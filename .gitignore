# Build output
/target/
**/*.o
**/*.ll

# native-tests build artifacts — keep only the .lang sources.
# Un-ignore every subdir so it descends, then every .lang under it
# — a per-dir whitelist let native-tests/lib2/ ship untracked once
# (found by the clean-room clone, N83-G).
native-tests/*
!native-tests/*.lang
!native-tests/*/
!native-tests/**/*.lang

# OS noise
.DS_Store
programs/*.ll
programs/*.o
programs/fcopy
programs/ugrep
programs/psum
programs/prodcons
programs/echo
programs/cfgparse
programs/wordfreq
programs/httpd
programs/minijson
programs/hexdump/main

# bench artifacts — regenerated by gen.py / harness.py
bench/build/
bench/data/
bench/out/
