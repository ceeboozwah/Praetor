// @desc   Direct recursion that stores an alias: the edge h.ptr -> x exists
//         at function exit on the base-case path, so the summary must carry
//         `creates` even though the call graph is cyclic. free x must reject.
// @class  use-after-free
// @safety reject a recursive callee's stored alias outlives the call
// @expect ownership  accept
// @expect region     accept
// @expect capability accept
// @expect affine     reject consume-while-aliased
// @expect region+capability accept
// @expect region+ownership accept
// @expect region+cap+affine reject consume-while-aliased

struct File { fd: u32 }
struct Holder { ptr: u32 }

fn rec_link(mut h: Holder, ref x: File, n: u32) -> u32 {
    if n > 0 {
        h.ptr = &x;
        rec_link(h, x, n - 1);
    }
    return 0;
}

fn f() -> u32 {
    let h = new Holder;
    let x = new File;
    rec_link(h, x, 3);
    free x;             // h.ptr may alias x
    return 0;
}
