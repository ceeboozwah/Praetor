// @desc   handle -> Mutex: a handle identifies the SAME mutex — locking
//         through the ticket resolves to m's domain. Tasks sharing the
//         ticket share the lock.
// @class  safe
// @safety accept locking a mutex through a handle ticket
// @expect ownership  accept
// @expect region     accept
// @expect capability accept
// @expect affine     accept
// @expect region+capability accept
// @expect region+ownership accept
// @expect region+cap+affine accept

struct Point { x: u32, y: u32 }

fn f() -> u32 {
    let m = mutex Point { x: 0, y: 0 };
    let hm = handle m;
    let t = spawn {
        let g = lock(hm);       // resolves to domain m
        g.x = 1;
    };
    let g2 = lock(m);
    g2.x = 2;
    join t;
    return 0;
}
