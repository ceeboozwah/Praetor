// @desc   A consumed resource is re-acquired (reassigned), then used. The
//         consume/reopen cycle is legal: Consumed -> Live on reassignment.
// @class  safe
// @safety accept reassignment re-establishes a live resource
// @expect ownership  accept
// @expect region     accept
// @expect capability accept
// @expect affine     accept
// @expect region+capability accept
// @expect region+ownership accept
// @expect region+cap+affine accept

struct File { fd: u32 }

fn f() -> u32 {
    let file = new File;
    free file;
    file = new File;   // reopen — a fresh Live resource
    return file.fd;
}
