// @desc   Child locks and writes; the parent locks and writes in the
//         window. Both synchronize on domain m — legal even though the
//         underlying data is the same.
// @class  safe
// @safety accept parent lock() racing a child's lock() on the same mutex
// @expect ownership  accept
// @expect region     accept
// @expect capability accept
// @expect affine     accept
// @expect region+capability accept
// @expect region+ownership accept
// @expect region+cap+affine accept

struct Point { x: u32, y: u32 }

fn f() -> u32 {
    let m = mutex Point { x: 0, y: 0 };
    let t = spawn {
        let g = lock(m);
        g.x = 1;
    };
    let g2 = lock(m);
    g2.x = 2;
    join t;
    return 0;
}
