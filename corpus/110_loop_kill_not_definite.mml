// @desc   Kill inside a loop body is not definite: the zero-iteration path
//         leaves the edge alive, so the summary must NOT claim kills h.ptr.
//         A flat kills list would record it and let the caller free x while
//         h.ptr may still point at it — an unsound miss. free x must reject.
// @class  use-after-free
// @safety reject a loop-body kill is only possible, never definite
// @expect ownership  accept
// @expect region     accept
// @expect capability accept
// @expect affine     reject consume-while-aliased
// @expect region+capability accept
// @expect region+ownership accept
// @expect region+cap+affine reject consume-while-aliased

struct File { fd: u32 }
struct Holder { ptr: u32 }

fn connect(mut h: Holder, ref x: File) -> u32 {
    h.ptr = &x;
    return 0;
}

fn loop_clear(mut h: Holder, n: u32) -> u32 {
    while n > 0 {
        h.ptr = 0;              // runs 0+ times -> kill not definite
        n = n - 1;
    }
    return 0;
}

fn f(n: u32) -> u32 {
    let h = new Holder;
    let x = new File;
    connect(h, x);
    loop_clear(h, n);
    free x;                     // h.ptr may still alias x (n could be 0)
    return 0;
}
