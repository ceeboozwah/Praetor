// @desc   The same object is read-shared with two separate calls.
// @class  safe
// @safety accept sequential shared reads never conflict
// @expect ownership  accept
// @expect region     accept
// @expect capability accept
// @expect region+capability accept

struct Node { v: u32, next: &Node }

fn look(ref x: Node) -> u32 {
    return x.v;
}

fn f() -> u32 {
    let n = new Node;
    let a = look(&n);
    let b = look(&n);
    return a + b;
}
// @expect region+ownership accept
// @expect affine accept
// @expect region+cap+affine accept
