// @desc   Nested containers: `h` holds an alias to `x` and is itself stored
//         inside `g`. The alias edge becomes transitive (g.h reaches x); when
//         the region closes, both containers die and every edge they carried
//         dies with them. `free x` afterward is legal.
// @class  safe
// @safety accept nested alias edges die with the outermost container
// @expect ownership  accept
// @expect region     accept
// @expect capability accept
// @expect affine     accept
// @expect region+capability accept
// @expect region+ownership accept
// @expect region+cap+affine accept

struct File { fd: u32 }
struct Holder { r: u32 }
struct Wrap { h: u32 }

fn f() -> u32 {
    let x = new File;
    region r {
        let h = new Holder;
        h.r = &x;       // h reaches x
        let g = new Wrap;
        g.h = h;        // g reaches x transitively through field h
    }                   // h and g both die; the edge to x dies with them
    free x;
    return 0;
}
