// N34C: word frequency on `std.map` StrMap<i64> — expected O(1)
// insert/lookup replaces the N24B linear scan (wordfreq_vec.lang is
// the frozen baseline for the benchmark).
//
// Keys are `str` VIEWS into the slurped input — `v`/`b` must outlive
// the map, which the borrow graph enforces: every free ordering is
// checked, and a non-UTF-8 file traps in `str_from_utf8` (the
// borrowed-key limit the milestone predicted).
//
// Exercises: get_mut counter bump (the `?`-style match both arms),
// put-entry drain into a sortable Vec, free ordering under
// transitive key borrows.

import std.fs;
import std.vec;
import std.io;
import std.map;
import std.result;

struct WC { w: str, cnt: i64 }

fn is_ws(c: u8) -> bool {
    return c == 32 || c == 10 || c == 9 || c == 13;
}

fn main(args: slice str) -> i32 {
    if args.len != 2 {
        io.eprintln("usage: wordfreq <file>");
        return 1;
    }
    let heap = system_allocator();
    let v = match fs.slurp_r(heap, args[1].bytes.ptr) {
        Ok(v) => v,
        Err(e) => {
            io.eprint("wordfreq: errno ");
            io.println_i64(i64(e));
            return e;
        }
    };
    if v.len == 0 {
        io.eprintln("wordfreq: empty input");
        return 1;
    }
    // `b` and everything built from it must die before `v.destroy()`
    // — the only scope is `if true` (F9: no bare blocks).
    if true {
        let b = v.as_slice();
        let m = map.new<i64>(heap, 16);
        // tokenize: a word is b[wlo..i) — an O(1) map hit each
        let i: u64 = 0;
        let wlo: u64 = 0;
        let in_word = false;
        while i <= v.len {
            let closing = i == v.len || is_ws(b[i]);
            if in_word && closing {
                let k = str_from_utf8(&b[wlo..i]);
                if m.contains(k) {
                    match m.get_mut(k) {
                        Ok(c) => { *c = *c + 1; }
                        Err(e) => { }
                    }
                } else {
                    match m.insert(k, i64(1)) {
                        Fresh(mm) => { m = mm; }
                        Replaced(o) => { m = o.m; }
                        Full(o) => { m = o.m; return 3; }
                    }
                }
                in_word = false;
            }
            if !in_word && !closing {
                wlo = i;
                in_word = true;
            }
            i = i + 1;
        }
        io.print("wordfreq: ");
        io.print_i64(m.len());
        io.println(" unique words");
        // drain the map into a Vec<WC> for sorting — the keys' b
        // views move into the list (b still borrowed, correctly)
        let list = vec.Vec<WC>::new(heap);
        let cont = 1;
        while cont == 1 {
            match m.pop_entry() {
                Ok(e) => { list = list.push(WC { w: e.key, cnt: e.v }); }
                Err(x) => { cont = 0; }
            }
        }
        m.free_storage();
        // selection-sort desc by cnt — same as the baseline; the
        // inner `if true` bounds the as_mut borrow before destroy
        if true {
        let s = list.as_mut();
        let n = s.len;
        let p: u64 = 0;
        while p < n {
            let best = p;
            let j = p + 1;
            while j < n {
                if s[j].cnt > s[best].cnt { best = j; }
                j = j + 1;
            }
            if best != p {
                let tmp = s[p];
                s[p] = s[best];
                s[best] = tmp;
            }
            p = p + 1;
        }
        let k: u64 = 0;
        while k < n {
            if k >= 10 { break; }
            let e = s[k];
            io.print_i64(e.cnt);
            io.print(" ");
            write(1, e.w.bytes.ptr, e.w.len);
            io.println("");
            k = k + 1;
        }
        }
        list.destroy();
    }
    v.destroy();
    return 0;
}
