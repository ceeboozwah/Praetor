// N24B-1: file copier. open -> read chunks -> write -> close.
// Exercises: std.fs wrappers, arrays, slice args, error paths.
//
// N25 rewrite: every N24B workaround in this file is gone.
//  - fs.fd_read(fd, &mut buf[..], n) works in a loop now that B1
//    is fixed — an inline slice-mut arg no longer pins buf.
//  - fs.fd_open routes through the mml_open_mode shim (N24C),
//    replacing the creat(2) call that dodged variadic open(2).
//  - Flags and mode spell themselves: O_WRONLY|O_CREAT|O_TRUNC is
//    0x1|0x200|0x400 on this platform; 0644 is 0x1a4.

import std.fs;
import std.io;

fn copy_fd(src: i32, dst: i32) -> i64 {
    let buf: [4096]u8;
    buf[0] = 0;
    let n = fs.fd_read(src, &mut buf[..], 4096);
    let total: i64 = 0;
    while n > 0 {
        let w = fs.fd_write(dst, &buf[..], u64(n));
        if w < n {
            return i64(0) - 1;
        }
        total = total + n;
        n = fs.fd_read(src, &mut buf[..], 4096);
    }
    return total;
}

fn main() -> i32 {
    let src = fs.fd_open("/tmp/n24b_src.txt", 0, 0);
    if src < 0 {
        io.eprintln("fcopy: cannot open source");
        return 1;
    }
    let dst = fs.fd_open("/tmp/n24b_dst.txt", 0x1 | 0x200 | 0x400, 0x1a4);
    if dst < 0 {
        io.eprintln("fcopy: cannot open dest");
        fs.fd_close(src);
        return 1;
    }
    let n = copy_fd(src, dst);
    fs.fd_close(src);
    fs.fd_close(dst);
    if n < 0 {
        io.eprintln("fcopy: short write");
        return 1;
    }
    io.print("fcopy: ");
    io.print_i64(n);
    io.println(" bytes copied");
    return 0;
}
