// fcopy — a real tool: `fcopy <src> <dst>`.
// open -> read chunks -> write -> close.
//
// N26A: paths come from argv — `args[i].bytes.ptr` is the C
// string's data, still NUL-terminated by the kernel, so it
// satisfies fd_open's `*const u8` directly. No copy, no alloc.

import std.fs;
import std.io;

fn copy_fd(src: i32, dst: i32) -> i64 {
    let buf: [4096]u8;
    buf[0] = 0;
    let n = fs.fd_read(src, &mut buf[..], 4096);
    let total: i64 = 0;
    while n > 0 {
        let w = fs.fd_write(dst, &buf[..], u64(n));
        if w < n {
            return i64(0) - 1;
        }
        total = total + n;
        n = fs.fd_read(src, &mut buf[..], 4096);
    }
    return total;
}

fn main(args: slice str) -> i32 {
    if args.len != 3 {
        io.eprintln("usage: fcopy <src> <dst>");
        return 1;
    }
    let src = fs.fd_open(args[1].bytes.ptr, 0, 0);
    if src < 0 {
        io.eprintln("fcopy: cannot open source");
        return 1;
    }
    let dst = fs.fd_open(args[2].bytes.ptr, 0x1 | 0x200 | 0x400, 0x1a4);
    if dst < 0 {
        io.eprintln("fcopy: cannot open dest");
        fs.fd_close(src);
        return 1;
    }
    let n = copy_fd(src, dst);
    fs.fd_close(src);
    fs.fd_close(dst);
    if n < 0 {
        io.eprintln("fcopy: short write");
        return 1;
    }
    io.print("fcopy: ");
    io.print_i64(n);
    io.println(" bytes copied");
    return 0;
}
