// N24B-1: file copier. open -> read chunks -> write -> close.
// Exercises: FFI, arrays, &mut pointers, u64 casts, error paths.
//
// Notes (see programs/NOTES.md):
//  - no argv: paths are literals (G1). Str literals coerce to
//    *const u8 at extern boundaries, so no CString needed.
//  - fs.fd_read(fd, &mut arr[..], n) binds a LASTING mut borrow on
//    the stack array (by-value `slice mut` param semantics) —
//    repeated calls fight it. The extern `read`/`write` *void
//    claims are transient per call, which is what a scratch
//    buffer actually wants (F1).

import std.io;

extern fn open(path: *const u8, flags: i32, mode: i32) -> i32;
extern fn creat(path: *const u8, mode: i32) -> i32;
extern fn read(fd: i32, buf: *void, n: u64) -> i64;
extern fn close(fd: i32) -> i32;

fn copy_fd(src: i32, dst: i32) -> i64 {
    let buf: [4096]u8;
    buf[0] = 0;
    let n = read(src, &mut buf[0], 4096);
    let total: i64 = 0;
    while n > 0 {
        let w = write(dst, &buf[0], u64(n));
        if w < n {
            return i64(0) - 1;
        }
        total = total + n;
        n = read(src, &mut buf[0], 4096);
    }
    return total;
}

fn main() -> i32 {
    let src = open("/tmp/n24b_src.txt", 0, 0);
    if src < 0 {
        io.eprintln("fcopy: cannot open source");
        return 1;
    }
    // creat(2) is non-variadic — open(2)'s trailing mode arg does
    // not marshal through a fixed-arity extern decl on this ABI
    // (it landed as 0, giving a mode-0000 file). F5.
    let dst = creat("/tmp/n24b_dst.txt", 420);
    if dst < 0 {
        io.eprintln("fcopy: cannot open dest");
        close(src);
        return 1;
    }
    let n = copy_fd(src, dst);
    close(src);
    close(dst);
    if n < 0 {
        io.eprintln("fcopy: short write");
        return 1;
    }
    io.print("fcopy: ");
    io.print_i64(n);
    io.println(" bytes copied");
    return 0;
}
