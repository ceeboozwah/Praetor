// N24B-8: multi-module CLI tool — hexdump clone.
// `main.lang` drives the fd loop; `hexutil.lang` owns byte->hex
// formatting. Output: `offset  xx xx xx xx  |ascii|` per 16 bytes.
//
// Exercises: local modules, write-capability params over slice mut,
// shift/mask arithmetic, mixed u8/u64/i64 at the FFI boundary.

import hexutil;
import std.fs;
import std.io;

fn dump_chunk(read c: [16]u8, n: u64, off: i64) {
    let line: [128]u8;
    line[0] = 0;
    let pos: u64 = 0;
    pos = hexutil.put_hex64(line, pos, off);
    line[pos] = 32; pos = pos + 1;
    line[pos] = 32; pos = pos + 1;
    let i: u64 = 0;
    while i < 16 {
        if i < n {
            pos = hexutil.put_hex8(line, pos, c[i]);
        } else {
            line[pos] = 32; pos = pos + 1;
            line[pos] = 32; pos = pos + 1;
        }
        line[pos] = 32; pos = pos + 1;
        if i == 7 {
            line[pos] = 32; pos = pos + 1;   // hexdump -C's column gap
        }
        i = i + 1;
    }
    line[pos] = 32; pos = pos + 1;
    line[pos] = 124; pos = pos + 1;   // ' |'
    i = 0;
    while i < n {
        if hexutil.is_printable(c[i]) {
            line[pos] = c[i];
        } else {
            line[pos] = 46;           // '.'
        }
        pos = pos + 1;
        i = i + 1;
    }
    line[pos] = 124; pos = pos + 1;
    line[pos] = 10; pos = pos + 1;
    fs.fd_write(1, &line[0..i64(pos)], pos);
}

fn main(args: slice str) -> i32 {
    if args.len != 2 {
        io.eprintln("usage: hexdump <file>");
        return 1;
    }
    let fd = match fs.open(args[1].bytes.ptr, fs.o_read(), 0) {
        Ok(f) => { f }
        Err(e) => {
            io.eprintln("hexdump: cannot open input");
            return 1;
        }
    };
    let buf: [16]u8;
    buf[0] = 0;
    let off: i64 = 0;
    let n = fs.fd_read(fd, &mut buf[..], 16);
    while n > 0 {
        dump_chunk(buf, u64(n), off);
        off = off + n;
        n = fs.fd_read(fd, &mut buf[..], 16);
    }
    fs.fd_close(fd);
    // hexdump -C ends with a bare 8-hex EOF offset.
    let tail: [128]u8;
    tail[0] = 0;
    let tp: u64 = 0;
    tp = hexutil.put_hex64(tail, tp, off);
    tail[tp] = 10;
    fs.fd_write(1, &tail[0..i64(tp + 1)], tp + 1);
    return 0;
}
