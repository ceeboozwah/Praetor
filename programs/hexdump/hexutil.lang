// hexdump/hexutil — byte formatting helpers.
// Every writer takes a caller buffer + cursor and returns the new
// cursor: explicit storage, no hidden allocation.
//
// N25 rewrite: real bit ops — nibble masks & shifts replace the
// %16 / 16 + reverse workaround (F10 closed by N25A/N25B).

pub fn hex_digit(n: i64) -> u8 {
    if n < 10 { return u8(n + 48); }
    return u8(n + 87);   // 'a' - 10 = 87
}

// Write 8 hex digits of `v` into out[pos..], return new pos.
// MSB-first via a shifting nibble mask — no temp, no reverse.
pub fn put_hex64(write out: [128]u8, pos: u64, v: i64) -> u64 {
    let i: i64 = 0;
    while i < 8 {
        let sh = (7 - i) * 4;
        out[pos + u64(i)] = hex_digit((v >> sh) & 0xf);
        i = i + 1;
    }
    return pos + 8;
}

pub fn put_hex8(write out: [128]u8, pos: u64, byte: u8) -> u64 {
    out[pos] = hex_digit(i64(byte >> 4));
    out[pos + 1] = hex_digit(i64(byte & 0x0f));
    return pos + 2;
}

pub fn is_printable(c: u8) -> bool {
    return c >= 32 && c <= 126;
}
