// N26B: TCP echo server on :8080 through std.net.
// socket -> reuse_addr -> bind -> listen -> accept one connection
// -> echo loop until the client closes, then exit.
//
// The sockaddr_in byte layout that this program used to spell by
// hand (sin_len, AF_INET, htons byte order, sin_zero) now lives in
// std.net — the application names the address and port.

import std.io;
import std.net;

fn main() -> i32 {
    let srv = net.tcp_socket();
    if srv < 0 {
        io.eprintln("echo: socket failed");
        return 1;
    }
    net.reuse_addr(srv);
    if net.bind_v4(srv, net.any_v4(), 8080) < 0 {
        io.eprintln("echo: bind failed");
        return 1;
    }
    if net.listen(srv, 5) < 0 {
        io.eprintln("echo: listen failed");
        return 1;
    }
    io.println("echo: listening on :8080");
    let conn = net.accept(srv);
    if conn < 0 {
        io.eprintln("echo: accept failed");
        return 1;
    }
    io.println("echo: client connected");
    let buf: [4096]u8;
    buf[0] = 0;
    let n = net.recv(conn, &mut buf[..], 4096);
    let total: i64 = 0;
    while n > 0 {
        let w = net.send(conn, &buf[..], u64(n));
        if w < n {
            io.eprintln("echo: short write");
            net.sock_close(conn);
            net.sock_close(srv);
            return 1;
        }
        total = total + n;
        n = net.recv(conn, &mut buf[..], 4096);
    }
    io.print("echo: ");
    io.print_i64(total);
    io.println(" bytes echoed, closing");
    net.sock_close(conn);
    net.sock_close(srv);
    return 0;
}
