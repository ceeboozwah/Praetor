// N26B + N30: TCP echo server on :8080 through std.net's Result
// layer — `net.socket()?`, `net.bind(...)`, `net.listen(...)`,
// `net.accept()`, `net.read`/`net.write`. The sockaddr_in byte
// layout lives in std.net; `Err` carries errno.

import std.io;
import std.net;
import std.result;

fn run() -> result.Result<i32, i32> {
    let srv = net.socket()?;
    net.reuse_addr(srv)?;
    net.bind(srv, net.any_v4(), 8080)?;
    net.listen(srv, 5)?;
    io.println("echo: listening on :8080");
    let conn = net.accept(srv)?;
    io.println("echo: client connected");
    let buf: [4096]u8;
    buf[0] = 0;
    let total: i64 = 0;
    while true {
        let n = net.read(conn, &mut buf[..], 4096)?;
        if n == 0 { break; }
        let w = net.write(conn, &buf[0..i64(n)], u64(n))?;
        if w < n {
            return result.Result<i32, i32>::Err(5);   // EIO
        }
        total = total + n;
    }
    net.close(conn)?;
    net.close(srv)?;
    io.print("echo: ");
    io.print_i64(total);
    io.println(" bytes echoed, closing");
    return result.Result<i32, i32>::Ok(0);
}

fn main() -> i32 {
    match run() {
        Ok(v) => { return v; }
        Err(e) => {
            io.eprint("echo: errno ");
            io.println_i64(i64(e));
            return e;
        }
    }
}
