// @compile-error cannot lock `m` through read authority
// N11: `read m` loans interior-read authority — `lock` grants
// synchronized WRITE authority, so a read edge cannot derive it.
struct Counter { value: i32 }
fn bad(read m: mutex Counter) {
    let g = lock(m);
    g.value = 1;
}
fn main() -> i32 {
    let m = mutex Counter { value: 0 };
    bad(m);
    return 0;
}
