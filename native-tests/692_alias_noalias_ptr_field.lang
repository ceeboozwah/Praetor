// @exit 42
// @ir-lacks noalias
// N51B — `*T` fields poison eligibility (N51A hole H2): an extern can
// stuff a pointer to m's own storage into m.p; the callee forwarding
// it to another extern writes through foreign provenance.

struct M { x: i64, p: *i64 }
fn f(write m: M) -> i64 { m.x = 9; return m.x; }
fn main() -> i32 {
    let m: M; m.x = 1;
    return i32(f(m)) + 33;
}
