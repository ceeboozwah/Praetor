// @exit 42
// N37: a `_` arm can hold no payload at all — every variant's
// payload edge is dead inside it, so the owner is free for `insert`.
import std.map;
import std.result;

fn main() -> i32 {
    let heap = system_allocator();
    let m = map.new<i64>(heap, 8);
    match m.get_mut("k") {
        Ok(v) => { *v = *v + 1; }
        _ => {
            match m.insert("k", i64(7)) {
                Fresh(mm) => { m = mm; }
                _ => { return 9; }
            }
        }
    }
    match m.get("k") {
        Ok(v) => { if *v != 7 { return 3; } }
        Err(_) => { return 4; }
    }
    return 42;
}
