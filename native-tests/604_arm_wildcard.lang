// @exit 42
// N37: a `_` arm can hold no payload at all — every variant's
// payload edge is dead inside it, so the owner is free for `insert`.
import std.map;
import std.result;

fn main() -> i32 {
    let heap = system_allocator();
    let m = map.new<i64>(heap, 8);
    match m.get_mut("k") {
        Ok(v) => { *v = *v + 1; }
        _ => {
            match m.insert("k", i64(7)) {
                Fresh(mm) => { m = mm; }
                Replaced(o) => { o.m.free_storage(); return 9; }
                Full(o) => { o.m.free_storage(); return 9; }
            }
        }
    }
    let bad: i32 = 0;
    match m.get("k") {
        Ok(v) => { if *v != 7 { bad = 3; } }
        Err(_) => { bad = 4; }
    }
    m.free_storage();
    if bad != 0 { return bad; }
    return 42;
}
