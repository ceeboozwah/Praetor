// @exit 42
// N46 — `i <= s.len` proves `&s[0..i]` in range: `0 <= 0 <= i <= len`
// with a const lo and the loop var as hi.

fn sum_to(s: slice i32, i: u64) -> i32 {
    let acc = 0;
    if i <= s.len {
        let w = &s[0..i];
        let j: u64 = 0;
        while j < w.len {
            acc = acc + w[j];
            j = j + 1;
        }
    }
    return acc;
}

fn main() -> i32 {
    let a: [4]i32;
    a[0] = 10; a[1] = 20; a[2] = 30; a[3] = 40;
    let s = &a[0..4];
    return sum_to(s, 2) + 12;
}
