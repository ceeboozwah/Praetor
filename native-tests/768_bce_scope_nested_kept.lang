// @exit -1
// @ir-has mml_range_check
// PLEX-0003 — nested scopes: a kill inside an inner `if` compacts
// below BOTH the inner and the outer mark, so `i ≡ 0` escapes two
// truncate boundaries to reach the outer merge. Check must stay.
fn get_idx() -> u64 { return 20; }
fn never() -> u64 { return 99999; }
fn main() -> i32 {
    let a: [4]u8;
    a[0] = 1; a[1] = 2; a[2] = 3; a[3] = 4;
    let s = &a[0..4];
    let z: u64 = 0;
    let i = get_idx();
    if get_idx() == never() {
        if get_idx() == never() {
            z = get_idx();
            i = 0;
        }
    }
    let k = &s[0..i];
    return i32(k.len);
}
