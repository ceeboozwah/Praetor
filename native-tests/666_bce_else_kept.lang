// @exit -1
// N47 — `n == s.len` in the else branch is FALSE: equality facts
// only dominate the then-arm. `s[i]` under `i < n` keeps its
// check and traps.

fn run(s: slice i32, n: u64) -> i32 {
    let i: u64 = 0;
    let r: i32 = 0;
    if n == s.len {
        return 1;
    }
    while i < n {
        r = r + s[i];
        i = i + 1;
    }
    return r;
}

fn main() -> i32 {
    let a: [4]i32;
    a[0] = 10; a[1] = 20; a[2] = 30; a[3] = 40;
    let s = &a[0..4];
    return run(s, 8);
}
