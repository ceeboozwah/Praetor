// @exit 11
// A function returns a re-slice of its param — the `$arg`-keyed span
// survives the boundary exactly like a returned `&T`.

fn tail(s: slice i32) -> slice i32 {
    return &s[1..3];
}

fn main() -> i32 {
    let a: [4]i32;
    a[0] = 1; a[1] = 5; a[2] = 6; a[3] = 7;
    let s = &a[0..4];
    let t = tail(s);
    return t[0] + t[1];
}
