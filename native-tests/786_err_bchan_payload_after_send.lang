// @compile-error `p`
// CHAN-004 S3b — `send` cut `p`'s authority into the packet at the
// call; `Err(v)` restores it under `v`, not `p`.
struct Point { x: i32, y: i32 }
fn main() -> i32 {
    let ch: bchannel i32 = bchannel(4);
    let p = Point { x: 1, y: 2 };
    let r = send(ch, p);
    match r {
        Ok => return 1,
        Err(v) => return p.x,
    }
    return 0;
}
