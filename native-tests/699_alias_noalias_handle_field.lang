// @exit 42
// @ir-lacks noalias
// N51B — a `handle` field poisons: m carries its own identity token,
// and (*m.h) reaches m's storage through foreign provenance inside
// the callee.

struct M { x: i64, h: handle M }
fn f(write m: M) -> i64 { m.x = 9; return m.x; }
fn main() -> i32 {
    let m: M; m.x = 1;
    return i32(f(m)) + 33;
}
