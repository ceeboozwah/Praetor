// @exit 42
// String = owned UTF-8 buffer over box slice u8. push_str reallocs
// like Vec; as_str returns a str VIEW (Read edge on the buffer);
// equality is content equality through the str views.
extern fn memcpy(dst: *void, src: *const void, n: u64) -> *void;
struct String { buf: box slice u8, len: u64, cap: u64, heap: alloc }
fn string_from(heap: alloc, s: str) -> String {
    let st: String;
    st.buf = alloc_slice<u8>(heap, s.len + 1);
    memcpy(st.buf.ptr, s.bytes.ptr, s.len);
    st.len = s.len; st.cap = s.len + 1; st.heap = heap;
    return st;
}
fn string_as_str(read s: String) -> str {
    return str_from_utf8(&s.buf[0..s.len]);
}
fn string_push_str(own s: String, t: str) -> String {
    if s.len + t.len >= s.cap {
        let ncap = (s.len + t.len + 1) * 2;
        let nb = alloc_slice<u8>(s.heap, ncap);
        memcpy(nb.ptr, s.buf.ptr, s.len);
        free(s.buf); s.buf = nb; s.cap = ncap;
    }
    memcpy(&mut s.buf[s.len], t.bytes.ptr, t.len);
    s.len = s.len + t.len;
    return s;
}
fn string_eq(read a: String, read b: String) -> bool {
    return string_as_str(a) == string_as_str(b);
}
fn string_free(own s: String) { free(s.buf); }

fn main() -> i32 {
    let heap = system_allocator();
    let s = string_from(heap, "hello");
    s = string_push_str(s, " world");   // realloc 6 -> cap 24
    let s2 = string_from(heap, "hello world");
    let same = string_eq(s, s2);
    let n: u64;
    region r {
        let v = string_as_str(s);
        n = v.len;
    }
    string_free(s);
    string_free(s2);
    if same {
        if n == 11 { return 42; }
    }
    return 1;
}
