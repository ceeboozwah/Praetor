// @exit 55
// `&mut s[1..3]` re-slices through the loaded data pointer — the
// sub-span writes map back onto `a`.

fn main() -> i32 {
    let a: [4]i32;
    a[0] = 1; a[1] = 2; a[2] = 3; a[3] = 4;
    region r {
        let s = &mut a[0..4];
        let t = &mut s[1..3];
        t[0] = 20;
        t[1] = 30;
    }
    return a[0] + a[1] + a[2] + a[3];
}
