// @exit -1
// N46 — the cond dominates the then-arm only: `s[i]` in the else
// arm (where `i >= s.len` held) keeps its check.

fn peek(s: slice i32, i: u64) -> i32 {
    let r = 0;
    if i < s.len {
        r = 1;
    } else {
        r = s[i];
    }
    return r;
}

fn main() -> i32 {
    let a: [4]i32;
    a[0] = 10; a[1] = 20; a[2] = 30; a[3] = 40;
    let s = &a[0..4];
    return peek(s, 4);
}
