// @exit -1
// N47 — assigning `n` inside the loop kills `n == s.len`;
// `s[i]`'s check must stay. n = 9 admits i = 8 on a 4-slice:
// the retained check traps.

fn run(s: slice i32) -> i32 {
    let n = s.len;
    let i: u64 = 0;
    let r: i32 = 0;
    while i < n {
        n = 9;
        r = r + s[i];
        i = i + 1;
    }
    return r;
}

fn main() -> i32 {
    let a: [4]i32;
    a[0] = 10; a[1] = 20; a[2] = 30; a[3] = 40;
    let s = &a[0..4];
    return run(s);
}
