// @exit 11
// N11: scope-end unlock + relock — a guard that dies (or a moved one
// that is unlocked) fully releases the domain for the next `lock`.
struct Counter { value: i32 }
fn main() -> i32 {
    let m = mutex Counter { value: 0 };
    let flag = true;
    if flag {
        let g = lock(m);
        g.value = 1;
    }
    let g2 = lock(m);
    g2.value = g2.value + 10;
    unlock(g2);
    let g3 = lock(m);
    let r = g3.value;
    unlock(g3);
    return r;
}
