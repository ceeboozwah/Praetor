// @exit 42
// N14: `*void` values flow back as opaque carriers — stored, passed
// to the next call, never dereferenced.
extern fn memset(p: *void, c: i32, n: i64) -> *void;
extern fn memchr(s: *const void, c: i32, n: i64) -> *void;

fn main() -> i32 {
    let a: [4]i32;
    a[0] = 1;
    let p = memset(&mut a, 0, 16);
    let q: *void = p;
    memchr(q, 0, 4);
    return 42;
}
