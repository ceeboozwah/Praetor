// @compile-error inside `spawn`
// N23 — `?` inside a task body rejects: a task's `return` binds its
// result, not the fn's — the propagation channel isn't defined there.
import std.result;

fn a() -> result.Result<i32, i32> {
    return result.Result<i32, i32>::Ok(1);
}
fn main() -> i32 {
    let x = 0;
    let t = spawn {
        let y = a()?;
        return y;
    };
    join t;
    return x;
}
