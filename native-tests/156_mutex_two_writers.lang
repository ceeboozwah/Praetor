// @exit 3
// N11: two tasks write the same counter through the same mutex — the
// Sync domain serializes what plain writes could not.
struct Counter { value: i32 }
fn main() -> i32 {
    let m = mutex Counter { value: 0 };
    let t1 = spawn {
        let g = lock(m);
        g.value = g.value + 1;
    };
    let t2 = spawn {
        let g = lock(m);
        g.value = g.value + 1;
    };
    let g = lock(m);
    g.value = g.value + 1;
    unlock(g);
    join t1;
    join t2;
    let g2 = lock(m);
    let r = g2.value;
    unlock(g2);
    return r;
}
