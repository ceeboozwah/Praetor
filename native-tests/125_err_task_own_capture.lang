// @compile-error held by unjoined task
// N9: the child transfers `x` away — the parent loses authority over
// the whole [spawn, join) window, not just at join.
fn take(own v: i32) -> i32 { return v; }
fn main() -> i32 {
    let x: i32 = 42;
    let t = spawn {
        take(x);
    };
    return x;
}
