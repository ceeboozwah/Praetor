// @exit -1
// Dynamic negative lower bound: `hi <u lo` must catch `lo < 0`
// (unsigned-huge lo fails the first compare).

fn main(args: slice str) -> i32 {
    let a: [4]i32;
    a[0] = 1; a[1] = 2; a[2] = 3; a[3] = 4;
    let s = &a[0..4];
    let lo: i64 = 0 - i64(args.len) - 1;
    let w = &s[lo..2];
    return i32(w[0]);
}
