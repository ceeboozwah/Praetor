// @exit 42
// N13: real parallel execution — two OS threads hammer the same
// atomic storage 100k times total; seq_cst atomicrmw must be exact.
fn main() -> i32 {
    let c: atomic i64 = 0;
    let t1 = spawn {
        let i = 0;
        while i < 50000 {
            atomic_add(c, 1);
            i = i + 1;
        }
    };
    let t2 = spawn {
        let i = 0;
        while i < 50000 {
            atomic_add(c, 1);
            i = i + 1;
        }
    };
    join t1;
    join t2;
    if atomic_load(c) == 100000 { return 42; }
    return 1;
}
