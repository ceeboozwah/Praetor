// @exit -1
// N47 — re-slicing `s` inside the loop kills `n == s.len` (s
// moved: its len may differ now); `s[i]` keeps its check and
// traps on the shrunk slice.

fn run(s: slice i32, t: slice i32) -> i32 {
    let n = s.len;
    let i: u64 = 0;
    let r: i32 = 0;
    while i < n {
        s = t;
        r = r + s[i];
        i = i + 1;
    }
    return r;
}

fn main() -> i32 {
    let a: [4]i32;
    a[0] = 10; a[1] = 20; a[2] = 30; a[3] = 40;
    let b: [1]i32;
    b[0] = 7;
    return run(&a[0..4], &b[0..1]);
}
