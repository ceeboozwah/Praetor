// @exit 42
// CHAN-004 S3b — unordered recv: two producer tasks send `&mut` to
// DIFFERENT targets. Their pushes mark `ch` unordered, so each
// `Some` claims unknown-identity (⊥ candidates {a,b}) — never a
// verbatim packet. Both delivered capabilities are usable through
// the claim, regardless of which producer's message arrived first.
struct Point { x: i32, y: i32 }
fn main() -> i32 {
    let ch: bchannel &mut Point = bchannel(4);
    let a = Point { x: 10, y: 0 };
    let b = Point { x: 20, y: 0 };
    let t1 = spawn {
        let r = send(ch, &mut a);
        match r { Ok => {} Err(e) => {} }
    };
    let t2 = spawn {
        let r = send(ch, &mut b);
        match r { Ok => {} Err(e) => {} }
    };
    join t1;
    join t2;
    let o = recv(ch);
    match o {
        Some(v) => { (*v).y = 1; }
        None => {}
    }
    let o2 = recv(ch);
    match o2 {
        Some(w) => { (*w).y = 1; }
        None => {}
    }
    return 42;
}
