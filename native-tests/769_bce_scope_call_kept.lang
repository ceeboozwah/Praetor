// @exit -1
// @ir-has mml_range_check
// PLEX-0003 — kill vectors beyond assignment: passing a fact-bearing
// place with write authority kills its facts, which used to compact
// the table mid-branch. `eat(z)` removes `z ≡ 0`, `i = 0` slides
// below the mark and survives the truncate. Check must stay.
fn get_idx() -> u64 { return 20; }
fn never() -> u64 { return 99999; }
fn eat(write z: u64) { z = 0; }
fn main() -> i32 {
    let a: [4]u8;
    a[0] = 1; a[1] = 2; a[2] = 3; a[3] = 4;
    let s = &a[0..4];
    let z: u64 = 0;
    let i = get_idx();
    if get_idx() == never() {
        eat(z);
        i = 0;
    }
    let k = &s[0..i];
    return i32(k.len);
}
