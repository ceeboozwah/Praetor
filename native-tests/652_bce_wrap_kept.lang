// @exit -1
// N46 — `i + 1 < s.len` does NOT prove `s[i]` in range: at
// i = u64::MAX the sum wraps to 0 and the cond holds while s[i]
// is wild. The check stays and traps.

fn peek(s: slice i32, i: u64) -> i32 {
    if i + 1 < s.len {
        return s[i];
    }
    return 0;
}

fn main() -> i32 {
    let a: [4]i32;
    a[0] = 10; a[1] = 20; a[2] = 30; a[3] = 40;
    let s = &a[0..4];
    let big: u64 = (u64(1) << 63) + ((u64(1) << 63) - 1);
    return peek(s, big);
}
