// @compile-error requires `lock`
// N11: a mutex passed by `write` still forbids raw interior access
// inside the callee — the capability grants locking rights, not
// unsynchronized writes.
struct Counter { value: i32 }
fn update(write m: mutex Counter) {
    m.value = 5;
}
fn main() -> i32 {
    let m = mutex Counter { value: 0 };
    update(m);
    return 0;
}
