// @exit 42
// N16B: a growable Vec built on plain language — `box slice` fields,
// `own`-param push (realloc frees the root inside), pop under
// `write`, explicit vec_free. No compiler container magic.
extern fn memcpy(dst: *void, src: *const void, n: u64) -> *void;
struct Vec { buf: box slice i32, len: u64, cap: u64, heap: alloc }
fn vec_new(heap: alloc) -> Vec {
    let v: Vec; v.buf = alloc_slice<i32>(heap, 4);
    v.len = 0; v.cap = 4; v.heap = heap; return v;
}
fn vec_push(own v: Vec, x: i32) -> Vec {
    if v.len == v.cap {
        let ncap = v.cap * 2;
        let nb = alloc_slice<i32>(v.heap, ncap);
        memcpy(nb.ptr, v.buf.ptr, v.len * 4);
        free(v.buf); v.buf = nb; v.cap = ncap;
    }
    v.buf[v.len] = x; v.len = v.len + 1;
    return v;
}
fn vec_pop(write v: Vec) -> i32 {
    v.len = v.len - 1; return v.buf[v.len];
}
fn vec_as_slice(read v: Vec) -> slice i32 {
    return &v.buf[0..v.len];
}
fn vec_as_mut(write v: Vec) -> slice mut i32 {
    return &mut v.buf[0..v.len];
}
fn vec_free(own v: Vec) { free(v.buf); }

fn main() -> i32 {
    let heap = system_allocator();
    let v = vec_new(heap);
    v = vec_push(v, 10);
    v = vec_push(v, 20);
    v = vec_push(v, 30);
    v = vec_push(v, 40);
    v = vec_push(v, 50);   // realloc 4 -> 8 inside push
    let p = vec_pop(v);    // 50
    let s = v.buf[0] + v.buf[1] + v.buf[2] + v.buf[3];  // 100
    vec_free(v);
    return p + s - 108;
}
