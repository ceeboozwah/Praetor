// @exit 7
// `v.push<i32>(7)` — explicit type args on method calls, same
// spelling as `vec.push<i32>(v, 7)` underneath.

import std.vec;

fn main() -> i32 {
    let heap = system_allocator();
    let v = vec.Vec<i32>::new(heap);
    let v = v.push<i32>(7);
    let s = v.as_slice();
    let r = s[0];
    consume s;
    v.destroy();
    return r;
}
