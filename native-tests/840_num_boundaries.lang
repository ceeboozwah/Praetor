// @exit 42
// Numerical boundaries — curated permanent fixture for the
// correctness suite. Every value below was computed independently
// (see native-tests/num_MANIFEST.md); a FAIL's exit code names the
// check number.
import std.io;
fn main() -> i32 {
    // Signed edges: i64::MAX + 1 wraps to i64::MIN at runtime —
    // wrapping is the language's runtime semantics (no nsw/nuw);
    // only pure-literal folds are range-checked.
    let imax: i64 = 9223372036854775807;
    if imax + 1 != i64(-9223372036854775808) { return 1; }
    let imin: i64 = -9223372036854775808;
    if imin - 1 != i64(9223372036854775807) { return 2; }
    if imin * i64(-1) != imin { return 3; }         // MIN * -1 wraps
    if 0 - imin != imin { return 4; }               // -MIN == MIN
    // i32 edges.
    let jmax: i32 = 2147483647;
    if jmax + 1 != i32(-2147483648) { return 5; }
    let jmin: i32 = -2147483648;
    if 0 - jmin != jmin { return 6; }
    // Unsigned edges: u64::MAX + 1 == 0; 0 - 1 == u64::MAX.
    let umax: u64 = 18446744073709551615;
    if umax + u64(1) != u64(0) { return 7; }
    let uzero: u64 = 0;
    if uzero - u64(1) != umax { return 8; }
    if umax / u64(2) != u64(9223372036854775807) { return 9; }
    if umax % u64(2) != u64(1) { return 10; }
    // Narrow widths wrap at their own boundary, not i32's.
    let b: i8 = 127;
    if b + 1 != i8(-128) { return 11; }
    let c: u8 = 255;
    if c + 1 != u8(0) { return 12; }
    let d: u16 = 65535;
    if d + 1 != u16(0) { return 13; }
    let e: i16 = -32768;
    if 0 - e != e { return 14; }
    // Truncating signed division: -7/2 = -3 (toward zero), % = -1.
    let dn: i64 = -7;
    let dd: i64 = 2;
    if dn / dd != i64(-3) { return 15; }
    if dn % dd != i64(-1) { return 16; }
    let dp: i64 = 7;
    let ddm: i64 = -2;
    if dp / ddm != i64(-3) { return 17; }
    if dp % ddm != i64(1) { return 18; }
    return 42;
}
