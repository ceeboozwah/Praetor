// @exit 42
// N46 — `while i < s.len` dominates the body: every `s[i]` in the
// counted loop is in range by the loop test itself.

fn sum(s: slice i32) -> i32 {
    let acc = 0;
    let i: u64 = 0;
    while i < s.len {
        acc = acc + s[i];
        i = i + 1;
    }
    return acc;
}

fn main() -> i32 {
    let a: [4]i32;
    a[0] = 10; a[1] = 20; a[2] = 30; a[3] = 40;
    return sum(&a[0..4]) - 58;
}
