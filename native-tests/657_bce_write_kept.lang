// @exit -1
// N46 — re-slicing `s` inside the dominated block kills the fact:
// `i < s.len` then `s = &s[0..0]` then `s[i]` keeps its check.

fn peek(s: slice i32, i: u64) -> i32 {
    let r = 0;
    if i < s.len {
        s = &s[0..0];
        r = s[i];
    }
    return r;
}

fn main() -> i32 {
    let a: [4]i32;
    a[0] = 10; a[1] = 20; a[2] = 30; a[3] = 40;
    let s = &a[0..4];
    return peek(s, 1);
}
