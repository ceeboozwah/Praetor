// @compile-error requires `lock`
// N11: a task's synchronized write does not permit an unsynchronized
// parent write — the interior rule fires on `m.value` directly.
struct Counter { value: i32 }
fn main() -> i32 {
    let m = mutex Counter { value: 0 };
    let t = spawn { let g = lock(m); g.value = 1; };
    m.value = 5;
    join t;
    return 0;
}
