// @exit 42
// N12: sibling handoff — t1's send lands in the shared endpoint's
// queue at spawn-end; t2's recv claims the same packet.
struct Point { x: i32, y: i32 }
fn main() -> i32 {
    let ch: channel &mut Point = channel();
    let x = Point { x: 0, y: 0 };
    let t1 = spawn {
        send(ch, &mut x);
    };
    let t2 = spawn {
        let g = recv(ch);
        (*g).x = 42;
    };
    join t1;
    join t2;
    return x.x;
}
