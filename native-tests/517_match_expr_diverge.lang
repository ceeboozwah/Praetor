// @exit 41
// N28 — a `=> return` arm diverges and drops out of the value join:
// the match's type is the live arm's alone.
import std.result;

fn f(r: result.Result<i32, i32>) -> i32 {
    let x = match r {
        Ok(v) => v,
        Err(e) => return 0 - e,
    };
    return x + 2;
}
fn main() -> i32 {
    let a = f(result.Result<i32, i32>::Ok(40));
    let b = f(result.Result<i32, i32>::Err(1));
    return a + b;   // 42 + (-1)
}
