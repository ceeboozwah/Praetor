// @exit -1
// N46 — a store inside the dominated block kills the fact it came
// from: `i < s.len` then `i = s.len` then `s[i]` keeps its check.

fn peek(s: slice i32, i: u64) -> i32 {
    if i < s.len {
        i = s.len;
        return s[i];
    }
    return 0;
}

fn main() -> i32 {
    let a: [4]i32;
    a[0] = 10; a[1] = 20; a[2] = 30; a[3] = 40;
    let s = &a[0..4];
    return peek(s, 1);
}
