// @exit 42
// N21B — std.mem: byte ops through the FFI boundary. `.ptr` hands
// over the span's pointer — `*mut i32` weakens to `*void`, `*const
// i32` to `*const void` (C's void* rule). The `&mut` slice borrows
// live inside a `region` so `b` is readable again afterwards.
import std.mem;

fn main() -> i32 {
    let heap = system_allocator();
    let src = alloc_slice<i32>(heap, 4);
    src[0] = 42;
    let dst = alloc_slice<i32>(heap, 4);
    dst[0] = 0;
    mem.copy(dst.ptr, src.ptr, 4); // one i32 = 4 bytes
    let a: [4]i32;
    a[0] = 3;
    a[1] = 0;
    a[2] = 0;
    a[3] = 0;
    let b: [4]i32;
    b[0] = 0; // seed the element family — the FFI write fills the rest
    region io {
        let bs = &mut b[0..4];
        let av = &a[0..4];
        mem.copy(bs.ptr, av.ptr, 16);
    }
    let four: u64 = 4;
    if mem.size<i32>() != four {
        return 1;
    }
    if dst[0] != 42 {
        return 2;
    }
    return dst[0] + b[0] - 3;
}
