// @exit -1
// @ir-has mml_range_check
// PLEX-0003 — the leaked fact lands in the SIBLING else branch: the
// then-arm kills `z ≡ 0` and pushes `i ≡ 0` below the mark, so the
// else inherits `i ≡ 0` it never established. `i` is really 20 at
// runtime; the range check must be emitted and must fire.
fn get_idx() -> u64 { return 20; }
fn never() -> u64 { return 99999; }
fn main() -> i32 {
    let a: [4]u8;
    a[0] = 1; a[1] = 2; a[2] = 3; a[3] = 4;
    let s = &a[0..4];
    let z: u64 = 0;
    let i = get_idx();
    if get_idx() == never() {
        z = get_idx();
        i = 0;
    } else {
        let k = &s[0..i];
        return i32(k.len);
    }
    return 0;
}
