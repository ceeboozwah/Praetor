// @compile-error wants a writable
// `s.ptr` on a shared slice yields `*const T` — a `*T` FFI param
// rejects it; the contract holds at the boundary.

extern fn memset(p: *void, c: i32, n: i64) -> *void;

fn main() -> i32 {
    let a: [4]i32;
    a[0] = 1;
    let s = &a[0..4];
    memset(s.ptr, 0, 8);
    return 0;
}
