// @exit 42
// N45R — passing to an `own` parameter transfers the authority: `p`
// is `sink`'s obligation, discharged inside by `free`.
fn sink(own p: box i32) -> i32 {
    let r = *p;
    free(p);
    return r;
}
fn main() -> i32 {
    let heap = system_allocator();
    let p = alloc<i32>(heap);
    *p = 42;
    return sink(p);
}
