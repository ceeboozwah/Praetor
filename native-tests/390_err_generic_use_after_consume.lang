// @compile-error use after consume
// The falsifiable proof: `id<box i32>`'s `own` param consumes `p`
// caller-side — identical to a concrete `fn(own p: box i32)`.

fn id<T>(own x: T) -> T {
    return x;
}

fn main() -> i32 {
    let heap = system_allocator();
    let p = alloc<i32>(heap);
    let q = id<box i32>(p);
    return *p;
}
