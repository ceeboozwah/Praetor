// @compile-error escapes its target's region
// N10: a task holding atomic storage may not outlive the region that
// owns it — same escape rule as N9.
fn main() -> i32 {
    let t: task i32;
    region frame {
        let c: atomic i32 = 0;
        t = spawn { atomic_add(c, 1); return 0; };
    }
    join t;
    return 0;
}
