// @compile-error cannot cross a spawn boundary
// N11: a guard bound in the parent has no meaning inside the child's
// window — it names parent-context authority.
struct Counter { value: i32 }
fn main() -> i32 {
    let m = mutex Counter { value: 0 };
    let g = lock(m);
    let t = spawn { g.value = 1; };
    join t;
    return 0;
}
