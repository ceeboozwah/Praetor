// @exit 42
// N46 — `i < s.len` dominates the body: `s[i]`'s bounds check is
// proven redundant and elided. Behavior is unchanged.

fn pick(s: slice i32, i: u64) -> i32 {
    if i < s.len {
        return s[i];
    }
    return 0;
}

fn main() -> i32 {
    let a: [4]i32;
    a[0] = 10; a[1] = 20; a[2] = 30; a[3] = 40;
    let s = &a[0..4];
    let r = pick(s, 2) + pick(s, 9);
    return r + 12;
}
