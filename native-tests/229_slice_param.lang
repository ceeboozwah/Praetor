// @exit 46
// A slice arg claims the span for the call's duration; release on
// return (unbound call form, like &mut params).

fn bump(s: slice mut i32) {
    s[0] = s[0] + 1;
    s[1] = s[1] + 1;
}

fn main() -> i32 {
    let a: [4]i32;
    a[0] = 40; a[1] = 1; a[2] = 3; a[3] = 4;
    bump(&mut a[0..2]);
    let t = &a[0..4];
    return t[0] - t[1] + a[2] + a[3];
}
