// @exit 42
// N24A — indexing a method call result: the Vec temp and the slice
// borrow both live exactly for the statement.

import std.vec;

fn mkv(h: alloc) -> vec.Vec<i32> {
    let v = vec.Vec<i32>::new(h);
    let v = v.push(33);
    let v = v.push(9);
    return v;
}

fn main() -> i32 {
    let heap = system_allocator();
    let tmp = mkv(heap);
    let s = tmp.as_slice();
    let r = s[0] + 9;
    consume s;
    tmp.destroy();
    return r;
}
