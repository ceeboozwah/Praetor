// @compile-error use after consume
// CHAN-004 S3b — `Err(v)` yields exactly one owner: `p` was
// consumed at the send and does NOT alias `v`.
fn main() -> i32 {
    let heap = system_allocator();
    let ch: bchannel box i32 = bchannel(1);
    let p0 = alloc<i32>(heap);
    *p0 = 1;
    let r1 = send(ch, p0);
    match r1 { Ok => {}, Err(v) => free(v) }
    let t = spawn { close(ch); };
    let p = alloc<i32>(heap);
    *p = 7;
    let r2 = send(ch, p);
    join t;
    match r2 {
        Ok => return 1,
        Err(v) => { let x = *p + *v; free(p); free(v); return x; }
    }
    return 0;
}
