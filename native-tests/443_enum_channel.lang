// @exit 42
// N22 — an enum moves through a channel: the `box Node` authority
// travels inside the `Some` variant's subtree and lands in the
// receiver's `match` — no enum-specific transport rules.
struct Node { v: i32 }

enum MaybeBox {
    None,
    Some(box Node),
}

fn main() -> i32 {
    let heap = system_allocator();
    let c: channel MaybeBox = channel();
    let p = alloc<Node>(heap);
    (*p).v = 42;
    let m = MaybeBox::Some(p);
    let t = spawn {
        let got = recv(c);
        let out = 0;
        match got {
            Some(v) => { out = (*v).v; }
            None => { out = 0; }
        }
        return out;
    };
    send(c, m);
    return join t;
}
