// @exit 42
// N54 — `continue` inside a nested `if` replays the body-scope defer
// on that edge too: total calls = 5 iterations regardless of which
// arm took the back-edge.
fn inc(write a: slice mut i64) -> void { a[0] = a[0] + 1; }
fn main() -> i32 {
    let a: [1]i64; a[0] = 0;
    let i = 0;
    while i < 5 {
        let s = &mut a[0..1];
        defer inc(s);
        if i < 4 { i = i + 1; continue; }
        i = i + 1;
    }
    if a[0] == 5 {
        return 42;
    }
    return 1;
}
