// @compile-error use of moved reference
// N52 — `&mut v.buf[..]` derives through the dead view — the borrow
// can't reanimate a moved claim.

struct V { buf: slice mut i64 }
fn main() -> i32 {
    let a: [4]i64; a[0] = 1;
    let v: V; v.buf = &mut a[0..4];
    let s = v.buf;
    let u = &mut v.buf[0..4];
    u[0] = 9;
    s[0] = 7;
    return i32(s[0]);
}
