// @exit 42
// N22 — variant state merges orthogonally to init: after an if/else
// assigning different cases, `x` is initialized but its case is
// unknown — `match` (here via `_`) is the way back to a payload.
enum Maybe<T> {
    None,
    Some(T),
}

fn main() -> i32 {
    let x: Maybe<i32>;
    let c = true;
    if c {
        x = Maybe<i32>::Some(40);
    } else {
        x = Maybe<i32>::None;
    }
    let r = 0;
    match x {
        Some(v) => { r = v + 2; }
        _ => { r = 1; }
    }
    return r;
}
