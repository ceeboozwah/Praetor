// @exit 42
// Orthogonality: `free` leaves the binding Init+Consumed — a second
// alloc resurrects it Init+Live. Consumed is not Uninitialized.

fn main() -> i32 {
    let heap = system_allocator();
    let p: box i32;
    p = alloc<i32>(heap);
    *p = 1;
    free(p);
    p = alloc<i32>(heap);
    *p = 42;
    return *p;
}
