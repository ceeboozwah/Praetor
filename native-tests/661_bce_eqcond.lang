// @exit 42
// N47 — a dominating `n == s.len` fact makes `i < n` prove
// `s[i]` inside the branch.

fn run(s: slice i32, n: u64) -> i32 {
    let r: i32 = 0;
    let i: u64 = 0;
    if n == s.len {
        while i < n {
            r = r + s[i];
            i = i + 1;
        }
    }
    return r;
}

fn main() -> i32 {
    let a: [4]i32;
    a[0] = 10; a[1] = 20; a[2] = 30; a[3] = 40;
    let s = &a[0..4];
    let r = run(s, 4) + run(s, 9);
    return r - 58;
}
