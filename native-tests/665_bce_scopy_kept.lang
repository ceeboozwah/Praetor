// @exit -1
// N47 — `let m = i64(n)` narrows u64→i64: not value-preserving
// for n > i64::MAX, so `m` gets no equality to `n`. The check
// under `i < u64(m) + 1` stays and traps past the slice end.

fn run(s: slice i32, n: u64) -> i32 {
    let m = i64(n);
    let i: u64 = 0;
    let r: i32 = 0;
    while i < u64(m) + 1 {
        r = r + s[i];
        i = i + 1;
    }
    return r;
}

fn main() -> i32 {
    let a: [4]i32;
    a[0] = 10; a[1] = 20; a[2] = 30; a[3] = 40;
    let s = &a[0..4];
    return run(s, 4);
}
