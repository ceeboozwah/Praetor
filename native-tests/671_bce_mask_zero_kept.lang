// @exit -1
// N48 — live trap, unproven domain: `cap` is a runtime parameter, so
// `cap > 0` is never established. At cap = 0 the mask wraps to
// u64::MAX, `h & mask == h == 99` and `slots[99]` is out of bounds.
// The check stays and traps — proving the refusal is semantic, not
// a syntax-match miss.

fn probe(slots: slice i32, cap: u64, h: u64) -> i32 {
    let mask = cap - 1;
    let idx = h & mask;
    return slots[idx];
}

fn main(args: slice str) -> i32 {
    let a: [4]i32;
    a[0] = 1; a[1] = 2; a[2] = 3; a[3] = 4;
    let s = &a[0..4];
    return probe(s, 0, 99);
}
