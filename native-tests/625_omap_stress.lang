// @exit 42
// N41 — OMap under load: 40 owned keys into a cap-8 table (rehash
// by slot memcpy — `kbuf` boxes relocate as handles, key BYTES stay
// put), tombstone deletes, tomb-reuse inserts, `box` values, drain.
import std.omap;
import std.result;
fn main() -> i32 {
    let heap = system_allocator();
    let m = omap.new<box i64>(heap, 8);
    let i: u64 = 0;
    while i < 40 {
        let kb = alloc_slice<u8>(heap, 4);
        kb[0] = 107;
        kb[1] = 48 + u8(i / 10);
        kb[2] = 48 + u8(i % 10);
        kb[3] = u8(97 + i % 26);
        let v = alloc<i64>(heap);
        *v = i64(i) * 3;
        match m.insert_kbuf(kb, v) {
            Fresh(mm) => { m = mm; }
            Replaced(o) => { o.m.free_storage(); free(o.v); return 1; }
            Full(o) => { o.m.free_storage(); free(o.v); return 1; }
        }
        i = i + 1;
    }
    let j: u64 = 0;
    while j < 40 {
        if j % 3 == 0 {
            let lb = alloc_slice<u8>(heap, 4);
            lb[0] = 107;
            lb[1] = 48 + u8(j / 10);
            lb[2] = 48 + u8(j % 10);
            lb[3] = u8(97 + j % 26);
            if true {
                let ks: str = str_from_utf8(&lb[0..4]);
                match m.remove(ks) {
                    Ok(v) => { free(v); }
                    Err(e) => { consume ks; free(lb); m.free_storage(); return 2; }
                }
            }
            free(lb);
        }
        j = j + 1;
    }
    let w: u64 = 40;
    while w < 52 {
        let kb = alloc_slice<u8>(heap, 4);
        kb[0] = 119;
        kb[1] = 48 + u8(w / 10);
        kb[2] = 48 + u8(w % 10);
        kb[3] = 90;
        let v = alloc<i64>(heap);
        *v = i64(w);
        match m.insert_kbuf(kb, v) {
            Fresh(mm) => { m = mm; }
            Replaced(o) => { o.m.free_storage(); free(o.v); return 3; }
            Full(o) => { o.m.free_storage(); free(o.v); return 3; }
        }
        w = w + 1;
    }
    let sum: i64 = 0;
    let t: u64 = 0;
    while t < 40 {
        let lb = alloc_slice<u8>(heap, 4);
        lb[0] = 107;
        lb[1] = 48 + u8(t / 10);
        lb[2] = 48 + u8(t % 10);
        lb[3] = u8(97 + t % 26);
        let gone = t % 3 == 0;
        let found = false;
        if true {
            let ks: str = str_from_utf8(&lb[0..4]);
            match m.get(ks) {
                Ok(v) => { found = true; sum = sum + **v; }
                Err(e) => { }
            }
        }
        if gone && found { free(lb); m.free_storage(); return 4; }
        if !gone && !found { free(lb); m.free_storage(); return 5; }
        free(lb);
        t = t + 1;
    }
    while true {
        match m.pop_entry() {
            Ok(e) => { free(e.kbuf); free(e.v); }
            Err(x) => { break; }
        }
    }
    m.free_storage();
    if i32(sum) != 1521 { return i32(sum % 200); }
    return 42;
}
