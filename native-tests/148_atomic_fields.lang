// @exit 2
// N10: atomic fields inside structs — `s.cnt` resolves to atomic
// storage; two tasks add through it.
struct Counter { cnt: atomic i32, data: i32 }
fn main() -> i32 {
    let s: Counter = Counter { cnt: 0, data: 0 };
    let t1 = spawn { atomic_add(s.cnt, 1); };
    let t2 = spawn { atomic_add(s.cnt, 1); };
    join t1;
    join t2;
    return atomic_load(s.cnt);
}
