// @exit -1
// N48 — stale-fact regression: at loop ENTRY `i == 0` and `s[i]` is
// safe, but the body writes `i = 99`. The back-edge cond must be
// re-evaluated under post-body facts — the check stays and traps on
// iteration 2. Before loop rotation this read unchecked garbage.

fn bad(s: slice i32) -> i32 {
    if s.len == 0 {
        return -1;
    }
    let i: u64 = 0;
    let r: i32 = 0;
    while s[i] != 0 {
        r = r + 1;
        i = 99;
    }
    return r;
}

fn main(args: slice str) -> i32 {
    let a: [4]i32;
    a[0] = 1; a[1] = 2; a[2] = 3; a[3] = 4;
    let s = &a[0..4];
    return bad(s);
}
