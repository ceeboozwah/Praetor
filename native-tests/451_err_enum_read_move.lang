// @compile-error cannot transfer own authority
// N22/N41 — `match` on a `read` param may inspect the tag, and the
// `Some(v)` binder now arrives as `&box Node` — a view of the live
// payload. Views still can't be consumed: `free(*v)` would reach
// the box through a read borrow.
struct Node { v: i32 }

enum MaybeBox {
    None,
    Some(box Node),
}

fn take(read m: MaybeBox) -> i32 {
    match m {
        Some(v) => { free(*v); return 0; }
        None => { return 0; }
    }
}

fn main() -> i32 {
    let heap = system_allocator();
    let p = alloc<Node>(heap);
    (*p).v = 42;
    let m = MaybeBox::Some(p);
    return take(m);
}
