// @exit 42
// N46 — inside `a && b`, `b` runs only when `a` held: `s[i]` on the
// rhs of `i < s.len &&` is dominated by the bound.

fn find(s: slice i32, i: u64, v: i32) -> i32 {
    if i < s.len && s[i] == v {
        return i32(i);
    }
    return -1;
}

fn main() -> i32 {
    let a: [4]i32;
    a[0] = 10; a[1] = 20; a[2] = 30; a[3] = 40;
    let s = &a[0..4];
    return find(s, 3, 40) + find(s, 9, 99) + 40;
}
