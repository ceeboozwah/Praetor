// @compile-error authority was sent through a channel
// N12: even inside a sibling task, channel-held authority is not
// ordinary storage — the transit set follows the place key.
struct Point { x: i32, y: i32 }
fn main() -> i32 {
    let ch: channel &mut Point = channel();
    let x = Point { x: 0, y: 0 };
    let t1 = spawn {
        send(ch, &mut x);
    };
    let t2 = spawn {
        x.x = 20;
    };
    join t1;
    join t2;
    return 0;
}
