// @compile-error cannot leave scope
// N45R — `break` unwinds the loop-body scope: `p` is live on the
// break path.
fn main() -> i32 {
    let heap = system_allocator();
    while true {
        let p = alloc<i32>(heap);
        *p = 0;
        if *p == 0 { break; }
        free(p);
    }
    return 42;
}
