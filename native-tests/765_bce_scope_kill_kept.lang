// @exit -1
// @ir-has mml_range_check
// PLEX-0003 — a fact-kill inside a marked branch must not let a
// later branch-local push slide below the truncate mark. `z` holds
// `z ≡ 0`; `z = get_idx()` kills it with no replacement push, so
// `i = 0`'s efact used to occupy the vacated slot and survive the
// end-of-branch truncate — the merge then believed `i ≡ 0` and
// elided the range check on `&s[0..i]` even though `i` is really 20.
// Fixed: kills tombstone in place; the check must stay and fire.
fn get_idx() -> u64 { return 20; }
fn never() -> u64 { return 99999; }
fn main() -> i32 {
    let a: [4]u8;
    a[0] = 1; a[1] = 2; a[2] = 3; a[3] = 4;
    let s = &a[0..4];
    let z: u64 = 0;
    let i = get_idx();
    if get_idx() == never() {
        z = get_idx();
        i = 0;
    }
    let k = &s[0..i];
    return i32(k.len);
}
