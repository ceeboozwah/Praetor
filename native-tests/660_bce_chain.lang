// @exit 42
// N47 — equality chains through copies: `m == n == s.len` makes
// `while i < m` prove `s[i]`.

fn run(s: slice i32) -> i32 {
    let n = s.len;
    let m = n;
    let i: u64 = 0;
    let r: i32 = 0;
    while i < m {
        r = r + s[i];
        i = i + 1;
    }
    return r;
}

fn main() -> i32 {
    let a: [4]i32;
    a[0] = 10; a[1] = 20; a[2] = 30; a[3] = 40;
    let s = &a[0..4];
    let r = run(s);
    return r - 58;
}
