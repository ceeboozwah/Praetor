// @exit 42
// N31 fix — a call scrutinee's argument temps must expire with the
// call, not live through the arms. `wrap(v.as_slice())` lowers the
// slice arg to a stmt-level `$rv` temp whose Read edge into `v` used
// to block `v.destroy()` after the match.

import std.vec;
import std.result;

fn wrap(s: slice u8) -> result.Result<i32, i32> {
    return result.Result<i32, i32>::Ok(i32(s.len));
}

fn main() -> i32 {
    let heap = system_allocator();
    let x: u8 = 7;
    let v = vec.Vec<u8>::new(heap).push(x);
    let n = match wrap(v.as_slice()) {
        Ok(n) => n,
        Err(e) => { return e; }
    };
    v.destroy();
    return 41 + n;
}
