// @exit -1
// N46 — `||` alternatives can't be assumed together: inside
// `i == 7 || i < s.len`, `s[i]` on the first alternative keeps its
// check — the bound isn't dominating here.

fn peek(s: slice i32, i: u64) -> i32 {
    if i == 7 || i < s.len {
        return s[i];
    }
    return 0;
}

fn main() -> i32 {
    let a: [4]i32;
    a[0] = 10; a[1] = 20; a[2] = 30; a[3] = 40;
    let s = &a[0..4];
    return peek(s, 7);
}
