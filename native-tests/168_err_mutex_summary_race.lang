// @compile-error requires `lock`
// N11 x N8: a task's synchronized interior write (replayed through the
// summary) still forbids the parent's unguarded interior write.
struct Counter { value: i32 }
fn update(write m: mutex Counter) {
    let g = lock(m);
    g.value = g.value + 1;
    unlock(g);
}
fn main() -> i32 {
    let m = mutex Counter { value: 0 };
    let t = spawn { update(m); };
    m.value = 5;
    join t;
    return 0;
}
