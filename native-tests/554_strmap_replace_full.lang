// @exit 42
// N34A: `Replaced` hands the old value back (no silent drops) and a
// saturated fixed-cap table returns `Put::Full` — map AND value —
// instead of overflowing or panicking.
import std.map;
import std.result;

fn g(read m: map.StrMap<i64>, k: str) -> i64 {
    match m.get(k) {
        Ok(v) => { return *v; }
        Err(e) => { return -1; }
    }
    return -2;
}

fn main() -> i32 {
    let heap = system_allocator();
    let m = map.new<i64>(heap, 8);
    let r: i32 = 0;
    // fill all 8 slots
    match m.insert("a", i64(1)) { Fresh(mm) => { m = mm; } _ => { return 1; } }
    match m.insert("i", i64(2)) { Fresh(mm) => { m = mm; } _ => { return 1; } }
    match m.insert("q", i64(3)) { Fresh(mm) => { m = mm; } _ => { return 1; } }
    match m.insert("y", i64(4)) { Fresh(mm) => { m = mm; } _ => { return 1; } }
    match m.insert("b", i64(5)) { Fresh(mm) => { m = mm; } _ => { return 1; } }
    match m.insert("c", i64(6)) { Fresh(mm) => { m = mm; } _ => { return 1; } }
    match m.insert("d", i64(7)) { Fresh(mm) => { m = mm; } _ => { return 1; } }
    match m.insert("z", i64(8)) { Fresh(mm) => { m = mm; } _ => { return 1; } }
    if m.len() != 8 { return 2; }
    // replace "a" — old value 1 comes back, new value reads out
    match m.insert("a", i64(30)) {
        Replaced(o) => {
            m = o.m;
            r = r + i32(o.v);                       // 1
        }
        _ => { return 3; }
    }
    if g(m, "a") != 30 { return 4; }
    if m.len() != 8 { return 5; }                   // replace keeps len
    // 9th insert into a full table — Put::Full returns map + value
    match m.insert("zz", i64(99)) {
        Full(o) => {
            m = o.m;
            r = r + i32(o.v % 60);                  // 39
        }
        _ => { return 6; }
    }
    if m.len() != 8 { return 7; }
    m.free_storage();
    return r + 2;                                   // 1+39+2 = 42
}
