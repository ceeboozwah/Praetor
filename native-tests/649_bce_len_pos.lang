// @exit 42
// N46 — `s.len > 0` proves `s[0]` in range: a const-lo bound
// (`0 < len`) covers the literal index.

fn head(s: slice i32) -> i32 {
    if s.len > 0 {
        return s[0];
    }
    return 0;
}

fn main() -> i32 {
    let a: [4]i32;
    a[0] = 10; a[1] = 20; a[2] = 30; a[3] = 40;
    let s = &a[0..4];
    return head(s) + head(&a[0..0]) + 32;
}
