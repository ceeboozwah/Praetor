// stdlib/mem — N21B. Raw byte ops over libc, plus `size<T>()` as the
// named spelling of `sizeof<T>`. Pointer-level on purpose: authority
// travels with the `*T`/`*const T` claim, exactly like any other FFI
// boundary — `dst`'s `*void` carries Write on the span.
//
//   copy / set / shift   — memcpy / memset / memmove
//   size<T>()            — sizeof<T> — element bytes, for stride math

extern fn memcpy(dst: *void, src: *const void, n: u64) -> *void;
extern fn memset(dst: *void, c: i32, n: u64) -> *void;
extern fn memmove(dst: *void, src: *const void, n: u64) -> *void;

pub fn copy(dst: *void, src: *const void, n: u64) {
    memcpy(dst, src, n);
}

pub fn set(dst: *void, byte: i32, n: u64) {
    memset(dst, byte, n);
}

pub fn shift(dst: *void, src: *const void, n: u64) {
    memmove(dst, src, n);
}

pub fn size<T>() -> u64 {
    return sizeof<T>;
}
