// stdlib/thread — N21B. `spawn`/`join` deliberately stay language
// syntax, not functions: task tokens are region-bound in the
// checker's task table, so they cannot cross a call boundary — a
// `thread.join(t)` wrapper would have to fabricate that tracking,
// which is exactly the kind of hidden semantics this module layer
// refuses. What CAN cross a boundary: the OS-level sched calls.

extern fn sched_yield() -> i32;
extern fn usleep(usec: i32) -> i32;

// Give the scheduler a turn. The return is discarded — yield is a
// hint, never an error contract.
pub fn yield_now() {
    sched_yield();
}

// Sleep at least `us` microseconds (POSIX usleep semantics).
pub fn sleep_us(us: i32) {
    usleep(us);
}
