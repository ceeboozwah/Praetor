// stdlib/vec — N19C/N20. The N16B vector, now type-parametric AND
// method-callable: one `Vec<T>` serves every element type, every
// instantiation inherits the whole authority model unchanged, and
// `v.push(x)` desugars to `vec.push(v, x)` — the `self` receiver is
// an ordinary capability parameter, so method syntax can never hide
// an ownership cost.
//
//   new                       Vec<T>::new(heap)
//   push / destroy            own self  — realloc may free the root;
//                                        destroy consumes it
//   pop                       write self — mutates, cannot destroy
//   as_slice                  read self  — installs a Read edge
//   as_mut                    write self — installs a Write edge
// A live slice view therefore blocks push/free/mut at ANY T — the
// same rule under method syntax as under function syntax.

extern fn memcpy(dst: *void, src: *const void, n: u64) -> *void;

pub struct Vec<T> { buf: box slice T, len: u64, cap: u64, heap: alloc }

pub fn new<T>(heap: alloc) -> Vec<T> {
    let v: Vec<T>;
    v.buf = alloc_slice<T>(heap, 4);
    v.len = 0;
    v.cap = 4;
    v.heap = heap;
    return v;
}

pub fn push<T>(own self: Vec<T>, x: T) -> Vec<T> {
    if self.len == self.cap {
        let ncap = self.cap * 2;
        let nb = alloc_slice<T>(self.heap, ncap);
        memcpy(nb.ptr, self.buf.ptr, self.len * sizeof<T>);
        free(self.buf);
        self.buf = nb;
        self.cap = ncap;
    }
    self.buf[self.len] = x;
    self.len = self.len + 1;
    return self;
}

pub fn pop<T>(write self: Vec<T>) -> T {
    self.len = self.len - 1;
    return self.buf[self.len];
}

pub fn as_slice<T>(read self: Vec<T>) -> slice T {
    return &self.buf[0..self.len];
}

pub fn as_mut<T>(write self: Vec<T>) -> slice mut T {
    return &mut self.buf[0..self.len];
}

pub fn destroy<T>(own self: Vec<T>) {
    free(self.buf);
}
