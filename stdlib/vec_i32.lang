/// stdlib/vec_i32 — N16B. A growable vector written in the language
/// itself: no compiler magic, just `box slice` + explicit authority.
///
/// The authority split IS the API contract:
///   vec_push / vec_free   own  — realloc may free the root; free destroys it
///   vec_pop               write — mutates, cannot destroy
///   vec_as_slice          read — installs a Read edge on the buffer
///   vec_as_mut            write — installs a Write edge on the buffer
/// A live slice view therefore blocks push/free/mut — invalidation
/// safety is the ordinary borrow rule, not an iterator rule.

extern fn memcpy(dst: *void, src: *const void, n: u64) -> *void;

pub struct Vec { buf: box slice i32, len: u64, cap: u64, heap: alloc }

pub fn vec_new(heap: alloc) -> Vec {
    let v: Vec;
    v.buf = alloc_slice<i32>(heap, 4);
    v.len = 0;
    v.cap = 4;
    v.heap = heap;
    return v;
}

pub fn vec_push(own v: Vec, x: i32) -> Vec {
    if v.len == v.cap {
        let ncap = v.cap * 2;
        let nb = alloc_slice<i32>(v.heap, ncap);
        memcpy(nb.ptr, v.buf.ptr, v.len * 4);
        free(v.buf);
        v.buf = nb;
        v.cap = ncap;
    }
    v.buf[v.len] = x;
    v.len = v.len + 1;
    return v;
}

pub fn vec_pop(write v: Vec) -> i32 {
    v.len = v.len - 1;
    return v.buf[v.len];
}

pub fn vec_as_slice(read v: Vec) -> slice i32 {
    return &v.buf[0..v.len];
}

pub fn vec_as_mut(write v: Vec) -> slice mut i32 {
    return &mut v.buf[0..v.len];
}

pub fn vec_free(own v: Vec) {
    free(v.buf);
}
