// stdlib/math — N21B. Integer helpers. Deliberately concrete `i32`
// signatures: it is the language's default int, so literal arguments
// (`math.abs(0 - 4)`) type-check without annotations. A generic
// `min<T>` would instantiate cleanly only where `<` exists on T, and
// silent per-T acceptance is the wrong contract for a math module —
// widen later if the corpus asks for it.

pub fn abs(n: i32) -> i32 {
    if n < 0 {
        return 0 - n;
    }
    return n;
}

pub fn min(a: i32, b: i32) -> i32 {
    if a < b {
        return a;
    }
    return b;
}

pub fn max(a: i32, b: i32) -> i32 {
    if a > b {
        return a;
    }
    return b;
}

pub fn clamp(x: i32, lo: i32, hi: i32) -> i32 {
    return min(max(x, lo), hi);
}

pub fn pow(base: i32, exp: i32) -> i32 {
    let r = 1;
    let i = 0;
    while i < exp {
        r = r * base;
        i = i + 1;
    }
    return r;
}
