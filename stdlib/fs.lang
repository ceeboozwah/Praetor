/// stdlib/fs — N21B + N30A + N58B. fd I/O. `open` takes PORTABLE flag
/// bits — `o_read()`/`o_write()`/`o_create()`/`o_trunc()`/`o_append()`
/// — which the runtime maps to the host's O_* constants (O_CREAT is
/// 0x40 on Linux, 0x200 on macOS — raw numbers never cross into
/// .lang source). fd I/O is always untranslated.
///
///   fd_open / fd_read / fd_write / fd_close
///       RAW layer — bare return codes, no error values. `fd_open`
///       takes the HOST's flag bits — an escape hatch, not the
///       portable path.
///   open / read / write / close
///       N30 — the Result layer: `fs.open(p, f, m)?` and friends.
///       `Err` carries errno (mml_errno — thread-local, read right
///       after the failed call); `Ok` carries the fd or byte count.
///       Ordinary library code — no compiler machinery.
///   read_all(heap, fd) / slurp(heap, path)
///       raw-layer drains; `slurp` on failure yields an empty Vec.
///   slurp_r(heap, path)
///       the Result-layer slurp: open failure is `Err(errno)`.

import std.vec;
import std.result;
import std.path;

// Host-aware path byte helpers — unqualified copies because every
// fn below names its argument `path`, shadowing the module.
fn hsep() -> u8 { return path.hsep(); }
fn is_hsep(b: u8) -> u8 { return path.is_hsep(b); }
fn rootlen(p: slice u8) -> u64 { return path.root_len(p); }

/// open(2) is variadic — a fixed-arity extern decl drops `mode` on
/// some ABIs (observed: O_CREAT produced mode-0000 files). The
/// runtime's fixed-arity shim makes the real variadic call (N24C).
extern fn mml_fd_open_mode(path: *const u8, flags: i32, mode: i32) -> i32;
/// N58B — same call but `oflags` is the portable MML_OF_* bit set:
/// the runtime translates, so callers never name a host O_* value.
extern fn mml_fd_open_flags(path: *const u8, oflags: i32, mode: i32) -> i32;
/// N30/N58C — the Result layer owns `read`/`write`/`close`, so the
/// libc spellings cross behind mml_fd_ boundary names: the fd
/// namespace is never confused with the mml_sock_ socket one.
extern fn mml_fd_read(fd: i32, buf: *void, n: u64) -> i64;
extern fn mml_fd_write(fd: i32, buf: *const void, n: u64) -> i64;
extern fn mml_fd_close(fd: i32) -> i32;
extern fn mml_errno() -> i32;

/// The portable open-mode bits `open` accepts. Values are a small
/// private vocabulary the runtime translates — `fs.o_write() |
/// fs.o_create() | fs.o_trunc()` is "create or truncate for writing"
/// on every host. (No `o_binary`: binary is the only mode.)
pub fn o_read() -> i32 {
    return 1;
}
pub fn o_write() -> i32 {
    return 2;
}
pub fn o_create() -> i32 {
    return 4;
}
pub fn o_trunc() -> i32 {
    return 8;
}
pub fn o_append() -> i32 {
    return 16;
}

/// HOST flag bits — `fd_open` keeps the raw POSIX contract as an
/// escape hatch; portable code should use `open` + `o_*` instead.
pub fn fd_open(path: *const u8, flags: i32, mode: i32) -> i32 {
    return mml_fd_open_mode(path, flags, mode);
}

/// Wrappers take slices, not `&mut`: the `&`-to-`*T` contract is an
/// extern-call rule — an ordinary fn's `*void` param can't fabricate
/// a pointer from a reference. `buf.ptr` crosses inside.
pub fn fd_read(fd: i32, buf: slice mut u8, n: u64) -> i64 {
    return mml_fd_read(fd, buf.ptr, n);
}

pub fn fd_write(fd: i32, buf: slice u8, n: u64) -> i64 {
    return mml_fd_write(fd, buf.ptr, n);
}

pub fn fd_close(fd: i32) {
    mml_fd_close(fd);
}

// ---- N30A — the Result layer ------------------------------------
// Negative returns become `Err(errno)`; everything else is `Ok`.
// EOF is `Ok(0)`, not an error — a short/zero read is a value.

pub fn open(path: *const u8, flags: i32, mode: i32) -> result.Result<i32, i32> {
    let fd = mml_fd_open_flags(path, flags, mode);
    if fd < 0 {
        return result.Result<i32, i32>::Err(mml_errno());
    }
    return result.Result<i32, i32>::Ok(fd);
}

/// The `slice mut` claim is a parameter, not a capture — it ends at
/// the return, so `fs.read(fd, &mut b[..], n)?` frees `b` again.
pub fn read(fd: i32, buf: slice mut u8, n: u64) -> result.Result<i64, i32> {
    let r = mml_fd_read(fd, buf.ptr, n);
    if r < 0 {
        return result.Result<i64, i32>::Err(mml_errno());
    }
    return result.Result<i64, i32>::Ok(r);
}

pub fn write(fd: i32, buf: slice u8, n: u64) -> result.Result<i64, i32> {
    let r = mml_fd_write(fd, buf.ptr, n);
    if r < 0 {
        return result.Result<i64, i32>::Err(mml_errno());
    }
    return result.Result<i64, i32>::Ok(r);
}

pub fn close(fd: i32) -> result.Result<i32, i32> {
    let r = mml_fd_close(fd);
    if r < 0 {
        return result.Result<i32, i32>::Err(mml_errno());
    }
    return result.Result<i32, i32>::Ok(r);
}

/// `open` + `read_all` + `close` with real errors: the fd outlives
/// the call only as far as the caller keeps it.
pub fn slurp_r(heap: alloc, path: *const u8) -> result.Result<vec.Vec<u8>, i32> {
    let fd = open(path, o_read(), 0)?;
    let v = read_all(heap, fd);
    let cr = close(fd);
    match cr {
        Err(e) => { v.destroy(); return result.Result<vec.Vec<u8>, i32>::Err(e); }
        Ok(_) => {}
    }
    return result.Result<vec.Vec<u8>, i32>::Ok(v);
}

// ---- raw-layer convenience (unchanged contract) -----------------

/// Drain `fd` into a fresh Vec<u8>. `&mut buf[0]` hands `read` a Write
/// claim on the scratch array's span for the call's duration; `buf[0]
/// = 0` seeds the element family's init certificate — the checker
/// can't see the syscall's stores, so the seed keeps later reads
/// honest.
pub fn read_all(heap: alloc, fd: i32) -> vec.Vec<u8> {
    let v = vec.Vec<u8>::new(heap);
    let buf: [512]u8;
    buf[0] = 0;
    let n = mml_fd_read(fd, &mut buf[0], 512);
    while n > 0 {
        let i: i64 = 0;
        while i < n {
            v = v.push(buf[i]);
            i = i + 1;
        }
        n = mml_fd_read(fd, &mut buf[0], 512);
    }
    return v;
}

pub fn slurp(heap: alloc, path: *const u8) -> vec.Vec<u8> {
    let fd = mml_fd_open_flags(path, 1, 0);
    if fd < 0 {
        return vec.Vec<u8>::new(heap);
    }
    let v = read_all(heap, fd);
    mml_fd_close(fd);
    return v;
}

// ---- directories (N65A) ---------------------------------------------

/// One directory entry — pure POD, so `DirEnt` copies and a Vec of
/// them sorts in place. `off`/`len` index the owning `DirList`'s
/// `buf`; `kind` is 1 file, 2 dir, 0 other.
pub struct DirEnt {
    off: u64,
    len: u64,
    kind: i32,
}

/// A directory's contents: every name packed into `buf` (entries
/// point into it, so `ents` stays POD), sorted byte-wise by name —
/// enumeration order is host-dependent, the sorted view is the
/// deterministic contract. Tear down with `free_dir_list`.
pub struct DirList {
    buf: vec.Vec<u8>,
    ents: vec.Vec<DirEnt>,
}

extern fn mml_dir_open(path: *const u8, len: i64) -> i64;
extern fn mml_dir_next(dh: i64, name: * *const u8, nlen: *i64,
                       kind: *i32) -> i32;
extern fn mml_dir_close(dh: i64) -> i32;
extern fn mml_mkdir(path: *const u8, len: i64, mode: i32) -> i32;
extern fn mml_remove(path: *const u8, len: i64) -> i32;

/// Entry count — same value as `dl.ents.len`; the accessor is the
/// stable surface (Vec internals aren't the directory contract).
pub fn dir_len(read dl: DirList) -> u64 {
    return dl.ents.len;
}

/// The i-th entry in sorted order — POD copy, bounds like indexing.
pub fn dir_ent(read dl: DirList, i: u64) -> DirEnt {
    return dl.ents.as_slice()[i];
}

/// The entry's name as `str` — borrows `dl`; a `DirEnt` is only
/// meaningful against its owning list.
pub fn ent_name(read dl: DirList, e: DirEnt) -> str {
    let b = dl.buf.as_slice();
    return str_from_utf8(&b[e.off..e.off + e.len]);
}

/// Create one directory (mode 0o755). EEXIST is an error like any
/// other — the caller decides if it's benign.
pub fn mkdir(path: str) -> result.Result<i32, i32> {
    let st = mml_mkdir(path.bytes.ptr, i64(path.len), 493);
    if st < 0 {
        return result.Result<i32, i32>::Err(0 - st);
    }
    return result.Result<i32, i32>::Ok(0);
}

/// Delete a file or an empty directory (POSIX remove() semantics).
pub fn remove(path: str) -> result.Result<i32, i32> {
    let st = mml_remove(path.bytes.ptr, i64(path.len));
    if st < 0 {
        return result.Result<i32, i32>::Err(0 - st);
    }
    return result.Result<i32, i32>::Ok(0);
}

fn name_lt(s: slice u8, a: DirEnt, b: DirEnt) -> bool {
    let n = a.len;
    if b.len < n {
        n = b.len;
    }
    let i: u64 = 0;
    while i < n {
        if s[a.off + i] != s[b.off + i] {
            return s[a.off + i] < s[b.off + i];
        }
        i = i + 1;
    }
    return a.len < b.len;
}

/// Enumerate `path` into a sorted DirList. Errors: Err(errno) on
/// open/scan failure. "." and ".." never appear; names that are not
/// valid UTF-8 are invisible (every `str` is valid UTF-8).
pub fn read_dir(heap: alloc, path: str) -> result.Result<DirList, i32> {
    let dh = mml_dir_open(path.bytes.ptr, i64(path.len));
    if dh < 0 {
        return result.Result<DirList, i32>::Err(i32(0 - dh));
    }
    let dl = DirList {
        buf: vec.Vec<u8>::new(heap),
        ents: vec.Vec<DirEnt>::new(heap),
    };
    let st: i32 = 1;
    while st > 0 {
        let p: *const u8 = 0;
        let n: i64 = 0;
        let k: i32 = 0;
        st = mml_dir_next(dh, &mut p, &mut n, &mut k);
        if st == 1 {
            let e = DirEnt {
                off: dl.buf.len,
                len: u64(n),
                kind: k,
            };
            let pv: slice u8 = slice(p, n);
            let i: i64 = 0;
            while i < n {
                dl.buf = dl.buf.push(pv[i]);
                i = i + 1;
            }
            dl.ents = dl.ents.push(e);
        }
    }
    let cr = mml_dir_close(dh);
    if st < 0 || cr < 0 {
        dl.buf.destroy();
        dl.ents.destroy();
        let e = 0 - cr;
        if st < 0 {
            e = 0 - st;
        }
        return result.Result<DirList, i32>::Err(e);
    }
    // Byte-wise insertion sort — `ents` is POD, so plain swaps move
    // it (the borrowed `buf` is only read, sibling claim).
    let i: u64 = 1;
    while i < dl.ents.len {
        let s = dl.ents.as_mut();
        let j: u64 = i;
        while j > 0 && name_lt(dl.buf.as_slice(), s[j], s[j - 1]) {
            let t = s[j];
            s[j] = s[j - 1];
            s[j - 1] = t;
            j = j - 1;
        }
        i = i + 1;
    }
    return result.Result<DirList, i32>::Ok(dl);
}

pub fn free_dir_list(own dl: DirList) {
    dl.buf.destroy();
    dl.ents.destroy();
}

/// N70 — canonicalize `path`: absolute, `.`/`..`/symlinks resolved
/// (POSIX realpath, Win32 GetFinalPathNameByHandle). Err(errno) when
/// it doesn't resolve; Ok owns the resolved bytes (a path is bytes,
/// not necessarily UTF-8 — callers validate if they need `str`).
extern fn mml_realpath(path: *const u8, len: i64,
                       buf: *u8, cap: i64) -> i64;
pub fn realpath(heap: alloc, path: slice u8) -> result.Result<vec.Vec<u8>, i32> {
    let buf: [8192]u8;
    buf[0] = 0;
    let n = mml_realpath(path.ptr, i64(path.len),
                         &mut buf[0], 8192);
    if n < 0 {
        return result.Result<vec.Vec<u8>, i32>::Err(i32(0 - n));
    }
    let v = vec.Vec<u8>::new(heap);
    let i: i64 = 0;
    while i < n {
        v = v.push(buf[i]);
        i = i + 1;
    }
    return result.Result<vec.Vec<u8>, i32>::Ok(v);
}

/// What `path` points at: 1 = regular file, 2 = directory, 0 = other,
/// negative = -errno (ENOENT when it doesn't exist).
extern fn mml_path_kind(path: *const u8, len: i64) -> i32;
pub fn path_kind(path: slice u8) -> i32 {
    return mml_path_kind(path.ptr, i64(path.len));
}

/// Host error text for an errno — Rust's io::Error Display spells it
/// `{strerror} (os error {n})`; the loader needs that spelling for
/// `read_to_string` failures.
extern fn mml_strerror(e: i32, buf: *u8, cap: i64) -> i64;
pub fn strerror(heap: alloc, e: i32) -> vec.Vec<u8> {
    let buf: [512]u8;
    buf[0] = 0;
    let n = mml_strerror(e, &mut buf[0], 512);
    let v = vec.Vec<u8>::new(heap);
    let i: i64 = 0;
    while i >= 0 && i < n {
        v = v.push(buf[i]);
        i = i + 1;
    }
    return v;
}

/// N81 — `mml_rename`: move `from` to `to`, replacing an existing
/// `to` (POSIX rename(2)). The dep cache's tmp→final swap.
extern fn mml_rename(from: *const u8, flen: i64,
                     to: *const u8, tlen: i64) -> i32;
pub fn rename(from: slice u8, to: slice u8) -> result.Result<i32, i32> {
    let st = mml_rename(from.ptr, i64(from.len), to.ptr, i64(to.len));
    if st < 0 {
        return result.Result<i32, i32>::Err(0 - st);
    }
    return result.Result<i32, i32>::Ok(0);
}

/// `path` is a directory / regular file — path_kind shorthands.
pub fn is_dir(path: slice u8) -> bool {
    return path_kind(path) == 2;
}
pub fn is_file(path: slice u8) -> bool {
    return path_kind(path) == 1;
}
/// Any kind at all (incl. 0-kinds) — Rust's `Path::exists`.
pub fn exists(path: slice u8) -> bool {
    return path_kind(path) >= 0;
}

/// Raw-pointer variants — no slice borrow, so the answer doesn't
/// keep the path owner alive. For callers that must destroy the
/// path inside the same scope (checker borrow regions).
pub fn path_kind_p(p: *const u8, n: i64) -> i32 {
    return mml_path_kind(p, n);
}
pub fn is_dir_p(p: *const u8, n: i64) -> bool {
    return mml_path_kind(p, n) == 2;
}
pub fn is_file_p(p: *const u8, n: i64) -> bool {
    return mml_path_kind(p, n) == 1;
}
pub fn exists_p(p: *const u8, n: i64) -> bool {
    return mml_path_kind(p, n) >= 0;
}

/// `create_dir_all` — every separator-prefixed ancestor plus `path`
/// itself; EEXIST is benign at every level (s0's scaffold and the
/// dep cache both need it). `path` empty → Ok. Both separators count
/// on Windows (`C:\a\b` splits too), matching std.path.is_hsep.
/// N79C #10: ancestors are only prefixes LONGER than the path root —
/// std.path.root_len names `\\?\C:\`, `\\?\UNC\s\sh\`, `\\s\sh\`,
/// `C:\`, `\`, `C:` as roots, none of which mkdir can create (a
/// verbatim path's first prefix is `\`, not a directory).
pub fn mkdir_all(heap: alloc, path: slice u8) -> result.Result<i32, i32> {
    let root = rootlen(path);
    let i: u64 = 0;
    while i < path.len {
        if is_hsep(path[i]) == 1 && i > root {
            match mkdir(str_from_utf8(&path[0..i])) {
                Ok(_) => {}
                Err(e) => {
                    // EEXIST(17 POSIX / 183 win is is_dir-checkable)
                    if !is_dir(&path[0..i]) {
                        return result.Result<i32, i32>::Err(e);
                    }
                }
            }
        }
        i = i + 1;
    }
    match mkdir(str_from_utf8(path)) {
        Ok(_) => { return result.Result<i32, i32>::Ok(0); }
        Err(e) => {
            if is_dir(path) {
                return result.Result<i32, i32>::Ok(0);
            }
            return result.Result<i32, i32>::Err(e);
        }
    }
}

/// `remove_dir_all` — recursive remove: children first, the dir
/// last. Missing paths are Ok (s0's remove_dir_all Errs on ENOENT —
/// callers that tolerate absence guard with exists() first).
pub fn remove_tree(heap: alloc, path: str) -> result.Result<i32, i32> {
    if is_dir(path.bytes) {
        match read_dir(heap, path) {
            Err(e) => { return result.Result<i32, i32>::Err(e); }
            Ok(dl) => {
                let i: u64 = 0;
                let fail: i32 = 0;
                while i < dir_len(dl) {
                    let e = dir_ent(dl, i);
                    let nm = ent_name(dl, e);
                    let sub = vec.Vec<u8>::new(heap);
                    sub = cat_slice(sub, path.bytes);
                    if sub.len > 0
                            && is_hsep(sub.buf[sub.len - 1]) == 0 {
                        sub = sub.push(hsep());
                    }
                    sub = cat_slice(sub, nm.bytes);
                    if e.kind == 2 {
                        match remove_tree(heap, str_from_utf8(sub.as_slice())) {
                            Ok(_) => {}
                            Err(x) => { if fail == 0 { fail = x; } }
                        }
                    } else {
                        match remove(str_from_utf8(sub.as_slice())) {
                            Ok(_) => {}
                            Err(x) => { if fail == 0 { fail = x; } }
                        }
                    }
                    sub.destroy();
                    i = i + 1;
                }
                free_dir_list(dl);
                if fail != 0 {
                    return result.Result<i32, i32>::Err(fail);
                }
            }
        }
    }
    return remove(path);
}

fn cat_slice(own v: vec.Vec<u8>, b: slice u8) -> vec.Vec<u8> {
    let i: u64 = 0;
    while i < u64(b.len) {
        v = v.push(b[i]);
        i = i + 1;
    }
    return v;
}
