/// stdlib/fs — N21B + N30A + N58B. fd I/O. `open` takes PORTABLE flag
/// bits — `o_read()`/`o_write()`/`o_create()`/`o_trunc()`/`o_append()`
/// — which the runtime maps to the host's O_* constants (O_CREAT is
/// 0x40 on Linux, 0x200 on macOS — raw numbers never cross into
/// .lang source). fd I/O is always untranslated.
///
///   fd_open / fd_read / fd_write / fd_close
///       RAW layer — bare return codes, no error values. `fd_open`
///       takes the HOST's flag bits — an escape hatch, not the
///       portable path.
///   open / read / write / close
///       N30 — the Result layer: `fs.open(p, f, m)?` and friends.
///       `Err` carries errno (mml_errno — thread-local, read right
///       after the failed call); `Ok` carries the fd or byte count.
///       Ordinary library code — no compiler machinery.
///   read_all(heap, fd) / slurp(heap, path)
///       raw-layer drains; `slurp` on failure yields an empty Vec.
///   slurp_r(heap, path)
///       the Result-layer slurp: open failure is `Err(errno)`.

import std.vec;
import std.result;

/// open(2) is variadic — a fixed-arity extern decl drops `mode` on
/// some ABIs (observed: O_CREAT produced mode-0000 files). The
/// runtime's fixed-arity shim makes the real variadic call (N24C).
extern fn mml_fd_open_mode(path: *const u8, flags: i32, mode: i32) -> i32;
/// N58B — same call but `oflags` is the portable MML_OF_* bit set:
/// the runtime translates, so callers never name a host O_* value.
extern fn mml_fd_open_flags(path: *const u8, oflags: i32, mode: i32) -> i32;
/// N30/N58C — the Result layer owns `read`/`write`/`close`, so the
/// libc spellings cross behind mml_fd_ boundary names: the fd
/// namespace is never confused with the mml_sock_ socket one.
extern fn mml_fd_read(fd: i32, buf: *void, n: u64) -> i64;
extern fn mml_fd_write(fd: i32, buf: *const void, n: u64) -> i64;
extern fn mml_fd_close(fd: i32) -> i32;
extern fn mml_errno() -> i32;

/// The portable open-mode bits `open` accepts. Values are a small
/// private vocabulary the runtime translates — `fs.o_write() |
/// fs.o_create() | fs.o_trunc()` is "create or truncate for writing"
/// on every host. (No `o_binary`: binary is the only mode.)
pub fn o_read() -> i32 {
    return 1;
}
pub fn o_write() -> i32 {
    return 2;
}
pub fn o_create() -> i32 {
    return 4;
}
pub fn o_trunc() -> i32 {
    return 8;
}
pub fn o_append() -> i32 {
    return 16;
}

/// HOST flag bits — `fd_open` keeps the raw POSIX contract as an
/// escape hatch; portable code should use `open` + `o_*` instead.
pub fn fd_open(path: *const u8, flags: i32, mode: i32) -> i32 {
    return mml_fd_open_mode(path, flags, mode);
}

/// Wrappers take slices, not `&mut`: the `&`-to-`*T` contract is an
/// extern-call rule — an ordinary fn's `*void` param can't fabricate
/// a pointer from a reference. `buf.ptr` crosses inside.
pub fn fd_read(fd: i32, buf: slice mut u8, n: u64) -> i64 {
    return mml_fd_read(fd, buf.ptr, n);
}

pub fn fd_write(fd: i32, buf: slice u8, n: u64) -> i64 {
    return mml_fd_write(fd, buf.ptr, n);
}

pub fn fd_close(fd: i32) {
    mml_fd_close(fd);
}

// ---- N30A — the Result layer ------------------------------------
// Negative returns become `Err(errno)`; everything else is `Ok`.
// EOF is `Ok(0)`, not an error — a short/zero read is a value.

pub fn open(path: *const u8, flags: i32, mode: i32) -> result.Result<i32, i32> {
    let fd = mml_fd_open_flags(path, flags, mode);
    if fd < 0 {
        return result.Result<i32, i32>::Err(mml_errno());
    }
    return result.Result<i32, i32>::Ok(fd);
}

/// The `slice mut` claim is a parameter, not a capture — it ends at
/// the return, so `fs.read(fd, &mut b[..], n)?` frees `b` again.
pub fn read(fd: i32, buf: slice mut u8, n: u64) -> result.Result<i64, i32> {
    let r = mml_fd_read(fd, buf.ptr, n);
    if r < 0 {
        return result.Result<i64, i32>::Err(mml_errno());
    }
    return result.Result<i64, i32>::Ok(r);
}

pub fn write(fd: i32, buf: slice u8, n: u64) -> result.Result<i64, i32> {
    let r = mml_fd_write(fd, buf.ptr, n);
    if r < 0 {
        return result.Result<i64, i32>::Err(mml_errno());
    }
    return result.Result<i64, i32>::Ok(r);
}

pub fn close(fd: i32) -> result.Result<i32, i32> {
    let r = mml_fd_close(fd);
    if r < 0 {
        return result.Result<i32, i32>::Err(mml_errno());
    }
    return result.Result<i32, i32>::Ok(r);
}

/// `open` + `read_all` + `close` with real errors: the fd outlives
/// the call only as far as the caller keeps it.
pub fn slurp_r(heap: alloc, path: *const u8) -> result.Result<vec.Vec<u8>, i32> {
    let fd = open(path, o_read(), 0)?;
    let v = read_all(heap, fd);
    let cr = close(fd);
    match cr {
        Err(e) => { v.destroy(); return result.Result<vec.Vec<u8>, i32>::Err(e); }
        Ok(_) => {}
    }
    return result.Result<vec.Vec<u8>, i32>::Ok(v);
}

// ---- raw-layer convenience (unchanged contract) -----------------

/// Drain `fd` into a fresh Vec<u8>. `&mut buf[0]` hands `read` a Write
/// claim on the scratch array's span for the call's duration; `buf[0]
/// = 0` seeds the element family's init certificate — the checker
/// can't see the syscall's stores, so the seed keeps later reads
/// honest.
pub fn read_all(heap: alloc, fd: i32) -> vec.Vec<u8> {
    let v = vec.Vec<u8>::new(heap);
    let buf: [512]u8;
    buf[0] = 0;
    let n = mml_fd_read(fd, &mut buf[0], 512);
    while n > 0 {
        let i: i64 = 0;
        while i < n {
            v = v.push(buf[i]);
            i = i + 1;
        }
        n = mml_fd_read(fd, &mut buf[0], 512);
    }
    return v;
}

pub fn slurp(heap: alloc, path: *const u8) -> vec.Vec<u8> {
    let fd = mml_fd_open_flags(path, 1, 0);
    if fd < 0 {
        return vec.Vec<u8>::new(heap);
    }
    let v = read_all(heap, fd);
    mml_fd_close(fd);
    return v;
}
