// std.omap — `OMap<V>`: the OWNED-key sibling of `std.map`'s
// `StrMap<V>` (N41). Same open-addressing table, same probing,
// same tombstone/rehash law — one deliberate difference:
//
//   `StrMap` keys are `str` VIEWS — zero-copy, but the bytes must
//   outlive the entry, so keys are limited to literals and storage
//   the caller freezes before first view. An entry can never own
//   its key bytes: a `str` field pointing into the entry's own
//   subtree would need a self-referential borrow.
//
//   `OMap` keys are `box slice u8` — the entry OWNS its key bytes.
//   `insert(k: str)` copies them (the `HashMap<String,V>` analogue);
//   `insert_kbuf` takes an already-boxed key with no copy. Every
//   lookup arg is a transient `str` view — hash it, compare bytes,
//   never store it — so dynamic runtime keys work anywhere `str`
//   can be produced.
//
//   Removal hands the whole `OEntry` back — key box AND value —
//   because the caller may want either. `remove` keeps StrMap's
//   shape and frees the dead key box itself; `remove_entry`/
//   `pop_entry` give the caller the bytes (key reuse, LRU
//   bookkeeping).
//
//   `free_storage` is the shell-only op, never a destructor: for
//   affine `V`, drain via `pop_entry` first or the authority leaks —
//   and every `kbuf` inside goes with it.

import std.result;

pub struct OMap<V> {
    slots: box slice OSlot<V>,
    len:   i64,
    used:  i64,
    heap:  alloc,
}

pub enum OSlot<V> {
    Empty,
    Full(OEntry<V>),
    Tomb,
}

pub struct OEntry<V> {
    kbuf: box slice u8,
    hash: u64,
    v:    V,
}

pub enum OPut<V> {
    Fresh(OMap<V>),
    Replaced(OPutOut<V>),
    Full(OPutOut<V>),
}

pub struct OPutOut<V> {
    m: OMap<V>,
    v: V,
}

// FNV-1a over raw bytes — same law as `map.hash` but on `slice u8`
// so the stored `kbuf` and the `str` lookup arg hash identically
// (`k.bytes` hands `str` as a slice).
pub fn hash_bytes(b: slice u8) -> u64 {
    let h = (u64(0xcbf29ce4) << 32) | 0x84222325;
    let i: u64 = 0;
    while i < b.len {
        h = (h ^ u64(b[i])) * 0x100000001b3;
        i = i + 1;
    }
    return h;
}

pub fn key_eq(read kb: box slice u8, k: str) -> bool {
    if kb.len != k.bytes.len { return false; }
    let b = k.bytes;
    let i: u64 = 0;
    while i < kb.len {
        if kb[i] != b[i] { return false; }
        i = i + 1;
    }
    return true;
}

// Byte equality between two owned key boxes — used where a `str`
// arg would leave a persistent borrow (the callee could retain any
// view it is handed, so `read` places are the honest comparison).
pub fn key_eq_b(read a: box slice u8, read b: box slice u8) -> bool {
    if a.len != b.len { return false; }
    let i: u64 = 0;
    while i < a.len {
        if a[i] != b[i] { return false; }
        i = i + 1;
    }
    return true;
}

pub fn new<V>(heap: alloc, cap: i64) -> OMap<V> {
    let want = cap;
    if want < 8 { want = 8; }
    let c: u64 = 1;
    while c < u64(want) { c = c * 2; }
    let m: OMap<V>;
    m.slots = alloc_slice<OSlot<V>>(heap, i64(c));
    m.len = 0;
    m.used = 0;
    m.heap = heap;
    let i: u64 = 0;
    while i < c {
        m.slots[i] = OSlot<V>::Empty;
        i = i + 1;
    }
    return m;
}

pub fn len<V>(read self: OMap<V>) -> i64 {
    return self.len;
}

pub fn cap<V>(read self: OMap<V>) -> i64 {
    return i64(self.slots.len);
}

pub fn used<V>(read self: OMap<V>) -> i64 {
    return self.used;
}

// Storage migration by `memcpy`, like `map.grow` — entries relocate
// bitwise; `kbuf` boxes move as handles so the key BYTES never move.
extern fn memcpy(dst: *void, src: *const void, n: u64) -> *void;

pub fn grow<V>(own self: OMap<V>) -> OMap<V> {
    let ncap = self.slots.len * 2;
    let nb = alloc_slice<OSlot<V>>(self.heap, i64(ncap));
    let i: u64 = 0;
    while i < ncap {
        nb[i] = OSlot<V>::Empty;
        i = i + 1;
    }
    let mask = ncap - 1;
    let j: u64 = 0;
    while j < self.slots.len {
        match self.slots[j] {
            Full(_) => {
                let k = self.slots[j].Full.hash & mask;
                let placed = false;
                while !placed {
                    match nb[k] {
                        Empty => {
                            memcpy(&mut nb[k], &self.slots[j], sizeof<OSlot<V>>);
                            placed = true;
                        }
                        _ => { k = (k + 1) & mask; }
                    }
                }
            }
            _ => {}
        }
        j = j + 1;
    }
    free(self.slots);
    self.slots = nb;
    self.used = self.len;
    return self;
}

// Copy a `str`'s bytes into a fresh owned key box.
pub fn dup_key(heap: alloc, k: str) -> box slice u8 {
    let b = k.bytes;
    let kb = alloc_slice<u8>(heap, i64(b.len));
    let i: u64 = 0;
    while i < b.len {
        kb[i] = b[i];
        i = i + 1;
    }
    return kb;
}

pub fn get<V>(read self: OMap<V>, k: str) -> result.Result<&V, i32> {
    let h = hash_bytes(k.bytes);
    let cap = self.slots.len;
    let i = h & (cap - 1);
    let n: u64 = 0;
    while n < cap {
        match self.slots[i] {
            Full(_) => {
                if self.slots[i].Full.hash == h && key_eq(self.slots[i].Full.kbuf, k) {
                    return result.Result<&V, i32>::Ok(&self.slots[i].Full.v);
                }
            }
            Empty => { return result.Result<&V, i32>::Err(1); }
            Tomb => {}
        }
        i = (i + 1) & (cap - 1);
        n = n + 1;
    }
    return result.Result<&V, i32>::Err(1);
}

pub fn contains<V>(read self: OMap<V>, k: str) -> bool {
    let h = hash_bytes(k.bytes);
    let cap = self.slots.len;
    let i = h & (cap - 1);
    let n: u64 = 0;
    while n < cap {
        match self.slots[i] {
            Full(_) => {
                if self.slots[i].Full.hash == h && key_eq(self.slots[i].Full.kbuf, k) { return true; }
            }
            Empty => { return false; }
            Tomb => {}
        }
        i = (i + 1) & (cap - 1);
        n = n + 1;
    }
    return false;
}

pub fn get_mut<V>(write self: OMap<V>, k: str) -> result.Result<&mut V, i32> {
    let h = hash_bytes(k.bytes);
    let cap = self.slots.len;
    let i = h & (cap - 1);
    let n: u64 = 0;
    while n < cap {
        match self.slots[i] {
            Full(_) => {
                if self.slots[i].Full.hash == h && key_eq(self.slots[i].Full.kbuf, k) {
                    return result.Result<&mut V, i32>::Ok(&mut self.slots[i].Full.v);
                }
            }
            Empty => { return result.Result<&mut V, i32>::Err(1); }
            Tomb => {}
        }
        i = (i + 1) & (cap - 1);
        n = n + 1;
    }
    return result.Result<&mut V, i32>::Err(1);
}

// Update an existing key's value — `write`, not `own`, like
// `StrMap::set`: the `replace` exchange never leaves a slot hole.
pub fn set<V>(write self: OMap<V>, k: str, v: V) -> result.Result<V, i32> {
    let h = hash_bytes(k.bytes);
    let cap = self.slots.len;
    let i = h & (cap - 1);
    let n: u64 = 0;
    while n < cap {
        match self.slots[i] {
            Full(_) => {
                if self.slots[i].Full.hash == h && key_eq(self.slots[i].Full.kbuf, k) {
                    let old = replace(self.slots[i].Full.v, v);
                    return result.Result<V, i32>::Ok(old);
                }
            }
            Empty => { return result.Result<V, i32>::Err(1); }
            Tomb => {}
        }
        i = (i + 1) & (cap - 1);
        n = n + 1;
    }
    return result.Result<V, i32>::Err(1);
}

pub fn insert<V>(own self: OMap<V>, k: str, v: V) -> OPut<V> {
    let kb = dup_key(self.heap, k);
    return insert_kbuf(self, kb, v);
}

// The zero-copy form — the caller already owns the key bytes.
pub fn insert_kbuf<V>(own self: OMap<V>, kbuf: box slice u8, v: V) -> OPut<V> {
    if self.used * 10 >= i64(self.slots.len) * 7 {
        self = grow(self);
    }
    let h = hash_bytes(&kbuf[..]);
    let cap = self.slots.len;
    let i = h & (cap - 1);
    let tomb: i64 = -1;
    let n: u64 = 0;
    while n < cap {
        match self.slots[i] {
            Empty => {
                let dst = i;
                if tomb >= 0 { dst = u64(tomb); }
                self.slots[dst] = OSlot<V>::Full(OEntry { kbuf: kbuf, hash: h, v: v });
                self.len = self.len + 1;
                if tomb < 0 { self.used = self.used + 1; }
                return OPut::Fresh(self);
            }
            Tomb => {
                if tomb < 0 { tomb = i64(i); }
            }
            Full(_) => {
                if self.slots[i].Full.hash == h && key_eq_b(self.slots[i].Full.kbuf, kbuf) {
                    // Same key: the NEW key box is redundant — free it
                    // and keep the stored one, then swap values.
                    free(kbuf);
                    let old = replace(self.slots[i].Full.v, v);
                    return OPut::Replaced(OPutOut { m: self, v: old });
                }
            }
        }
        i = (i + 1) & (cap - 1);
        n = n + 1;
    }
    if tomb >= 0 {
        self.slots[u64(tomb)] = OSlot<V>::Full(OEntry { kbuf: kbuf, hash: h, v: v });
        self.len = self.len + 1;
        return OPut::Fresh(self);
    }
    return OPut::Full(OPutOut { m: self, v: v });
}

// Value-only removal — the dead key box is freed inside, the value
// returns to the caller. Same extract-then-tomb law as StrMap.
pub fn remove<V>(write self: OMap<V>, k: str) -> result.Result<V, i32> {
    match remove_entry(self, k) {
        Ok(e) => {
            free(e.kbuf);
            return result.Result<V, i32>::Ok(e.v);
        }
        Err(x) => { return result.Result<V, i32>::Err(x); }
    }
}

// The whole entry — key box included — for callers that need the
// bytes back (eviction paths, key reuse).
pub fn remove_entry<V>(write self: OMap<V>, k: str) -> result.Result<OEntry<V>, i32> {
    let h = hash_bytes(k.bytes);
    let cap = self.slots.len;
    let i = h & (cap - 1);
    let n: u64 = 0;
    while n < cap {
        match self.slots[i] {
            Full(_) => {
                if self.slots[i].Full.hash == h && key_eq(self.slots[i].Full.kbuf, k) {
                    let e = replace(self.slots[i], OSlot<V>::Tomb);
                    self.len = self.len - 1;
                    match e {
                        Full(x) => { return result.Result<OEntry<V>, i32>::Ok(x); }
                        _ => { return result.Result<OEntry<V>, i32>::Err(9); }
                    }
                }
            }
            Empty => { return result.Result<OEntry<V>, i32>::Err(1); }
            Tomb => {}
        }
        i = (i + 1) & (cap - 1);
        n = n + 1;
    }
    return result.Result<OEntry<V>, i32>::Err(1);
}

pub fn pop_entry<V>(write self: OMap<V>) -> result.Result<OEntry<V>, i32> {
    let i: u64 = 0;
    while i < self.slots.len {
        match self.slots[i] {
            Full(_) => {
                let e = replace(self.slots[i], OSlot<V>::Tomb);
                self.len = self.len - 1;
                match e {
                    Full(x) => { return result.Result<OEntry<V>, i32>::Ok(x); }
                    _ => { return result.Result<OEntry<V>, i32>::Err(9); }
                }
            }
            _ => {}
        }
        i = i + 1;
    }
    return result.Result<OEntry<V>, i32>::Err(1);
}

// Shell-only, never a destructor: drain via `pop_entry` for affine
// `V` AND to reclaim every `kbuf`, else both leak.
pub fn free_storage<V>(own self: OMap<V>) {
    free(self.slots);
}
