/// stdlib/process — N32. Process state as read-only foreign views
/// plus one terminal effect.
///
///   env(name: str) -> Result<str, i32>   — immutable process-lifetime
///                                          view into environ storage
///   cwd(write buf: slice mut u8)
///       -> Result<str, i32>              — caller-buffered getcwd;
///                                          the str borrows `buf`
///   arg(i) -> Result<str, i32>           — i-th argv entry
///   argc() -> i64                        — argument count
///   pid() -> i32
///   exit(code: i32)                      — never returns
///
/// `env`/`arg` values are borrowed views into process-global C
/// storage. This language exposes no environment mutation (no
/// setenv/unsetenv — deliberately), so those views stay valid for
/// the process lifetime: "immutable + global" is expressible without
/// a lifetime annotation.
///
/// Errors: Err(1) = missing/unknown; Err(2) = the bytes are not
/// well-formed UTF-8; Err(3) = name too long. `cwd` errors carry
/// errno. No hidden allocation anywhere — `cwd`'s buffer is the
/// caller's own storage.

import std.result;
import std.vec;

extern fn mml_env_get(name: *const u8, nlen: i64,
                      out_ptr: * *const u8, out_len: *i64) -> i32;
extern fn mml_getcwd(buf: *u8, cap: i64) -> i64;
extern fn mml_exit(code: i32);
extern fn mml_arg(i: i64, out_ptr: * *const u8, out_len: *i64) -> i32;
extern fn mml_argc() -> i64;
/// N58B — pid crosses the boundary too; the libc spelling stays
/// behind `mml_` like every other OS call.
extern fn mml_getpid() -> i32;

pub fn env(name: str) -> result.Result<str, i32> {
    let p: *const u8 = 0;
    let n: i64 = 0;
    let st = mml_env_get(name.bytes.ptr, i64(name.len), &mut p, &mut n);
    if st != 0 {
        return result.Result<str, i32>::Err(st);
    }
    return result.Result<str, i32>::Ok(str_from_utf8(slice(p, n)));
}

/// `buf` is a slice-mut value like `fs.read`'s — the write claim
/// rides the view, and the returned str borrows the same storage,
/// so it cannot outlive the caller's buffer.
pub fn cwd(buf: slice mut u8) -> result.Result<str, i32> {
    let n = mml_getcwd(buf.ptr, i64(buf.len));
    if n < 0 {
        return result.Result<str, i32>::Err(i32(0 - n));
    }
    return result.Result<str, i32>::Ok(str_from_utf8(&buf[0..u64(n)]));
}

pub fn arg(i: i64) -> result.Result<str, i32> {
    let p: *const u8 = 0;
    let n: i64 = 0;
    let st = mml_arg(i, &mut p, &mut n);
    if st != 0 {
        return result.Result<str, i32>::Err(st);
    }
    return result.Result<str, i32>::Ok(str_from_utf8(slice(p, n)));
}

pub fn argc() -> i64 {
    return mml_argc();
}

pub fn pid() -> i32 {
    return mml_getpid();
}

/// `unreachable` after the rt call marks this path terminated; the
/// fn summary records `diverges`, so every `process.exit(n)` call
/// site inherits it — init/consumed joins ignore the exit arm.
pub fn exit(code: i32) {
    mml_exit(code);
    unreachable();
}

// ---- spawn (N65B) ---------------------------------------------------

/// Synchronous spawn-and-wait — stdio inherited, env inherited.
/// `args` is a NUL-separated byte block; `cwd` len 0 = inherit.
extern fn mml_proc_run(exe: *const u8, elen: i64, args: *const u8,
                       alen: i64, cwd: *const u8, clen: i64) -> i64;

/// Run `exe` with `args` (argv[0] is `exe` itself) to completion.
/// Ok(exit code) — 128+signal on signal death (POSIX; Windows has
/// exit codes only) — or Err(errno) when the child can't start
/// (missing/non-executable file, fork failure). Stdio is inherited:
/// the child's output is the parent's output. v1 has no pipes,
/// capture, or env override — CHANNELS.md's "no implicit network"
/// applies to process state too: env customization is its own seam.
pub fn run(heap: alloc, exe: str, args: slice str, cwd: str) -> result.Result<i32, i32> {
    // NUL-terminated exe
    let eb = alloc_slice<u8>(heap, i64(exe.len) + 1);
    let i: u64 = 0;
    while i < exe.len {
        eb[i] = exe.bytes[i];
        i = i + 1;
    }
    eb[exe.len] = 0;
    // NUL-separated argv block ("a\0b\0")
    let alen: u64 = 0;
    let i: u64 = 0;
    while i < args.len {
        alen = alen + args[i].len + 1;
        i = i + 1;
    }
    let ab = alloc_slice<u8>(heap, i64(alen) + 1);
    let at: u64 = 0;
    let i: u64 = 0;
    while i < args.len {
        let j: u64 = 0;
        while j < args[i].len {
            ab[at] = args[i].bytes[j];
            at = at + 1;
            j = j + 1;
        }
        ab[at] = 0;
        at = at + 1;
        i = i + 1;
    }
    ab[alen] = 0;
    // NUL-terminated cwd — len 0 means "inherit", pointer ignored.
    let cbuf = alloc_slice<u8>(heap, i64(cwd.len) + 1);
    let i: u64 = 0;
    while i < cwd.len {
        cbuf[i] = cwd.bytes[i];
        i = i + 1;
    }
    cbuf[cwd.len] = 0;
    let st = mml_proc_run(&eb[0], i64(exe.len), &ab[0], i64(alen),
                          &cbuf[0], i64(cwd.len));
    free(cbuf);
    free(eb);
    free(ab);
    return spawn_result(st);
}

fn spawn_result(st: i64) -> result.Result<i32, i32> {
    if st < 0 {
        return result.Result<i32, i32>::Err(i32(0 - st));
    }
    return result.Result<i32, i32>::Ok(i32(st));
}

// ---- N81 — dispatcher support ------------------------------------

/// `setenv(name, val)` — the toolchain dispatcher marks re-exec'd
/// children with OUR_DISPATCHED so a lying sibling is caught.
extern fn mml_env_set(name: *const u8, nlen: i64,
                      val: *const u8, vlen: i64) -> i32;
pub fn env_set(name: str, val: str) -> result.Result<i32, i32> {
    let st = mml_env_set(name.bytes.ptr, i64(name.len),
                         val.bytes.ptr, i64(val.len));
    if st < 0 {
        return result.Result<i32, i32>::Err(0 - st);
    }
    return result.Result<i32, i32>::Ok(0);
}

/// The running executable's path — s0's `std::env::current_exe`.
/// The toolchain dispatcher scans its directory for versioned
/// `our-x.y.z` siblings.
extern fn mml_self_exe(buf: *u8, cap: i64) -> i64;
pub fn self_exe(heap: alloc) -> result.Result<vec.Vec<u8>, i32> {
    let buf: [4096]u8;
    buf[0] = 0;   // element-family init certificate (extern fills)
    let n = mml_self_exe(&mut buf[0], 4096);
    if n < 0 {
        return result.Result<vec.Vec<u8>, i32>::Err(i32(0 - n));
    }
    let v = vec.Vec<u8>::new(heap);
    let i: i64 = 0;
    while i < n {
        v = v.push(buf[i]);
        i = i + 1;
    }
    return result.Result<vec.Vec<u8>, i32>::Ok(v);
}

/// `mml_proc_run_cap` — spawn-and-wait with `which` (1 stdout,
/// 2 stderr) redirected to `cap` (created/truncated). s0's
/// `Command::output()` shape for the toolchain driver.
extern fn mml_proc_run_cap(exe: *const u8, elen: i64,
                           args: *const u8, alen: i64,
                           cwd: *const u8, clen: i64,
                           cap: *const u8, caplen: i64,
                           which: i64) -> i64;
