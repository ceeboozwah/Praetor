// bench/psum — parallel sum over N i64s. Four workers; each
// allocates, fills, sums, and frees its own quarter — real heap
// traffic per thread, no shared-buffer claims to arbitrate.
import std.io;
import std.strconv;

fn quarter(heap: alloc, lo: i64, hi: i64) -> i64 {
    let n = hi - lo;
    let b = alloc_slice<i64>(heap, u64(n));
    let i: i64 = 0;
    while i < n {
        b[i] = lo + i;
        i = i + 1;
    }
    let s: i64 = 0;
    i = 0;
    while i < n {
        s = s + b[i];
        i = i + 1;
    }
    free(b);
    return s;
}

fn main(args: slice str) -> i32 {
    if args.len != 2 { return 1; }
    let n = match strconv.to_i64(args[1]) { Ok(v) => v, Err(e) => return 1 };
    let q = n / 4;
    let acc: atomic i64 = 0;
    let t0 = spawn { atomic_add(acc, quarter(system_allocator(), 0, q)); };
    let t1 = spawn { atomic_add(acc, quarter(system_allocator(), q, q * 2)); };
    let t2 = spawn { atomic_add(acc, quarter(system_allocator(), q * 2, q * 3)); };
    let t3 = spawn { atomic_add(acc, quarter(system_allocator(), q * 3, n)); };
    join t0;
    join t1;
    join t2;
    join t3;
    io.println_i64(atomic_load(acc));
    return 0;
}
