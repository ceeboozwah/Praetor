// BCE E5 — conditional indexing, random access: `if j < s.len`
// guards a masked-hash index; the fact eliminates the check.
import std.io;
import std.strconv;

fn probe(s: slice i64, iters: u64) -> i64 {
    let acc: i64 = 0;
    let h: u64 = 0x5DEECE66D;
    let i: u64 = 0;
    while i < iters {
        h = h * 63641362 + 14426950;
        let j = h & 4194303;              // 4M-1 mask, cap == len
        if j < s.len { acc = acc + s[j]; }
        i = i + 1;
    }
    return acc;
}

fn main(args: slice str) -> i32 {
    if args.len != 2 { return 1; }
    let n = match strconv.to_i64(args[1]) { Ok(v) => v, Err(e) => return 1 };
    let heap = system_allocator();
    let b = alloc_slice<i64>(heap, 4194304);   // 4M == mask+1
    let i: u64 = 0;
    while i < b.len { b[i] = i64(i & 255); i = i + 1; }
    io.println_i64(probe(&b[0..b.len], u64(n)));
    free(b);
    return 0;
}
