// BCE-0.3 E3 — ABI-boundary authority: `work` is deliberately too
// large for LLVM's inliner (16-arm dispatch + loop), so every call
// materializes the `alloc` parameter at the ABI — verified by
// counting `bl work` sites in the final disassembly.
import std.io;
import std.strconv;

fn work(heap: alloc, x: i64, n: i64) -> i64 {
    let acc = x;
    let i: i64 = 0;
    while i < n {
        if (i & 15) == 0 {
            acc = acc * 1103515245 + 1;
        } else {         if (i & 15) == 1 {
            acc = acc * 1103563516 + 2;
        } else {         if (i & 15) == 2 {
            acc = acc * 1103611787 + 3;
        } else {         if (i & 15) == 3 {
            acc = acc * 1103660058 + 4;
        } else {         if (i & 15) == 4 {
            acc = acc * 1103708329 + 5;
        } else {         if (i & 15) == 5 {
            acc = acc * 1103756600 + 6;
        } else {         if (i & 15) == 6 {
            acc = acc * 1103804871 + 7;
        } else {         if (i & 15) == 7 {
            acc = acc * 1103853142 + 8;
        } else {         if (i & 15) == 8 {
            acc = acc * 1103901413 + 9;
        } else {         if (i & 15) == 9 {
            acc = acc * 1103949684 + 10;
        } else {         if (i & 15) == 10 {
            acc = acc * 1103997955 + 11;
        } else {         if (i & 15) == 11 {
            acc = acc * 1104046226 + 12;
        } else {         if (i & 15) == 12 {
            acc = acc * 1104094497 + 13;
        } else {         if (i & 15) == 13 {
            acc = acc * 1104142768 + 14;
        } else {         if (i & 15) == 14 {
            acc = acc * 1104191039 + 15;
        } else { if (i & 15) == 15 {
            acc = acc * 1104239310 + 16;
        } else { acc = acc + 1; } } } } } } } } } } } } } } } }
        acc = acc & 0x7FFFFFFF;
        i = i + 1;
    }
    return acc;
}

fn main(args: slice str) -> i32 {
    if args.len != 2 { return 1; }
    let n = match strconv.to_i64(args[1]) { Ok(v) => v, Err(e) => return 1 };
    let heap = system_allocator();
    let acc: i64 = 0;
    let i: i64 = 0;
    while i < n {
        acc = acc + work(heap, i, 64);   // heap crosses every call
        i = i + 1;
    }
    io.println_i64(acc);
    return 0;
}
