// BCE E3 — unprovable indexing: `n` arrives via argv, so nothing
// proves n <= s.len; the per-element check MUST be retained. This
// is the safety-cost measurement: kept-check scan vs C.
import std.io;
import std.strconv;

fn scan(s: slice i64, n: u64) -> i64 {
    let acc: i64 = 0;
    let i: u64 = 0;
    while i < n {          // n is opaque — check on every s[i]
        acc = acc + s[i];
        i = i + 1;
    }
    return acc;
}

fn main(args: slice str) -> i32 {
    if args.len != 2 { return 1; }
    let n = match strconv.to_i64(args[1]) { Ok(v) => v, Err(e) => return 1 };
    let heap = system_allocator();
    let b = alloc_slice<i64>(heap, u64(n));
    let i: u64 = 0;
    while i < b.len {
        b[i] = i64(i);
        i = i + 1;
    }
    io.println_i64(scan(&b[0..b.len], u64(n)));   // n == len, correct
    free(b);
    return 0;
}
