// BCE E3c — same cache-resident scan but with the check RETAINED:
// index via `len-1-j` (unproven arithmetic index). Delta vs
// scan_hot_g = the true per-element check cost when not hidden by
// memory bandwidth.
import std.io;
import std.strconv;

fn scan(s: slice i64) -> i64 {
    let acc: i64 = 0;
    let j: u64 = 0;
    while j < s.len {
        acc = acc + s[s.len - 1 - j];   // check kept per element
        j = j + 1;
    }
    return acc;
}

fn main(args: slice str) -> i32 {
    if args.len != 2 { return 1; }
    let n = match strconv.to_i64(args[1]) { Ok(v) => v, Err(e) => return 1 };
    let heap = system_allocator();
    let b = alloc_slice<i64>(heap, 8192);
    let i: u64 = 0;
    while i < b.len { b[i] = i64(i); i = i + 1; }
    let acc: i64 = 0;
    let k: i64 = 0;
    while k < n {
        acc = acc + scan(&b[0..b.len]);
        k = k + 1;
    }
    io.println_i64(acc);
    free(b);
    return 0;
}
