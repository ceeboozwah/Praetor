import std.io;
import std.vec;
import std.result;
import semver;
import toml;
import sha256;
import registry;
import project;
import resolve;
import std.process;

fn check(b: bool, name: str) -> u8 {
    if b {
        let m = catz2(vec.Vec<u8>::new(system_allocator()), "ok ");
        let m2 = catz2(m, name);
        io.println(str_from_utf8(m2.as_slice()));
        m2.destroy();
        return 0;
    }
    let m = catz2(vec.Vec<u8>::new(system_allocator()), "FAIL ");
    let m2 = catz2(m, name);
    io.println(str_from_utf8(m2.as_slice()));
    m2.destroy();
    return 1;
}

fn lbp(s: str) -> slice u8 { return s.bytes; }

fn catz2(own v: vec.Vec<u8>, s: str) -> vec.Vec<u8> {
    return registry.cat(v, s.bytes);
}

fn hexs(own v: vec.Vec<u8>) -> vec.Vec<u8> {
    return v;
}

fn main() -> i32 {
    let heap = system_allocator();
    let fails: u8 = 0;

    // --- sha256 known vectors ---
    let hx = sha256.sha256_hex(vec.Vec<u8>::new(heap), lbp("abc"));
    fails = fails + check(keqs(hx.as_slice(),
        "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad"),
        "sha256 abc");
    hx.destroy();
    let hx2 = sha256.sha256_hex(vec.Vec<u8>::new(heap), lbp(""));
    fails = fails + check(keqs(hx2.as_slice(),
        "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855"),
        "sha256 empty");
    hx2.destroy();

    // --- semver ---
    match semver.parse_ver(heap, lbp("1.2.3")) {
        Ok(v) => {
            if v.maj == 1 && v.min == 2 && v.pat == 3 {
                fails = fails + check(true, "ver parse");
            } else { fails = fails + check(false, "ver fields"); }
        }
        Err(e) => { e.destroy(); fails = fails + check(false, "ver parse"); }
    }
    match semver.parse_req(heap, lbp("^1.2")) {
        Ok(r) => {
            let v12 = semver.Ver { maj: 1, min: 2, pat: 9 };
            let v20 = semver.Ver { maj: 2, min: 0, pat: 0 };
            fails = fails + check(semver.satisfies(r, v12)
                && !semver.satisfies(r, v20), "caret req");
        }
        Err(e) => { e.destroy(); fails = fails + check(false, "req parse"); }
    }
    let rd = semver.req_display(heap, semver.Req { exact: 0,
        base: semver.Ver { maj: 1, min: 2, pat: 0 } });
    fails = fails + check(keqs(rd.as_slice(), "^1.2.0"), "req display");
    rd.destroy();

    // --- toml ---
    match toml.parse_value(heap, lbp("\"hello\"")) {
        Ok(v) => {
            fails = fails + check(keqs(v.as_slice(), "hello"),
                "toml str");
            v.destroy();
        }
        Err(e) => { e.destroy(); fails = fails + check(false, "toml"); }
    }

    // --- registry path_cmp: component-wise ordering ---
    // PathBuf: components ["a-b"] vs ["a","c"] → "a-b" > "a" →
    // a/c sorts first (byte sort would give a-b < a/c).
    fails = fails + check(
        registry.path_cmp(lbp("a-b"), lbp("a/c")) > 0,
        "path_cmp");

    // --- index parse ---
    let idx: str = "# test\n[[version]]\nversion = \"1.2.0\"\nsha256 = \"ab\"\n\n[[version]]\nversion = \"1.3.0\"\nsha256 = \"cd\"\nrequires = \"^0.1\"\n";
    match registry.parse_index(heap, lbp("test-index"), lbp(idx)) {
        Ok(ent) => {
            fails = fails + check(ent.len == 2, "index len");
            let i: u64 = 0;
            while i < ent.len {
                let m = vec.Vec<u8>::new(heap);
                let m2 = resolve.bu32(m, ent.buf[i].version.maj);
                let m3 = m2.push(u8(46));
                let m4 = resolve.bu32(m3, ent.buf[i].version.min);
                let m5 = m4.push(u8(46));
                let m6 = resolve.bu32(m5, ent.buf[i].version.pat);
                io.println(str_from_utf8(m6.as_slice()));
                m6.destroy();
                i = i + 1;
            }
            registry.free_entries(ent);
        }
        Err(m) => { io.println(str_from_utf8(m.as_slice())); m.destroy(); fails = fails + 1; }
    }
    return i32(fails);
}

fn keqs(a: slice u8, s: str) -> bool {
    let b = s.bytes;
    if a.len != b.len { return false; }
    let i: u64 = 0;
    while i < u64(a.len) {
        if a[i] != b[i] { return false; }
        i = i + 1;
    }
    return true;
}
