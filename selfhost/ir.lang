}
/// `dst = cas.{ty} {place}, {expected}, {new}` — compare-exchange.
fn e_acas(own g: G, dst: u32, ek: u32, ev: i64,
          nk: u32, nv: i64) -> G {
    g = ge(g);
    g = irplace(g);
    g = irec(g, 10, dst, g.res, ek, nk, 0, 0, 0);
    g = irecv(g, 3, ev);
    g = irecv(g, 4, nv);
    g.fnb = gr(g.fnb, dst);
    g.fnb = resolve.bputs(g.fnb, " = cas.");
    g.fnb = gty(g.fnb, g.c.r, g.pl_ty);
    g.fnb = g.fnb.push(u8(32));
    g.fnb = gptext(g.fnb, g);
    g.fnb = resolve.bputs(g.fnb, ", ");
    g.fnb = gop(g.fnb, g.c.r, ek, ev);
    g.fnb = resolve.bputs(g.fnb, ", ");
    g.fnb = gop(g.fnb, g.c.r, nk, nv);
    return geol(g);
}
/// `dst = extract.{ty} {agg}[{idx}]` — the str_parts halves.
fn e_extract(own g: G, dst: u32, ty: u32, ak: u32,
             av: i64, idx: u32) -> G {
    g = ge(g);
    g = irec(g, 15, dst, ty, ak, idx, 0, 0, 0);
    g = irecv(g, 3, av);
    g.fnb = gr(g.fnb, dst);
    g.fnb = resolve.bputs(g.fnb, " = extract.");
    g.fnb = gty(g.fnb, g.c.r, ty);
    g.fnb = g.fnb.push(u8(32));
    g.fnb = gop(g.fnb, g.c.r, ak, av);
    g.fnb = g.fnb.push(u8(91));
    g.fnb = resolve.bu32(g.fnb, u64(idx));
    g.fnb = g.fnb.push(u8(93));
    return geol(g);
}
fn e_handle(own g: G, dst: u32) -> G {
    g = ge(g);
    g = irplace(g);
    g = irec(g, 6, dst, g.res, 0, 0, 0, 0, 0);
    g.fnb = gr(g.fnb, dst);
    g.fnb = resolve.bputs(g.fnb, " = handle ");
    g.fnb = gptext(g.fnb, g);
    g.fnb = resolve.bputs(g.fnb, " (id ");
    g.fnb = gty(g.fnb, g.c.r, g.pl_ty);
    g.fnb = g.fnb.push(u8(41));
    return geol(g);
}
fn e_bin(own g: G, dst: u32, op: u32, ty: u32,
         ka: u32, va: i64, kb: u32, vb: i64) -> G {
    g = ge(g);
    g = irec(g, 11, dst, op, ty, ka, kb, 0, 0);
    g = irecv(g, 4, va);
    g = irecv(g, 5, vb);
    g.fnb = gr(g.fnb, dst);
    g.fnb = resolve.bputs(g.fnb, " = ");
    if op == 0 { g.fnb = resolve.bputs(g.fnb, "add"); }
    if op == 1 { g.fnb = resolve.bputs(g.fnb, "sub"); }
    if op == 2 { g.fnb = resolve.bputs(g.fnb, "mul"); }
    if op == 3 { g.fnb = resolve.bputs(g.fnb, "div"); }
    if op == 4 { g.fnb = resolve.bputs(g.fnb, "mod"); }
    if op == 5 { g.fnb = resolve.bputs(g.fnb, "eq"); }
    if op == 6 { g.fnb = resolve.bputs(g.fnb, "ne"); }
    if op == 7 { g.fnb = resolve.bputs(g.fnb, "lt"); }
    if op == 8 { g.fnb = resolve.bputs(g.fnb, "gt"); }
    if op == 9 { g.fnb = resolve.bputs(g.fnb, "le"); }
    if op == 10 { g.fnb = resolve.bputs(g.fnb, "ge"); }
    if op == 11 { g.fnb = resolve.bputs(g.fnb, "shl"); }
    if op == 12 { g.fnb = resolve.bputs(g.fnb, "shr"); }
    if op == 13 { g.fnb = resolve.bputs(g.fnb, "and"); }
    if op == 14 { g.fnb = resolve.bputs(g.fnb, "or"); }
    if op == 15 { g.fnb = resolve.bputs(g.fnb, "xor"); }
    g.fnb = g.fnb.push(u8(46));
    g.fnb = gty(g.fnb, g.c.r, ty);
    g.fnb = g.fnb.push(u8(32));
    g.fnb = gop(g.fnb, g.c.r, ka, va);
    g.fnb = resolve.bputs(g.fnb, ", ");
    g.fnb = gop(g.fnb, g.c.r, kb, vb);
    return geol(g);
}
fn e_unary(own g: G, dst: u32, op: u32, ty: u32,
           ka: u32, va: i64) -> G {
    g = ge(g);
    g = irec(g, 12, dst, op, ty, ka, 0, 0, 0);
    g = irecv(g, 4, va);
    g.fnb = gr(g.fnb, dst);
    g.fnb = resolve.bputs(g.fnb, " = ");
    if op == 0 { g.fnb = resolve.bputs(g.fnb, "neg"); }
    if op == 1 { g.fnb = resolve.bputs(g.fnb, "not"); }
    if op == 2 { g.fnb = resolve.bputs(g.fnb, "bnot"); }
    g.fnb = g.fnb.push(u8(46));
    g.fnb = gty(g.fnb, g.c.r, ty);
    g.fnb = g.fnb.push(u8(32));
    g.fnb = gop(g.fnb, g.c.r, ka, va);
    return geol(g);
}
/// terminators — seal prints `    term`.
fn gseal_ret(own g: G, hasv: u8, k: u32, v: i64, ty: u32) -> G {
    g = gseal(g);
    g = irseal(g, 0, u32(hasv), ty, k, 0);
    g = irbv(g, 6, v);
    if hasv == 0 {
        g.fnb = resolve.bputs(g.fnb, "ret.void");
    } else {
        g.fnb = resolve.bputs(g.fnb, "ret.");
        g.fnb = gty(g.fnb, g.c.r, ty);
        g.fnb = g.fnb.push(u8(32));
        g.fnb = gop(g.fnb, g.c.r, k, v);
    }
    return geol(g);
}
fn gseal_jmp(own g: G, lbl: u32) -> G {
    g = gseal(g);
    g = irseal(g, 2, lbl, 0, 0, 0);
    g.fnb = resolve.bputs(g.fnb, "jmp ");
    g.fnb = glbl(g.fnb, g, lbl);
    return geol(g);
}
fn gseal_br(own g: G, ck: u32, cv: i64, t: u32, e: u32) -> G {
    g = gseal(g);
    g = irseal(g, 1, ck, t, e, 0);
    g = irbv(g, 4, cv);
    g.fnb = resolve.bputs(g.fnb, "br ");
    g.fnb = gop(g.fnb, g.c.r, ck, cv);
    g.fnb = resolve.bputs(g.fnb, " -> ");
    g.fnb = glbl(g.fnb, g, t);
    g.fnb = resolve.bputs(g.fnb, ", ");
    g.fnb = glbl(g.fnb, g, e);
    return geol(g);
}
fn gseal_dead(own g: G) -> G {
    g = gseal(g);
    g = irseal(g, 3, 0, 0, 0, 0);
    g.fnb = resolve.bputs(g.fnb, "dead");
    return geol(g);
}

// ---- fn context ----------------------------------------------------

/// env lookup, innermost scope out — res = slot idx | NONE; when
/// found, res2/res3/res4 = (reg, ty, alias).
fn gfind(own g: G, n: u32) -> G {
    let i = g.slots.len;
    while i > 0 {
        i = i - 1;
        if g.slots.buf[i].n == n {
            g.res = u32(i);
            g.res2 = g.slots.buf[i].r;
            g.res3 = g.slots.buf[i].ty;
            g.res4 = u32(g.slots.buf[i].al);
            return g;
        }
    }
    g.res = NONE();
    return g;
}
fn gbind(own g: G, n: u32, r: u32, ty: u32, al: u8) -> G {
    g.slots = g.slots.push(Slot { n: n, r: r, ty: ty, al: al });
    return g;
}
fn gpush(own g: G) -> G {
    g.frame = g.frame.push(u32(g.slots.len));
    g.dmark = g.dmark.push(u32(g.dlist.len));
    return g;
}
/// N54 — `emit_defers_above(depth)`: every scope deeper than `depth`,
/// innermost first, LIFO within each level. The lists STAY — each
/// exit edge carries its own copy; the scope's pop owns removal.
fn g_defer_above(own g: G, read p: ast.Parser, depth: u32) -> G {
    let lvl = g.dmark.len;
    while lvl > u64(depth) {
        lvl = lvl - 1;
        let top = g.dlist.len;
        if lvl + 1 < g.dmark.len { top = u64(g.dmark.buf[lvl + 1]); }
        let j = top;
        while j > u64(g.dmark.buf[lvl]) {
            j = j - 1;
            g = g_expr(g, p, g.dlist.buf[j], NONE());
        }
    }
    return g;
}
/// `open_guards` membership — res = position or len.
fn og_at(read g: G, slot: u32) -> u64 {
    let i: u64 = 0;
    while i < g.oguards.len {
        if g.oguards.buf[i] == slot { return i; }
        i = i + 1;
    }
    return g.oguards.len;
}
/// drop `slot` from the set (ordered — insertion order is the
/// deterministic emission order for multi-guard edges).
fn og_rel(own g: G, slot: u32) -> G {
    let i = og_at(g, slot);
    if i < g.oguards.len {
        while i + 1 < g.oguards.len {
            g.oguards.buf[i] = g.oguards.buf[i + 1];
            i = i + 1;
        }
        g.oguards.pop();
    }
    return g;
}
/// scope-exit release — `v = load.guard void slot;
/// call mml_mutex_unlock(&void v)` (s0's `unlock_slot`).
fn g_unlockslot(own g: G, slot: u32) -> G {
    g = rty(g, 9);                       // void
    g.c.r = resolve.mk_un(g.c.r, 22, g.res, 0);
    let gt = g.c.r.res;
    g = gfresh(g);
    let d = g.res;
    g.pl_r = slot; g.pl_val = 0;
    g.pl_rty = gt; g.pl_ty = gt;
    g.pl_off = u32(g.pel.len); g.pl_len = 0;
    g = e_load(g, d);
    g = g_ptrty(g);
    let pt = g.res;
    while g.ax.len > 0 { g.ax.pop(); }
    g.ax = g.ax.push(AX { ty: pt, k: OK_REG(), v: i64(d) });
    g = rty(g, 9);
    return g_rtcall(g, "mml_mutex_unlock", g.res);
}
/// every live guard releases (return / fn-end edges).
fn g_unlockall(own g: G) -> G {
    let i: u64 = 0;
    while i < g.oguards.len {
        let slot = g.oguards.buf[i];
        g = g_unlockslot(g, slot);
        i = i + 1;
    }
    while g.oguards.len > 0 { g.oguards.pop(); }
    return g;
}
/// guards bound at or above `depth` slots that are still open —
/// the break/continue edge release (s0's `env[depth..]` scan).
fn g_unlockdeep(own g: G, base: u64) -> G {
    let i = base;
    while i < g.slots.len {
        let s = g.slots.buf[i];
        if g.c.r.rtys.buf[u64(s.ty)].kind == 22
            && og_at(g, s.r) < g.oguards.len {
            g = g_unlockslot(g, s.r);
        }
        i = i + 1;
    }
    return g;
}

/// unwrap Ref/Handle layers toward the endpoint's declared Channel
/// payload — res = Channel's inner tyid or NONE (s0's et-walk).
fn g_chanpay(own g: G, t0: u32) -> G {
    let et = t0;
    while et != NONE() && u64(et) < g.c.r.rtys.len {
        let en = g.c.r.rtys.buf[u64(et)];
        if en.kind == 23 { g.res = en.a; return g; }
        if en.kind != 15 && en.kind != 18 {
            g.res = NONE(); return g;
        }
        et = en.a;
    }
    g.res = NONE();
    return g;
}
/// `send(c,v)` / `recv(c)` / `close(c)` — s0's chan ops: the
/// endpoint's cell loads as `&void`; packets marshal through a
/// `$pkt` cell sized by the DECLARED payload.
fn g_chanop(own g: G, read p: ast.Parser, e: ast.Expr, eid: u32,
            vn: u32) -> G {
    if check.call_nargs(g.c, p, eid) == 0 {
        g.res = OK_IMM(); g.resv = 0;
        return g;
    }
    g.c = check.call_arg(g.c, p, e, eid, 0);
    let a0 = g.c.res;
    g = g_infer(g, p, a0, NONE());
    let ct = g.res2;
    let cn = g.c.r.rtys.buf[u64(ct)];
    let have: u8 = 0;
    let chk = OK_IMM(); let chv: i64 = 0;
    if cn.kind == 15 || cn.kind == 18 {
        // handle/ref endpoint — load its ptr, then the `&void` cell
        // at it (s0's chan_cell Handle/Ref arm).
        g = g_place(g, p, a0);
        if g.res3 != NONE() {
            g = gload(g);
            if g.res == OK_REG() {
                let hr = u32(g.resv);
                g = g_ptrty(g);
                let vt = g.res;
                g.pl_r = hr; g.pl_val = 1;
                g.pl_rty = vt; g.pl_ty = vt;
                g.pl_off = u32(g.pel.len); g.pl_len = 0;
                g = gload(g);
                chk = g.res; chv = g.resv;
                have = 1;
            }
        }
    }
    if have == 0 {
        // direct `channel T` — the cell itself, re-typed `&void`
        // (root_ty stays — only the load tag changes).
        g = g_place(g, p, a0);
        if g.res3 != NONE() {
            g = g_ptrty(g);
            g.pl_ty = g.res;
            g = gload(g);
            chk = g.res; chv = g.resv;
            have = 1;
        }
    }
    if have == 0 { g.res = OK_IMM(); g.resv = 0; return g; }
    g = g_ptrty(g);
    let pt = g.res;
    if check.nid_lit_eq(g.c, vn, "send") {
        if check.call_nargs(g.c, p, eid) < 2 {
            g.res = OK_IMM(); g.resv = 0;
            return g;
        }
        g.c = check.call_arg(g.c, p, e, eid, 1);
        let a1 = g.c.res;
        g = g_infer(g, p, a1, NONE());
        let vt = g.res2;
        g = g_chanpay(g, ct);
        if g.res != NONE()
            && g.c.r.rtys.buf[u64(g.res)].kind != 9 {
            vt = g.res;
        }
        g = g_expr(g, p, a1, vt);
        let vk = g.res; let vv = g.resv;
        g = gfresh(g);
        let cell = g.res;
        g = g_lit(g, "$pkt");
        g = e_local(g, cell, vt, g.res);
        g.pl_r = cell; g.pl_val = 0;
        g.pl_rty = vt; g.pl_ty = vt;
        g.pl_off = u32(g.pel.len); g.pl_len = 0;
        g = e_store(g, vk, vv);
        g = gfresh(g);
        let cp = g.res;
        g = e_addr(g, cp);
        while g.ax.len > 0 { g.ax.pop(); }
        g.ax = g.ax.push(AX { ty: pt, k: chk, v: chv });
        g.ax = g.ax.push(AX { ty: pt, k: OK_REG(), v: i64(cp) });
        g = rty(g, 9);
        g = g_rtcall(g, "mml_chan_send", g.res);
        g.res = OK_IMM(); g.resv = 0;
        return g;
    }
    if check.nid_lit_eq(g.c, vn, "recv") {
        g = g_chanpay(g, ct);
        let pt2 = g.res;
        if pt2 == NONE()
            || g.c.r.rtys.buf[u64(pt2)].kind == 9 {
            g = rty(g, 7);
            pt2 = g.res;
        }
        g = gfresh(g);
        let cell = g.res;
        g = g_lit(g, "$pkt");
        g = e_local(g, cell, pt2, g.res);
        g.pl_r = cell; g.pl_val = 0;
        g.pl_rty = pt2; g.pl_ty = pt2;
        g.pl_off = u32(g.pel.len); g.pl_len = 0;
        g = gfresh(g);
        let cp = g.res;
        g = e_addr(g, cp);
        while g.ax.len > 0 { g.ax.pop(); }
        g.ax = g.ax.push(AX { ty: pt, k: chk, v: chv });
        g.ax = g.ax.push(AX { ty: pt, k: OK_REG(), v: i64(cp) });
        g = rty(g, 9);
        g = g_rtcall(g, "mml_chan_recv", g.res);
        g.pl_r = cell; g.pl_val = 0;
        g.pl_rty = pt2; g.pl_ty = pt2;
        g.pl_off = u32(g.pel.len); g.pl_len = 0;
        return gload(g);
    }
    // `close` — flag + wake blocked receivers.
    while g.ax.len > 0 { g.ax.pop(); }
    g.ax = g.ax.push(AX { ty: pt, k: chk, v: chv });
    g = rty(g, 9);
    g = g_rtcall(g, "mml_chan_close", g.res);
    g.res = OK_IMM(); g.resv = 0;
    return g;
}
/// `atomic_load`/`atomic_store`/`atomic_add`/`compare_exchange` —
/// s0's atomic ops: aload/astore/armw.add/cas on the named storage;
/// ref/handle args mean the referent's place (place_ptr).
fn g_atomic(own g: G, read p: ast.Parser, e: ast.Expr, eid: u32,
            vn: u32) -> G {
    if check.call_nargs(g.c, p, eid) == 0 {
        g.res = OK_IMM(); g.resv = 0;
        return g;
    }
    g.c = check.call_arg(g.c, p, e, eid, 0);
    let a0 = g.c.res;
    g = g_infer(g, p, a0, NONE());
    let t0 = g.res2;
    let n0 = g.c.r.rtys.buf[u64(t0)];
    let have: u8 = 0;
    if n0.kind == 15 || n0.kind == 18 {
        let el = n0.a;
        g = g_expr(g, p, a0, NONE());
        if g.res == OK_REG() {
            g.pl_r = u32(g.resv); g.pl_val = 1;
            g.pl_rty = el; g.pl_ty = el;
            g.pl_off = u32(g.pel.len); g.pl_len = 0;
            have = 1;
        }
    }
    if have == 0 {
        g = g_place(g, p, a0);
        if g.res3 != NONE() { have = 1; }
    }
    if have == 0 { g.res = OK_IMM(); g.resv = 0; return g; }
    let pr = g.pl_r; let pv = g.pl_val;
    let prt = g.pl_rty; let pt = g.pl_ty;
    let po = g.pl_off; let pl = g.pl_len;
    if check.nid_lit_eq(g.c, vn, "atomic_load") {
        g = gfresh(g);
        let d = g.res;
        g = e_aload(g, d);
        g.res = OK_REG(); g.resv = i64(d);
        return g;
    }
    if check.nid_lit_eq(g.c, vn, "atomic_store") {
        g.c = check.call_arg(g.c, p, e, eid, 1);
        g = g_expr(g, p, g.c.res, pt);
        let vk = g.res; let vv = g.resv;
        g.pl_r = pr; g.pl_val = pv; g.pl_rty = prt;
        g.pl_ty = pt; g.pl_off = po; g.pl_len = pl;
        g = e_astore(g, vk, vv);
        g = g_bkill(g, p, a0);
        g.res = OK_IMM(); g.resv = 0;
        return g;
    }
    if check.nid_lit_eq(g.c, vn, "atomic_add") {
        g.c = check.call_arg(g.c, p, e, eid, 1);
        g = g_expr(g, p, g.c.res, pt);
        let vk = g.res; let vv = g.resv;
        g.pl_r = pr; g.pl_val = pv; g.pl_rty = prt;
        g.pl_ty = pt; g.pl_off = po; g.pl_len = pl;
        g = gfresh(g);
        let d = g.res;
        g = e_aadd(g, d, vk, vv);
        g = g_bkill(g, p, a0);
        g.res = OK_REG(); g.resv = i64(d);
        return g;
    }
    // compare_exchange — expected, new, dst reg.
    if check.call_nargs(g.c, p, eid) < 3 {
        g.res = OK_IMM(); g.resv = 0;
        return g;
    }
    g.c = check.call_arg(g.c, p, e, eid, 1);
    g = g_expr(g, p, g.c.res, pt);
    let ek = g.res; let ev = g.resv;
    g.c = check.call_arg(g.c, p, e, eid, 2);
    g = g_expr(g, p, g.c.res, pt);
    let nk = g.res; let nv = g.resv;
    g.pl_r = pr; g.pl_val = pv; g.pl_rty = prt;
    g.pl_ty = pt; g.pl_off = po; g.pl_len = pl;
    g = gfresh(g);
    let d = g.res;
    g = e_acas(g, d, ek, ev, nk, nv);
    g = g_bkill(g, p, a0);
    g.res = OK_REG(); g.resv = i64(d);
    return g;
}

// ---- tasks (N13): spawn env-pack, join, synthesized task fns ------

/// ptr-shaped at the machine level (s0 `Ty::is_ptr_like`) — these
/// captures carry the slot's VALUE; the rest alias the caller's
/// storage by address.
fn g_ptrlike(read g: G, t: u32) -> u8 {
    if u64(t) >= g.c.r.rtys.len { return 0; }
    let n = g.c.r.rtys.buf[u64(t)];
    if n.kind == 11 || n.kind == 15 || n.kind == 16 || n.kind == 18
        || n.kind == 19 || n.kind == 21 || n.kind == 22
        || n.kind == 23 || n.kind == 24 {
        return 1;
    }
    return 0;
}
/// fv_expr — free-var names into `fout` (first-use order); `fbnd`
/// holds names bound inside the walked body.
fn g_fv_e(own g: G, read p: ast.Parser, eid: u32) -> G {
    let e = check.xexp(g.c, p, eid);
    let k = check.ek_num(e.kind);
    if k == 2 {                              // Var — first free use
        g.c.r = resolve.intern_pname(g.c.r, p, e.a);
        let n = g.c.r.res;
        if vhas2(g.fbnd, n) == 0 && vhas2(g.fout, n) == 0 {
            g.fout = g.fout.push(n);
        }
        return g;
    }
    if k == 0 || k == 1 || k == 3 || k == 18 { return g; }
    if k == 4 { return g_fv_e(g, p, e.b); }  // Unary — operand
    if k == 7 || k == 12 || k == 14 || k == 15 || k == 16
        || k == 21 {
        return g_fv_e(g, p, e.a);            // unary-operand kinds
    }
    if k == 5 {                              // Bin
        g = g_fv_e(g, p, e.b);
        return g_fv_e(g, p, e.c);
    }
    if k == 8 {                              // Index
        g = g_fv_e(g, p, e.a);
        return g_fv_e(g, p, e.b);
    }
    if k == 9 {                              // IndexRange
        g = g_fv_e(g, p, e.a);
        if e.b != NONE() { g = g_fv_e(g, p, e.b); }
        if e.c != NONE() { g = g_fv_e(g, p, e.c); }
        return g;
    }
    if k == 6 {                              // Call — args only
        let nt = u64(p.u32s.buf[u64(e.b)]);
        let na = u64(p.u32s.buf[u64(e.b) + 1 + nt]);
        let i: u64 = u64(e.b) + 2 + nt;
        while i < u64(e.b) + 2 + nt + na {
            g = g_fv_e(g, p, p.u32s.buf[i]);
            i = i + 1;
        }
        return g;
    }
    if k == 10 {                             // StructLit — field exprs
        let nt = u64(p.u32s.buf[u64(e.b)]);
        let nf = u64(p.u32s.buf[u64(e.b) + 1 + nt]);
        let i: u64 = 0;
        while i < nf {
            g = g_fv_e(g, p,
                p.u32s.buf[u64(e.b) + 2 + nt + i * 2 + 1]);
            i = i + 1;
        }
        return g;
    }
    if k == 11 { return g_fv_e(g, p, e.b); } // AddrOf — place
    if k == 17 {                             // Alloc
        g = g_fv_e(g, p, e.b);
        if e.c != NONE() { g = g_fv_e(g, p, e.c); }
        return g;
    }
    if k == 13 {                             // Spawn — nested body
        let m = u32(g.fbnd.len);
        g = g_fv_s(g, p, e.b, e.c);
        while g.fbnd.len > u64(m) { g.fbnd.pop(); }
        return g;
    }
    if k == 19 || k == 20 {                  // MethodCall | AssocFn
        if k == 19 { g = g_fv_e(g, p, e.a); }
        let i: u64 = u64(e.c);
        while i < u64(e.c) + u64(e.d) {
            g = g_fv_e(g, p, p.u32s.buf[i]);
            i = i + 1;
        }
        return g;
    }
    if k == 22 {                             // Match — scrut + arms
        g = g_fv_e(g, p, e.a);
        let ai: u64 = u64(e.b);
        while ai < u64(e.b) + u64(e.c) {
            let arm = p.arms.buf[ai];
            let m = u32(g.fbnd.len);
            if arm.bind != NONE() {
                g.fbnd = g.fbnd.push(arm.bind);
            }
            g = g_fv_s(g, p, arm.off, arm.len);
            while g.fbnd.len > u64(m) { g.fbnd.pop(); }
            ai = ai + 1;
        }
        return g;
    }
    return g;
}
/// fv_stmts — s0's walk: lets bind AFTER their init's free vars.
fn g_fv_s(own g: G, read p: ast.Parser, bo: u32, bl: u32) -> G {
    let i: u64 = u64(bo);
    while i < u64(bo) + u64(bl) {
        let s = p.stmts.buf[u64(p.u32s.buf[i])];
        let k = check.sk_num(s.kind);
        if k == 0 {                          // Let — init, then bind
            if s.c != NONE() { g = g_fv_e(g, p, s.c); }
            g.c.r = resolve.intern_pname(g.c.r, p, s.a);
            if vhas2(g.fbnd, g.c.r.res) == 0 {
                g.fbnd = g.fbnd.push(g.c.r.res);
            }
        }
        if k == 1 {                          // Assign
            g = g_fv_e(g, p, s.a);
            g = g_fv_e(g, p, s.b);
        }
        if k == 2 && s.a != NONE() { g = g_fv_e(g, p, s.a); }
        if k == 3 {                          // If — scoped bodies
            g = g_fv_e(g, p, s.a);
            let base = u64(s.b);
            let nt = u64(p.u32s.buf[base]);
            let m = u32(g.fbnd.len);
            g = g_fv_s(g, p, u32(base + 1), u32(nt));
            while g.fbnd.len > u64(m) { g.fbnd.pop(); }
            if p.u32s.buf[base + 1 + nt] == 1 {
                g = g_fv_s(g, p, u32(base + 2 + nt),
                           u32(u64(s.c) - nt - 2));
                while g.fbnd.len > u64(m) { g.fbnd.pop(); }
            }
        }
        if k == 4 || k == 9 {                // While | Region
            if k == 4 { g = g_fv_e(g, p, s.a); }
            let m = u32(g.fbnd.len);
            g = g_fv_s(g, p, s.b, s.c);
            while g.fbnd.len > u64(m) { g.fbnd.pop(); }
        }
        if k == 8 {                          // Match — scrut + arms
            g = g_fv_e(g, p, s.a);
            let ai: u64 = u64(s.b);
            while ai < u64(s.b) + u64(s.c) {
                let arm = p.arms.buf[ai];
                let m = u32(g.fbnd.len);
                if arm.bind != NONE() {
                    g.fbnd = g.fbnd.push(arm.bind);
                }
                g = g_fv_s(g, p, arm.off, arm.len);
                while g.fbnd.len > u64(m) { g.fbnd.pop(); }
                ai = ai + 1;
            }
        }
        if k == 7 || k == 10 || k == 11 || k == 12 {
            g = g_fv_e(g, p, s.a);
        }
        i = i + 1;
    }
    return g;
}
/// the body's free vars that resolve in env — res/res2 = the
/// capture range in `tcaps` (s0's `captures`).
fn g_caps(own g: G, read p: ast.Parser, bo: u32, bl: u32) -> G {
    while g.fbnd.len > 0 { g.fbnd.pop(); }
    while g.fout.len > 0 { g.fout.pop(); }
    g = g_fv_s(g, p, bo, bl);
    let coff = u32(g.tcaps.len);
    let i: u64 = 0;
    while i < g.fout.len {
        let n = g.fout.buf[i];
        g = gfind(g, n);
        if g.res != NONE() {
            g.tcaps = g.tcaps.push(TCap {
                n: n, ty: g.res3, pc: g_ptrlike(g, g.res3) });
        }
        i = i + 1;
    }
    g.res = coff;
    g.res2 = u32(g.tcaps.len) - coff;
    return g;
}
/// spawn_ret_ty — first `return e` wins; the body's own lets feed
/// `srtl` so `return <local>` resolves in the child's scope.
fn g_srt(own g: G, read p: ast.Parser, bo: u32, bl: u32) -> G {
    let i: u64 = u64(bo);
    while i < u64(bo) + u64(bl) {
        let s = p.stmts.buf[u64(p.u32s.buf[i])];
        let k = check.sk_num(s.kind);
        if k == 2 && s.a != NONE() {
            g = g_infer(g, p, s.a, NONE());
            g.res = g.res2;
            return g;
        }
        if k == 0 {
            let lt: u32 = NONE();
            if s.b != NONE() {
                g.c.r = resolve.cnv_ty(g.c.r, p, s.b);
                lt = g.c.r.res;
            }
            if lt == NONE() && s.c != NONE() {
                g = g_infer(g, p, s.c, NONE());
                lt = g.res2;
            }
            if lt == NONE() { g = rty(g, 9); lt = g.res; }
            g.c.r = resolve.intern_pname(g.c.r, p, s.a);
            g.srtl = g.srtl.push(check.KK { k: g.c.r.res, v: lt });
        }
        if k == 3 {
            let base = u64(s.b);
            let nt = u64(p.u32s.buf[base]);
            let m = u32(g.srtl.len);
            g = g_srt(g, p, u32(base + 1), u32(nt));
            if g.res != NONE()
                && g.c.r.rtys.buf[u64(g.res)].kind != 9 {
                return g;
            }
            while g.srtl.len > u64(m) { g.srtl.pop(); }
            if p.u32s.buf[base + 1 + nt] == 1 {
                g = g_srt(g, p, u32(base + 2 + nt),
                          u32(u64(s.c) - nt - 2));
                if g.res != NONE()
                    && g.c.r.rtys.buf[u64(g.res)].kind != 9 {
                    return g;
                }
                while g.srtl.len > u64(m) { g.srtl.pop(); }
            }
        }
        if k == 4 || k == 9 {
            let m = u32(g.srtl.len);
            g = g_srt(g, p, s.b, s.c);
            if g.res != NONE()
                && g.c.r.rtys.buf[u64(g.res)].kind != 9 {
                return g;
            }
            while g.srtl.len > u64(m) { g.srtl.pop(); }
        }
        i = i + 1;
    }
    g = rty(g, 9);
    return g;
}
/// `env_slot(i)` — `{Slot(env):arr_ty [Index i]:&void}`.
fn g_envslot(own g: G, env: u32, arr_ty: u32, i: i64) -> G {
    g = rty(g, 6);                           // i32 index opnd
    let i32t = g.res;
    g.pl_r = env; g.pl_val = 0;
    g.pl_rty = arr_ty;
    g.pl_off = u32(g.pel.len); g.pl_len = 0;
    g = g_ptrty(g);
    g.pl_ty = g.res;
    g = gpush_i(g, OK_IMM(), i, i32t);
    return g;
}
/// `spawn { ... }` — N13: pack the body's free vars into an env
/// frame ([0] task*, [1] result-cell ptr, [2+i] captures) and hand
/// a synthesized `__task_*` fn to the runtime. The task token IS
/// env's address.
fn g_spawn(own g: G, read p: ast.Parser, e: ast.Expr) -> G {
    let sm = u32(g.srtl.len);
    g = g_srt(g, p, e.b, e.c);
    let inner = g.res;
    while g.srtl.len > u64(sm) { g.srtl.pop(); }
    g = g_caps(g, p, e.b, e.c);
    let coff = g.res; let clen = g.res2;
    g = g_ptrty(g);
    let pt = g.res;
    g.c.r = resolve.mk_arr(g.c.r, pt, u64(clen) + 2);
    let arr_ty = g.c.r.res;
    g = gfresh(g);
    let env = g.res;
    g = g_lit(g, "$env");
    g = e_local(g, env, arr_ty, g.res);
    let ik = g.c.r.rtys.buf[u64(inner)].kind;
    if ik != 9 {
        // the result cell lives in THIS frame — the task stores
        // through env[1]; join reads it back.
        g = gfresh(g);
        let cell = g.res;
        g = g_lit(g, "$res");
        g = e_local(g, cell, inner, g.res);
        g = gfresh(g);
        let rp = g.res;
        g.pl_r = cell; g.pl_val = 0;
        g.pl_rty = inner; g.pl_ty = inner;
        g.pl_off = u32(g.pel.len); g.pl_len = 0;
        g = e_addr(g, rp);
        g = g_envslot(g, env, arr_ty, 1);
        g = e_store(g, OK_REG(), i64(rp));
    }
    let i: u64 = 0;
    while i < u64(clen) {
        let tc = g.tcaps.buf[u64(coff) + i];
        // place of the captured var — ptr-class loads the VALUE;
        // storage aliases the ADDRESS (s0's env-pack loop).
        g = gplace_var(g, tc.n);
        let vk = OK_IMM(); let vv: i64 = 0;
        if tc.pc == 1 {
            g = gload(g);
            vk = g.res; vv = g.resv;
        } else {
            g = gfresh(g);
            let d = g.res;
            g = e_addr(g, d);
            vk = OK_REG(); vv = i64(d);
        }
        g = g_envslot(g, env, arr_ty, i64(i) + 2);
        g = e_store(g, vk, vv);
        i = i + 1;
    }
    // `__task_<fname>_<tseq>` — task fns get the empty prefix (s0's
    // for_task leaves fname blank → `__task__N`).
    let nb = vec.Vec<u8>::new(g.heap);
    nb = resolve.bputs(nb, "__task_");
    if g.tfname != NONE() {
        nb = rname(nb, g.c.r, g.tfname);
    }
    nb = resolve.bputs(nb, "_");
    nb = gi64(nb, i64(g.tseq));
    g.tseq = g.tseq + 1;
    g.c.r = resolve.intern(g.c.r, nb.as_slice());
    let tname = g.c.r.res;
    nb.destroy();
    g.tasks = g.tasks.push(TSpec {
        name: tname, bo: e.b, bl: e.c, ret: inner,
        coff: coff, clen: clen,
        tp: g.cur_tp, ins: g.cur_ins,
        cfn: g.c.cur_fn, cwho: g.c.who });
    g = gfresh(g);
    let envp = g.res;
    g.pl_r = env; g.pl_val = 0;
    g.pl_rty = arr_ty; g.pl_ty = arr_ty;
    g.pl_off = u32(g.pel.len); g.pl_len = 0;
    g = e_addr(g, envp);
    while g.ax.len > 0 { g.ax.pop(); }
    g.ax = g.ax.push(AX { ty: pt, k: OK_FUN(), v: i64(tname) });
    g.ax = g.ax.push(AX { ty: pt, k: OK_REG(), v: i64(envp) });
    g = g_rtcall(g, "mml_task_spawn", pt);
    let tk = g.res; let tv = g.resv;
    g = g_envslot(g, env, arr_ty, 0);
    g = e_store(g, tk, tv);
    g.res = OK_REG(); g.resv = i64(envp);
    return g;
}
/// `join t` — token = env ptr: [0] is the runtime task, [1] the
/// result-cell pointer (s0's Join arm).
fn g_join(own g: G, read p: ast.Parser, e: ast.Expr) -> G {
    // N46 — the task's suspended writes land here; they can hit any
    // captured place: drop all bound facts.
    while g.bfacts.len > 0 { g.bfacts.pop(); }
    while g.efacts.len > 0 { g.efacts.pop(); }
    g = g_expr(g, p, e.a, NONE());
    if g.res != OK_REG() { g.res = OK_IMM(); g.resv = 0; return g; }
    let ev = u32(g.resv);
    g = g_ptrty(g);
    let pt = g.res;
    g = gfresh(g);
    let task = g.res;
    g.pl_r = ev; g.pl_val = 1;
    g.pl_rty = pt; g.pl_ty = pt;
    g.pl_off = u32(g.pel.len); g.pl_len = 0;
    g = e_load(g, task);
    while g.ax.len > 0 { g.ax.pop(); }
    g.ax = g.ax.push(AX { ty: pt, k: OK_REG(), v: i64(task) });
    g = rty(g, 9);
    g = g_rtcall(g, "mml_task_join", g.res);
    // payload ty — infer(inner)'s Task elem, void else.
    g = g_infer(g, p, e.a, NONE());
    let rt: u32 = NONE();
    if g.res2 != NONE() && u64(g.res2) < g.c.r.rtys.len {
        let n = g.c.r.rtys.buf[u64(g.res2)];
        if n.kind == 19 { rt = n.a; }
    }
    if rt == NONE() || g.c.r.rtys.buf[u64(rt)].kind == 9 {
        g.res = OK_IMM(); g.resv = 0;
        return g;
    }
    g = gfresh(g);
    let rp = g.res;
    g.c.r = resolve.mk_arr(g.c.r, pt, 2);
    let arr2 = g.c.r.res;
    g = rty(g, 6);
    let i32t = g.res;
    g.pl_r = ev; g.pl_val = 1;
    g.pl_rty = arr2;
    g.pl_off = u32(g.pel.len); g.pl_len = 0;
    g.pl_ty = pt;
    g = gpush_i(g, OK_IMM(), 1, i32t);
    g = e_load(g, rp);
    g.pl_r = rp; g.pl_val = 1;
    g.pl_rty = rt; g.pl_ty = rt;
    g.pl_off = u32(g.pel.len); g.pl_len = 0;
    return gload(g);
}
/// `fn __task_<f>_<n>($env: &void) -> &void` — s0's run_task:
/// env slots unpack into bindings, `return v` stores through
/// env[1], the tail seals a null ret (pthread contract).
fn g_task(own g: G, read p: ast.Parser, ts: TSpec) -> G {
    g.nxt = 0;
    g.nlbl = 0;
    g.cur = NONE(); g.term = 0; g.put = 0;
    g = g_ptrty(g);
    g.ret = g.res;
    g.tfname = NONE();
    g.tseq = 0;
    g.cur_tp = ts.tp; g.cur_ins = ts.ins;
    g.c.cur_fn = ts.cfn; g.c.who = ts.cwho;
    while g.slots.len > 0 { g.slots.pop(); }
    while g.frame.len > 0 { g.frame.pop(); }
    while g.loops.len > 0 { g.loops.pop(); }
    while g.promo.len > 0 { g.promo.pop(); }
    while g.rvm.len > 0 { g.rvm.pop(); }
    while g.oguards.len > 0 { g.oguards.pop(); }
    while g.dmark.len > 0 { g.dmark.pop(); }
    while g.dlist.len > 0 { g.dlist.pop(); }
    while g.bfacts.len > 0 { g.bfacts.pop(); }
    while g.efacts.len > 0 { g.efacts.pop(); }
    g = gpush(g);
    // N74 record head — the task's sole param is `$env: &void`.
    let fpo = u32(g.irpa.len);
    let fao = u32(g.irar.len);
    let fbo = u32(g.irb.len) / 8;
    g = g_lit(g, "$env");
    g.irpa = g.irpa.push(g.res);
    g.irpa = g.irpa.push(u32(0));
    g.irpa = g.irpa.push(g.ret);
    // header — `fn __task_f_n($env: &void) -> &void:`
    g.fnb = resolve.bputs(g.fnb, "fn ");
    g.fnb = rname(g.fnb, g.c.r, ts.name);
    g.fnb = resolve.bputs(g.fnb, "($env: ");
    g.fnb = gty(g.fnb, g.c.r, g.ret);
    g.fnb = resolve.bputs(g.fnb, ") -> ");
    g.fnb = gty(g.fnb, g.c.r, g.ret);
    g.fnb = resolve.bputs(g.fnb, ":\n");
    let off = u32(g.lbyt.len);
    g.lbyt = resolve.bputs(g.lbyt, "entry");
    g.lbls = g.lbls.push(loader.Span2 { off: off, len: 5 });
    g = gopen(g, u32(g.lbls.len) - 1);
    g = gfresh(g);
    let env_arg = g.res;
    g = e_arg(g, env_arg, g.ret, 0);
    let k = u64(ts.clen);
    g.c.r = resolve.mk_arr(g.c.r, g.ret, k + 2);
    let arr_ty = g.c.r.res;
    // $env binds as an alias — `*v0[i]` reads straight through.
    g = g_lit(g, "$env");
    g = gbind(g, g.res, env_arg, arr_ty, 1);
    // env[1] = the caller's result cell — `return` stores through it.
    g.taskon = 1;
    g.taskrp = 0;
    g.taskrt = ts.ret;
    g = gnew_lbl(g, "tend");
    g.taskend = g.res;
    if g.c.r.rtys.buf[u64(ts.ret)].kind != 9 {
        g = rty(g, 6);
        let i32t = g.res;
        g = gfresh(g);
        let rp = g.res;
        g.pl_r = env_arg; g.pl_val = 1;
        g.pl_rty = arr_ty;
        g.pl_off = u32(g.pel.len); g.pl_len = 0;
        g.pl_ty = g.ret;
        g = gpush_i(g, OK_IMM(), 1, i32t);
        g = e_load(g, rp);
        g.taskrp = rp;
    }
    let i: u64 = 0;
    while i < k {
        let tc = g.tcaps.buf[u64(ts.coff) + i];
        g = rty(g, 6);
        let i32t = g.res;
        g = gfresh(g);
        let cv = g.res;
        g.pl_r = env_arg; g.pl_val = 1;
        g.pl_rty = arr_ty;
        g.pl_off = u32(g.pel.len); g.pl_len = 0;
        g.pl_ty = g.ret;
        g = gpush_i(g, OK_IMM(), i64(i) + 2, i32t);
        g = e_load(g, cv);
        if tc.pc == 1 {
            // ptr-class — the env slot IS the pointer value; an
            // ordinary local rebuilds the binding.
            g = gfresh(g);
            let slot = g.res;
            g = e_local(g, slot, tc.ty, tc.n);
            g.pl_r = slot; g.pl_val = 0;
            g.pl_rty = tc.ty; g.pl_ty = tc.ty;
            g.pl_off = u32(g.pel.len); g.pl_len = 0;
            g = e_store(g, OK_REG(), i64(cv));
            g = gbind(g, tc.n, slot, tc.ty, 0);
        } else {
            // storage — the env slot carries the ADDRESS; the task
            // aliases the caller's frame directly.
            g = gbind(g, tc.n, cv, tc.ty, 1);
        }
        i = i + 1;
    }
    g = g_stmts(g, p, ts.bo, ts.bl);
    if g.term == 0 || g.cur != NONE() {
        g = g_defer_above(g, p, 0);
        g = gseal_jmp(g, g.taskend);
    }
    g = gopen(g, g.taskend);
    // guards still open at fn end release here — a task that locks
    // without unlock relies on scope-exit semantics.
    g = g_unlockall(g);
    g = gconst(g, g.ret, 0);
    g = gseal_ret(g, 1, g.res, g.resv, g.ret);
    g.taskon = 0;
    g.ftx = resolve.bpush(g.ftx, g.fnb.as_slice());
    while g.fnb.len > 0 { g.fnb.pop(); }
    // N74 record tail — `__task_<f>_<n>($env:&void) -> &void`.
    g.irf = g.irf.push(ts.name);
    g.irf = g.irf.push(g.ret);
    g.irf = g.irf.push(fpo);
    g.irf = g.irf.push(u32(g.irpa.len) / 3 - fpo / 3);
    g.irf = g.irf.push(fao);
    g.irf = g.irf.push(u32(g.irar.len) - fao);
    g.irf = g.irf.push(fbo);
    g.irf = g.irf.push(u32(g.irb.len) / 8 - fbo);
    g = gpop(g, p);
    return g;
}

/// scope exit — defers replay on the live fall-through edge before
/// the slots die (defer band); `promote`d bindings move one scope
/// outward — they re-push on top, so a later same-name let shadows
/// them exactly like Stage-0's outer-scope insert.
fn gpop(own g: G, read p: ast.Parser) -> G {
    let base = g.frame.buf[g.frame.len - 1];
    g.frame.pop();
    // N54 — the dying scope's deferred calls replay first, LIFO —
    // the defer is the younger claim, running while its operand
    // names still resolve. A dead tail replays nothing.
    let db = u64(g.dmark.buf[g.dmark.len - 1]);
    g.dmark.pop();
    let dj = g.dlist.len;
    if g.term == 0 || g.cur != NONE() {
        while dj > db {
            dj = dj - 1;
            g = g_expr(g, p, g.dlist.buf[dj], NONE());
        }
    }
    while g.dlist.len > db { g.dlist.pop(); }
    // guard-bound slots in the dying scope release — emission rides
    // the live-or-dead state of the current block like s0's pop.
    let keep = vec.Vec<Slot>::new(g.heap);
    let i = u64(base);
    while i < g.slots.len {
        let s = g.slots.buf[i];
        if g.c.r.rtys.buf[u64(s.ty)].kind == 22
            && og_at(g, s.r) < g.oguards.len {
            g = g_unlockslot(g, s.r);
            g = og_rel(g, s.r);
        }
        if vhas2(g.promo, s.n) == 1 { keep = keep.push(s); }
        i = i + 1;
    }
    while u64(g.slots.len) > u64(base) { g.slots.pop(); }
    i = 0;
    while i < keep.len {
        g.slots = g.slots.push(keep.buf[i]);
        i = i + 1;
    }
    keep.destroy();
    return g;
}

/// `const_of` — a const instr, opnd result.
fn gconst(own g: G, ty: u32, n: i64) -> G {
    g = gfresh(g);
    let d = g.res;
    g = e_const(g, d, ty, n);
    g.res = OK_REG();
    g.resv = i64(d);
    return g;
}

/// place(Var) — slot or alias root, empty path.
fn gplace_var(own g: G, nid: u32) -> G {
    g = gfind(g, nid);
    if g.res == NONE() {
        g.res3 = NONE();
        return g;
    }
    g.pl_r = g.res2;
    g.pl_val = u8(g.res4);
    g.pl_rty = g.res3;
    g.pl_ty = g.res3;
    g.pl_off = u32(g.pel.len);
    g.pl_len = 0;
    g.res3 = g.pl_ty;
    return g;
}

/// load_place — `v = load.pl.ty place`, opnd result.
fn gload(own g: G) -> G {
    g = gfresh(g);
    let d = g.res;
    g = e_load(g, d);
    g.res = OK_REG();
    g.resv = i64(d);
    return g;
}

// ---- expression typing — mirrors FnGen::infer ----------------------

fn is_int_k(k: u8) -> u8 { if k <= 7 { return 1; } return 0; }
/// Ty::is_int — atomic storage is transparent to the int shape.
fn is_int_t(read g: G, t: u32) -> u8 {
    let n = g.c.r.rtys.buf[u64(t)];
    if n.kind <= 7 { return 1; }
    if n.kind == 20 { return is_int_t(g, n.a); }
    return 0;
}
/// Ty::is_ptr_like — Ref/Ptr/Handle/Guard/Channel/Mutex/Task/Box/Alloc.
fn is_ptrlike_k(k: u8) -> u8 {
    if k == 11 { return 1; }
    if k == 15 || k == 16 { return 1; }
    if k == 18 || k == 19 { return 1; }
    if k == 21 || k == 22 || k == 23 || k == 24 { return 1; }
    return 0;
}

/// resolved-prim helper — intern a primitive rty by kind.
fn rty(own g: G, k: u8) -> G {
    let i: u64 = 0;
    while i < g.c.r.rtys.len {
        let t = g.c.r.rtys.buf[i];
        if t.kind == k && t.name == 0 && t.a == 0 && t.b == 0
            && t.c == 0 && t.w == 0 {
            g.res = u32(i);
            return g;
        }
        i = i + 1;
    }
    g.c.r.rtys = g.c.r.rtys.push(resolve.RTy {
        kind: k, name: 0, a: 0, b: 0, c: 0, w: 0 });
    g.res = u32(g.c.r.rtys.len) - 1;
    return g;
}
/// `a == b` on tyids, modulo node-identity — prim nodes don't
/// intern (`mk_prim` pushes dup `i64`s), so s0's `Ty` equality is
/// full-record equality here. res=1 iff same.
fn g_same_ty(own g: G, a: u32, b: u32) -> G {
    if a == b { g.res = 1; return g; }
    let na = g.c.r.rtys.buf[u64(a)];
    let nb = g.c.r.rtys.buf[u64(b)];
    if na.kind == nb.kind && na.name == nb.name
        && na.a == nb.a && na.b == nb.b
        && na.c == nb.c && na.w == nb.w {
        g.res = 1;
        return g;
    }
    g.res = 0;
    return g;
}
/// &T / &mut T rty — mk_un(15, elem, mutf).
fn rty_ref(own g: G, elem: u32, mutf: u32) -> G {
    g.c.r = resolve.mk_un(g.c.r, 15, elem, mutf);
    g.res = g.c.r.res;
    return g;
}

/// `&void` — Stage-0's ptr_ty (`Ty::Ref{mutable:false, void}`).
fn g_ptrty(own g: G) -> G {
    g = rty(g, 9);
    let vd = g.res;
    g.c.r = resolve.mk_un(g.c.r, 15, vd, 0);
    g.res = g.c.r.res;
    return g;
}

/// shared call emit — `v = call.ret f(ty a, ..)` reading staged
/// `g.ax` args. res/resv = result opnd (Imm 0 for void).
fn g_callemit(own g: G, vn: u32, ret: u32) -> G {
    let d: u32 = NONE();
    if ret != NONE() {
        if g.c.r.rtys.buf[u64(ret)].kind != 9 {
            g = gfresh(g);
            d = g.res;
        }
    }
    g = ge(g);
    let xo = u32(g.irax.len);
    let xj: u64 = 0;
    while xj < g.ax.len {
        g.irax = g.irax.push(g.ax.buf[xj]);
        xj = xj + 1;
    }
    g = irec(g, 16, d, ret, vn, xo, u32(g.irax.len) - xo, 0, 0);
    if d != NONE() {
        g.fnb = gr(g.fnb, d);
        g.fnb = resolve.bputs(g.fnb, " = call.");
    } else {
        g.fnb = resolve.bputs(g.fnb, "call.");
    }
    g.fnb = gty(g.fnb, g.c.r, ret);
    g.fnb = g.fnb.push(u8(32));
    g.fnb = rname(g.fnb, g.c.r, vn);
    g.fnb = g.fnb.push(u8(40));
    let j: u64 = 0;
    while j < g.ax.len {
        if j > 0 { g.fnb = resolve.bputs(g.fnb, ", "); }
        let axr = g.ax.buf[j];
        g.fnb = gty(g.fnb, g.c.r, axr.ty);
        g.fnb = g.fnb.push(u8(32));
        g.fnb = gop(g.fnb, g.c.r, axr.k, axr.v);
        j = j + 1;
    }
    g.fnb = g.fnb.push(u8(41));
    g = geol(g);
    if d != NONE() {
        g.res = OK_REG(); g.resv = i64(i32(d));
    } else {
        g.res = OK_IMM(); g.resv = 0;
    }
    return g;
}

/// fill_enum — `store.i64 pl.tag, vidx` then `store.pty pl.payload, v`
/// for a payload variant (s0's fill_enum). pl_* holds the enum place
/// on entry and is restored on exit.
fn g_fillenum(own g: G, read p: ast.Parser, ei: u32, vnid: u32,
              pay: u32, aty: u32) -> G {
    let ed = g.c.r.edecls.buf[u64(ei)];
    // instantiated enum — `Maybe<i32>` substitutes `T := i32`; the
    // template's variant tys stay `T` in the decl range.
    let voff = u64(ed.vs_off);
    let vlen = u64(ed.vs_len);
    let tn = g.c.r.rtys.buf[u64(aty)];
    if tn.kind == 13 {
        voff = g.c.r.vars.len;
        g.c.r = resolve.subst_variants(g.c.r, ei, tn.b, tn.c);
        if g.c.r.suberr != 0 { voff = u64(ed.vs_off); }
    }
    let idx: i64 = 0;
    let pty: u32 = NONE();
    let vi: u64 = 0;
    while vi < vlen {
        let vr = g.c.r.vars.buf[voff + vi];
        if vr.name == vnid { idx = i64(vi); pty = vr.ty; }
        vi = vi + 1;
    }
    let bo = g.pl_off; let bl = g.pl_len;
    let br_ = g.pl_r; let bv_ = g.pl_val;
    let brt = g.pl_rty; let bty = g.pl_ty;
    while u64(g.pel.len) > u64(bo) + u64(bl) { g.pel.pop(); }
    g = g_lit(g, "tag");
    let tagn = g.res;
    g = rty(g, 7);
    let i64t = g.res;
    g = gpush_f(g, tagn, 0, i64t);
    g.pl_ty = i64t;
    g = e_store(g, OK_IMM(), idx);
    while u64(g.pel.len) > u64(bo) + u64(bl) { g.pel.pop(); }
    g.pl_len = bl; g.pl_ty = bty;
    if pay != NONE() {
        if pty == NONE() { g = rty(g, 9); pty = g.res; }
        g = g_expr(g, p, pay, pty);
        let vk = g.res; let vv = g.resv;
        // the payload eval clobbered the place regs — restore.
        g.pl_r = br_; g.pl_val = bv_; g.pl_rty = brt;
        g.pl_ty = bty; g.pl_off = bo; g.pl_len = bl;
        while u64(g.pel.len) > u64(bo) + u64(bl) { g.pel.pop(); }
        g = g_lit(g, "payload");
        let payn = g.res;
        g = gpush_f(g, payn, 1, pty);
        g.pl_ty = pty;
        g = e_store(g, vk, vv);
        while u64(g.pel.len) > u64(bo) + u64(bl) { g.pel.pop(); }
        g.pl_len = bl;
    }
    g.pl_r = br_; g.pl_val = bv_; g.pl_rty = brt;
    g.pl_ty = bty; g.pl_off = bo; g.pl_len = bl;
    return g;
}

/// arm bind mode — the checker's `abinds` row: (match span, variant)
/// -> 0 value | 1 ref. Missing row = value (s0's unwrap_or(Value)).
fn g_abind(read g: G, line: u32, col: u32, vn: u32) -> u8 {
    let i: u64 = 0;
    while i < g.c.abinds.len {
        let ab = g.c.abinds.buf[i];
        if ab.line == line && ab.col == col && ab.variant == vn
            && ab.who == g.c.who && ab.ctx == g.c.cur_fn {
            return ab.byref;
        }
        i = i + 1;
    }
    return 0;
}

/// byte-lex less-than over two ranges in an arena.
fn eb_less(read a: vec.Vec<u8>, ao: u32, al: u32,
           bo: u32, bl: u32) -> u8 {
    let i: u64 = 0;
    while i < u64(al) && i < u64(bl) {
        let x = a.buf[u64(ao) + i];
        let y = a.buf[u64(bo) + i];
        if x != y {
            if x < y { return 1; }
            return 0;
        }
        i = i + 1;
    }
    if al < bl { return 1; }
    return 0;
}

/// match yield ty — the checker's `myields` join at (line,col);
/// NONE when the span never checked (diagnosed paths).
fn g_mty(read g: G, line: u32, col: u32) -> u32 {
    let i: u64 = 0;
    while i < g.c.ysave.len {
        let my = g.c.ysave.buf[i];
        if my.line == line && my.col == col
            && my.who == g.c.who && my.ctx == g.c.cur_fn {
            return my.ty;
        }
        i = i + 1;
    }
    return NONE();
}

/// gen_match — tag compare-chain + arm bodies + `$match` yield slot.
/// res/resv = the result opnd (Imm 0 for stmt-position matches).
fn g_match(own g: G, read p: ast.Parser, scr: u32, ab: u32, ac: u32,
           line: u32, col: u32, want: u32) -> G {
    let mty = g_mty(g, line, col);
    if mty == NONE() { g = rty(g, 9); mty = g.res; }
    let mvoid: u8 = 0;
    if g.c.r.rtys.buf[u64(mty)].kind == 9 { mvoid = 1; }
    let mslot: u32 = NONE();
    if mvoid == 0 {
        g = gfresh(g);
        mslot = g.res;
        g = g_lit(g, "$match");
        g = e_local(g, mslot, mty, g.res);
    }
    g = gnew_lbl(g, "match.end");
    let endl = g.res;
    let albs = vec.Vec<u32>::new(g.heap);    // (arm, next) pairs
    let i: u64 = 0;
    while i < u64(ac) {
        g = gnew_lbl(g, "arm");
        albs = albs.push(g.res);
        g = gnew_lbl(g, "next");
        albs = albs.push(g.res);
        i = i + 1;
    }
    // tag load — scrut place + .tag
    let tk: u32 = OK_IMM(); let tv: i64 = 0;
    g = rty(g, 7);
    let i64t = g.res;
    g = g_place(g, p, scr);
    if g.res3 != NONE() {
        let bo = g.pl_off; let bl = g.pl_len;
        while u64(g.pel.len) > u64(bo) + u64(bl) { g.pel.pop(); }
        g = g_lit(g, "tag");
        let tagn = g.res;
        g = gpush_f(g, tagn, 0, i64t);
        g.pl_ty = i64t;
        g = gload(g);
        tk = g.res; tv = g.resv;
    }
    // enum decl + (substituted) variant range for the scrutinee ty
    let ei: u32 = NONE();
    let voff: u64 = 0; let vlen: u64 = 0;
    g = g_infer(g, p, scr, NONE());
    let sty = g.res2;
    if sty != NONE() && u64(sty) < g.c.r.rtys.len {
        let sn = g.c.r.rtys.buf[u64(sty)];
        if sn.kind == 12 || sn.kind == 13 {
            g = g_declof(g, sn.name);
            ei = g.res2;
        }
        if ei != NONE() {
            let ed = g.c.r.edecls.buf[u64(ei)];
            voff = u64(ed.vs_off); vlen = u64(ed.vs_len);
            if sn.kind == 13 {
                voff = g.c.r.vars.len;
                g.c.r = resolve.subst_variants(
                    g.c.r, ei, sn.b, sn.c);
                if g.c.r.suberr != 0 { voff = u64(ed.vs_off); }
            }
        }
    }
    g.frame = g.frame.push(u32(g.slots.len));
    g.dmark = g.dmark.push(u32(g.dlist.len));
    i = 0;
    while i < u64(ac) {
        let a = p.arms.buf[u64(ab) + i];
        let this = albs.buf[i * 2];
        let nxt = albs.buf[i * 2 + 1];
        g.c.r = resolve.intern_pname(g.c.r, p, a.variant);
        let avn = g.c.r.res;
        let wild = check.nid_lit_eq(g.c, avn, "_");
        let vidx: i64 = 0 - 1;
        let vty: u32 = NONE();
        if ei != NONE() {
            let j: u64 = 0;
            while j < vlen {
                let vr = g.c.r.vars.buf[voff + j];
                if vr.name == avn { vidx = i64(j); vty = vr.ty; }
                j = j + 1;
            }
        }
        if wild || vidx < 0 {
            g = gseal_jmp(g, this);
        } else {
            g = gfresh(g);
            let cc = g.res;
            g = e_bin(g, cc, 5, i64t, tk, tv, OK_IMM(), vidx);
            g = gseal_br(g, OK_REG(), i64(cc), this, nxt);
        }
        g = gopen(g, this);
        // payload bind — `V(b)`: value loads a copy into a fresh
        // slot; ref stores the payload's address (&T binder).
        if a.bind != NONE() && ei != NONE() && vty != NONE() {
            g = g_place(g, p, scr);
            if g.res3 != NONE() {
                let bo = g.pl_off; let bl = g.pl_len;
                while u64(g.pel.len) > u64(bo) + u64(bl) {
                    g.pel.pop();
                }
                g = gpush_f(g, avn, 1, vty);
                g.pl_ty = vty;
                g.c.r = resolve.intern_pname(g.c.r, p, a.bind);
                let bn = g.c.r.res;
                let mode = g_abind(g, line, col, avn);
                if mode == 0 {
                    g = gload(g);
                    let pvk = g.res; let pvv = g.resv;
                    g = gfresh(g);
                    let bs = g.res;
                    g = e_local(g, bs, vty, bn);
                    g.pl_r = bs; g.pl_val = 0;
                    g.pl_rty = vty; g.pl_ty = vty;
                    g.pl_off = u32(g.pel.len); g.pl_len = 0;
                    g = e_store(g, pvk, pvv);
                    g.slots = g.slots.push(
                        Slot { n: bn, r: bs, ty: vty, al: 0 });
                } else {
                    g = gfresh(g);
                    let ar = g.res;
                    g = e_addr(g, ar);
                    g.c.r = resolve.mk_un(g.c.r, 15, vty, 0);
                    let rty_ = g.c.r.res;
                    g = gfresh(g);
                    let bs = g.res;
                    g = e_local(g, bs, rty_, bn);
                    g.pl_r = bs; g.pl_val = 0;
                    g.pl_rty = rty_; g.pl_ty = rty_;
                    g.pl_off = u32(g.pel.len); g.pl_len = 0;
                    g = e_store(g, OK_REG(), i64(ar));
                    g.slots = g.slots.push(
                        Slot { n: bn, r: bs, ty: rty_, al: 0 });
                }
            }
        }
        // arm body — `=> expr` arms' tail stmt is the yield
        let blen = a.len;
        let tail: u32 = NONE();
        if a.expr_arm == 1 && a.len > 0 {
            blen = a.len - 1;
            tail = p.u32s.buf[u64(a.off) + u64(a.len) - 1];
        }
        // N54 — arm bodies share the match's defer list: `amark`
        // isolates the entries THIS arm registers.
        let amark = u32(g.dlist.len);
        if blen > 0 { g = g_stmts(g, p, a.off, blen); }
        if tail != NONE() && mvoid == 0
            && (g.term == 0 || g.cur != NONE()) {
            let ts = p.stmts.buf[u64(tail)];
            if u32(check.sk_num(ts.kind)) == 7 {
                g = g_expr(g, p, ts.a, mty);
                let vk = g.res; let vv = g.resv;
                g.pl_r = mslot; g.pl_val = 0;
                g.pl_rty = mty; g.pl_ty = mty;
                g.pl_off = u32(g.pel.len); g.pl_len = 0;
                g = e_store(g, vk, vv);
            }
        }
        // the arm's scope dies here — its defers replay LIFO on the
        // live edge, and the entries are drained either way.
        let dj = g.dlist.len;
        if g.term == 0 || g.cur != NONE() {
            while dj > u64(amark) {
                dj = dj - 1;
                g = g_expr(g, p, g.dlist.buf[dj], NONE());
            }
            g = gseal_jmp(g, endl);
        }
        while g.dlist.len > u64(amark) { g.dlist.pop(); }
        g = gopen(g, nxt);
        i = i + 1;
    }
    // fell off the last next — wildcard caught it, or diagnosed.
    g = gseal_dead(g);
    g = gopen(g, endl);
    albs.destroy();
    g = gpop(g, p);
    if mvoid == 0 {
        g.pl_r = mslot; g.pl_val = 0;
        g.pl_rty = mty; g.pl_ty = mty;
        g.pl_off = u32(g.pel.len); g.pl_len = 0;
        return gload(g);
    }
    g.res = OK_IMM(); g.resv = 0;
    return g;
}

/// `expr?` — N23's mid-expression tag branch: the Err path
/// rebuilds THIS fn's return enum and returns; Ok yields the
/// payload (s0's Expr::Try arm).
fn g_try(own g: G, read p: ast.Parser, eid: u32) -> G {
    let e = check.xexp(g.c, p, eid);
    g = g_infer(g, p, e.a, NONE());
    let sty = g.res2;
    if sty == NONE() || u64(sty) >= g.c.r.rtys.len {
        g.res = OK_IMM(); g.resv = 0; return g;
    }
    let sn = g.c.r.rtys.buf[u64(sty)];
    if sn.kind != 12 && sn.kind != 13 {
        g.res = OK_IMM(); g.resv = 0; return g;
    }
    g = g_declof(g, sn.name);
    let ei = g.res2;
    if ei == NONE() { g.res = OK_IMM(); g.resv = 0; return g; }
    let ed = g.c.r.edecls.buf[u64(ei)];
    let voff = u64(ed.vs_off);
    let vlen = u64(ed.vs_len);
    if sn.kind == 13 {
        voff = g.c.r.vars.len;
        g.c.r = resolve.subst_variants(g.c.r, ei, sn.b, sn.c);
        if g.c.r.suberr != 0 { voff = u64(ed.vs_off); }
    }
    // variant positions — s0's position("Ok")/position("Err")
    let okidx: i64 = 0; let erridx: i64 = 1;
    let okty: u32 = NONE(); let errty: u32 = NONE();
    let i: u64 = 0;
    while i < vlen {
        let vr = g.c.r.vars.buf[voff + i];
        if check.nid_lit_eq(g.c, vr.name, "Ok") {
            okidx = i64(i); okty = vr.ty;
        }
        if check.nid_lit_eq(g.c, vr.name, "Err") {
            erridx = i64(i); errty = vr.ty;
        }
        i = i + 1;
    }
    if okty == NONE() { g = rty(g, 9); okty = g.res; }
    if errty == NONE() { g = rty(g, 9); errty = g.res; }
    // materialize the scrutinee into a place — payloads sit under
    // field 1 of {tag, payload}.
    g = g_place(g, p, e.a);
    if g.res3 == NONE() {
        g = g_expr(g, p, e.a, sty);
        let vk = g.res; let vv = g.resv;
        g = gfresh(g);
        let slot = g.res;
        g = e_local(g, slot, sty, NONE());
        g.pl_r = slot; g.pl_val = 0;
        g.pl_rty = sty; g.pl_ty = sty;
        g.pl_off = u32(g.pel.len); g.pl_len = 0;
        g = e_store(g, vk, vv);
    }
    let pr = g.pl_r; let pv = g.pl_val;
    let prt = g.pl_rty; let pt = g.pl_ty;
    let po = g.pl_off; let pl = g.pl_len;
    // tag test: `eq tag, err_idx` → try.err/try.ok
    g = rty(g, 7);
    let i64t = g.res;
    g.pl_r = pr; g.pl_val = pv; g.pl_rty = prt;
    g.pl_ty = pt; g.pl_off = po; g.pl_len = pl;
    while u64(g.pel.len) > u64(po) + u64(pl) { g.pel.pop(); }
    g = g_lit(g, "tag");
    g = gpush_f(g, g.res, 0, i64t);
    g.pl_ty = i64t;
    g = gload(g);
    let tk = g.res; let tv = g.resv;
    g = gfresh(g);
    let cc = g.res;
    g = e_bin(g, cc, 5, i64t, tk, tv, OK_IMM(), erridx);
    g = gnew_lbl(g, "try.err");
    let el = g.res;
    g = gnew_lbl(g, "try.ok");
    let kl = g.res;
    g = gseal_br(g, OK_REG(), i64(cc), el, kl);
    // Err block — `return Ret::Err(payload)`; the ret enum's own
    // Err index may differ from the scrutinee's.
    g = gopen(g, el);
    let rty = g.ret;
    g = gfresh(g);
    let rslot = g.res;
    g = e_local(g, rslot, rty, NONE());
    let rerr: i64 = 1;
    if u64(rty) < g.c.r.rtys.len {
        let rn = g.c.r.rtys.buf[u64(rty)];
        let reid: u32 = NONE();
        if rn.kind == 12 || rn.kind == 13 {
            g = g_declof(g, rn.name);
            reid = g.res2;
        }
        if reid == NONE() { reid = ei; }
        let red = g.c.r.edecls.buf[u64(reid)];
        let roff = u64(red.vs_off);
        let rlen = u64(red.vs_len);
        if rn.kind == 13 {
            roff = g.c.r.vars.len;
            g.c.r = resolve.subst_variants(
                g.c.r, reid, rn.b, rn.c);
            if g.c.r.suberr != 0 { roff = u64(red.vs_off); }
        }
        i = 0;
        while i < rlen {
            let vr = g.c.r.vars.buf[roff + i];
            if check.nid_lit_eq(g.c, vr.name, "Err") {
                rerr = i64(i);
            }
            i = i + 1;
        }
    }
    g.pl_r = rslot; g.pl_val = 0;
    g.pl_rty = rty; g.pl_ty = rty;
    g.pl_off = u32(g.pel.len); g.pl_len = 0;
    g = g_lit(g, "tag");
    g = gpush_f(g, g.res, 0, i64t);
    g.pl_ty = i64t;
    g = e_store(g, OK_IMM(), rerr);
    // ev = scrutinee.Err; rslot.Err = ev
    g.pl_r = pr; g.pl_val = pv; g.pl_rty = prt;
    g.pl_ty = pt; g.pl_off = po; g.pl_len = pl;
    while u64(g.pel.len) > u64(po) + u64(pl) { g.pel.pop(); }
    g = g_lit(g, "Err");
    g = gpush_f(g, g.res, 1, errty);
    g.pl_ty = errty;
    g = gload(g);
    let evk = g.res; let evv = g.resv;
    g.pl_r = rslot; g.pl_val = 0;
    g.pl_rty = rty; g.pl_ty = rty;
    g.pl_off = u32(g.pel.len); g.pl_len = 0;
    g = g_lit(g, "Err");
    g = gpush_f(g, g.res, 1, errty);
    g.pl_ty = errty;
    g = e_store(g, evk, evv);
    g.pl_r = rslot; g.pl_val = 0;
    g.pl_rty = rty; g.pl_ty = rty;
    g.pl_off = u32(g.pel.len); g.pl_len = 0;
    g = gload(g);
    let rvk = g.res; let rvv = g.resv;
    // N54 — `?` unwinds the whole stack: every live defer replays
    // before the Err return leaves.
    g = g_defer_above(g, p, 0);
    g = gseal_ret(g, 1, rvk, rvv, rty);
    // Ok block — the expr's value is the payload.
    g = gopen(g, kl);
    g.pl_r = pr; g.pl_val = pv; g.pl_rty = prt;
    g.pl_ty = pt; g.pl_off = po; g.pl_len = pl;
    while u64(g.pel.len) > u64(po) + u64(pl) { g.pel.pop(); }
    g = g_lit(g, "Ok");
    g = gpush_f(g, g.res, 1, okty);
    g.pl_ty = okty;
    return gload(g);
}

/// `mml_*` runtime call — literal name, args staged in `g.ax`.
fn g_rtcall(own g: G, f: str, ret: u32) -> G {
    g = g_lit(g, f);
    let vn = g.res;
    return g_callemit(g, vn, ret);
}

/// i64v — runtime-boundary width coercion (Imm and i64 pass).
fn g_i64v(own g: G, t: u32, k: u32, v: i64) -> G {
    if k == OK_IMM() { g.res = k; g.resv = v; return g; }
    if g.c.r.rtys.buf[u64(t)].kind == 7 {
        g.res = k; g.resv = v;
        return g;
    }
    g = rty(g, 7);
    let i64t = g.res;
    g = gfresh(g);
    let d = g.res;
    g = e_cast(g, d, t, k, v, i64t);
    g.res = OK_REG(); g.resv = i64(d);
    return g;
}

/// str_parts — extract the (ptr, len) halves of a {ptr,u64} value.
/// res/resv = ptr opnd, res4/resv2 = len opnd.
fn g_strparts(own g: G, k: u32, v: i64) -> G {
    g = g_ptrty(g);
    let pt = g.res;
    g = gfresh(g);
    let d0 = g.res;
    g = e_extract(g, d0, pt, k, v, 0);
    g = rty(g, 3);
    let lt = g.res;
    g = gfresh(g);
    let d1 = g.res;
    g = e_extract(g, d1, lt, k, v, 1);
    g.res = OK_REG(); g.resv = i64(d0);
    g.res4 = OK_REG(); g.resv2 = i64(d1);
    return g;
}

/// make_agg2 — fill an anonymous `{ptr, len}` slot, load it back.
fn g_makeagg2(own g: G, sty: u32, pk: u32, pv: i64,
              lk: u32, lv: i64) -> G {
    g = gfresh(g);
    let slot = g.res;
    g = e_local(g, slot, sty, NONE());
    g.pl_r = slot; g.pl_val = 0; g.pl_rty = sty;
    g.pl_off = u32(g.pel.len); g.pl_len = 0;
    g = g_ptrty(g);
    let pt = g.res;
    g = g_lit(g, "ptr");
    g = gpush_f(g, g.res, 0, pt);
    g.pl_ty = pt;
    g = e_store(g, pk, pv);
    while u64(g.pel.len) > u64(g.pl_off) { g.pel.pop(); }
    g.pl_len = 0;
    g = rty(g, 3);
    let lt = g.res;
    g = g_lit(g, "len");
    g = gpush_f(g, g.res, 1, lt);
    g.pl_ty = lt;
    g = e_store(g, lk, lv);
    while u64(g.pel.len) > u64(g.pl_off) { g.pel.pop(); }
    g.pl_len = 0;
    g.pl_ty = sty;
    return gload(g);
}

/// `&b[lo..hi]` — range check (skipped when all-constant), start
/// ptr, then the {ptr, len} slice aggregate. res/resv = opnd.
fn g_slicerange(own g: G, read p: ast.Parser, base: u32,
                lo: u32, hi: u32, mutf: u32) -> G {
    g.res = OK_IMM(); g.resv = 0;
    g = g_place(g, p, base);
    if g.res3 == NONE() { return g; }
    let bty = g.pl_ty;
    let br_ = g.pl_r; let bv_ = g.pl_val;
    let brt = g.pl_rty; let bo = g.pl_off; let bl = g.pl_len;
    let bn = g.c.r.rtys.buf[u64(bty)];
    let elem: u32 = NONE();
    let limk: u32 = OK_IMM(); let limv: i64 = 0;
    if bn.kind == 14 {
        elem = bn.a; limk = OK_IMM(); limv = i64(bn.w);
    }
    if bn.kind == 17 || bn.kind == 25 {
        elem = bn.a;
        g = rty(g, 3);
        let lt = g.res;
        g = g_lit(g, "len");
        g = gpush_f(g, g.res, 1, lt);
        g.pl_ty = lt;
        g = gload(g);
        limk = g.res; limv = g.resv;
        while u64(g.pel.len) > u64(bo) + u64(bl) { g.pel.pop(); }
        g.pl_off = bo; g.pl_len = bl; g.pl_ty = bty;
    }
    if elem == NONE() { return g; }
    g = rty(g, 7);
    let i64t = g.res;
    // bound evals — Int folds to an immediate; absent → default.
    let lok: u32 = OK_IMM(); let lov: i64 = 0;
    if lo != NONE() {
        let le = check.xexp(g.c, p, lo);
        if check.ek_num(le.kind) == 0 {
            lok = OK_IMM(); lov = le.w;
        } else {
            g = g_infer(g, p, lo, i64t);
            let it = g.res2;
            g = g_expr(g, p, lo, it);
            g = g_i64v(g, it, g.res, g.resv);
            lok = g.res; lov = g.resv;
        }
    }
    let hik: u32 = limk; let hiv: i64 = limv;
    if hi != NONE() {
        let he = check.xexp(g.c, p, hi);
        if check.ek_num(he.kind) == 0 {
            hik = OK_IMM(); hiv = he.w;
        } else {
            g = g_infer(g, p, hi, i64t);
            let it = g.res2;
            g = g_expr(g, p, hi, it);
            g = g_i64v(g, it, g.res, g.resv);
            hik = g.res; hiv = g.resv;
        }
    }
    // N46 — all-constant ranges skip the check, as does a range the
    // dominating-cond facts already prove (`0 <= lo <= hi <= len`).
    if lok != OK_IMM() || hik != OK_IMM() || limk != OK_IMM() {
        g = gb_range(g, p, lo, hi, base);
        if g.res == 0 {
            while g.ax.len > 0 { g.ax.pop(); }
            g.ax = g.ax.push(AX { ty: i64t, k: lok, v: lov });
            g.ax = g.ax.push(AX { ty: i64t, k: hik, v: hiv });
            g.ax = g.ax.push(AX { ty: i64t, k: limk, v: limv });
            g = rty(g, 9);
            g = g_rtcall(g, "mml_range_check", g.res);
        }
    }
    // start place — `&base[lo]`; a re-slice steps off .ptr, an
    // array base indexes into its own storage.
    if bn.kind == 14 {
        g.pl_r = br_; g.pl_val = bv_; g.pl_rty = brt;
        g.pl_off = bo; g.pl_len = bl; g.pl_ty = elem;
        g = gpush_i(g, lok, lov, i64t);
    } else {
        let bm: u32 = 1;
        if bn.kind == 17 { bm = bn.b; }
        g.c.r = resolve.mk_un(g.c.r, 16, elem, bm);
        let pt = g.c.r.res;
        // nested bound evals append dead path elems — truncate back
        // to the base's tail before re-pushing `.ptr`.
        while u64(g.pel.len) > u64(bo) + u64(bl) { g.pel.pop(); }
        g.pl_r = br_; g.pl_val = bv_; g.pl_rty = brt;
        g.pl_off = bo; g.pl_len = bl; g.pl_ty = pt;
        g = g_lit(g, "ptr");
        g = gpush_f(g, g.res, 0, pt);
        g.pl_ty = pt;
        g = gload(g);
        if g.res != OK_REG() { return g; }
        while u64(g.pel.len) > u64(bo) + u64(bl) {
            g.pel.pop();
        }
        g.pl_r = u32(g.resv); g.pl_val = 1; g.pl_rty = pt;
        g.pl_off = u32(g.pel.len); g.pl_len = 0;
        g.pl_ty = elem;
        g = gpush_i(g, lok, lov, i64t);
    }
    g = gfresh(g);
    let dptr = g.res;
    g = e_addr(g, dptr);
    let lenk: u32 = OK_IMM(); let lenv: i64 = 0;
    if hik == OK_IMM() && lok == OK_IMM() {
        lenk = OK_IMM(); lenv = hiv - lov;
    } else {
        g = gfresh(g);
        let dd = g.res;
        g = e_bin(g, dd, 1, i64t, hik, hiv, lok, lov);
        lenk = OK_REG(); lenv = i64(dd);
    }
    g.c.r = resolve.mk_un(g.c.r, 17, elem, mutf);
    return g_makeagg2(g, g.c.r.res, OK_REG(), i64(dptr), lenk, lenv);
}

/// is_concrete — no tparam anywhere (kind-12 names must be real
/// concrete decls; tparams intern as unregistered kind-12 names).
fn g_conc(own g: G, t: u32) -> G {
    let n = g.c.r.rtys.buf[u64(t)];
    if n.kind == 12 {
        g.res = 0;
        if u64(n.name) < g.c.r.conc.len
            && g.c.r.conc.buf[u64(n.name)] == 1 {
            g.res = 1;
        }
        return g;
    }
    if n.kind == 13 {
        let i: u64 = 0;
        while i < u64(n.c) {
            g = g_conc(g, g.c.r.targs.buf[u64(n.b) + i]);
            if g.res == 0 { return g; }
            i = i + 1;
        }
        g.res = 1; return g;
    }
    if n.kind >= 14 && n.kind <= 25 { return g_conc(g, n.a); }
    g.res = 1;
    return g;
}

/// fdecl by resolved name — the check_call2 scan: own-module any,
/// deps pub-or-extern, templates excluded.
fn g_fdecl(own g: G, vn: u32) -> G {
    let i: u64 = 0;
    g.res = NONE();
    while i < g.c.r.fdecls.len {
        let fd = g.c.r.fdecls.buf[i];
        if fd.name == vn && fd.tps_len == 0
            && vhas2(g.c.vprogs, fd.prog) == 1
            && (fd.prog == g.c.who || fd.pub_ == 1
                || fd.ext == 1) {
            g.res = u32(i);
        }
        i = i + 1;
    }
    return g;
}
/// push a Field path elem — name nid + struct idx + field ty.
fn gpush_f(own g: G, name: u32, idx: u32, ty: u32) -> G {
    g.pel = g.pel.push(PE {
        kind: 0, name: name, idx: idx, ty: ty, ok: 0, ov: 0 });
    g.pl_len = g.pl_len + 1;
    return g;
}
/// push an Index path elem — `k` is the opnd kind +1 (OK_*+1).
fn gpush_i(own g: G, k: u32, v: i64, ty: u32) -> G {
    g.pel = g.pel.push(PE {
        kind: u8(k + 1), name: 0, idx: 0, ty: ty, ok: 0, ov: v });
    g.pl_len = g.pl_len + 1;
    return g;
}
fn vhas2(read v: vec.Vec<u32>, n: u32) -> u8 {
    let i: u64 = 0;
    while i < v.len {
        if v.buf[i] == n { return 1; }
        i = i + 1;
    }
    return 0;
}
/// intern a str literal into the name arena — `intern` wants a byte
/// slice; str bytes come via `.bytes`.
fn g_lit(own g: G, s: str) -> G {
    g.c.r = resolve.intern(g.c.r, s.bytes);
    g.res = g.c.r.res;
    return g;
}

/// infer — `res2` = tyid. `want` = rtyid | NONE.
fn g_infer(own g: G, read p: ast.Parser, eid: u32,
           want: u32) -> G {
    let rn = rvm_find(g, eid);               // materialized → Var $rvN
    if eid == g.rvskip { rn = NONE(); }     // producer re-eval, no self-load
    if rn != NONE() {
        g = gfind(g, rn);
        if g.res == NONE() { g.res2 = NONE(); return g; }
        g.res2 = g.res3;
        return g;
    }
    let e = check.xexp(g.c, p, eid);
    let k = check.ek_num(e.kind);
    if k == 0 {                              // Int
        if want != NONE() {
            let wk = g.c.r.rtys.buf[u64(want)].kind;
            if is_int_t(g, want) == 1 || is_ptrlike_k(wk) == 1 {
                g.res2 = want; return g;
            }
        }
        g = rty(g, 6);                       // INT_DEFAULT = i32
        g.res2 = g.res;
        return g;
    }
    if k == 1 { g = rty(g, 8); g.res2 = g.res; return g; }  // Bool
    if k == 18 { g = rty(g, 3); g.res2 = g.res; return g; } // Sizeof
    if k == 3 {                              // Str — want str else *const u8
        if want != NONE()
            && g.c.r.rtys.buf[u64(want)].kind == 10 {
            g.res2 = want; return g;
        }
        g = rty(g, 0);
        let u8t = g.res;
        g.c.r = resolve.mk_un(g.c.r, 16, u8t, 0);
        g.res2 = g.c.r.res;
        return g;
    }
    if k == 4 {                              // Unary
        if e.a == 1 { g = rty(g, 8); g.res2 = g.res; return g; }
        return g_infer(g, p, e.b, want);
    }
    if k == 5 {                              // Bin
        let op = e.a;
        if op >= 16 || (op >= 5 && op <= 10) {   // && || | cmp
            g = rty(g, 8); g.res2 = g.res; return g;
        }
        g = g_infer(g, p, e.b, NONE());
        let ta = g.res2;
        let ae = check.xexp(g.c, p, e.b);
        if check.ek_num(ae.kind) == 0 {
            if g.c.r.rtys.buf[u64(ta)].kind == 6 {
                return g_infer(g, p, e.c, want);
            }
        }
        return g_infer(g, p, e.b, want);
    }
    if k == 2 {                              // Var
        g.c.r = resolve.intern_pname(g.c.r, p, e.a);
        let vn2 = g.c.r.res;
        // srt overlay — spawn-body lets beat env during srt_walk
        // (s0's lookup_ty: ovl first, env second).
        let oi: u64 = 0;
        while oi < g.srtl.len {
            if g.srtl.buf[oi].k == vn2 {
                g.res2 = g.srtl.buf[oi].v;
                return g;
            }
            oi = oi + 1;
        }
        g = gfind(g, vn2);
        if g.res == NONE() {
            g = rty(g, 9); g.res2 = g.res; return g;
        }
        g.res2 = g.res3;
        return g;
    }
    if k == 6 || k == 19 || k == 20 {        // Call/Method/Assoc → ret
        g.c = check.callee_of(g.c, p, eid);
        let vn = g.c.res;
        if vn == NONE() {
            // enum-variant ctor `T::v(..)` (AssocFn with no cres) —
            // the checker's `etys` holds the resolved ty (incl. the
            // inferred `Maybe<i32>` upgrade); the bare `e.a` name is
            // the fallback.
            if k == 20 {
                let rt_ = g_ety(g, e.line, e.col);
                if rt_ != NONE() {
                    g.res2 = rt_;
                    return g;
                }
                g.c.r = resolve.cnv_ty(g.c.r, p, e.a);
                g.res2 = g.c.r.res;
                return g;
            }
            g = rty(g, 9); g.res2 = g.res;
            return g;
        }
        let ctk = resolve.int_cast_ty(g.c.r, vn);
        if ctk >= 0 {
            g = g_localfn(g, p, vn);
            if g.res4 == 0 {
                g = rty(g, u8(ctk));
                g.res2 = g.res;
                return g;
            }
        }
        if check.nid_lit_eq(g.c, vn, "system_allocator") {
            g = g_localfn(g, p, vn);
            if g.res4 == 0 {
                g = rty(g, 11);              // Alloc
                g.res2 = g.res;
                return g;
            }
        }
        if check.nid_lit_eq(g.c, vn, "cstr") {
            g = g_localfn(g, p, vn);
            if g.res4 == 0 {
                g = rty(g, 0);
                g.c.r = resolve.mk_un(g.c.r, 16, g.res, 0);
                g.res2 = g.c.r.res;
                return g;
            }
        }
        if check.nid_lit_eq(g.c, vn, "str_from_utf8") {
            g = g_localfn(g, p, vn);
            if g.res4 == 0 {
                g = rty(g, 10); g.res2 = g.res; return g;
            }
        }
        if check.nid_lit_eq(g.c, vn, "slice") {
            g = g_localfn(g, p, vn);
            if g.res4 == 0 {
                // mutability/elem ride on arg0's ptr ty.
                let el2: u32 = NONE(); let mf2: u32 = 0;
                if check.call_nargs(g.c, p, eid) > 0 {
                    g.c = check.call_arg(g.c, p, e, eid, 0);
                    g = g_infer(g, p, g.c.res, NONE());
                    let pt0 = g.res2;
                    if pt0 != NONE() {
                        let pn = g.c.r.rtys.buf[u64(pt0)];
                        if pn.kind == 16 { el2 = pn.a; mf2 = pn.b; }
                    }
                }
                if el2 == NONE() { g = rty(g, 9); el2 = g.res; }
                g.c.r = resolve.mk_un(g.c.r, 17, el2, mf2);
                g.res2 = g.c.r.res;
                return g;
            }
        }
        if check.nid_lit_eq(g.c, vn, "replace") {
            g = g_localfn(g, p, vn);
            if g.res4 == 0 {
                if check.call_nargs(g.c, p, eid) > 0 {
                    g.c = check.call_arg(g.c, p, e, eid, 0);
                    return g_infer(g, p, g.c.res, NONE());
                }
                g = rty(g, 9); g.res2 = g.res; return g;
            }
        }
        if check.nid_lit_eq(g.c, vn, "swap") {
            g = g_localfn(g, p, vn);
            if g.res4 == 0 {
                g = rty(g, 9); g.res2 = g.res; return g;
            }
        }
        // `lock` — the guard's payload is the mutex's inner ty.
        if check.nid_lit_eq(g.c, vn, "lock") {
            g = g_localfn(g, p, vn);
            if g.res4 == 0 {
                let t0: u32 = NONE();
                if check.call_nargs(g.c, p, eid) > 0 {
                    g.c = check.call_arg(g.c, p, e, eid, 0);
                    let a0 = g.c.res;
                    g = g_pshallow(g, p, a0);
                    t0 = g.res2;
                    if t0 == NONE() {
                        g = g_infer(g, p, a0, NONE());
                        t0 = g.res2;
                    }
                }
                let el: u32 = NONE();
                if t0 != NONE() && u64(t0) < g.c.r.rtys.len {
                    let n0 = g.c.r.rtys.buf[u64(t0)];
                    if n0.kind == 21 { el = n0.a; }
                    if n0.kind == 15 || n0.kind == 18 {
                        let n2 = g.c.r.rtys.buf[u64(n0.a)];
                        if n2.kind == 21 { el = n2.a; }
                    }
                }
                if el != NONE() {
                    g.c.r = resolve.mk_un(g.c.r, 22, el, 0);
                    g.res2 = g.c.r.res;
                    return g;
                }
                g = rty(g, 9); g.res2 = g.res; return g;
            }
        }
        if check.nid_lit_eq(g.c, vn, "unlock")
            || check.nid_lit_eq(g.c, vn, "send")
            || check.nid_lit_eq(g.c, vn, "close") {
            g = g_localfn(g, p, vn);
            if g.res4 == 0 { g = rty(g, 9); g.res2 = g.res; return g; }
        }
        if check.nid_lit_eq(g.c, vn, "channel") {
            g = g_localfn(g, p, vn);
            if g.res4 == 0 {
                g = rty(g, 9);
                g.c.r = resolve.mk_un(g.c.r, 23, g.res, 0);
                g.res2 = g.c.r.res; return g;
            }
        }
        // `recv` — the endpoint's declared payload.
        if check.nid_lit_eq(g.c, vn, "recv") {
            g = g_localfn(g, p, vn);
            if g.res4 == 0 {
                if check.call_nargs(g.c, p, eid) > 0 {
                    g.c = check.call_arg(g.c, p, e, eid, 0);
                    g = g_infer(g, p, g.c.res, NONE());
                    g = g_chanpay(g, g.res2);
                    if g.res != NONE() { g.res2 = g.res; return g; }
                }
                g = rty(g, 9); g.res2 = g.res; return g;
            }
        }
        // atomics — cas → bool; load → the storage's payload.
        if check.nid_lit_eq(g.c, vn, "compare_exchange") {
            g = g_localfn(g, p, vn);
            if g.res4 == 0 { g = rty(g, 8); g.res2 = g.res; return g; }
        }
        if check.nid_lit_eq(g.c, vn, "atomic_load") {
            g = g_localfn(g, p, vn);
            if g.res4 == 0 {
                if check.call_nargs(g.c, p, eid) > 0 {
                    g.c = check.call_arg(g.c, p, e, eid, 0);
                    g = g_pshallow(g, p, g.c.res);
                    let t0 = g.res2;
                    if t0 != NONE() && u64(t0) < g.c.r.rtys.len {
                        let n0 = g.c.r.rtys.buf[u64(t0)];
                        let el = t0;
                        if n0.kind == 15 || n0.kind == 18 {
                            el = n0.a;
                        }
                        if u64(el) < g.c.r.rtys.len {
                            let ne = g.c.r.rtys.buf[u64(el)];
                            if ne.kind == 20 { el = ne.a; }
                        }
                        g.res2 = el;
                        return g;
                    }
                }
                g = rty(g, 9); g.res2 = g.res; return g;
            }
        }
        if check.nid_lit_eq(g.c, vn, "atomic_store")
            || check.nid_lit_eq(g.c, vn, "atomic_add") {
            g = g_localfn(g, p, vn);
            if g.res4 == 0 { g = rty(g, 9); g.res2 = g.res; return g; }
        }
        g = g_fdecl(g, vn);
        if g.res != NONE() {
            g.res2 = g.c.r.fdecls.buf[u64(g.res)].ret;
            return g;
        }
        g = rty(g, 9); g.res2 = g.res;
        return g;
    }
    if k == 11 {                             // &p → Ref{mut, elem}
        let pe = check.xexp(g.c, p, e.b);
        if check.ek_num(pe.kind) == 9 {
            // `&a[lo..hi]` — a slice, not a ref.
            g = g_pshallow(g, p, pe.a);
            let bt = g.res2;
            let el = NONE();
            if bt != NONE() {
                let bn = g.c.r.rtys.buf[u64(bt)];
                if bn.kind == 14 || bn.kind == 17 || bn.kind == 25 {
                    el = bn.a;
                }
            }
            if el == NONE() { g = rty(g, 9); el = g.res; }
            g.c.r = resolve.mk_un(g.c.r, 17, el, e.a);
            g.res2 = g.c.r.res;
            return g;
        }
        g = g_pshallow(g, p, e.b);
        let el = g.res2;
        if el == NONE() { g = rty(g, 9); el = g.res; }
        g = rty_ref(g, el, e.a);
        g.res2 = g.res;
        return g;
    }
    if k == 12 {                             // handle p → handle elem
        g = g_pshallow(g, p, e.a);
        let el = g.res2;
        if el == NONE() { g = rty(g, 9); el = g.res; }
        g.c.r = resolve.mk_un(g.c.r, 18, el, 0);
        g.res2 = g.c.r.res;
        return g;
    }
    if k == 16 {                             // *p → elem of ref-ish
        g = g_infer(g, p, e.a, NONE());
        let n = g.c.r.rtys.buf[u64(g.res2)];
        if n.kind == 15 || n.kind == 18 || n.kind == 22
            || n.kind == 24 {
            g.res2 = n.a;
            return g;
        }
        g = rty(g, 9); g.res2 = g.res;
        return g;
    }
    if k == 15 {                             // mutex v → mutex T
        g = g_infer(g, p, e.a, NONE());
        let it = g.res2;
        if it == NONE() { g = rty(g, 9); g.res2 = g.res; return g; }
        let in_ = g.c.r.rtys.buf[u64(it)];
        let el = it;
        if in_.kind == 18 { el = in_.a; }
        g.c.r = resolve.mk_un(g.c.r, 21, el, 0);
        g.res2 = g.c.r.res;
        return g;
    }
    if k == 13 {                             // spawn → task T
        let sm = u32(g.srtl.len);
        g = g_srt(g, p, e.b, e.c);
        let it = g.res;
        while g.srtl.len > u64(sm) { g.srtl.pop(); }
        g.c.r = resolve.mk_un(g.c.r, 19, it, 0);
        g.res2 = g.c.r.res;
        return g;
    }
    if k == 14 {                             // join t → task's inner
        g = g_infer(g, p, e.a, NONE());
        let it = g.res2;
        if it != NONE() && u64(it) < g.c.r.rtys.len {
            let n = g.c.r.rtys.buf[u64(it)];
            if n.kind == 19 { g.res2 = n.a; return g; }
        }
        g = rty(g, 9); g.res2 = g.res;
        return g;
    }
    if k == 7 || k == 8 {                    // Field|Index → shallow ty
        g = g_pshallow(g, p, eid);
        if g.res2 == NONE() { g = rty(g, 9); g.res2 = g.res; }
        return g;
    }
    if k == 21 {                             // Try — `Ok` payload ty
        g = g_infer(g, p, e.a, NONE());
        let st = g.res2;
        g.res2 = NONE();
        if st == NONE() || u64(st) >= g.c.r.rtys.len { return g; }
        let n = g.c.r.rtys.buf[u64(st)];
        if n.kind != 12 && n.kind != 13 { return g; }
        g = g_declof(g, n.name);
        let ei = g.res2;
        g.res2 = NONE();
        if ei == NONE() { return g; }
        let ed = g.c.r.edecls.buf[u64(ei)];
        let voff = u64(ed.vs_off);
        let vlen = u64(ed.vs_len);
        if n.kind == 13 {
            voff = g.c.r.vars.len;
            g.c.r = resolve.subst_variants(
                g.c.r, ei, n.b, n.c);
            if g.c.r.suberr != 0 { voff = u64(ed.vs_off); }
        }
        let i: u64 = 0;
        while i < vlen {
            let vr = g.c.r.vars.buf[voff + i];
            if check.nid_lit_eq(g.c, vr.name, "Ok") {
                g.res2 = vr.ty;
                if g.res2 == NONE() { g = rty(g, 9); g.res2 = g.res; }
                return g;
            }
            i = i + 1;
        }
        g = rty(g, 9); g.res2 = g.res;
        return g;
    }
    if k == 22 {                             // Match — checker's join
        let mt = g_mty(g, e.line, e.col);
        if mt == NONE() { g = rty(g, 9); g.res2 = g.res; return g; }
        g.res2 = mt;
        return g;
    }
    if k == 9 {                              // bare `a[lo..hi]` → slice
        g = g_pshallow(g, p, e.a);
        let bt = g.res2;
        if bt == NONE() {
            g = g_infer(g, p, e.a, NONE());
            bt = g.res2;
        }
        let el = NONE();
        if bt != NONE() {
            let n = g.c.r.rtys.buf[u64(bt)];
            if n.kind == 14 || n.kind == 17 || n.kind == 25 {
                el = n.a;
            }
        }
        if el == NONE() { g = rty(g, 9); el = g.res; }
        g.c.r = resolve.mk_un(g.c.r, 17, el, 0);
        g.res2 = g.c.r.res;
        return g;
    }
    if k == 10 {                             // StructLit — the checker's
        let lt = check.lits_find(g.c,        //   `lits` row IS the ty
            e.line, e.col);
        if lt != NONE() {
            g.res2 = lt;
            return g;
        }
        g = rty(g, 9); g.res2 = g.res;
        return g;
    }
    if k == 17 {                             // alloc<T>(heap[, n])
        g.c.r = resolve.cnv_ty(g.c.r, p, e.a);
        let et = g.c.r.res;
        if e.c == NONE() {
            g.c.r = resolve.mk_un(g.c.r, 24, et, 0);
        } else {
            g.c.r = resolve.mk_un(g.c.r, 25, et, 0);
        }
        g.res2 = g.c.r.res;
        return g;
    }
    // MethodCall/AssocFn infer Void in Stage-0 (post-mono they are
    // Call); everything else lands as its family is ported.
    g = rty(g, 9); g.res2 = g.res;
    return g;
}

/// place_shallow — the place's ty without emitting code (Var from
/// the env, *p from the referent ty; aggregates land with places).
fn g_pshallow(own g: G, read p: ast.Parser, eid: u32) -> G {
    let rn = rvm_find(g, eid);               // materialized → Var $rvN
    if eid == g.rvskip { rn = NONE(); }     // producer re-eval, no self-load
    if rn != NONE() {
        g = gfind(g, rn);
        if g.res == NONE() { g.res2 = NONE(); return g; }
        g.res2 = g.res3;
        return g;
    }
    let e = check.xexp(g.c, p, eid);
    let k = check.ek_num(e.kind);
    if k == 2 {
        g.c.r = resolve.intern_pname(g.c.r, p, e.a);
        g = gfind(g, g.c.r.res);
        if g.res == NONE() { g.res2 = NONE(); return g; }
        g.res2 = g.res3;
        return g;
    }
    if k == 16 {
        g = g_infer(g, p, e.a, NONE());
        let n = g.c.r.rtys.buf[u64(g.res2)];
        if n.kind == 15 || n.kind == 18 || n.kind == 22
            || n.kind == 24 {
            g.res2 = n.a;
            return g;
        }
        g.res2 = NONE();
        return g;
    }
    if k == 7 {                              // field ty, no emit
        g.c.r = resolve.intern_pname(g.c.r, p, e.b);
        let fn_ = g.c.r.res;
        g = g_pshallow(g, p, e.a);
        let bt = g.res2;
        if bt == NONE() {
            g = g_infer(g, p, e.a, NONE());
            bt = g.res2;
        }
        if bt == NONE() { g.res2 = NONE(); return g; }
        let n = g.c.r.rtys.buf[u64(bt)];
        if n.kind == 17 {
            if check.nid_lit_eq(g.c, fn_, "ptr") {
                g.c.r = resolve.mk_un(g.c.r, 16, n.a, n.b);
                g.res2 = g.c.r.res;
                return g;
            }
            if check.nid_lit_eq(g.c, fn_, "len") {
                g = rty(g, 3); g.res2 = g.res; return g;
            }
            g.res2 = NONE(); return g;
        }
        if n.kind == 10 {
            if check.nid_lit_eq(g.c, fn_, "len") {
                g = rty(g, 3); g.res2 = g.res; return g;
            }
            if check.nid_lit_eq(g.c, fn_, "bytes") {
                g = rty(g, 0);
                g.c.r = resolve.mk_un(g.c.r, 17, g.res, 0);
                g.res2 = g.c.r.res;
                return g;
            }
            g.res2 = NONE(); return g;
        }
        if n.kind == 25 {
            if check.nid_lit_eq(g.c, fn_, "ptr") {
                g.c.r = resolve.mk_un(g.c.r, 16, n.a, 1);
                g.res2 = g.c.r.res;
                return g;
            }
            if check.nid_lit_eq(g.c, fn_, "len") {
                g = rty(g, 3); g.res2 = g.res; return g;
            }
            g.res2 = NONE(); return g;
        }
        let sname: u32 = NONE();
        let sty: u32 = NONE();
        if n.kind == 12 || n.kind == 13 { sname = n.name; sty = bt; }
        if n.kind == 21 || n.kind == 22 {
            let n2 = g.c.r.rtys.buf[u64(n.a)];
            if n2.kind == 12 || n2.kind == 13 { sname = n2.name; sty = n.a; }
        }
        if sname == NONE() { g.res2 = NONE(); return g; }
        // enum variant → its payload ty before the field table
        g = g_declof(g, sname);
        if g.res2 != NONE() {
            let ed = g.c.r.edecls.buf[u64(g.res2)];
            let voff = u64(ed.vs_off);
            let vlen = u64(ed.vs_len);
            let stn = g.c.r.rtys.buf[u64(sty)];
            if stn.kind == 13 {
                voff = g.c.r.vars.len;
                g.c.r = resolve.subst_variants(
                    g.c.r, g.res2, stn.b, stn.c);
                if g.c.r.suberr != 0 { voff = u64(ed.vs_off); }
            }
            let vi: u64 = 0;
            while vi < vlen {
                let vr = g.c.r.vars.buf[voff + vi];
                if vr.name == fn_ {
                    g.res2 = vr.ty;   // NONE for payload-less
                    return g;
                }
                vi = vi + 1;
            }
        }
        g = g_sfields(g, sty);
        if g.res == NONE() { g.res2 = NONE(); return g; }
        let f0 = u64(g.res);
        let fend = f0 + u64(g.res2);
        let fi: u64 = f0;
        while fi < fend {
            let sf = g.c.r.sfields.buf[fi];
            if sf.name == fn_ { g.res2 = sf.ty; return g; }
            fi = fi + 1;
        }
        g.res2 = NONE();
        return g;
    }
    if k == 8 || k == 9 {                    // Index|IndexRange — elem
        g = g_pshallow(g, p, e.a);
        let bt = g.res2;
        if bt == NONE() {
            g = g_infer(g, p, e.a, NONE());
            bt = g.res2;
        }
        if bt == NONE() { g.res2 = NONE(); return g; }
        let n = g.c.r.rtys.buf[u64(bt)];
        if n.kind == 14 || n.kind == 17 || n.kind == 25 {
            g.res2 = n.a;
            return g;
        }
        if n.kind == 21 || n.kind == 22 {
            let n2 = g.c.r.rtys.buf[u64(n.a)];
            if n2.kind == 14 { g.res2 = n2.a; return g; }
        }
        g.res2 = NONE();
        return g;
    }
    g = g_infer(g, p, eid, NONE());
    return g;
}

// ---- $rv rvalue-place materialization (lower.rs port) ----------------
// The checker emulates Stage-0's AST lowering: rv_names (eid -> seq)
// from a whole-module scan; emit=1 walks materialize `let $rvN = e`
// at statement heads and remember eid -> temp in rv_map. IR needs the
// same trail textually — `local.T $rvN` + expr + store — and expr/place
// walkers must resolve a materialized eid as Var($rvN). `rvm` is my
// live eid -> nid map; `rvnc` holds clone-body eid -> abs-seq.

/// eid -> bound temp nid | NONE.
fn rvm_find(read g: G, eid: u32) -> u32 {
    let i: u64 = 0;
    while i < g.rvm.len {
        if g.rvm.buf[i].k == eid { return g.rvm.buf[i].v; }
        i = i + 1;
    }
    return NONE();
}
/// eid -> absolute $rv seq | NONE. Reads the checker's `rv_names` —
/// module fns keep its post-`rv_scan` rows; each clone swaps in its
/// own scan under `inst_env_on` (rebased like `check_inst`).
fn rvseq_of(read g: G, eid: u32) -> u32 {
    return check.rv_names_find(g.c, eid);
}

// lv_* — verbatim ports of the checker's lower_e/lower_s/rv_mat
// emission-order walk; rv_is_* read `p.exps` like the originals.
fn lv_is_place(read p: ast.Parser, eid: u32) -> u8 {
    let k = check.ek_num(p.exps.buf[u64(eid)].kind);
    if k == 2 || k == 7 || k == 8 || k == 9 || k == 16 { return 1; }
    return 0;
}
fn lv_is_const(read p: ast.Parser, eid: u32) -> u8 {
    let e = p.exps.buf[u64(eid)];
    let k = check.ek_num(e.kind);
    if k == 0 || k == 1 || k == 3 || k == 18 { return 1; }
    if k == 4 { return lv_is_const(p, e.b); }
    if k == 5 {
        if lv_is_const(p, e.b) == 1 && lv_is_const(p, e.c) == 1 {
            return 1;
        }
    }
    return 0;
}
fn lv_arg_needs(read p: ast.Parser, eid: u32) -> u8 {
    if lv_is_place(p, eid) == 1 { return 0; }
    if lv_is_const(p, eid) == 1 { return 0; }
    let k = check.ek_num(p.exps.buf[u64(eid)].kind);
    if k == 11 || k == 12 || k == 15 || k == 13 { return 0; }
    return 1;
}
/// rv_pauth — param i's auth for callee `vn` (0 when unfound).
fn lv_pauth(read g: G, vn: u32, i: u64) -> u8 {
    let j: u64 = 0;
    while j < g.c.r.fdecls.len {
        let fd = g.c.r.fdecls.buf[j];
        if fd.name == vn && fd.tps_len == 0
            && vhas2(g.c.vprogs, fd.prog) == 1 {
            if i < u64(fd.ps_len) {
                return g.c.r.params.buf[u64(fd.ps_off) + i].auth;
            }
            return 0;
        }
        j = j + 1;
    }
    return 0;
}
fn g_edeclof(read g: G, name: u32) -> u32 {
    let i: u64 = 0;
    while i < g.c.r.edecls.len {
        if g.c.r.edecls.buf[i].name == name { return u32(i); }
        i = i + 1;
    }
    return NONE();
}
/// the checker's recorded expr ty (etys, keyed by span) | NONE.
fn g_ety(read g: G, line: u32, col: u32) -> u32 {
    let i: u64 = 0;
    while i < g.c.etys.len {
        let xr = g.c.etys.buf[i];
        if xr.line == line && xr.col == col
            && xr.who == g.c.who && xr.ctx == g.c.cur_fn {
            return xr.ty;
        }
        i = i + 1;
    }
    return NONE();
}

/// `e` an enum variant ctor (`E::V(...)`, AssocFn over an enum)?
/// res2 = the enum's tyid, NONE otherwise. cnv_ty interns, so this
/// needs g.
fn g_enumlit_ty(g: G, read p: ast.Parser, eid: u32) -> G {
    let e = check.xexp(g.c, p, eid);
    g.res2 = NONE(); g.res3 = NONE();
    if check.ek_num(e.kind) != 20 { return g; }
    let aty = g_ety(g, e.line, e.col);
    if aty == NONE() {
        g.c.r = resolve.cnv_ty(g.c.r, p, e.a);
        aty = g.c.r.res;
    }
    if aty == NONE() || u64(aty) >= g.c.r.rtys.len { return g; }
    let n = g.c.r.rtys.buf[u64(aty)];
    if n.kind != 12 && n.kind != 13 { return g; }
    let ei = g_edeclof(g, n.name);
    if ei == NONE() { return g; }
    g.res2 = aty;
    g.res3 = ei;
    return g;
}

/// emit `local.T $rvN; <expr>; store` + bind — the IR half of
/// checker's rv_mat (which ran check_let_n for semantics). emit=0 is
/// the clone-scan pass: record eid -> scan-order seq in `rvnc`.
/// init into `slot` — the same dispatch `Stmt::Let` uses: struct
/// and enum literals fill the place directly, everything else
/// evals + stores (s0's `match init` inside the Let arm).
fn g_initfill(own g: G, read p: ast.Parser, slot: u32, t: u32,
              eid: u32) -> G {
    let ie = check.xexp(g.c, p, eid);
    g = g_enumlit_ty(g, p, eid);
    let eidx = g.res3;
    if check.ek_num(ie.kind) == 10 {
        g.pl_r = slot; g.pl_val = 0;
        g.pl_rty = t; g.pl_ty = t;
        g.pl_off = u32(g.pel.len); g.pl_len = 0;
        return g_fill(g, p, eid);
    }
    if g.res2 != NONE() {
        g.c.r = resolve.intern_pname(g.c.r, p, ie.b);
        let vnid = g.c.r.res;
        let pay: u32 = NONE();
        if ie.d > 0 { pay = p.u32s.buf[u64(ie.c)]; }
        g.pl_r = slot; g.pl_val = 0;
        g.pl_rty = t; g.pl_ty = t;
        g.pl_off = u32(g.pel.len); g.pl_len = 0;
        return g_fillenum(g, p, eidx, vnid, pay, t);
    }
    g = g_expr(g, p, eid, t);
    let vk = g.res; let vv = g.resv;
    g.pl_r = slot; g.pl_val = 0; g.pl_rty = t; g.pl_ty = t;
    g.pl_off = u32(g.pel.len); g.pl_len = 0;
    return e_store(g, vk, vv);
}

fn lv_mat(own g: G, read p: ast.Parser, eid: u32,
          emit: u8) -> G {
    if lv_is_place(p, eid) == 1 { return g; }
    if emit == 0 {
        g.rvnc = g.rvnc.push(check.KK {
            k: eid, v: u32(g.rvnc.len) });
        return g;
    }
    let bound = rvm_find(g, eid);
    if bound != NONE() {
        // re-materialization (e.g. while-cond back-edge) — store the
        // re-eval into the LIVE slot; no local, no rebind, and the
        // expr itself must eval un-redirected.
        g = gfind(g, bound);
        if g.res == NONE() { return g; }
        let slot = g.res2;
        let t = g.res3;
        g.rvskip = eid;
        g = g_initfill(g, p, slot, t, eid);
        g.rvskip = NONE();
        return g;
    }
    let seq = rvseq_of(g, eid);
    if seq == NONE() { return g; }
    let nm = vec.Vec<u8>::new(g.heap);
    let nm2 = resolve.bputs(nm, "$rv");
    let nm3 = loader.bpush_u64(nm2, u64(seq));
    g.c.r = resolve.intern(g.c.r, nm3.as_slice());
    let vn = g.c.r.res;
    nm3.destroy();
    g = g_infer(g, p, eid, NONE());
    let t = g.res2;
    if t == NONE() { g = rty(g, 9); t = g.res; }
    g = gfresh(g);
    let slot = g.res;
    g = e_local(g, slot, t, vn);
    g = g_initfill(g, p, slot, t, eid);
    g = gbind(g, vn, slot, t, 0);
    // s0 materializes `let $rvN = e` as a real stmt — its copy
    // facts record like any other let.
    g = g_letfacts(g, p, slot, t, eid);
    g.rvm = g.rvm.push(check.KK { k: eid, v: vn });
    return g;
}

fn lv_e(own g: G, read p: ast.Parser, eid: u32,
          emit: u8) -> G {
    let e = check.xexp(g.c, p, eid);
    let k = check.ek_num(e.kind);
    if k == 0 || k == 1 || k == 2 || k == 3 || k == 18 { return g; }
    if k == 4 { return lv_e(g, p, e.b, emit); }
    if k == 5 {
        g = lv_e(g, p, e.b, emit);
        return lv_e(g, p, e.c, emit);
    }
    if k == 6 {                              // Call — args
        let noff = u64(e.b);
        let nt = u64(p.u32s.buf[noff]);
        let na = p.u32s.buf[noff + 1 + nt];
        g.c.r = resolve.intern_pname(g.c.r, p, e.a);
        let vn = g.c.r.res;
        let cr6 = check.cres_find(g.c, e.line, e.col);
        if cr6 != NONE() { vn = cr6; }
        let shift: u64 = 0;
        if check.mrecv_at(g.c, e) != NONE() { shift = 1; }
        let i: u64 = 0;
        while i < u64(na) {
            let a = p.u32s.buf[noff + 2 + nt + i];
            g = lv_e(g, p, a, emit);
            if lv_pauth(g, vn, i + shift) != 2
                && lv_arg_needs(p, a) == 1 {
                g = lv_mat(g, p, a, emit);
            }
            i = i + 1;
        }
        return g;
    }
    if k == 20 {                             // AssocFn — variant gate
        let isvar: u8 = 0;
        g.c.r = resolve.cnv_ty(g.c.r, p, e.a);
        let aty = g.c.r.res;
        let atn = g.c.r.rtys.buf[u64(aty)];
        let bnm: u32 = NONE();
        if atn.kind == 13 { bnm = atn.name; }
        if atn.kind == 12 { bnm = atn.name; }
        if bnm != NONE() {
            let ei = g_edeclof(g, bnm);
            if ei != NONE() {
                g.c.r = resolve.intern_pname(g.c.r, p, e.b);
                let vn2 = g.c.r.res;
                let ed2 = g.c.r.edecls.buf[u64(ei)];
                let vi: u64 = 0;
                while vi < u64(ed2.vs_len) {
                    if g.c.r.vars.buf[u64(ed2.vs_off) + vi].name
                        == vn2 { isvar = 1; }
                    vi = vi + 1;
                }
            }
        }
        let cvn = check.cres_find(g.c, e.line, e.col);
        let i: u64 = u64(e.c);
        while i < u64(e.c) + u64(e.d) {
            let a = p.u32s.buf[i];
            g = lv_e(g, p, a, emit);
            let pa: u8 = 0;
            if cvn != NONE() {
                pa = lv_pauth(g, cvn, i - u64(e.c));
            }
            if isvar == 0 && pa != 2
                && lv_arg_needs(p, a) == 1 {
                g = lv_mat(g, p, a, emit);
            }
            i = i + 1;
        }
        return g;
    }
    if k == 19 {                             // MethodCall — recv+args
        let cvn = check.cres_find(g.c, e.line, e.col);
        g = lv_e(g, p, e.a, emit);
        if cvn == NONE() || lv_pauth(g, cvn, 0) != 2 {
            g = lv_mat(g, p, e.a, emit);
        }
        let noff = u64(e.c);
        let nt = u64(p.u32s.buf[noff]);
        let na = p.u32s.buf[noff + 1 + nt];
        let i: u64 = 0;
        while i < u64(na) {
            let a = p.u32s.buf[noff + 2 + nt + i];
            g = lv_e(g, p, a, emit);
            let pa: u8 = 0;
            if cvn != NONE() { pa = lv_pauth(g, cvn, i + 1); }
            if pa != 2 && lv_arg_needs(p, a) == 1 {
                g = lv_mat(g, p, a, emit);
            }
            i = i + 1;
        }
        return g;
    }
    if k == 7 {                              // Field — place base
        g = lv_e(g, p, e.a, emit);
        return lv_mat(g, p, e.a, emit);
    }
    if k == 8 {                              // Index — base + index
        g = lv_e(g, p, e.a, emit);
        g = lv_mat(g, p, e.a, emit);
        return lv_e(g, p, e.b, emit);
    }
    if k == 9 {                              // IndexRange
        g = lv_e(g, p, e.a, emit);
        g = lv_mat(g, p, e.a, emit);
        if e.b != NONE() { g = lv_e(g, p, e.b, emit); }
        if e.c != NONE() { g = lv_e(g, p, e.c, emit); }
        return g;
    }
    if k == 10 {                             // StructLit — fields
        let nt = u64(p.u32s.buf[u64(e.b)]);
        let nf = u64(p.u32s.buf[u64(e.b) + 1 + nt]);
        let i: u64 = 0;
        while i < nf {
            g = lv_e(g, p,
                p.u32s.buf[u64(e.b) + 2 + nt + i * 2 + 1], emit);
            i = i + 1;
        }
        return g;
    }
    if k == 11 {                             // AddrOf — operand
        g = lv_e(g, p, e.b, emit);
        return lv_mat(g, p, e.b, emit);
    }
    if k == 12 || k == 16 || k == 21 {       // Handle|Deref|Try
        g = lv_e(g, p, e.a, emit);
        return lv_mat(g, p, e.a, emit);
    }
    if k == 13 {                             // Spawn — emit walks the
        if emit == 0 {                       //   body in scan mode only
            let i: u64 = u64(e.b);
            while i < u64(e.b) + u64(e.c) {
                g = lv_s(g, p, p.u32s.buf[i], emit);
                i = i + 1;
            }
        }
        return g;
    }
    if k == 14 || k == 15 {                  // Join | Mutex
        return lv_e(g, p, e.a, emit);
    }
    if k == 17 {                             // Alloc — expr + count
        g = lv_e(g, p, e.b, emit);
        if e.c != NONE() { g = lv_e(g, p, e.c, emit); }
        return g;
    }
    if k == 22 {                             // Match — scrut + arms
        g = lv_e(g, p, e.a, emit);
        g = lv_mat(g, p, e.a, emit);
        let i: u64 = u64(e.b);
        while i < u64(e.b) + u64(e.c) {
            let arm = p.arms.buf[i];
            let j: u64 = u64(arm.off);
            while j < u64(arm.off) + u64(arm.len) {
                g = lv_s(g, p, p.u32s.buf[j], emit);
                j = j + 1;
            }
            i = i + 1;
        }
        return g;
    }
    return g;
}

/// stmt-level materialization — emit=1 half of checker's lower_s:
/// this statement's own exprs only (nested blocks re-run at their
/// own g_stmts iteration).
fn lv_s(own g: G, read p: ast.Parser, sid: u32,
          emit: u8) -> G {
    let s = p.stmts.buf[u64(sid)];
    let k = check.sk_num(s.kind);
    if k == 0 { if s.c != NONE() { return lv_e(g, p, s.c, emit); }
        return g; }
    if k == 1 { g = lv_e(g, p, s.a, emit);
        return lv_e(g, p, s.b, emit); }
    if k == 2 { if s.a != NONE() { return lv_e(g, p, s.a, emit); }
        return g; }
    if k == 3 {                              // If — cond; bodies scan-
        g = lv_e(g, p, s.a, emit);           //   walked only (emit=0
        if emit == 0 {                       //   mode runs once per fn)
            let nt = u64(p.u32s.buf[u64(s.b)]);
            let i: u64 = u64(s.b) + 1;
            while i < u64(s.b) + 1 + nt {
                g = lv_s(g, p, p.u32s.buf[i], emit);
                i = i + 1;
            }
            if p.u32s.buf[u64(s.b) + 1 + nt] == 1 {
                i = u64(s.b) + 2 + nt;
                while i < u64(s.b) + u64(s.c) {
                    g = lv_s(g, p, p.u32s.buf[i], emit);
                    i = i + 1;
                }
            }
        }
        return g;
    }
    if k == 4 || k == 9 {                    // While | Region
        if k == 4 { g = lv_e(g, p, s.a, emit); }
        if emit == 0 {
            let i: u64 = u64(s.b);
            while i < u64(s.b) + u64(s.c) {
                g = lv_s(g, p, p.u32s.buf[i], emit);
                i = i + 1;
            }
        }
        return g;
    }
    if k == 7 { return lv_e(g, p, s.a, emit); }
    if k == 8 {                              // Match — scrut + temp
        g = lv_e(g, p, s.a, emit);
        g = lv_mat(g, p, s.a, emit);
        if emit == 0 {
            let i: u64 = u64(s.b);
            while i < u64(s.b) + u64(s.c) {
                let arm = p.arms.buf[i];
                let j: u64 = u64(arm.off);
                while j < u64(arm.off) + u64(arm.len) {
                    g = lv_s(g, p, p.u32s.buf[j], emit);
                    j = j + 1;
                }
                i = i + 1;
            }
        }
        return g;
    }
    if k == 10 || k == 11 || k == 12 {       // Promote|Consume|Defer
        return lv_e(g, p, s.a, emit);
    }
    return g;
}

// ---- expressions ----------------------------------------------------

/// expr — `res`/`resv` = opnd. `want` = rtyid | NONE.
fn g_expr(own g: G, read p: ast.Parser, eid: u32,
          want: u32) -> G {
    let rn = rvm_find(g, eid);               // materialized → Var $rvN
    if eid == g.rvskip { rn = NONE(); }     // producer re-eval, no self-load
    if rn != NONE() {
        g = gplace_var(g, rn);
        if g.res3 == NONE() {
            g.res = OK_IMM(); g.resv = 0;
            return g;
        }
        return gload(g);
    }
    let e = check.xexp(g.c, p, eid);
    let k = check.ek_num(e.kind);
    if k == 0 {                              // Int
        if want != NONE() {
            let wk = g.c.r.rtys.buf[u64(want)].kind;
            if is_int_t(g, want) == 1 || is_ptrlike_k(wk) == 1 {
                return gconst(g, want, e.w);
            }
        }
        g = rty(g, 6);
        return gconst(g, g.res, e.w);
    }
    if k == 1 {                              // Bool — flag in `a`
        g = rty(g, 8);
        return gconst(g, g.res, i64(e.a));
    }
    if k == 3 {                              // Str — global + {ptr,len}
        // decoded payload is lx.dbyt[e.a..e.b]; the shared table
        // index is emission order across merged modules (N14). The
        // bytes copy into `sbyt` — dbyt spans are parser-local and
        // a dep module's literal would index the wrong arena.
        let so = u32(g.sbyt.len);
        let si: u64 = u64(e.a);
        while si < u64(e.b) {
            g.sbyt = g.sbyt.push(p.lx.dbyt.buf[si]);
            si = si + 1;
        }
        g.strings = g.strings.push(
            loader.Span2 { off: so, len: e.b - e.a });
        let idx = g.strings.len - 1;
        g = gfresh(g);
        let d = g.res;
        g = ge(g);
        g = irec(g, 13, d, 0, 0, 0, 0, 0, 0);
        g = irecv(g, 1, i64(idx));
        g = irecv(g, 2, i64(e.b - e.a) + 1);
        g.fnb = gr(g.fnb, d);
        g.fnb = resolve.bputs(g.fnb, " = straddr @.str.");
        g.fnb = resolve.bu32(g.fnb, idx);
        g = geol(g);
        if want != NONE()
            && g.c.r.rtys.buf[u64(want)].kind == 10 {
            g = rty(g, 10);
            let st = g.res;
            g = g_makeagg2(g, st, OK_REG(), i64(d),
                           OK_IMM(), i64(e.b - e.a));
            return g;
        }
        g.res = OK_REG(); g.resv = i64(d);
        return g;
    }
    if k == 18 {                             // Sizeof
        g.c.r = resolve.cnv_ty(g.c.r, p, e.a);
        g = g_sizeof(g, g.c.r.res);
        let n = g.resv;
        g = rty(g, 3);
        return gconst(g, g.res, n);
    }
    if k == 2 {                              // Var → place + load
        g.c.r = resolve.intern_pname(g.c.r, p, e.a);
        g = gplace_var(g, g.c.r.res);
        if g.res3 == NONE() {
            g.res = OK_IMM(); g.resv = 0;
            return g;
        }
        return gload(g);
    }
    if k == 4 {                              // Unary
        if e.a == 1 {                        // not
            g = rty(g, 8);
            let bt0 = g.res;
            g = g_expr(g, p, e.b, bt0);
            let ka = g.res; let va = g.resv;
            g = rty(g, 8);
            let bt = g.res;
            g = gfresh(g);
            let d = g.res;
            g = e_unary(g, d, 1, bt, ka, va);
            g.res = OK_REG(); g.resv = i64(d);
            return g;
        }
        let t2 = NONE();
        g = g_infer(g, p, e.b, want);
        t2 = g.res2;
        if e.a == 0 {                        // neg
            g = g_expr(g, p, e.b, t2);
            let ka = g.res; let va = g.resv;
            g = gfresh(g);
            let d = g.res;
            g = e_unary(g, d, 0, t2, ka, va);
            g.res = OK_REG(); g.resv = i64(d);
            return g;
        }
        // bitnot → xor.t a, -1
        g = g_expr(g, p, e.b, t2);
        let ka = g.res; let va = g.resv;
        g = gfresh(g);
        let d = g.res;
        g = e_bin(g, d, 15, t2, ka, va, OK_IMM(), 0 - 1);
        g.res = OK_REG(); g.resv = i64(d);
        return g;
    }
    if k == 5 {                              // Bin
        let op = e.a;
        if op == 16 || op == 17 {
            return g_sc(g, p, eid, op);
        }
        if op == 5 || op == 6 {
            // `str == str`/`!=` — runtime bytes compare (len + memcmp),
            // not pointer identity; result flips for `==`.
            g = g_infer(g, p, e.b, NONE());
            let ta = g.res2;
            g = g_infer(g, p, e.c, NONE());
            let tb = g.res2;
            let sflg: u8 = 0;
            if ta != NONE()
                && g.c.r.rtys.buf[u64(ta)].kind == 10 { sflg = 1; }
            if tb != NONE()
                && g.c.r.rtys.buf[u64(tb)].kind == 10 { sflg = 1; }
            if sflg == 1 {
                g = rty(g, 10);
                let st = g.res;
                g = g_expr(g, p, e.b, st);
                let ka = g.res; let va = g.resv;
                g = g_expr(g, p, e.c, st);
                let kb = g.res; let vb = g.resv;
                g = g_strparts(g, ka, va);
                let pk = g.res; let pv = g.resv;
                let lk = g.res4; let lv = g.resv2;
                g = g_strparts(g, kb, vb);
                let pk2 = g.res; let pv2 = g.resv;
                let lk2 = g.res4; let lv2 = g.resv2;
                g = g_ptrty(g);
                let pt = g.res;
                g = rty(g, 7);
                let i64t = g.res;
                while g.ax.len > 0 { g.ax.pop(); }
                g.ax = g.ax.push(AX { ty: pt, k: pk, v: pv });
                g.ax = g.ax.push(AX { ty: i64t, k: lk, v: lv });
                g.ax = g.ax.push(AX { ty: pt, k: pk2, v: pv2 });
                g.ax = g.ax.push(AX { ty: i64t, k: lk2, v: lv2 });
                g = rty(g, 6);
                g = g_rtcall(g, "mml_str_eq", g.res);
                let ek = g.res; let ev = g.resv;
                g = rty(g, 6);
                let i32t = g.res;
                g = gfresh(g);
                let d = g.res;
                let bop = op;
                if op == 5 { bop = 6; } else { bop = 5; }
                g = e_bin(g, d, bop, i32t, ek, ev, OK_IMM(), 0);
                g.res = OK_REG(); g.resv = i64(d);
                return g;
            }
        }
        g = g_infer(g, p, eid, want);
        let t = g.res2;
        let oty = t;
        if op >= 5 && op <= 10 {             // cmp → operand ty
            let ae = check.xexp(g.c, p, e.b);
            let be = check.xexp(g.c, p, e.c);
            let aint = check.ek_num(ae.kind) == 0;
            let bint = check.ek_num(be.kind) == 0;
            g = g_infer(g, p, e.b, NONE());
            let ta = g.res2;
            g = g_infer(g, p, e.c, NONE());
            let tb = g.res2;
            oty = ta;
            if aint && !bint { oty = tb; }
        }
        g = g_expr(g, p, e.b, oty);
        let ka = g.res; let va = g.resv;
        g = g_expr(g, p, e.c, oty);
        let kb = g.res; let vb = g.resv;
        if op == 11 || op == 12 {            // N25A shift check
            let be = check.xexp(g.c, p, e.c);
            let bits = ty_bits_k(g.c.r.rtys.buf[u64(oty)].kind);
            let ok: u8 = 0;
            if check.ek_num(be.kind) == 0 && be.w >= 0
                && u64(be.w) < bits { ok = 1; }
            if ok == 0 {
                let ak = kb; let av = vb;
                if kb != OK_IMM()
                    && g.c.r.rtys.buf[u64(oty)].kind != 7 {
                    g = gfresh(g);
                    let d = g.res;
                    g = rty(g, 7);
                    g = e_cast(g, d, oty, kb, vb, g.res);
                    ak = OK_REG(); av = i64(d);
                }
                g = rty(g, 7);
                let i64t = g.res;
                while g.ax.len > 0 { g.ax.pop(); }
                g.ax = g.ax.push(AX { ty: i64t, k: ak, v: av });
                g.ax = g.ax.push(AX { ty: i64t, k: OK_IMM(),
                                      v: i64(bits) });
                g = rty(g, 9);
                g = g_rtcall(g, "mml_shift_check", g.res);
            }
        }
        g = gfresh(g);
        let d = g.res;
        g = e_bin(g, d, op, oty, ka, va, kb, vb);
        g.res = OK_REG(); g.resv = i64(d);
        return g;
    }
    if k == 6 || k == 19 || k == 20 {          // Call / method / assoc
        return g_call(g, p, eid, want);
    }
    if k == 11 {                             // &place — or &a[lo..hi]
        let pe = check.xexp(g.c, p, e.b);
        if check.ek_num(pe.kind) == 9 {
            return g_slicerange(g, p, pe.a, pe.b, pe.c, e.a);
        }
        g = g_place(g, p, e.b);
        if g.res3 == NONE() {
            g.res = OK_IMM(); g.resv = 0;
            return g;
        }
        g = gfresh(g);
        let d = g.res;
        g = e_addr(g, d);
        g.res = OK_REG(); g.resv = i64(d);
        return g;
    }
    if k == 12 {                             // handle place
        g = g_place(g, p, e.a);
        if g.res3 == NONE() {
            g.res = OK_IMM(); g.resv = 0;
            return g;
        }
        g = gfresh(g);
        let d = g.res;
        g = e_handle(g, d);
        g.res = OK_REG(); g.resv = i64(d);
        return g;
    }
    if k == 16 {                             // *p — place + load
        g = g_place(g, p, eid);
        if g.res3 == NONE() {
            g.res = OK_IMM(); g.resv = 0;
            return g;
        }
        return gload(g);
    }
    if k == 7 || k == 8 {                    // e.f / a[i] — place+load
        g = g_place(g, p, eid);
        if g.res3 == NONE() {
            g.res = OK_IMM(); g.resv = 0;
            return g;
        }
        return gload(g);
    }
    if k == 10 {                             // value-position literal:
        let lt = check.lits_find(g.c,        //   anon slot + fill + load
            e.line, e.col);
        if lt == NONE() {
            g.res = OK_IMM(); g.resv = 0;
            return g;
        }
        g = gfresh(g);
        let slot = g.res;
        g = e_local(g, slot, lt, NONE());
        g.pl_r = slot; g.pl_val = 0;
        g.pl_rty = lt; g.pl_ty = lt;
        g.pl_off = u32(g.pel.len); g.pl_len = 0;
        g = g_fill(g, p, eid);
        g.pl_r = slot; g.pl_val = 0;
        g.pl_rty = lt; g.pl_ty = lt;
        g.pl_off = u32(g.pel.len); g.pl_len = 0;
        return gload(g);
    }
    if k == 17 {                             // alloc<T>(heap[, n])
        g.c.r = resolve.cnv_ty(g.c.r, p, e.a);
        let et = g.c.r.res;
        // the alloc token evals (value unused — s0 discards it)
        g = rty(g, 11);
        let at = g.res;
        g = g_expr(g, p, e.b, at);
        g = g_sizeof(g, et);
        let sz = g.resv;
        if sz < 1 { sz = 1; }
        g = rty(g, 7);                       // i64
        let i64t = g.res;
        while g.ax.len > 0 { g.ax.pop(); }
        g.ax = g.ax.push(AX { ty: i64t, k: OK_IMM(), v: sz });
        if e.c == NONE() {
            g = g_ptrty(g);
            return g_rtcall(g, "mml_alloc", g.res);
        }
        g = g_infer(g, p, e.c, i64t);        // i64v coercion
        let ity = g.res2;
        g = g_expr(g, p, e.c, ity);
        g = g_i64v(g, ity, g.res, g.resv);
        let nk = g.res; let nv = g.resv;
        g.ax = g.ax.push(AX { ty: i64t, k: nk, v: nv });
        g = g_ptrty(g);
        let pt = g.res;
        g = g_rtcall(g, "mml_alloc_slice", pt);
        let pk = g.res; let pv = g.resv;
        g.c.r = resolve.mk_un(g.c.r, 25, et, 0);
        return g_makeagg2(g, g.c.r.res, pk, pv, nk, nv);
    }
    if k == 15 {                             // mutex v / mutex h
        g = g_infer(g, p, e.a, NONE());
        let it = g.res2;
        let in_ = g.c.r.rtys.buf[u64(it)];
        if in_.kind == 18 {
            // handle-backed — wrap the existing mutex object.
            g = g_expr(g, p, e.a, it);
            let hk = g.res; let hv = g.resv;
            g = g_ptrty(g);
            let pt = g.res;
            while g.ax.len > 0 { g.ax.pop(); }
            g.ax = g.ax.push(AX { ty: pt, k: hk, v: hv });
            return g_rtcall(g, "mml_mutex_wrap", pt);
        }
        // fresh domain — new mutex object, payload stored via data.
        g = g_expr(g, p, e.a, it);
        let vk = g.res; let vv = g.resv;
        g = g_sizeof(g, it);
        let sz = g.resv;
        g = rty(g, 7);                       // i64
        let i64t = g.res;
        g = gconst(g, i64t, sz);
        let szk = g.res; let szv = g.resv;
        g = g_ptrty(g);
        let pt = g.res;
        while g.ax.len > 0 { g.ax.pop(); }
        g.ax = g.ax.push(AX { ty: i64t, k: szk, v: szv });
        g = g_rtcall(g, "mml_mutex_new", pt);
        let bk = g.res; let bv = g.resv;
        while g.ax.len > 0 { g.ax.pop(); }
        g.ax = g.ax.push(AX { ty: pt, k: bk, v: bv });
        g = g_rtcall(g, "mml_mutex_data", pt);
        // store.<it> *data, v
        g.pl_r = u32(g.resv); g.pl_val = 1;
        g.pl_rty = it; g.pl_ty = it;
        g.pl_off = u32(g.pel.len); g.pl_len = 0;
        g = e_store(g, vk, vv);
        g.res = bk; g.resv = bv;
        return g;
    }
    if k == 13 {                             // spawn { … } — env pack
        return g_spawn(g, p, e);
    }
    if k == 14 {                             // join t
        return g_join(g, p, e);
    }
    if k == 21 {                             // Try — `e?` tag branch
        return g_try(g, p, eid);
    }
    if k == 22 {                             // Match — N28 value form
        return g_match(g, p, e.a, e.b, e.c, e.line, e.col, want);
    }
    // unhandled family — the checker's verdict stands; keep emitting.
    g.res = OK_IMM(); g.resv = 0;
    return g;
}

/// `a && b` / `a || b` — named bool slot + per-arm store, load at
/// the merge (N25C). `&&` runs b when a holds; `||` when a fails.
fn g_sc(own g: G, read p: ast.Parser, eid: u32, op: u32) -> G {
    let e = check.xexp(g.c, p, eid);
    g = rty(g, 8);
    let bt = g.res;
    g = gfresh(g);
    let slot = g.res;
    g = g_lit(g, "$sc");
    let sn = g.res;
    g = e_local(g, slot, bt, sn);
    g = g_expr(g, p, e.b, bt);
    let av_k = g.res; let av_v = g.resv;
    g = gnew_lbl(g, "sc.run");
    let run = g.res;
    g = gnew_lbl(g, "sc.skip");
    let skip = g.res;
    g = gnew_lbl(g, "sc.done");
    let done = g.res;
    if op == 16 {
        g = gseal_br(g, av_k, av_v, run, skip);
    } else {
        g = gseal_br(g, av_k, av_v, skip, run);
    }
    g = gopen(g, run);
    // N46 — `b` in `a && b` runs only when `a` held.
    let bm = u32(g.bfacts.len); let em = u32(g.efacts.len);
    if op == 16 { g = g_condf(g, p, e.b); }
    g = g_expr(g, p, e.c, bt);
    while g.bfacts.len > u64(bm) { g.bfacts.pop(); }
    while g.efacts.len > u64(em) { g.efacts.pop(); }
    let bv_k = g.res; let bv_v = g.resv;
    g.pl_r = slot; g.pl_val = 0; g.pl_rty = bt; g.pl_ty = bt;
    g.pl_off = u32(g.pel.len); g.pl_len = 0;
    g = e_store(g, bv_k, bv_v);
    g = gseal_jmp(g, done);
    g = gopen(g, skip);
    g.pl_r = slot; g.pl_val = 0; g.pl_rty = bt; g.pl_ty = bt;
    g.pl_off = u32(g.pel.len); g.pl_len = 0;
    if op == 16 {
        g = e_store(g, OK_IMM(), 0);
    } else {
        g = e_store(g, OK_IMM(), 1);
    }
    g = gseal_jmp(g, done);
    g = gopen(g, done);
    g.pl_r = slot; g.pl_val = 0; g.pl_rty = bt; g.pl_ty = bt;
    g.pl_off = u32(g.pel.len); g.pl_len = 0;
    return gload(g);
}

// ---- N46-N48 bounds facts ------------------------------------------
//
// Stage-0's bkey/bnorm/reps/proof engine. Keys are interned byte
// strings: `#` = literal, `s{reg}` = local slot, `{k}.{name}` /
// `{k}.*` / `{k}.len` = place projections, `cast:{n}:{k}:{o}` =
// opaque cast keys. Facts live on `g.bfacts`/`g.efacts` with the
// same scope (mark/truncate) and kill (bkill) discipline.

fn ty_signed_k(k: u8) -> u8 { if k >= 4 && k <= 7 { return 1; } return 0; }
fn ty_bits_k(k: u8) -> u64 {
    let sh = u64(k % 4);
    let b: u64 = 8;
    let i: u64 = 0;
    while i < sh { b = b * 2; i = i + 1; }
    return b;
}

/// append key `kid`'s bytes to `v`.
fn gb_kcat(own v: vec.Vec<u8>, read g: G, kid: u32) -> vec.Vec<u8> {
    let sp = g.bks.buf[u64(kid)];
    let i: u64 = 0;
    while i < u64(sp.len) {
        v = v.push(g.bkbyt.buf[u64(sp.off) + i]);
        i = i + 1;
    }
    return v;
}
/// intern a key — dedup on bytes (res = kid).
fn gb_key(own g: G, own v: vec.Vec<u8>) -> G {
    let i: u64 = 0;
    while i < g.bks.len {
        let sp = g.bks.buf[i];
        if u64(sp.len) == v.len {
            let eq: u8 = 1;
            let j: u64 = 0;
            while j < v.len {
                if g.bkbyt.buf[u64(sp.off) + j] != v.buf[j] { eq = 0; }
                j = j + 1;
            }
            if eq == 1 { v.destroy(); g.res = u32(i); return g; }
        }
        i = i + 1;
    }
    let off = u32(g.bkbyt.len);
    let j: u64 = 0;
    while j < v.len {
        g.bkbyt = g.bkbyt.push(v.buf[j]);
        j = j + 1;
    }
    g.bks = g.bks.push(loader.Span2 {
        off: off, len: u32(v.len) });
    v.destroy();
    g.res = u32(g.bks.len) - 1;
    return g;
}
/// `{kid}.{suf}` → res = kid (also `{kid}.*` via suffix "*").
fn gb_kdot(own g: G, kid: u32, suf: str) -> G {
    let v = vec.Vec<u8>::new(g.heap);
    v = gb_kcat(v, g, kid);
    v = v.push(u8(46));
    v = resolve.bputs(v, suf);
    g = gb_key(g, v);
    return g;
}
/// does key `xk`'s text start with `{k}.` (s0's `starts_with`)?
fn gb_pref(read g: G, xk: u32, k: u32) -> u8 {
    let xs = g.bks.buf[u64(xk)];
    let ks = g.bks.buf[u64(k)];
    if xs.len <= ks.len { return 0; }
    let i: u64 = 0;
    while i < u64(ks.len) {
        if g.bkbyt.buf[u64(xs.off) + i]
            != g.bkbyt.buf[u64(ks.off) + i] {
            return 0;
        }
        i = i + 1;
    }
    if g.bkbyt.buf[u64(xs.off) + u64(ks.len)] != u8(46) { return 0; }
    return 1;
}

/// bkey — `g.bk` = key id | NONE. Var → `s{reg}`, `.f`/`.len`
/// projections, `.*` derefs; anything else has no key.
fn g_bkey(own g: G, read p: ast.Parser, eid: u32) -> G {
    let e = check.xexp(g.c, p, eid);
    let k = check.ek_num(e.kind);
    if k == 2 {                              // Var → s{reg}
        g.c.r = resolve.intern_pname(g.c.r, p, e.a);
        g = gfind(g, g.c.r.res);
        if g.res == NONE() { g.bk = NONE(); return g; }
        let v = vec.Vec<u8>::new(g.heap);
        v = resolve.bputs(v, "s");
        v = resolve.bu32(v, u64(g.res2));
        g = gb_key(g, v);
        g.bk = g.res;
        return g;
    }
    if k == 7 {                              // Field → {k}.{name}
        g = g_bkey(g, p, e.a);
        if g.bk == NONE() { return g; }
        let b = g.bk;
        let v = vec.Vec<u8>::new(g.heap);
        v = gb_kcat(v, g, b);
        v = v.push(u8(46));
        g.c.r = resolve.intern_pname(g.c.r, p, e.b);
        v = resolve.push_name(v, g.c.r, g.c.r.res);
        g = gb_key(g, v);
        g.bk = g.res;
        return g;
    }
    if k == 16 {                             // *p → {k}.*
        g = g_bkey(g, p, e.a);
        if g.bk == NONE() { return g; }
        g = gb_kdot(g, g.bk, "*");
        g.bk = g.res;
        return g;
    }
    g.bk = NONE();
    return g;
}

/// bnorm — `g.bk`/`g.bo` = the affine (key,off); bk NONE = not a
/// single-place affine expr (mirrors Stage-0 arm for arm).
fn g_bnorm(own g: G, read p: ast.Parser, eid: u32) -> G {
    let e = check.xexp(g.c, p, eid);
    let k = check.ek_num(e.kind);
    if k == 0 { g.bk = g.kh; g.bo = e.w; return g; }
    if k == 5 && e.a == 0 {                  // a + const
        g = g_bnorm(g, p, e.b);
        let ak = g.bk; let ao = g.bo;
        g = g_bnorm(g, p, e.c);
        if ak != NONE() && g.bk != NONE() {
            if g.bk == g.kh {
                g.bk = ak; g.bo = ao + g.bo; return g;
            }
            if ak == g.kh {
                g.bo = g.bo + ao; return g;   // (c + off) + key
            }
        }
        g.bk = NONE();
        return g;
    }
    if k == 5 && e.a == 1 {                  // a - const
        g = g_bnorm(g, p, e.b);
        let ak = g.bk; let ao = g.bo;
        g = g_bnorm(g, p, e.c);
        if ak != NONE() && g.bk != NONE() && g.bk == g.kh {
            g.bk = ak; g.bo = ao - g.bo; return g;
        }
        g.bk = NONE();
        return g;
    }
    if k == 6 {                              // int-cast call?
        g.c.r = resolve.intern_pname(g.c.r, p, e.a);
        let vn = g.c.r.res;
        let ck = resolve.int_cast_ty(g.c.r, vn);
        if ck >= 0 {
            let noff = u64(e.b);
            let nt = u64(p.u32s.buf[noff]);
            if p.u32s.buf[noff + 1 + nt] == 0 {
                g.bk = NONE(); return g;
            }
            let a = p.u32s.buf[noff + 2 + nt];
            g = g_bnorm(g, p, a);
            if g.bk == NONE() { return g; }
            let ik = g.bk; let io = g.bo;
            g = g_infer(g, p, a, NONE());
            if g.res2 == NONE() { g.bk = NONE(); return g; }
            let fk = g.c.r.rtys.buf[u64(g.res2)].kind;
            if is_int_t(g, g.res2) == 0 { g.bk = NONE(); return g; }
            let tk = u8(ck);
            let exact: u8 = 0;
            if fk == tk { exact = 1; }
            if ty_signed_k(fk) == ty_signed_k(tk)
                && ty_bits_k(fk) <= ty_bits_k(tk) { exact = 1; }
            if ty_signed_k(fk) == 0 && ty_signed_k(tk) == 1
                && ty_bits_k(fk) < ty_bits_k(tk) { exact = 1; }
            if exact == 1 { g.bk = ik; g.bo = io; return g; }
            let v = vec.Vec<u8>::new(g.heap);
            v = resolve.bputs(v, "cast:");
            v = resolve.push_name(v, g.c.r, vn);
            v = v.push(u8(58));
            v = gb_kcat(v, g, ik);
            v = v.push(u8(58));
            v = gi64(v, io);
            g = gb_key(g, v);
            g.bk = g.res; g.bo = 0;
            return g;
        }
    }
    g = g_bkey(g, p, eid);
    g.bo = 0;
    return g;
}

/// bnorm_lenkey — `alloc_slice` count provenance (N48).
fn g_bnorm_lenkey(own g: G, read p: ast.Parser, eid: u32) -> G {
    g = g_bnorm(g, p, eid);
    if g.bk == NONE() { return g; }
    let ik = g.bk; let io = g.bo;
    g = g_infer(g, p, eid, NONE());
    let sgn: u8 = 0;
    if g.res2 != NONE() {
        sgn = ty_signed_k(g.c.r.rtys.buf[u64(g.res2)].kind);
    }
    if sgn == 0 { g.bk = ik; g.bo = io; return g; }
    if ik == g.kh {
        if io >= 0 { g.bk = ik; g.bo = io; return g; }
        g.bk = NONE();
        return g;
    }
    let e = check.xexp(g.c, p, eid);
    if check.ek_num(e.kind) == 6 {
        g.c.r = resolve.intern_pname(g.c.r, p, e.a);
        if check.nid_lit_eq(g.c, g.c.r.res, "i64") {
            let noff = u64(e.b);
            let nt = u64(p.u32s.buf[noff]);
            if p.u32s.buf[noff + 1 + nt] > 0 {
                let a = p.u32s.buf[noff + 2 + nt];
                g = g_infer(g, p, a, NONE());
                if g.res2 != NONE() && ty_signed_k(
                    g.c.r.rtys.buf[u64(g.res2)].kind) == 0 {
                    return g_bnorm(g, p, a);
                }
            }
        }
    }
    let v = vec.Vec<u8>::new(g.heap);
    v = resolve.bputs(v, "cast:u64:");
    v = gb_kcat(v, g, ik);
    v = v.push(u8(58));
    v = gi64(v, io);
    g = gb_key(g, v);
    g.bk = g.res; g.bo = 0;
    return g;
}

/// reps — reflexive transitive closure of `x` under efacts.
fn gb_reps(read g: G, k: u32, o: i64) -> vec.Vec<KP> {
    let out = vec.Vec<KP>::new(g.heap);
    out = out.push(KP { k: k, o: o });
    let i: u64 = 0;
    while i < out.len {
        let cur = out.buf[i];
        i = i + 1;
        let j: u64 = 0;
        while j < g.efacts.len {
            let f = g.efacts.buf[j];
            let nk: u32 = NONE(); let no: i64 = 0;
            if f.ak == cur.k && f.ao == cur.o {
                nk = f.bk; no = f.bo;
            }
            if f.bk == cur.k && f.bo == cur.o {
                nk = f.ak; no = f.ao;
            }
            if nk != NONE() {
                let dup: u8 = 0;
                let q: u64 = 0;
                while q < out.len {
                    if out.buf[q].k == nk && out.buf[q].o == no {
                        dup = 1;
                    }
                    q = q + 1;
                }
                if dup == 0 { out = out.push(KP { k: nk, o: no }); }
            }
            j = j + 1;
        }
    }
    return out;
}
fn gb_khas(read v: vec.Vec<KP>, k: u32, o: i64) -> u8 {
    let i: u64 = 0;
    while i < v.len {
        if v.buf[i].k == k && v.buf[i].o == o { return 1; }
        i = i + 1;
    }
    return 0;
}
fn gb_peq(read g: G, ak: u32, ao: i64, bk: u32, bo: i64) -> u8 {
    let r = gb_reps(g, ak, ao);
    let h = gb_khas(r, bk, bo);
    r.destroy();
    return h;
}

/// lt_proven — `a < b` under active facts (strict fact, or a
/// const-lo bound covering a const `a`). Both sides substitute
/// through efacts.
fn gb_lt(read g: G, ak: u32, ao: i64, bk: u32, bo: i64) -> u8 {
    let ar = gb_reps(g, ak, ao);
    let br = gb_reps(g, bk, bo);
    let i: u64 = 0;
    let ok: u8 = 0;
    while i < g.bfacts.len {
        let f = g.bfacts.buf[i];
        if gb_khas(br, f.hi_k, f.hi_o) == 1 {
            let hit: u8 = 0;
            if f.strict == 1
                && gb_khas(ar, f.lo_k, f.lo_o) == 1 { hit = 1; }
            if hit == 0 {
                let ca: i64 = 0; let caf: u8 = 0;
                let j: u64 = 0;
                while j < ar.len {
                    if ar.buf[j].k == g.kh {
                        caf = 1; ca = ar.buf[j].o;
                    }
                    j = j + 1;
                }
                if caf == 1 {
                    let lr = gb_reps(g, f.lo_k, f.lo_o);
                    j = 0;
                    while j < lr.len {
                        if lr.buf[j].k == g.kh
                            && lr.buf[j].o + i64(f.strict) >= ca + 1 {
                            hit = 1;
                        }
                        j = j + 1;
                    }
                    lr.destroy();
                }
            }
            if hit == 1 { ok = 1; }
        }
        i = i + 1;
    }
    ar.destroy(); br.destroy();
    return ok;
}

/// flo_proves — `want <= lo-of-some-fact-on-key` (const-lo bound).
fn gb_flo(read g: G, want: i64, key: u32, off: i64) -> u8 {
    let hr = gb_reps(g, key, off);
    let i: u64 = 0;
    let ok: u8 = 0;
    while i < g.bfacts.len {
        let f = g.bfacts.buf[i];
        if gb_khas(hr, f.hi_k, f.hi_o) == 1 {
            let lr = gb_reps(g, f.lo_k, f.lo_o);
            let j: u64 = 0;
            while j < lr.len {
                if lr.buf[j].k == g.kh
                    && lr.buf[j].o + i64(f.strict) >= want { ok = 1; }
                j = j + 1;
            }
            lr.destroy();
        }
        i = i + 1;
    }
    hr.destroy();
    return ok;
}

/// le_proven — `a <= b`: equality, a const `a` vs const/unsigned/
/// const-lo `b`, or a fact over these exact (or strict+1) operands.
fn gb_le(read g: G, ak: u32, ao: i64, bk2: u32, bo: i64,
         buns: u8) -> u8 {
    if gb_peq(g, ak, ao, bk2, bo) == 1 { return 1; }
    let ar = gb_reps(g, ak, ao);
    let ca: i64 = 0; let caf: u8 = 0;
    let i: u64 = 0;
    while i < ar.len {
        if ar.buf[i].k == g.kh { caf = 1; ca = ar.buf[i].o; }
        i = i + 1;
    }
    if caf == 1 {
        let br = gb_reps(g, bk2, bo);
        let j: u64 = 0;
        while j < br.len {
            if br.buf[j].k == g.kh && ca <= br.buf[j].o {
                ar.destroy(); br.destroy();
                return 1;
            }
            j = j + 1;
        }
        br.destroy();
        if bk2 != g.kh {
            if ca <= 0 && buns == 1 { ar.destroy(); return 1; }
            if gb_flo(g, ca, bk2, bo) == 1 { ar.destroy(); return 1; }
        }
    }
    let ok: u8 = 0;
    i = 0;
    while i < g.bfacts.len {
        let f = g.bfacts.buf[i];
        let hr = gb_reps(g, f.hi_k, f.hi_o);
        if gb_khas(hr, bk2, bo) == 1 {
            let lo_ok = gb_khas(ar, f.lo_k, f.lo_o);
            if lo_ok == 0 && f.strict == 1 {
                let j: u64 = 0;
                while j < ar.len {
                    if ar.buf[j].k == f.lo_k
                        && f.lo_o + 1 == ar.buf[j].o { lo_ok = 1; }
                    j = j + 1;
                }
            }
            if lo_ok == 1 { ok = 1; }
        }
        hr.destroy();
        i = i + 1;
    }
    ar.destroy();
    return ok;
}

/// pos_proven — `key > 0`: a positive const rep, or `0 < key`.
fn gb_pos(read g: G, key: u32) -> u8 {
    let r = gb_reps(g, key, 0);
    let i: u64 = 0;
    let ok: u8 = 0;
    while i < r.len {
        if r.buf[i].k == g.kh && r.buf[i].o > 0 { ok = 1; }
        i = i + 1;
    }
    r.destroy();
    if ok == 1 { return 1; }
    return gb_lt(g, g.kh, 0, key, 0);
}

/// and_facts — `dst = a & mask` records `0 <= dst <= mask`, plus
/// `dst < cap` for each `mask ≡ cap - 1` rep with `cap > 0` (N48).
fn g_and_facts(own g: G, read p: ast.Parser,
               dk: u32, dof: i64, mk: u32, mo: i64, mask: u32) -> G {
    let mreps = gb_reps(g, mk, mo);
    let pos = vec.Vec<u32>::new(g.heap);
    let i: u64 = 0;
    while i < mreps.len {
        let r = mreps.buf[i];
        if r.o == 0 - 1 && gb_pos(g, r.k) == 1 { pos = pos.push(r.k); }
        i = i + 1;
    }
    let nonneg: u8 = 0;
    g = g_infer(g, p, mask, NONE());
    if g.res2 != NONE()
        && ty_signed_k(g.c.r.rtys.buf[u64(g.res2)].kind) == 0 {
        nonneg = 1;
    }
    i = 0;
    while i < mreps.len {
        if mreps.buf[i].k == g.kh && mreps.buf[i].o >= 0 { nonneg = 1; }
        i = i + 1;
    }
    if pos.len > 0 { nonneg = 1; }
    if nonneg == 0 {
        pos.destroy(); mreps.destroy();
        return g;
    }
    g.bfacts = g.bfacts.push(BF {
        lo_k: g.kh, lo_o: 0, hi_k: dk, hi_o: dof, strict: 0 });
    g.bfacts = g.bfacts.push(BF {
        lo_k: dk, lo_o: dof, hi_k: mk, hi_o: mo, strict: 0 });
    i = 0;
    while i < pos.len {
        g.bfacts = g.bfacts.push(BF {
            lo_k: dk, lo_o: dof, hi_k: pos.buf[i], hi_o: 0,
            strict: 1 });
        i = i + 1;
    }
    pos.destroy(); mreps.destroy();
    return g;
}

/// `x != 0` on an unsigned `x` gives `0 < x` (N48) — shared by
/// cond's `!=` and neg's `==`.
fn g_neg_ne(own g: G, read p: ast.Parser, a: u32, b: u32) -> G {
    let i: u64 = 0;
    while i < 2 {
        let x = a; let c = b;
        if i == 1 { x = b; c = a; }
        g = g_bnorm(g, p, x);
        let xk = g.bk; let xo = g.bo;
        g = g_bnorm(g, p, c);
        if xk != NONE() && g.bk != NONE() {
            if g.bk == g.kh && g.bo == 0 && xk != g.kh {
                g = g_infer(g, p, x, NONE());
                if g.res2 != NONE() && ty_signed_k(
                    g.c.r.rtys.buf[u64(g.res2)].kind) == 0 {
                    g.bfacts = g.bfacts.push(BF {
                        lo_k: g.kh, lo_o: 0, hi_k: xk, hi_o: xo,
                        strict: 1 });
                    return g;
                }
            }
        }
        i = i + 1;
    }
    return g;
}

/// cond_facts — the facts a dominating cond proves (N46-48).
fn g_condf(own g: G, read p: ast.Parser, eid: u32) -> G {
    let e = check.xexp(g.c, p, eid);
    let k = check.ek_num(e.kind);
    if k == 4 && e.a == 1 { return g_negf(g, p, e.b); }
    if k == 5 && e.a == 16 {
        g = g_condf(g, p, e.b);
        return g_condf(g, p, e.c);
    }
    if k == 5 {
        let op = e.a;
        g = g_bnorm(g, p, e.b);
        let lk = g.bk; let lo = g.bo;
        g = g_bnorm(g, p, e.c);
        let rk = g.bk; let ro = g.bo;
        if lk == NONE() || rk == NONE() { return g; }
        if op == 5 {
            g.efacts = g.efacts.push(EF {
                ak: lk, ao: lo, bk: rk, bo: ro });
            return g;
        }
        if op == 6 { return g_neg_ne(g, p, e.b, e.c); }
        let strict: u8 = 1;
        if op == 7 { }
        if op == 9 { strict = 0; }
        if op == 8 { let t = lk; lk = rk; rk = t;
                     let t2 = lo; lo = ro; ro = t2; }
        if op == 10 { let t = lk; lk = rk; rk = t;
                      let t2 = lo; lo = ro; ro = t2; strict = 0; }
        if op != 7 && op != 8 && op != 9 && op != 10 { return g; }
        g.bfacts = g.bfacts.push(BF {
            lo_k: lk, lo_o: lo, hi_k: rk, hi_o: ro, strict: strict });
    }
    return g;
}

/// neg_facts — facts that hold when `cond` is FALSE (N48).
fn g_negf(own g: G, read p: ast.Parser, eid: u32) -> G {
    let e = check.xexp(g.c, p, eid);
    let k = check.ek_num(e.kind);
    if k == 4 && e.a == 1 { return g_condf(g, p, e.b); }
    if k == 5 && e.a == 17 {
        g = g_negf(g, p, e.b);
        return g_negf(g, p, e.c);
    }
    if k == 5 {
        let op = e.a;
        g = g_bnorm(g, p, e.b);
        let lk = g.bk; let lo = g.bo;
        g = g_bnorm(g, p, e.c);
        let rk = g.bk; let ro = g.bo;
        if lk == NONE() || rk == NONE() { return g; }
        if op == 6 {
            g.efacts = g.efacts.push(EF {
                ak: lk, ao: lo, bk: rk, bo: ro });
            return g;
        }
        if op == 5 { return g_neg_ne(g, p, e.b, e.c); }
        let strict: u8 = 1;
        if op == 7 { let t = lk; lk = rk; rk = t;
                     let t2 = lo; lo = ro; ro = t2; strict = 0; }
        if op == 9 { let t = lk; lk = rk; rk = t;
                     let t2 = lo; lo = ro; ro = t2; }
        if op == 8 { strict = 0; }
        if op != 7 && op != 8 && op != 9 && op != 10 { return g; }
        g.bfacts = g.bfacts.push(BF {
            lo_k: lk, lo_o: lo, hi_k: rk, hi_o: ro, strict: strict });
    }
    return g;
}

/// expr_has_deref — a `*p` anywhere inside `e`.
fn gb_hd(read g: G, read p: ast.Parser, eid: u32) -> u8 {
    let e = check.xexp(g.c, p, eid);
    let k = check.ek_num(e.kind);
    if k == 16 { return 1; }
    if k == 0 || k == 1 || k == 2 || k == 3 || k == 18
        || k == 13 || k == 22 { return 0; }
    if k == 4 || k == 11 { return gb_hd(g, p, e.b); }
    if k == 7 || k == 12 || k == 14 || k == 15 || k == 21 {
        return gb_hd(g, p, e.a);
    }
    if k == 5 {
        if gb_hd(g, p, e.b) == 1 { return 1; }
        return gb_hd(g, p, e.c);
    }
    if k == 8 {
        if gb_hd(g, p, e.a) == 1 { return 1; }
        return gb_hd(g, p, e.b);
    }
    if k == 9 {
        if gb_hd(g, p, e.a) == 1 { return 1; }
        if e.b != NONE() && gb_hd(g, p, e.b) == 1 { return 1; }
        if e.c != NONE() && gb_hd(g, p, e.c) == 1 { return 1; }
        return 0;
    }
    if k == 10 {
        let nt = u64(p.u32s.buf[u64(e.b)]);
        let nf = u64(p.u32s.buf[u64(e.b) + 1 + nt]);
        let i: u64 = 0;
        while i < nf {
            if gb_hd(g, p,
                p.u32s.buf[u64(e.b) + 2 + nt + i * 2 + 1]) == 1 {
                return 1;
            }
            i = i + 1;
        }
        return 0;
    }
    if k == 17 {
        if gb_hd(g, p, e.b) == 1 { return 1; }
        if e.c != NONE() && gb_hd(g, p, e.c) == 1 { return 1; }
        return 0;
    }
    if k == 20 {
        let i: u64 = u64(e.c);
        while i < u64(e.c) + u64(e.d) {
            if gb_hd(g, p, p.u32s.buf[i]) == 1 { return 1; }
            i = i + 1;
        }
        return 0;
    }
    // Call(6)/MethodCall(19) — u32s [nt,targs..,na,args..]
    let noff = u64(e.b);
    if k == 19 { noff = u64(e.c); }
    if k == 19 && gb_hd(g, p, e.a) == 1 { return 1; }
    let nt = u64(p.u32s.buf[noff]);
    let na = p.u32s.buf[noff + 1 + nt];
    let i: u64 = 0;
    while i < u64(na) {
        if gb_hd(g, p, p.u32s.buf[noff + 2 + nt + i]) == 1 {
            return 1;
        }
        i = i + 1;
    }
    return 0;
}

/// expr_has_mut_addr — `e` hands out a `&mut` of some place.
fn gb_hm(read g: G, read p: ast.Parser, eid: u32) -> u8 {
    let e = check.xexp(g.c, p, eid);
    let k = check.ek_num(e.kind);
    if k == 11 {
        if e.a != 0 { return 1; }
        return gb_hm(g, p, e.b);
    }
    if k == 0 || k == 1 || k == 2 || k == 3 || k == 18
        || k == 13 || k == 22 { return 0; }
    if k == 4 { return gb_hm(g, p, e.b); }
    if k == 7 || k == 12 || k == 14 || k == 15 || k == 16 || k == 21 {
        return gb_hm(g, p, e.a);
    }
    if k == 5 {
        if gb_hm(g, p, e.b) == 1 { return 1; }
        return gb_hm(g, p, e.c);
    }
    if k == 8 {
        if gb_hm(g, p, e.a) == 1 { return 1; }
        return gb_hm(g, p, e.b);
    }
    if k == 9 {
        if gb_hm(g, p, e.a) == 1 { return 1; }
        if e.b != NONE() && gb_hm(g, p, e.b) == 1 { return 1; }
        if e.c != NONE() && gb_hm(g, p, e.c) == 1 { return 1; }
        return 0;
    }
    if k == 10 {
        let nt = u64(p.u32s.buf[u64(e.b)]);
        let nf = u64(p.u32s.buf[u64(e.b) + 1 + nt]);
        let i: u64 = 0;
        while i < nf {
            if gb_hm(g, p,
                p.u32s.buf[u64(e.b) + 2 + nt + i * 2 + 1]) == 1 {
                return 1;
            }
            i = i + 1;
        }
        return 0;
    }
    if k == 17 {
        if gb_hm(g, p, e.b) == 1 { return 1; }
        if e.c != NONE() && gb_hm(g, p, e.c) == 1 { return 1; }
        return 0;
    }
    if k == 20 {
        let i: u64 = u64(e.c);
        while i < u64(e.c) + u64(e.d) {
            if gb_hm(g, p, p.u32s.buf[i]) == 1 { return 1; }
            i = i + 1;
        }
        return 0;
    }
    let noff = u64(e.b);
    if k == 19 { noff = u64(e.c); }
    if k == 19 && gb_hm(g, p, e.a) == 1 { return 1; }
    let nt = u64(p.u32s.buf[noff]);
    let na = p.u32s.buf[noff + 1 + nt];
    let i: u64 = 0;
    while i < u64(na) {
        if gb_hm(g, p, p.u32s.buf[noff + 2 + nt + i]) == 1 {
            return 1;
        }
        i = i + 1;
    }
    return 0;
}

/// bkill — a store through `e` kills facts anchored on its place;
/// a `*p` store clears all.
fn g_bkill(own g: G, read p: ast.Parser, eid: u32) -> G {
    if gb_hd(g, p, eid) == 1 {
        while g.bfacts.len > 0 { g.bfacts.pop(); }
        while g.efacts.len > 0 { g.efacts.pop(); }
        return g;
    }
    let tgt = eid;
    let te = check.xexp(g.c, p, eid);
    if check.ek_num(te.kind) == 11 { tgt = te.b; }
    g = g_bkey(g, p, tgt);
    if g.bk == NONE() { return g; }
    let k = g.bk;
    let nb = vec.Vec<BF>::new(g.heap);
    let i: u64 = 0;
    while i < g.bfacts.len {
        let f = g.bfacts.buf[i];
        let dl: u8 = 0; let dh: u8 = 0;
        if f.lo_k == k || gb_pref(g, f.lo_k, k) == 1 { dl = 1; }
        if f.hi_k == k || gb_pref(g, f.hi_k, k) == 1 { dh = 1; }
        if dl == 0 && dh == 0 { nb = nb.push(f); }
        i = i + 1;
    }
    g.bfacts.destroy();
    g.bfacts = nb;
    let ne = vec.Vec<EF>::new(g.heap);
    i = 0;
    while i < g.efacts.len {
        let f = g.efacts.buf[i];
        let da: u8 = 0; let db: u8 = 0;
        if f.ak == k || gb_pref(g, f.ak, k) == 1 { da = 1; }
        if f.bk == k || gb_pref(g, f.bk, k) == 1 { db = 1; }
        if da == 0 && db == 0 { ne = ne.push(f); }
        i = i + 1;
    }
    g.efacts.destroy();
    g.efacts = ne;
    return g;
}

/// and_idx_proven — `base[a & m]`: `a & m <= m < len` when `m` is
/// nonneg and proven under the len key (N48 mask idiom). res = 0/1.
fn gb_andidx(own g: G, read p: ast.Parser, m: u32, lk: u32) -> G {
    g = g_bnorm(g, p, m);
    if g.bk == NONE() { g.res = 0; return g; }
    let mk = g.bk; let mo = g.bo;
    let mreps = gb_reps(g, mk, mo);
    let lreps = gb_reps(g, lk, 0);
    let pos = vec.Vec<u32>::new(g.heap);
    let i: u64 = 0;
    while i < mreps.len {
        if mreps.buf[i].o == 0 - 1
            && gb_pos(g, mreps.buf[i].k) == 1 {
            pos = pos.push(mreps.buf[i].k);
        }
        i = i + 1;
    }
    let nonneg: u8 = 0;
    g = g_infer(g, p, m, NONE());
    if g.res2 != NONE()
        && ty_signed_k(g.c.r.rtys.buf[u64(g.res2)].kind) == 0 {
        nonneg = 1;
    }
    i = 0;
    while i < mreps.len {
        if mreps.buf[i].k == g.kh && mreps.buf[i].o >= 0 {
            nonneg = 1;
        }
        i = i + 1;
    }
    if pos.len > 0 { nonneg = 1; }
    g.res = 0;
    if nonneg == 1 {
        if gb_lt(g, mk, mo, lk, 0) == 1 {
            g.res = 1;
        } else {
            i = 0;
            while i < pos.len {
                if gb_khas(lreps, pos.buf[i], 0) == 1 { g.res = 1; }
                i = i + 1;
            }
        }
    }
    pos.destroy(); mreps.destroy(); lreps.destroy();
    return g;
}

/// idx_proven — `idx` provably inside `base`'s len (N46). res = 0/1.
fn gb_idx(own g: G, read p: ast.Parser, idx: u32, base: u32,
          it: u32) -> G {
    g = g_bkey(g, p, base);
    if g.bk == NONE() { g.res = 0; return g; }
    g = gb_kdot(g, g.bk, "len");
    let lk = g.res;
    g = g_bnorm(g, p, idx);
    if g.bk == NONE() {
        let ie = check.xexp(g.c, p, idx);
        if check.ek_num(ie.kind) == 5 && ie.a == 13 {
            return gb_andidx(g, p, ie.c, lk);
        }
        g.res = 0;
        return g;
    }
    let ik = g.bk; let io = g.bo;
    if ik == g.kh && io < 0 { g.res = 0; return g; }
    if gb_lt(g, ik, io, lk, 0) == 0 { g.res = 0; return g; }
    if ik == g.kh { g.res = 1; return g; }
    let itk = g.c.r.rtys.buf[u64(it)].kind;
    if ty_signed_k(itk) == 0 { g.res = 1; return g; }
    g.res = u32(gb_flo(g, 0, ik, io));
    return g;
}

/// range_proven — `0 <= lo <= hi <= len` (N46). res = 0/1.
fn gb_range(own g: G, read p: ast.Parser, lo: u32, hi: u32,
            base: u32) -> G {
    g = g_bkey(g, p, base);
    if g.bk == NONE() { g.res = 0; return g; }
    g = gb_kdot(g, g.bk, "len");
    let lk = g.res;
    let hk = lk; let ho: i64 = 0;
    if hi != NONE() {
        g = g_bnorm(g, p, hi);
        if g.bk == NONE() { g.res = 0; return g; }
        hk = g.bk; ho = g.bo;
        if gb_le(g, hk, ho, lk, 0, 1) == 0 { g.res = 0; return g; }
    }
    let lok = g.kh; let loff: i64 = 0;
    let losgn: u8 = 0;
    if lo != NONE() {
        g = g_bnorm(g, p, lo);
        if g.bk == NONE() { g.res = 0; return g; }
        lok = g.bk; loff = g.bo;
        g = g_infer(g, p, lo, NONE());
        if g.res2 != NONE() && ty_signed_k(
            g.c.r.rtys.buf[u64(g.res2)].kind) == 1 { losgn = 1; }
    }
    let lo_ok: u8 = 0;
    if lok == g.kh && loff >= 0 { lo_ok = 1; }
    if lok != g.kh && (losgn == 0 || gb_flo(g, 0, lok, loff) == 1) {
        lo_ok = 1;
    }
    if lo_ok == 0 { g.res = 0; return g; }
    let huns: u8 = 1;
    if hi != NONE() {
        g = g_infer(g, p, hi, NONE());
        if g.res2 != NONE() && ty_signed_k(
            g.c.r.rtys.buf[u64(g.res2)].kind) == 1 { huns = 0; }
    }
    g.res = u32(gb_le(g, lok, loff, hk, ho, huns));
    return g;
}

/// N47-N48 — the facts a fresh binding establishes: `m = e` gives
/// `m ≡ e` (+`.len` for spans), `alloc_slice(h, n)` gives
/// `m.len ≡ n`, `a & mask` binds the AND's bounds onto `m`. Shared
/// by `let` stmts and `$rvN` materialization lets.
fn g_letfacts(own g: G, read p: ast.Parser, slot: u32, t: u32,
              init: u32) -> G {
    let mv = vec.Vec<u8>::new(g.heap);
    mv = resolve.bputs(mv, "s");
    mv = resolve.bu32(mv, u64(slot));
    g = gb_key(g, mv);
    let mk = g.res;
    let ie = check.xexp(g.c, p, init);
    let did: u8 = 0;
    if check.ek_num(ie.kind) == 17 && ie.c != NONE() {
        did = 1;
        g = g_bnorm_lenkey(g, p, ie.c);
        if g.bk != NONE() {
            g = gb_kdot(g, mk, "len");
            g.efacts = g.efacts.push(EF {
                ak: g.res, ao: 0, bk: g.bk, bo: g.bo });
        }
    }
    if did == 0 {
        g = g_bnorm(g, p, init);
        if g.bk != NONE() {
            let pk = g.bk; let po = g.bo;
            g.efacts = g.efacts.push(EF {
                ak: mk, ao: 0, bk: pk, bo: po });
            let tk = g.c.r.rtys.buf[u64(t)].kind;
            if tk == 17 || tk == 25 || tk == 10 {
                g = gb_kdot(g, mk, "len");
                let a2 = g.res;
                g = gb_kdot(g, pk, "len");
                g.efacts = g.efacts.push(EF {
                    ak: a2, ao: 0, bk: g.res, bo: po });
            }
        }
        if check.ek_num(ie.kind) == 5 && ie.a == 13 {
            g = g_bnorm(g, p, ie.c);
            if g.bk != NONE() {
                g = g_and_facts(g, p, mk, 0, g.bk, g.bo, ie.c);
            }
        }
    }
    return g;
}

/// call — resolved callee via cres/intern; fdecl sig marshals args
/// (read/write → place addr, own/plain → expr value).
/// own-module fn named `vn` — s0's `local_fns` set (own `p.fns`
/// only; dep fns don't shadow builtins).
fn g_localfn(own g: G, read p: ast.Parser, vn: u32) -> G {
    let i: u64 = 0;
    g.res4 = 0;
    while i < p.fns.len {
        g.c.r = resolve.intern_pname(g.c.r, p, p.fns.buf[i].name);
        let fn_ = g.c.r.res;
        if g.c.r.qual != NONE() {
            g.c.r = resolve.qual_for(g.c.r, g.c.r.qual, fn_);
            fn_ = g.c.r.res;
        }
        if fn_ == vn { g.res4 = 1; return g; }
        i = i + 1;
    }
    return g;
}

fn g_call(own g: G, read p: ast.Parser, eid: u32,
          want: u32) -> G {
    let e = check.xexp(g.c, p, eid);
    g.c = check.callee_of(g.c, p, eid);
    let vn = g.c.res;
    if vn == NONE() {                        // unresolved / variant lit
        if check.ek_num(e.kind) == 20 {
            // `T::v(..)` — enum-variant ctor (s0's EnumLit): anon
            // local, tag+payload stores, whole-aggregate load. The
            // checker's etys row carries the inferred App upgrade.
            let aty = g_ety(g, e.line, e.col);
            if aty == NONE() {
                g.c.r = resolve.cnv_ty(g.c.r, p, e.a);
                aty = g.c.r.res;
            }
            if u64(aty) < g.c.r.rtys.len {
                let atn = g.c.r.rtys.buf[u64(aty)];
                if atn.kind == 12 || atn.kind == 13 {
                    g = g_declof(g, atn.name);
                    if g.res2 != NONE() {
                        let ei = g.res2;
                        g.c.r = resolve.intern_pname(g.c.r, p, e.b);
                        let vnid = g.c.r.res;
                        let pay: u32 = NONE();
                        if e.d > 0 {
                            pay = p.u32s.buf[u64(e.c)];
                        }
                        g = gfresh(g);
                        let slot = g.res;
                        g = e_local(g, slot, aty, NONE());
                        g.pl_r = slot; g.pl_val = 0;
                        g.pl_rty = aty; g.pl_ty = aty;
                        g.pl_off = u32(g.pel.len); g.pl_len = 0;
                        g = g_fillenum(g, p, ei, vnid, pay, aty);
                        return gload(g);
                    }
                }
            }
        }
        g.res = OK_IMM(); g.resv = 0;
        return g;
    }
    // `u64(x)`/`i32(x)` — builtin int casts unless an own-module fn
    // shadows the name (s0's int_cast_ty + !local_fns guard).
    let ctk = resolve.int_cast_ty(g.c.r, vn);
    if ctk >= 0 {
        g = g_localfn(g, p, vn);
        if g.res4 == 0 {
            if check.call_nargs(g.c, p, eid) != 1 {
                g.res = OK_IMM(); g.resv = 0;
                return g;
            }
            g = rty(g, u8(ctk));
            let to = g.res;
            g.c = check.call_arg(g.c, p, e, eid, 0);
            let a0 = g.c.res;
            g = g_infer(g, p, a0, NONE());
            let from = g.res2;
            g = g_expr(g, p, a0, from);
            let vk = g.res; let vv = g.resv;
            g = g_same_ty(g, from, to);
            if g.res == 1 {
                g.res = vk; g.resv = vv;
                return g;
            }
            g = gfresh(g);
            let d = g.res;
            g = e_cast(g, d, from, vk, vv, to);
            g.res = OK_REG(); g.resv = i64(d);
            return g;
        }
    }
    // `system_allocator()` — the token is a runtime pointer; NULL
    // is the system heap (s0: const_of(Alloc, 0)).
    if check.nid_lit_eq(g.c, vn, "system_allocator") {
        g = g_localfn(g, p, vn);
        if g.res4 == 0 {
            g = rty(g, 11);
            return gconst(g, g.res, 0);
        }
    }
    // `free(p)` → `call.void mml_free(*void p)` — the checker
    // consumed the Own authority; IR hands the data ptr over.
    if check.nid_lit_eq(g.c, vn, "free") {
        g = g_localfn(g, p, vn);
        if g.res4 == 0 {
            if check.call_nargs(g.c, p, eid) == 0 {
                g.res = OK_IMM(); g.resv = 0;
                return g;
            }
            g.c = check.call_arg(g.c, p, e, eid, 0);
            let a0 = g.c.res;
            g = g_infer(g, p, a0, NONE());
            let t = g.res2;
            g = g_expr(g, p, a0, t);
            let pk = g.res; let pv = g.resv;
            if u64(t) < g.c.r.rtys.len {
                if g.c.r.rtys.buf[u64(t)].kind == 25 {
                    g = g_strparts(g, pk, pv);
                    pk = g.res; pv = g.resv;
                }
            }
            g = g_ptrty(g);
            let pty = g.res;
            g = rty(g, 9);
            let vd = g.res;
            while g.ax.len > 0 { g.ax.pop(); }
            g.ax = g.ax.push(AX { ty: pty, k: pk, v: pv });
            g = g_rtcall(g, "mml_free", vd);
            g.res = OK_IMM(); g.resv = 0;
            return g;
        }
    }
    // `str_from_utf8(b)` — validate, then re-tag the same {ptr,len}
    // as `str`.
    if check.nid_lit_eq(g.c, vn, "str_from_utf8") {
        g = g_localfn(g, p, vn);
        if g.res4 == 0 {
            if check.call_nargs(g.c, p, eid) == 0 {
                g.res = OK_IMM(); g.resv = 0;
                return g;
            }
            g.c = check.call_arg(g.c, p, e, eid, 0);
            let a0 = g.c.res;
            g = g_expr(g, p, a0, NONE());
            g = g_strparts(g, g.res, g.resv);
            let pk = g.res; let pv = g.resv;
            let lk = g.res4; let lv = g.resv2;
            g = g_ptrty(g);
            let pty = g.res;
            g = rty(g, 7);
            let i64t = g.res;
            while g.ax.len > 0 { g.ax.pop(); }
            g.ax = g.ax.push(AX { ty: pty, k: pk, v: pv });
            g.ax = g.ax.push(AX { ty: i64t, k: lk, v: lv });
            g = rty(g, 9);
            g = g_rtcall(g, "mml_str_validate", g.res);
            g = rty(g, 10);
            return g_makeagg2(g, g.res, pk, pv, lk, lv);
        }
    }
    // `cstr(s)` — the literal's own address, or field 0 of the str
    // aggregate; the checker proved the storage carries a NUL.
    if check.nid_lit_eq(g.c, vn, "cstr") {
        g = g_localfn(g, p, vn);
        if g.res4 == 0 {
            if check.call_nargs(g.c, p, eid) == 0 {
                g.res = OK_IMM(); g.resv = 0;
                return g;
            }
            g.c = check.call_arg(g.c, p, e, eid, 0);
            let a0 = g.c.res;
            let ae = check.xexp(g.c, p, a0);
            if check.ek_num(ae.kind) == 3 {
                return g_expr(g, p, a0, NONE());
            }
            g = rty(g, 10);
            let st = g.res;
            g = g_expr(g, p, a0, st);
            g = g_strparts(g, g.res, g.resv);
            g.resv2 = 0;
            return g;                   // res/resv = ptr opnd
        }
    }
    // `slice(p, n)` — trusted foreign-storage wrap: raw ptr + len.
    if check.nid_lit_eq(g.c, vn, "slice") {
        g = g_localfn(g, p, vn);
        if g.res4 == 0 {
            if check.call_nargs(g.c, p, eid) < 2 {
                g.res = OK_IMM(); g.resv = 0;
                return g;
            }
            g.c = check.call_arg(g.c, p, e, eid, 0);
            let p0 = g.c.res;
            g.c = check.call_arg(g.c, p, e, eid, 1);
            let l0 = g.c.res;
            let elem: u32 = NONE();
            let mutf: u32 = 0;
            g = g_infer(g, p, p0, NONE());
            let pt0 = g.res2;
            if pt0 != NONE() {
                let pn = g.c.r.rtys.buf[u64(pt0)];
                if pn.kind == 16 { elem = pn.a; mutf = pn.b; }
            }
            if elem == NONE() { g = rty(g, 9); elem = g.res; }
            g = g_expr(g, p, p0, NONE());
            let pk = g.res; let pv = g.resv;
            g = g_infer(g, p, l0, NONE());
            let lt0 = g.res2;
            g = g_expr(g, p, l0, lt0);
            g = g_i64v(g, lt0, g.res, g.resv);
            let lk = g.res; let lv = g.resv;
            g.c.r = resolve.mk_un(g.c.r, 17, elem, mutf);
            return g_makeagg2(g, g.c.r.res, pk, pv, lk, lv);
        }
    }
    // `unreachable()` — N32: seal the block dead.
    if check.nid_lit_eq(g.c, vn, "unreachable") {
        g = g_localfn(g, p, vn);
        if g.res4 == 0 {
            g = gseal_dead(g);
            g.res = OK_IMM(); g.resv = 0;
            return g;
        }
    }
    // `unlock(g)` — explicit release: the slot drops out of the
    // scope-exit set so it isn't unlocked twice (s0's remove).
    if check.nid_lit_eq(g.c, vn, "unlock") {
        g = g_localfn(g, p, vn);
        if g.res4 == 0 {
            if check.call_nargs(g.c, p, eid) == 0 {
                g.res = OK_IMM(); g.resv = 0;
                return g;
            }
            g.c = check.call_arg(g.c, p, e, eid, 0);
            let a0 = g.c.res;
            let ae = check.xexp(g.c, p, a0);
            if check.ek_num(ae.kind) == 2 {
                g.c.r = resolve.intern_pname(g.c.r, p, ae.a);
                g = gfind(g, g.c.r.res);
                if g.res != NONE()
                    && g.c.r.rtys.buf[u64(g.res3)].kind == 22 {
                    g = og_rel(g, g.res2);
                }
            }
            g = g_expr(g, p, a0, NONE());
            let vk = g.res; let vv = g.resv;
            g = g_ptrty(g);
            let pt = g.res;
            while g.ax.len > 0 { g.ax.pop(); }
            g.ax = g.ax.push(AX { ty: pt, k: vk, v: vv });
            g = rty(g, 9);
            g = g_rtcall(g, "mml_mutex_unlock", g.res);
            g.res = OK_IMM(); g.resv = 0;
            return g;
        }
    }
    // `lock(m)` — the mutex object ptr flows to mml_mutex_lock;
    // Ref/Handle args deref to the cell, Mutex args load the cell.
    if check.nid_lit_eq(g.c, vn, "lock") {
        g = g_localfn(g, p, vn);
        if g.res4 == 0 {
            if check.call_nargs(g.c, p, eid) == 0 {
                g.res = OK_IMM(); g.resv = 0;
                return g;
            }
            g.c = check.call_arg(g.c, p, e, eid, 0);
            let a0 = g.c.res;
            g = g_pshallow(g, p, a0);
            let t0 = g.res2;
            if t0 == NONE() {
                g = g_infer(g, p, a0, NONE());
                t0 = g.res2;
            }
            let n0 = g.c.r.rtys.buf[u64(t0)];
            let have: u8 = 0;
            let bk = OK_IMM(); let bv: i64 = 0;
            if n0.kind == 15 || n0.kind == 18 {
                // place_ptr — the referent's cell holds the object
                // pointer: eval the arg, root a Val place, load.
                let el = n0.a;
                g = g_expr(g, p, a0, NONE());
                if g.res == OK_REG() {
                    g.pl_r = u32(g.resv); g.pl_val = 1;
                    g.pl_rty = el; g.pl_ty = el;
                    g.pl_off = u32(g.pel.len); g.pl_len = 0;
                    g = gload(g);
                    bk = g.res; bv = g.resv;
                    have = 1;
                }
            }
            if have == 0 && n0.kind == 21 {
                g = g_place(g, p, a0);
                if g.res3 != NONE() {
                    g = gload(g);
                    bk = g.res; bv = g.resv;
                    have = 1;
                }
            }
            if have == 0 { g.res = OK_IMM(); g.resv = 0; return g; }
            g = g_ptrty(g);
            let pt = g.res;
            while g.ax.len > 0 { g.ax.pop(); }
            g.ax = g.ax.push(AX { ty: pt, k: bk, v: bv });
            return g_rtcall(g, "mml_mutex_lock", pt);
        }
    }
    // `channel()` — a runtime queue sized for the declared packet
    // shape (`channel T` — T's size rides in `want`; default 8).
    if check.nid_lit_eq(g.c, vn, "channel") {
        g = g_localfn(g, p, vn);
        if g.res4 == 0 {
            let sz: i64 = 8;
            if want != NONE() && u64(want) < g.c.r.rtys.len {
                let wn = g.c.r.rtys.buf[u64(want)];
                if wn.kind == 23 {
                    g = g_sizeof(g, wn.a);
                    sz = g.resv;
                }
            }
            if sz < 8 { sz = 8; }
            g = rty(g, 7);
            let i64t = g.res;
            g = gconst(g, i64t, sz);
            let szk = g.res; let szv = g.resv;
            g = g_ptrty(g);
            let pt = g.res;
            while g.ax.len > 0 { g.ax.pop(); }
            g.ax = g.ax.push(AX { ty: i64t, k: szk, v: szv });
            return g_rtcall(g, "mml_chan_new", pt);
        }
    }
    // `send(c, v)` / `recv(c)` / `close(c)` — the handle's payload
    // cell marshals across the runtime boundary (s0's chan ops).
    if check.nid_lit_eq(g.c, vn, "send")
        || check.nid_lit_eq(g.c, vn, "recv")
        || check.nid_lit_eq(g.c, vn, "close") {
        g = g_localfn(g, p, vn);
        if g.res4 == 0 {
            return g_chanop(g, p, e, eid, vn);
        }
    }
    // atomic builtins — aload/astore/armw.add/cas on the named
    // storage; ref/handle args mean the REFERENT's place.
    if check.nid_lit_eq(g.c, vn, "atomic_load")
        || check.nid_lit_eq(g.c, vn, "atomic_store")
        || check.nid_lit_eq(g.c, vn, "atomic_add")
        || check.nid_lit_eq(g.c, vn, "compare_exchange") {
        g = g_localfn(g, p, vn);
        if g.res4 == 0 {
            return g_atomic(g, p, e, eid, vn);
        }
    }
    // `replace(pl, v)` — load old into a temp, store the new.
    if check.nid_lit_eq(g.c, vn, "replace") {
        g = g_localfn(g, p, vn);
        if g.res4 == 0 {
            g.c = check.call_arg(g.c, p, e, eid, 0);
            g = g_place(g, p, g.c.res);
            if g.res3 == NONE() {
                g.res = OK_IMM(); g.resv = 0;
                return g;
            }
            let pr = g.pl_r; let pv2 = g.pl_val;
            let prt = g.pl_rty; let pt = g.pl_ty;
            let po = g.pl_off; let plen = g.pl_len;
            let vk = OK_IMM(); let vv: i64 = 0;
            if check.call_nargs(g.c, p, eid) > 1 {
                g.c = check.call_arg(g.c, p, e, eid, 1);
                g = g_expr(g, p, g.c.res, pt);
                vk = g.res; vv = g.resv;
            }
            g.pl_r = pr; g.pl_val = pv2; g.pl_rty = prt;
            g.pl_ty = pt; g.pl_off = po; g.pl_len = plen;
            g = gload(g);
            let ok_ = g.res; let ov = g.resv;
            g = e_store(g, vk, vv);
            // N46 — the store may move a bound fact's place.
            g.c = check.call_arg(g.c, p, e, eid, 0);
            g = g_bkill(g, p, g.c.res);
            g.res = ok_; g.resv = ov;
            return g;
        }
    }
    // `swap(a, b)` — both loads before either store.
    if check.nid_lit_eq(g.c, vn, "swap") {
        g = g_localfn(g, p, vn);
        if g.res4 == 0 {
            if check.call_nargs(g.c, p, eid) < 2 {
                g.res = OK_IMM(); g.resv = 0;
                return g;
            }
            g.c = check.call_arg(g.c, p, e, eid, 0);
            g = g_place(g, p, g.c.res);
            if g.res3 == NONE() {
                g.res = OK_IMM(); g.resv = 0;
                return g;
            }
            let ar = g.pl_r; let av_ = g.pl_val;
            let art = g.pl_rty; let at2 = g.pl_ty;
            let ao = g.pl_off; let al = g.pl_len;
            g.c = check.call_arg(g.c, p, e, eid, 1);
            g = g_place(g, p, g.c.res);
            if g.res3 == NONE() {
                g.res = OK_IMM(); g.resv = 0;
                return g;
            }
            let br_ = g.pl_r; let bv_ = g.pl_val;
            let brt = g.pl_rty; let bt2 = g.pl_ty;
            let bo = g.pl_off; let bl = g.pl_len;
            g.pl_r = ar; g.pl_val = av_; g.pl_rty = art;
            g.pl_ty = at2; g.pl_off = ao; g.pl_len = al;
            g = gload(g);
            let vak = g.res; let vav = g.resv;
            g.pl_r = br_; g.pl_val = bv_; g.pl_rty = brt;
            g.pl_ty = bt2; g.pl_off = bo; g.pl_len = bl;
            g = gload(g);
            let vbk = g.res; let vbv = g.resv;
            g.pl_r = ar; g.pl_val = av_; g.pl_rty = art;
            g.pl_ty = at2; g.pl_off = ao; g.pl_len = al;
            g = e_store(g, vbk, vbv);          // store(a, vb)
            g.pl_r = br_; g.pl_val = bv_; g.pl_rty = brt;
            g.pl_ty = bt2; g.pl_off = bo; g.pl_len = bl;
            g = e_store(g, vak, vav);          // store(b, va)
            // N46 — both stores may move bound facts' places.
            g.c = check.call_arg(g.c, p, e, eid, 0);
            g = g_bkill(g, p, g.c.res);
            g.c = check.call_arg(g.c, p, e, eid, 1);
            g = g_bkill(g, p, g.c.res);
            g.res = OK_IMM(); g.resv = 0;
            return g;
        }
    }
    g = g_fdecl(g, vn);
    let fi = g.res;
    let na = check.call_nargs(g.c, p, eid);
    // per-call arg vec — arg lowering can itself emit calls (bounds
    // checks inside `&a[i]` places), so the shared `g.ax` can't hold
    // an in-flight arg list.
    let axv = vec.Vec<AX>::new(g.heap);
    let i: u64 = 0;
    while i < na {
        let pa: u8 = 0;
        let at = NONE();
        if fi != NONE() {
            let fd = g.c.r.fdecls.buf[u64(fi)];
            if i < u64(fd.ps_len) {
                let pr = g.c.r.params.buf[u64(fd.ps_off) + i];
                pa = pr.auth;
                at = pr.ty;
            }
        }
        g.c = check.call_arg(g.c, p, e, eid, i);
        let aeid = g.c.res;
        if at == NONE() {
            g = g_infer(g, p, aeid, NONE());
            at = g.res2;
        }
        if pa == 1 || pa == 2 {              // read | write
            g = g_place(g, p, aeid);
            g = gfresh(g);
            let d = g.res;
            g = e_addr(g, d);
            g = rty_ref(g, at, u32(pa) - 1);
            axv = axv.push(AX { ty: g.res, k: OK_REG(), v: i64(d) });
        } else {
            g = g_expr(g, p, aeid, at);
            axv = axv.push(AX { ty: at, k: g.res, v: g.resv });
        }
        i = i + 1;
    }
    let ret: u32 = 9;
    if fi != NONE() {
        ret = g.c.r.fdecls.buf[u64(fi)].ret;
    } else {
        g = rty(g, 9);
        ret = g.res;
    }
    let saved = g.ax;
    g.ax = axv;
    g = g_callemit(g, vn, ret);
    g.ax.destroy();
    g.ax = saved;
    // N46 — the call may write through `write` params or a `&mut`
    // operand: bound facts on those places die here. (bkill clobbers
    // res/resv — hold the result opnd aside.)
    let rk = g.res; let rv = g.resv;
    let j: u64 = 0;
    while j < na {
        let mut_: u8 = 0;
        if fi != NONE() {
            let fd2 = g.c.r.fdecls.buf[u64(fi)];
            if j < u64(fd2.ps_len) {
                if g.c.r.params.buf[u64(fd2.ps_off) + j].auth == 2 {
                    mut_ = 1;
                }
            }
        }
        g.c = check.call_arg(g.c, p, e, eid, j);
        let ae = g.c.res;
        if mut_ == 0 && gb_hm(g, p, ae) == 1 { mut_ = 1; }
        if mut_ == 1 { g = g_bkill(g, p, ae); }
        j = j + 1;
    }
    g.res = rk; g.resv = rv;
    return g;
}

/// place — `res3` = pl_ty | NONE, place itself in `pl_*`. Var and
/// Deref now; Field/Index land with the aggregate bands.
fn g_place(own g: G, read p: ast.Parser, eid: u32) -> G {
    let rn = rvm_find(g, eid);               // materialized → Var $rvN
    if eid == g.rvskip { rn = NONE(); }     // producer re-eval, no self-load
    if rn != NONE() { return gplace_var(g, rn); }
    let e = check.xexp(g.c, p, eid);
    let k = check.ek_num(e.kind);
    if k == 2 {
        g.c.r = resolve.intern_pname(g.c.r, p, e.a);
        let vn = g.c.r.res;
        // guard slots hold the mutex object — place access goes
        // through `mml_mutex_data` (s0's `Expr::Var` guard arm).
        g = gfind(g, vn);
        if g.res != NONE()
            && g.c.r.rtys.buf[u64(g.res3)].kind == 22 {
            let el2 = g.c.r.rtys.buf[u64(g.res3)].a;
            g.pl_r = g.res2; g.pl_val = u8(g.res4);
            g.pl_rty = g.res3; g.pl_ty = g.res3;
            g.pl_off = u32(g.pel.len); g.pl_len = 0;
            g = gload(g);
            let vv = g.resv;
            g = g_ptrty(g);
            let pt = g.res;
            while g.ax.len > 0 { g.ax.pop(); }
            g.ax = g.ax.push(AX { ty: pt, k: OK_REG(), v: vv });
            g = g_rtcall(g, "mml_mutex_data", pt);
            g.pl_r = u32(g.resv); g.pl_val = 1;
            g.pl_rty = el2; g.pl_ty = el2;
            g.pl_off = u32(g.pel.len); g.pl_len = 0;
            g.res3 = el2;
            return g;
        }
        return gplace_var(g, vn);
    }
    if k == 16 {                             // *inner — Val-root
        g = g_infer(g, p, e.a, NONE());
        let n = g.c.r.rtys.buf[u64(g.res2)];
        if n.kind != 15 && n.kind != 18 && n.kind != 22
            && n.kind != 24 {
            g.res3 = NONE();
            return g;
        }
        let el = n.a;
        g = g_expr(g, p, e.a, NONE());
        if g.res != OK_REG() {
            g.res3 = NONE();
            return g;
        }
        let vr = u32(g.resv);
        if n.kind == 22 {
            // `*g` lands on the guarded payload — the guard's value
            // is the mutex object, so root at `mml_mutex_data(g)`
            // (s0's place_ptr Guard arm).
            g = g_ptrty(g);
            let pt = g.res;
            while g.ax.len > 0 { g.ax.pop(); }
            g.ax = g.ax.push(AX { ty: pt, k: OK_REG(), v: i64(vr) });
            g = g_rtcall(g, "mml_mutex_data", pt);
            vr = u32(g.resv);
        }
        g.pl_r = vr;
        g.pl_val = 1;
        g.pl_rty = el;
        g.pl_ty = el;
        g.pl_off = u32(g.pel.len);
        g.pl_len = 0;
        g.res3 = el;
        return g;
    }
    if k == 7 {                              // base.f — field nav
        g.c.r = resolve.intern_pname(g.c.r, p, e.b);
        let fn_ = g.c.r.res;
        g = g_place(g, p, e.a);
        if g.res3 == NONE() { return g; }
        let n = g.c.r.rtys.buf[u64(g.pl_ty)];
        // slice → ptr/len pseudo-fields
        if n.kind == 17 {
            if check.nid_lit_eq(g.c, fn_, "ptr") {
                g.c.r = resolve.mk_un(g.c.r, 16, n.a, n.b);
                g.pl_ty = g.c.r.res;
                g = gpush_f(g, fn_, 0, g.pl_ty);
                g.res3 = g.pl_ty;
                return g;
            }
            if check.nid_lit_eq(g.c, fn_, "len") {
                g = rty(g, 3);
                g.pl_ty = g.res;
                g = gpush_f(g, fn_, 1, g.pl_ty);
                g.res3 = g.pl_ty;
                return g;
            }
            g.res3 = NONE(); return g;
        }
        // str — `.len` is field 1; `.bytes` re-reads the aggregate
        // as `slice u8` with NO path push.
        if n.kind == 10 {
            if check.nid_lit_eq(g.c, fn_, "len") {
                g = rty(g, 3);
                g.pl_ty = g.res;
                g = gpush_f(g, fn_, 1, g.pl_ty);
                g.res3 = g.pl_ty;
                return g;
            }
            if check.nid_lit_eq(g.c, fn_, "bytes") {
                g = rty(g, 0);
                g.c.r = resolve.mk_un(g.c.r, 17, g.res, 0);
                g.pl_ty = g.c.r.res;
                g.res3 = g.pl_ty;
                return g;
            }
            g.res3 = NONE(); return g;
        }
        // box slice — `.ptr` writable, `.len` at 1.
        if n.kind == 25 {
            if check.nid_lit_eq(g.c, fn_, "ptr") {
                g.c.r = resolve.mk_un(g.c.r, 16, n.a, 1);
                g.pl_ty = g.c.r.res;
                g = gpush_f(g, fn_, 0, g.pl_ty);
                g.res3 = g.pl_ty;
                return g;
            }
            if check.nid_lit_eq(g.c, fn_, "len") {
                g = rty(g, 3);
                g.pl_ty = g.res;
                g = gpush_f(g, fn_, 1, g.pl_ty);
                g.res3 = g.pl_ty;
                return g;
            }
            g.res3 = NONE(); return g;
        }
        // N22 — an enum's variant name resolves to its payload area:
        // pseudo-field 1 of {tag, payload}, leaf-typed by the variant.
        if n.kind == 12 || n.kind == 13 {
            g = g_declof(g, n.name);
            if g.res2 != NONE() {
                let ed = g.c.r.edecls.buf[u64(g.res2)];
                let voff = u64(ed.vs_off);
                let vlen = u64(ed.vs_len);
                if n.kind == 13 {
                    voff = g.c.r.vars.len;
                    g.c.r = resolve.subst_variants(
                        g.c.r, g.res2, n.b, n.c);
                    if g.c.r.suberr != 0 { voff = u64(ed.vs_off); }
                }
                let vi: u64 = 0;
                while vi < vlen {
                    let vr = g.c.r.vars.buf[voff + vi];
                    if vr.name == fn_ && vr.ty != NONE() {
                        g.pl_ty = vr.ty;
                        g = gpush_f(g, fn_, 1, vr.ty);
                        g.res3 = vr.ty;
                        return g;
                    }
                    vi = vi + 1;
                }
            }
        }
        // struct — the name may sit under guard/mutex.
        let sname: u32 = NONE();
        let sty: u32 = NONE();
        if n.kind == 12 || n.kind == 13 { sname = n.name; sty = g.pl_ty; }
        if n.kind == 21 || n.kind == 22 {
            let n2 = g.c.r.rtys.buf[u64(n.a)];
            if n2.kind == 12 || n2.kind == 13 { sname = n2.name; sty = n.a; }
        }
        if sname == NONE() { g.res3 = NONE(); return g; }
        g = g_sfields(g, sty);
        if g.res == NONE() { g.res3 = NONE(); return g; }
        let f0 = u64(g.res);
        let fend = f0 + u64(g.res2);
        let fi: u64 = f0;
        while fi < fend {
            let sf = g.c.r.sfields.buf[fi];
            if sf.name == fn_ {
                g.pl_ty = sf.ty;
                g = gpush_f(g, fn_, u32(fi - f0), sf.ty);
                g.res3 = sf.ty;
                return g;
            }
            fi = fi + 1;
        }
        g.res3 = NONE();
        return g;
    }
    if k == 8 {                              // base[i]
        g = g_place(g, p, e.a);
        if g.res3 == NONE() { return g; }
        let n = g.c.r.rtys.buf[u64(g.pl_ty)];
        // `s[i]`/`p[i]` on slice|box slice — load the aggregate's
        // .ptr/.len, bounds-check, then index the data pointer.
        let selem: u32 = NONE();
        let mutf: u32 = 0;
        if n.kind == 17 { selem = n.a; mutf = n.b; }
        if n.kind == 25 { selem = n.a; mutf = 1; }
        if selem != NONE() {
            let br_ = g.pl_r; let bv_ = g.pl_val;
            let brt = g.pl_rty;
            let bo = g.pl_off; let bl = g.pl_len;
            // .ptr load → dp (a *mut T / *T reg)
            g.c.r = resolve.mk_un(g.c.r, 16, selem, mutf);
            let pt = g.c.r.res;
            g = g_lit(g, "ptr");
            g = gpush_f(g, g.res, 0, pt);
            g.pl_ty = pt;
            g = gload(g);
            if g.res != OK_REG() {
                g.res3 = NONE(); return g;
            }
            let dp = u32(g.resv);
            while u64(g.pel.len) > u64(bo) + u64(bl) {
                g.pel.pop();
            }
            g.pl_off = bo; g.pl_len = bl;
            // .len load → sl
            g = rty(g, 3);
            let lt2 = g.res;
            g = g_lit(g, "len");
            g = gpush_f(g, g.res, 1, lt2);
            g.pl_ty = lt2;
            g = gload(g);
            let slk = g.res; let slv = g.resv;
            while u64(g.pel.len) > u64(bo) + u64(bl) {
                g.pel.pop();
            }
            // idx — Int literals ride through as immediates, no cast
            g = rty(g, 7);
            let i64t = g.res;
            g = g_infer(g, p, e.b, i64t);
            let it = g.res2;
            let ivk: u32 = 0;
            let ivv: i64 = 0;
            let ie = check.xexp(g.c, p, e.b);
            if check.ek_num(ie.kind) == 0 {
                ivk = OK_IMM(); ivv = ie.w;
            } else {
                g = g_expr(g, p, e.b, it);
                g = g_i64v(g, it, g.res, g.resv);
                ivk = g.res; ivv = g.resv;
            }
            // N46 — a dominating cond that already bounded the
            // index makes the runtime check redundant.
            g = gb_idx(g, p, e.b, e.a, it);
            if g.res == 0 {
                g = gnew_lbl(g, "bcok");
                let okl = g.res;
                g = gnew_lbl(g, "bcbad");
                let badl = g.res;
                g = gfresh(g);
                let c2 = g.res;
                g = e_bin(g, c2, 7, lt2, ivk, ivv, slk, slv);
                g = gseal_br(g, OK_REG(), i64(c2), okl, badl);
                g = gopen(g, badl);
                while g.ax.len > 0 { g.ax.pop(); }
                g.ax = g.ax.push(AX { ty: i64t, k: ivk, v: ivv });
                g.ax = g.ax.push(AX { ty: i64t, k: slk, v: slv });
                g = rty(g, 9);
                g = g_rtcall(g, "mml_bounds_fail", g.res);
                g = gseal_dead(g);
                g = gopen(g, okl);
            }
            // place = *dp[iv] : elem
            g.pl_r = dp; g.pl_val = 1; g.pl_rty = pt;
            g.pl_ty = selem;
            g.pl_off = u32(g.pel.len); g.pl_len = 0;
            g = gpush_i(g, ivk, ivv, i64t);
            g.res3 = selem;
            return g;
        }
        let elem: u32 = NONE();
        if n.kind == 14 { elem = n.a; }
        if n.kind == 21 || n.kind == 22 {
            let n2 = g.c.r.rtys.buf[u64(n.a)];
            if n2.kind == 14 { elem = n2.a; }
        }
        if elem == NONE() { g.res3 = NONE(); return g; }
        g = rty(g, 7);
        g = g_infer(g, p, e.b, g.res);
        let it = g.res2;
        // the index expr's own place evals clobber pl_* — snapshot
        // the base's (Assign's invariant, inside the walker).
        let pr = g.pl_r; let pv = g.pl_val;
        let prt = g.pl_rty; let pt = g.pl_ty;
        let po = g.pl_off; let pl = g.pl_len;
        g = g_expr(g, p, e.b, it);
        let ivk = g.res; let ivv = g.resv;
        g.pl_r = pr; g.pl_val = pv; g.pl_rty = prt;
        g.pl_ty = pt; g.pl_off = po; g.pl_len = pl;
        g.pl_ty = elem;
        g = gpush_i(g, ivk, ivv, it);
        g.res3 = elem;
        return g;
    }
    g.res3 = NONE();
    return g;
}

/// fill_place — a struct literal's fields write straight into the
/// target place (`pl_*`); each field-store extends the base path by
/// one elem, leaf-typed by the field.
fn g_fill(own g: G, read p: ast.Parser, lit: u32) -> G {
    let e = check.xexp(g.c, p, lit);
    let pr = g.pl_r;
    let pv = g.pl_val;
    let prt = g.pl_rty;
    let pt = g.pl_ty;
    let po = g.pl_off;
    let plen0 = g.pl_len;
    g = g_sfields(g, pt);
    if g.res == NONE() { return g; }
    let sf0 = u64(g.res);
    let sfn = u64(g.res2);
    let base = u64(e.b);
    let nt = u64(p.u32s.buf[base]);
    let nf = u64(p.u32s.buf[base + 1 + nt]);
    let i: u64 = 0;
    while i < nf {
        let nm = p.u32s.buf[base + 2 + nt + i * 2];
        let fe = p.u32s.buf[base + 2 + nt + i * 2 + 1];
        g.c.r = resolve.intern_pname(g.c.r, p, nm);
        let fn_ = g.c.r.res;
        let fi: u64 = sf0;
        let fend = fi + sfn;
        let fidx: u32 = NONE();
        let fty: u32 = 9;
        while fi < fend {
            let sf = g.c.r.sfields.buf[fi];
            if sf.name == fn_ {
                fidx = u32(fi - sf0);
                fty = sf.ty;
            }
            fi = fi + 1;
        }
        if fidx != NONE() {
            g = g_expr(g, p, fe, fty);
            let vk = g.res; let vv = g.resv;
            while u64(g.pel.len) > u64(po) + u64(plen0) {
                g.pel.pop();
            }
            g.pl_r = pr; g.pl_val = pv; g.pl_rty = prt;
            g.pl_ty = fty;
            g.pl_off = po; g.pl_len = plen0;
            g = gpush_f(g, fn_, fidx, fty);
            g.pl_ty = fty;
            g = e_store(g, vk, vv);
            g.pl_len = plen0;
        }
        i = i + 1;
    }
    return g;
}

// ---- layout — mirrors size_of_fields / align_of_fields --------------

/// sizeof — resv = bytes.
fn g_sizeof(own g: G, t: u32) -> G {
    let n = g.c.r.rtys.buf[u64(t)];
    if n.kind == 0 || n.kind == 4 || n.kind == 8 {
        g.resv = 1; return g;
    }
    if n.kind == 1 || n.kind == 5 { g.resv = 2; return g; }
    if n.kind == 2 || n.kind == 6 { g.resv = 4; return g; }
    if n.kind == 20 { return g_sizeof(g, n.a); }
    if n.kind == 10 || n.kind == 17 || n.kind == 25 {
        g.resv = 16; return g;
    }
    if n.kind == 14 {
        g = g_sizeof(g, n.a);
        let s = g.resv;
        g = g_alignof(g, n.a);
        let a = g.resv;
        g.resv = (s + a - 1) / a * a * i64(n.w);
        return g;
    }
    if n.kind == 12 || n.kind == 13 {
        return g_layout(g, t);
    }
    g.resv = 8;
    return g;
}
fn g_alignof(own g: G, t: u32) -> G {
    let n = g.c.r.rtys.buf[u64(t)];
    if n.kind == 0 || n.kind == 4 || n.kind == 8 {
        g.resv = 1; return g;
    }
    if n.kind == 1 || n.kind == 5 { g.resv = 2; return g; }
    if n.kind == 2 || n.kind == 6 { g.resv = 4; return g; }
    if n.kind == 20 { return g_alignof(g, n.a); }
    if n.kind == 14 { return g_alignof(g, n.a); }
    if n.kind == 12 || n.kind == 13 {
        return g_maxalign(g, t);
    }
    g.resv = 8;
    return g;
}
/// field range for a struct rty — checker's `sfields_of`: the decl's
/// own fields, or a `subst_fields` clone appended to `r.sfields` for
/// `App<..>` bases. res = `sfields` off | NONE, res2 = count.
fn g_sfields(own g: G, ty: u32) -> G {
    g.res = NONE(); g.res2 = 0;
    let tn = g.c.r.rtys.buf[u64(ty)];
    if tn.kind != 12 && tn.kind != 13 { return g; }
    if u64(tn.name) >= g.c.r.tb_s.len { return g; }
    let si = g.c.r.tb_s.buf[u64(tn.name)];
    if si < 0 { return g; }
    let sd = g.c.r.sdecls.buf[u64(si)];
    if sd.tps_len == 0 {
        g.res = sd.fs_off; g.res2 = sd.fs_len;
        return g;
    }
    if tn.kind != 13 { return g; }           // bare template name
    let f0 = u32(g.c.r.sfields.len);
    g.c.r = resolve.subst_fields(g.c.r, u32(si), tn.b, tn.c);
    if g.c.r.suberr != 0 { return g; }
    g.res = f0; g.res2 = sd.fs_len;
    return g;
}

/// struct/enum decl by ty name nid — res = sdecl idx|NONE,
/// res2 = edecl idx|NONE.
fn g_declof(own g: G, name: u32) -> G {
    let i: u64 = 0;
    g.res = NONE(); g.res2 = NONE();
    while i < g.c.r.sdecls.len {
        if g.c.r.sdecls.buf[i].name == name {
            g.res = u32(i);
        }
        i = i + 1;
    }
    i = 0;
    while i < g.c.r.edecls.len {
        if g.c.r.edecls.buf[i].name == name {
            g.res2 = u32(i);
        }
        i = i + 1;
    }
    return g;
}
/// sizeof a struct ty (fields table) or enum ({i64 tag, [N]u8}).
fn g_layout(own g: G, t: u32) -> G {
    let n = g.c.r.rtys.buf[u64(t)];
    g = g_sfields(g, t);
    if g.res != NONE() {
        let sf0 = u64(g.res);
        let sfn = u64(g.res2);
        let off: i64 = 0;
        let ma: i64 = 1;
        let i: u64 = sf0;
        while i < sf0 + sfn {
            let ft = g.c.r.sfields.buf[i].ty;
            g = g_alignof(g, ft);
            let fa = g.resv;
            if g.resv > ma { ma = g.resv; }
            g = g_sizeof(g, ft);
            off = (off + fa - 1) / fa * fa + g.resv;
            i = i + 1;
        }
        g.resv = (off + ma - 1) / ma * ma;
        return g;
    }
    g = g_declof(g, n.name);
    if g.res2 != NONE() {
        let ed = g.c.r.edecls.buf[u64(g.res2)];
        // instantiated enum — variant tys substitute from targs.
        let voff = u64(ed.vs_off);
        let vlen = u64(ed.vs_len);
        if n.kind == 13 {
            voff = g.c.r.vars.len;
            g.c.r = resolve.subst_variants(g.c.r, g.res2, n.b, n.c);
            if g.c.r.suberr != 0 { voff = u64(ed.vs_off); }
        }
        let mx: i64 = 0;
        let i: u64 = 0;
        while i < vlen {
            let vt = g.c.r.vars.buf[voff + i].ty;
            if vt != NONE() {
                g = g_sizeof(g, vt);
                if g.resv > mx { mx = g.resv; }
            }
            i = i + 1;
        }
        g.resv = 8 + mx;
        return g;
    }
    g.resv = 8;
    return g;
}
fn g_maxalign(own g: G, t: u32) -> G {
    g = g_sfields(g, t);
    if g.res != NONE() {
        let sf0 = u64(g.res);
        let sfn = u64(g.res2);
        let ma: i64 = 1;
        let i: u64 = sf0;
        while i < sf0 + sfn {
            let ft = g.c.r.sfields.buf[i].ty;
            g = g_alignof(g, ft);
            if g.resv > ma { ma = g.resv; }
            i = i + 1;
        }
        g.resv = ma;
        return g;
    }
    g.resv = 8;
    return g;
}

// ---- statements ------------------------------------------------------

fn g_stmts(own g: G, read p: ast.Parser,
           off: u32, len: u32) -> G {
    let i: u64 = u64(off);
    let jn = i + u64(len);
    while i < jn {
        let sid = p.u32s.buf[i];
        // $rv materialization first — the temp lets' instrs precede
        // the owning stmt's (lower.rs splices them before it).
        g = lv_s(g, p, sid, 1);
        g = g_stmt(g, p, sid);
        i = i + 1;
    }
    return g;
}

fn g_stmt(own g: G, read p: ast.Parser, sid: u32) -> G {
    let s = p.stmts.buf[u64(sid)];
    let k = u32(check.sk_num(s.kind));
    if k == 0 {                              // Let
        let t = NONE();
        if s.b != NONE() {
            g.c.r = resolve.cnv_ty(g.c.r, p, s.b);
            t = g.c.r.res;
        } else {
            if s.c != NONE() {
                g = g_infer(g, p, s.c, NONE());
                t = g.res2;
            } else {
                g = rty(g, 9);
                t = g.res;
            }
        }
        g.c.r = resolve.intern_pname(g.c.r, p, s.a);
        let vn = g.c.r.res;
        g = gfresh(g);
        let slot = g.res;
        g = e_local(g, slot, t, vn);
        if s.c != NONE() {
            // struct/enum literal inits fill the slot directly;
            // everything else evals + stores (s0's `match init`).
            g = g_initfill(g, p, slot, t, s.c);
        }
        if g.c.r.rtys.buf[u64(t)].kind == 22 {
            // Guard(T) lets register the slot; a moved guard hands
            // its responsibility to the destination (s0's
            // move-check + open_guards.insert).
            if s.c != NONE() {
                let ie = check.xexp(g.c, p, s.c);
                if check.ek_num(ie.kind) == 2 {
                    g.c.r = resolve.intern_pname(g.c.r, p, ie.a);
                    let svn = g.c.r.res;
                    g = gfind(g, svn);
                    if g.res != NONE()
                        && g.c.r.rtys.buf[u64(g.res3)].kind == 22 {
                        g = og_rel(g, g.res2);
                    }
                }
            }
            g.oguards = g.oguards.push(slot);
        }
        g = gbind(g, vn, slot, t, 0);
        if s.c != NONE() { g = g_letfacts(g, p, slot, t, s.c); }
        return g;
    }
    if k == 1 {                              // Assign
        g = g_place(g, p, s.a);
        if g.res3 != NONE() {
            // expr() may emit loads that reuse the place regs —
            // snapshot the target before evaluating the value.
            let pr = g.pl_r; let pv = g.pl_val;
            let prt = g.pl_rty; let pt = g.pl_ty;
            let po = g.pl_off; let pl = g.pl_len;
            let ve = check.xexp(g.c, p, s.b);
            let filled: u8 = 0;
            if check.ek_num(ve.kind) == 10 {
                // literal → fill the target place directly
                g = g_fill(g, p, s.b);
                filled = 1;
            }
            if filled == 0 {
                // enum-ctor assign → fill the target place in place
                g = g_enumlit_ty(g, p, s.b);
                if g.res2 != NONE() {
                    let eidx = g.res3;
                    g.c.r = resolve.intern_pname(g.c.r, p, ve.b);
                    let vnid = g.c.r.res;
                    let pay: u32 = NONE();
                    if ve.d > 0 { pay = p.u32s.buf[u64(ve.c)]; }
                    g.pl_r = pr; g.pl_val = pv; g.pl_rty = prt;
                    g.pl_ty = pt; g.pl_off = po; g.pl_len = pl;
                    g = g_fillenum(g, p, eidx, vnid, pay, pt);
                    filled = 1;
                }
            }
            if filled == 0 {
                g = g_expr(g, p, s.b, pt);
                let vk = g.res; let vv = g.resv;
                g.pl_r = pr; g.pl_val = pv; g.pl_rty = prt;
                g.pl_ty = pt; g.pl_off = po; g.pl_len = pl;
                g = e_store(g, vk, vv);
            }
            // N46-N48 — the store kills anchored facts; a copy is a
            // fresh equality; `i = (i+1) & mask` re-binds the bound.
            g = g_bkill(g, p, s.a);
            g = g_bkey(g, p, s.a);
            if g.bk != NONE() {
                let t2 = g.bk;
                let tspan: u8 = 0;
                let ptk = g.c.r.rtys.buf[u64(pt)].kind;
                if ptk == 17 || ptk == 25 || ptk == 10 { tspan = 1; }
                g = g_bnorm(g, p, s.b);
                if g.bk != NONE() && g.bk != t2
                    && gb_pref(g, g.bk, t2) == 0 {
                    let pk = g.bk; let po2 = g.bo;
                    g.efacts = g.efacts.push(EF {
                        ak: t2, ao: 0, bk: pk, bo: po2 });
                    if tspan == 1 {
                        g = gb_kdot(g, t2, "len");
                        let a2 = g.res;
                        g = gb_kdot(g, pk, "len");
                        g.efacts = g.efacts.push(EF {
                            ak: a2, ao: 0, bk: g.res, bo: po2 });
                    }
                }
                if check.ek_num(ve.kind) == 5 && ve.a == 13 {
                    g = g_bnorm(g, p, ve.c);
                    if g.bk != NONE() {
                        g = g_and_facts(g, p, t2, 0, g.bk, g.bo,
                                        ve.c);
                    }
                }
            }
        }
        return g;
    }
    if k == 2 {                              // Return
        // every live guard releases on this edge — emitted before
        // the value eval like s0's Return arm; the whole defer stack
        // replays between the value's evaluation and the seal.
        g = g_unlockall(g);
        if g.taskon == 1 {
            // inside a task fn — `return v` stores through the
            // caller's result-cell pointer and jumps to `tend`.
            if s.a != NONE() {
                g = g_expr(g, p, s.a, g.taskrt);
                let vk = g.res; let vv = g.resv;
                g.pl_r = g.taskrp; g.pl_val = 1;
                g.pl_rty = g.taskrt; g.pl_ty = g.taskrt;
                g.pl_off = u32(g.pel.len); g.pl_len = 0;
                g = e_store(g, vk, vv);
            }
            g = g_defer_above(g, p, 0);
            g = gseal_jmp(g, g.taskend);
            return g;
        }
        if s.a == NONE() {
            g = g_defer_above(g, p, 0);
            g = gseal_ret(g, 0, 0, 0, g.ret);
            return g;
        }
        g = g_expr(g, p, s.a, g.ret);
        let vk = g.res; let vv = g.resv;
        g = g_defer_above(g, p, 0);
        g = gseal_ret(g, 1, vk, vv, g.ret);
        return g;
    }
    if k == 3 {                              // If — u32s[s.b..+s.c]:
                                             // nt, then.., haselse, else..
        let base = u64(s.b);
        let nt = u64(p.u32s.buf[base]);
        let haselse = p.u32s.buf[base + 1 + nt];
        g = rty(g, 8);
        g = g_expr(g, p, s.a, g.res);
        let ck = g.res; let cv = g.resv;
        g = gnew_lbl(g, "then");
        let tl = g.res;
        g = gnew_lbl(g, "else");
        let el = g.res;
        g = gnew_lbl(g, "merge");
        let ml = g.res;
        if haselse != 0 {
            g = gseal_br(g, ck, cv, tl, el);
        } else {
            g = gseal_br(g, ck, cv, tl, ml);
        }
        g = gopen(g, tl);
        // N46 — the cond's comparisons dominate the then-block; a
        // dead else leaves `cond` dominating the continuation.
        let bm = u32(g.bfacts.len); let em = u32(g.efacts.len);
        g = g_condf(g, p, s.a);
        g = gpush(g);
        g = g_stmts(g, p, u32(base + 1), u32(nt));
        while g.bfacts.len > u64(bm) { g.bfacts.pop(); }
        while g.efacts.len > u64(em) { g.efacts.pop(); }
        g = gpop(g, p);
        let tdead: u8 = 0;
        if g.term == 1 && g.cur == NONE() { tdead = 1; }
        if g.term == 0 || g.cur != NONE() {
            g = gseal_jmp(g, ml);
        }
        let edead: u8 = 0;
        if haselse != 0 {
            g = gopen(g, el);
            // N48 — the else arm runs under `!cond`.
            let bm2 = u32(g.bfacts.len); let em2 = u32(g.efacts.len);
            g = g_negf(g, p, s.a);
            g = gpush(g);
            g = g_stmts(g, p, u32(base + 2 + nt),
                        u32(u64(s.c) - nt - 2));
            while g.bfacts.len > u64(bm2) { g.bfacts.pop(); }
            while g.efacts.len > u64(em2) { g.efacts.pop(); }
            g = gpop(g, p);
            if g.term == 1 && g.cur == NONE() { edead = 1; }
            if g.term == 0 || g.cur != NONE() {
                g = gseal_jmp(g, ml);
            }
        }
        g = gopen(g, ml);
        if haselse != 0 {
            if edead == 1 { g = g_condf(g, p, s.a); }
        } else {
            // `if !c { diverge }` / `if c { return }` — `!cond`
            // dominates everything after (the guard/assert idiom).
            if tdead == 1 { g = g_negf(g, p, s.a); }
        }
        return g;
    }
    if k == 4 {                              // While — u32s[s.b..+s.c]
        g = gnew_lbl(g, "cond");
        let cl = g.res;
        g = gnew_lbl(g, "body");
        let bl = g.res;
        g = gnew_lbl(g, "after");
        let al = g.res;
        g = gseal_jmp(g, cl);
        g = gopen(g, cl);
        g = rty(g, 8);
        g = g_expr(g, p, s.a, g.res);
        let ck = g.res; let cv = g.resv;
        g = gseal_br(g, ck, cv, bl, al);
        g.loops = g.loops.push(Lp {
            brk: al, cnt: bl, cond: s.a,
            depth: u32(g.frame.len) });
        g = gopen(g, bl);
        // N46 — the loop test dominates the body (`while i < s.len`
        // proves `s[i]` in range); the facts die at `after`.
        let bm = u32(g.bfacts.len); let em = u32(g.efacts.len);
        g = g_condf(g, p, s.a);
        g = gpush(g);
        g = g_stmts(g, p, s.b, s.c);
        g = gpop(g, p);
        g.loops.pop();
        if g.term == 0 || g.cur != NONE() {
            // back-edge — the cond's $rv temps re-materialize at body
            // end (the lowering appended their lets there), then the
            // cond re-tests under the END-OF-BODY fact state.
            g = lv_e(g, p, s.a, 1);
            g = rty(g, 8);
            g = g_expr(g, p, s.a, g.res);
            let c2k = g.res; let c2v = g.resv;
            g = gseal_br(g, c2k, c2v, bl, al);
        }
        while g.bfacts.len > u64(bm) { g.bfacts.pop(); }
        while g.efacts.len > u64(em) { g.efacts.pop(); }
        g = gopen(g, al);
        return g;
    }
    if k == 5 || k == 6 {                    // Break | Continue
        let lp = g.loops.buf[g.loops.len - 1];
        let gbase = u64(g.frame.buf[u64(lp.depth)]);
        // N54 — defers of the scopes this exit unwinds replay on the
        // edge, while their names still resolve.
        g = g_defer_above(g, p, lp.depth);
        // guards bound at or above the loop's entry depth release on
        // this edge; they STAY in the set — the scope's own pop
        // removes them (s0's env[depth..] unlock loop).
        g = g_unlockdeep(g, gbase);
        if k == 5 {
            g = gseal_jmp(g, lp.brk);
            return g;
        }
        // re-test under the entry-edge env — scopes opened inside the
        // loop swap out while the cond lowers, then restore (s0's
        // split_off/extend on `depth`).
        let base = gbase;
        let keep = vec.Vec<Slot>::new(g.heap);
        while u64(g.slots.len) > base {
            keep = keep.push(g.slots.buf[g.slots.len - 1]);
            g.slots.pop();
        }
        g = rty(g, 8);
        g = g_expr(g, p, lp.cond, g.res);
        let ck = g.res; let cv = g.resv;
        let i = keep.len;
        while i > 0 {
            i = i - 1;
            g.slots = g.slots.push(keep.buf[i]);
        }
        keep.destroy();
        g = gseal_br(g, ck, cv, lp.cnt, lp.brk);
        return g;
    }
    if k == 9 {                              // Region — scope only
        g = gpush(g);
        g = g_stmts(g, p, s.b, s.c);
        g = gpop(g, p);
        return g;
    }
    if k == 7 {                              // Expr
        g = g_expr(g, p, s.a, NONE());
        return g;
    }
    if k == 10 {                             // Promote — mark the name
        let te = check.xexp(g.c, p, s.a);
        if check.ek_num(te.kind) == 2 {
            g.c.r = resolve.intern_pname(g.c.r, p, te.a);
            if vhas2(g.promo, g.c.r.res) == 0 {
                g.promo = g.promo.push(g.c.r.res);
            }
        }
        return g;
    }
    if k == 8 {                              // Match — stmt position
        g = g_match(g, p, s.a, s.b, s.c, s.line, s.col, NONE());
        return g;
    }
    if k == 12 {                             // Defer — register only;
        g.dlist = g.dlist.push(s.a);         // each exit edge replays
        return g;
    }
    // Consume(11) emits nothing.
    return g;
}

// ---- fn / module -----------------------------------------------------

/// one fn — header + entry block + param prologue + body + implicit
/// fallthrough ret. `fd` = resolved fdecl; `p`/`bo`/`bl` = the
/// body-owning parser + `u32s` stmt range (a clone's template may
/// live in another module).
fn g_fn(own g: G, read p: ast.Parser, fd: resolve.FDecl,
        bo: u32, bl: u32, ctp: u32, cins: u32) -> G {
    g.nxt = 0;
    g.nlbl = 0;
    g.cur = NONE(); g.term = 0; g.put = 0;
    g.ret = fd.ret;
    g.tfname = fd.name;
    g.tseq = 0;
    g.taskon = 0;
    g.cur_tp = ctp; g.cur_ins = cins;
    while g.tasks.len > 0 { g.tasks.pop(); }
    while g.slots.len > 0 { g.slots.pop(); }
    while g.frame.len > 0 { g.frame.pop(); }
    while g.loops.len > 0 { g.loops.pop(); }
    while g.promo.len > 0 { g.promo.pop(); }
    while g.rvm.len > 0 { g.rvm.pop(); }
    while g.oguards.len > 0 { g.oguards.pop(); }
    while g.dmark.len > 0 { g.dmark.pop(); }
    while g.dlist.len > 0 { g.dlist.pop(); }
    while g.bfacts.len > 0 { g.bfacts.pop(); }
    while g.efacts.len > 0 { g.efacts.pop(); }
    g = gpush(g);
    // N74 record head — params/blocks ranges start here.
    let fpo = u32(g.irpa.len);
    let fao = u32(g.irar.len);
    let fbo = u32(g.irb.len) / 8;
    let pi0: u64 = 0;
    while pi0 < u64(fd.ps_len) {
        let pr0 = g.c.r.params.buf[u64(fd.ps_off) + pi0];
        g.irpa = g.irpa.push(pr0.name);
        g.irpa = g.irpa.push(u32(pr0.auth));
        g.irpa = g.irpa.push(pr0.ty);
        pi0 = pi0 + 1;
    }
    // header — `fn name(a: t, own b: t2) -> r:`
    g.fnb = resolve.bputs(g.fnb, "fn ");
    g.fnb = rname(g.fnb, g.c.r, fd.name);
    g.fnb = g.fnb.push(u8(40));
    let i: u64 = 0;
    while i < u64(fd.ps_len) {
        if i > 0 { g.fnb = resolve.bputs(g.fnb, ", "); }
        let pr = g.c.r.params.buf[u64(fd.ps_off) + i];
        if pr.auth == 1 { g.fnb = resolve.bputs(g.fnb, "read "); }
        if pr.auth == 2 { g.fnb = resolve.bputs(g.fnb, "write "); }
        if pr.auth == 3 { g.fnb = resolve.bputs(g.fnb, "own "); }
        g.fnb = rname(g.fnb, g.c.r, pr.name);
        g.fnb = resolve.bputs(g.fnb, ": ");
        g.fnb = gty(g.fnb, g.c.r, pr.ty);
        i = i + 1;
    }
    g.fnb = resolve.bputs(g.fnb, ") -> ");
    g.fnb = gty(g.fnb, g.c.r, fd.ret);
    g.fnb = resolve.bputs(g.fnb, ":\n");
    // entry label
    let off = u32(g.lbyt.len);
    g.lbyt = resolve.bputs(g.lbyt, "entry");
    g.lbls = g.lbls.push(loader.Span2 { off: off, len: 5 });
    g = gopen(g, u32(g.lbls.len) - 1);
    // params — arg/local/store (capability params alias instead)
    i = 0;
    while i < u64(fd.ps_len) {
        let pr = g.c.r.params.buf[u64(fd.ps_off) + i];
        g = gfresh(g);
        let inc = g.res;
        if pr.auth == 1 || pr.auth == 2 {
            g = rty_ref(g, pr.ty, u32(pr.auth) - 1);
            g = e_arg(g, inc, g.res, u32(i));
            g = gbind(g, pr.name, inc, pr.ty, 1);
            i = i + 1;
            continue;
        }
        g = e_arg(g, inc, pr.ty, u32(i));
        g = gfresh(g);
        let slot = g.res;
        g = e_local(g, slot, pr.ty, pr.name);
        g.pl_r = slot; g.pl_val = 0; g.pl_rty = pr.ty; g.pl_ty = pr.ty;
        g.pl_off = u32(g.pel.len); g.pl_len = 0;
        g = e_store(g, OK_REG(), i64(i32(inc)));
        g = gbind(g, pr.name, slot, pr.ty, 0);
        i = i + 1;
    }
    g = g_stmts(g, p, bo, bl);
    // implicit fallthrough — a typed zero when the fn returns
    // non-void. Top-scope defers replay here (defer band); open
    // guards release — fn end is their scope's death.
    if g.term == 0 || g.cur != NONE() {
        g = g_defer_above(g, p, 0);
        g = g_unlockall(g);
        let rk = g.c.r.rtys.buf[u64(g.ret)].kind;
        if rk == 9 {
            g = gseal_ret(g, 0, 0, 0, g.ret);
        } else {
            g = gconst(g, g.ret, 0);
            let vk = g.res; let vv = g.resv;
            g = gseal_ret(g, 1, vk, vv, g.ret);
        }
    }
    g.ftx = resolve.bpush(g.ftx, g.fnb.as_slice());
    while g.fnb.len > 0 { g.fnb.pop(); }
    // N74 record tail — the fn closes over its param/arg/block ranges.
    g.irf = g.irf.push(fd.name);
    g.irf = g.irf.push(fd.ret);
    g.irf = g.irf.push(fpo);
    g.irf = g.irf.push(u32(g.irpa.len) / 3 - fpo / 3);
    g.irf = g.irf.push(fao);
    g.irf = g.irf.push(u32(g.irar.len) - fao);
    g.irf = g.irf.push(fbo);
    g.irf = g.irf.push(u32(g.irb.len) / 8 - fbo);
    // lbls/lbyt stay — label text is shared storage, not fn-local.
    g = gpop(g, p);
    return g;
}

/// module — Stage-0's `for f in &p.fns` (templates skipped, externs
/// split) with mono's clones appended, dedup'd by name across the
/// merged module.
pub fn module(own g: G, read p: ast.Parser,
              read l: loader.Loader, prog: u32, fb: u32) -> G {
    g.c.who = prog;
    g.c.fbase = fb;
    g.c.cur_fn = NONE();
    // same module context the checker re-establishes — cnv_ty's
    // qualifier and the dep-visibility table for sig lookups.
    g.c.r = resolve.set_qual(g.c.r, l, p, prog);
    while g.c.vprogs.len > 0 { g.c.vprogs.pop(); }
    g.c.vprogs = g.c.vprogs.push(prog);
    let d0: u32 = 0;
    let dn: u32 = 0;
    if prog == u32(l.progs.len) {
        d0 = l.res2; dn = l.res3;
    } else {
        let mp = l.mods.buf[u64(prog)];
        d0 = mp.deps_off; dn = mp.deps_len;
    }
    let di: u64 = 0;
    while di < u64(dn) {
        let dnid = l.darena.buf[u64(d0) + di];
        let mi2: u64 = 0;
        while mi2 < l.mods.len {
            if l.mods.buf[mi2].name == dnid {
                g.c.vprogs = g.c.vprogs.push(u32(mi2));
            }
            mi2 = mi2 + 1;
        }
        di = di + 1;
    }
    // struct decls — own module only, non-generic.
    let i: u64 = 0;
    while i < p.structs.len {
        let sd = p.structs.buf[i];
        i = i + 1;
        if sd.tps_len != 0 { continue; }
        g.c.r = resolve.intern_pname(g.c.r, p, sd.name);
        let sn = g.c.r.res;
        if g.c.r.qual != NONE() {              // dep decls qualify
            g.c.r = resolve.qual_for(g.c.r, g.c.r.qual, sn);
            sn = g.c.r.res;
        }
        let sdi = NONE();
        let j: u64 = 0;
        while j < g.c.r.sdecls.len {
            let rd = g.c.r.sdecls.buf[j];
            if rd.name == sn && rd.prog == prog
                && rd.tps_len == 0 { sdi = u32(j); }
            j = j + 1;
        }
        if sdi == NONE() { continue; }
        let rd2 = g.c.r.sdecls.buf[u64(sdi)];
        if vhas2(g.seen_s, rd2.name) == 1 { continue; }
        g.seen_s = g.seen_s.push(rd2.name);
        let sfo = u32(g.irsf.len);
        g.stx = resolve.bputs(g.stx, "struct ");
        g.stx = rname(g.stx, g.c.r, rd2.name);
        g.stx = resolve.bputs(g.stx, " { ");
        let q: u64 = 0;
        while q < u64(rd2.fs_len) {
            if q > 0 { g.stx = resolve.bputs(g.stx, ", "); }
            let sf = g.c.r.sfields.buf[u64(rd2.fs_off) + q];
            g.stx = rname(g.stx, g.c.r, sf.name);
            g.stx = resolve.bputs(g.stx, ": ");
            g.stx = gty(g.stx, g.c.r, sf.ty);
            g.irsf = g.irsf.push(sf.name);
            g.irsf = g.irsf.push(sf.ty);
            q = q + 1;
        }
        g.stx = resolve.bputs(g.stx, " }\n");
        g.irst = g.irst.push(rd2.name);
        g.irst = g.irst.push(sfo);
        g.irst = g.irst.push(u32(g.irsf.len) / 2 - sfo / 2);
    }
    // concrete generic structs — the module's own clone decls in
    // s0-mono append order: `r.isdecls` carries the winning want's
    // round-scan rank (lvl, shi, slo); sort per module by it.
    // Cross-module dedup rides `seen_i` on the canon'd App tyid (mk2
    // interns, so identical canons share it). Enum insts collect
    // into `ers`/`eik` — they sort into the enum pseudo-layout pass
    // by name, not append order.
    let eik = vec.Vec<u8>::new(g.heap);
    let ers = vec.Vec<ER>::new(g.heap);
    let ids = vec.Vec<u32>::new(g.heap);
    i = 0;
    while i < g.c.r.isdecls.len {
        let isi = g.c.r.isdecls.buf[i];
        if isi.who == prog {
            // insertion-sort `ids` by (lvl, shi, slo)
            let j = ids.len;
            ids = ids.push(u32(i));
            while j > 0 {
                let a2 = g.c.r.isdecls.buf[u64(ids.buf[j - 1])];
                if a2.lvl < isi.lvl
                    || (a2.lvl == isi.lvl && a2.shi < isi.shi)
                    || (a2.lvl == isi.lvl && a2.shi == isi.shi
                        && a2.slo <= isi.slo) {
                    break;
                }
                ids.buf[j] = ids.buf[j - 1];
                j = j - 1;
            }
            ids.buf[j] = u32(i);
        }
        i = i + 1;
    }
    let idk: u64 = 0;
    while idk < ids.len {
        let isi = g.c.r.isdecls.buf[u64(ids.buf[idk])];
        idk = idk + 1;
        let tn0 = g.c.r.rtys.buf[u64(isi.ty)];
        g.c.r = resolve.canon_nid(g.c.r, tn0.name, tn0.b, tn0.c);
        if vhas2(g.seen_i, g.c.r.res) == 1 { continue; }
        g.seen_i = g.seen_i.push(g.c.r.res);
        let tn = g.c.r.rtys.buf[u64(isi.ty)];
        let gi = resolve.gdecl_at(g.c.r, tn.name);
        if gi < 0 { continue; }
        let gd = g.c.r.gdecls.buf[u64(gi)];
        if gd.kind == 2 {                     // enum inst → pseudo-layout
            let kk = resolve.canon_push(
                vec.Vec<u8>::new(g.heap), g.c.r,
                tn.name, tn.b, tn.c);
            let eoff = u32(eik.len);
            let kq2: u64 = 0;
            while kq2 < kk.len {
                eik = eik.push(kk.buf[kq2]);
                kq2 = kq2 + 1;
            }
            ers = ers.push(ER { off: eoff, len: u32(kk.len),
                ei: gd.idx, tb: tn.b, tl: tn.c });
            kk.destroy();
            continue;
        }
        if gd.kind != 1 { continue; }         // fns inst separately
        let kk = resolve.canon_push(
            vec.Vec<u8>::new(g.heap), g.c.r,
            tn.name, tn.b, tn.c);
        g.c.r = resolve.canon_nid(g.c.r, tn.name, tn.b, tn.c);
        let kn = g.c.r.res;
        g.c.r = resolve.subst_fields(g.c.r, gd.idx, tn.b, tn.c);
        if g.c.r.suberr != 0 { kk.destroy(); continue; }
        let f0 = u64(g.c.r.sfields.len) - u64(g.c.r.sdecls.buf[u64(gd.idx)].fs_len);
        let fcnt = u64(g.c.r.sdecls.buf[u64(gd.idx)].fs_len);
        let sfo = u32(g.irsf.len);
        g.stx = resolve.bputs(g.stx, "struct ");
        g.stx = resolve.bpush(g.stx, kk.as_slice());
        kk.destroy();
        g.stx = resolve.bputs(g.stx, " { ");
        let q: u64 = 0;
        while q < fcnt {
            if q > 0 { g.stx = resolve.bputs(g.stx, ", "); }
            let sf = g.c.r.sfields.buf[f0 + q];
            g.stx = rname(g.stx, g.c.r, sf.name);
            g.stx = resolve.bputs(g.stx, ": ");
            g.stx = gty(g.stx, g.c.r, sf.ty);
            g.irsf = g.irsf.push(sf.name);
            g.irsf = g.irsf.push(sf.ty);
            q = q + 1;
        }
        g.stx = resolve.bputs(g.stx, " }\n");
        g.irst = g.irst.push(kn);
        g.irst = g.irst.push(sfo);
        g.irst = g.irst.push(u32(g.irsf.len) / 2 - sfo / 2);
    }
    ids.destroy();
    // enum pseudo-layouts — {tag:i64, payload:[N]u8} sorted by name
    // (N22; imports join the module's enum table like Stage-0).
    // Plain decls and concrete insts share the one name sort.
    i = 0;
    while i < g.c.r.edecls.len {
        let ed = g.c.r.edecls.buf[i];
        i = i + 1;
        if ed.tps_len != 0 { continue; }
        if ed.prog != prog
            && (ed.pub_ == 0 || vhas2(g.c.vprogs, ed.prog) == 0) {
            continue;
        }
        if vhas2(g.seen_s, ed.name) == 1 { continue; }
        let sp = g.c.r.rns.buf[u64(ed.name)];
        let eoff = u32(eik.len);
        let w: u64 = 0;
        while w < u64(sp.len) {
            eik = eik.push(g.c.r.rbyt.buf[u64(sp.off) + w]);
            w = w + 1;
        }
        ers = ers.push(ER { off: eoff, len: u32(sp.len),
            ei: u32(i) - 1, tb: NONE(), tl: 0 });
    }
    // insertion-sort by name text — deterministic decl order.
    i = 1;
    while i < ers.len {
        let x = ers.buf[i];
        let j = i;
        while j > 0 {
            let y = ers.buf[j - 1];
            if eb_less(eik, x.off, x.len, y.off, y.len) == 1 {
                ers.buf[j] = y; j = j - 1;
            } else { break; }
        }
        ers.buf[j] = x;
        i = i + 1;
    }
    i = 0;
    while i < ers.len {
        let r = ers.buf[i];
        i = i + 1;
        let ed = g.c.r.edecls.buf[u64(r.ei)];
        let voff = u64(ed.vs_off);
        let vlen = u64(ed.vs_len);
        if r.tl > 0 {
            voff = g.c.r.vars.len;
            g.c.r = resolve.subst_variants(g.c.r, r.ei, r.tb, r.tl);
            if g.c.r.suberr != 0 { voff = u64(ed.vs_off); }
        }
        // N = widest payload; pseudo-layout = {i64 tag, [N x i8]}
        let mx: i64 = 0;
        let q: u64 = 0;
        while q < vlen {
            let vt = g.c.r.vars.buf[voff + q].ty;
            if vt != NONE() {
                g = g_sizeof(g, vt);
                if g.resv > mx { mx = g.resv; }
            }
            q = q + 1;
        }
        if r.tb == NONE() {
            g.seen_s = g.seen_s.push(ed.name);
        }
        g.stx = resolve.bputs(g.stx, "struct ");
        let w2: u64 = 0;
        while w2 < u64(r.len) {
            g.stx = g.stx.push(eik.buf[u64(r.off) + w2]);
            w2 = w2 + 1;
        }
        g.stx = resolve.bputs(g.stx, " { tag: i64, payload: [");
        g.stx = resolve.bu32(g.stx, u64(mx));
        g.stx = resolve.bputs(g.stx, "]u8 }\n");
        // N74 — s0's StructDef{name,[(tag,i64),(payload,[N x u8])]}.
        let enid: u32 = ed.name;
        if r.tb != NONE() {
            g.c.r = resolve.canon_nid(g.c.r, ed.name, r.tb, r.tl);
            enid = g.c.r.res;
        }
        let sfo = u32(g.irsf.len);
        g = g_lit(g, "tag");
        g.irsf = g.irsf.push(g.res);
        g = rty(g, 7);
        g.irsf = g.irsf.push(g.res);
        g = g_lit(g, "payload");
        g.irsf = g.irsf.push(g.res);
        g = rty(g, 0);
        g.c.r = resolve.mk_arr(g.c.r, g.res, u64(mx));
        g.irsf = g.irsf.push(g.c.r.res);
        g.irst = g.irst.push(enid);
        g.irst = g.irst.push(sfo);
        g.irst = g.irst.push(u32(2));
    }
    eik.destroy();
    ers.destroy();
    // fn bodies — parser fns (concrete) then this module's clones,
    // in inst order; externs go to the extern section.
    i = 0;
    while i < p.fns.len {
        let f = p.fns.buf[i];
        let fd = g.c.r.fdecls.buf[u64(fb) + i];
        i = i + 1;
        if f.tps_len != 0 { continue; }
        if fd.ext == 1 {
            if vhas2(g.seen_e, fd.name) == 0 {
                g.seen_e = g.seen_e.push(fd.name);
                g = g_extern(g, fd);
            }
            continue;
        }
        if vhas2(g.seen_f, fd.name) == 1 { continue; }
        g.seen_f = g.seen_f.push(fd.name);
        g.c.cur_fn = fd.name;
        g.inclone = 0;
        g = g_fn(g, p, fd, f.body_off, f.body_len, NONE(), NONE());
        // this fn's spawns queue for the module-level LIFO drain.
        let ti: u64 = 0;
        while ti < g.tasks.len {
            g.pending = g.pending.push(g.tasks.buf[ti]);
            ti = ti + 1;
        }
    }
    // clones append in inst order; each one's $rv names rebase onto a
    // running base — Stage-0's lower numbers clone bodies in p.fns
    // append order right after the parser fns' seqs.
    let rbase = u32(g.c.rv_names.len);
    i = 0;
    while i < g.c.r.insts.len {
        let ins = g.c.r.insts.buf[i];
        i = i + 1;
        if ins.req != prog { continue; }
        if ins.ext == 1 {
            if vhas2(g.seen_e, ins.name) == 0 {
                g.seen_e = g.seen_e.push(ins.name);
                g = g_extern_i(g, ins);
            }
            continue;
        }
        // this clone's base — the checker's own `inst_rvlen` counts
        // its template-body temps exactly like check.module's rbv.
        let base = rbase;
        g.c = check.inst_rvlen(g.c, p, l, prog, u32(i) - 1);
        rbase = rbase + u32(g.c.res);
        if vhas2(g.seen_f, ins.name) == 1 { continue; }
        g.seen_f = g.seen_f.push(ins.name);
        g.c.cur_fn = ins.name;
        // clone env: cmap = T->args subst, qual = the TEMPLATE's
        // module — same toggle the checker uses for check_inst.
        g.c = check.inst_env_on(g.c, p, l, prog, ins);
        // the clone's body = its template's, in the template's parser
        if ins.tp == prog {
            let tf = p.fns.buf[u64(ins.tidx)];
            g = g_fn_i(g, p, ins, tf.body_off, tf.body_len, base,
                       u32(i) - 1);
        } else {
            let tf = l.progs.buf[u64(ins.tp)].fns.buf[u64(ins.tidx)];
            g = g_fn_i(g, l.progs.buf[u64(ins.tp)], ins,
                       tf.body_off, tf.body_len, base, u32(i) - 1);
        }
        g.c = check.inst_env_off(g.c, p, l, prog);
        let ti: u64 = 0;
        while ti < g.tasks.len {
            g.pending = g.pending.push(g.tasks.buf[ti]);
            ti = ti + 1;
        }
    }
    // synthesized task fns may themselves spawn — drain to fixpoint
    // (s0's `while let Some(spec) = pending.pop()` — LIFO order).
    while g.pending.len > 0 {
        let ts = g.pending.buf[g.pending.len - 1];
        g.pending.pop();
        while g.tasks.len > 0 { g.tasks.pop(); }
        if ts.ins != NONE() {
            let ins2 = g.c.r.insts.buf[u64(ts.ins)];
            g.c = check.inst_env_on(g.c, p, l, prog, ins2);
        }
        if ts.tp == NONE() || ts.tp == prog {
            g = g_task(g, p, ts);
        } else {
            g = g_task(g, l.progs.buf[u64(ts.tp)], ts);
        }
        if ts.ins != NONE() {
            g.c = check.inst_env_off(g.c, p, l, prog);
        }
        let ti: u64 = 0;
        while ti < g.tasks.len {
            g.pending = g.pending.push(g.tasks.buf[ti]);
            ti = ti + 1;
        }
    }
    return g;
}

fn g_extern(own g: G, fd: resolve.FDecl) -> G {
    let xo = u32(g.irpa.len);
    g.etx = resolve.bputs(g.etx, "extern ");
    g.etx = rname(g.etx, g.c.r, fd.name);
    g.etx = g.etx.push(u8(40));
    let i: u64 = 0;
    while i < u64(fd.ps_len) {
        if i > 0 { g.etx = resolve.bputs(g.etx, ", "); }
        let pr = g.c.r.params.buf[u64(fd.ps_off) + i];
        g.etx = gty(g.etx, g.c.r, pr.ty);
        g.irpa = g.irpa.push(pr.name);
        g.irpa = g.irpa.push(u32(0));
        g.irpa = g.irpa.push(pr.ty);
        i = i + 1;
    }
    g.etx = resolve.bputs(g.etx, ") -> ");
    g.etx = gty(g.etx, g.c.r, fd.ret);
    g.etx = g.etx.push(u8(10));
    g.irx = g.irx.push(fd.name);
    g.irx = g.irx.push(fd.ret);
    g.irx = g.irx.push(xo);
    g.irx = g.irx.push(u32(g.irpa.len) / 3 - xo / 3);
    return g;
}
/// extern from an inst's sig slice (params live in r.params too).
fn g_extern_i(own g: G, ins: resolve.Inst) -> G {
    let xo = u32(g.irpa.len);
    g.etx = resolve.bputs(g.etx, "extern ");
    g.etx = rname(g.etx, g.c.r, ins.name);
    g.etx = g.etx.push(u8(40));
    let i: u64 = 0;
    while i < u64(ins.ps_len) {
        if i > 0 { g.etx = resolve.bputs(g.etx, ", "); }
        let pr = g.c.r.params.buf[u64(ins.ps_off) + i];
        g.etx = gty(g.etx, g.c.r, pr.ty);
        g.irpa = g.irpa.push(pr.name);
        g.irpa = g.irpa.push(u32(0));
        g.irpa = g.irpa.push(pr.ty);
        i = i + 1;
    }
    g.etx = resolve.bputs(g.etx, ") -> ");
    g.etx = gty(g.etx, g.c.r, ins.ret);
    g.etx = g.etx.push(u8(10));
    g.irx = g.irx.push(ins.name);
    g.irx = g.irx.push(ins.ret);
    g.irx = g.irx.push(xo);
    g.irx = g.irx.push(u32(g.irpa.len) / 3 - xo / 3);
    return g;
}
/// fn from an inst's sig — header reads ins.params/ins.ret, body is
/// the template's. `base` = the clone's $rv base (insts-order).
fn g_fn_i(own g: G, read p: ast.Parser, ins: resolve.Inst,
          bo: u32, bl: u32, base: u32, insi: u32) -> G {
    // the clone's $rv facts — the checker's own body scan assigns
    // local seqs under the inst env; rebase onto `base` like
    // check_inst does before the body lowers.
    g.c = check.rv_scan_body(g.c, p, bo, bl, ins.ret);
    let i: u64 = 0;
    while i < g.c.rv_names.len {
        let e2 = g.c.rv_names.buf[i];
        g.c.rv_names.buf[i] = check.KK { k: e2.k, v: e2.v + base };
        i = i + 1;
    }
    g.inclone = 1;
    let fd = resolve.FDecl {
        name: ins.name, pub_: ins.pub_, ext: ins.ext,
        line: ins.line, col: ins.col,
        tps_off: 0, tps_len: 0,
        ps_off: ins.ps_off, ps_len: ins.ps_len,
        ret: ins.ret, prog: ins.req, idx: ins.tidx };
    return g_fn(g, p, fd, bo, bl, ins.tp, insi);
}

/// name-text less-than for the enum pseudo-struct sort.
fn nm_less(read r: resolve.Resolver, a: u32, b: u32) -> u8 {
    let sa = r.rns.buf[u64(a)];
    let sb = r.rns.buf[u64(b)];
    let i: u64 = 0;
    while i < u64(sa.len) && i < u64(sb.len) {
        let x = r.rbyt.buf[u64(sa.off) + i];
        let y = r.rbyt.buf[u64(sb.off) + i];
        if x != y { if x < y { return 1; } return 0; }
        i = i + 1;
    }
    if u64(sa.len) < u64(sb.len) { return 1; }
    return 0;
}
