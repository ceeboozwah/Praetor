//! selfhost.ir — own-IR lowering (N73). AST → the canonical
//! struct/extern/fn text `--dump-ir` prints, consuming the
//! resolver's products (rtys, fdecls, insts, cres) exactly like
//! Stage-0's `ir::gen` consumes `p` + the module interface.
//!
//! Streaming model: `Display` order == generation order, so fn
//! text emits directly — reg/label counters, env scopes, and the
//! loop stack are the only fn-local state. Opnds/Places ride the
//! scratch registers like the checker's (res = kind, resv = value).

import std.vec;
import lexer;
import ast;
import loader;
import resolve;
import check;

extern fn mml_fd_write(fd: i32, buf: *const void, n: u64) -> i64;
fn dbgp(s: str) {
    let i: u64 = 0;
    while i < s.len {
        let w = mml_fd_write(2, &s.bytes[i], 1);
        if w <= 0 { return; }
        i = i + 1;
    }
}

fn dbgp_num(n: u64) {
    if n >= 10 { dbgp_num(n / 10); }
    let d = u8(n % 10) + u8(48);
    let w = mml_fd_write(2, &d, 1);
}

pub fn NONE() -> u32 { return 0xFFFFFFFF; }

// opnd kinds
fn OK_REG() -> u32 { return 0; }
fn OK_IMM() -> u32 { return 1; }
fn OK_FUN() -> u32 { return 2; }

/// env binding — name nid -> (root reg, ty, is_alias). Capability
/// params and storage captures bind as aliases: the reg IS the
/// place's root (`PRoot::Val`), no slot, no copy.
pub struct Slot { n: u32, r: u32, ty: u32, al: u8 }

/// loop frame — (break label, continue target = body label,
/// cond eid, env depth at loop entry).
pub struct Lp { brk: u32, cnt: u32, cond: u32, depth: u32 }
/// task capture — (name nid, ty, ptr-class flag).
pub struct TCap { n: u32, ty: u32, pc: u8 }
/// synthesized task fn spec — (name nid, body u32s range, ret ty,
/// capture range in `tcaps`, template prog idx|NONE, insts idx|NONE).
pub struct TSpec { name: u32, bo: u32, bl: u32, ret: u32,
                   coff: u32, clen: u32, tp: u32, ins: u32,
                   cfn: u32, cwho: u32 }

/// place path elem — Field (kind 0: name nid, struct idx, ty) or
/// Index (kind 1+OK_*: index opnd + elem ty). Lives in `g.pel`; a
/// place is a (root, path range).
pub struct PE { kind: u8, name: u32, idx: u32, ty: u32, ok: u8, ov: i64 }

/// staged call arg — (ty, opnd kind, opnd val).
pub struct AX { ty: u32, k: u32, v: i64 }

/// enum pseudo-layout entry — name bytes live in an arena
/// (off/len); `tb..tl` NONE/0 means the decl's own variant range,
/// else a subst_variants range for an instantiated decl.
pub struct ER { off: u32, len: u32, ei: u32, tb: u32, tl: u32 }

/// N46 bound fact — `lo <[/<=] hi` under a dominating cond. Keys are
/// interned byte strings in `g.bkbyt`/`g.bks` (s0's `String`s).
pub struct BF { lo_k: u32, lo_o: i64, hi_k: u32, hi_o: i64, strict: u8 }
/// (key-id, off) affine pair — `reps()` results.
pub struct KP { k: u32, o: i64 }
/// N47 value-equality fact — `a ≡ b`.
pub struct EF { ak: u32, ao: i64, bk: u32, bo: i64 }

pub struct G {
    heap: alloc,
    c: check.Checker,
    // output sections — structs, externs, fns print in that order
    stx: vec.Vec<u8>, etx: vec.Vec<u8>, ftx: vec.Vec<u8>,
    seen_s: vec.Vec<u32>, seen_f: vec.Vec<u32>, seen_e: vec.Vec<u32>,
    seen_i: vec.Vec<u32>,           // emitted inst-decl App tyids
    // interned string-literal table (StrAddr idx) — (off,len) into sbyt
    strings: vec.Vec<loader.Span2>, sbyt: vec.Vec<u8>,
    // fn-local
    fnb: vec.Vec<u8>,
    nxt: u32, nlbl: u32,
    lbyt: vec.Vec<u8>, lbls: vec.Vec<loader.Span2>,
    cur: u32,                          // open block's label | NONE
    term: u8,                          // current block sealed
    put: u8,                           // label line printed
    slots: vec.Vec<Slot>,              // flat env stack
    frame: vec.Vec<u32>,               // per-scope start into slots
    promo: vec.Vec<u32>,               // `promote`'d name nids
    loops: vec.Vec<Lp>,
    pel: vec.Vec<PE>,                  // path-elem arena
    ax: vec.Vec<AX>,                   // call-arg scratch
    rvm: vec.Vec<check.KK>,            // eid -> $rvN nid (live temps)
    rvnc: vec.Vec<check.KK>,           // clone body: eid -> abs seq
    oguards: vec.Vec<u32>,             // live guard slots (s0 open_guards)
    dmark: vec.Vec<u32>,               // per-scope defer start in dlist
    dlist: vec.Vec<u32>,               // flat defer eid stack (s0 defers)
    tseq: u32,                         // per-fn spawn counter
    tfname: u32,                       // enclosing fn name nid | NONE
    cur_tp: u32,                       // template prog idx | NONE (root p)
    cur_ins: u32,                      // insts idx | NONE (plain fn)
    tasks: vec.Vec<TSpec>,             // spawns seen in THIS fn
    tcaps: vec.Vec<TCap>,              // capture arena for TSpec
    pending: vec.Vec<TSpec>,           // module drain queue (LIFO)
    taskon: u8,                        // inside a task fn
    taskend: u32, taskrp: u32, taskrt: u32,
    srtl: vec.Vec<check.KK>,           // srt_walk's spawn-local ty overlay
    fbnd: vec.Vec<u32>,                // fv walk — bound names
    fout: vec.Vec<u32>,                // fv walk — capture candidates
    rvskip: u32,                       // eid whose redirect is off —
                                       // a $rv producer re-evals raw
    inclone: u8,
    ret: u32,
    // N46-N48 bounds facts — dominating-cond bounds and value
    // equalities, same scope/kill discipline as Stage-0's FnGen.
    bfacts: vec.Vec<BF>, efacts: vec.Vec<EF>,
    bkbyt: vec.Vec<u8>, bks: vec.Vec<loader.Span2>, kh: u32,
    // N74 — the emitted module as DATA, recorded alongside fnb so
    // the LLVM backend sees the same `Module` Stage-0 hands `emit`.
    // `iri`/`iri64` are index-parallel: 8 slots per instr, the i64
    // side carries immediates (u32 slots hold regs/nids/tys/kinds);
    // an opnd is (u32 kind-slot, i64 val-slot at the same index).
    iri: vec.Vec<u32>, iri64: vec.Vec<i64>,
    irpl: vec.Vec<u32>,                  // place heads: 6 slots each
    irpe: vec.Vec<PE>,                   // place path elems
    irax: vec.Vec<AX>,                   // call args
    irb: vec.Vec<u32>, irb64: vec.Vec<i64>,   // blocks: 8 slots each
    irf: vec.Vec<u32>,                   // fns: 8 slots each
    irpa: vec.Vec<u32>,                  // params (nid,auth,ty) ×3;
                                         // externs share it (auth=0)
    irar: vec.Vec<u32>,                  // arg regs per fn
    irx: vec.Vec<u32>,                   // externs: 4 slots each
    irst: vec.Vec<u32>,                  // struct decls: 3 slots each
    irsf: vec.Vec<u32>,                  // struct fields (nid,ty)
    blkioff: u32,                        // iri-instr index where the
                                         // pending block began
    sealbl: u32,                         // label `gseal` sealed under
    // scratch — opnd (res=kind,resv=val), ty (res2), place regs,
    // bnorm pair (bk=key|NONE, bo=off)
    res: u32, resv: i64,
    res2: u32, res3: u32, res4: u32, resv2: i64,
    pl_r: u32, pl_val: u8, pl_rty: u32, pl_ty: u32,
    pl_off: u32, pl_len: u32,
    bk: u32, bo: i64,
}

pub fn new(own c: check.Checker) -> G {
    let g = G {
        heap: c.heap,
        c: c,
        stx: vec.Vec<u8>::new(c.heap),
        etx: vec.Vec<u8>::new(c.heap),
        ftx: vec.Vec<u8>::new(c.heap),
        seen_s: vec.Vec<u32>::new(c.heap),
        seen_i: vec.Vec<u32>::new(c.heap),
        seen_f: vec.Vec<u32>::new(c.heap),
        seen_e: vec.Vec<u32>::new(c.heap),
        strings: vec.Vec<loader.Span2>::new(c.heap),
        sbyt: vec.Vec<u8>::new(c.heap),
        fnb: vec.Vec<u8>::new(c.heap),
        nxt: 0, nlbl: 0,
        lbyt: vec.Vec<u8>::new(c.heap),
        lbls: vec.Vec<loader.Span2>::new(c.heap),
        cur: NONE(), term: 0, put: 0,
        slots: vec.Vec<Slot>::new(c.heap),
        frame: vec.Vec<u32>::new(c.heap),
        promo: vec.Vec<u32>::new(c.heap),
        loops: vec.Vec<Lp>::new(c.heap),
        pel: vec.Vec<PE>::new(c.heap),
        ax: vec.Vec<AX>::new(c.heap),
        rvm: vec.Vec<check.KK>::new(c.heap),
        rvnc: vec.Vec<check.KK>::new(c.heap),
        oguards: vec.Vec<u32>::new(c.heap),
        dmark: vec.Vec<u32>::new(c.heap),
        dlist: vec.Vec<u32>::new(c.heap),
        tseq: 0, tfname: NONE(),
        cur_tp: NONE(), cur_ins: NONE(),
        tasks: vec.Vec<TSpec>::new(c.heap),
        tcaps: vec.Vec<TCap>::new(c.heap),
        pending: vec.Vec<TSpec>::new(c.heap),
        taskon: 0, taskend: NONE(), taskrp: 0, taskrt: NONE(),
        srtl: vec.Vec<check.KK>::new(c.heap),
        fbnd: vec.Vec<u32>::new(c.heap),
        fout: vec.Vec<u32>::new(c.heap),
        rvskip: NONE(),
        inclone: 0,
        ret: 9,
        res: 0, resv: 0, res2: 0, res3: 0, res4: 0, resv2: 0,
        pl_r: 0, pl_val: 0, pl_rty: 9, pl_ty: 9,
        pl_off: 0, pl_len: 0,
        bfacts: vec.Vec<BF>::new(c.heap),
        efacts: vec.Vec<EF>::new(c.heap),
        bkbyt: vec.Vec<u8>::new(c.heap),
        bks: vec.Vec<loader.Span2>::new(c.heap),
        kh: 0, bk: NONE(), bo: 0,
        iri: vec.Vec<u32>::new(c.heap),
        iri64: vec.Vec<i64>::new(c.heap),
        irpl: vec.Vec<u32>::new(c.heap),
        irpe: vec.Vec<PE>::new(c.heap),
        irax: vec.Vec<AX>::new(c.heap),
        irb: vec.Vec<u32>::new(c.heap),
        irb64: vec.Vec<i64>::new(c.heap),
        irf: vec.Vec<u32>::new(c.heap),
        irpa: vec.Vec<u32>::new(c.heap),
        irar: vec.Vec<u32>::new(c.heap),
        irx: vec.Vec<u32>::new(c.heap),
        irst: vec.Vec<u32>::new(c.heap),
        irsf: vec.Vec<u32>::new(c.heap),
        blkioff: 0, sealbl: NONE(),
    };
    // intern `#` — the literal-key marker rides key 0.
    g.bkbyt = g.bkbyt.push(u8(35));
    g.bks = g.bks.push(loader.Span2 { off: 0, len: 1 });
    return g;
}

pub fn destroy(own g: G) {
    g.stx.destroy(); g.etx.destroy(); g.ftx.destroy();
    g.seen_s.destroy(); g.seen_f.destroy(); g.seen_e.destroy();
    g.seen_i.destroy();
    g.strings.destroy(); g.sbyt.destroy();
    g.fnb.destroy(); g.lbyt.destroy(); g.lbls.destroy();
    g.slots.destroy(); g.frame.destroy(); g.promo.destroy();
    g.loops.destroy(); g.pel.destroy(); g.ax.destroy();
    g.rvm.destroy(); g.rvnc.destroy(); g.oguards.destroy();
    g.dmark.destroy(); g.dlist.destroy();
    g.tasks.destroy(); g.tcaps.destroy(); g.pending.destroy();
    g.srtl.destroy();
    g.fbnd.destroy(); g.fout.destroy();
    g.bfacts.destroy(); g.efacts.destroy();
    g.bkbyt.destroy(); g.bks.destroy();
    g.iri.destroy(); g.iri64.destroy();
    g.irpl.destroy(); g.irpe.destroy(); g.irax.destroy();
    g.irb.destroy(); g.irb64.destroy();
    g.irf.destroy(); g.irpa.destroy(); g.irar.destroy();
    g.irx.destroy(); g.irst.destroy(); g.irsf.destroy();
    check.destroy(g.c);
}

// ---- text helpers -------------------------------------------------

fn rname(own v: vec.Vec<u8>, read r: resolve.Resolver,
         nid: u32) -> vec.Vec<u8> {
    return resolve.push_name(v, r, nid);
}
fn gty(own v: vec.Vec<u8>, read r: resolve.Resolver,
       t: u32) -> vec.Vec<u8> {
    return resolve.ty_text(v, r, t);
}
fn gr(own v: vec.Vec<u8>, r: u32) -> vec.Vec<u8> {
    v = v.push(u8(118));
    return resolve.bu32(v, u64(r));
}
fn gi64(own v: vec.Vec<u8>, n: i64) -> vec.Vec<u8> {
    if n < 0 {
        v = v.push(u8(45));
        return resolve.bu32(v, u64(0 - n));
    }
    return resolve.bu32(v, u64(n));
}
fn gop(own v: vec.Vec<u8>, read r: resolve.Resolver,
       k: u32, val: i64) -> vec.Vec<u8> {
    if k == OK_IMM() { return gi64(v, val); }
    if k == OK_FUN() {
        v = v.push(u8(64));
        return rname(v, r, u32(val));
    }
    return gr(v, u32(val));
}

// ---- label / reg / block plumbing ---------------------------------

fn gfresh(own g: G) -> G {
    g.res = g.nxt;
    g.nxt = g.nxt + 1;
    return g;
}
fn gnew_lbl(own g: G, hint: str) -> G {
    let off = u32(g.lbyt.len);
    g.lbyt = resolve.bputs(g.lbyt, hint);
    g.lbyt = resolve.bu32(g.lbyt, u64(g.nlbl));
    g.nlbl = g.nlbl + 1;
    g.lbls = g.lbls.push(loader.Span2 {
        off: off, len: u32(g.lbyt.len) - off });
    g.res = u32(g.lbls.len) - 1;
    return g;
}
fn glbl(own v: vec.Vec<u8>, read g: G, id: u32) -> vec.Vec<u8> {
    let sp = g.lbls.buf[u64(id)];
    let i: u64 = u64(sp.off);
    while i < u64(sp.off) + u64(sp.len) {
        v = v.push(g.lbyt.buf[i]);
        i = i + 1;
    }
    return v;
}

/// emit a label line when the current block's hasn't printed yet —
/// `open` prints eagerly; emit-forced dead blocks print lazily here.
fn glab(own g: G) -> G {
    if g.put == 0 {
        g.fnb = glbl(g.fnb, g, g.cur);
        g.fnb = g.fnb.push(u8(58));
        g.fnb = g.fnb.push(u8(10));
        g.put = 1;
    }
    return g;
}

/// `emit` — an instruction line into the open block; post-terminator
/// code materializes a `dead` block first (gen.rs's emit).
fn ge(own g: G) -> G {
    if g.cur == NONE() {
        g = gnew_lbl(g, "dead");
        g.cur = g.res;
        g.put = 0;
    }
    g = glab(g);
    g.fnb = resolve.bputs(g.fnb, "    ");
    return g;
}
fn geol(own g: G) -> G {
    g.fnb = g.fnb.push(u8(10));
    return g;
}

// ---- N74 module record ----------------------------------------------
// Every emitter below also records its instr into `iri`/`iri64` (8
// slots per instr, index-parallel i64 side for immediates). The LLVM
// backend renders `.ll` from this record — the same `Module` s0's
// emit.rs consumes. Instr kinds:
//   0 Arg{dst,idx,ty} 1 Local{dst,ty,name} 2 Const{dst,ty,v}
//   3 Load{dst,pl} 4 Store{pl,val} 5 Addr{dst,pl} 6 MakeHandle{dst,pl}
//   7 ALoad{dst,pl} 8 AStore{pl,val} 9 AAdd{dst,pl,val}
//   10 ACas{dst,pl,e,n} 11 Bin{dst,op,ty,a,b} 12 Unary{dst,op,ty,a}
//   13 StrAddr{dst,idx,len} 14 Cast{dst,to,from,a}
//   15 Extract{dst,ty,a,idx} 16 Call{dst|NONE,ret,name,args}
// An opnd is (u32 kind slot, i64 val slot at the same index).

fn irec(own g: G, a: u32, b: u32, c: u32, d: u32,
        e: u32, f: u32, h: u32, i: u32) -> G {
    g.iri = g.iri.push(a); g.iri = g.iri.push(b);
    g.iri = g.iri.push(c); g.iri = g.iri.push(d);
    g.iri = g.iri.push(e); g.iri = g.iri.push(f);
    g.iri = g.iri.push(h); g.iri = g.iri.push(i);
    let z: i64 = 0;
    let j: u64 = 0;
    while j < 8 { g.iri64 = g.iri64.push(z); j = j + 1; }
    return g;
}
/// set the i64 side of the just-pushed instr's `slot`.
fn irecv(own g: G, slot: u32, v: i64) -> G {
    g.iri64.buf[u64(u32(g.iri64.len) - 8 + slot)] = v;
    return g;
}
/// snapshot the live `pl_*` place into `irpl`/`irpe` — res = its idx.
fn irplace(own g: G) -> G {
    let po = u32(g.irpe.len);
    let i: u64 = u64(g.pl_off);
    let jn = i + u64(g.pl_len);
    while i < jn {
        g.irpe = g.irpe.push(g.pel.buf[i]);
        i = i + 1;
    }
    g.irpl = g.irpl.push(g.pl_r);
    g.irpl = g.irpl.push(u32(g.pl_val));
    g.irpl = g.irpl.push(g.pl_rty);
    g.irpl = g.irpl.push(g.pl_ty);
    g.irpl = g.irpl.push(po);
    g.irpl = g.irpl.push(u32(g.pl_len));
    g.res = u32(g.irpl.len) / 6 - 1;
    return g;
}
/// seal-record: push the pending block under its term — s0's Block
/// exists only at seal; the label is whatever `g.cur` last held.
fn irseal(own g: G, tk: u32, a: u32, b: u32,
          c: u32, d: u32) -> G {
    let io = g.blkioff;
    let il = u32(g.iri.len) / 8 - io;
    g.irb = g.irb.push(g.sealbl); g.irb = g.irb.push(io);
    g.irb = g.irb.push(il); g.irb = g.irb.push(tk);
    g.irb = g.irb.push(a); g.irb = g.irb.push(b);
    g.irb = g.irb.push(c); g.irb = g.irb.push(d);
    let z: i64 = 0;
    let j: u64 = 0;
    while j < 8 { g.irb64 = g.irb64.push(z); j = j + 1; }
    g.blkioff = u32(g.iri.len) / 8;
    return g;
}
/// set the i64 side of the just-pushed block's `slot`.
fn irbv(own g: G, slot: u32, v: i64) -> G {
    g.irb64.buf[u64(u32(g.irb64.len) - 8 + slot)] = v;
    return g;
}

fn gopen(own g: G, lbl: u32) -> G {
    g.cur = lbl;
    g.term = 0;
    g.put = 0;
    g = glab(g);
    return g;
}
fn gseal(own g: G) -> G {
    // label may be unset only for a block that emitted nothing —
    // a fresh dead label names it (gen.rs's seal unwrap_or_else).
    if g.cur == NONE() {
        g = gnew_lbl(g, "dead");
        g.cur = g.res;
        g.put = 0;
    }
    g = glab(g);
    g.fnb = resolve.bputs(g.fnb, "    ");
    g.term = 1;
    g.sealbl = g.cur;
    g.cur = NONE();
    g.put = 0;
    return g;
}

// ---- instruction emitters -----------------------------------------

fn e_const(own g: G, dst: u32, ty: u32, val: i64) -> G {
    g = ge(g);
    g = irec(g, 2, dst, ty, OK_IMM(), 0, 0, 0, 0);
    g = irecv(g, 3, val);
    g.fnb = gr(g.fnb, dst);
    g.fnb = resolve.bputs(g.fnb, " = const.");
    g.fnb = gty(g.fnb, g.c.r, ty);
    g.fnb = g.fnb.push(u8(32));
    g.fnb = gi64(g.fnb, val);
    return geol(g);
}
fn e_local(own g: G, dst: u32, ty: u32, name: u32) -> G {
    g = ge(g);
    g = irec(g, 1, dst, ty, name, 0, 0, 0, 0);
    g.fnb = gr(g.fnb, dst);
    g.fnb = resolve.bputs(g.fnb, " = local.");
    g.fnb = gty(g.fnb, g.c.r, ty);
    g.fnb = resolve.bputs(g.fnb, " `");
    if name != NONE() {
        g.fnb = rname(g.fnb, g.c.r, name);
    }
    g.fnb = g.fnb.push(u8(96));
    return geol(g);
}
fn e_arg(own g: G, dst: u32, ty: u32, idx: u32) -> G {
    g = ge(g);
    g = irec(g, 0, dst, idx, ty, 0, 0, 0, 0);
    g.irar = g.irar.push(dst);
    g.fnb = gr(g.fnb, dst);
    g.fnb = resolve.bputs(g.fnb, " = arg.");
    g.fnb = gty(g.fnb, g.c.r, ty);
    g.fnb = resolve.bputs(g.fnb, " #");
    g.fnb = resolve.bu32(g.fnb, u64(idx));
    return geol(g);
}

/// place text — `v5` / `*v5` + `.f`/`[x]` path elems.
fn gptext(own v: vec.Vec<u8>, read g: G) -> vec.Vec<u8> {
    if g.pl_val == 1 { v = v.push(u8(42)); }
    v = gr(v, g.pl_r);
    let i: u64 = u64(g.pl_off);
    let jn = i + u64(g.pl_len);
    while i < jn {
        let pe = g.pel.buf[i];
        if pe.kind == 0 {
            v = v.push(u8(46));
            v = rname(v, g.c.r, pe.name);
        } else {
            v = v.push(u8(91));
            v = gop(v, g.c.r, u32(pe.kind) - 1, pe.ov);
            v = v.push(u8(93));
        }
        i = i + 1;
    }
    return v;
}
fn e_load(own g: G, dst: u32) -> G {
    g = ge(g);
    g = irplace(g);
    g = irec(g, 3, dst, g.res, 0, 0, 0, 0, 0);
    g.fnb = gr(g.fnb, dst);
    g.fnb = resolve.bputs(g.fnb, " = load.");
    g.fnb = gty(g.fnb, g.c.r, g.pl_ty);
    g.fnb = g.fnb.push(u8(32));
    g.fnb = gptext(g.fnb, g);
    return geol(g);
}
fn e_store(own g: G, k: u32, val: i64) -> G {
    g = ge(g);
    g = irplace(g);
    g = irec(g, 4, g.res, k, 0, 0, 0, 0, 0);
    g = irecv(g, 2, val);
    g.fnb = resolve.bputs(g.fnb, "store.");
    g.fnb = gty(g.fnb, g.c.r, g.pl_ty);
    g.fnb = g.fnb.push(u8(32));
    g.fnb = gptext(g.fnb, g);
    g.fnb = resolve.bputs(g.fnb, ", ");
    g.fnb = gop(g.fnb, g.c.r, k, val);
    return geol(g);
}
fn e_addr(own g: G, dst: u32) -> G {
    g = ge(g);
    g = irplace(g);
    g = irec(g, 5, dst, g.res, 0, 0, 0, 0, 0);
    g.fnb = gr(g.fnb, dst);
    g.fnb = resolve.bputs(g.fnb, " = addr ");
    g.fnb = gptext(g.fnb, g);
    g.fnb = resolve.bputs(g.fnb, " (&");
    g.fnb = gty(g.fnb, g.c.r, g.pl_ty);
    g.fnb = g.fnb.push(u8(41));
    return geol(g);
}
/// `dst = cast.{from} {a} -> {to}` — the `u64(x)` builtin.
fn e_cast(own g: G, dst: u32, from: u32, k: u32,
          v: i64, to: u32) -> G {
    g = ge(g);
    g = irec(g, 14, dst, to, from, k, 0, 0, 0);
    g = irecv(g, 4, v);
    g.fnb = gr(g.fnb, dst);
    g.fnb = resolve.bputs(g.fnb, " = cast.");
    g.fnb = gty(g.fnb, g.c.r, from);
    g.fnb = g.fnb.push(u8(32));
    g.fnb = gop(g.fnb, g.c.r, k, v);
    g.fnb = resolve.bputs(g.fnb, " -> ");
    g.fnb = gty(g.fnb, g.c.r, to);
    return geol(g);
}
/// `dst = aload.{ty} {place}` — atomic load.
fn e_aload(own g: G, dst: u32) -> G {
    g = ge(g);
    g = irplace(g);
    g = irec(g, 7, dst, g.res, 0, 0, 0, 0, 0);
    g.fnb = gr(g.fnb, dst);
    g.fnb = resolve.bputs(g.fnb, " = aload.");
    g.fnb = gty(g.fnb, g.c.r, g.pl_ty);
    g.fnb = g.fnb.push(u8(32));
    g.fnb = gptext(g.fnb, g);
    return geol(g);
}
/// `astore.{ty} {place}, {val}` — atomic store.
fn e_astore(own g: G, k: u32, val: i64) -> G {
    g = ge(g);
    g = irplace(g);
    g = irec(g, 8, g.res, k, 0, 0, 0, 0, 0);
    g = irecv(g, 2, val);
    g.fnb = resolve.bputs(g.fnb, "astore.");
    g.fnb = gty(g.fnb, g.c.r, g.pl_ty);
    g.fnb = g.fnb.push(u8(32));
    g.fnb = gptext(g.fnb, g);
    g.fnb = resolve.bputs(g.fnb, ", ");
    g.fnb = gop(g.fnb, g.c.r, k, val);
    return geol(g);
}
/// `dst = armw.add.{ty} {place}, {val}` — atomic fetch-add.
fn e_aadd(own g: G, dst: u32, k: u32, val: i64) -> G {
    g = ge(g);
    g = irplace(g);
    g = irec(g, 9, dst, g.res, k, 0, 0, 0, 0);
    g = irecv(g, 3, val);
    g.fnb = gr(g.fnb, dst);
    g.fnb = resolve.bputs(g.fnb, " = armw.add.");
    g.fnb = gty(g.fnb, g.c.r, g.pl_ty);
    g.fnb = g.fnb.push(u8(32));
    g.fnb = gptext(g.fnb, g);
    g.fnb = resolve.bputs(g.fnb, ", ");
    g.fnb = gop(g.fnb, g.c.r, k, val);
