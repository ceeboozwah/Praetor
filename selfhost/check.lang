    c.tag_v = s.tag_v; c.tag_has = s.tag_has;
    c.has_lock = s.has_lock; c.lock_dom = s.lock_dom;
    c.lock_root = s.lock_root; c.lock_ty = s.lock_ty;
    c.lock_off = s.lock_off; c.lock_len = s.lock_len;
    c.has_mutex = s.has_mutex; c.mx_off = s.mx_off; c.mx_len = s.mx_len;
    c.has_recv = s.has_recv; c.recv_pkt = s.recv_pkt;
    c.has_spawn = s.has_spawn; c.spawn_eff = s.spawn_eff;
    c.last_spawn_tk = s.last_spawn_tk;
    c.sp_line = s.sp_line; c.sp_col = s.sp_col;
    c.sp_hoff = s.sp_hoff; c.sp_hlen = s.sp_hlen;
    c.task_ret = s.task_ret;
    c.lrefs_has = s.lrefs_has; c.lrefs_mut = s.lrefs_mut;
    c.lrefs_mf = s.lrefs_mf; c.lrefs_foreign = s.lrefs_foreign;
    c.lcaps_has = s.lcaps_has; c.llen_has = s.llen_has; c.llen = s.llen;
    c.cond_depth = s.cond_depth;
    return c;
}

// ---- tasks: spawn / join --------------------------------------------------

/// is_external — the key's root starts `$` or was a live bind at
/// spawn (task_ext holds `name#epoch` roots). res = 1|0.
fn is_ext(own c: Checker, k: u32) -> Checker {
    c = key_root(c, k);
    let rk = c.res;
    if k_is_arg(c, rk) == 1 { c.res = 1; return c; }
    c.res = u32(vhas(c.task_ext, rk));
    return c;
}

/// wrapper rty — Task/Handle/etc: (kind, a) canonical, find-or-push.
fn rty_mk_wrap(own c: Checker, kind: u8, a: u32) -> Checker {
    let i: u64 = 0;
    while i < c.r.rtys.len {
        let t = c.r.rtys.buf[i];
        if t.kind == kind && t.name == 0 && t.a == a
            && t.b == 0 && t.w == 0 {
            c.res = u32(i);
            return c;
        }
        i = i + 1;
    }
    c.r.rtys = c.r.rtys.push(resolve.RTy {
        kind: kind, name: 0, a: a, b: 0, c: 0, w: 0 });
    c.res = u32(c.r.rtys.len) - 1;
    return c;
}

/// key-order sorts for the suspended-diff capture (canonical replay
/// order at join). Insertion sort — these lists are small.
fn srt_e2(read c: Checker, own v: vec.Vec<E2>) -> vec.Vec<E2> {
    let i: u64 = 1;
    while i < v.len {
        let x = v.buf[i];
        let j = i;
        while j > 0 {
            let y = v.buf[j - 1];
            let less: u8 = 0;
            if kless(c, x.h, y.h) == 1 { less = 1; }
            else { if y.h == x.h { less = kless(c, x.t, y.t); } }
            if less == 0 { break; }
            v.buf[j] = v.buf[j - 1];
            j = j - 1;
        }
        v.buf[j] = x;
        i = i + 1;
    }
    return v;
}
fn srt_c3(read c: Checker, own v: vec.Vec<C3>) -> vec.Vec<C3> {
    let i: u64 = 1;
    while i < v.len {
        let x = v.buf[i];
        let j = i;
        while j > 0 {
            let y = v.buf[j - 1];
            let less: u8 = 0;
            if kless(c, x.h, y.h) == 1 { less = 1; }
            else { if y.h == x.h { less = kless(c, x.t, y.t); } }
            if less == 0 { break; }
            v.buf[j] = v.buf[j - 1];
            j = j - 1;
        }
        v.buf[j] = x;
        i = i + 1;
    }
    return v;
}
fn srt_me2(read c: Checker, own v: vec.Vec<MapE2>) -> vec.Vec<MapE2> {
    let i: u64 = 1;
    while i < v.len {
        let x = v.buf[i];
        let j = i;
        while j > 0 && kless(c, x.k, v.buf[j - 1].k) == 1 {
            v.buf[j] = v.buf[j - 1];
            j = j - 1;
        }
        v.buf[j] = x;
        i = i + 1;
    }
    return v;
}
fn srt_cf(read c: Checker, own v: vec.Vec<CF>) -> vec.Vec<CF> {
    let i: u64 = 1;
    while i < v.len {
        let x = v.buf[i];
        let j = i;
        while j > 0 && kless(c, x.k, v.buf[j - 1].k) == 1 {
            v.buf[j] = v.buf[j - 1];
            j = j - 1;
        }
        v.buf[j] = x;
        i = i + 1;
    }
    return v;
}
fn srt_pv(read c: Checker, own v: vec.Vec<PV>) -> vec.Vec<PV> {
    let i: u64 = 1;
    while i < v.len {
        let x = v.buf[i];
        let j = i;
        while j > 0 && kless(c, x.k, v.buf[j - 1].k) == 1 {
            v.buf[j] = v.buf[j - 1];
            j = j - 1;
        }
        v.buf[j] = x;
        i = i + 1;
    }
    return v;
}
fn srt_km(read c: Checker, own v: vec.Vec<KM>) -> vec.Vec<KM> {
    let i: u64 = 1;
    while i < v.len {
        let x = v.buf[i];
        let j = i;
        while j > 0 && kless(c, x.k, v.buf[j - 1].k) == 1 {
            v.buf[j] = v.buf[j - 1];
            j = j - 1;
        }
        v.buf[j] = x;
        i = i + 1;
    }
    return v;
}

/// Expr::Spawn — fork the world, run the body on the child state,
/// diff the suspended transform back, leave `has_spawn` for the
/// binding site (bind_task / the unbound-spawn diagnostic).
fn expr_spawn(own c: Checker, read p: ast.Parser, eid: u32) -> Checker {
    let e = xexp(c, p, eid);
    c = es(c, "(spawn @");
    c = eu(c, u64(e.line));
    c = ec(c, u8(58));
    c = eu(c, u64(e.col));
    c = ec(c, u8(41));
    c = rec(c);
    // ext — every live bind key (`{name}#{epoch}`)
    let ext = vec.Vec<u32>::new(c.heap);
    let i: u64 = 0;
    while i < c.bnames.len {
        let b = c.binds.buf[u64(c.bnames.buf[i].v)];
        c = key_of(c, b.n, b.epoch);
        if vhas(ext, c.res) == 0 { ext = ext.push(c.res); }
        i = i + 1;
    }
    let base_regs = u32(c.regs.len);
    let sline = e.line; let scol = e.col;
    let sb = e.b; let se = e.c;
    // fork — parent channels into the snap, child on clones/resets.
    let t = ss_take(c);
    c = t.c;
    let snap = t.s;
    c.task_ext.destroy();
    c.task_ext = ext;
    c = rty_prim(c, 9);
    c.task_ret = c.res;
    let tret = c.task_ret;
    c = es(c, "(task-begin)");
    c = rec(c);
    c = check_block(c, p, sb, sb + se, 0, tret);
    c = es(c, "(task-end)");
    c = rec(c);
    return spawn_commit(c, snap, base_regs, sline, scol);
}

/// spawn_commit — suspended-diff + parent merge of Expr::Spawn
/// (own frame so nested spawn recursion stays cheap).
fn spawn_commit(own c: Checker, own snap: SSnap,
                base_regs: u32, sline: u32, scol: u32) -> Checker {
    // suspended diff — capture into locals (child state still live).
    let i: u64 = 0;
    let ret = c.task_ret;
    let d_edges = vec.Vec<E2>::new(c.heap);
    i = 0;
    while i < c.edges.len {
        let x = c.edges.buf[i];
        c = is_ext(c, x.h);
        let he = c.res;
        c = is_ext(c, x.t);
        if he == 1 && c.res == 1 {
            let same: u8 = 0;
            let j: u64 = 0;
            while j < snap.edges.len {
                let pe = snap.edges.buf[j];
                if pe.h == x.h && pe.t == x.t
                    && pe.kind == x.kind && pe.cert == x.cert { same = 1; }
                j = j + 1;
            }
            if same == 0 { d_edges = d_edges.push(x); }
        }
        i = i + 1;
    }
    let d_kills = vec.Vec<MapE2>::new(c.heap);
    i = 0;
    while i < c.ekills.len {
        let m = c.ekills.buf[i];
        c = is_ext(c, m.k);
        if c.res == 1 { d_kills = d_kills.push(m); }
        i = i + 1;
    }
    let d_ccaps = vec.Vec<C3>::new(c.heap);
    i = 0;
    while i < c.caps.len {
        let x = c.caps.buf[i];
        c = is_ext(c, x.h);
        let he = c.res;
        c = is_ext(c, x.t);
        if he == 1 && c.res == 1 {
            let same: u8 = 0;
            let j: u64 = 0;
            while j < snap.caps.len {
                let pc = snap.caps.buf[j];
                if pc.h == x.h && pc.t == x.t
                    && pc.cert == x.cert { same = 1; }
                j = j + 1;
            }
            if same == 0 { d_ccaps = d_ccaps.push(x); }
        }
        i = i + 1;
    }
    let d_ckills = vec.Vec<MapE2>::new(c.heap);
    i = 0;
    while i < c.ckills.len {
        let m = c.ckills.buf[i];
        c = is_ext(c, m.k);
        if c.res == 1 { d_ckills = d_ckills.push(m); }
        i = i + 1;
    }
    let d_cons = vec.Vec<CF>::new(c.heap);
    i = 0;
    while i < c.cons.len {
        let f = c.cons.buf[i];
        c = is_ext(c, f.k);
        if c.res == 1 {
            let pst: u8 = 0;
            let j: u64 = 0;
            while j < snap.cons.len {
                if snap.cons.buf[j].k == f.k {
                    pst = snap.cons.buf[j].st;
                }
                j = j + 1;
            }
            if pst != f.st { d_cons = d_cons.push(f); }
        }
        i = i + 1;
    }
    let d_provs = vec.Vec<PV>::new(c.heap);
    i = 0;
    while i < c.provs.len {
        let v = c.provs.buf[i];
        c = is_ext(c, v.k);
        if c.res == 1 {
            // region ids >= base_regs name child-internal regions —
            // meaningless to the parent, filtered.
            if v.pk == 2 && v.pv >= base_regs { }
            else { d_provs = d_provs.push(v); }
        }
        i = i + 1;
    }
    let d_re = clone_km(c.heap, c.ret_edges);
    let d_rc = clone_u(c.heap, c.ret_caps);
    let d_holds = vec.Vec<KM>::new(c.heap);
    i = 0;
    while i < c.holds.len {
        let h = c.holds.buf[i];
        c = is_ext(c, h.k);
        if c.res == 1 { d_holds = d_holds.push(h); }
        i = i + 1;
    }
    // channel world — external transit + queues merge back at spawn.
    let d_transit = vec.Vec<u32>::new(c.heap);
    i = 0;
    while i < c.transit.len {
        let tk = c.transit.buf[i];
        c = is_ext(c, tk);
        if c.res == 1 { d_transit = d_transit.push(tk); }
        i = i + 1;
    }
    let d_chans = vec.Vec<CQ>::new(c.heap);
    i = 0;
    while i < c.chans.len {
        let qk = c.chans.buf[i].k;
        c = is_ext(c, qk);
        if c.res == 1 {
            let np = vec.Vec<Packet>::new(c.heap);
            let j: u64 = 0;
            while j < c.chans.buf[i].pkts.len {
                np = np.push(c.chans.buf[i].pkts.buf[j]);
                j = j + 1;
            }
            d_chans = d_chans.push(CQ { k: qk, pkts: np });
        }
        i = i + 1;
    }
    // back to the parent world.
    c = ss_restore(c, snap);
    c.transit.destroy();
    c.transit = d_transit;
    // Stage-0 sorts child channel queues by key before landing them.
    let qks = vec.Vec<u32>::new(c.heap);
    i = 0;
    while i < d_chans.len {
        qks = qks.push(d_chans.buf[i].k); i = i + 1;
    }
    let qks2 = ksort(c, qks);
    i = 0;
    while i < qks2.len {
        let qk = qks2.buf[i];
        let di: u64 = 0;
        while di < d_chans.len {
            if d_chans.buf[di].k == qk { break; }
            di = di + 1;
        }
        let qn = u64(d_chans.buf[di].pkts.len);
        c = es(c, "(chan ");
        c = eqs(c, qk);
        c = ec(c, u8(32));
        c = eu(c, qn);
        c = ec(c, u8(41));
        c = rec(c);
        let hit: i64 = 0 - 1;
        let j: u64 = 0;
        while j < c.chans.len {
            if c.chans.buf[j].k == qk { hit = i64(j); }
            j = j + 1;
        }
        if hit >= 0 {
            let np = vec.Vec<Packet>::new(c.heap);
            let j2: u64 = 0;
            while j2 < qn {
                np = np.push(d_chans.buf[di].pkts.buf[j2]);
                j2 = j2 + 1;
            }
            c.chans.buf[u64(hit)].pkts.destroy();
            c.chans.buf[u64(hit)].pkts = np;
        }
        if hit < 0 {
            let np = vec.Vec<Packet>::new(c.heap);
            let j2: u64 = 0;
            while j2 < qn {
                np = np.push(d_chans.buf[di].pkts.buf[j2]);
                j2 = j2 + 1;
            }
            c.chans = c.chans.push(CQ { k: qk, pkts: np });
        }
        i = i + 1;
    }
    while d_chans.len > 0 {
        let dq = d_chans.pop();
        dq.pkts.destroy();
    }
    d_chans.destroy();
    qks2.destroy();
    // eff + holds into the arenas — sorted for canonical join replay.
    let d_e2 = srt_e2(c, d_edges);
    let d_k2 = srt_me2(c, d_kills);
    let d_c2 = srt_c3(c, d_ccaps);
    let d_ck2 = srt_me2(c, d_ckills);
    let d_f2 = srt_cf(c, d_cons);
    let d_p2 = srt_pv(c, d_provs);
    let effi = u32(c.teffs.len);
    let eo = u32(c.te_edges.len);
    i = 0;
    while i < d_e2.len { c.te_edges = c.te_edges.push(d_e2.buf[i]); i = i + 1; }
    let ko = u32(c.te_kills.len);
    i = 0;
    while i < d_k2.len { c.te_kills = c.te_kills.push(d_k2.buf[i]); i = i + 1; }
    let co = u32(c.te_ccaps.len);
    i = 0;
    while i < d_c2.len { c.te_ccaps = c.te_ccaps.push(d_c2.buf[i]); i = i + 1; }
    let cko = u32(c.te_ckills.len);
    i = 0;
    while i < d_ck2.len { c.te_ckills = c.te_ckills.push(d_ck2.buf[i]); i = i + 1; }
    let dof = u32(c.te_cons.len);
    i = 0;
    while i < d_f2.len { c.te_cons = c.te_cons.push(d_f2.buf[i]); i = i + 1; }
    let po = u32(c.te_provs.len);
    i = 0;
    while i < d_p2.len { c.te_provs = c.te_provs.push(d_p2.buf[i]); i = i + 1; }
    let reo = u32(c.te_re.len);
    i = 0;
    while i < d_re.len { c.te_re = c.te_re.push(d_re.buf[i]); i = i + 1; }
    let rco = u32(c.te_rc.len);
    i = 0;
    while i < d_rc.len { c.te_rc = c.te_rc.push(d_rc.buf[i]); i = i + 1; }
    c.teffs = c.teffs.push(TaskEff {
        eoff: eo, elen: u32(c.te_edges.len) - eo,
        koff: ko, klen: u32(c.te_kills.len) - ko,
        coff: co, clen: u32(c.te_ccaps.len) - co,
        ckoff: cko, cklen: u32(c.te_ckills.len) - cko,
        doff: dof, dlen: u32(c.te_cons.len) - dof,
        poff: po, plen: u32(c.te_provs.len) - po,
        reoff: reo, relen: u32(c.te_re.len) - reo,
        rcoff: rco, rclen: u32(c.te_rc.len) - rco,
        ret: ret });
    d_e2.destroy(); d_k2.destroy(); d_c2.destroy(); d_ck2.destroy();
    d_f2.destroy(); d_p2.destroy(); d_re.destroy(); d_rc.destroy();
    c.sp_hoff = u32(c.tk_holds.len);
    let d_h2 = srt_km(c, d_holds);
    i = 0;
    while i < d_h2.len { c.tk_holds = c.tk_holds.push(d_h2.buf[i]); i = i + 1; }
    c.sp_hlen = u32(c.tk_holds.len) - c.sp_hoff;
    d_h2.destroy();
    c.has_spawn = 1;
    c.spawn_eff = effi;
    c.sp_line = sline;
    c.sp_col = scol;
    c = rty_mk_wrap(c, 19, ret);
    c.res2 = 0;
    c.res3 = 0;
    return c;
}

/// Expr::Join — the suspended transform lands: kills then creates
/// then caps (summary-replay order), hold edges die, token is spent.
fn expr_join(own c: Checker, read p: ast.Parser, eid: u32) -> Checker {
    let e = xexp(c, p, eid);
    c = builtin_shadow(c, "join", e.line, e.col);
    c = expr_tv(c, p, e.a);
    let t = c.res;
    let tn = c.r.rtys.buf[u64(t)];
    if tn.kind != 19 {
        let m = vec.Vec<u8>::new(c.heap);
        let m2 = resolve.bputs(m, "`join` requires a task, found ");
        let t1 = push_ty(m2, c, t);
        c = t1.c;
        c = pdiag(c, e.line, e.col, t1.m.as_slice());
        t1.m.destroy();
        c = rty_prim(c, 9);
        c.res2 = 0;
        c.res3 = 0;
        return c;
    }
    let ret = tn.a;
    c = place_id(c, p, e.a);
    let key = c.res;
    let ti: u32 = NONE();
    if key != NONE() { ti = task_find(c, key); }
    if ti == NONE() {
        let m = vec.Vec<u8>::new(c.heap);
        let m2 = resolve.bputs(m,
            "join of unknown or already-joined task `");
        let m3 = tn_into(m2, c, p, e.a);
        let m4 = m3.push(u8(96));
        c = pdiag(c, e.line, e.col, m4.as_slice());
        m4.destroy();
        c.res = ret;
        c.res2 = 1;
        c.res3 = 0;
        return c;
    }
    c = es(c, "(task-join ");
    c = eqs(c, key);
    c = es(c, " @");
    c = eu(c, u64(e.line));
    c = ec(c, u8(58));
    c = eu(c, u64(e.col));
    c = ec(c, u8(41));
    c = rec(c);
    if cons_covers(c, key) == 1 {
        c.res = ret;
        c.res2 = 1;
        c.res3 = 0;
        return c;
    }
    let tk = c.tasks.buf[u64(ti)];
    let eff = c.teffs.buf[u64(tk.eff)];
    let i: u64 = u64(eff.koff);
    while i < u64(eff.koff) + u64(eff.klen) {
        let m = c.te_kills.buf[i];
        c = kill_set(c, m.k, m.cert);
        c = apply_kill(c, m.k, m.cert);
        i = i + 1;
    }
    i = u64(eff.ckoff);
    while i < u64(eff.ckoff) + u64(eff.cklen) {
        let m = c.te_ckills.buf[i];
        c = capkill_set(c, m.k, m.cert);
        c = apply_cap_kill(c, m.k, m.cert);
        i = i + 1;
    }
    i = u64(eff.eoff);
    while i < u64(eff.eoff) + u64(eff.elen) {
        let x = c.te_edges.buf[i];
        c = edge_set(c, x.h, x.t, x.kind, x.cert, x.bl, x.bc);
        // region-prov backfill — target root names a live bind
        c = key_root(c, x.t);
        let rk = c.res;
        let nm = root_name(c, rk);
        if nm != NONE() {
            let bi = bfind(c, nm);
            if i64(bi) >= 0 {
                let b = c.binds.buf[u64(bi)];
                c = key_of(c, nm, b.epoch);
                if c.res == rk {
                    c = prov_set(c, x.h, 2, b.owner);
                }
            }
        }
        i = i + 1;
    }
    i = u64(eff.coff);
    while i < u64(eff.coff) + u64(eff.clen) {
        let x = c.te_ccaps.buf[i];
        c = cap_set(c, x.h, x.t, x.cert);
        i = i + 1;
    }
    i = u64(eff.doff);
    while i < u64(eff.doff) + u64(eff.dlen) {
        let f = c.te_cons.buf[i];
        c = cons_set(c, f.k, f.st, f.aoff, f.alen);
        i = i + 1;
    }
    i = u64(eff.poff);
    while i < u64(eff.poff) + u64(eff.plen) {
        let v = c.te_provs.buf[i];
        c = prov_set(c, v.k, v.pk, v.pv);
        i = i + 1;
    }
    c = edges_retain_holder(c, key);
    c = cons1(c, key, 1, e.line, e.col);
    c.res = ret;
    c.res2 = 1;
    c.res3 = 0;
    return c;
}

/// join_prov — res = pk, res2 = pv of the joined prov.
fn jprov(own c: Checker, apk: u8, apv: u32,
         bpk: u8, bpv: u32) -> Checker {
    if apk == 0 { c.res = u32(bpk); c.res2 = bpv; return c; }
    if bpk == 0 { c.res = u32(apk); c.res2 = apv; return c; }
    if apk == 1 && bpk == 1 { c.res = 1; c.res2 = 0; return c; }
    if apk == 1 { c.res = u32(bpk); c.res2 = bpv; return c; }
    if bpk == 1 { c.res = u32(apk); c.res2 = apv; return c; }
    // region x region -> lca
    c.res = 2; c.res2 = rlca(c, apv, bpv);
    return c;
}

/// region lca via parent chains.
fn rlca(read c: Checker, a: u32, b: u32) -> u32 {
    // walk a's ancestors; return first that is an ancestor of b
    let cur = a;
    while cur != NONE() {
        if ranc(c, cur, b) == 1 { return cur; }
        cur = c.regs.buf[u64(cur)].parent;
    }
    return 0;
}

/// is `a` an ancestor-or-self of `b`?
fn ranc(read c: Checker, a: u32, b: u32) -> u8 {
    let cur = b;
    while cur != NONE() {
        if cur == a { return 1; }
        cur = c.regs.buf[u64(cur)].parent;
    }
    return 0;
}

/// init_covered — Def cert at k's canon or any ancestor in `m`.
fn icov(own c: Checker, read m: vec.Vec<MapE2>, k0: u32) -> Checker {
    c.res = 0;
    c = init_canon(c, k0);
    let cur = c.res;
    while cur != NONE() {
        let i: u64 = 0;
        while i < m.len {
            if m.buf[i].k == cur && m.buf[i].cert == 1 {
                c.res = 1; return c;
            }
            i = i + 1;
        }
        let ck = cur;
        c = init_parent(c, ck);
        cur = c.res;
    }
    return c;
}

/// icov over the live init map.
fn icov_c(own c: Checker, k0: u32) -> Checker {
    c.res = 0;
    c = init_canon(c, k0);
    let cur = c.res;
    while cur != NONE() {
        let i: u64 = 0;
        while i < c.init.len {
            if c.init.buf[i].k == cur && c.init.buf[i].cert == 1 {
                c.res = 1; return c;
            }
            i = i + 1;
        }
        let ck = cur;
        c = init_parent(c, ck);
        cur = c.res;
    }
    return c;
}

/// cert of k in a MapE2 vec: 1 def, 2 maybe, 0 absent.
fn me_get(read v: vec.Vec<MapE2>, k: u32) -> u8 {
    let i: u64 = 0;
    while i < v.len {
        if v.buf[i].k == k { return v.buf[i].cert; }
        i = i + 1;
    }
    return 0;
}

fn e2_has(read v: vec.Vec<E2>, h: u32, t: u32) -> i64 {
    let i: u64 = 0;
    while i < v.len {
        if v.buf[i].h == h && v.buf[i].t == t { return i64(i); }
        i = i + 1;
    }
    return 0 - 1;
}

fn c3_get(read v: vec.Vec<C3>, h: u32, t: u32) -> u8 {
    let i: u64 = 0;
    while i < v.len {
        if v.buf[i].h == h && v.buf[i].t == t { return v.buf[i].cert; }
        i = i + 1;
    }
    return 0;
}

fn cf_get(read v: vec.Vec<CF>, k: u32) -> i64 {
    let i: u64 = 0;
    while i < v.len {
        if v.buf[i].k == k { return i64(i); }
        i = i + 1;
    }
    return 0 - 1;
}

fn pv_get(read v: vec.Vec<PV>, k: u32) -> i64 {
    let i: u64 = 0;
    while i < v.len {
        if v.buf[i].k == k { return i64(i); }
        i = i + 1;
    }
    return 0 - 1;
}

/// merge_origins for cons `at` spans — appends b's sites to a's
/// (dedup, cap 4) and returns a fresh (off,len) into c.atspans.
/// alen == NONE() means the side had no fact.
fn ats_merge(own c: Checker, aoff: u32, alen: u32,
             boff: u32, blen: u32) -> Checker {
    let off = u32(c.atspans.len);
    let n: u32 = 0;
    if alen != NONE() {
        let j: u64 = 0;
        while j < u64(alen) * 2 {
            c.atspans = c.atspans.push(c.atspans.buf[u64(aoff) + j]);
            j = j + 1;
        }
        n = alen;
    }
    if blen != NONE() {
        let j: u64 = 0;
        while j < u64(blen) {
            let sl = c.atspans.buf[u64(boff) + j * 2];
            let sc = c.atspans.buf[u64(boff) + j * 2 + 1];
            let dup: u8 = 0;
            let q: u64 = u64(off);
            while q < c.atspans.len {
                if c.atspans.buf[q] == sl
                    && c.atspans.buf[q + 1] == sc { dup = 1; }
                q = q + 2;
            }
            if dup == 0 && n < 4 {
                c.atspans = c.atspans.push(sl);
                c.atspans = c.atspans.push(sc);
                n = n + 1;
            }
            j = j + 1;
        }
    }
    c.res = off; c.res2 = n;
    return c;
}

/// if_merge — the full two-path join: c holds the else state, `then`
/// is the other arm. pre provs feed the prov-join fallback.
fn if_merge(own c: Checker, own t: BS, read pre: BS) -> Checker {
    // edges: union; Def iff both Def && same kind; born then-first
    let w = vec.Vec<E2>::new(c.heap);
    let i: u64 = 0;
    while i < t.edges.len {
        let e = t.edges.buf[i];
        let cert: u8 = 2;
        let bi = e2_has(c.edges, e.h, e.t);
        if bi >= 0 {
            let o = c.edges.buf[u64(bi)];
            if o.cert == 1 && e.cert == 1 && o.kind == e.kind {
                cert = 1;
            }
        }
        w = w.push(E2 { h: e.h, t: e.t, kind: e.kind,
            cert: cert, bl: e.bl, bc: e.bc });
        i = i + 1;
    }
    i = 0;
    while i < c.edges.len {
        let e = c.edges.buf[i];
        if e2_has(t.edges, e.h, e.t) < 0 {
            w = w.push(E2 { h: e.h, t: e.t, kind: e.kind,
                cert: 2, bl: e.bl, bc: e.bc });
        }
        i = i + 1;
    }
    c.edges.destroy(); c.edges = w;
    // caps: same both-Def rule on (h,t)
    let w2 = vec.Vec<C3>::new(c.heap);
    i = 0;
    while i < t.caps.len {
        let e = t.caps.buf[i];
        let cert: u8 = 2;
        if c3_get(c.caps, e.h, e.t) == 1 && e.cert == 1 { cert = 1; }
        w2 = w2.push(C3 { h: e.h, t: e.t, cert: cert });
        i = i + 1;
    }
    i = 0;
    while i < c.caps.len {
        let e = c.caps.buf[i];
        let in_then: u8 = 0;
        let j: u64 = 0;
        while j < t.caps.len {
            if t.caps.buf[j].h == e.h && t.caps.buf[j].t == e.t {
                in_then = 1;
            }
            j = j + 1;
        }
        if in_then == 0 {
            w2 = w2.push(C3 { h: e.h, t: e.t, cert: 2 });
        }
        i = i + 1;
    }
    c.caps.destroy(); c.caps = w2;
    // cons: union keys; Cons iff both Cons; merged at-sites
    let w3 = vec.Vec<CF>::new(c.heap);
    i = 0;
    while i < t.cons.len {
        let f = t.cons.buf[i];
        let k = f.k;
        let bi = cf_get(c.cons, k);
        let st: u8 = 2;
        let bo: u32 = 0; let bl: u32 = NONE();
        if bi >= 0 {
            bo = c.cons.buf[u64(bi)].aoff;
            bl = c.cons.buf[u64(bi)].alen;
            if f.st == 1 && c.cons.buf[u64(bi)].st == 1 { st = 1; }
        }
        c = ats_merge(c, f.aoff, f.alen, bo, bl);
        let ao = c.res; let al = u32(c.res2);
        w3 = w3.push(CF { k: k, st: st, aoff: ao, alen: al });
        i = i + 1;
    }
    i = 0;
    while i < c.cons.len {
        let f = c.cons.buf[i];
        if cf_get(t.cons, f.k) < 0 {
            c = ats_merge(c, 0, NONE(), f.aoff, f.alen);
            let ao = c.res; let al = u32(c.res2);
            w3 = w3.push(CF { k: f.k, st: 2, aoff: ao, alen: al });
        }
        i = i + 1;
    }
    c.cons.destroy(); c.cons = w3;
    // init: union keys; Def iff init_covered on both
    let w4 = vec.Vec<MapE2>::new(c.heap);
    i = 0;
    while i < t.init.len {
        let k = t.init.buf[i].k;
        c = icov(c, t.init, k);
        let ca = c.res;
        c = icov_c(c, k);
        let cb = c.res;
        if ca == 1 && cb == 1 {
            w4 = w4.push(MapE2 { k: k, cert: 1 });
        } else { if ca != cb || ca == 1 || cb == 1 {
            w4 = w4.push(MapE2 { k: k, cert: 2 });
        } }
        i = i + 1;
    }
    i = 0;
    while i < c.init.len {
        let k = c.init.buf[i].k;
        let in_then: u8 = 0;
        let j: u64 = 0;
        while j < t.init.len {
            if t.init.buf[j].k == k { in_then = 1; }
            j = j + 1;
        }
        if in_then == 0 {
            c = icov(c, t.init, k);
            let ca = c.res;
            c = icov_c(c, k);
            let cb = c.res;
            if ca == 1 && cb == 1 {
                w4 = w4.push(MapE2 { k: k, cert: 1 });
            } else { if ca != cb || ca == 1 || cb == 1 {
                w4 = w4.push(MapE2 { k: k, cert: 2 });
            } }
        }
        i = i + 1;
    }
    c.init.destroy(); c.init = w4;
    // kills: union; Def iff both Def
    c = join_killmap(c, t.ekills, 0);
    c = join_killmap(c, t.ckills, 1);
    // provs: base = else (c); then keys join vs else|pre
    i = 0;
    while i < t.provs.len {
        let pv2 = t.provs.buf[i];
        let bi = pv_get(c.provs, pv2.k);
        let opk: u8 = 0; let opv: u32 = 0;
        let have: u8 = 0;
        if bi >= 0 {
            let o = c.provs.buf[u64(bi)];
            opk = o.pk; opv = o.pv; have = 1;
        } else {
            let pi = pv_get(pre.provs, pv2.k);
            if pi >= 0 {
                let o = pre.provs.buf[u64(pi)];
                opk = o.pk; opv = o.pv; have = 1;
            }
        }
        if have == 0 { opk = pv2.pk; opv = pv2.pv; }
        c = jprov(c, pv2.pk, pv2.pv, opk, opv);
        let pk2 = u8(c.res); let pv3 = c.res2;
        // upsert into c.provs
        if bi >= 0 {
            c.provs.buf[u64(bi)].pk = pk2;
            c.provs.buf[u64(bi)].pv = pv3;
        } else {
            c.provs = c.provs.push(
                PV { k: pv2.k, pk: pk2, pv: pv3 });
        }
        i = i + 1;
    }
    // scopes: merge_envs(then, else)
    c = merge_envs2(c, t);
    // defers/dres
    c = merge_dframes(c, t);
    let j2: u64 = 0;
    while j2 < t.dres.len {
        let dr = t.dres.buf[j2];
        let has: u8 = 0;
        let q: u64 = 0;
        while q < c.dres.len {
            if c.dres.buf[q].k == dr.k { has = 1; }
            q = q + 1;
        }
        if has == 0 { c.dres = c.dres.push(dr); }
        j2 = j2 + 1;
    }
    // transit union + chan max-len
    i = 0;
    while i < t.transit.len {
        if vhas(c.transit, t.transit.buf[i]) == 0 {
            c.transit = c.transit.push(t.transit.buf[i]);
        }
        i = i + 1;
    }
    i = 0;
    while i < t.chans.len {
        let ck2 = t.chans.buf[i].k;
        let tn = t.chans.buf[i].pkts.len;
        let j: u64 = 0;
        while j < c.chans.len {
            if c.chans.buf[j].k == ck2 {
                if tn > c.chans.buf[j].pkts.len {
                    let np = vec.Vec<Packet>::new(c.heap);
                    let q: u64 = 0;
                    while q < tn {
                        np = np.push(t.chans.buf[i].pkts.buf[q]);
                        q = q + 1;
                    }
                    c.chans.buf[j].pkts.destroy();
                    c.chans.buf[j].pkts = np;
                }
            }
            j = j + 1;
        }
        i = i + 1;
    }
    // tag: NOT merged — Stage-0's `if` never snapshots `ctx.tag`;
    // the else-walk's final tag stands.
    bs_free(t);
    return c;
}

/// join_cert_map of two maps into a fresh vec.
fn jkm(h: alloc, read t: vec.Vec<MapE2>,
       read m: vec.Vec<MapE2>) -> vec.Vec<MapE2> {
    let w = vec.Vec<MapE2>::new(h);
    let i: u64 = 0;
    while i < t.len {
        let k = t.buf[i].k;
        let cert: u8 = 2;
        if t.buf[i].cert == 1 && me_get(m, k) == 1 { cert = 1; }
        w = w.push(MapE2 { k: k, cert: cert });
        i = i + 1;
    }
    i = 0;
    while i < m.len {
        let k = m.buf[i].k;
        let in_t: u8 = 0;
        let j: u64 = 0;
        while j < t.len {
            if t.buf[j].k == k { in_t = 1; }
            j = j + 1;
        }
        if in_t == 0 { w = w.push(MapE2 { k: k, cert: 2 }); }
        i = i + 1;
    }
    return w;
}

/// join_cert_map into c.ekills (which=0) or c.ckills (which=1).
fn join_killmap(own c: Checker, read t: vec.Vec<MapE2>,
                which: u8) -> Checker {
    if which == 0 {
        let w = jkm(c.heap, t, c.ekills);
        c.ekills.destroy(); c.ekills = w;
    } else {
        let w = jkm(c.heap, t, c.ckills);
        c.ckills.destroy(); c.ckills = w;
    }
    return c;
}

/// merge_envs over a branch-state's scopes (a = then base).
fn merge_envs2(own c: Checker, read a: BS) -> Checker {
    return merge_envs_v(c, a.binds, a.bnames, a.scopes);
}

/// merge_defer_frames — frame-wise union, dedup by call span.
fn merge_dframes(own c: Checker, read t: BS) -> Checker {
    let n = c.defers.len;
    if t.defers.len > n { n = t.defers.len; }
    let w = vec.Vec<vec.Vec<DeferRec>>::new(c.heap);
    let i: u64 = 0;
    while i < n {
        let f = vec.Vec<DeferRec>::new(c.heap);
        if i < c.defers.len {
            let j: u64 = 0;
            while j < c.defers.buf[i].len {
                f = f.push(c.defers.buf[i].buf[j]);
                j = j + 1;
            }
        }
        if i < t.defers.len {
            let j: u64 = 0;
            while j < t.defers.buf[i].len {
                let r = t.defers.buf[i].buf[j];
                // dedup by eid's span
                let has: u8 = 0;
                let q: u64 = 0;
                while q < f.len {
                    if f.buf[q].eid == r.eid { has = 1; }
                    q = q + 1;
                }
                if has == 0 { f = f.push(r); }
                j = j + 1;
            }
        }
        w = w.push(f);
        i = i + 1;
    }
    i = 0;
    while i < c.defers.len { c.defers.buf[i].destroy(); i = i + 1; }
    c.defers.destroy(); c.defers = w;
    return c;
}

fn check_if(own c: Checker, read p: ast.Parser,
            s: ast.Stmt, ret: u32) -> Checker {
    c = expr_tv(c, p, s.a);
    let pre_dead = c.diverged;
    let pre_term = c.terminated;
    // u32s[b..] = [nt, then..., haselse, else...]
    let nt = p.u32s.buf[u64(s.b)];
    let r0 = bs_take(c);
    c = r0.c; let pre = r0.bs;
    c = check_block(c, p, s.b + 1, s.b + 1 + nt, 0, ret);
    let then_d = c.diverged;
    let then_t = c.terminated;
    let r1 = bs_take(c);
    c = r1.c; let then = r1.bs;
    // restore pre for the else walk; flags reset live/cont
    let r2 = bs_dup(c, pre);
    c = r2.c;
    c = bs_install(c, r2.bs);
    // Stage-0 doesn't snapshot `tag` across `if` — the then-arm's
    // tag facts ride into the else walk, and whatever the else (or
    // absent-else) leaves is the merged tag.
    c.tag.destroy();
    c.tag = clone_tg(c.heap, then.tag);
    c.diverged = 0; c.terminated = 0;
    c = rec_flags(c);
    let has_else = p.u32s.buf[u64(s.b) + 1 + u64(nt)];
    if has_else == 1 {
        c = check_block(c, p, s.b + 2 + nt, s.b + s.c, 1, ret);
    }
    let else_d = c.diverged;
    let else_t = c.terminated;
    // statically-known arm? `if true`/`if false`
    let ce = p.exps.buf[u64(s.a)];
    let lit: u32 = NONE();
    if ek_num(ce.kind) == 1 { lit = ce.a; }
    if lit != NONE() {
        if lit == 1 {
            // install the then state wholesale — `tag` excluded
            // (Stage-0's lit install doesn't carry it either).
            let etag = clone_tg(c.heap, c.tag);
            bs_free(pre);
            c = bs_install(c, then);
            c.tag.destroy();
            c.tag = etag;
            c.diverged = then_d;
            c.terminated = then_t;
            c = rec_flags(c);
        } else {
            // else (or pre when absent) is already installed
            bs_free(pre);
            bs_free(then);
        }
    } else {
        if then_d == 1 || else_d == 1 {
            // a diverged arm contributes nothing — survivor wholesale
            if then_d == 1 {
                // else is already live; but chans keep post-else
                bs_free(then);
            } else {
                c = bs_install_surv(c, then);
            }
            bs_free(pre);
        } else {
            c = if_merge(c, then, pre);
            c = rec_joined(c, p, s.line, s.col);
            bs_free(pre);
        }
        // flags: diverged only when BOTH live arms diverge
        c.diverged = pre_dead;
        if has_else == 1 && then_d == 1 && else_d == 1 {
            c.diverged = 1;
        }
        c.terminated = pre_term;
        if then_t == 1 && else_t == 1 { c.terminated = 1; }
        c = rec_flags(c);
    }
    return c;
}

/// lsnap_take — clone live channels into a LoopSnap.
fn lsnap_take(own c: Checker) -> LSC {
    let s = LSnap {
        edges: clone_e2(c.heap, c.edges),
        caps: clone_c3(c.heap, c.caps),
        cons: clone_cf(c.heap, c.cons),
        init: clone_me2(c.heap, c.init),
        ekills: clone_me2(c.heap, c.ekills),
        ckills: clone_me2(c.heap, c.ckills),
        provs: clone_pv(c.heap, c.provs),
        transit: clone_u(c.heap, c.transit),
        tag: clone_tg(c.heap, c.tag),
        chans: clone_cq(c.heap, c.chans),
        defers: clone_df(c.heap, c.defers),
        dres: clone_dr(c.heap, c.dres) };
    return LSC { c: c, s: s };
}
pub struct LSC { c: Checker, s: LSnap }

/// restore_snap — wholesale channel install (no scopes/flags).
fn lsnap_install(own c: Checker, own s: LSnap) -> Checker {
    c.edges.destroy(); c.edges = s.edges;
    c.caps.destroy(); c.caps = s.caps;
    c.cons.destroy(); c.cons = s.cons;
    c.init.destroy(); c.init = s.init;
    c.ekills.destroy(); c.ekills = s.ekills;
    c.ckills.destroy(); c.ckills = s.ckills;
    c.provs.destroy(); c.provs = s.provs;
    c.transit.destroy(); c.transit = s.transit;
    c.tag.destroy(); c.tag = s.tag;
    c.chans.destroy(); c.chans = s.chans;
    c.defers.destroy(); c.defers = s.defers;
    c.dres.destroy(); c.dres = s.dres;
    return c;
}

/// join_snap — ctx := join(ctx, s): both-Def rules, unions for
/// transit/chans, tag same-variant-else-None; `(joined)` snapshot.
fn join_snap2(own c: Checker, read p: ast.Parser,
                own s: LSnap) -> Checker {
    // edges: union; Def iff both Def && same kind; born current-first
    let w = vec.Vec<E2>::new(c.heap);
    let i: u64 = 0;
    while i < c.edges.len {
        let e = c.edges.buf[i];
        let cert: u8 = 2;
        let bi = e2_has(s.edges, e.h, e.t);
        if bi >= 0 {
            let o = s.edges.buf[u64(bi)];
            if o.cert == 1 && e.cert == 1 && o.kind == e.kind {
                cert = 1;
            }
        }
        w = w.push(E2 { h: e.h, t: e.t, kind: e.kind,
            cert: cert, bl: e.bl, bc: e.bc });
        i = i + 1;
    }
    i = 0;
    while i < s.edges.len {
        let e = s.edges.buf[i];
        if e2_has(c.edges, e.h, e.t) < 0 {
            w = w.push(E2 { h: e.h, t: e.t, kind: e.kind,
                cert: 2, bl: e.bl, bc: e.bc });
        }
        i = i + 1;
    }
    c.edges.destroy(); c.edges = w;
    // caps
    let w2 = vec.Vec<C3>::new(c.heap);
    i = 0;
    while i < c.caps.len {
        let e = c.caps.buf[i];
        let cert: u8 = 2;
        if c3_get(s.caps, e.h, e.t) == 1 && e.cert == 1 { cert = 1; }
        w2 = w2.push(C3 { h: e.h, t: e.t, cert: cert });
        i = i + 1;
    }
    i = 0;
    while i < s.caps.len {
        let e = s.caps.buf[i];
        let in_cur: u8 = 0;
        let j: u64 = 0;
        while j < c.caps.len {
            if c.caps.buf[j].h == e.h && c.caps.buf[j].t == e.t {
                in_cur = 1;
            }
            j = j + 1;
        }
        if in_cur == 0 {
            w2 = w2.push(C3 { h: e.h, t: e.t, cert: 2 });
        }
        i = i + 1;
    }
    c.caps.destroy(); c.caps = w2;
    // cons: union; Cons iff both Cons
    let w3 = vec.Vec<CF>::new(c.heap);
    i = 0;
    while i < c.cons.len {
        let f = c.cons.buf[i];
        let bi = cf_get(s.cons, f.k);
        let st: u8 = 2;
        let bo: u32 = 0; let bl: u32 = NONE();
        if bi >= 0 {
            bo = s.cons.buf[u64(bi)].aoff;
            bl = s.cons.buf[u64(bi)].alen;
            if f.st == 1 && s.cons.buf[u64(bi)].st == 1 { st = 1; }
        }
        c = ats_merge(c, f.aoff, f.alen, bo, bl);
        let ao = c.res; let al = u32(c.res2);
        w3 = w3.push(CF { k: f.k, st: st, aoff: ao, alen: al });
        i = i + 1;
    }
    i = 0;
    while i < s.cons.len {
        let f = s.cons.buf[i];
        if cf_get(c.cons, f.k) < 0 {
            c = ats_merge(c, 0, NONE(), f.aoff, f.alen);
            let ao = c.res; let al = u32(c.res2);
            w3 = w3.push(CF { k: f.k, st: 2, aoff: ao, alen: al });
        }
        i = i + 1;
    }
    c.cons.destroy(); c.cons = w3;
    // init: union keys; Def iff init_covered on both
    let w4 = vec.Vec<MapE2>::new(c.heap);
    i = 0;
    while i < c.init.len {
        let k = c.init.buf[i].k;
        c = icov_c(c, k);
        let ca = c.res;
        c = icov(c, s.init, k);
        let cb = c.res;
        if ca == 1 && cb == 1 {
            w4 = w4.push(MapE2 { k: k, cert: 1 });
        } else { if ca != cb || ca == 1 || cb == 1 {
            w4 = w4.push(MapE2 { k: k, cert: 2 });
        } }
        i = i + 1;
    }
    i = 0;
    while i < s.init.len {
        let k = s.init.buf[i].k;
        let in_cur: u8 = 0;
        let j: u64 = 0;
        while j < c.init.len {
            if c.init.buf[j].k == k { in_cur = 1; }
            j = j + 1;
        }
        if in_cur == 0 {
            c = icov_c(c, k);
            let ca = c.res;
            c = icov(c, s.init, k);
            let cb = c.res;
            if ca == 1 && cb == 1 {
                w4 = w4.push(MapE2 { k: k, cert: 1 });
            } else { if ca != cb || ca == 1 || cb == 1 {
                w4 = w4.push(MapE2 { k: k, cert: 2 });
            } }
        }
        i = i + 1;
    }
    c.init.destroy(); c.init = w4;
    // kills: join_cert_map (current, snap)
    let wk = jkm(c.heap, c.ekills, s.ekills);
    c.ekills.destroy(); c.ekills = wk;
    let wk2 = jkm(c.heap, c.ckills, s.ckills);
    c.ckills.destroy(); c.ckills = wk2;
    // provs: base = snap's; current keys join vs snap
    let wp = clone_pv(c.heap, s.provs);
    i = 0;
    while i < c.provs.len {
        let pv2 = c.provs.buf[i];
        let bi = pv_get(s.provs, pv2.k);
        let opk = pv2.pk; let opv = pv2.pv;
        if bi >= 0 {
            opk = s.provs.buf[u64(bi)].pk;
            opv = s.provs.buf[u64(bi)].pv;
        }
        c = jprov(c, pv2.pk, pv2.pv, opk, opv);
        let pk2 = u8(c.res); let pv3 = c.res2;
        // upsert into wp (snap base)
        let has: i64 = pv_get(wp, pv2.k);
        if has >= 0 {
            wp.buf[u64(has)].pk = pk2;
            wp.buf[u64(has)].pv = pv3;
        } else {
            wp = wp.push(PV { k: pv2.k, pk: pk2, pv: pv3 });
        }
        i = i + 1;
    }
    c.provs.destroy(); c.provs = wp;
    // transit union
    i = 0;
    while i < s.transit.len {
        if vhas(c.transit, s.transit.buf[i]) == 0 {
            c.transit = c.transit.push(s.transit.buf[i]);
        }
        i = i + 1;
    }
    // chans: per-key max len
    i = 0;
    while i < s.chans.len {
        let ck2 = s.chans.buf[i].k;
        let sn = s.chans.buf[i].pkts.len;
        let j: u64 = 0;
        let seen: u8 = 0;
        while j < c.chans.len {
            if c.chans.buf[j].k == ck2 {
                seen = 1;
                if sn > c.chans.buf[j].pkts.len {
                    let np = vec.Vec<Packet>::new(c.heap);
                    let q: u64 = 0;
                    while q < sn {
                        np = np.push(s.chans.buf[i].pkts.buf[q]);
                        q = q + 1;
                    }
                    c.chans.buf[j].pkts.destroy();
                    c.chans.buf[j].pkts = np;
                }
            }
            j = j + 1;
        }
        if seen == 0 {
            let np = vec.Vec<Packet>::new(c.heap);
            let q: u64 = 0;
            while q < sn {
                np = np.push(s.chans.buf[i].pkts.buf[q]);
                q = q + 1;
            }
            c.chans = c.chans.push(CQ { k: ck2, pkts: np });
        }
        i = i + 1;
    }
    // tag: union keys; same definite variant survives, else None
    i = 0;
    while i < s.tag.len {
        let tk = s.tag.buf[i].k;
        let sv = s.tag.buf[i].v;
        let has: i64 = 0 - 1;
        let j: u64 = 0;
        while j < c.tag.len {
            if c.tag.buf[j].k == tk { has = i64(j); }
            j = j + 1;
        }
        if has < 0 {
            // key only on the other path -> known-enum unknown-variant
            c.tag = c.tag.push(TG { k: tk, v: NONE(), has: 1 });
        } else {
            let cv = c.tag.buf[u64(has)].v;
            let same: u8 = 0;
            if cv != NONE() && sv != NONE() && cv == sv { same = 1; }
            if same == 0 {
                c.tag.buf[u64(has)].v = NONE();
                c.tag.buf[u64(has)].has = 1;
            }
        }
        i = i + 1;
    }
    i = 0;
    while i < c.tag.len {
        let tk = c.tag.buf[i].k;
        let in_s: u8 = 0;
        let j: u64 = 0;
        while j < s.tag.len {
            if s.tag.buf[j].k == tk { in_s = 1; }
            j = j + 1;
        }
        if in_s == 0 {
            c.tag.buf[i].v = NONE();
            c.tag.buf[i].has = 1;
        }
        i = i + 1;
    }
    // defers/dres union-merge
    let n = c.defers.len;
    if s.defers.len > n { n = s.defers.len; }
    let w5 = vec.Vec<vec.Vec<DeferRec>>::new(c.heap);
    i = 0;
    while i < n {
        let f = vec.Vec<DeferRec>::new(c.heap);
        if i < c.defers.len {
            let j: u64 = 0;
            while j < c.defers.buf[i].len {
                f = f.push(c.defers.buf[i].buf[j]);
                j = j + 1;
            }
        }
        if i < s.defers.len {
            let j: u64 = 0;
            while j < s.defers.buf[i].len {
                let r = s.defers.buf[i].buf[j];
                let has: u8 = 0;
                let q: u64 = 0;
                while q < f.len {
                    if f.buf[q].eid == r.eid { has = 1; }
                    q = q + 1;
                }
                if has == 0 { f = f.push(r); }
                j = j + 1;
            }
        }
        w5 = w5.push(f);
        i = i + 1;
    }
    i = 0;
    while i < c.defers.len { c.defers.buf[i].destroy(); i = i + 1; }
    c.defers.destroy(); c.defers = w5;
    i = 0;
    while i < s.dres.len {
        let dr = s.dres.buf[i];
        let has: u8 = 0;
        let q: u64 = 0;
        while q < c.dres.len {
            if c.dres.buf[q].k == dr.k { has = 1; }
            q = q + 1;
        }
        if has == 0 { c.dres = c.dres.push(dr); }
        i = i + 1;
    }
    lsnap_destroy(s);
    c = rec_joined(c, p, NONE(), NONE());
    return c;
}

/// merge_envs over explicit scope vecs (a = out base, c = other).
fn merge_envs_v(own c: Checker, read ab: vec.Vec<CBind>,
                read abn: vec.Vec<KK>,
                read asc: vec.Vec<u32>) -> Checker {
    let bn = vec.Vec<KK>::new(c.heap);
    let sc = vec.Vec<u32>::new(c.heap);
    let nb = clone_cb(c.heap, ab);
    let lv: u64 = 0;
    while lv < asc.len {
        let ao = u64(asc.buf[lv]);
        let ae = abn.len;
        if lv + 1 < asc.len {
            ae = u64(asc.buf[lv + 1]);
        }
        sc = sc.push(u32(bn.len));
        let j: u64 = ao;
        while j < ae {
            let nm = abn.buf[j];
            let bind = nb.buf[u64(nm.v)];
            let skip: u8 = 0;
            if bind.prov_k == 2 && bind.prov_v >= u32(c.regs.len) {
                skip = 1;
            }
            if skip == 0 {
                let found: i64 = 0 - 1;
                if lv < c.scopes.len {
                    let co = u64(c.scopes.buf[lv]);
                    let ce = c.bnames.len;
                    if lv + 1 < c.scopes.len {
                        ce = u64(c.scopes.buf[lv + 1]);
                    }
                    let q = ce;
                    while q > co {
                        q = q - 1;
                        if c.bnames.buf[q].k == nm.k {
                            found = i64(q); break;
                        }
                    }
                }
                if found < 0 {
                    j = j + 1; continue;
                }
                let ob = c.binds.buf[
                    u64(c.bnames.buf[u64(found)].v)];
                c = jprov(c, bind.prov_k, bind.prov_v,
                          ob.prov_k, ob.prov_v);
                nb.buf[u64(nm.v)].prov_k = u8(c.res);
                nb.buf[u64(nm.v)].prov_v = c.res2;
                if ob.owner > bind.owner {
                    nb.buf[u64(nm.v)].owner = ob.owner;
                }
            }
            bn = bn.push(KK { k: nm.k, v: nm.v });
            j = j + 1;
        }
        lv = lv + 1;
    }
    c.binds.destroy(); c.binds = nb;
    c.bnames.destroy(); c.bnames = bn;
    c.scopes.destroy(); c.scopes = sc;
    return c;
}

/// Stmt::While — cond, body, loop-exit join per exit snapshot.
fn check_while(own c: Checker, read p: ast.Parser,
               s: ast.Stmt, ret: u32) -> Checker {
    c = es(c, "(while @");
    c = eu(c, u64(s.line));
    c = ec(c, u8(58));
    c = eu(c, u64(s.col));
    c = ec(c, u8(41));
    c = rec(c);
    c = expr_tv(c, p, s.a);
    let pre_dead = c.diverged;
    let pre_term = c.terminated;
    let sb = clone_cb(c.heap, c.binds);
    let sbn = clone_kk(c.heap, c.bnames);
    let ssc = clone_u(c.heap, c.scopes);
    let r0 = lsnap_take(c);
    c = r0.c; let pre = r0.s;
    c.loops = c.loops.push(LoopCtx {
        depth: u32(c.scopes.len),
        breaks: vec.Vec<LSnap>::new(c.heap),
        conts: vec.Vec<LSnap>::new(c.heap) });
    // the cond's `$rv` temps re-materialize at the back-edge — the
    // lowering appends `$rvN = <call>` to the body. Hand the range
    // to check_block; inner whiles overwrite wh_lo/wh_hi.
    c.tail_lo = c.wh_lo;
    c.tail_hi = c.wh_hi;
    c = check_block(c, p, s.b, s.b + s.c, 0, ret);
    let lc = c.loops.pop();
    let body_d = c.diverged;
    let body_t = c.terminated;
    // body scopes <-> saved scopes
    let bb = clone_cb(c.heap, c.binds);
    let bbn = clone_kk(c.heap, c.bnames);
    let bsc = clone_u(c.heap, c.scopes);
    c.binds.destroy(); c.binds = sb;
    c.bnames.destroy(); c.bnames = sbn;
    c.scopes.destroy(); c.scopes = ssc;
    let r1 = lsnap_take(c);
    c = r1.c; let body_snap = r1.s;
    // exit list: breaks, conts (!is_true), fall-through (!d).
    // `exits` is built REVERSED so pop_own yields forward order.
    let ce = p.exps.buf[u64(s.a)];
    let is_true: u8 = 0;
    if ek_num(ce.kind) == 1 && ce.a == 1 { is_true = 1; }
    let exits = vec.Vec<LSnap>::new(c.heap);
    if is_true == 0 {
        if body_d == 0 { exits = exits.push(body_snap); }
        else { lsnap_destroy(body_snap); }
        while lc.conts.len > 0 {
            let pp = lc.conts.pop_own();
            lc.conts = pp.v;
            exits = exits.push(pp.x);
        }
        while lc.breaks.len > 0 {
            let pp = lc.breaks.pop_own();
            lc.breaks = pp.v;
            exits = exits.push(pp.x);
        }
    } else {
        lsnap_destroy(body_snap);
        while lc.conts.len > 0 {
            let pp = lc.conts.pop_own();
            lc.conts = pp.v;
            lsnap_destroy(pp.x);
        }
        while lc.breaks.len > 0 {
            let pp = lc.breaks.pop_own();
            lc.breaks = pp.v;
            exits = exits.push(pp.x);
        }
    }
    let no_out: u8 = 0;
    if exits.len == 0 { no_out = 1; }
    if is_true == 1 && no_out == 0 {
        let pp = exits.pop_own();
        exits = pp.v;
        c = lsnap_install(c, pp.x);
        lsnap_destroy(pre);
    } else {
        c = lsnap_install(c, pre);
    }
    while exits.len > 0 {
        let pp = exits.pop_own();
        exits = pp.v;
        c = join_snap2(c, p, pp.x);
    }
    exits.destroy();
    if is_true == 1 && no_out == 1 {
        c.diverged = 1;
        c.terminated = body_t;
        c = rec_flags(c);
    } else {
        c.diverged = pre_dead;
        c.terminated = pre_term;
        c = rec_flags(c);
    }
    lc.breaks.destroy(); lc.conts.destroy();
    c = merge_envs_v(c, bb, bbn, bsc);
    bb.destroy(); bbn.destroy(); bsc.destroy();
    return c;
}

/// Stmt::Break | Stmt::Continue — N25D: drain scopes deeper than the
/// loop's (defers replay, bindings expire at the kw's span), snapshot
/// the exit state into the loop's breaks/conts, re-push empty frames
/// so each enclosing block's natural pop stays balanced, then mark
/// this path diverged.
fn check_brk(own c: Checker, read p: ast.Parser,
             s: ast.Stmt, ret: u32) -> Checker {
    let is_break = sk_num(s.kind) == 5;
    if c.loops.len == 0 {
        let m = vec.Vec<u8>::new(c.heap);
        let m2 = m.push(u8(96));
        let m3 = resolve.bputs(m2, "break");
        if !is_break {
            let mx = vec.Vec<u8>::new(c.heap);
            let mx2 = mx.push(u8(96));
            let mx3 = resolve.bputs(mx2, "continue");
            m3.destroy();
            let m4 = resolve.bputs(mx3, "` outside a loop");
            c = pdiag(c, s.line, s.col, m4.as_slice());
            m4.destroy();
        } else {
            let m4 = resolve.bputs(m3, "` outside a loop");
            c = pdiag(c, s.line, s.col, m4.as_slice());
            m4.destroy();
        }
        return c;
    }
    let depth = u64(c.loops.buf[u64(c.loops.len - 1)].depth);
    let drained: u64 = 0;
    while u64(c.scopes.len) > depth {
        c = pop_scope_defers(c, p);
        let cp = pop_scope_names(c);
        c = cp.c;
        if is_break {
            c = expire_scope(c, cp.popped, s.line, s.col, 1,
                "this `break` exits");
        } else {
            c = expire_scope(c, cp.popped, s.line, s.col, 1,
                "this `continue` exits");
        }
        drained = drained + 1;
    }
    let r0 = lsnap_take(c);
    c = r0.c; let snap = r0.s;
    let lc = c.loops.pop();
    if is_break {
        lc.breaks = lc.breaks.push(snap);
    } else {
        lc.conts = lc.conts.push(snap);
    }
    c.loops = c.loops.push(lc);
    // balance frames — enclosing blocks pop these naturally
    let j: u64 = 0;
    while j < drained {
        c.scopes = c.scopes.push(u32(c.bnames.len));
        c.defers = c.defers.push(vec.Vec<DeferRec>::new(c.heap));
        j = j + 1;
    }
    c.diverged = 1;
    c = rec_flags(c);
    return c;
}

/// reaches_own — `t` embeds own authority inline (box/box slice
/// reached through struct fields, enum payloads, arrays, atoms).
/// Cyclic types can't exist (the resolver rejects them), so no
/// seen-set. res = 1|0.
fn reaches_own(own c: Checker, ty: u32) -> Checker {
    c.res = 0;
    let tn = c.r.rtys.buf[u64(ty)];
    if tn.kind == 24 || tn.kind == 25 {              // box | box slice
        c.res = 1;
        return c;
    }
    if tn.kind == 20 || tn.kind == 14 {              // atomic | array
        return reaches_own(c, tn.a);
    }
    if tn.kind == 12 || tn.kind == 13 {              // struct | app
        let ei = edecl_of(c, tn.name);
        if ei != NONE() {
            let ed = c.r.edecls.buf[u64(ei)];
            let i: u64 = 0;
            while i < u64(ed.vs_len) {
                let vd = c.r.vars.buf[u64(ed.vs_off) + i];
                if vd.ty != NONE() {
                    c = reaches_own(c, vd.ty);
                    if c.res == 1 { return c; }
                }
                i = i + 1;
            }
            return c;
        }
        c = sfields_of(c, ty);
        if c.res != NONE() {
            let f0 = c.res; let fn2 = c.res2;
            let i: u64 = 0;
            while i < u64(fn2) {
                let fd = c.r.sfields.buf[u64(f0) + i];
                c = reaches_own(c, fd.ty);
                if c.res == 1 { return c; }
                i = i + 1;
            }
        }
        c.res = 0;
        return c;
    }
    return c;
}

/// cons_sil — insert/update a consumed fact with no event (the
/// dead-variant mark rides `ctx.consumed.insert` silently).
fn cons_sil(own c: Checker, k: u32, st: u8,
            aoff: u32, alen: u32) -> Checker {
    let i: u64 = 0;
    while i < c.cons.len {
        if c.cons.buf[i].k == k {
            c.cons.buf[i].st = st;
            c.cons.buf[i].aoff = aoff;
            c.cons.buf[i].alen = alen;
            return c;
        }
        i = i + 1;
    }
    c.cons = c.cons.push(CF { k: k, st: st, aoff: aoff, alen: alen });
    return c;
}

/// key_pref — `k == p` or `k` starts `p.` — the dead-variant prefix
/// test (payload paths are `key.V`).
fn key_pref(read c: Checker, k: u32, p2: u32) -> u8 {
    if k == p2 { return 1; }
    let sk = c.kns.buf[u64(k)];
    let sp = c.kns.buf[u64(p2)];
    if u64(sk.len) <= u64(sp.len) { return 0; }
    let i: u64 = 0;
    while i < u64(sp.len) {
        if c.kbyt.buf[u64(sk.off) + i] != c.kbyt.buf[u64(sp.off) + i] {
            return 0;
        }
        i = i + 1;
    }
    if c.kbyt.buf[u64(sk.off) + u64(sp.len)] == u8(46) { return 1; }
    return 0;
}

/// mdead_prune — drop every edge/cap whose holder or target lives
/// under a dead-variant prefix. Silent — Stage-0's `edges_retain`/
/// mdead_prune — drop every edge/cap whose holder or target lives
/// under a dead-variant prefix. Per prefix: collect → sort → emit
/// `(unedge …)`/`(uncap …)` — stage-0's `edges_retain`/`caps_retain`
/// emit sorted pairs.
fn mdead_prune(own c: Checker, read prefs: vec.Vec<u32>) -> Checker {
    let i: u64 = 0;
    while i < prefs.len {
        let p2 = prefs.buf[i];
        let dead = vec.Vec<E2>::new(c.heap);
        let j: u64 = 0;
        while j < c.edges.len {
            let e = c.edges.buf[j];
            if key_pref(c, e.h, p2) == 1
                || key_pref(c, e.t, p2) == 1 { dead = dead.push(e); }
            j = j + 1;
        }
        let dead2 = esort(c, dead);
        j = 0;
        while j < dead2.len {
            c = unedge(c, dead2.buf[j].h, dead2.buf[j].t);
            j = j + 1;
        }
        dead2.destroy();
        let deadc = vec.Vec<C3>::new(c.heap);
        j = 0;
        while j < c.caps.len {
            let e = c.caps.buf[j];
            if key_pref(c, e.h, p2) == 1
                || key_pref(c, e.t, p2) == 1 { deadc = deadc.push(e); }
            j = j + 1;
        }
        let deadc2 = csort(c, deadc);
        j = 0;
        while j < deadc2.len {
            c = uncap(c, deadc2.buf[j].h, deadc2.buf[j].t);
            j = j + 1;
        }
        deadc2.destroy();
        i = i + 1;
    }
    return c;
}

/// place_auth_k — key-level place_auth for the payload path `k.V`:
/// every edge arriving at `k` either rides a path holder (its kind
/// downgrades) or is foreign (drops to Read). Holders inside `k`'s
/// subtree don't count. Returns 3 own | 2 write | 1 read.
fn place_auth_k(read c: Checker, k: u32,
                read holders: vec.Vec<u32>) -> u32 {
    let own: u8 = 1;
    let wr: u8 = 1;
    let i: u64 = 0;
    while i < c.edges.len {
        let e = c.edges.buf[i];
        if overlap(c, e.t, k) == 1 {
            let inh: u8 = 0;
            let j: u64 = 0;
            while j < holders.len {
                if holders.buf[j] == e.h { inh = 1; }
                j = j + 1;
            }
            if inh == 1 {
                if e.kind != 3 {
                    if e.kind == 2 { own = 0; }
                    else { own = 0; wr = 0; }
                }
            } else {
                if key_under(c, e.h, k) == 0 { own = 0; wr = 0; }
            }
        }
        i = i + 1;
    }
    if own == 1 { return 3; }
    if wr == 1 { return 2; }
    return 1;
}

/// ri_to_sort — sort the ri_to range [off, len) (target lists are
/// collected into a shared arena; canonical order is by key bytes).
fn ri_to_sort(own c: Checker, off: u64) -> Checker {
    let i = off + 1;
    while i < c.ri_to.len {
        let x = c.ri_to.buf[i];
        let j = i;
        while j > off && kless(c, x, c.ri_to.buf[j - 1]) == 1 {
            c.ri_to.buf[j] = c.ri_to.buf[j - 1];
            j = j - 1;
        }
        c.ri_to.buf[j] = x;
        i = i + 1;
    }
    return c;
}

/// in_foreign — is `k` on the foreign set? (read-only probe;
/// `foreign_set` itself emits and inserts.)
fn in_foreign(read c: Checker, k: u32) -> u8 {
    let i: u64 = 0;
    while i < c.foreign.len {
        if c.foreign.buf[i] == k { return 1; }
        i = i + 1;
    }
    return 0;
}

/// collect_lit_k — key-level `collect_lit`: every fact rooted at `k`
/// or below becomes a rel-keyed lit packet (`""` = k's own level) so
/// `record_lit_fields` can re-root it under the destination key.
/// Mirrors stage-0's ordering: "" first, children sorted by rel;
/// provs see only `k.` descendants (the root prov rides the bind).
fn collect_lit_k(own c: Checker, k: u32) -> Checker {
    c = kstr(c, "");
    let erel = c.res;
    // ---- edges — "" group first, then rels sorted ----
    let toff = u32(c.ri_to.len);
    let m_: u8 = 0;
    let i: u64 = 0;
    while i < c.edges.len {
        let e = c.edges.buf[i];
        if e.h == k {
            c.ri_to = c.ri_to.push(e.t);
            if e.kind == 2 { m_ = 1; }
        }
        i = i + 1;
    }
    c = ri_to_sort(c, u64(toff));
    let fr = in_foreign(c, k);
    if u32(c.ri_to.len) > toff || fr == 1 {
        c.rinfos = c.rinfos.push(RefInf {
            toff: toff, tlen: u32(c.ri_to.len) - toff,
            mut_: m_, mf: NONE(), foreign: fr });
        c.lit_edges = c.lit_edges.push(RLE {
            rel: erel, ri: u32(c.rinfos.len) - 1 });
        c.has_lit = 1;
    }
    // child holder rels — distinct, sorted
    let rels = vec.Vec<u32>::new(c.heap);
    i = 0;
    while i < c.edges.len {
        let h = c.edges.buf[i].h;
        if h != k && kprefix(c, k, h) == 1 {
            c = key_rel_nd(c, h, k);
            if vhas(rels, c.res) == 0 { rels = rels.push(c.res); }
        }
        i = i + 1;
    }
    let rels2 = ksort(c, rels);
    i = 0;
    while i < rels2.len {
        let rl = rels2.buf[i];
        c = key_join_rel(c, k, rl);
        let hk = c.res;
        let toff2 = u32(c.ri_to.len);
        let m2: u8 = 0;
        let j: u64 = 0;
        while j < c.edges.len {
            let e = c.edges.buf[j];
            if e.h == hk {
                let seen: u8 = 0;
                let q = u64(toff2);
                while q < c.ri_to.len {
                    if c.ri_to.buf[q] == e.t { seen = 1; }
                    q = q + 1;
                }
                if seen == 0 { c.ri_to = c.ri_to.push(e.t); }
                if e.kind == 2 { m2 = 1; }
            }
            j = j + 1;
        }
        c = ri_to_sort(c, u64(toff2));
        c.rinfos = c.rinfos.push(RefInf {
            toff: toff2, tlen: u32(c.ri_to.len) - toff2,
            mut_: m2, mf: NONE(), foreign: in_foreign(c, hk) });
        c.lit_edges = c.lit_edges.push(RLE {
            rel: rl, ri: u32(c.rinfos.len) - 1 });
        c.has_lit = 1;
        i = i + 1;
    }
    rels2.destroy();
    // ---- caps — "" group first, then rels sorted ----
    let coff = u32(c.rlc_keys.len);
    i = 0;
    while i < c.caps.len {
        let e = c.caps.buf[i];
        if e.h == k { c.rlc_keys = c.rlc_keys.push(e.t); }
        i = i + 1;
    }
    // sort the cap range in place
    let q0 = u64(coff) + 1;
    while q0 < c.rlc_keys.len {
        let x = c.rlc_keys.buf[q0];
        let j = q0;
        while j > u64(coff)
            && kless(c, x, c.rlc_keys.buf[j - 1]) == 1 {
            c.rlc_keys.buf[j] = c.rlc_keys.buf[j - 1];
            j = j - 1;
        }
        c.rlc_keys.buf[j] = x;
        q0 = q0 + 1;
    }
    if u32(c.rlc_keys.len) > coff {
        c.lit_caps = c.lit_caps.push(RLE2 {
            rel: erel, off: coff,
            len: u32(c.rlc_keys.len) - coff });
        c.has_lit = 1;
    }
    let crels = vec.Vec<u32>::new(c.heap);
    i = 0;
    while i < c.caps.len {
        let h = c.caps.buf[i].h;
        if h != k && kprefix(c, k, h) == 1 {
            c = key_rel_nd(c, h, k);
            if vhas(crels, c.res) == 0 { crels = crels.push(c.res); }
        }
        i = i + 1;
    }
    let crels2 = ksort(c, crels);
    i = 0;
    while i < crels2.len {
        let rl = crels2.buf[i];
        c = key_join_rel(c, k, rl);
        let hk = c.res;
        let coff2 = u32(c.rlc_keys.len);
        let j: u64 = 0;
        while j < c.caps.len {
            let e = c.caps.buf[j];
            if e.h == hk {
                let seen: u8 = 0;
                let q = u64(coff2);
                while q < c.rlc_keys.len {
                    if c.rlc_keys.buf[q] == e.t { seen = 1; }
                    q = q + 1;
                }
                if seen == 0 { c.rlc_keys = c.rlc_keys.push(e.t); }
            }
            j = j + 1;
        }
        let q1 = u64(coff2) + 1;
        while q1 < c.rlc_keys.len {
            let x = c.rlc_keys.buf[q1];
            let j2 = q1;
            while j2 > u64(coff2)
                && kless(c, x, c.rlc_keys.buf[j2 - 1]) == 1 {
                c.rlc_keys.buf[j2] = c.rlc_keys.buf[j2 - 1];
                j2 = j2 - 1;
            }
            c.rlc_keys.buf[j2] = x;
            q1 = q1 + 1;
        }
        c.lit_caps = c.lit_caps.push(RLE2 {
            rel: rl, off: coff2,
            len: u32(c.rlc_keys.len) - coff2 });
        c.has_lit = 1;
        i = i + 1;
    }
    crels2.destroy();
    // ---- provs — `k.` descendants only, sorted ----
    let prels = vec.Vec<u32>::new(c.heap);
    i = 0;
    while i < c.provs.len {
        let pk = c.provs.buf[i].k;
        if pk != k && kprefix(c, k, pk) == 1 {
            c = key_rel_nd(c, pk, k);
            if vhas(prels, c.res) == 0 { prels = prels.push(c.res); }
        }
        i = i + 1;
    }
    let prels2 = ksort(c, prels);
    i = 0;
    while i < prels2.len {
        let rl = prels2.buf[i];
        c = key_join_rel(c, k, rl);
        let pv = prov_at(c, c.res);
        c.last_lit = c.last_lit.push(
            PV { k: rl, pk: pv.pk, pv: pv.pv });
        c.has_lit = 1;
        i = i + 1;
    }
    prels2.destroy();
    // ---- dead — `k.` consumed marks, sorted by rel ----
    let drels = vec.Vec<u32>::new(c.heap);
    i = 0;
    while i < c.cons.len {
        let ck = c.cons.buf[i].k;
        if ck != k && kprefix(c, k, ck) == 1 {
            c = key_rel_nd(c, ck, k);
            if vhas(drels, c.res) == 0 { drels = drels.push(c.res); }
        }
        i = i + 1;
    }
    let drels2 = ksort(c, drels);
    i = 0;
    while i < drels2.len {
        let rl = drels2.buf[i];
        c = key_join_rel(c, k, rl);
        let hk = c.res;
        let j: u64 = 0;
        while j < c.cons.len {
            if c.cons.buf[j].k == hk {
                c.lit_dead_cfs = c.lit_dead_cfs.push(c.cons.buf[j]);
                c.lit_dead = c.lit_dead.push(LCF {
                    rel: rl, cf: u32(c.lit_dead_cfs.len) - 1 });
                c.has_lit = 1;
            }
            j = j + 1;
        }
        i = i + 1;
    }
    drels2.destroy();
    // ---- lens — "" first, then children sorted ----
    i = 0;
    while i < c.slens.len {
        if c.slens.buf[i].k == k {
            c.lit_lens = c.lit_lens.push(
                KI { k: erel, n: c.slens.buf[i].n });
            c.has_lit = 1;
        }
        i = i + 1;
    }
    let lrels = vec.Vec<u32>::new(c.heap);
    i = 0;
    while i < c.slens.len {
        let lk = c.slens.buf[i].k;
        if lk != k && kprefix(c, k, lk) == 1 {
            c = key_rel_nd(c, lk, k);
            if vhas(lrels, c.res) == 0 { lrels = lrels.push(c.res); }
        }
        i = i + 1;
    }
    let lrels2 = ksort(c, lrels);
    i = 0;
    while i < lrels2.len {
        let rl = lrels2.buf[i];
        c = key_join_rel(c, k, rl);
        let hk = c.res;
        let j: u64 = 0;
        while j < c.slens.len {
            if c.slens.buf[j].k == hk {
                c.lit_lens = c.lit_lens.push(
                    KI { k: rl, n: c.slens.buf[j].n });
                c.has_lit = 1;
            }
            j = j + 1;
        }
        i = i + 1;
    }
    lrels2.destroy();
    // ---- tags — "" first, then children sorted ----
    let tvs = tagv_at(c, k);
    if tvs != NONE() {
        c.lit_tags = c.lit_tags.push(
            TG { k: erel, v: tvs, has: 1 });
        c.has_lit = 1;
    }
    let trels = vec.Vec<u32>::new(c.heap);
    i = 0;
    while i < c.tag.len {
        let tk = c.tag.buf[i].k;
        if tk != k && kprefix(c, k, tk) == 1 {
            c = key_rel_nd(c, tk, k);
            if vhas(trels, c.res) == 0 { trels = trels.push(c.res); }
        }
        i = i + 1;
    }
    let trels2 = ksort(c, trels);
    i = 0;
    while i < trels2.len {
        let rl = trels2.buf[i];
        c = key_join_rel(c, k, rl);
        let hk = c.res;
        let j: u64 = 0;
        while j < c.tag.len {
            if c.tag.buf[j].k == hk {
                c.lit_tags = c.lit_tags.push(
                    TG { k: rl, v: c.tag.buf[j].v, has: 1 });
                c.has_lit = 1;
            }
            j = j + 1;
        }
        i = i + 1;
    }
    trels2.destroy();
    // ---- csafe — "" for k itself, children sorted ----
    let srels = vec.Vec<u32>::new(c.heap);
    i = 0;
    while i < c.csafe.len {
        let ck = c.csafe.buf[i];
        if ck == k {
            if vhas(srels, erel) == 0 { srels = srels.push(erel); }
        } else {
            if kprefix(c, k, ck) == 1 {
                c = key_rel_nd(c, ck, k);
                if vhas(srels, c.res) == 0 {
                    srels = srels.push(c.res);
                }
            }
        }
        i = i + 1;
    }
    let srels2 = ksort(c, srels);
    i = 0;
    while i < srels2.len {
        c.lit_csafe = c.lit_csafe.push(srels2.buf[i]);
        c.has_lit = 1;
        i = i + 1;
    }
    srels2.destroy();
    return c;
}

/// pkt_drain — lift the whole lit_* channel set into a saved packet
/// (stage-0's per-key `collect_lit` for `replace`/`swap`). Pool
/// entries copy into packet-private vecs so later channel traffic
/// can't disturb the snapshot.
fn pkt_drain(own c: Checker) -> LPR {
    let pk = LPKT {
        le_rel: vec.Vec<u32>::new(c.heap),
        le_ri: vec.Vec<RefInf>::new(c.heap),
        le_pool: vec.Vec<u32>::new(c.heap),
        lc: vec.Vec<RLE2>::new(c.heap),
        lc_keys: vec.Vec<u32>::new(c.heap),
        ld_rel: vec.Vec<u32>::new(c.heap),
        ld_cf: vec.Vec<CF>::new(c.heap),
        ll: vec.Vec<KI>::new(c.heap),
        lt: vec.Vec<TG>::new(c.heap),
        lcs: vec.Vec<u32>::new(c.heap),
        lp: vec.Vec<PV>::new(c.heap) };
    let q: u64 = 0;
    while q < c.lit_edges.len {
        let e0 = c.lit_edges.buf[q];
        let ri0 = c.rinfos.buf[u64(e0.ri)];
        let toff = u32(pk.le_pool.len);
        let j: u64 = 0;
        while j < u64(ri0.tlen) {
            pk.le_pool = pk.le_pool.push(
                c.ri_to.buf[u64(ri0.toff) + j]);
            j = j + 1;
        }
        pk.le_ri = pk.le_ri.push(RefInf {
            toff: toff, tlen: ri0.tlen, mut_: ri0.mut_,
            mf: ri0.mf, foreign: ri0.foreign });
        pk.le_rel = pk.le_rel.push(e0.rel);
        q = q + 1;
    }
    while c.lit_edges.len > 0 { c.lit_edges.pop(); }
    q = 0;
    while q < c.lit_caps.len {
        let e0 = c.lit_caps.buf[q];
        let coff = u32(pk.lc_keys.len);
        let j: u64 = 0;
        while j < u64(e0.len) {
            pk.lc_keys = pk.lc_keys.push(
                c.rlc_keys.buf[u64(e0.off) + j]);
            j = j + 1;
        }
        pk.lc = pk.lc.push(RLE2 {
            rel: e0.rel, off: coff, len: e0.len });
        q = q + 1;
    }
    while c.lit_caps.len > 0 { c.lit_caps.pop(); }
    q = 0;
    while q < c.lit_dead.len {
        let e0 = c.lit_dead.buf[q];
        pk.ld_rel = pk.ld_rel.push(e0.rel);
        pk.ld_cf = pk.ld_cf.push(c.lit_dead_cfs.buf[u64(e0.cf)]);
        q = q + 1;
    }
    while c.lit_dead.len > 0 { c.lit_dead.pop(); }
    while c.lit_dead_cfs.len > 0 { c.lit_dead_cfs.pop(); }
    q = 0;
    while q < c.lit_lens.len {
        pk.ll = pk.ll.push(c.lit_lens.buf[q]);
        q = q + 1;
    }
    while c.lit_lens.len > 0 { c.lit_lens.pop(); }
    q = 0;
    while q < c.lit_tags.len {
        pk.lt = pk.lt.push(c.lit_tags.buf[q]);
        q = q + 1;
    }
    while c.lit_tags.len > 0 { c.lit_tags.pop(); }
    q = 0;
    while q < c.lit_csafe.len {
        pk.lcs = pk.lcs.push(c.lit_csafe.buf[q]);
        q = q + 1;
    }
    while c.lit_csafe.len > 0 { c.lit_csafe.pop(); }
    q = 0;
    while q < c.last_lit.len {
        pk.lp = pk.lp.push(c.last_lit.buf[q]);
        q = q + 1;
    }
    while c.last_lit.len > 0 { c.last_lit.pop(); }
    c.has_lit = 0;
    return LPR { c: c, pk: pk };
}

/// pkt_push — feed a saved packet back into the lit_* channels
/// (stage-0's `push_lit`) so the next record_lit_fields re-roots it.
fn pkt_push(own c: Checker, read pk: LPKT) -> Checker {
    let q: u64 = 0;
    while q < pk.le_rel.len {
        let ri0 = pk.le_ri.buf[q];
        let toff = u32(c.ri_to.len);
        let w: u64 = 0;
        while w < u64(ri0.tlen) {
            c.ri_to = c.ri_to.push(pk.le_pool.buf[u64(ri0.toff) + w]);
            w = w + 1;
        }
        c.rinfos = c.rinfos.push(RefInf {
            toff: toff, tlen: ri0.tlen, mut_: ri0.mut_,
            mf: ri0.mf, foreign: ri0.foreign });
        c.lit_edges = c.lit_edges.push(RLE {
            rel: pk.le_rel.buf[q], ri: u32(c.rinfos.len) - 1 });
        q = q + 1;
    }
    q = 0;
    while q < pk.lc.len {
        let e0 = pk.lc.buf[q];
        let coff = u32(c.rlc_keys.len);
        let w: u64 = 0;
        while w < u64(e0.len) {
            c.rlc_keys = c.rlc_keys.push(
                pk.lc_keys.buf[u64(e0.off) + w]);
            w = w + 1;
        }
        c.lit_caps = c.lit_caps.push(RLE2 {
            rel: e0.rel, off: coff, len: e0.len });
        q = q + 1;
    }
    q = 0;
    while q < pk.ld_rel.len {
        c.lit_dead_cfs = c.lit_dead_cfs.push(pk.ld_cf.buf[q]);
        c.lit_dead = c.lit_dead.push(LCF {
            rel: pk.ld_rel.buf[q],
            cf: u32(c.lit_dead_cfs.len) - 1 });
        q = q + 1;
    }
    q = 0;
    while q < pk.lp.len {
        c.last_lit = c.last_lit.push(pk.lp.buf[q]);
        q = q + 1;
    }
    q = 0;
    while q < pk.ll.len {
        c.lit_lens = c.lit_lens.push(pk.ll.buf[q]);
        q = q + 1;
    }
    q = 0;
    while q < pk.lt.len {
        c.lit_tags = c.lit_tags.push(pk.lt.buf[q]);
        q = q + 1;
    }
    q = 0;
    while q < pk.lcs.len {
        c.lit_csafe = c.lit_csafe.push(pk.lcs.buf[q]);
        q = q + 1;
    }
    if pk.le_rel.len > 0 || pk.lc.len > 0 || pk.ld_rel.len > 0
        || pk.ll.len > 0 || pk.lt.len > 0 || pk.lcs.len > 0
        || pk.lp.len > 0 {
        c.has_lit = 1;
    }
    return c;
}

fn pkt_free(own pk: LPKT) {
    pk.le_rel.destroy(); pk.le_ri.destroy(); pk.le_pool.destroy();
    pk.lc.destroy(); pk.lc_keys.destroy();
    pk.ld_rel.destroy(); pk.ld_cf.destroy();
    pk.ll.destroy(); pk.lt.destroy(); pk.lcs.destroy();
    pk.lp.destroy();
}

/// k_ends_ii — does place key `k` end in `[]`?  (the index-family
/// self-pair exemption in `swap`'s overlap check)
fn k_ends_ii(read c: Checker, k: u32) -> u8 {
    let sp = c.kns.buf[u64(k)];
    if u64(sp.len) < 2 { return 0; }
    let b0 = c.kbyt.buf[u64(sp.off) + u64(sp.len) - 2];
    if b0 == u8(91)
        && c.kbyt.buf[u64(sp.off) + u64(sp.len) - 1] == u8(93) {
        return 1;
    }
    return 0;
}

/// swap_clear — stage-0's `clear` in `swap`: every fact rooted at or
/// under `k` dies (sorted `(un…)` per family, in family order).
/// init is not cleared — the cross-install's init_set lands next.
fn swap_clear(own c: Checker, k: u32) -> Checker {
    c = edges_retain_holder(c, k);
    c = caps_retain_holder(c, k);
    let tv0 = vec.Vec<u32>::new(c.heap);
    c = cons_retain_holder(c, k, NONE(), tv0);
    tv0.destroy();
    let i: u64 = 0;
    let ks = vec.Vec<u32>::new(c.heap);
    while i < c.tag.len {
        if kprefix(c, k, c.tag.buf[i].k) == 1 {
            ks = ks.push(c.tag.buf[i].k);
        }
        i = i + 1;
    }
    let ks2 = ksort(c, ks);
    i = 0;
    while i < ks2.len {
        c = tag_unset(c, ks2.buf[i]);
        i = i + 1;
    }
    ks2.destroy();
    let ks3 = vec.Vec<u32>::new(c.heap);
    i = 0;
    while i < c.slens.len {
        if kprefix(c, k, c.slens.buf[i].k) == 1 {
            ks3 = ks3.push(c.slens.buf[i].k);
        }
        i = i + 1;
    }
    let ks4 = ksort(c, ks3);
    i = 0;
    while i < ks4.len {
        c = unslen(c, ks4.buf[i]);
        i = i + 1;
    }
    ks4.destroy();
    let ks5 = vec.Vec<u32>::new(c.heap);
    i = 0;
    while i < c.csafe.len {
        if kprefix(c, k, c.csafe.buf[i]) == 1 {
            ks5 = ks5.push(c.csafe.buf[i]);
        }
        i = i + 1;
    }
    let ks6 = ksort(c, ks5);
    i = 0;
    while i < ks6.len {
        c = uncsafe(c, ks6.buf[i]);
        i = i + 1;
    }
    ks6.destroy();
    let ks7 = vec.Vec<u32>::new(c.heap);
    i = 0;
    while i < c.foreign.len {
        if kprefix(c, k, c.foreign.buf[i]) == 1 {
            ks7 = ks7.push(c.foreign.buf[i]);
        }
        i = i + 1;
    }
    let ks8 = ksort(c, ks7);
    i = 0;
    while i < ks8.len {
        c = unforeign(c, ks8.buf[i]);
        i = i + 1;
    }
    ks8.destroy();
    let ks9 = vec.Vec<u32>::new(c.heap);
    i = 0;
    while i < c.provs.len {
        if kprefix(c, k, c.provs.buf[i].k) == 1 {
            ks9 = ks9.push(c.provs.buf[i].k);
        }
        i = i + 1;
    }
    let ks10 = ksort(c, ks9);
    i = 0;
    while i < ks10.len {
        c = unprov(c, ks10.buf[i]);
        i = i + 1;
    }
    ks10.destroy();
    return c;
}

/// arm_bind — the `V(b)` payload bind inside an arm scope, a
/// key-level `let b = k.V` (or `let b = &k.V` for read scrutinees):
/// holds on the scrutinee and the payload path, subtree collect +
/// consume when the payload owns, then the let-fact sequence —
/// init, ref edges (record_edges: kill + mf + claims), caps, slen,
/// lit re-root, tag adopt, bind. `byref` arrives as `&pt` with an
/// immutable edge into the live payload.
fn arm_bind(own c: Checker, read p: ast.Parser, bn: u32,
            vn: u32, pt: u32, k: u32, pidk: u32, seid: u32,
            line: u32, col: u32, byref: u8) -> Checker {
    c = key_field(c, k, vn);
    let pk2 = c.res;
    // place_id key for the payload — an `own`/cap scrutinee's
    // binding path (`m#e.V`), not the resolved `$arg` storage. The
    // by-value init reads it (path_ty_prov's Read hold, refs_of's
    // edge scan, prov/tag lookup); a `&` bind cap-checks the
    // RESOLVED place instead, and its `require_place_bases` sees no
    // base read (Field bases carry no value requirement).
    let pk = pidk;
    if pk == NONE() { pk = pk2; }
    if byref == 1 {
        c = record_hold(c, pk2, 1);
    } else {
        // stage-0's synthesized `let b = scrut.V` walks the whole
        // place expr — base holds (var/field/index) ride the eval,
        // the element's own hold merges in from the scrutinee read.
        c = expr_tv_w(c, p, seid, NONE(), 0);
        c.has_tag = 0;
        c.tag_has = 0;
        c = record_hold(c, pk, 1);
    }
    let ptn = c.r.rtys.buf[u64(pt)];
    // push_place_lit — an aggregate payload's subtree facts collect
    // BEFORE the move kills the source edges. A `&k.V` init sees a
    // Ref value — nothing collects, nothing consumes.
    let agg: u8 = 0;
    if byref == 0
        && (ptn.kind == 12 || ptn.kind == 13 || ptn.kind == 14) {
        agg = 1;
        c = collect_lit_k(c, pk2);
    }
    // consume_owned_src — only a payload with something to move
    // (box/boxslice, or an aggregate whose subtree owns) consumes.
    let owns: u8 = 0;
    if byref == 0 && (ptn.kind == 24 || ptn.kind == 25) { owns = 1; }
    if owns == 0 && agg == 1 {
        c = live_own_at(c, pk2, pt);
        if c.res != NONE() { owns = 1; }
        let j: u64 = 0;
        while owns == 0 && j < c.edges.len {
            let eh = c.edges.buf[j].h;
            if eh != pk2 && kprefix(c, pk2, eh) == 1 { owns = 1; }
            j = j + 1;
        }
        j = 0;
        while owns == 0 && j < c.caps.len {
            let ch = c.caps.buf[j].h;
            if ch != pk2 && kprefix(c, pk2, ch) == 1 { owns = 1; }
            j = j + 1;
        }
    }
    if owns == 1 {
        // consume_place's cap_check claims Own on the resolved place.
        c = record_hold(c, pk2, 3);
        c = cons1(c, pk2, 1, line, col);
        c = kill_set(c, pk2, 1);
        c = edges_retain_holder(c, pk2);
    }
    c.next_epoch = c.next_epoch + 1;
    let ep = c.next_epoch;
    c = key_of(c, bn, ep);
    let bkey = c.res;
    c = init_set(c, bkey, 1);
    let owner = cur_region(c);
    let bt = pt;
    let bpk: u8 = 0;
    let bpv: u32 = 0;
    // let_edges — ref-edge/cap/len attach, the record_edges shape.
    if byref == 1 {
        // `let b = &k.V` — the binder claims the payload path read.
        while c.lrefs_to.len > 0 { c.lrefs_to.pop(); }
        c.lrefs_to = c.lrefs_to.push(pk2);
        c.lrefs_mut = 0;
        c.lrefs_mf = NONE();
        c.lrefs_foreign = 0;
        c = record_edges(c, bkey, line, col, 1);
        c = rty_mk_wrap(c, 15, pt);
        bt = c.res;
        // `&place` prov — place_req: a capability param's storage
        // outlives this frame (param), a local's rides its region.
        c = place_req(c, p, seid);
        bpk = u8(c.res2);
        bpv = c.res3;
    } else {
        if ptn.kind == 10 || ptn.kind == 15 || ptn.kind == 17 {
            // refs_of(k.V) — a view payload hands its claims over:
            // record_edges kills the fresh binder (always, even for
            // empty targets) then installs the claims at `b`. The
            // scans key off place_id, matching refs_of's Field arm.
            while c.lrefs_to.len > 0 { c.lrefs_to.pop(); }
            let i: u64 = 0;
            while i < c.edges.len {
                if c.edges.buf[i].h == pk {
                    c.lrefs_to = c.lrefs_to.push(c.edges.buf[i].t);
                }
                i = i + 1;
            }
            c.lrefs_mut = 0;
            if (ptn.kind == 15 || ptn.kind == 17) && ptn.b == 1 {
                c.lrefs_mut = 1;
            }
            c.lrefs_mf = NONE();
            if c.lrefs_mut == 1 { c.lrefs_mf = pk; }
            c.lrefs_foreign = in_foreign(c, pk);
            if c.lrefs_foreign == 1 { c = foreign_set(c, bkey); }
            c = record_edges(c, bkey, line, col, 1);
        }
        if ptn.kind == 18 {
            // caps_of — a handle payload's identity edges ride.
            // `caps_of` yields Some even for an empty target set —
            // `record_caps` still fires the holder's capkill.
            while c.lcaps.len > 0 { c.lcaps.pop(); }
            let i: u64 = 0;
            while i < c.caps.len {
                if c.caps.buf[i].h == pk {
                    c.lcaps = c.lcaps.push(c.caps.buf[i].t);
                }
                i = i + 1;
            }
            c = record_caps(c, bkey);
        }
        // slice_len_of — an slen at the payload path installs.
        let i: u64 = 0;
        while i < c.slens.len {
            if c.slens.buf[i].k == pk {
                c = slen_set(c, bkey, c.slens.buf[i].n);
            }
            i = i + 1;
        }
    }
    // record_lit_fields — the collected subtree re-roots under `b`.
    c = record_lit_fields(c, bkey, line, col, 1);
    // record_tag — enum payload adopts `k.V`'s tag; else untag.
    // `bt` is the BIND ty — a `&E` view bind is not enum-typed.
    if is_enum_ty(c, bt) == 1 {
        c = tag_set(c, bkey, tagv_at(c, pk));
    } else {
        c = untag(c, bkey);
    }
    if byref == 0 {
        // `let` prov rule — Handle/Str binds are owner-provenanced.
        if ptn.kind == 18 || ptn.kind == 10 {
            bpk = 2; bpv = owner;
        } else {
            let pv2 = prov_at(c, pk);
            bpk = pv2.pk;
            bpv = pv2.pv;
        }
    }
    // (bind "b#e" @L:C "ty" prov owner) — same emit as check_let_n
    c = es(c, "(bind ");
    c = eqs(c, bkey);
    c = es(c, " @");
    c = eu(c, u64(line));
    c = ec(c, u8(58));
    c = eu(c, u64(col));
    c = ec(c, u8(32));
    c = ec(c, u8(34));
    c = e_ty(c, bt);
    c = ec(c, u8(34));
    c = ec(c, u8(32));
    c = eprov(c, bpk, bpv);
    c = ec(c, u8(32));
    c = eprov(c, 2, owner);
    c = es(c, ")");
    c = rec(c);
    c.binds = c.binds.push(CBind {
        n: bn, epoch: ep, ty: bt,
        prov_k: bpk, prov_v: bpv,
        owner: owner, auth: 0,
        line: line, col: col,
        guard_dom: NONE(), guard_root: NONE(),
        goff: 0, glen: 0 });
    c.bnames = c.bnames.push(KK { k: bn, v: u32(c.binds.len) - 1 });
    return c;
}

/// match_arm_block — check_block for one arm: `(scope)` … stmts …
/// `(pop)`, with the `V(b)` payload bind spliced in as the first
/// statement when `bn != NONE`. `expr_arm`/`want` route the tail
/// `Stmt::Expr` through expr_tv_w for the yield.
fn match_arm_block(own c: Checker, read p: ast.Parser,
                   b: u32, e_: u32, ret: u32,
                   bn: u32, vn: u32, pt: u32, k: u32, pidk: u32,
                   seid: u32, line: u32, col: u32, byref: u8,
                   expr_arm: u8, want: u32) -> Checker {
    c = push_scope(c);
    if bn != NONE() {
        c = arm_bind(c, p, bn, vn, pt, k, pidk, seid,
                     line, col, byref);
    }
    let pending = vec.Vec<u32>::new(c.heap);
    let i: u64 = u64(b);
    let last_l: u32 = 0; let last_c: u32 = 0; let has_last: u8 = 0;
    while i < u64(e_) {
        let sid = p.u32s.buf[i];
        let st = p.stmts.buf[u64(sid)];
        if c.terminated == 1 { break; }
        let mark = c.rv_new.len;
        c = lower_s(c, p, sid, ret, 1);
        let is_tail: u8 = 0;
        if expr_arm == 1 && i + 1 == u64(e_)
            && sk_num(st.kind) == 7 {
            is_tail = 1;
        }
        // stage-0: `is_tail` is structural; a diverged arm's tail
        // skips eval entirely (no events, no yield).
        if is_tail == 1 {
            if c.diverged == 0 {
                c = expr_tv_w(c, p, st.a, want, 1);
                c.my_ty = c.res;
                c.my_pk = u8(c.res2);
                c.my_pv = c.res3;
                c.my_tail = st.a;
                c.my_llen = c.llen; c.my_llh = c.llen_has;
                // INT_DEFAULT-ness (stage-0 Ty::INT_DEFAULT): an i32
                // ty from a pure-literal tree adopts the peer's int ty.
                c.my_def = 0;
                if c.res != NONE()
                    && c.r.rtys.buf[u64(c.res)].kind == 6 {
                    c = const_int(c, p, st.a, c.res);
                    if c.res5 == 1 { c.my_def = 1; }
                }
                c = push_place_lit(c, p, st.a);
                c = consume_owned_src(c, p, st.a, st.line, st.col);
                c.my_has = 1;
                // ArmYieldInfo (N28/N40): tail refs/caps plus the
                // lit_* channels captured while arm-locals live —
                // the join unions these per variant.
                let rih: u8 = 0; let rim: u8 = 0;
                let rimf: u32 = NONE(); let rif: u8 = 0;
                let rito = vec.Vec<u32>::new(c.heap);
                c = refs_of(c, p, st.a);
                if c.lrefs_has == 1 {
                    rih = 1; rim = c.lrefs_mut;
                    rimf = c.lrefs_mf; rif = c.lrefs_foreign;
                    let q: u64 = 0;
                    while q < c.lrefs_to.len {
                        rito = rito.push(c.lrefs_to.buf[q]);
                        q = q + 1;
                    }
                }
                let cph: u8 = 0;
                let cps = vec.Vec<u32>::new(c.heap);
                c = caps_of(c, p, st.a);
                if c.lcaps_has == 1 {
                    cph = 1;
                    let q: u64 = 0;
                    while q < c.lcaps.len {
                        cps = cps.push(c.lcaps.buf[q]);
                        q = q + 1;
                    }
                }
                // std::mem::take — the arm's lit_* packets move into
                // the yield record (drain order preserved).
                let lerel = vec.Vec<u32>::new(c.heap);
                let leri = vec.Vec<RefInf>::new(c.heap);
                let lepool = vec.Vec<u32>::new(c.heap);
                let q: u64 = 0;
                while q < c.lit_edges.len {
                    let e0 = c.lit_edges.buf[q];
                    let ri0 = c.rinfos.buf[u64(e0.ri)];
                    let toff = u32(lepool.len);
                    let j: u64 = 0;
                    while j < u64(ri0.tlen) {
                        lepool = lepool.push(
                            c.ri_to.buf[u64(ri0.toff) + j]);
                        j = j + 1;
                    }
                    leri = leri.push(RefInf {
                        toff: toff, tlen: ri0.tlen, mut_: ri0.mut_,
                        mf: ri0.mf, foreign: ri0.foreign });
                    lerel = lerel.push(e0.rel);
                    q = q + 1;
                }
                while c.lit_edges.len > 0 { c.lit_edges.pop(); }
                let alc = vec.Vec<RLE2>::new(c.heap);
                let alck = vec.Vec<u32>::new(c.heap);
                q = 0;
                while q < c.lit_caps.len {
                    let e0 = c.lit_caps.buf[q];
                    let coff = u32(alck.len);
                    let j: u64 = 0;
                    while j < u64(e0.len) {
                        alck = alck.push(
                            c.rlc_keys.buf[u64(e0.off) + j]);
                        j = j + 1;
                    }
                    alc = alc.push(RLE2 {
                        rel: e0.rel, off: coff, len: e0.len });
                    q = q + 1;
                }
                while c.lit_caps.len > 0 { c.lit_caps.pop(); }
                let aldr = vec.Vec<u32>::new(c.heap);
                let aldf = vec.Vec<CF>::new(c.heap);
                q = 0;
                while q < c.lit_dead.len {
                    let e0 = c.lit_dead.buf[q];
                    aldr = aldr.push(e0.rel);
                    aldf = aldf.push(
                        c.lit_dead_cfs.buf[u64(e0.cf)]);
                    q = q + 1;
                }
                while c.lit_dead.len > 0 { c.lit_dead.pop(); }
                while c.lit_dead_cfs.len > 0 {
                    c.lit_dead_cfs.pop();
                }
                let all = vec.Vec<KI>::new(c.heap);
                q = 0;
                while q < c.lit_lens.len {
                    all = all.push(c.lit_lens.buf[q]);
                    q = q + 1;
                }
                while c.lit_lens.len > 0 { c.lit_lens.pop(); }
                let altg = vec.Vec<TG>::new(c.heap);
                q = 0;
                while q < c.lit_tags.len {
                    altg = altg.push(c.lit_tags.buf[q]);
                    q = q + 1;
                }
                while c.lit_tags.len > 0 { c.lit_tags.pop(); }
                let alp = vec.Vec<PV>::new(c.heap);
                q = 0;
                while q < c.last_lit.len {
                    alp = alp.push(c.last_lit.buf[q]);
                    q = q + 1;
                }
                while c.last_lit.len > 0 { c.last_lit.pop(); }
                c.has_lit = 0;
                c.mays = c.mays.push(MYI {
                    ri_has: rih, ri_mut: rim, ri_mf: rimf,
                    ri_foreign: rif, ri_to: rito,
                    cap_has: cph, caps: cps,
                    le_rel: lerel, le_ri: leri, le_pool: lepool,
                    lc: alc, lc_keys: alck,
                    ld_rel: aldr, ld_cf: aldf,
                    lp: alp, ll: all, lt: altg });
            }
        } else {
            c = check_stmt(c, p, sid, ret);
        }
        let q = mark;
        while q < c.rv_new.len {
            c = kill_temp(c, c.rv_new.buf[q]);
            q = q + 1;
        }
        while u64(c.rv_new.len) > mark { c.rv_new.pop(); }
        last_l = st.line; last_c = st.col; has_last = 1;
        if sk_num(st.kind) == 0 {
            c.r = resolve.intern_pname(c.r, p, st.a);
            if n_is_rv(c, c.r.res) == 1 {
                pending = pending.push(c.r.res);
                i = i + 1;
                continue;
            }
        }
        let q2: u64 = 0;
        while q2 < pending.len {
            c = kill_temp(c, pending.buf[q2]);
            q2 = q2 + 1;
        }
        while pending.len > 0 { pending.pop(); }
        i = i + 1;
    }
    pending.destroy();
    c = pop_scope_defers(c, p);
    let cp = pop_scope_names(c);
    c = cp.c;
    c = expire_scope(c, cp.popped, last_l, last_c, has_last,
        "the enclosing scope ends");
    c = es(c, "(pop)");
    c = rec(c);
    return c;
}

/// join_init2 — pairwise `join_init` of c.init against `b`: a key in
/// the union is Def iff init_covered on BOTH sides, Maybe on either
/// alone, dropped when neither side's coverage reaches it.
fn join_init2(own c: Checker, read b: vec.Vec<MapE2>) -> Checker {
    let w = vec.Vec<MapE2>::new(c.heap);
    let i: u64 = 0;
    while i < c.init.len {
        let k = c.init.buf[i].k;
        c = icov_c(c, k);
        let ca = c.res;
        c = icov(c, b, k);
        let cb = c.res;
        if ca == 1 && cb == 1 {
            w = w.push(MapE2 { k: k, cert: 1 });
        } else { if ca == 1 || cb == 1 {
            w = w.push(MapE2 { k: k, cert: 2 });
        } }
        i = i + 1;
    }
    i = 0;
    while i < b.len {
        let k = b.buf[i].k;
        let ina: u8 = 0;
        let j: u64 = 0;
        while j < c.init.len {
            if c.init.buf[j].k == k { ina = 1; }
            j = j + 1;
        }
        if ina == 0 {
            c = icov_c(c, k);
            let ca = c.res;
            c = icov(c, b, k);
            let cb = c.res;
            if ca == 1 && cb == 1 {
                w = w.push(MapE2 { k: k, cert: 1 });
            } else { if ca == 1 || cb == 1 {
                w = w.push(MapE2 { k: k, cert: 2 });
            } }
        }
        i = i + 1;
    }
    c.init.destroy();
    c.init = w;
    return c;
}

/// join_cons2 — pairwise `join_consumed` of c.cons against `b`:
/// union keys; Cons iff both Cons; Maybe keeps the merged origins.
/// Result lands in `c.cons`.
fn join_cons2(own c: Checker, read b: vec.Vec<CF>) -> Checker {
    let w = vec.Vec<CF>::new(c.heap);
    let i: u64 = 0;
    while i < c.cons.len {
        let f = c.cons.buf[i];
        let bi = cf_get(b, f.k);
        let st: u8 = 2;
        let bo: u32 = 0; let bl: u32 = NONE();
        if bi >= 0 {
            bo = b.buf[u64(bi)].aoff;
            bl = b.buf[u64(bi)].alen;
            if f.st == 1 && b.buf[u64(bi)].st == 1 { st = 1; }
        }
        c = ats_merge(c, f.aoff, f.alen, bo, bl);
        let ao = c.res; let al = u32(c.res2);
        w = w.push(CF { k: f.k, st: st, aoff: ao, alen: al });
        i = i + 1;
    }
    i = 0;
    while i < b.len {
        let f = b.buf[i];
        if cf_get(c.cons, f.k) < 0 {
            c = ats_merge(c, 0, NONE(), f.aoff, f.alen);
            let ao = c.res; let al = u32(c.res2);
            w = w.push(CF { k: f.k, st: 2, aoff: ao, alen: al });
        }
        i = i + 1;
    }
    c.cons.destroy();
    c.cons = w;
    return c;
}

/// match_join — the N-arm merge over post-arm snapshots. Live
/// (non-diverged) arms drive the init/scope joins; when none live,
/// ALL snaps stand in for the fact channels. Mirrors Stage-0's merge
/// order: flags, init, edges, caps, consumed, kills, transit/chans,
/// tag, provs, scopes, defers.
fn match_join(own c: Checker, own snaps: vec.Vec<BS>,
              pre_dead: u8, pre_term: u8,
              has_missing: u8, wildcard: u8) -> Checker {
    let n = snaps.len;
    let all_dead: u8 = 1;
    let all_term: u8 = 1;
    let nlive: u64 = 0;
    let i: u64 = 0;
    while i < n {
        if snaps.buf[i].diverged == 0 { all_dead = 0; nlive = nlive + 1; }
        if snaps.buf[i].terminated == 0 { all_term = 0; }
        i = i + 1;
    }
    c.diverged = 0;
    if pre_dead == 1
        || (all_dead == 1 && (has_missing == 0 || wildcard == 1)) {
        c.diverged = 1;
    }
    c.terminated = 0;
    if pre_term == 1
        || (all_term == 1 && (has_missing == 0 || wildcard == 1)) {
        c.terminated = 1;
    }
    c = rec_flags(c);
    // live set marker — a diverged snap contributes nothing to the
    // init/scope folds.
    let islive = vec.Vec<u8>::new(c.heap);
    i = 0;
    while i < n {
        islive = islive.push(snaps.buf[i].diverged);
        i = i + 1;
    }
    // init: fold join_init over live arms (empty → current = pre)
    if nlive > 0 {
        let first: u8 = 1;
        i = 0;
        while i < n {
            if islive.buf[i] == 0 {
                if first == 1 {
                    let w = vec.Vec<MapE2>::new(c.heap);
                    let j: u64 = 0;
                    while j < snaps.buf[i].init.len {
                        w = w.push(snaps.buf[i].init.buf[j]);
                        j = j + 1;
                    }
                    c.init.destroy();
                    c.init = w;
                    first = 0;
                } else {
                    c = join_init2(c, snaps.buf[i].init);
                }
            }
            i = i + 1;
        }
    }
    // arms source for the fact channels
    let useall: u8 = 0;
    if nlive == 0 { useall = 1; }
    // edges: union over arms; fact = first arm's; Def iff all Def
    let w = vec.Vec<E2>::new(c.heap);
    i = 0;
    while i < n {
        if useall == 0 && islive.buf[i] != 0 { i = i + 1; continue; }
        let j: u64 = 0;
        while j < snaps.buf[i].edges.len {
            let e = snaps.buf[i].edges.buf[j];
            let have: u8 = 0;
            let q: u64 = 0;
            while q < w.len {
                if w.buf[q].h == e.h && w.buf[q].t == e.t { have = 1; }
                q = q + 1;
            }
            if have == 0 {
                // cert = Def iff every arm carries (h,t) Def
                let alld: u8 = 1;
                let s2: u64 = 0;
                while s2 < n {
                    if useall == 0 && islive.buf[s2] != 0 {
                        s2 = s2 + 1; continue;
                    }
                    let fd: u8 = 0;
                    let q2: u64 = 0;
                    while q2 < snaps.buf[s2].edges.len {
                        let e2 = snaps.buf[s2].edges.buf[q2];
                        if e2.h == e.h && e2.t == e.t {
                            fd = 1;
                            if e2.cert != 1 { alld = 0; }
                        }
                        q2 = q2 + 1;
                    }
                    if fd == 0 { alld = 0; }
                    s2 = s2 + 1;
                }
                let ct: u8 = 2;
                if alld == 1 { ct = 1; }
                w = w.push(E2 { h: e.h, t: e.t, kind: e.kind,
                    cert: ct, bl: e.bl, bc: e.bc });
            }
            j = j + 1;
        }
        i = i + 1;
    }
    c.edges.destroy();
    c.edges = w;
    // caps: union over arms; Def iff all Def
    let w2 = vec.Vec<C3>::new(c.heap);
    i = 0;
    while i < n {
        if useall == 0 && islive.buf[i] != 0 { i = i + 1; continue; }
        let j: u64 = 0;
        while j < snaps.buf[i].caps.len {
            let e = snaps.buf[i].caps.buf[j];
            let have: u8 = 0;
            let q: u64 = 0;
            while q < w2.len {
                if w2.buf[q].h == e.h && w2.buf[q].t == e.t { have = 1; }
                q = q + 1;
            }
            if have == 0 {
                let alld: u8 = 1;
                let s2: u64 = 0;
                while s2 < n {
                    if useall == 0 && islive.buf[s2] != 0 {
                        s2 = s2 + 1; continue;
                    }
                    let fd: u8 = 0;
                    let q2: u64 = 0;
                    while q2 < snaps.buf[s2].caps.len {
                        let e2 = snaps.buf[s2].caps.buf[q2];
                        if e2.h == e.h && e2.t == e.t {
                            fd = 1;
                            if e2.cert != 1 { alld = 0; }
                        }
                        q2 = q2 + 1;
                    }
                    if fd == 0 { alld = 0; }
                    s2 = s2 + 1;
                }
                let ct: u8 = 2;
                if alld == 1 { ct = 1; }
                w2 = w2.push(C3 { h: e.h, t: e.t, cert: ct });
            }
            j = j + 1;
        }
        i = i + 1;
    }
    c.caps.destroy();
    c.caps = w2;
    // cons: join_consumed fold over arms
    i = 0;
    let first: u8 = 1;
    while i < n {
        if useall == 0 && islive.buf[i] != 0 { i = i + 1; continue; }
        if first == 1 {
            let wc = vec.Vec<CF>::new(c.heap);
            let j: u64 = 0;
            while j < snaps.buf[i].cons.len {
                wc = wc.push(snaps.buf[i].cons.buf[j]);
                j = j + 1;
            }
            c.cons.destroy();
            c.cons = wc;
            first = 0;
        } else {
            c = join_cons2(c, snaps.buf[i].cons);
        }
        i = i + 1;
    }
    // kills: join_cert_map fold (Def iff both Def) over arms
    i = 0;
    first = 1;
    while i < n {
        if useall == 0 && islive.buf[i] != 0 { i = i + 1; continue; }
        if first == 1 {
            let we = vec.Vec<MapE2>::new(c.heap);
            let wc2 = vec.Vec<MapE2>::new(c.heap);
            let j: u64 = 0;
            while j < snaps.buf[i].ekills.len {
                we = we.push(snaps.buf[i].ekills.buf[j]);
                j = j + 1;
            }
            j = 0;
            while j < snaps.buf[i].ckills.len {
                wc2 = wc2.push(snaps.buf[i].ckills.buf[j]);
                j = j + 1;
            }
            c.ekills.destroy();
            c.ekills = we;
            c.ckills.destroy();
            c.ckills = wc2;
            first = 0;
        } else {
            // union keys; Def iff both Def — both maps
            let we = vec.Vec<MapE2>::new(c.heap);
            let j: u64 = 0;
            while j < c.ekills.len {
                let k = c.ekills.buf[j].k;
                let ct: u8 = 2;
                let q2: u64 = 0;
                while q2 < snaps.buf[i].ekills.len {
                    let o = snaps.buf[i].ekills.buf[q2];
                    if o.k == k && o.cert == 1
                        && c.ekills.buf[j].cert == 1 { ct = 1; }
                    q2 = q2 + 1;
                }
                we = we.push(MapE2 { k: k, cert: ct });
                j = j + 1;
            }
            j = 0;
            while j < snaps.buf[i].ekills.len {
                let o = snaps.buf[i].ekills.buf[j];
                let ina: u8 = 0;
                let q2: u64 = 0;
                while q2 < c.ekills.len {
                    if c.ekills.buf[q2].k == o.k { ina = 1; }
                    q2 = q2 + 1;
                }
                if ina == 0 {
                    we = we.push(MapE2 { k: o.k, cert: 2 });
                }
                j = j + 1;
            }
            c.ekills.destroy();
            c.ekills = we;
            let we2 = vec.Vec<MapE2>::new(c.heap);
            j = 0;
            while j < c.ckills.len {
                let k = c.ckills.buf[j].k;
                let ct: u8 = 2;
                let q2: u64 = 0;
                while q2 < snaps.buf[i].ckills.len {
                    let o = snaps.buf[i].ckills.buf[q2];
                    if o.k == k && o.cert == 1
                        && c.ckills.buf[j].cert == 1 { ct = 1; }
                    q2 = q2 + 1;
                }
                we2 = we2.push(MapE2 { k: k, cert: ct });
                j = j + 1;
            }
            j = 0;
            while j < snaps.buf[i].ckills.len {
                let o = snaps.buf[i].ckills.buf[j];
                let ina: u8 = 0;
                let q2: u64 = 0;
                while q2 < c.ckills.len {
                    if c.ckills.buf[q2].k == o.k { ina = 1; }
                    q2 = q2 + 1;
                }
                if ina == 0 {
                    we2 = we2.push(MapE2 { k: o.k, cert: 2 });
                }
                j = j + 1;
            }
            c.ckills.destroy();
            c.ckills = we2;
        }
        i = i + 1;
    }
    // transit union + chan max-len over arms
    i = 0;
    while i < n {
        if useall == 0 && islive.buf[i] != 0 { i = i + 1; continue; }
        let j: u64 = 0;
        while j < snaps.buf[i].transit.len {
            if vhas(c.transit, snaps.buf[i].transit.buf[j]) == 0 {
                c.transit = c.transit.push(snaps.buf[i].transit.buf[j]);
            }
            j = j + 1;
        }
        j = 0;
        while j < snaps.buf[i].chans.len {
            let cqk = snaps.buf[i].chans.buf[j].k;
            let cqn = snaps.buf[i].chans.buf[j].pkts.len;
            let fnd: u8 = 0;
            let q: u64 = 0;
            while q < c.chans.len {
                if c.chans.buf[q].k == cqk {
                    fnd = 1;
                    if cqn > c.chans.buf[q].pkts.len {
                        let np = vec.Vec<Packet>::new(c.heap);
                        let q2: u64 = 0;
                        while q2 < cqn {
                            np = np.push(
                                snaps.buf[i].chans.buf[j].pkts.buf[q2]);
                            q2 = q2 + 1;
                        }
                        c.chans.buf[q].pkts.destroy();
                        c.chans.buf[q].pkts = np;
                    }
                }
                q = q + 1;
            }
            if fnd == 0 {
                let np = vec.Vec<Packet>::new(c.heap);
                let q2: u64 = 0;
                while q2 < cqn {
                    np = np.push(
                        snaps.buf[i].chans.buf[j].pkts.buf[q2]);
                    q2 = q2 + 1;
                }
                c.chans = c.chans.push(CQ { k: cqk, pkts: np });
            }
            j = j + 1;
        }
        i = i + 1;
    }
    // tag: union keys over arms; same definite variant survives, else ?
    let wt = vec.Vec<TG>::new(c.heap);
    i = 0;
    while i < n {
        if useall == 0 && islive.buf[i] != 0 { i = i + 1; continue; }
        let j: u64 = 0;
        while j < snaps.buf[i].tag.len {
            let tg = snaps.buf[i].tag.buf[j];
            let have: u8 = 0;
            let q: u64 = 0;
            while q < wt.len {
                if wt.buf[q].k == tg.k { have = 1; }
                q = q + 1;
            }
            if have == 0 { wt = wt.push(tg); }
            j = j + 1;
        }
        i = i + 1;
    }
    i = 0;
    while i < wt.len {
        let k = wt.buf[i].k;
        let first_v: u32 = NONE();
        let s2: u64 = 0;
        while s2 < n && first_v == NONE() {
            if useall == 0 && islive.buf[s2] != 0 {
                s2 = s2 + 1; continue;
            }
            let q2: u64 = 0;
            while q2 < snaps.buf[s2].tag.len {
                let tg = snaps.buf[s2].tag.buf[q2];
                if tg.k == k && tg.v != NONE() { first_v = tg.v; }
                q2 = q2 + 1;
            }
            s2 = s2 + 1;
        }
        let same: u8 = 1;
        if first_v == NONE() { same = 0; }
        s2 = 0;
        while s2 < n {
            if useall == 0 && islive.buf[s2] != 0 {
                s2 = s2 + 1; continue;
            }
            let has: u8 = 0;
            let q2: u64 = 0;
            while q2 < snaps.buf[s2].tag.len {
                let tg = snaps.buf[s2].tag.buf[q2];
                if tg.k == k && tg.v == first_v { has = 1; }
                q2 = q2 + 1;
            }
            if has == 0 { same = 0; }
            s2 = s2 + 1;
        }
        if same == 0 { wt.buf[i].v = NONE(); }
        else { wt.buf[i].v = first_v; }
        i = i + 1;
    }
    c.tag.destroy();
    c.tag = wt;
    // provs: union keys over arms; per-key jprov fold with the
    // pre-state value filling arms that lack the key.
    let wp = vec.Vec<PV>::new(c.heap);
    i = 0;
    while i < n {
        if useall == 0 && islive.buf[i] != 0 { i = i + 1; continue; }
        let j: u64 = 0;
        while j < snaps.buf[i].provs.len {
            let pv2 = snaps.buf[i].provs.buf[j];
            let have: u8 = 0;
            let q: u64 = 0;
            while q < wp.len {
                if wp.buf[q].k == pv2.k { have = 1; }
                q = q + 1;
            }
            if have == 0 {
                // fold jprov over arms, saved (pre) where absent —
                // but pre was restored; its provs live in c.provs NOW.
                let apk: u8 = 0; let apv: u32 = 0;
                let have2: u8 = 0;
                let s2: u64 = 0;
                while s2 < n {
                    if useall == 0 && islive.buf[s2] != 0 {
                        s2 = s2 + 1; continue;
                    }
                    let vk: u8 = 0; let vv: u32 = 0; let vh: u8 = 0;
                    let q2: u64 = 0;
                    while q2 < snaps.buf[s2].provs.len {
                        let o = snaps.buf[s2].provs.buf[q2];
                        if o.k == pv2.k { vk = o.pk; vv = o.pv; vh = 1; }
                        q2 = q2 + 1;
                    }
                    if vh == 0 {
                        // fallback to pre-state value
                        let bi = pv_get(c.provs, pv2.k);
                        if bi >= 0 {
                            let o = c.provs.buf[u64(bi)];
                            vk = o.pk; vv = o.pv; vh = 1;
                        }
                    }
                    if vh == 1 {
                        if have2 == 0 { apk = vk; apv = vv; have2 = 1; }
                        else {
                            c = jprov(c, apk, apv, vk, vv);
                            apk = u8(c.res); apv = c.res2;
                        }
                    }
                    s2 = s2 + 1;
                }
                if have2 == 1 {
                    wp = wp.push(PV { k: pv2.k, pk: apk, pv: apv });
                }
            }
            j = j + 1;
        }
        i = i + 1;
    }
    c.provs.destroy();
    c.provs = wp;
    // scopes: fold merge_envs over live arms — env = binds + bnames +
    // scope stack. First live arm installs, later ones merge.
    i = 0;
    first = 1;
    while i < n {
        if islive.buf[i] != 0 { i = i + 1; continue; }
        if first == 1 {
            let wb = vec.Vec<CBind>::new(c.heap);
            let wn = vec.Vec<KK>::new(c.heap);
            let ws = vec.Vec<u32>::new(c.heap);
            let j: u64 = 0;
            while j < snaps.buf[i].binds.len {
                wb = wb.push(snaps.buf[i].binds.buf[j]);
                j = j + 1;
            }
            j = 0;
            while j < snaps.buf[i].bnames.len {
                wn = wn.push(snaps.buf[i].bnames.buf[j]);
                j = j + 1;
            }
            j = 0;
            while j < snaps.buf[i].scopes.len {
                ws = ws.push(snaps.buf[i].scopes.buf[j]);
                j = j + 1;
            }
            c.binds.destroy(); c.binds = wb;
            c.bnames.destroy(); c.bnames = wn;
            c.scopes.destroy(); c.scopes = ws;
            first = 0;
        } else {
            c = merge_envs2(c, snaps.buf[i]);
        }
        i = i + 1;
    }
    // defers: frame-wise merge over arms + dres union
    i = 0;
    first = 1;
    while i < n {
        if useall == 0 && islive.buf[i] != 0 { i = i + 1; continue; }
        if first == 1 {
            let wd = vec.Vec<vec.Vec<DeferRec>>::new(c.heap);
            let j: u64 = 0;
            while j < snaps.buf[i].defers.len {
                let f2 = vec.Vec<DeferRec>::new(c.heap);
                let q2: u64 = 0;
                while q2 < snaps.buf[i].defers.buf[j].len {
                    f2 = f2.push(snaps.buf[i].defers.buf[j].buf[q2]);
                    q2 = q2 + 1;
                }
                wd = wd.push(f2);
                j = j + 1;
            }
            let di: u64 = 0;
            while di < c.defers.len {
                c.defers.buf[di].destroy(); di = di + 1;
            }
            c.defers.destroy();
            c.defers = wd;
            first = 0;
            // dres: union — start from this arm's
            let wr = vec.Vec<DR>::new(c.heap);
            let j2: u64 = 0;
            while j2 < snaps.buf[i].dres.len {
                wr = wr.push(snaps.buf[i].dres.buf[j2]);
                j2 = j2 + 1;
            }
            c.dres.destroy();
            c.dres = wr;
        } else {
            c = merge_dframes(c, snaps.buf[i]);
            let j: u64 = 0;
            while j < snaps.buf[i].dres.len {
                let dr = snaps.buf[i].dres.buf[j];
                let has: u8 = 0;
                let q: u64 = 0;
                while q < c.dres.len {
                    if c.dres.buf[q].k == dr.k { has = 1; }
                    q = q + 1;
                }
                if has == 0 { c.dres = c.dres.push(dr); }
                j = j + 1;
            }
        }
        i = i + 1;
    }
    // free every snap
    i = 0;
    while i < n {
        bs_free(snaps.buf[i]);
        i = i + 1;
    }
    snaps.destroy();
    islive.destroy();
    return c;
}

/// check_match — stmt-position `match` (no value context).
fn check_match(own c: Checker, read p: ast.Parser,
               s: ast.Stmt, ret: u32) -> Checker {
    return check_match2(c, p, s.a, s.b, s.c, s.line, s.col,
                        ret, NONE());
}

/// check_match2 — stage-0's shared `check_match`: scrutinee checks,
/// arm validation, per-arm snapshot/join, yield unification (N28).
/// Returns the match's type in res; prov lands in the `myields`
/// record keyed (line,col) and in res2/res3 for expr callers.
pub struct MIU { c: Checker, m: MYI }

/// myi_union — stage-0's ArmYieldInfo fold: `inf` accumulates across
/// live arms exactly as the match join does — refs/caps/lit_edges/
/// lit_caps union their target sets, lit_dead facts all land Maybe
/// with merged origins, lit_provs join pointwise, lit_lens/lit_tags
/// survive only when every arm agrees. `first` = inf is still empty
/// (the arm's own channels copy in wholesale).
fn myi_union(own c: Checker, own inf: MYI, read a: MYI,
             first: u8) -> MIU {
    // refs — a None arm only strips `foreign`
    if inf.ri_has == 0 {
        if a.ri_has == 1 {
            inf.ri_has = 1; inf.ri_mut = a.ri_mut;
            inf.ri_mf = a.ri_mf; inf.ri_foreign = a.ri_foreign;
            let i: u64 = 0;
            while i < a.ri_to.len {
                inf.ri_to = inf.ri_to.push(a.ri_to.buf[i]);
                i = i + 1;
            }
        }
    } else {
        if a.ri_has == 1 {
            let j: u64 = 0;
            while j < a.ri_to.len {
                if vhas(inf.ri_to, a.ri_to.buf[j]) == 0 {
                    inf.ri_to = inf.ri_to.push(a.ri_to.buf[j]);
                }
                j = j + 1;
            }
            if a.ri_mut == 1 { inf.ri_mut = 1; }
            if inf.ri_mf == NONE() { inf.ri_mf = a.ri_mf; }
            if a.ri_foreign == 0 { inf.ri_foreign = 0; }
        } else { inf.ri_foreign = 0; }
    }
    // caps — None arms contribute nothing
    if inf.cap_has == 0 {
        if a.cap_has == 1 {
            inf.cap_has = 1;
            let i: u64 = 0;
            while i < a.caps.len {
                inf.caps = inf.caps.push(a.caps.buf[i]);
                i = i + 1;
            }
        }
    } else {
        if a.cap_has == 1 {
            let j: u64 = 0;
            while j < a.caps.len {
                if vhas(inf.caps, a.caps.buf[j]) == 0 {
                    inf.caps = inf.caps.push(a.caps.buf[j]);
                }
                j = j + 1;
            }
        }
    }
    // lit_edges — per-rel target union, mut|=, foreign&=
    let j: u64 = 0;
    while j < a.le_rel.len {
        let rel = a.le_rel.buf[j];
        let ri = a.le_ri.buf[j];
        let k: u64 = 0; let found: i64 = 0 - 1;
        while k < inf.le_rel.len {
            if inf.le_rel.buf[k] == rel { found = i64(k); }
            k = k + 1;
        }
        if found < 0 {
            let toff = u32(inf.le_pool.len);
            let q: u64 = 0;
            while q < u64(ri.tlen) {
                inf.le_pool = inf.le_pool.push(
                    a.le_pool.buf[u64(ri.toff) + q]);
                q = q + 1;
            }
            inf.le_ri = inf.le_ri.push(RefInf {
                toff: toff, tlen: ri.tlen, mut_: ri.mut_,
                mf: ri.mf, foreign: ri.foreign });
            inf.le_rel = inf.le_rel.push(rel);
        } else {
            let k2 = u64(found);
            let m = inf.le_ri.buf[k2];
            let toff = u32(inf.le_pool.len);
            let q: u64 = 0;
            while q < u64(m.tlen) {
                inf.le_pool = inf.le_pool.push(
                    inf.le_pool.buf[u64(m.toff) + q]);
                q = q + 1;
            }
            q = 0;
            while q < u64(ri.tlen) {
                let t = a.le_pool.buf[u64(ri.toff) + q];
                let has: u8 = 0;
                let w: u64 = 0;
                while w < u64(m.tlen) {
                    if inf.le_pool.buf[u64(m.toff) + w] == t {
                        has = 1;
                    }
                    w = w + 1;
                }
                if has == 0 {
                    inf.le_pool = inf.le_pool.push(t);
                }
                q = q + 1;
            }
            inf.le_ri.buf[k2].toff = toff;
            inf.le_ri.buf[k2].tlen = u32(inf.le_pool.len) - toff;
            if ri.mut_ == 1 { inf.le_ri.buf[k2].mut_ = 1; }
            if ri.foreign == 0 { inf.le_ri.buf[k2].foreign = 0; }
        }
        j = j + 1;
    }
    // lit_caps — per-rel target union
    j = 0;
    while j < a.lc.len {
        let e0 = a.lc.buf[j];
        let k: u64 = 0; let found: i64 = 0 - 1;
        while k < inf.lc.len {
            if inf.lc.buf[k].rel == e0.rel { found = i64(k); }
            k = k + 1;
        }
        if found < 0 {
            let coff = u32(inf.lc_keys.len);
            let q: u64 = 0;
            while q < u64(e0.len) {
                inf.lc_keys = inf.lc_keys.push(
                    a.lc_keys.buf[u64(e0.off) + q]);
                q = q + 1;
            }
            inf.lc = inf.lc.push(RLE2 {
                rel: e0.rel, off: coff, len: e0.len });
        } else {
            let k2 = u64(found);
            let m = inf.lc.buf[k2];
            let coff = u32(inf.lc_keys.len);
            let q: u64 = 0;
            while q < u64(m.len) {
                inf.lc_keys = inf.lc_keys.push(
                    inf.lc_keys.buf[u64(m.off) + q]);
                q = q + 1;
            }
            q = 0;
            while q < u64(e0.len) {
                let t = a.lc_keys.buf[u64(e0.off) + q];
                let has: u8 = 0;
                let w: u64 = 0;
                while w < u64(m.len) {
                    if inf.lc_keys.buf[u64(m.off) + w] == t {
                        has = 1;
                    }
                    w = w + 1;
                }
                if has == 0 {
                    inf.lc_keys = inf.lc_keys.push(t);
                }
                q = q + 1;
            }
            inf.lc.buf[k2].off = coff;
            inf.lc.buf[k2].len = u32(inf.lc_keys.len) - coff;
        }
        j = j + 1;
    }
    // lit_dead — every unioned rel lands Maybe with merged origins
    j = 0;
    while j < a.ld_rel.len {
        let rel = a.ld_rel.buf[j];
        let f = a.ld_cf.buf[j];
        let k: u64 = 0; let found: i64 = 0 - 1;
        while k < inf.ld_rel.len {
            if inf.ld_rel.buf[k] == rel { found = i64(k); }
            k = k + 1;
        }
        if found < 0 {
            c = ats_merge(c, 0, NONE(), f.aoff, f.alen);
            inf.ld_rel = inf.ld_rel.push(rel);
            inf.ld_cf = inf.ld_cf.push(CF {
                k: rel, st: 2, aoff: c.res, alen: u32(c.res2) });
        } else {
            let k2 = u64(found);
            let m = inf.ld_cf.buf[k2];
            c = ats_merge(c, m.aoff, m.alen, f.aoff, f.alen);
            inf.ld_cf.buf[k2].st = 2;
            inf.ld_cf.buf[k2].aoff = c.res;
            inf.ld_cf.buf[k2].alen = u32(c.res2);
        }
        j = j + 1;
    }
    // lit_provs — per-rel prov join
    j = 0;
    while j < a.lp.len {
        let pv0 = a.lp.buf[j];
        let k: u64 = 0; let found: i64 = 0 - 1;
        while k < inf.lp.len {
            if inf.lp.buf[k].k == pv0.k { found = i64(k); }
            k = k + 1;
        }
        if found < 0 {
            inf.lp = inf.lp.push(pv0);
        } else {
            let k2 = u64(found);
            let m = inf.lp.buf[k2];
            c = jprov(c, m.pk, m.pv, pv0.pk, pv0.pv);
            inf.lp.buf[k2].pk = u8(c.res);
            inf.lp.buf[k2].pv = c.res2;
        }
        j = j + 1;
    }
    // lit_lens / lit_tags — first arm copies; later arms retain only
    // entries they agree on
    if first == 1 {
        j = 0;
        while j < a.ll.len {
            inf.ll = inf.ll.push(a.ll.buf[j]);
            j = j + 1;
        }
        j = 0;
        while j < a.lt.len {
            inf.lt = inf.lt.push(a.lt.buf[j]);
            j = j + 1;
        }
    } else {
        let wll = vec.Vec<KI>::new(c.heap);
        j = 0;
        while j < inf.ll.len {
            let e0 = inf.ll.buf[j];
            let w: u64 = 0; let keep: u8 = 0;
            while w < a.ll.len {
                let e1 = a.ll.buf[w];
                if e1.k == e0.k && e1.n == e0.n { keep = 1; }
                w = w + 1;
            }
            if keep == 1 { wll = wll.push(e0); }
            j = j + 1;
        }
        inf.ll.destroy(); inf.ll = wll;
        let wlt = vec.Vec<TG>::new(c.heap);
        j = 0;
        while j < inf.lt.len {
            let e0 = inf.lt.buf[j];
            let w: u64 = 0; let keep: u8 = 0;
            while w < a.lt.len {
                let e1 = a.lt.buf[w];
                if e1.k == e0.k && e1.v == e0.v
                    && e1.has == e0.has { keep = 1; }
                w = w + 1;
            }
            if keep == 1 { wlt = wlt.push(e0); }
            j = j + 1;
        }
        inf.lt.destroy(); inf.lt = wlt;
    }
    return MIU { c: c, m: inf };
}

/// check_match2 — primitive-span form shared by stmt- and expr-
/// position `match` (the a.off/a.len arm window, not a stmt slot).
fn check_match2(own c: Checker, read p: ast.Parser,
                scr: u32, ab: u32, ac: u32, line: u32, col: u32,
                ret: u32, want: u32) -> Checker {
    c = es(c, "(match @");
    c = eu(c, u64(line));
    c = ec(c, u8(58));
    c = eu(c, u64(col));
    c = ec(c, u8(41));
    c = rec(c);
    // scrutinee: a value read of an initialized enum place
    c = expr_tv(c, p, scr);
    let st = c.res;
    let se = p.exps.buf[u64(scr)];
    let skd = ek_num(se.kind);
    if skd == 2 || skd == 7 || skd == 8 || skd == 16 {
        c = require_init(c, p, scr);
    }
    if is_enum_ty(c, st) == 0 {
        let m = vec.Vec<u8>::new(c.heap);
        let m2 = resolve.bputs(m,
            "`match` scrutinee must be an enum, found ");
        let t1 = push_ty(m2, c, st);
        c = t1.c;
        c = pdiag(c, line, col, t1.m.as_slice());
        t1.m.destroy();
        c = rty_prim(c, 9);
        return c;
    }
    let stn = c.r.rtys.buf[u64(st)];
    let ename = stn.name;
    let edi = edecl_of(c, ename);
    let ed = c.r.edecls.buf[u64(edi)];
    // instantiated variant range — a generic scrutinee's payload tys
    // arrive substituted (`Maybe<i32>` → `Some(i32)`); subst_variants
    // appends the instantiated block to `c.r.vars`.
    let voff = u64(ed.vs_off);
    let vlen = u64(ed.vs_len);
    if stn.kind == 13 {
        voff = c.r.vars.len;
        c.r = resolve.subst_variants(c.r, u32(edi), stn.b, stn.c);
        if c.r.suberr != 0 { voff = u64(ed.vs_off); }
    }
    c = resolve_place(c, p, scr);
    let nkeys = c.res4;
    if nkeys == 0 {
        c = pdiag_s(c, line, col,
            "`match` scrutinee must be a place");
        c = rty_prim(c, 9);
        return c;
    }
    let skeys = vec.Vec<u32>::new(c.heap);
    let i: u64 = 0;
    while i < u64(nkeys) {
        skeys = skeys.push(c.pstash.buf[i]);
        i = i + 1;
    }
    // scrutinee-root set for the temp-kill sweep
    let sroots = vec.Vec<u32>::new(c.heap);
    i = 0;
    while i < skeys.len {
        c = key_root(c, skeys.buf[i]);
        sroots = sroots.push(c.res);
        i = i + 1;
    }
    // operand temps materialized inside the scrutinee die with the
    // match head — kill every $rv not rooted at a scrutinee key.
    i = 0;
    while i < c.binds.len {
        let b2 = c.binds.buf[i];
        if n_is_rv(c, b2.n) == 1 {
            c = key_of(c, b2.n, b2.epoch);
            let tk = c.res;
            if vhas(sroots, tk) == 0 {
                c = kill_temp(c, b2.n);
            }
        }
        i = i + 1;
    }
    // arm validation: known variant, no dup, `_` binds nothing.
    let covered = vec.Vec<u32>::new(c.heap);
    let wildcard: u8 = 0;
    i = u64(ab);
    while i < u64(ab) + u64(ac) {
        let a = p.arms.buf[i];
        c.r = resolve.intern_pname(c.r, p, a.variant);
        let avn = c.r.res;
        if nid_lit_eq(c, avn, "_") {
            wildcard = 1;
            if a.bind != NONE() {
                c = pdiag_s(c, line, col,
                    "`_` binds no payload");
            }
            i = i + 1;
            continue;
        }
        let fnd: u8 = 0;
        let vty: u32 = NONE();
        let j: u64 = 0;
        while j < vlen {
            let vd = c.r.vars.buf[voff + j];
            if vd.name == avn { fnd = 1; vty = vd.ty; }
            j = j + 1;
        }
        if fnd == 0 {
            let m = vec.Vec<u8>::new(c.heap);
            let m2 = resolve.bputs(m, "enum `");
            let pt_ = push_ty(m2, c, st);
            c = pt_.c;
            let m3 = pt_.m;
            let m4 = resolve.bputs(m3, "` has no variant `");
            let m5 = push_rname(m4, c, avn);
            let m6 = m5.push(u8(96));
            c = pdiag(c, line, col, m6.as_slice());
            m6.destroy();
            i = i + 1;
            continue;
        }
        if vhas(covered, avn) == 1 {
            let m = vec.Vec<u8>::new(c.heap);
            let m2 = resolve.bputs(m, "duplicate match arm `");
            let m3 = push_rname(m2, c, avn);
            let m4 = m3.push(u8(96));
            c = pdiag(c, line, col, m4.as_slice());
            m4.destroy();
        }
        covered = covered.push(avn);
        if vty == NONE() && a.bind != NONE() {
            let m = vec.Vec<u8>::new(c.heap);
            let m2 = resolve.bputs(m, "variant `");
            let m3 = push_rname(m2, c, avn);
            let m4 = resolve.bputs(m3, "` of `");
            let pt_ = push_ty(m4, c, st);
            c = pt_.c;
            let m5 = pt_.m;
            let m6 = resolve.bputs(m5,
                "` carries no payload to bind");
            c = pdiag(c, line, col, m6.as_slice());
            m6.destroy();
        }
        i = i + 1;
    }
    // missing = enum variants no arm names
    let missing = vec.Vec<u32>::new(c.heap);
    i = 0;
    while i < vlen {
        let vd = c.r.vars.buf[voff + i];
        if vhas(covered, vd.name) == 0 {
            missing = missing.push(vd.name);
        }
        i = i + 1;
    }
    if missing.len > 0 && wildcard == 0 {
        let m = vec.Vec<u8>::new(c.heap);
        let m2 = resolve.bputs(m, "non-exhaustive `match` on `");
        let pt_ = push_ty(m2, c, st);
        c = pt_.c;
        let m3 = pt_.m;
        let m4 = resolve.bputs(m3, "` — missing: ");
        i = 0;
        while i < missing.len {
            if i > 0 { m4 = resolve.bputs(m4, ", "); }
            m4 = push_rname(m4, c, missing.buf[i]);
            i = i + 1;
        }
        c = pdiag(c, line, col, m4.as_slice());
        m4.destroy();
    }
    // per-arm pass: tag forced to the arm's variant, payload paths of
    // the variants it can't hold pruned + dead-marked, body checked,
    // exit state snapped.
    let pre_dead = c.diverged;
    let pre_term = c.terminated;
    let mays_base = u64(c.mays.len);
    let r0 = bs_take(c);
    c = r0.c;
    let pre = r0.bs;
    let snaps = vec.Vec<BS>::new(c.heap);
    c = rty_prim(c, 9);
    let vt = c.res;
    let mys = vec.Vec<u32>::new(c.heap);   // per-arm yield tys
    let mye = vec.Vec<u32>::new(c.heap);   // tail eid | NONE (block arm)
    let myis = vec.Vec<MYI>::new(c.heap);  // per-arm yield captures
    let mypk = vec.Vec<u8>::new(c.heap);   // prov kind
    let mypv = vec.Vec<u32>::new(c.heap);  // prov value
    let myll = vec.Vec<i64>::new(c.heap);  // static slice len
    let mylh = vec.Vec<u8>::new(c.heap);   // len present
    let myd = vec.Vec<u8>::new(c.heap);    // INT_DEFAULT yield
    i = u64(ab);
    while i < u64(ab) + u64(ac) {
        let a = p.arms.buf[i];
        // state already == pre for arm 0; later arms restored at the
        // end of the previous iteration.
        c.r = resolve.intern_pname(c.r, p, a.variant);
        let avn = c.r.res;
        let iswild: u8 = 0;
        if nid_lit_eq(c, avn, "_") { iswild = 1; }
        let fnd: u8 = 0;
        let avty: u32 = NONE();
        let j: u64 = 0;
        while j < vlen {
            let vd = c.r.vars.buf[voff + j];
            if vd.name == avn { fnd = 1; avty = vd.ty; }
            j = j + 1;
        }
        let force: u32 = NONE();
        if iswild == 0 && fnd == 1 { force = avn; }
        let q: u64 = 0;
        while q < skeys.len {
            c = tag_set(c, skeys.buf[q], force);
            q = q + 1;
        }
        // dead-variant set: wildcard kills the covered names; a named
        // arm kills every other variant.
        let prefs = vec.Vec<u32>::new(c.heap);
        j = 0;
        while j < vlen {
            let vd = c.r.vars.buf[voff + j];
            let isdead: u8 = 0;
            if iswild == 1 {
                if vhas(covered, vd.name) == 1 { isdead = 1; }
            } else {
                if vd.name != avn { isdead = 1; }
            }
            if isdead == 1 {
                q = 0;
                while q < skeys.len {
                    c = key_field(c, skeys.buf[q], vd.name);
                    prefs = prefs.push(c.res);
                    q = q + 1;
                }
            }
            j = j + 1;
        }
        c = mdead_prune(c, prefs);
        prefs.destroy();
        // pre-body dead mark: own-authority payloads of dead variants
        j = 0;
        while j < vlen {
            let vd = c.r.vars.buf[voff + j];
            let isdead: u8 = 0;
            if iswild == 1 {
                if vhas(covered, vd.name) == 1 { isdead = 1; }
            } else {
                if vd.name != avn { isdead = 1; }
            }
            if isdead == 1 && vd.ty != NONE() {
                c = reaches_own(c, vd.ty);
                if c.res == 1 {
                    q = 0;
                    while q < skeys.len {
                        c = key_field(c, skeys.buf[q], vd.name);
                        let aoff2 = u32(c.atspans.len);
                        c.atspans = c.atspans.push(line);
                        c.atspans = c.atspans.push(col);
                        c = cons_sil(c, c.res, 1, aoff2, 1);
                        q = q + 1;
                    }
                }
            }
            j = j + 1;
        }
        // payload bind — `V(b)`: ref-mode only when the payload
        // embeds own authority the scrutinee can't surrender.
        let bn: u32 = NONE();
        let bvn: u32 = 0;
        let byref: u8 = 0;
        if a.bind != NONE() && fnd == 1 && avty != NONE() {
            c.r = resolve.intern_pname(c.r, p, a.bind);
            bn = c.r.res;
            bvn = avn;
            c = reaches_own(c, avty);
            if c.res == 1 {
                c = path_holders(c, p, scr);
                q = 0;
                while q < skeys.len {
                    c = key_field(c, skeys.buf[q], avn);
                    let pky = c.res;
                    let au = place_auth_k(c, pky, c.hstash);
                    if au == 1 { byref = 1; }
                    q = q + 1;
                }
            }
            // (armbind @L:C "V" value|ref)
            c = es(c, "(armbind @");
            c = eu(c, u64(line));
            c = ec(c, u8(58));
            c = eu(c, u64(col));
            c = ec(c, u8(32));
            c = eqnid(c, avn);
            c = ec(c, u8(32));
            if byref == 1 { c = es(c, "ref"); }
            else { c = es(c, "value"); }
            c = ec(c, u8(41));
            c = rec(c);
        }
        // body: scope + optional synth let + stmts (+ yield tail)
        c.my_has = 0;
        c.my_ty = vt;
        c.my_tail = NONE(); c.my_llh = 0; c.my_def = 0;
        let abase = c.mays.len;
        if iswild == 0 && bn != NONE() && avty != NONE() {
            // bind against the first scrutinee key (multi-key match
            // places are rvalue-only paths stage-0 doesn't reach).
            // `pidk` is the place_id `.V` path — the binding's own
            // epoch key — vs the resolved `skeys[0]` storage.
            c = place_id(c, p, scr);
            let pidk = c.res;
            if pidk != NONE() {
                c = key_field(c, pidk, avn);
                pidk = c.res;
            }
            c = match_arm_block(c, p, a.off, a.off + a.len, ret,
                bn, bvn, avty, skeys.buf[0], pidk, scr,
                line, col, byref, a.expr_arm, want);
        } else {
            c = match_arm_block(c, p, a.off, a.off + a.len, ret,
                NONE(), 0, NONE(), 0, NONE(), scr, line, col,
                0, a.expr_arm, want);
        }
        // N28 — each reachable arm contributes a yield: a `=> expr`
        // tail's capture, or Void for a `=> { .. }` arm that
        // completes. A diverged arm contributes nothing.
        if c.diverged == 0 {
            if u64(c.mays.len) == abase {
                c.mays = c.mays.push(myi_new(c.heap));
            }
            myis = myis.push(myi_clone(c.heap,
                c.mays.buf[abase]));
            while u64(c.mays.len) > abase {
                myi_free(c.mays.pop());
            }
            if c.my_has == 1 {
                mys = mys.push(c.my_ty);
                mye = mye.push(c.my_tail);
                mypk = mypk.push(c.my_pk);
                mypv = mypv.push(c.my_pv);
                myll = myll.push(c.my_llen);
                mylh = mylh.push(c.my_llh);
                myd = myd.push(c.my_def);
            } else {
                mys = mys.push(vt);    // Void
                mye = mye.push(NONE());
                mypk = mypk.push(u8(0)); mypv = mypv.push(u32(0));
                myll = myll.push(i64(0)); mylh = mylh.push(u8(0));
                myd = myd.push(u8(0));
            }
        } else {
            // a diverged arm contributes nothing — drop any partial
            // capture so indices stay aligned with `mys`
            while u64(c.mays.len) > abase {
                myi_free(c.mays.pop());
            }
        }
        // post-body dead mark — same set; the snap must carry it.
        j = 0;
        while j < vlen {
            let vd = c.r.vars.buf[voff + j];
            let isdead: u8 = 0;
            if iswild == 1 {
                if vhas(covered, vd.name) == 1 { isdead = 1; }
            } else {
                if vd.name != avn { isdead = 1; }
            }
            if isdead == 1 && vd.ty != NONE() {
                c = reaches_own(c, vd.ty);
                if c.res == 1 {
                    q = 0;
                    while q < skeys.len {
                        c = key_field(c, skeys.buf[q], vd.name);
                        let aoff2 = u32(c.atspans.len);
                        c.atspans = c.atspans.push(line);
                        c.atspans = c.atspans.push(col);
                        c = cons_sil(c, c.res, 1, aoff2, 1);
                        q = q + 1;
                    }
                }
            }
            j = j + 1;
        }
        let r1 = bs_take(c);
        c = r1.c;
        snaps = snaps.push(r1.bs);
        // restore pre for the next arm (or the join)
        let r2 = bs_dup(c, pre);
        c = r2.c;
        c = bs_install(c, r2.bs);
        c.diverged = 0;
        c.terminated = 0;
        c = rec_flags(c);
        i = i + 1;
    }
    bs_free(pre);
    // ── N-arm merge ──
    let has_miss: u8 = 0;
    if missing.len > 0 { has_miss = 1; }
    c = match_join(c, snaps, pre_dead, pre_term, has_miss, wildcard);
    missing.destroy();
    covered.destroy();
    skeys.destroy();
    sroots.destroy();
    c = rec_joined(c, p, line, col);
    // ── yield unification (N28) — every live arm must produce the
    // same type. A default-int yield adopts the concrete peer's int
    // type; its literal range re-checks against the winner below.
    let mty: u32 = NONE();
    let mdef: u8 = 0;
    i = 0;
    while i < mys.len {
        let t2 = mys.buf[i];
        let d2 = myd.buf[i];
        if mty == NONE() { mty = t2; mdef = d2; }
        if mty != NONE() && !resolve.ty_eq(c.r, mty, t2) {
            let tk2 = c.r.rtys.buf[u64(t2)].kind;
            let mtk = c.r.rtys.buf[u64(mty)].kind;
            let bad: u8 = 1;
            if mdef == 1 && tk2 <= 7 {
                mty = t2; mdef = 0; bad = 0;
            }
            if bad == 1 && d2 == 1 && mtk <= 7 {
                // keep mty — the default literal adopts it
                bad = 0;
            }
            if bad == 1 {
                // diag at the offending arm's tail span
                let dl = line; let dc = col;
                let te = mye.buf[i];
                if te != NONE() {
                    let tee = xexp(c, p, te);
                    dl = tee.line; dc = tee.col;
                }
                let m = vec.Vec<u8>::new(c.heap);
                let m2 = resolve.bputs(m,
                    "match arms produce different types: `");
                let t1 = push_ty(m2, c, mty);
                c = t1.c;
                let m3 = resolve.bputs(t1.m, "` vs `");
                let t2b = push_ty(m3, c, t2);
                c = t2b.c;
                let m4 = resolve.bputs(t2b.m, "`");
                c = pdiag(c, dl, dc, m4.as_slice());
                m4.destroy();
            }
        }
        i = i + 1;
    }
    // Every arm diverged → the expression never yields; adopt `want`
    // (or Void) so `let x: T = <diverging match>` still checks.
    if mty == NONE() {
        if want != NONE() { mty = want; } else { mty = vt; }
    }
    // literal re-check — default-int yields coerce to the winner.
    if mdef == 0 && c.r.rtys.buf[u64(mty)].kind <= 7 {
        i = 0;
        while i < mys.len {
            if myd.buf[i] == 1 && mye.buf[i] != NONE() {
                c = coerce(c, p, mty, mye.buf[i],
                           mys.buf[i]);
            }
            i = i + 1;
        }
    }
    // value-side join — prov via jprov over non-void yields; a static
    // slice len survives only when every arm agrees; refs/caps/lit_*
    // fold through myi_union (stage-0's ArmYieldInfo merge).
    let jpk: u8 = 0; let jpv: u32 = 0;
    let jlen: i64 = 0; let jlh: u8 = 0;
    let first: u8 = 1;
    let inf = myi_new(c.heap);
    i = 0;
    while i < mys.len {
        if mys.buf[i] != vt {               // skip Void yields
            if first == 1 {
                jpk = mypk.buf[i]; jpv = mypv.buf[i];
                jlen = myll.buf[i]; jlh = mylh.buf[i];
            } else {
                c = jprov(c, jpk, jpv, mypk.buf[i], mypv.buf[i]);
                jpk = u8(c.res); jpv = c.res2;
                if jlh == 0 || mylh.buf[i] == 0
                    || jlen != myll.buf[i] {
                    jlh = 0;
                }
            }
            let r = myi_union(c, inf, myis.buf[i], first);
            c = r.c; inf = r.m;
            first = 0;
        }
        i = i + 1;
    }
    c = es(c, "(yield @");
    c = eu(c, u64(line));
    c = ec(c, u8(58));
    c = eu(c, u64(col));
    c = ec(c, u8(41));
    c = rec(c);
    // record the yield for expr-position consumers (ety_at etc.)
    let yi: u32 = NONE();
    if jlh == 1 {
        c.mylens = c.mylens.push(jlen);
        yi = u32(c.mylens.len) - 1;
    }
    c.myinfos = c.myinfos.push(inf);
    c.myields = c.myields.push(MY {
        line: line, col: col, ty: mty, pk: jpk, pv: jpv, y: yi,
        z: u32(c.myinfos.len) - 1 });
    // per-arm captures die with the join — the joined record lives on
    while u64(c.mays.len) > mays_base {
        myi_free(c.mays.pop());
    }
    while myis.len > 0 { myi_free(myis.pop()); }
    myis.destroy();
    mys.destroy(); mye.destroy();
    mypk.destroy(); mypv.destroy();
    myll.destroy(); mylh.destroy(); myd.destroy();
    c.res = mty;
    c.res2 = u32(jpk); c.res3 = jpv;
    return c;
}

fn check_region(own c: Checker, read p: ast.Parser,
                s: ast.Stmt, ret: u32) -> Checker {
    c.r = resolve.intern_pname(c.r, p, s.a);
    let n = c.r.res;
    c.regs = c.regs.push(RegF { name: n, parent: cur_region(c) });
    // (region "n" "parent" @L:C) — parent is the ENCLOSING frame name
    c = es(c, "(region ");
    c = eqs_r(c, &c.r.rbyt.buf[u64(c.r.rns.buf[u64(n)].off)..
        u64(c.r.rns.buf[u64(n)].off) + u64(c.r.rns.buf[u64(n)].len)]);
    c = ec(c, u8(32));
    let pr = c.regs.buf[u64(cur_region(c))].parent;
    if pr != NONE() {
        let pn = c.regs.buf[u64(pr)].name;
        let sp = c.r.rns.buf[u64(pn)];
        c = eqs_r(c, &c.r.rbyt.buf[u64(sp.off)..
            u64(sp.off) + u64(sp.len)]);
    } else { c = es(c, "?"); }
    c = es(c, " @");
    c = eu(c, u64(s.line));
    c = ec(c, u8(58));
    c = eu(c, u64(s.col));
    c = rec(c);
    c = check_block(c, p, s.b, s.b + s.c, 0, ret);
    c = es(c, "(region-pop ");
    c = eqs_r(c, &c.r.rbyt.buf[u64(c.r.rns.buf[u64(n)].off)..
        u64(c.r.rns.buf[u64(n)].off) + u64(c.r.rns.buf[u64(n)].len)]);
    c = ec(c, u8(41));
    c = rec(c);
    c.regs.pop();
    return c;
}

fn check_promote(own c: Checker, read p: ast.Parser,
                 s: ast.Stmt, ret: u32) -> Checker {
    // promote moves the binding's owner one region out; every alias
    // edge held inside x's subtree must target a place that outlives
    // the destination (edge closure, not a graph walk).
    let e = p.exps.buf[u64(s.a)];
    if ek_num(e.kind) != 2 {
        let m = vec.Vec<u8>::new(c.heap);
        let m2 = resolve.bputs(m, "promote requires a variable");
        c = pdiag(c, s.line, s.col, m2.as_slice());
        m2.destroy();
        return c;
    }
    c.r = resolve.intern_pname(c.r, p, e.a);
    let n = c.r.res;
    let bi = bfind(c, n);
    if i64(bi) < 0 {
        let m = vec.Vec<u8>::new(c.heap);
        let m2 = resolve.bputs(m, "undefined variable `");
        let m3 = push_rname(m2, c, n);
        let m4 = m3.push(u8(96));
        c = pdiag(c, s.line, s.col, m4.as_slice());
        m4.destroy();
        return c;
    }
    let b = c.binds.buf[u64(bi)];
    let pr = c.regs.buf[u64(b.owner)].parent;
    if pr == NONE() {
        let m = vec.Vec<u8>::new(c.heap);
        let m2 = resolve.bputs(m, "cannot promote `");
        let m3 = push_rname(m2, c, n);
        let m4 = resolve.bputs(m3, "` out of the function frame");
        c = pdiag(c, s.line, s.col, m4.as_slice());
        m4.destroy();
        return c;
    }
    let dest = pr;
    c = key_of(c, n, b.epoch);
    let key = c.res;
    let dl = defer_conflict(c, key);
    if dl != NONE() {
        let m = vec.Vec<u8>::new(c.heap);
        let m2 = resolve.bputs(m, "cannot promote `");
        let m3 = push_rname(m2, c, n);
        let m4 = resolve.bputs(m3,
            "`: it is reserved by the `defer` at line ");
        let m5 = loader.bpush_u64(m4, u64(dl));
        c = pdiag(c, s.line, s.col, m5.as_slice());
        m5.destroy();
        return c;
    }
    let i: u64 = 0;
    while i < c.edges.len {
        let eg = c.edges.buf[i];
        // under_x = h == key || h under `key.`/`key[`; internal edges
        // (target rooted at key) move with the value.
        if kroot_eq(c, key, eg.h) == 1
            && kroot_eq(c, key, eg.t) == 0 {
            let tsp = c.kns.buf[u64(eg.t)];
            let rend: u64 = 0;
            while rend < u64(tsp.len) {
                let x = c.kbyt.buf[u64(tsp.off) + rend];
                if x == u8(46) || x == u8(91) { break; }
                rend = rend + 1;
            }
            let nend: u64 = 0;
            while nend < rend {
                if c.kbyt.buf[u64(tsp.off) + nend] == u8(35) { break; }
                nend = nend + 1;
            }
            let tnid = rns_find_kbytes(c, u64(tsp.off), nend);
            let towner = NONE();
            if tnid != NONE() {
                let bj = bfind(c, tnid);
                if i64(bj) >= 0 {
                    let bb = c.binds.buf[u64(bj)];
                    c = key_of(c, tnid, bb.epoch);
                    if kroot_eq(c, c.res, eg.t) == 1 {
                        towner = bb.owner;
                    }
                }
            }
            if towner != NONE()
                && outlives(c, 2, towner, 2, dest) == 0 {
                let m = vec.Vec<u8>::new(c.heap);
                let m2 = resolve.bputs(m,
                    "dangling edge after promote: `");
                let m3 = push_rname(m2, c, n);
                let m4 = resolve.bputs(m3,
                    "` holds a reference to `");
                let m5 = push_rname(m4, c, tnid);
                let m6 = resolve.bputs(m5,
                    "`, which dies in region `");
                let m7 = push_rname(m6, c,
                    c.regs.buf[u64(towner)].name);
                let m8 = m7.push(u8(96));
                c = pdiag(c, s.line, s.col, m8.as_slice());
                m8.destroy();
            }
        }
        i = i + 1;
    }
    // identity edges out of x never block — a stale handle is a
    // use-site error, not a promote error.
    c.binds.buf[u64(bi)].owner = dest;
    return c;
}

fn check_consume(own c: Checker, read p: ast.Parser,
                 s: ast.Stmt, ret: u32) -> Checker {
    // `consume p` — the standalone affine transfer (same law as an
    // `own` call arg, minus the call).
    return consume_place(c, p, s.a);
}

/// defer_place_form — s0's operand shape gate: a deferred call
/// re-evaluates its operand places at exit, so args must be place
/// paths or literals (Var/Int/Bool/Str; Deref/Field/Index/Range
/// recurse into their parts).
fn defer_place_form(read c: Checker, read p: ast.Parser,
                    eid: u32) -> u8 {
    let e = xexp(c, p, eid);
    let k = ek_num(e.kind);
    if k == 2 || k == 0 || k == 1 || k == 3 { return 1; }
    if k == 16 { return defer_place_form(c, p, e.a); }
    if k == 7 { return defer_place_form(c, p, e.a); }
    if k == 8 {
        if defer_place_form(c, p, e.a) == 0 { return 0; }
        return defer_place_form(c, p, e.b);
    }
    if k == 9 {
        if defer_place_form(c, p, e.a) == 0 { return 0; }
        if e.b != NONE() && defer_place_form(c, p, e.b) == 0 { return 0; }
        if e.c != NONE() && defer_place_form(c, p, e.c) == 0 { return 0; }
        return 1;
    }
    return 0;
}

/// defer_collect — s0's collect_place_keys: Index/IndexRange gather
/// their sub-exprs' keys before the place's own; Var/Field/Deref
/// contribute resolve_place keys; anything else contributes none.
fn defer_collect(own c: Checker, read p: ast.Parser,
                 eid: u32) -> Checker {
    let e = xexp(c, p, eid);
    let k = ek_num(e.kind);
    if k == 8 {
        c = defer_collect(c, p, e.a);
        c = defer_collect(c, p, e.b);
    } else { if k == 9 {
        c = defer_collect(c, p, e.a);
        if e.b != NONE() { c = defer_collect(c, p, e.b); }
        if e.c != NONE() { c = defer_collect(c, p, e.c); }
    } else { if k != 2 && k != 7 && k != 16 {
        return c;
    } } }
    c = resolve_place(c, p, eid);
    let j: u64 = 0;
    while j < u64(c.res4) {
        c.df_keys = c.df_keys.push(c.pstash.buf[j]);
        j = j + 1;
    }
    return c;
}

/// df_sort_win — ksort + dedup a df_keys window in place.
fn df_sort_win(own c: Checker, off: u32) -> Checker {
    let w = vec.Vec<u32>::new(c.heap);
    let i: u64 = u64(off);
    while i < c.df_keys.len {
        w = w.push(c.df_keys.buf[i]);
        i = i + 1;
    }
    w = ksort(c, w);
    while c.df_keys.len > u64(off) { c.df_keys.pop(); }
    i = 0;
    while i < w.len {
        if i == 0 || w.buf[i] != w.buf[i - 1] {
            c.df_keys = c.df_keys.push(w.buf[i]);
        }
        i = i + 1;
    }
    w.destroy();
    return c;
}

fn check_defer(own c: Checker, read p: ast.Parser,
               s: ast.Stmt, ret: u32) -> Checker {
    let e = xexp(c, p, s.a);
    let dk = ek_num(e.kind);
    // s0 sees post-desugar Calls: MethodCall always is one; AssocFn
    // only when a cres row exists (else it's a variant literal).
    let is_call: u8 = 0;
    if dk == 6 || dk == 19 { is_call = 1; }
    if dk == 20 {
        c = callee_of(c, p, s.a);
        if c.res != NONE() { is_call = 1; }
    }
    if is_call == 0 {
        c = pdiag_s(c, s.line, s.col,
            "`defer` expects a call: `defer f(place, ..)`");
        return c;
    }
    let na = call_nargs(c, p, s.a);
    let bad: u8 = 0;
    let i: u64 = 0;
    while i < na {
        c = call_arg(c, p, e, s.a, i);
        if defer_place_form(c, p, c.res) == 0 { bad = 1; }
        i = i + 1;
    }
    if bad == 1 {
        c = pdiag_s(c, s.line, s.col,
            "`defer` operands must be place paths or literals — bind computed values first");
    }
    c = es(c, "(defer @");
    c = eu(c, u64(s.line));
    c = ec(c, u8(58));
    c = eu(c, u64(s.col));
    c = ec(c, u8(41));
    c = rec(c);
    // Dry-run on a cloned state, events truncated: diagnostics surface
    // at the defer site (drained + re-emitted), effects do not.
    let bx = bs_take(c);
    c = bx.c;
    let s_holds = clone_km(c.heap, c.holds);
    let s_doms = clone_kk(c.heap, c.doms);
    let s_slens = clone_ki(c.heap, c.slens);
    let s_csafe = clone_u(c.heap, c.csafe);
    let s_foreign = clone_u(c.heap, c.foreign);
    let s_iw = clone_u(c.heap, c.iw);
    let s_aa = clone_kk(c.heap, c.arg_atomic);
    let s_am = clone_kk(c.heap, c.arg_mutex);
    let s_ac = clone_kk(c.heap, c.arg_chan);
    let s_epoch = c.next_epoch;
    let s_xel = c.xexps.len; let s_xml = c.xmap.len;
    let s_ovrl = c.ovr.len; let s_ovron = c.ovr_on;
    let s_myl = c.myields.len; let s_myll = c.mylens.len;
    let s_mayl = c.mays.len; let s_myil = c.myinfos.len;
    let s_my_has = c.my_has; let s_my_ty = c.my_ty;
    let s_my_pk = c.my_pk; let s_my_pv = c.my_pv;
    let s_mytail = c.my_tail; let s_myllen = c.my_llen;
    let s_myllh = c.my_llh; let s_mydef = c.my_def;
    let evlen = c.ev.len;
    let errn = c.errs.len;
    c = expr_tv(c, p, s.a);
    let rt = c.res;
    // consumes — keys the dry-run consumed/killed that were live
    // before (sorted+dedup'd union of cons ∪ edge_kills).
    let cw = vec.Vec<u32>::new(c.heap);
    let i2: u64 = 0;
    while i2 < c.cons.len {
        let kk = c.cons.buf[i2].k;
        if cons_in(c, bx.bs.cons, kk) == 0 && vhas(cw, kk) == 0 {
            cw = cw.push(kk);
        }
        i2 = i2 + 1;
    }
    i2 = 0;
    while i2 < c.ekills.len {
        let kk = c.ekills.buf[i2].k;
        if init_in(c, bx.bs.ekills, kk) == 0 && vhas(cw, kk) == 0 {
            cw = cw.push(kk);
        }
        i2 = i2 + 1;
    }
    // restore — state rolls back to the defer site.
    c = bs_install(c, bx.bs);
    c.holds.destroy(); c.holds = s_holds;
    c.doms.destroy(); c.doms = s_doms;
    c.slens.destroy(); c.slens = s_slens;
    c.csafe.destroy(); c.csafe = s_csafe;
    c.foreign.destroy(); c.foreign = s_foreign;
    c.iw.destroy(); c.iw = s_iw;
    c.arg_atomic.destroy(); c.arg_atomic = s_aa;
    c.arg_mutex.destroy(); c.arg_mutex = s_am;
    c.arg_chan.destroy(); c.arg_chan = s_ac;
    c.next_epoch = s_epoch;
    while c.xexps.len > s_xel { c.xexps.pop(); }
    while c.xmap.len > s_xml { c.xmap.pop(); }
    while c.ovr.len > s_ovrl { c.ovr.pop(); }
    c.ovr_on = s_ovron;
    while c.myields.len > s_myl { c.myields.pop(); }
    while c.mylens.len > s_myll { c.mylens.pop(); }
    while c.mays.len > s_mayl { c.mays.pop(); }
    while c.myinfos.len > s_myil { c.myinfos.pop(); }
    c.my_has = s_my_has; c.my_ty = s_my_ty;
    c.my_pk = s_my_pk; c.my_pv = s_my_pv;
    c.my_tail = s_mytail; c.my_llen = s_myllen;
    c.my_llh = s_myllh; c.my_def = s_mydef;
    while c.ev.len > evlen { c.ev.pop(); }
    // drained dry-run diags — s0 re-emits their (err …) events here.
    i2 = errn;
    while i2 < c.errs.len {
        let d = c.errs.buf[i2];
        c = err_rec(c, d.line, d.col,
            &c.ebyt.buf[u64(d.m0)..u64(d.m1)], d.l0, d.l1, d.n0, d.n1);
        i2 = i2 + 1;
    }
    if c.r.rtys.buf[u64(rt)].kind != 9 {
        let m = vec.Vec<u8>::new(c.heap);
        let m2 = resolve.bputs(m,
            "`defer` runs a `void` call, but it returns ");
        let t1 = push_ty(m2, c, rt);
        c = t1.c;
        c = pdiag(c, s.line, s.col, t1.m.as_slice());
        t1.m.destroy();
    }
    // operands — every place the call reads, sorted+dedup'd.
    let ooff = u32(c.df_keys.len);
    i2 = 0;
    while i2 < na {
        c = call_arg(c, p, e, s.a, i2);
        c = defer_collect(c, p, c.res);
        i2 = i2 + 1;
    }
    c = df_sort_win(c, ooff);
    let olen = u32(c.df_keys.len) - ooff;
    // consumes — sorted+dedup'd, appended after the operand window.
    let coff = u32(c.df_keys.len);
    i2 = 0;
    while i2 < cw.len {
        c.df_keys = c.df_keys.push(cw.buf[i2]);
        i2 = i2 + 1;
    }
    cw.destroy();
    c = df_sort_win(c, coff);
    let clen = u32(c.df_keys.len) - coff;
    // reservations — operands then consumes (s0's chain order).
    i2 = u64(ooff);
    while i2 < u64(ooff) + u64(olen) {
        c = dres_set(c, c.df_keys.buf[i2], s.line, s.col);
        i2 = i2 + 1;
    }
    i2 = u64(coff);
    while i2 < u64(coff) + u64(clen) {
        c = dres_set(c, c.df_keys.buf[i2], s.line, s.col);
        i2 = i2 + 1;
    }
    if c.defers.len > 0 {
        c = es(c, "(defer-reg @");
        c = eu(c, u64(s.line));
        c = ec(c, u8(58));
        c = eu(c, u64(s.col));
        c = ec(c, u8(41));
        c = rec(c);
        let frame = c.defers.buf[u64(c.defers.len - 1)];
        let f2 = frame.push(DeferRec {
            eid: s.a, ooff: ooff, olen: olen,
            coff: coff, clen: clen });
        c.defers.buf[u64(c.defers.len - 1)] = f2;
    }
    return c;
}

/// check_block — `(scope)` … stmt list … `(pop)`.
fn check_block(own c: Checker, read p: ast.Parser,
               b: u32, e_: u32, has: u8, ret: u32) -> Checker {
    c = push_scope(c);
    // b..e when has==0 is a u32s range [stmts]; when has==1 it's the
    // else-half: p.u32s[b-?] — callers pass the sub-range indices
    // directly (b/e are u32s positions).
    let pending = vec.Vec<u32>::new(c.heap);
    // back-edge temp re-materialization handed down by check_while —
    // the appended `$rvN = <call>` runs inside this scope, last.
    let tlo = c.tail_lo; let thi = c.tail_hi;
    c.tail_lo = NONE(); c.tail_hi = 0;
    let i: u64 = u64(b);
    let last_l: u32 = 0; let last_c: u32 = 0; let has_last: u8 = 0;
    while i < u64(e_) {
        let sid = p.u32s.buf[i];
        let st = p.stmts.buf[u64(sid)];
        if c.terminated == 1 { break; }
        let mark = c.rv_new.len;
        c = lower_s(c, p, sid, ret, 1);
        c = check_stmt(c, p, sid, ret);
        // temps die oldest-first — Stage-0's pending drain order.
        let q = mark;
        while q < c.rv_new.len {
            c = kill_temp(c, c.rv_new.buf[q]);
            q = q + 1;
        }
        while u64(c.rv_new.len) > mark { c.rv_new.pop(); }
        last_l = st.line; last_c = st.col; has_last = 1;
        if sk_num(st.kind) == 0 {
            c.r = resolve.intern_pname(c.r, p, st.a);
            if n_is_rv(c, c.r.res) == 1 {
                pending = pending.push(c.r.res);
                i = i + 1;
                continue;
            }
        }
        let q2: u64 = 0;
        while q2 < pending.len {
            c = kill_temp(c, pending.buf[q2]);
            q2 = q2 + 1;
        }
        while pending.len > 0 { pending.pop(); }
        i = i + 1;
    }
    if tlo != NONE() && c.terminated == 0 {
        c = rv_remat(c, p, tlo, thi, ret);
    }
    pending.destroy();
    c = pop_scope_defers(c, p);
    let cp = pop_scope_names(c);
    c = cp.c;
    c = expire_scope(c, cp.popped, last_l, last_c, has_last,
        "the enclosing scope ends");
    c = es(c, "(pop)");
    c = rec(c);
    return c;
}

