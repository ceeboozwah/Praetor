        pk_caps: vec.Vec<C3>::new(heap),
        pk_sent: vec.Vec<u32>::new(heap),
        defers: vec.Vec<vec.Vec<DeferRec>>::new(heap),
        df_keys: vec.Vec<u32>::new(heap),
        dres: vec.Vec<DR>::new(heap),
        loops: vec.Vec<LoopCtx>::new(heap),
        has_lit: 0, has_tag: 0, tag_v: 0, tag_has: 0,
        has_lock: 0, lock_dom: 0, lock_root: 0, lock_ty: 0,
        lock_off: 0, lock_len: 0,
        has_mutex: 0, mx_off: 0, mx_len: 0,
        has_recv: 0, recv_pkt: 0,
        cg: vec.Vec<u32>::new(heap),
        has_spawn: 0, spawn_eff: 0,
        last_spawn_tk: 0,
        sp_line: 0, sp_col: 0, sp_hoff: 0, sp_hlen: 0,
        teffs: vec.Vec<TaskEff>::new(heap),
        glocks: vec.Vec<u32>::new(heap),
        pkt_stash: vec.Vec<Packet>::new(heap),
        tk_holds: vec.Vec<KM>::new(heap),
        task_ret: NONE(), task_ext: vec.Vec<u32>::new(heap),
        fn_ret: 0,
        next_epoch: 0,
        diverged: 0, terminated: 0,
        cmap: vec.Vec<resolve.MapE>::new(heap),
        rvnext: 0, cond_depth: 0,
        refresh: vec.Vec<Refresh>::new(heap),
        myields: vec.Vec<MY>::new(heap),
        mylens: vec.Vec<i64>::new(heap),
        snap_edges: vec.Vec<E2>::new(heap),
        snap_caps: vec.Vec<C3>::new(heap),
        snap_cons: vec.Vec<CF>::new(heap),
        snap_init: vec.Vec<MapE2>::new(heap),
        snap_ekills: vec.Vec<MapE2>::new(heap),
        snap_ckills: vec.Vec<MapE2>::new(heap),
        snap_provs: vec.Vec<PV>::new(heap),
        snap_transit: vec.Vec<u32>::new(heap),
        snap_tag: vec.Vec<TG>::new(heap),
        snap_chans: vec.Vec<CQ>::new(heap),
        snap_defers: vec.Vec<vec.Vec<DeferRec>>::new(heap),
        snap_dres: vec.Vec<DR>::new(heap),
        snap_diverged: 0, snap_terminated: 0,
        scrv: vec.Vec<u8>::new(heap),
        cbuf: vec.Vec<u32>::new(heap),
        hstash: vec.Vec<u32>::new(heap),
        res: 0, res2: 0, res3: 0, res4: 0, res5: 0,
    };
    return c;
}

// ---- emit helpers ------------------------------------------------------

fn es(own c: Checker, s: str) -> Checker {
    c.ev = resolve.bputs(c.ev, s);
    return c;
}
fn ec(own c: Checker, b: u8) -> Checker {
    c.ev = c.ev.push(b);
    return c;
}
fn eu(own c: Checker, n: u64) -> Checker {
    c.ev = resolve.bu32(c.ev, n);
    return c;
}

/// `"…"` quoting — backslash, quote, \n, \t, \uXXXX under 0x20.
fn eqs_b(own v: vec.Vec<u8>, s: slice u8) -> vec.Vec<u8> {
    v = v.push(u8(34));
    let i: u64 = 0;
    while i < s.len {
        let b = s[i];
        if b == u8(34) { v = resolve.bputs(v, "\\\""); }
        else { if b == u8(92) { v = resolve.bputs(v, "\\\\"); }
        else { if b == u8(10) { v = resolve.bputs(v, "\\n"); }
        else { if b == u8(9) { v = resolve.bputs(v, "\\t"); }
        else {
            if b < u8(32) {
                v = resolve.bputs(v, "\\u00");
                let hi = b / u8(16);
                let lo = b % u8(16);
                if hi < u8(10) { v = v.push(u8(48) + hi); }
                else { v = v.push(u8(87) + hi); }
                if lo < u8(10) { v = v.push(u8(48) + lo); }
                else { v = v.push(u8(87) + lo); }
            } else { v = v.push(b); }
        } } } }
        i = i + 1;
    }
    v = v.push(u8(34));
    return v;
}

/// `"name"` — the key nid's bytes, quoted.
fn eqs(own c: Checker, k: u32) -> Checker {
    let sp = c.kns.buf[u64(k)];
    let i: u64 = 0;
    c.ev = c.ev.push(u8(34));
    while i < u64(sp.len) {
        let b = c.kbyt.buf[u64(sp.off) + i];
        if b == u8(34) { c.ev = resolve.bputs(c.ev, "\\\""); }
        else { if b == u8(92) { c.ev = resolve.bputs(c.ev, "\\\\"); }
        else { c.ev = c.ev.push(b); } }
        i = i + 1;
    }
    c.ev = c.ev.push(u8(34));
    return c;
}

/// `"…"` on a raw byte slice in `ebyt` or elsewhere.
fn eqs_r(own c: Checker, b: slice u8) -> Checker {
    c.ev = eqs_b(c.ev, b);
    return c;
}

/// ` @L:C` — empty when line == 0 sentinel (None span).
fn eat(own c: Checker, has: u8, line: u32, col: u32) -> Checker {
    if has == 0 { return c; }
    c = es(c, " @");
    c = eu(c, u64(line));
    c = ec(c, u8(58));
    return eu(c, u64(col));
}

fn eauth(own c: Checker, a: u8) -> Checker {
    if a == 1 { return es(c, "read"); }
    if a == 2 { return es(c, "write"); }
    if a == 3 { return es(c, "own"); }
    if a == 4 { return es(c, "atomic"); }
    if a == 5 { return es(c, "sync"); }
    return es(c, "?");
}
fn ecert(own c: Checker, v: u8) -> Checker {
    if v == 1 { return es(c, "def"); }
    return es(c, "maybe");
}
/// Prov code -> `?`/`param`/`"name"`.
fn eprov(own c: Checker, pk: u8, pv: u32) -> Checker {
    if pk == 1 { return es(c, "param"); }
    if pk == 0 { return es(c, "?"); }
    let rf = c.regs.buf[u64(pv)];
    let sp = c.r.rns.buf[u64(rf.name)];
    return eqs_r(c, &c.r.rbyt.buf[u64(sp.off)..
        u64(sp.off) + u64(sp.len)]);
}

fn rec(own c: Checker) -> Checker {
    c.ev = c.ev.push(u8(10));
    return c;
}

// ---- place-key interning ------------------------------------------------
// Keys are byte strings: `n#e` (binding), `$argN`, `k.f`, `k[]`, `k.v`.
// The key arena is separate from the resolver's name space so nids
// never alias decl names.

fn kin(own c: Checker, s: slice u8) -> Checker {
    let i: u64 = 0;
    while i < c.kns.len {
        let sp = c.kns.buf[i];
        if u64(sp.len) == s.len {
            let j: u64 = 0;
            let same: u8 = 1;
            while j < s.len {
                if c.kbyt.buf[u64(sp.off) + j] != s[j] { same = 0; }
                j = j + 1;
            }
            if same == 1 { c.res = u32(i); return c; }
        }
        i = i + 1;
    }
    c.kns = c.kns.push(loader.Span2 {
        off: u32(c.kbyt.len), len: u32(s.len) });
    c.kbyt = resolve.bpush(c.kbyt, s);
    c.res = u32(c.kns.len) - 1;
    return c;
}

/// key bytes of nid `k` — for scans/compares.
fn kbytes(read c: Checker, k: u32) -> slice u8 {
    let sp = c.kns.buf[u64(k)];
    return &c.kbyt.buf[u64(sp.off)..u64(sp.off) + u64(sp.len)];
}

/// lexical compare of two keys' bytes — for sorted emits.
fn kless(read c: Checker, a: u32, b: u32) -> u8 {
    let sa = c.kns.buf[u64(a)];
    let sb = c.kns.buf[u64(b)];
    let n = u64(sa.len);
    if u64(sb.len) < n { n = u64(sb.len); }
    let i: u64 = 0;
    while i < n {
        let x = c.kbyt.buf[u64(sa.off) + i];
        let y = c.kbyt.buf[u64(sb.off) + i];
        if x != y { if x < y { return 1; } return 0; }
        i = i + 1;
    }
    if sa.len < sb.len { return 1; }
    return 0;
}

/// `n#e` — the binding's place key; name is a resolver nid.
fn key_of(own c: Checker, name: u32, epoch: u32) -> Checker {
    let sp = c.r.rns.buf[u64(name)];
    let i: u64 = 0;
    while i < u64(sp.len) {
        c.ksc = c.ksc.push(c.r.rbyt.buf[u64(sp.off) + i]);
        i = i + 1;
    }
    c.ksc = c.ksc.push(u8(35));
    c.ksc = resolve.bu32(c.ksc, u64(epoch));
    let s0 = u64(c.ksc.len);
    c = kin(c, &c.ksc.buf[0..s0]);
    while u64(c.ksc.len) > 0 { c.ksc.pop(); }
    return c;
}

/// `k` + raw suffix bytes — `[]`, `.*`, `[i]` paths.
fn key_ext(own c: Checker, k: u32, s: slice u8) -> Checker {
    let sp = c.kns.buf[u64(k)];
    let i: u64 = 0;
    while i < u64(sp.len) {
        c.ksc = c.ksc.push(c.kbyt.buf[u64(sp.off) + i]);
        i = i + 1;
    }
    c.ksc = resolve.bpush(c.ksc, s);
    let s0 = u64(c.ksc.len);
    c = kin(c, &c.ksc.buf[0..s0]);
    while u64(c.ksc.len) > 0 { c.ksc.pop(); }
    return c;
}

/// `*k` — the un-mapped span fallback key.
fn key_pstar(own c: Checker, k: u32) -> Checker {
    c.ksc = c.ksc.push(u8(42));
    let sp = c.kns.buf[u64(k)];
    let i: u64 = 0;
    while i < u64(sp.len) {
        c.ksc = c.ksc.push(c.kbyt.buf[u64(sp.off) + i]);
        i = i + 1;
    }
    let s0 = u64(c.ksc.len);
    c = kin(c, &c.ksc.buf[0..s0]);
    while u64(c.ksc.len) > 0 { c.ksc.pop(); }
    return c;
}

/// A literal-string key — `$argN`, synthetic names.
fn key_str(own c: Checker, s: slice u8) -> Checker {
    c = kin(c, s);
    return c;
}

/// `k.f` — field hop on a place key; fname is a resolver nid.
fn key_field(own c: Checker, k: u32, fname: u32) -> Checker {
    let sp = c.kns.buf[u64(k)];
    let i: u64 = 0;
    while i < u64(sp.len) {
        c.ksc = c.ksc.push(c.kbyt.buf[u64(sp.off) + i]);
        i = i + 1;
    }
    c.ksc = c.ksc.push(u8(46));
    let fp = c.r.rns.buf[u64(fname)];
    i = 0;
    while i < u64(fp.len) {
        c.ksc = c.ksc.push(c.r.rbyt.buf[u64(fp.off) + i]);
        i = i + 1;
    }
    let s0 = u64(c.ksc.len);
    c = kin(c, &c.ksc.buf[0..s0]);
    while u64(c.ksc.len) > 0 { c.ksc.pop(); }
    return c;
}

// ---- channel mutators + emits -------------------------------------------
// Every state commit emits first, then mutates — the event stream is
// scan-order, exactly like Stage-0's `*_set` family.

fn edge_set(own c: Checker, h: u32, t: u32,
            kind: u8, cert: u8, bl: u32, bc: u32) -> Checker {
    c = es(c, "(edge ");
    c = eqs(c, h);
    c = es(c, " -> ");
    c = eqs(c, t);
    c = ec(c, u8(32));
    c = eauth(c, kind);
    c = ec(c, u8(32));
    c = ecert(c, cert);
    c = eat(c, eat_b(bl, bc), bl, bc);
    c = ec(c, u8(41));
    c = rec(c);
    c.edges = c.edges.push(E2 { h: h, t: t, kind: kind, cert: cert,
        bl: bl, bc: bc });
    return c;
}

/// born commit — `has`==0 means no born span (0,0).
fn edge_set0(own c: Checker, h: u32, t: u32, kind: u8, cert: u8,
             bl: u32, bc: u32, has: u8) -> Checker {
    if has == 0 { return edge_set(c, h, t, kind, cert, 0, 0); }
    return edge_set(c, h, t, kind, cert, bl, bc);
}

/// Find edge (h,t) — returns idx | -1.
fn edge_at(read c: Checker, h: u32, t: u32) -> i64 {
    let i: u64 = 0;
    while i < c.edges.len {
        let e = c.edges.buf[i];
        if e.h == h && e.t == t { return i64(i); }
        i = i + 1;
    }
    return 0 - 1;
}

fn cap_set(own c: Checker, h: u32, t: u32, cert: u8) -> Checker {
    c = es(c, "(cap ");
    c = eqs(c, h);
    c = es(c, " -> ");
    c = eqs(c, t);
    c = ec(c, u8(32));
    c = ecert(c, cert);
    c = ec(c, u8(41));
    c = rec(c);
    c.caps = c.caps.push(C3 { h: h, t: t, cert: cert });
    return c;
}

/// Cons overwrite — the fact's at-sites print in order, then insert
/// replaces (HashMap::insert semantics). `at` lives in `atspans` as
/// (line,col) pairs; `alen` counts sites.
fn cons_set(own c: Checker, k: u32, st: u8,
            aoff: u32, alen: u32) -> Checker {
    c = es(c, "(cons ");
    c = eqs(c, k);
    c = ec(c, u8(32));
    if st == 1 { c = es(c, "cons"); } else { c = es(c, "maybe"); }
    let j: u64 = u64(aoff);
    let jn = j + u64(alen) * 2;
    while j < jn {
        c = eat(c, 1, c.atspans.buf[j], c.atspans.buf[j + 1]);
        j = j + 2;
    }
    c = ec(c, u8(41));
    c = rec(c);
    let i: u64 = 0;
    while i < c.cons.len {
        if c.cons.buf[i].k == k {
            c.cons.buf[i].st = st;
            c.cons.buf[i].aoff = aoff;
            c.cons.buf[i].alen = alen;
            return c;
        }
        i = i + 1;
    }
    c.cons = c.cons.push(CF { k: k, st: st, aoff: aoff, alen: alen });
    return c;
}

/// `ConsFact::cons(span)` — single-site definite consume.
fn cons1(own c: Checker, k: u32, st: u8,
         line: u32, col: u32) -> Checker {
    let aoff = u32(c.atspans.len);
    c.atspans = c.atspans.push(line);
    c.atspans = c.atspans.push(col);
    return cons_set(c, k, st, aoff, 1);
}

fn init_set(own c: Checker, k: u32, cert: u8) -> Checker {
    c = es(c, "(init ");
    c = eqs(c, k);
    c = ec(c, u8(32));
    c = ecert(c, cert);
    c = ec(c, u8(41));
    c = rec(c);
    let i: u64 = 0;
    while i < c.init.len {
        if c.init.buf[i].k == k {
            c.init.buf[i].cert = cert;
            return c;
        }
        i = i + 1;
    }
    c.init = c.init.push(MapE2 { k: k, cert: cert });
    return c;
}

/// tag: has=1 + v=variant nid (Some), has=1 + v=NONE (known-enum `?`),
/// absent = no fact.
fn tag_set(own c: Checker, k: u32, v: u32) -> Checker {
    c = es(c, "(tag ");
    c = eqs(c, k);
    c = ec(c, u8(32));
    if v == NONE() { c = es(c, "?"); } else { c = eqs(c, v); }
    c = ec(c, u8(41));
    c = rec(c);
    let i: u64 = 0;
    while i < c.tag.len {
        if c.tag.buf[i].k == k {
            c.tag.buf[i].v = v;
            c.tag.buf[i].has = 1;
            return c;
        }
        i = i + 1;
    }
    c.tag = c.tag.push(TG { k: k, v: v, has: 1 });
    return c;
}

/// prov: pk 0=Unknown 1=Param 2+=Region(idx-0? region idx).
fn prov_set(own c: Checker, k: u32, pk: u8, pv: u32) -> Checker {
    c = es(c, "(prov ");
    c = eqs(c, k);
    c = ec(c, u8(32));
    c = eprov(c, pk, pv);
    c = ec(c, u8(41));
    c = rec(c);
    let i: u64 = 0;
    while i < c.provs.len {
        if c.provs.buf[i].k == k {
            c.provs.buf[i].pk = pk;
            c.provs.buf[i].pv = pv;
            return c;
        }
        i = i + 1;
    }
    c.provs = c.provs.push(PV { k: k, pk: pk, pv: pv });
    return c;
}

/// `(err @L:C "msg" (label @L:C "…")* (note "…")*)` — dmsg is a byte
/// slice (already built); labels/notes are staged in `dlab`/`dnote`
/// ranges pushed by the caller.
fn err_rec(own c: Checker, line: u32, col: u32,
           m: slice u8, l0: u32, l1: u32, n0: u32, n1: u32) -> Checker {
    c = es(c, "(err @");
    c = eu(c, u64(line));
    c = ec(c, u8(58));
    c = eu(c, u64(col));
    c = ec(c, u8(32));
    c = eqs_r(c, m);
    let i: u64 = u64(l0);
    while i < u64(l1) {
        let lb = c.dlab.buf[i];
        c = es(c, " (label @");
        c = eu(c, u64(lb.line));
        c = ec(c, u8(58));
        c = eu(c, u64(lb.col));
        c = ec(c, u8(32));
        let sp = loader.Span2 { off: lb.m0, len: u32(u64(lb.m1) - u64(lb.m0)) };
        c = eqs_r(c, &c.ebyt.buf[u64(sp.off)..u64(sp.off) + u64(sp.len)]);
        c = ec(c, u8(41));
        i = i + 1;
    }
    i = u64(n0);
    while i < u64(n1) {
        let np = c.dnote.buf[i];
        c = es(c, " (note ");
        c = eqs_r(c, &c.ebyt.buf[u64(np.off)..u64(np.off) + u64(np.len)]);
        c = ec(c, u8(41));
        i = i + 1;
    }
    c = ec(c, u8(41));
    c = rec(c);
    return c;
}

/// Stage a message into `ebyt` — returns span in res/res2.
fn msg(own c: Checker, m: slice u8) -> Checker {
    c.res = u32(c.ebyt.len);
    c.ebyt = resolve.bpush(c.ebyt, m);
    c.res2 = u32(c.ebyt.len);
    return c;
}

/// push_diag — plain message, no labels/notes.
fn pdiag(own c: Checker, line: u32, col: u32, m: slice u8) -> Checker {
    c = msg(c, m);
    let m0 = c.res;
    let m1 = c.res2;
    c = err_rec(c, line, col, &c.ebyt.buf[u64(m0)..u64(m1)],
        u32(c.dlab.len), u32(c.dlab.len),
        u32(c.dnote.len), u32(c.dnote.len));
    c.errs = c.errs.push(CDiag {
        line: line, col: col, m0: m0, m1: m1,
        l0: 0, l1: 0, n0: 0, n1: 0 });
    return c;
}

/// pdiag_s — literal-message variant.
fn pdiag_s(own c: Checker, line: u32, col: u32, m: str) -> Checker {
    let v = resolve.bputs(vec.Vec<u8>::new(c.heap), m);
    c = pdiag(c, line, col, v.as_slice());
    v.destroy();
    return c;
}

/// push_err — list-only diag: Stage-0's `ctx.errs.push` (lands in the
/// `! -` tail, no `(err)` event).
fn push_err(own c: Checker, line: u32, col: u32, m: slice u8) -> Checker {
    c = msg(c, m);
    let m0 = c.res;
    let m1 = c.res2;
    c.errs = c.errs.push(CDiag {
        line: line, col: col, m0: m0, m1: m1,
        l0: 0, l1: 0, n0: 0, n1: 0 });
    return c;
}

/// push_err_s — literal-message variant.
fn push_err_s(own c: Checker, line: u32, col: u32, m: str) -> Checker {
    let v = resolve.bputs(vec.Vec<u8>::new(c.heap), m);
    c = push_err(c, line, col, v.as_slice());
    v.destroy();
    return c;
}

fn kill_set(own c: Checker, k: u32, cert: u8) -> Checker {
    c = es(c, "(kill ");
    c = eqs(c, k);
    c = ec(c, u8(32));
    c = ecert(c, cert);
    c = ec(c, u8(41));
    c = rec(c);
    let i: u64 = 0;
    while i < c.ekills.len {
        if c.ekills.buf[i].k == k {
            c.ekills.buf[i].cert = cert;
            return c;
        }
        i = i + 1;
    }
    c.ekills = c.ekills.push(MapE2 { k: k, cert: cert });
    return c;
}

fn capkill_set(own c: Checker, k: u32, cert: u8) -> Checker {
    c = es(c, "(capkill ");
    c = eqs(c, k);
    c = ec(c, u8(32));
    c = ecert(c, cert);
    c = ec(c, u8(41));
    c = rec(c);
    let i: u64 = 0;
    while i < c.ckills.len {
        if c.ckills.buf[i].k == k {
            c.ckills.buf[i].cert = cert;
            return c;
        }
        i = i + 1;
    }
    c.ckills = c.ckills.push(MapE2 { k: k, cert: cert });
    return c;
}

fn transit_set(own c: Checker, k: u32) -> Checker {
    c = es(c, "(transit ");
    c = eqs(c, k);
    c = ec(c, u8(41));
    c = rec(c);
    c.transit = c.transit.push(k);
    return c;
}

fn dom_set(own c: Checker, d: u32, r: u32) -> Checker {
    c = es(c, "(dom ");
    c = eqs(c, d);
    c = ec(c, u8(32));
    c = eqs(c, r);
    c = ec(c, u8(41));
    c = rec(c);
    let i: u64 = 0;
    while i < c.doms.len {
        if c.doms.buf[i].k == d {
            c.doms.buf[i].v = r;
            return c;
        }
        i = i + 1;
    }
    c.doms = c.doms.push(KK { k: d, v: r });
    return c;
}

fn slen_set(own c: Checker, k: u32, n: i64) -> Checker {
    c = es(c, "(slen ");
    c = eqs(c, k);
    c = ec(c, u8(32));
    if n < 0 {
        c = ec(c, u8(45));
        c = eu(c, u64(0 - n));
    } else { c = eu(c, u64(n)); }
    c = ec(c, u8(41));
    c = rec(c);
    let i: u64 = 0;
    while i < c.slens.len {
        if c.slens.buf[i].k == k {
            c.slens.buf[i].n = n;
            return c;
        }
        i = i + 1;
    }
    c.slens = c.slens.push(KI { k: k, n: n });
    return c;
}

