/// (re "k" mut|im) by k.
fn sum_re(own c: Checker, off: u32, len: u32) -> Checker {
    let ix = vec.Vec<u32>::new(c.heap);
    let i: u64 = 0;
    while i < u64(len) { ix = ix.push(off + u32(i)); i = i + 1; }
    i = 1;
    while i < ix.len {
        let x = ix.buf[i];
        let j = i;
        while j > 0 && kless(c, c.sm_re.buf[u64(x)].k,
            c.sm_re.buf[u64(ix.buf[j - 1])].k) == 1 {
            ix.buf[j] = ix.buf[j - 1];
            j = j - 1;
        }
        ix.buf[j] = x;
        i = i + 1;
    }
    i = 0;
    while i < ix.len {
        let e = c.sm_re.buf[u64(ix.buf[i])];
        c = es(c, " (re ");
        c = eqs(c, e.k);
        if e.m == 1 { c = es(c, " mut"); } else { c = es(c, " im"); }
        c = ec(c, u8(41));
        i = i + 1;
    }
    ix.destroy();
    return c;
}

/// (rc "k") by k.
fn sum_rc(own c: Checker, off: u32, len: u32) -> Checker {
    let ix = vec.Vec<u32>::new(c.heap);
    let i: u64 = 0;
    while i < u64(len) { ix = ix.push(off + u32(i)); i = i + 1; }
    i = 1;
    while i < ix.len {
        let x = ix.buf[i];
        let j = i;
        while j > 0 && kless(c, c.sm_rc.buf[u64(x)],
            c.sm_rc.buf[u64(ix.buf[j - 1])]) == 1 {
            ix.buf[j] = ix.buf[j - 1];
            j = j - 1;
        }
        ix.buf[j] = x;
        i = i + 1;
    }
    i = 0;
    while i < ix.len {
        c = es(c, " (rc ");
        c = eqs(c, c.sm_rc.buf[u64(ix.buf[i])]);
        c = ec(c, u8(41));
        i = i + 1;
    }
    ix.destroy();
    return c;
}

fn arg_in(read c: Checker, read v: vec.Vec<u32>, k: u32) -> u8 {
    let i: u64 = 0;
    while i < v.len {
        if kprefix(c, v.buf[i], k) == 1 { return 1; }
        i = i + 1;
    }
    return 0;
}

/// calls_in — parser Call name nids reachable from a stmt range.
fn calls_in(read c: Checker, read p: ast.Parser,
            b: u32, e_: u32, own out: vec.Vec<u32>) -> vec.Vec<u32> {
    let i: u64 = u64(b);
    while i < u64(e_) {
        out = calls_stmt(c, p, p.u32s.buf[i], out);
        i = i + 1;
    }
    return out;
}

fn calls_stmt(read c: Checker, read p: ast.Parser,
              sid: u32, own out: vec.Vec<u32>) -> vec.Vec<u32> {
    let s = p.stmts.buf[u64(sid)];
    let k = sk_num(s.kind);
    if k == 0 {                                 // Let
        if s.c != NONE() { out = calls_expr(c, p, s.c, out); }
        return out;
    }
    if k == 1 {                                 // Assign
        out = calls_expr(c, p, s.a, out);
        out = calls_expr(c, p, s.b, out);
        return out;
    }
    if k == 2 {                                 // Return
        if s.a != NONE() { out = calls_expr(c, p, s.a, out); }
        return out;
    }
    if k == 3 {                                 // If
        out = calls_expr(c, p, s.a, out);
        let nt = p.u32s.buf[u64(s.b)];
        let i: u64 = u64(s.b) + 1;
        while i < u64(s.b) + 1 + u64(nt) {
            out = calls_stmt(c, p, p.u32s.buf[i], out);
            i = i + 1;
        }
        let he = p.u32s.buf[u64(s.b) + 1 + u64(nt)];
        if he == 1 {
            i = u64(s.b) + 2 + u64(nt);
            while i < u64(s.b) + u64(s.c) {
                out = calls_stmt(c, p, p.u32s.buf[i], out);
                i = i + 1;
            }
        }
        return out;
    }
    if k == 4 || k == 9 {                       // While | Region
        if k == 4 { out = calls_expr(c, p, s.a, out); }
        let i: u64 = u64(s.b);
        while i < u64(s.b) + u64(s.c) {
            out = calls_stmt(c, p, p.u32s.buf[i], out);
            i = i + 1;
        }
        return out;
    }
    if k == 7 || k == 10 || k == 11 || k == 12 {
        out = calls_expr(c, p, s.a, out);
        return out;
    }
    if k == 8 {                                 // Match
        out = calls_expr(c, p, s.a, out);
        let i: u64 = u64(s.b);
        while i < u64(s.b) + u64(s.c) {
            let arm = p.arms.buf[i];
            let j: u64 = u64(arm.off);
            while j < u64(arm.off) + u64(arm.len) {
                out = calls_stmt(c, p, p.u32s.buf[j], out);
                j = j + 1;
            }
            i = i + 1;
        }
        return out;
    }
    return out;
}


// ---- $rv rvalue-place lowering (N24A port) ----------------------------------
// Stage-0 runs lower.rs over the AST before checking: any place-position
// operand or call arg whose value isn't place-shaped materializes into
// `let $rvN = <e>` — the temp dies when the statement it belongs to
// finishes. We can't rewrite the parser's arenas, so we emulate: a
// source-order naming pass (rv_scan) assigns each lowerable eid its seq;
// lower_stmt, run at the head of check_block's loop, emits the same
// `let` event trail check_let produces and records eid -> temp-name in
// rv_map; the place/expr walkers then treat a mapped eid as `Var $rvN`.

pub fn rv_find(read c: Checker, eid: u32) -> u32 {
    let i: u64 = 0;
    while i < c.rv_map.len {
        if c.rv_map.buf[i].k == eid { return c.rv_map.buf[i].v; }
        i = i + 1;
    }
    return NONE();
}

fn rv_names_find(read c: Checker, eid: u32) -> u32 {
    let i: u64 = 0;
    while i < c.rv_names.len {
        if c.rv_names.buf[i].k == eid { return c.rv_names.buf[i].v; }
        i = i + 1;
    }
    return NONE();
}

/// syntactic place forms — place_id's domain.
fn rv_is_place(read p: ast.Parser, eid: u32) -> u8 {
    let k = ek_num(p.exps.buf[u64(eid)].kind);
    if k == 2 || k == 7 || k == 8 || k == 9 || k == 16 { return 1; }
    return 0;
}

/// pure constant — literal leaves under Unary/Bin.
fn rv_is_const(read p: ast.Parser, eid: u32) -> u8 {
    let e = p.exps.buf[u64(eid)];
    let k = ek_num(e.kind);
    if k == 0 || k == 1 || k == 3 || k == 18 { return 1; }
    if k == 4 { return rv_is_const(p, e.b); }
    if k == 5 {
        if rv_is_const(p, e.b) == 1 && rv_is_const(p, e.c) == 1 {
            return 1;
        }
    }
    return 0;
}

/// non-place arg with no dedicated arg-position rule → temp.
fn rv_arg_needs(read p: ast.Parser, eid: u32) -> u8 {
    if rv_is_place(p, eid) == 1 { return 0; }
    if rv_is_const(p, eid) == 1 { return 0; }
    let k = ek_num(p.exps.buf[u64(eid)].kind);
    if k == 11 || k == 12 || k == 15 || k == 13 { return 0; }
    return 1;
}

/// param i's auth for callee `vn` (0 when unfound — extern/generic).
fn rv_pauth(read c: Checker, vn: u32, i: u64) -> u8 {
    let j: u64 = 0;
    while j < c.r.fdecls.len {
        let fd = c.r.fdecls.buf[j];
        if fd.name == vn && fd.tps_len == 0
            && vhas(c.vprogs, fd.prog) == 1 {
            if i < u64(fd.ps_len) {
                return c.r.params.buf[u64(fd.ps_off) + i].auth;
            }
            return 0;
        }
        j = j + 1;
    }
    return 0;
}

/// materialize `let $rv{seq} = e` — emit mode runs the let through
/// check_let_n; scan mode just assigns the seq number.
fn rv_mat(own c: Checker, read p: ast.Parser,
          eid: u32, ret: u32, emit: u8) -> Checker {
    if rv_is_place(p, eid) == 1 { return c; }
    let e = xexp(c, p, eid);
    if emit == 0 {
        c.rv_names = c.rv_names.push(KK {
            k: eid, v: u32(c.rv_names.len) });
        return c;
    }
    let seq = rv_names_find(c, eid);
    if seq == NONE() { return c; }
    let nm = vec.Vec<u8>::new(c.heap);
    let nm2 = resolve.bputs(nm, "$rv");
    let nm3 = loader.bpush_u64(nm2, u64(seq));
    c.r = resolve.intern(c.r, nm3.as_slice());
    let vn = c.r.res;
    nm3.destroy();
    let s = ast.Stmt {
        kind: ast.SK::Let, line: e.line, col: e.col,
        a: NONE(), b: NONE(), c: eid, d: e.line, e: e.col };
    c = check_let_n(c, p, vn, s, ret);
    c.rv_map = c.rv_map.push(KK { k: eid, v: vn });
    c.rv_new = c.rv_new.push(vn);
    return c;
}

/// lower.rs `expr()` — interior place-position bases + call args.
/// emit=0: scan (assign names); emit=1: emit the let trail.
fn lower_e(own c: Checker, read p: ast.Parser,
           eid: u32, ret: u32, emit: u8) -> Checker {
    let e = xexp(c, p, eid);
    let k = ek_num(e.kind);
    if k == 0 || k == 1 || k == 2 || k == 3 || k == 18 { return c; }
    if k == 4 { return lower_e(c, p, e.b, ret, emit); }
    if k == 5 {
        c = lower_e(c, p, e.b, ret, emit);
        return lower_e(c, p, e.c, ret, emit);
    }
    if k == 6 {                             // Call — args
        let noff = u64(e.b);
        let nnid = e.a;
        let nt = u64(p.u32s.buf[noff]);
        let na = p.u32s.buf[noff + 1 + nt];
        c.r = resolve.intern_pname(c.r, p, nnid);
        let vn = c.r.res;
        let cr6 = cres_find(c, e.line, e.col);
        if cr6 != NONE() { vn = cr6; }
        // `v.m(..)` — the bound receiver is arg0 of the desugared
        // call: it's a Var (never hoisted) and shifts the parsed
        // args' param indices by one.
        let shift: u64 = 0;
        if mrecv_at(c, e) != NONE() { shift = 1; }
        let i: u64 = 0;
        while i < u64(na) {
            let a = p.u32s.buf[noff + 2 + nt + i];
            c = lower_e(c, p, a, ret, emit);
            if rv_pauth(c, vn, i + shift) != 2
                && rv_arg_needs(p, a) == 1 {
                c = rv_mat(c, p, a, ret, emit);
            }
            i = i + 1;
        }
        return c;
    }
    if k == 20 {                            // AssocFn — e.c..e.c+e.d args
        // `T::v(payload)` where `v` is an enum variant lowers like
        // Stage-0's `Expr::EnumLit` — `self.expr(payload)`, args stay
        // inline (post-mono the variant form isn't a Call). A real
        // associated fn keeps `call_args` hoisting.
        let isvar: u8 = 0;
        c.r = resolve.cnv_ty(c.r, p, e.a);
        let aty = c.r.res;
        let atn = c.r.rtys.buf[u64(aty)];
        let bnm: u32 = NONE();
        if atn.kind == 13 { bnm = atn.name; }
        if atn.kind == 12 { bnm = atn.name; }
        if bnm != NONE() {
            let ei = edecl_of(c, bnm);
            if ei != NONE() {
                c.r = resolve.intern_pname(c.r, p, e.b);
                let vn2 = c.r.res;
                let ed2 = c.r.edecls.buf[u64(ei)];
                let vi: u64 = 0;
                while vi < u64(ed2.vs_len) {
                    if c.r.vars.buf[u64(ed2.vs_off) + vi].name
                        == vn2 { isvar = 1; }
                    vi = vi + 1;
                }
            }
        }
        let cvn = cres_find(c, e.line, e.col);
        let i: u64 = u64(e.c);
        while i < u64(e.c) + u64(e.d) {
            let a = p.u32s.buf[i];
            c = lower_e(c, p, a, ret, emit);
            let pa: u8 = 0;
            if cvn != NONE() {
                pa = rv_pauth(c, cvn, i - u64(e.c));
            }
            if isvar == 0 && pa != 2
                && rv_arg_needs(p, a) == 1 {
                c = rv_mat(c, p, a, ret, emit);
            }
            i = i + 1;
        }
        return c;
    }
    if k == 19 {                            // MethodCall — recv + args
        // desugars to `Call(canon, [recv, args..])` — the cres row's
        // resolved callee carries the param auths (recv is arg0).
        let cvn = cres_find(c, e.line, e.col);
        c = lower_e(c, p, e.a, ret, emit);
        if cvn == NONE() || rv_pauth(c, cvn, 0) != 2 {
            c = rv_mat(c, p, e.a, ret, emit);
        }
        let noff = u64(e.c);
        let nt = u64(p.u32s.buf[noff]);
        let na = p.u32s.buf[noff + 1 + nt];
        let i: u64 = 0;
        while i < u64(na) {
            let a = p.u32s.buf[noff + 2 + nt + i];
            c = lower_e(c, p, a, ret, emit);
            let pa: u8 = 0;
            if cvn != NONE() { pa = rv_pauth(c, cvn, i + 1); }
            if pa != 2 && rv_arg_needs(p, a) == 1 {
                c = rv_mat(c, p, a, ret, emit);
            }
            i = i + 1;
        }
        return c;
    }
    if k == 7 {                             // Field — place_operand
        c = lower_e(c, p, e.a, ret, emit);
        return rv_mat(c, p, e.a, ret, emit);
    }
    if k == 8 {                             // Index — base + index
        c = lower_e(c, p, e.a, ret, emit);
        c = rv_mat(c, p, e.a, ret, emit);
        return lower_e(c, p, e.b, ret, emit);
    }
    if k == 9 {                             // IndexRange
        c = lower_e(c, p, e.a, ret, emit);
        c = rv_mat(c, p, e.a, ret, emit);
        if e.b != NONE() { c = lower_e(c, p, e.b, ret, emit); }
        if e.c != NONE() { c = lower_e(c, p, e.c, ret, emit); }
        return c;
    }
    if k == 10 {                            // StructLit — field exprs
        let nt = u64(p.u32s.buf[u64(e.b)]);
        let nf = p.u32s.buf[u64(e.b) + 1 + nt];
        let i: u64 = 0;
        while i < u64(nf) {
            c = lower_e(c, p,
                p.u32s.buf[u64(e.b) + 2 + nt + i * 2 + 1], ret, emit);
            i = i + 1;
        }
        return c;
    }
    if k == 11 {                            // AddrOf — place_operand
        c = lower_e(c, p, e.b, ret, emit);
        return rv_mat(c, p, e.b, ret, emit);
    }
    if k == 12 || k == 16 || k == 21 {      // Handle|Deref|Try
        c = lower_e(c, p, e.a, ret, emit);
        return rv_mat(c, p, e.a, ret, emit);
    }
    if k == 13 {                            // Spawn — stmt list
        // emit=1 lowers only the enclosing stmt — the body re-lowers
        // inside the forked check_block (child ctx, not parent's).
        if emit == 0 {
            let i: u64 = u64(e.b);
            while i < u64(e.b) + u64(e.c) {
                c = lower_s(c, p, p.u32s.buf[i], ret, emit);
                i = i + 1;
            }
        }
        return c;
    }
    if k == 14 || k == 15 {                 // Join | Mutex — interior
        return lower_e(c, p, e.a, ret, emit);
    }
    if k == 17 {                            // Alloc — b=expr, c=count
        c = lower_e(c, p, e.b, ret, emit);
        if e.c != NONE() { c = lower_e(c, p, e.c, ret, emit); }
        return c;
    }
    if k == 22 {                            // Match — scrut + arms
        c = lower_e(c, p, e.a, ret, emit);
        c = rv_mat(c, p, e.a, ret, emit);
        let i: u64 = u64(e.b);
        while i < u64(e.b) + u64(e.c) {
            let arm = p.arms.buf[i];
            let j: u64 = u64(arm.off);
            while j < u64(arm.off) + u64(arm.len) {
                c = lower_s(c, p, p.u32s.buf[j], ret, emit);
                j = j + 1;
            }
            i = i + 1;
        }
        return c;
    }
    return c;
}

/// lower.rs `stmt()` — emit=0 walks EVERYTHING (nested blocks too —
/// the names pass runs once over the whole fn); emit=1 lowers only
/// this statement's own exprs, nested blocks re-lower at their own
/// check_block iteration.
fn lower_s(own c: Checker, read p: ast.Parser,
           sid: u32, ret: u32, emit: u8) -> Checker {
    let s = p.stmts.buf[u64(sid)];
    let k = sk_num(s.kind);
    if k == 0 { if s.c != NONE() { c = lower_e(c, p, s.c, ret, emit); }
        return c; }
    if k == 1 { c = lower_e(c, p, s.a, ret, emit);
        c = lower_e(c, p, s.b, ret, emit); return c; }
    if k == 2 { if s.a != NONE() { c = lower_e(c, p, s.a, ret, emit); }
        return c; }
    if k == 3 {                             // If — cond; bodies via block
        c = lower_e(c, p, s.a, ret, emit);
        if emit == 0 {
            // u32s range: [nt, then.., haselse, else..]
            let nt = u64(p.u32s.buf[u64(s.b)]);
            let i: u64 = u64(s.b) + 1;
            while i < u64(s.b) + 1 + nt {
                c = lower_s(c, p, p.u32s.buf[i], ret, emit);
                i = i + 1;
            }
            let he = p.u32s.buf[u64(s.b) + 1 + nt];
            if he == 1 {
                i = u64(s.b) + 2 + nt;
                while i < u64(s.b) + u64(s.c) {
                    c = lower_s(c, p, p.u32s.buf[i], ret, emit);
                    i = i + 1;
                }
            }
        }
        return c;
    }
    if k == 4 || k == 9 {                   // While | Region
        if k == 4 {
            if emit == 1 { c.wh_lo = u32(c.rv_map.len); }
            c = lower_e(c, p, s.a, ret, emit);
            if emit == 1 { c.wh_hi = u32(c.rv_map.len); }
        }
        if emit == 0 {
            let i: u64 = u64(s.b);
            while i < u64(s.b) + u64(s.c) {
                c = lower_s(c, p, p.u32s.buf[i], ret, emit);
                i = i + 1;
            }
        }
        return c;
    }
    if k == 7 { return lower_e(c, p, s.a, ret, emit); }
    if k == 8 {                             // Match — scrut + arms
        c = lower_e(c, p, s.a, ret, emit);
        c = rv_mat(c, p, s.a, ret, emit);
        if emit == 0 {
            let i: u64 = u64(s.b);
            while i < u64(s.b) + u64(s.c) {
                let arm = p.arms.buf[i];
                let j: u64 = u64(arm.off);
                while j < u64(arm.off) + u64(arm.len) {
                    c = lower_s(c, p, p.u32s.buf[j], ret, emit);
                    j = j + 1;
                }
                i = i + 1;
            }
        }
        return c;
    }
    if k == 10 || k == 11 || k == 12 {      // Promote|Consume|Defer
        return lower_e(c, p, s.a, ret, emit);
    }
    return c;
}

/// rv_scan — lower.rs's program walk: every fn body in source order
/// (names are numbered by a single per-module counter).
fn rv_scan(own c: Checker, read p: ast.Parser,
           fb: u32) -> Checker {
    while c.rv_names.len > 0 { c.rv_names.pop(); }
    let i: u64 = 0;
    while i < p.fns.len {
        let f = p.fns.buf[i];
        c.cur_fn = c.r.fdecls.buf[u64(fb) + i].name;
        let j: u64 = u64(f.body_off);
        while j < u64(f.body_off) + u64(f.body_len) {
            c = lower_s(c, p, p.u32s.buf[j], f.ret, 0);
            j = j + 1;
        }
        i = i + 1;
    }
    return c;
}

fn calls_expr(read c: Checker, read p: ast.Parser,
              eid: u32, own out: vec.Vec<u32>) -> vec.Vec<u32> {
    let e = xexp(c, p, eid);
    let k = ek_num(e.kind);
    if k == 6 {                                 // Call
        // resolver-name nids — the DFS set mixes parser fns with
        // clone canonical names, so `e.a` (parser space) can't key
        // it. Every resolvable call carries a `cres` row.
        let vn = cres_find(c, e.line, e.col);
        if vn != NONE() && vhas(out, vn) == 0 { out = out.push(vn); }
        let nt = u64(p.u32s.buf[u64(e.b)]);
        let na = p.u32s.buf[u64(e.b) + 1 + nt];
        let i: u64 = 0;
        while i < u64(na) {
            out = calls_expr(c, p,
                p.u32s.buf[u64(e.b) + 2 + nt + i], out);
            i = i + 1;
        }
        return out;
    }
    if k == 19 {                                // MethodCall — a Call
        // in Stage-0's post-mono tree: same [nt,targs..,na,args..]
        // list plus the receiver prepended as arg0.
        let vn = cres_find(c, e.line, e.col);
        if vn != NONE() && vhas(out, vn) == 0 { out = out.push(vn); }
        out = calls_expr(c, p, e.a, out);
        let nt = u64(p.u32s.buf[u64(e.c)]);
        let na = p.u32s.buf[u64(e.c) + 1 + nt];
        let i: u64 = 0;
        while i < u64(na) {
            out = calls_expr(c, p,
                p.u32s.buf[u64(e.c) + 2 + nt + i], out);
            i = i + 1;
        }
        return out;
    }
    if k == 20 {                                // AssocFn — a Call, or
        // an enum-variant literal when no cres row exists (still
        // walks the payload args like Stage-0's EnumLit arm).
        let vn = cres_find(c, e.line, e.col);
        if vn != NONE() && vhas(out, vn) == 0 { out = out.push(vn); }
        let i: u64 = 0;
        while i < u64(e.d) {
            out = calls_expr(c, p, p.u32s.buf[u64(e.c) + i], out);
            i = i + 1;
        }
        return out;
    }
    if k == 4 {                                 // Unary — b=operand
        return calls_expr(c, p, e.b, out);
    }
    if k == 16 || k == 12 || k == 14 || k == 15 {
        // Deref | Handle | Join | Mutex — a=operand
        return calls_expr(c, p, e.a, out);
    }
    if k == 13 {                                // Spawn — b..c stmt list
        let i: u64 = u64(e.b);
        while i < u64(e.c) {
            out = calls_stmt(c, p, p.u32s.buf[i], out);
            i = i + 1;
        }
        return out;
    }
    if k == 5 {                                 // Bin
        out = calls_expr(c, p, e.b, out);
        out = calls_expr(c, p, e.c, out);
        return out;
    }
    if k == 7 {                                 // Field
        return calls_expr(c, p, e.a, out);
    }
    if k == 8 {                                 // Index
        out = calls_expr(c, p, e.a, out);
        out = calls_expr(c, p, e.b, out);
        return out;
    }
    if k == 9 {                                 // IndexRange
        out = calls_expr(c, p, e.a, out);
        if e.b != NONE() { out = calls_expr(c, p, e.b, out); }
        if e.c != NONE() { out = calls_expr(c, p, e.c, out); }
        return out;
    }
    if k == 11 {                                // AddrOf — b=place
        return calls_expr(c, p, e.b, out);
    }
    if k == 17 {                                // Alloc: b=expr, c=count|NONE
        out = calls_expr(c, p, e.b, out);
        if e.c != NONE() { out = calls_expr(c, p, e.c, out); }
        return out;
    }
    if k == 10 {                                // StructLit: fields in u32s
        let nt = u64(p.u32s.buf[u64(e.b)]);
        let nf = p.u32s.buf[u64(e.b) + 1 + nt];
        let i: u64 = 0;
        while i < u64(nf) {
            out = calls_expr(c, p,
                p.u32s.buf[u64(e.b) + 2 + nt + i * 2 + 1], out);
            i = i + 1;
        }
        return out;
    }
    if k == 21 {                                // Try
        return calls_expr(c, p, e.a, out);
    }
    if k == 22 {                                // Match expr — arms b..c
        out = calls_expr(c, p, e.a, out);
        let i: u64 = u64(e.b);
        while i < u64(e.b) + u64(e.c) {
            let arm = p.arms.buf[i];
            let j: u64 = u64(arm.off);
            while j < u64(arm.off) + u64(arm.len) {
                out = calls_stmt(c, p, p.u32s.buf[j], out);
                j = j + 1;
            }
            i = i + 1;
        }
        return out;
    }
    return out;
}

// ---- module driver -----------------------------------------------------------

/// DFS return bundle — the three walk vecs.
pub struct DFSO {
    st: vec.Vec<KK>, cyc: vec.Vec<u32>, ord: vec.Vec<u32>,
}

/// DFS state for one fn — name nid + marks.
fn dfs_order(read c: Checker, read p: ast.Parser,
             n: u32, prog: u32,
             read calls: vec.Vec<u32>, read callk: vec.Vec<u32>,
             read names: vec.Vec<u32>,
             own state: vec.Vec<KK>,
             own cyclic: vec.Vec<u32>,
             own order: vec.Vec<u32>) -> DFSO {
    state = st_put(state, n, 1);
    // find n's call range
    let i: u64 = 0;
    while i < calls.len {
        if calls.buf[i] == n {
            let off = callk.buf[i * 2];
            let len = callk.buf[i * 2 + 1];
            let j: u64 = 0;
            while j < u64(len) {
                let callee = c.cbuf.buf[u64(off) + j];
                if vhas(names, callee) == 1 {
                    let st = st_get(state, callee);
                    if st == 0 {
                        let d = dfs_order(c, p, callee, prog,
                            calls, callk, names,
                            state, cyclic, order);
                        state = d.st; cyclic = d.cyc; order = d.ord;
                    } else { if st == 1 {
                        if vhas(cyclic, n) == 0 { cyclic = cyclic.push(n); }
                        if vhas(cyclic, callee) == 0 {
                            cyclic = cyclic.push(callee);
                        }
                    } }
                }
                j = j + 1;
            }
        }
        i = i + 1;
    }
    state = st_put(state, n, 2);
    order = order.push(n);
    return DFSO { st: state, cyc: cyclic, ord: order };
}

fn st_get(read v: vec.Vec<KK>, n: u32) -> u8 {
    let i: u64 = 0;
    while i < v.len {
        if v.buf[i].k == n { return u8(v.buf[i].v); }
        i = i + 1;
    }
    return 0;
}
fn st_put(own v: vec.Vec<KK>, n: u32, s: u32) -> vec.Vec<KK> {
    let i: u64 = 0;
    while i < v.len {
        if v.buf[i].k == n {
            v.buf[i] = KK { k: n, v: s };
            return v;
        }
        i = i + 1;
    }
    return v.push(KK { k: n, v: s });
}

/// check one module's fns — `prog` = parser index (l.progs idx or
/// l.progs.len for root), `p` its parser, `fb` = fbases[prog].
/// continue the module's $rvN sequence over one clone's body —
/// `rv_scan` cleared `rv_names`; clone bodies append to it.
fn rv_scan_body(own c: Checker, read p: ast.Parser,
                bo: u32, bl: u32, ret: u32) -> Checker {
    let j: u64 = u64(bo);
    while j < u64(bo) + u64(bl) {
        c = lower_s(c, p, p.u32s.buf[j], ret, 0);
        j = j + 1;
    }
    return c;
}

/// pre-pass: check every fn clone this module requested. Mono lands
/// a clone in the REQUESTER's program — its `(fn …)` block belongs
/// in this segment, its template body lives in `l.progs[tp]` (or `p`
/// when the requester is the template owner — the root module's own
/// generics, or a module instantiating its own). `r.cmap` carries
/// the T->arg subst while `cnv_ty` reads the template's types.
/// install this module's clone fdecls — canon name, requester
/// prog (the callee scan's `vprogs` accepts own progs), template
/// idx for the body. Runs BEFORE `rv_scan` so the lowering's
/// per-arg auth lookup sees clone signatures; `c.inst_fds[i]`
/// records the fdecl index for `check_insts`.
fn inst_fdecls(own c: Checker, prog: u32) -> Checker {
    while c.inst_fds.len > 0 { c.inst_fds.pop(); }
    let i: u64 = 0;
    while i < c.r.insts.len {
        let ins = c.r.insts.buf[i];
        i = i + 1;
        if ins.req != prog { continue; }
        c.r.fdecls = c.r.fdecls.push(resolve.FDecl {
            name: ins.name, pub_: ins.pub_, ext: ins.ext,
            line: ins.line, col: ins.col,
            tps_off: 0, tps_len: 0,
            ps_off: ins.ps_off, ps_len: ins.ps_len,
            ret: ins.ret, prog: prog, idx: ins.tidx });
        while c.inst_fds.len < i - 1 {
            c.inst_fds = c.inst_fds.push(NONE());
        }
        c.inst_fds = c.inst_fds.push(u32(c.r.fdecls.len) - 1);
    }
    return c;
}

/// clone env on — subst map + the TEMPLATE module's qualify
/// context (`Vec { .. }` inside vec.new<T> is `vec.Vec`), with a
/// fresh rv_names for the clone's eids. Returns nothing — the
/// caller tracks `saved`/`oldmap` for `inst_env_off`.
fn inst_env_on(own c: Checker, read p: ast.Parser,
               read l: loader.Loader, prog: u32,
               ins: resolve.Inst) -> Checker {
    let oldmap = c.r.cmap;
    c.saved_map = c.saved_map.push(oldmap);
    c.r.cmap = vec.Vec<resolve.MapE>::new(c.heap);
    let j: u64 = 0;
    while j < u64(ins.cm_len) {
        c.r.cmap = c.r.cmap.push(c.r.cmaps.buf[u64(ins.cm_off) + j]);
        j = j + 1;
    }
    let saved = c.rv_names;
    c.saved_rvn = c.saved_rvn.push(saved);
    c.rv_names = vec.Vec<KK>::new(c.heap);
    c.cur_fn = ins.name;
    if ins.tp == prog {
        c.r = resolve.set_qual(c.r, l, p, prog);
    } else {
        c.r = resolve.set_qual(c.r, l,
            l.progs.buf[u64(ins.tp)], ins.tp);
    }
    return c;
}

/// clone env off — restores what inst_env_on stacked, then the
/// checking module's qualify context.
fn inst_env_off(own c: Checker, read p: ast.Parser,
                read l: loader.Loader, prog: u32) -> Checker {
    let dn = c.rv_names; dn.destroy();
    c.rv_names = c.saved_rvn.buf[c.saved_rvn.len - 1];
    c.saved_rvn.pop();
    let d = c.r.cmap; d.destroy();
    c.r.cmap = c.saved_map.buf[c.saved_map.len - 1];
    c.saved_map.pop();
    c.r = resolve.set_qual(c.r, l, p, prog);
    return c;
}

/// scan a clone's template body under its env — emits nothing;
/// `c.res` = how many $rv temps the body claims. Used to assign
/// each clone its $rv base in mono's append order.
fn inst_rvlen(own c: Checker, read p: ast.Parser,
              read l: loader.Loader, prog: u32,
              iidx: u32) -> Checker {
    let ins = c.r.insts.buf[u64(iidx)];
    c = inst_env_on(c, p, l, prog, ins);
    if ins.tp == prog {
        let tf = p.fns.buf[u64(ins.tidx)];
        c = rv_scan_body(c, p, tf.body_off, tf.body_len, ins.ret);
    } else {
        let tf = l.progs.buf[u64(ins.tp)].fns.buf[u64(ins.tidx)];
        c = rv_scan_body(c, l.progs.buf[u64(ins.tp)],
            tf.body_off, tf.body_len, ins.ret);
    }
    c.res = u32(c.rv_names.len);
    c = inst_env_off(c, p, l, prog);
    return c;
}

/// check one clone — Stage-0's monomorphized FnDef path: the
/// template body under the inst's subst map, its temps renumbered
/// onto `rvbase`.
fn check_inst(own c: Checker, read p: ast.Parser,
              read l: loader.Loader, prog: u32,
              iidx: u32, rvbase: u32) -> Checker {
    let ins = c.r.insts.buf[u64(iidx)];
    c = inst_env_on(c, p, l, prog, ins);
    if ins.tp == prog {
        let tf = p.fns.buf[u64(ins.tidx)];
        c = rv_scan_body(c, p, tf.body_off, tf.body_len, ins.ret);
    } else {
        let tf = l.progs.buf[u64(ins.tp)].fns.buf[u64(ins.tidx)];
        c = rv_scan_body(c, l.progs.buf[u64(ins.tp)],
            tf.body_off, tf.body_len, ins.ret);
    }
    let j2: u64 = 0;
    while j2 < c.rv_names.len {
        let e2 = c.rv_names.buf[j2];
        c.rv_names.buf[j2] = KK { k: e2.k, v: e2.v + rvbase };
        j2 = j2 + 1;
    }
    let fdi = c.inst_fds.buf[u64(iidx)];
    if ins.tp == prog {
        c = check_fn(c, p, fdi);
    } else {
        c = check_fn(c, l.progs.buf[u64(ins.tp)], fdi);
    }
    c = inst_env_off(c, p, l, prog);
    return c;
}

pub fn module(own c: Checker, read p: ast.Parser,
              read l: loader.Loader,
              prog: u32, fb: u32) -> Checker {
    c.who = prog; c.fbase = fb;
    // re-establish the module qualifier — resolve's materialize
    // leaves `qual`/`own_ty` on the last clone's owner, and the
    // checker's own `cnv_ty`/`qualify_ty` calls need THIS module's.
    c.r = resolve.set_qual(c.r, l, p, prog);
    // visible progs — self plus every direct dep (clone bodies
    // import like requester fns). Dep name nids → postorder index.
    while c.vprogs.len > 0 { c.vprogs.pop(); }
    c.vprogs = c.vprogs.push(prog);
    let d0: u32 = 0; let dn: u32 = 0;
    if prog == u32(l.progs.len) {
        d0 = l.res2; dn = l.res3;
    } else {
        let mp = l.mods.buf[u64(prog)];
        d0 = mp.deps_off; dn = mp.deps_len;
    }
    let di: u64 = 0;
    while di < u64(dn) {
        let dnid = l.darena.buf[u64(d0) + di];
        let mi2: u64 = 0;
        while mi2 < l.mods.len {
            if l.mods.buf[mi2].name == dnid {
                c.vprogs = c.vprogs.push(u32(mi2));
            }
            mi2 = mi2 + 1;
        }
        di = di + 1;
    }
    // Decl diags resolution collected for this module — stage-0's
    // check_module errs hold them in the same list, so each becomes
    // an (err …) event plus a `!` tail entry, before any (fn …).
    let pe: u64 = 0;
    while pe < c.r.perrs.len {
        let ed = c.r.perrs.buf[pe];
        let m = vec.Vec<u8>::new(c.heap);
        let mj: u64 = u64(ed.m0);
        while mj < u64(ed.m1) {
            m = m.push(c.r.ebyt.buf[mj]);
            mj = mj + 1;
        }
        c = pdiag(c, ed.line, ed.col, m.as_slice());
        m.destroy();
        pe = pe + 1;
    }
    if c.r.perrs.len != 0 {
        let pd = c.r.perrs; pd.destroy();
        c.r.perrs = vec.Vec<resolve.RD>::new(c.heap);
    }
    // clone fdecls first — the lowering's param-auth lookup and the
    // callee scan both need them resolvable already.
    c = inst_fdecls(c, prog);
    // N24A — $rvN naming pass over all bodies (source order).
    c = rv_scan(c, p, fb);
    // per-clone $rv base — Stage-0's lower numbers each clone's
    // temps in p.fns append order, so bases follow `insts` order
    // regardless of the DFS check order below.
    let rbv = vec.Vec<u32>::new(c.heap);
    let rbase = u32(c.rv_names.len);
    let i: u64 = 0;
    while i < c.r.insts.len {
        let ins = c.r.insts.buf[i];
        if ins.req == prog && ins.ext == 0 {
            rbv = rbv.push(rbase);
            c = inst_rvlen(c, p, l, prog, u32(i));
            rbase = rbase + c.res;
        } else {
            rbv = rbv.push(NONE());
        }
        i = i + 1;
    }
    // unified fn set — Stage-0's mono appends this module's clones
    // to p.fns, so parser fns then insts is its seed order. nkind
    // 0 = parser fn (nidx = p.fns idx), 1 = clone (nidx = insts idx).
    let names = vec.Vec<u32>::new(c.heap);
    let nkind = vec.Vec<u32>::new(c.heap);
    let nidx = vec.Vec<u32>::new(c.heap);
    i = 0;
    while i < p.fns.len {
        let f = p.fns.buf[i];
        if f.tps_len == 0 {
            let fd = c.r.fdecls.buf[u64(fb) + i];
            if vhas(names, fd.name) == 0 {
                names = names.push(fd.name);
                nkind = nkind.push(u32(0));
                nidx = nidx.push(u32(i));
            }
        }
        i = i + 1;
    }
    i = 0;
    while i < c.r.insts.len {
        let ins = c.r.insts.buf[i];
        i = i + 1;
        if ins.req != prog { continue; }
        if vhas(names, ins.name) == 0 {
            names = names.push(ins.name);
            nkind = nkind.push(u32(1));
            nidx = nidx.push(u32(i - 1));
        }
    }
    // call edges — resolver nids from `cres` rows (ctx = the
    // enclosing fn's canonical name, which `cur_fn` supplies).
    let calls = vec.Vec<u32>::new(c.heap);
    let callk = vec.Vec<u32>::new(c.heap);
    i = 0;
    while i < names.len {
        calls = calls.push(names.buf[i]);
        callk = callk.push(u32(c.cbuf.len));
        c.cur_fn = names.buf[i];
        let b2 = vec.Vec<u32>::new(c.heap);
        if nkind.buf[i] == 0 {
            let f = p.fns.buf[u64(nidx.buf[i])];
            b2 = calls_in(c, p, f.body_off,
                f.body_off + f.body_len, b2);
        } else {
            let ins = c.r.insts.buf[u64(nidx.buf[i])];
            if ins.tp == prog {
                let tf = p.fns.buf[u64(ins.tidx)];
                b2 = calls_in(c, p, tf.body_off,
                    tf.body_off + tf.body_len, b2);
            } else {
                let tf = l.progs.buf[u64(ins.tp)]
                    .fns.buf[u64(ins.tidx)];
                b2 = calls_in(c, l.progs.buf[u64(ins.tp)],
                    tf.body_off, tf.body_off + tf.body_len, b2);
            }
        }
        callk = callk.push(u32(b2.len));
        let j: u64 = 0;
        while j < b2.len {
            c.cbuf = c.cbuf.push(b2.buf[j]);
            j = j + 1;
        }
        b2.destroy();
        i = i + 1;
    }
    // postorder DFS
    let state = vec.Vec<KK>::new(c.heap);
    let cyclic = vec.Vec<u32>::new(c.heap);
    let order = vec.Vec<u32>::new(c.heap);
    i = 0;
    while i < names.len {
        if st_get(state, names.buf[i]) == 0 {
            let d = dfs_order(c, p, names.buf[i], prog,
                calls, callk, names, state, cyclic, order);
            state = d.st; cyclic = d.cyc; order = d.ord;
        }
        i = i + 1;
    }
    // check in callee-first order
    i = 0;
    while i < order.len {
        let n = order.buf[i];
        i = i + 1;
        let j: u64 = 0;
        while j < names.len {
            if names.buf[j] != n { j = j + 1; continue; }
            if nkind.buf[j] == 0 {
                let fd = c.r.fdecls.buf[u64(fb)
                    + u64(nidx.buf[j])];
                if fd.ext == 0 {
                    c = check_fn(c, p,
                        u32(u64(fb) + u64(nidx.buf[j])));
                }
            } else {
                let ins = c.r.insts.buf[u64(nidx.buf[j])];
                if ins.ext == 0 {
                    c = check_inst(c, p, l, prog, nidx.buf[j],
                        rbv.buf[u64(nidx.buf[j])]);
                }
            }
            // a fn on a call cycle is checked but its summary is
            // withheld — callers fall back to arg-union.
            if vhas(cyclic, n) == 1 {
                let q: u64 = 0;
                while q < c.sums.len {
                    if c.sums.buf[q].k == n {
                        c.sums.swap_remove(q);
                    }
                    q = q + 1;
                }
            }
            j = j + 1;
        }
    }
    rbv.destroy();
    names.destroy();
    nkind.destroy();
    nidx.destroy();
    calls.destroy();
    callk.destroy();
    state.destroy();
    cyclic.destroy();
    order.destroy();
    return c;
}


/// bool as u8 for the eat flag.
fn eat_b(bl: u32, bc: u32) -> u8 {
    if bl != 0 || bc != 0 { return 1; }
    return 0;
}

/// joined cert: Def iff both Def.
fn jcert(a: u8, b: u8) -> u8 {
    if a == 1 && b == 1 { return 1; }
    return 2;
}
