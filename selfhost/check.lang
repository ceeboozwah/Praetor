        who: 0, fbase: 0,
        cboff: vec.Vec<u32>::new(heap), cblen: vec.Vec<u32>::new(heap),
        cbases: vec.Vec<u32>::new(heap), tk_out: vec.Vec<u32>::new(heap),
        tk_out2: vec.Vec<u32>::new(heap),
        ahold: vec.Vec<u32>::new(heap), rebs: vec.Vec<Reb>::new(heap),
        reb_edges: vec.Vec<E2>::new(heap),
        reb_caps: vec.Vec<C3>::new(heap),
        sums: vec.Vec<MapE3>::new(heap),
        fsums: vec.Vec<FSum>::new(heap),
        sm_edges: vec.Vec<E2>::new(heap),
        sm_kills: vec.Vec<MapE2>::new(heap),
        sm_ccaps: vec.Vec<C3>::new(heap),
        sm_ckills: vec.Vec<MapE2>::new(heap),
        sm_keys: vec.Vec<u32>::new(heap),
        sm_re: vec.Vec<KM>::new(heap),
        sm_rc: vec.Vec<u32>::new(heap),
        sm_rle: vec.Vec<RLE>::new(heap),
        sm_rlc: vec.Vec<RLE2>::new(heap),
        sm_rlp: vec.Vec<PV>::new(heap),
        scopes: vec.Vec<u32>::new(heap),
        binds: vec.Vec<CBind>::new(heap),
        bnames: vec.Vec<KK>::new(heap),
        regs: vec.Vec<RegF>::new(heap),
        edges: vec.Vec<E2>::new(heap),
        caps: vec.Vec<C3>::new(heap),
        cons: vec.Vec<CF>::new(heap),
