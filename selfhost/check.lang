    while i < ix.len {
        let e = c.sm_re.buf[u64(ix.buf[i])];
        c = es(c, " (re ");
        c = eqs(c, e.k);
        if e.m == 1 { c = es(c, " mut"); } else { c = es(c, " im"); }
        c = ec(c, u8(41));
        i = i + 1;
    }
    ix.destroy();
    return c;
}

