/// `(joined …)` — the post-merge snapshot; every channel sorted.
/// span=NONE prints bare `(joined`.
fn rec_joined(own c: Checker, read p: ast.Parser,
              line: u32, col: u32) -> Checker {
    c = es(c, "(joined");
    if line != NONE() {
        c = es(c, " @");
        c = eu(c, u64(line));
        c = ec(c, u8(58));
        c = eu(c, u64(col));
    }
    // edges sorted by (h,t)
    let es2 = vec.Vec<E2>::new(c.heap);
    let i: u64 = 0;
    while i < c.edges.len { es2 = es2.push(c.edges.buf[i]); i = i + 1; }
    let es3 = esort(c, es2);
    i = 0;
    while i < es3.len {
        let e = es3.buf[i];
        c = es(c, " (e ");
        c = eqs(c, e.h);
        c = ec(c, u8(32));
        c = eqs(c, e.t);
        c = ec(c, u8(32));
        c = eauth(c, e.kind);
        c = ec(c, u8(32));
        c = ecert(c, e.cert);
        c = eat(c, eat_b(e.bl, e.bc), e.bl, e.bc);
        c = ec(c, u8(41));
        i = i + 1;
    }
    es3.destroy();
    let cs2 = vec.Vec<C3>::new(c.heap);
    i = 0;
    while i < c.caps.len { cs2 = cs2.push(c.caps.buf[i]); i = i + 1; }
    let cs3 = csort(c, cs2);
    i = 0;
    while i < cs3.len {
        let e = cs3.buf[i];
        c = es(c, " (c ");
        c = eqs(c, e.h);
        c = ec(c, u8(32));
        c = eqs(c, e.t);
        c = ec(c, u8(32));
        c = ecert(c, e.cert);
        c = ec(c, u8(41));
        i = i + 1;
    }
    cs3.destroy();
    // cons sorted by key — (m k st) where st=cons|maybe
    let ks = vec.Vec<u32>::new(c.heap);
    i = 0;
    while i < c.cons.len { ks = ks.push(c.cons.buf[i].k); i = i + 1; }
    let ks2 = ksort(c, ks);
    i = 0;
    while i < ks2.len {
        let k = ks2.buf[i];
        let st = cons_st(c, k);
        c = es(c, " (m ");
        c = eqs(c, k);
        c = ec(c, u8(32));
        if st == 1 { c = es(c, "cons"); } else { c = es(c, "maybe"); }
        c = ec(c, u8(41));
        i = i + 1;
    }
    ks2.destroy();
    // init sorted — (i k cert)
    let ks = vec.Vec<u32>::new(c.heap);
    i = 0;
    while i < c.init.len { ks = ks.push(c.init.buf[i].k); i = i + 1; }
    let ks2 = ksort(c, ks);
    i = 0;
    while i < ks2.len {
        let k = ks2.buf[i];
        c = es(c, " (i ");
        c = eqs(c, k);
        c = ec(c, u8(32));
        c = ecert(c, init_cert(c, k));
        c = ec(c, u8(41));
        i = i + 1;
    }
    ks2.destroy();
    // tag sorted — (g k v|?)
    let ks = vec.Vec<u32>::new(c.heap);
    i = 0;
    while i < c.tag.len { ks = ks.push(c.tag.buf[i].k); i = i + 1; }
    let ks2 = ksort(c, ks);
    i = 0;
    while i < ks2.len {
        let k = ks2.buf[i];
        c = es(c, " (g ");
        c = eqs(c, k);
        c = ec(c, u8(32));
        let tv = tagv_at(c, k);
        if tv == NONE() { c = es(c, "?"); }
        else { c = eqnid(c, tv); }
        c = ec(c, u8(41));
        i = i + 1;
    }
    ks2.destroy();
    // edge_kills — (k k cert)
    let ks = vec.Vec<u32>::new(c.heap);
    i = 0;
    while i < c.ekills.len { ks = ks.push(c.ekills.buf[i].k); i = i + 1; }
    let ks2 = ksort(c, ks);
    i = 0;
    while i < ks2.len {
        let k = ks2.buf[i];
        c = es(c, " (k ");
        c = eqs(c, k);
        c = ec(c, u8(32));
        c = ecert(c, ek_cert(c, k));
        c = ec(c, u8(41));
        i = i + 1;
    }
    ks2.destroy();
    // cap_kills — (ck k cert)
    let ks = vec.Vec<u32>::new(c.heap);
    i = 0;
    while i < c.ckills.len { ks = ks.push(c.ckills.buf[i].k); i = i + 1; }
    let ks2 = ksort(c, ks);
    i = 0;
    while i < ks2.len {
        let k = ks2.buf[i];
        c = es(c, " (ck ");
        c = eqs(c, k);
        c = ec(c, u8(32));
        c = ecert(c, ck_cert(c, k));
        c = ec(c, u8(41));
        i = i + 1;
    }
    ks2.destroy();
    // path_provs — (p k prov)
    let ks = vec.Vec<u32>::new(c.heap);
    i = 0;
    while i < c.provs.len { ks = ks.push(c.provs.buf[i].k); i = i + 1; }
    let ks2 = ksort(c, ks);
    i = 0;
    while i < ks2.len {
        let k = ks2.buf[i];
        c = es(c, " (p ");
        c = eqs(c, k);
        c = ec(c, u8(32));
        let pv = prov_at(c, k);
        c = eprov(c, pv.pk, pv.pv);
        c = ec(c, u8(41));
        i = i + 1;
    }
    ks2.destroy();
    // transit — (t k)
    let ks = vec.Vec<u32>::new(c.heap);
    i = 0;
    while i < c.transit.len { ks = ks.push(c.transit.buf[i]); i = i + 1; }
    let ks2 = ksort(c, ks);
    i = 0;
    while i < ks2.len {
        c = es(c, " (t ");
        c = eqs(c, ks2.buf[i]);
        c = ec(c, u8(41));
        i = i + 1;
    }
    ks2.destroy();
    // chan queues — (q "chan" (pk …)*)
    let qs2 = vec.Vec<u32>::new(c.heap);
    i = 0;
    while i < c.chans.len { qs2 = qs2.push(c.chans.buf[i].k); i = i + 1; }
    let qs3 = ksort(c, qs2);
    i = 0;
    while i < qs3.len {
        let ck2 = qs3.buf[i];
        c = es(c, " (q ");
        c = eqs(c, ck2);
        let qn = chan_len(c, ck2);
        let qi = chan_idx(c, ck2);
        let j: u64 = 0;
        while j < qn {
            let p = c.chans.buf[u64(qi)].pkts.buf[j];
            c = es(c, " (pk ");
            c = ec(c, u8(34));
            c = e_ty(c, p.ty);
            c = ec(c, u8(34));
            // packet edges sorted
            let pe = vec.Vec<E2>::new(c.heap);
            let w: u64 = 0;
            while w < u64(p.elen) {
                pe = pe.push(c.pk_edges.buf[u64(p.eoff) + w]);
                w = w + 1;
            }
            let pe2 = esort(c, pe);
            w = 0;
            while w < pe2.len {
                let e = pe2.buf[w];
                c = es(c, " (pe ");
                c = eqs(c, e.h);
                c = ec(c, u8(32));
                c = eqs(c, e.t);
                c = ec(c, u8(32));
                c = eauth(c, e.kind);
                c = ec(c, u8(32));
                c = ecert(c, e.cert);
                c = eat(c, eat_b(e.bl, e.bc), e.bl, e.bc);
                c = ec(c, u8(41));
                w = w + 1;
            }
            pe2.destroy();
            let pc = vec.Vec<C3>::new(c.heap);
            w = 0;
            while w < u64(p.clen) {
                pc = pc.push(c.pk_caps.buf[u64(p.coff) + w]);
                w = w + 1;
            }
            let pc2 = csort(c, pc);
            w = 0;
            while w < pc2.len {
                let e = pc2.buf[w];
                c = es(c, " (pc ");
                c = eqs(c, e.h);
                c = ec(c, u8(32));
                c = eqs(c, e.t);
                c = ec(c, u8(32));
                c = ecert(c, e.cert);
                c = ec(c, u8(41));
                w = w + 1;
            }
            pc2.destroy();
            let ps = vec.Vec<u32>::new(c.heap);
            w = 0;
            while w < u64(p.slen) {
                ps = ps.push(c.pk_sent.buf[u64(p.soff) + w]);
                w = w + 1;
            }
            let ps2 = ksort(c, ps);
            w = 0;
            while w < ps2.len {
                c = es(c, " (ps ");
                c = eqs(c, ps2.buf[w]);
                c = ec(c, u8(41));
                w = w + 1;
            }
            ps2.destroy();
            c = ec(c, u8(41));
            j = j + 1;
        }
        c = ec(c, u8(41));
        i = i + 1;
    }
    qs3.destroy();
    // defer_res — (dr k @L:C)
    let ks = vec.Vec<u32>::new(c.heap);
    i = 0;
    while i < c.dres.len { ks = ks.push(c.dres.buf[i].k); i = i + 1; }
    let ks2 = ksort(c, ks);
    i = 0;
    while i < ks2.len {
        let k = ks2.buf[i];
        let j: u64 = 0;
        while j < c.dres.len {
            if c.dres.buf[j].k == k {
                c = es(c, " (dr ");
                c = eqs(c, k);
                c = eat(c, 1, c.dres.buf[j].line, c.dres.buf[j].col);
                c = ec(c, u8(41));
            }
            j = j + 1;
        }
        i = i + 1;
    }
    ks2.destroy();
    // defer frames — (df @L:C …) per non-empty level
    i = 0;
    while i < c.defers.len {
        if c.defers.buf[i].len > 0 {
            c = es(c, " (df");
            let j: u64 = 0;
            while j < c.defers.buf[i].len {
                let e = p.exps.buf[u64(c.defers.buf[i].buf[j].eid)];
                c = es(c, " @");
                c = eu(c, u64(e.line));
                c = ec(c, u8(58));
                c = eu(c, u64(e.col));
                j = j + 1;
            }
            c = ec(c, u8(41));
        }
        i = i + 1;
    }
    c = ec(c, u8(41));
    c = rec(c);
    return c;
}

// ---- channel lookups (no emit) ------------------------------------------

fn cons_st(read c: Checker, k: u32) -> u8 {
    let i: u64 = 0;
    while i < c.cons.len {
        if c.cons.buf[i].k == k { return c.cons.buf[i].st; }
        i = i + 1;
    }
    return 0;
}
fn init_get(read c: Checker, k: u32) -> u8 {
    let i: u64 = 0;
    while i < c.init.len {
        if c.init.buf[i].k == k { return c.init.buf[i].cert; }
        i = i + 1;
    }
    return 0;
}
fn tagv_at(read c: Checker, k: u32) -> u32 {
    let i: u64 = 0;
    while i < c.tag.len {
        if c.tag.buf[i].k == k { return c.tag.buf[i].v; }
        i = i + 1;
    }
    return NONE();
}
fn ek_cert(read c: Checker, k: u32) -> u8 {
    let i: u64 = 0;
    while i < c.ekills.len {
        if c.ekills.buf[i].k == k { return c.ekills.buf[i].cert; }
        i = i + 1;
    }
    return 0;
}
fn ck_cert(read c: Checker, k: u32) -> u8 {
    let i: u64 = 0;
    while i < c.ckills.len {
        if c.ckills.buf[i].k == k { return c.ckills.buf[i].cert; }
        i = i + 1;
    }
    return 0;
}
fn prov_at(read c: Checker, k: u32) -> PV {
    let i: u64 = 0;
    while i < c.provs.len {
        if c.provs.buf[i].k == k { return c.provs.buf[i]; }
        i = i + 1;
    }
    return PV { k: 0, pk: 0, pv: 0 };
}
fn chan_len(read c: Checker, k: u32) -> u64 {
    let i: u64 = 0;
    while i < c.chans.len {
        if c.chans.buf[i].k == k { return c.chans.buf[i].pkts.len; }
        i = i + 1;
    }
    return 0;
}
fn chan_idx(read c: Checker, k: u32) -> u32 {
    let i: u64 = 0;
    while i < c.chans.len {
        if c.chans.buf[i].k == k { return u32(i); }
        i = i + 1;
    }
    return NONE();
}

/// sort E2 by (h,t) key bytes.
fn esort(read c: Checker, own v: vec.Vec<E2>) -> vec.Vec<E2> {
    let i: u64 = 1;
    while i < v.len {
        let x = v.buf[i];
        let j = i;
        while j > 0 {
            let y = v.buf[j - 1];
            let lt = 0;
            if kless(c, x.h, y.h) == 1 { lt = 1; }
            else { if x.h == y.h && kless(c, x.t, y.t) == 1 { lt = 1; } }
            if lt == 0 { break; }
            v.buf[j] = y;
            j = j - 1;
        }
        v.buf[j] = x;
        i = i + 1;
    }
    return v;
}
fn csort(read c: Checker, own v: vec.Vec<C3>) -> vec.Vec<C3> {
    let i: u64 = 1;
    while i < v.len {
        let x = v.buf[i];
        let j = i;
        while j > 0 {
            let y = v.buf[j - 1];
            let lt = 0;
            if kless(c, x.h, y.h) == 1 { lt = 1; }
            else { if x.h == y.h && kless(c, x.t, y.t) == 1 { lt = 1; } }
            if lt == 0 { break; }
            v.buf[j] = y;
            j = j - 1;
        }
        v.buf[j] = x;
        i = i + 1;
    }
    return v;
}

// ---- ty text — resolve.ty_text's format == Rust Ty::Display -------------

fn e_ty(own c: Checker, t: u32) -> Checker {
    if t == NONE() { return es(c, "?"); }
    let n = c.r.rtys.buf[u64(t)];
    if n.kind < 12 {
        if n.kind == 0 { c = es(c, "u8"); }
        if n.kind == 1 { c = es(c, "u16"); }
        if n.kind == 2 { c = es(c, "u32"); }
        if n.kind == 3 { c = es(c, "u64"); }
        if n.kind == 4 { c = es(c, "i8"); }
        if n.kind == 5 { c = es(c, "i16"); }
        if n.kind == 6 { c = es(c, "i32"); }
        if n.kind == 7 { c = es(c, "i64"); }
        if n.kind == 8 { c = es(c, "bool"); }
        if n.kind == 9 { c = es(c, "void"); }
        if n.kind == 10 { c = es(c, "str"); }
        if n.kind == 11 { c = es(c, "alloc"); }
        return c;
    }
    if n.kind == 12 {
        let sp = c.r.rns.buf[u64(n.name)];
        let i: u64 = 0;
        while i < u64(sp.len) {
            c.ev = c.ev.push(c.r.rbyt.buf[u64(sp.off) + i]);
            i = i + 1;
        }
        return c;
    }
    if n.kind == 13 {
        let sp = c.r.rns.buf[u64(n.name)];
        let i: u64 = 0;
        while i < u64(sp.len) {
            c.ev = c.ev.push(c.r.rbyt.buf[u64(sp.off) + i]);
            i = i + 1;
        }
        c = ec(c, u8(60));
        let sep: u8 = 0;
        i = u64(n.b);
        while i < u64(n.b) + u64(n.c) {
            if sep == 1 { c = ec(c, u8(44)); }
            c = e_ty(c, c.r.targs.buf[i]);
            sep = 1;
            i = i + 1;
        }
        return ec(c, u8(62));
    }
    if n.kind == 14 {
        c = ec(c, u8(91));
        c = eu(c, n.w);
        c = ec(c, u8(93));
        return e_ty(c, n.a);
    }
    if n.kind == 15 {
        c = ec(c, u8(38));
        if n.b == 1 { c = es(c, "mut "); }
        return e_ty(c, n.a);
    }
    if n.kind == 16 {
        c = ec(c, u8(42));
        if n.b == 0 { c = es(c, "const "); }
        return e_ty(c, n.a);
    }
    if n.kind == 17 {
        c = es(c, "slice ");
        if n.b == 1 { c = es(c, "mut "); }
        return e_ty(c, n.a);
    }
    if n.kind == 18 { c = es(c, "handle "); }
    if n.kind == 19 { c = es(c, "task "); }
    if n.kind == 20 { c = es(c, "atomic "); }
    if n.kind == 21 { c = es(c, "mutex "); }
    if n.kind == 22 { c = es(c, "guard "); }
    if n.kind == 23 { c = es(c, "channel "); }
    if n.kind == 24 { c = es(c, "box "); }
    if n.kind == 25 { c = es(c, "box slice "); }
    return e_ty(c, n.a);
}

/// RTy name push (kind 12/13 helper for quoted contexts).
fn e_tyn(own c: Checker, nid: u32) -> Checker {
    let sp = c.r.rns.buf[u64(nid)];
    let i: u64 = 0;
    while i < u64(sp.len) {
        c.ev = c.ev.push(c.r.rbyt.buf[u64(sp.off) + i]);
        i = i + 1;
    }
    return c;
}

// ---- scopes / binds ------------------------------------------------------

fn push_scope(own c: Checker) -> Checker {
    c = es(c, "(scope)");
    c = rec(c);
    c.scopes = c.scopes.push(u32(c.bnames.len));
    c.defers = c.defers.push(vec.Vec<DeferRec>::new(c.heap));
    return c;
}

/// lookup by name nid — innermost-first; returns binds idx | -1.
fn bfind(read c: Checker, n: u32) -> i64 {
    let i = c.bnames.len;
    while i > 0 {
        i = i - 1;
        let b = c.bnames.buf[i];
        if b.k == n { return i64(b.v); }
    }
    return 0 - 1;
}

/// bnames slot = (name nid -> binds idx).
fn bput(own c: Checker, n: u32, bi: u32) -> Checker {
    c.bnames = c.bnames.push(KK { k: n, v: bi });
    return c;
}

fn cur_region(read c: Checker) -> u32 {
    return u32(c.regs.len) - 1;
}

/// Scope pop — drains bnames past the top scope offset into `popped`
/// (name -> binds idx pairs, pop order = reverse insertion).
pub struct CP { c: Checker, popped: vec.Vec<KK> }
fn pop_scope_names(own c: Checker) -> CP {
    let popped = vec.Vec<KK>::new(c.heap);
    let off = u64(c.scopes.buf[u64(c.scopes.len - 1)]);
    while c.bnames.len > off {
        popped = popped.push(c.bnames.pop());
    }
    c.scopes.pop();
    return CP { c: c, popped: popped };
}

// ---- place-key path ops -------------------------------------------------

/// `x#3.f.g` -> `x#3`; `$arg0.f` -> `$arg0`. Root = prefix to first
/// `.` or `[`.
fn key_root(own c: Checker, k: u32) -> Checker {
    let sp = c.kns.buf[u64(k)];
    let i: u64 = 0;
    while i < u64(sp.len) {
        let b = c.kbyt.buf[u64(sp.off) + i];
        if b == u8(46) || b == u8(91) { break; }
        c.ksc = c.ksc.push(b);
        i = i + 1;
    }
    let n = u64(c.ksc.len);
    c = kin(c, &c.ksc.buf[0..n]);
    while c.ksc.len > 0 { c.ksc.pop(); }
    return c;
}

/// name-nid bytes of key root — for `dead.contains(path_root(k))`.
fn kroot_cmp(read c: Checker, a: slice u8, b: u32) -> u8 {
    // a = root bytes, b = key nid — does key's root equal `a`?
    let sp = c.kns.buf[u64(b)];
    let i: u64 = 0;
    while i < u64(sp.len) && i < a.len {
        if c.kbyt.buf[u64(sp.off) + i] != a[i] { return 0; }
        let x = c.kbyt.buf[u64(sp.off) + i];
        if x == u8(46) || x == u8(91) { return 0; }
        i = i + 1;
    }
    if i < a.len { return 0; }
    if i == u64(sp.len) { return 1; }
    let x = c.kbyt.buf[u64(sp.off) + i];
    if x == u8(46) || x == u8(91) { return 1; }
    return 0;
}

/// key root == dead-key nid? compares bytes.
fn kroot_eq(read c: Checker, root: u32, k: u32) -> u8 {
    // root is already a root key (no ./[) — k's root prefix must equal
    // it byte-for-byte.
    let ra = c.kns.buf[u64(root)];
    let kb = c.kns.buf[u64(k)];
    if ra.len > kb.len { return 0; }
    let i: u64 = 0;
    while i < u64(ra.len) {
        if c.kbyt.buf[u64(ra.off) + i] != c.kbyt.buf[u64(kb.off) + i] {
            return 0;
        }
        i = i + 1;
    }
    if u64(kb.len) == u64(ra.len) { return 1; }
    let x = c.kbyt.buf[u64(kb.off) + u64(ra.len)];
    if x == u8(46) || x == u8(91) { return 1; }
    return 0;
}

/// `dead` set membership via root equality against dead ROOT keys.
/// `dead` holds binding keys `n#e` — path_root(k) ∈ dead iff some
/// dead key byte-equals k's root prefix.
fn dead_has(read c: Checker, read dead: vec.Vec<u32>, k: u32) -> u8 {
    let i: u64 = 0;
    while i < dead.len {
        if kroot_eq(c, dead.buf[i], k) == 1 { return 1; }
        i = i + 1;
    }
    return 0;
}

/// root-byte equality of two keys (prefix to first `.`/`[`).
fn roots_eq(read c: Checker, a: u32, b: u32) -> u8 {
    let sa = c.kns.buf[u64(a)];
    let sb = c.kns.buf[u64(b)];
    let i: u64 = 0;
    let e = u64(sa.len);
    if u64(sb.len) < e { e = u64(sb.len); }
    while i < e {
        let x = c.kbyt.buf[u64(sa.off) + i];
        let y = c.kbyt.buf[u64(sb.off) + i];
        if x != y { return 0; }
        // same position, same delimiter — both roots end here, equal.
        if x == u8(46) || x == u8(91) { return 1; }
        i = i + 1;
    }
    // roots must end at the same position — the shorter key's next
    // char (or its end) must be a boundary on both sides.
    if sa.len == sb.len { return 1; }
    let x = c.kbyt.buf[u64(sa.off) + i];
    if u64(sa.len) < u64(sb.len) {
        x = c.kbyt.buf[u64(sb.off) + i];
    }
    if x == u8(46) || x == u8(91) { return 1; }
    return 0;
}

/// `a` is a boundary-prefix of `b` (same bytes to `a`'s end, then
/// `.`/`[`/`*`).
fn kprefix(read c: Checker, a: u32, b: u32) -> u8 {
    let sa = c.kns.buf[u64(a)];
    let sb = c.kns.buf[u64(b)];
    if sa.len > sb.len { return 0; }
    let i: u64 = 0;
    while i < u64(sa.len) {
        if c.kbyt.buf[u64(sa.off) + i] != c.kbyt.buf[u64(sb.off) + i] {
            return 0;
        }
        i = i + 1;
    }
    if sa.len == sb.len { return 1; }
    let x = c.kbyt.buf[u64(sb.off) + u64(sa.len)];
    if x == u8(46) || x == u8(91) || x == u8(42) { return 1; }
    return 0;
}

/// overlap: same root + prefix at `./[`/`*` boundary (either way).
fn overlap(read c: Checker, a: u32, b: u32) -> u8 {
    if roots_eq(c, a, b) == 0 { return 0; }
    if kprefix(c, a, b) == 1 { return 1; }
    return kprefix(c, b, a);
}

// ---- live_own_at + flag_abandoned + expire_scope -------------------------

/// init_present: `k` or any `./[`-ancestor of it is Def/Maybe in init.
/// Rust walks `init_parent` UP from `init_canon(k)` — a live
/// descendant (`v#2.buf` under an un-init `v#2`) does NOT count.
fn init_present(read c: Checker, k: u32) -> u8 {
    let i: u64 = 0;
    while i < c.init.len {
        if c.init.buf[i].k == k
            || kprefix(c, c.init.buf[i].k, k) == 1 {
            return 1;
        }
        i = i + 1;
    }
    return 0;
}

/// consumed_state: fact st or NONE.
fn cons_state(read c: Checker, k: u32) -> u8 {
    let i: u64 = 0;
    while i < c.cons.len {
        if c.cons.buf[i].k == k { return c.cons.buf[i].st; }
        i = i + 1;
    }
    return 0;
}

/// does key contain `[]`?
fn k_has_brackets(read c: Checker, k: u32) -> u8 {
    let sp = c.kns.buf[u64(k)];
    let i: u64 = 0;
    while i < u64(sp.len) {
        if c.kbyt.buf[u64(sp.off) + i] == u8(91) {
            if i + 1 < u64(sp.len) {
                if c.kbyt.buf[u64(sp.off) + i + 1] == u8(93) { return 1; }
            }
        }
        i = i + 1;
    }
    return 0;
}

/// live_own_at — some held `own` path under `k`, or NONE.
/// Port of the recursive struct/enum descent with tag pruning.
fn live_own_at(own c: Checker, k: u32, ty: u32) -> Checker {
    c.res = NONE();
    if k_has_brackets(c, k) == 1 { return c; }
    if init_present(c, k) == 0 { return c; }
    if cons_covers(c, k) == 1 { return c; }
    let n = c.r.rtys.buf[u64(ty)];
    if n.kind == 24 || n.kind == 25 {
        c.res = k;
        return c;
    }
    if n.kind == 20 {  // atomic — descend payload
        c = live_own_at(c, k, n.a);
        return c;
    }
    if n.kind == 12 || n.kind == 13 {
        // struct/enum — find decl by name nid
        let en = n.name;
        // enum?  variants in `vars` via edecl
        let ei = edecl_by_name(c, en);
        if ei != NONE() {
            let ed = c.r.edecls.buf[u64(ei)];
            let i: u64 = 0;
            while i < u64(ed.vs_len) {
                let vd = c.r.vars.buf[u64(ed.vs_off) + i];
                if vd.ty != NONE() {
                    // payload live while tag can still name this variant
                    let tv = tagv_at(c, k);
                    let possible = 1;
                    if tv != NONE() && tv != vd.name { possible = 0; }
                    if possible == 1 {
                        c = key_field(c, k, vd.name);
                        let k2 = c.res;
                        c = live_own_at(c, k2, vd.ty);
                        if c.res != NONE() { return c; }
                    }
                }
                i = i + 1;
            }
            return c;
        }
        c = sfields_of(c, ty);
        if c.res != NONE() {
            let f0 = c.res; let fn2 = c.res2;
            let i: u64 = 0;
            while i < u64(fn2) {
                let fd = c.r.sfields.buf[u64(f0) + i];
                c = key_field(c, k, fd.name);
                let k2 = c.res;
                c = live_own_at(c, k2, fd.ty);
                if c.res != NONE() { return c; }
                i = i + 1;
            }
        }
        c.res = NONE();
        return c;
    }
    return c;
}

fn edecl_by_name(read c: Checker, n: u32) -> u32 {
    let i: u64 = 0;
    while i < c.r.edecls.len {
        if c.r.edecls.buf[i].name == n { return u32(i); }
        i = i + 1;
    }
    return NONE();
}
fn sdecl_by_name(read c: Checker, n: u32) -> u32 {
    let i: u64 = 0;
    while i < c.r.sdecls.len {
        if c.r.sdecls.buf[i].name == n { return u32(i); }
        i = i + 1;
    }
    return NONE();
}

/// `(abandon "key")` + the cannot-leave-scope diag for live `own`
/// authority dying at this point. `popped` = (name -> binds idx)
/// pairs, sorted by `name#epoch` key text.
fn flag_abandoned(own c: Checker, own popped: vec.Vec<KK>,
                  el: u32, ec: u32, has_exit: u8,
                  phrase: str) -> Checker {
    // sort popped by `name#epoch` bytes — the place key IS the order.
    // Build keys first for stable sort.
    let keys = vec.Vec<u32>::new(c.heap);
    let i: u64 = 0;
    while i < popped.len {
        let b = c.binds.buf[u64(popped.buf[i].v)];
        c = key_of(c, popped.buf[i].k, b.epoch);
        keys = keys.push(c.res);
        i = i + 1;
    }
    // insertion sort popped by key bytes
    i = 1;
    while i < popped.len {
        let x = popped.buf[i];
        let xk = keys.buf[i];
        let j = i;
        while j > 0 && kless(c, xk, keys.buf[j - 1]) == 1 {
            popped.buf[j] = popped.buf[j - 1];
            keys.buf[j] = keys.buf[j - 1];
            j = j - 1;
        }
        popped.buf[j] = x;
        keys.buf[j] = xk;
        i = i + 1;
    }
    i = 0;
    while i < popped.len {
        let n = popped.buf[i].k;
        let b = c.binds.buf[u64(popped.buf[i].v)];
        if b.auth == 1 || b.auth == 2 {
            i = i + 1;
            continue;
        }
        let key = keys.buf[i];
        if vhas(c.abandoned, key) == 1 {
            i = i + 1;
            continue;
        }
        // own-param probe: an edge key.h == key targeting `$arg*`
        let probe = key;
        let j: u64 = 0;
        while j < c.edges.len {
            let e = c.edges.buf[j];
            if e.h == key {
                if k_starts_arg(c, e.t) == 1 { probe = e.t; }
                break;
            }
            j = j + 1;
        }
        c = live_own_at(c, probe, b.ty);
        let held = c.res;
        if held != NONE() {
            let tail0 = tail_off(c, probe, held);
            let tail_empty = 0;
            if tail0 != NONE() {
                tail_empty = 0;
                if u64(tail0) == u64(c.kns.buf[u64(held)].len) { tail_empty = 1; }
            }
            c = es(c, "(abandon ");
            c = eqs(c, key);
            c = es(c, ")");
            c = rec(c);
            c.abandoned = c.abandoned.push(key);
            let internal = n_is_dollar(c, n);
            // build the message
            let m = vec.Vec<u8>::new(c.heap);
            let m2 = resolve.bputs(m, "cannot leave scope while ");
            let m3 = m2;
            if internal == 1 {
                m3 = resolve.bputs(m3, "the `match`ed value");
            } else {
                m3 = resolve.bputs(m3, "`");
                m3 = push_rname(m3, c, n);
                m3 = resolve.bputs(m3, "`");
            }
            let m4 = resolve.bputs(m3, " still owns ");
            let m5 = m4;
            if tail0 == NONE() || tail_empty == 1 {
                m5 = resolve.bputs(m5, "live resources");
            } else { if internal == 1 {
                m5 = resolve.bputs(m5, "`");
                m5 = push_ktail(m5, c, held, tail0 + 1);
                m5 = resolve.bputs(m5, "`");
            } else {
                m5 = resolve.bputs(m5, "`");
                m5 = push_rname(m5, c, n);
                m5 = push_ktail(m5, c, held, tail0);
                m5 = resolve.bputs(m5, "`");
            } }
            c = msg(c, m5.as_slice());
            let m0 = c.res;
            let m1 = c.res2;
            m5.destroy();
            // label on exit span when present
            let l0 = u32(c.dlab.len);
            if has_exit == 1 {
                let lm = vec.Vec<u8>::new(c.heap);
                let lm2 = resolve.bputs(lm, phrase);
                let lm3 = resolve.bputs(lm2, " before ");
                let lm4 = lm3;
                if internal == 1 {
                    lm4 = resolve.bputs(lm4, "the `match`ed value");
                } else {
                    lm4 = resolve.bputs(lm4, "`");
                    lm4 = push_rname(lm4, c, n);
                    lm4 = resolve.bputs(lm4, "`");
                }
                let lm5 = resolve.bputs(lm4, " is released");
                c = msg(c, lm5.as_slice());
                c.dlab = c.dlab.push(CLab {
                    line: el, col: ec, m0: c.res, m1: c.res2 });
                lm5.destroy();
            }
            let l1 = u32(c.dlab.len);
            c = err_rec(c, b.line, b.col,
                &c.ebyt.buf[u64(m0)..u64(m1)], l0, l1,
                u32(c.dnote.len), u32(c.dnote.len));
            c.errs = c.errs.push(CDiag {
                line: b.line, col: b.col, m0: m0, m1: m1,
                l0: l0, l1: l1, n0: 0, n1: 0 });
        }
        i = i + 1;
    }
    keys.destroy();
    popped.destroy();
    return c;
}

/// does key text start with `$arg`?
fn k_starts_arg(read c: Checker, k: u32) -> u8 {
    let sp = c.kns.buf[u64(k)];
    if sp.len < 4 { return 0; }
    if c.kbyt.buf[u64(sp.off)] == u8(36)
        && c.kbyt.buf[u64(sp.off) + 1] == u8(97)
        && c.kbyt.buf[u64(sp.off) + 2] == u8(114)
        && c.kbyt.buf[u64(sp.off) + 3] == u8(103) {
        return 1;
    }
    return 0;
}

/// resolver name starts with `$`?
fn n_is_dollar(read c: Checker, n: u32) -> u8 {
    let sp = c.r.rns.buf[u64(n)];
    if sp.len == 0 { return 0; }
    if c.r.rbyt.buf[u64(sp.off)] == u8(36) { return 1; }
    return 0;
}

/// held's byte offset just past probe's prefix — NONE when not a
/// prefix.
fn tail_off(read c: Checker, probe: u32, held: u32) -> u32 {
    let sa = c.kns.buf[u64(probe)];
    let sb = c.kns.buf[u64(held)];
    if sa.len > sb.len { return NONE(); }
    let i: u64 = 0;
    while i < u64(sa.len) {
        if c.kbyt.buf[u64(sa.off) + i] != c.kbyt.buf[u64(sb.off) + i] {
            return NONE();
        }
        i = i + 1;
    }
    return u32(sa.len);
}

fn push_rname(own v: vec.Vec<u8>, read c: Checker, n: u32) -> vec.Vec<u8> {
    let sp = c.r.rns.buf[u64(n)];
    let i: u64 = 0;
    while i < u64(sp.len) {
        v = v.push(c.r.rbyt.buf[u64(sp.off) + i]);
        i = i + 1;
    }
    return v;
}

/// key bytes from offset — for tails.
fn push_ktail(own v: vec.Vec<u8>, read c: Checker,
              k: u32, off: u32) -> vec.Vec<u8> {
    let sp = c.kns.buf[u64(k)];
    let i: u64 = u64(off);
    while i < u64(sp.len) {
        v = v.push(c.kbyt.buf[u64(sp.off) + i]);
        i = i + 1;
    }
    return v;
}

// ---- retains --------------------------------------------------------------
// Dead keys collect + sort first (Stage-0's pattern), then emit and
// remove — the event order is canonical regardless of table layout.

/// collect sorted dead indices; emits `(unedge h t)` per removed.
fn edges_retain_dead(own c: Checker, read dead: vec.Vec<u32>) -> Checker {
    let ks = vec.Vec<u64>::new(c.heap);
    let i: u64 = 0;
    while i < c.edges.len {
        let e = c.edges.buf[i];
        c = key_root(c, e.h);
        let rh = c.res;
        c = key_root(c, e.t);
        let rt = c.res;
        if dead_has(c, dead, rh) == 1 || dead_has(c, dead, rt) == 1 {
            ks = ks.push(u64(u32(i)));
        }
        i = i + 1;
    }
    // sort by (h bytes, t bytes)
    i = 1;
    while i < ks.len {
        let x = ks.buf[i];
        let ex = c.edges.buf[u64(u32(x))];
        let j = i;
        while j > 0 {
            let ey = c.edges.buf[u64(u32(ks.buf[j - 1]))];
            let less = u8(0);
            if kless(c, ex.h, ey.h) == 1 { less = 1; }
            else { if ey.h == ex.h { less = kless(c, ex.t, ey.t); } }
            if less == 0 { break; }
            ks.buf[j] = ks.buf[j - 1];
            j = j - 1;
        }
        ks.buf[j] = x;
        i = i + 1;
    }
    i = 0;
    while i < ks.len {
        let e = c.edges.buf[u64(u32(ks.buf[i]))];
        c = es(c, "(unedge ");
        c = eqs(c, e.h);
        c = ec(c, u8(32));
        c = eqs(c, e.t);
        c = ec(c, u8(41));
        c = rec(c);
        i = i + 1;
    }
    // compact — drop retained-dead entries
    let w = vec.Vec<E2>::new(c.heap);
    i = 0;
    while i < c.edges.len {
        let e = c.edges.buf[i];
        c = key_root(c, e.h);
        let rh = c.res;
        c = key_root(c, e.t);
        let rt = c.res;
        if dead_has(c, dead, rh) == 0 && dead_has(c, dead, rt) == 0 {
            w = w.push(e);
        }
        i = i + 1;
    }
    c.edges.destroy();
    c.edges = w;
    ks.destroy();
    return c;
}

fn caps_retain_dead(own c: Checker, read dead: vec.Vec<u32>) -> Checker {
    let ks = vec.Vec<u64>::new(c.heap);
    let i: u64 = 0;
    while i < c.caps.len {
        c = key_root(c, c.caps.buf[i].h);
        if dead_has(c, dead, c.res) == 1 { ks = ks.push(i); }
        i = i + 1;
    }
    i = 1;
    while i < ks.len {
        let x = ks.buf[i];
        let ex = c.caps.buf[u64(u32(x))];
        let j = i;
        while j > 0 {
            let ey = c.caps.buf[u64(u32(ks.buf[j - 1]))];
            let less = u8(0);
            if kless(c, ex.h, ey.h) == 1 { less = 1; }
            else { if ey.h == ex.h { less = kless(c, ex.t, ey.t); } }
            if less == 0 { break; }
            ks.buf[j] = ks.buf[j - 1];
            j = j - 1;
        }
        ks.buf[j] = x;
        i = i + 1;
    }
    i = 0;
    while i < ks.len {
        let e = c.caps.buf[u64(u32(ks.buf[i]))];
        c = es(c, "(uncap ");
        c = eqs(c, e.h);
        c = ec(c, u8(32));
        c = eqs(c, e.t);
        c = ec(c, u8(41));
        c = rec(c);
        i = i + 1;
    }
    let w = vec.Vec<C3>::new(c.heap);
    i = 0;
    while i < c.caps.len {
        let e = c.caps.buf[i];
        c = key_root(c, e.h);
        if dead_has(c, dead, c.res) == 0 { w = w.push(e); }
        i = i + 1;
    }
    c.caps.destroy();
    c.caps = w;
    ks.destroy();
    return c;
}

fn provs_retain_dead(own c: Checker, read dead: vec.Vec<u32>) -> Checker {
    let ks = vec.Vec<u64>::new(c.heap);
    let i: u64 = 0;
    while i < c.provs.len {
        c = key_root(c, c.provs.buf[i].k);
        if dead_has(c, dead, c.res) == 1 { ks = ks.push(i); }
        i = i + 1;
    }
    ks = sort_key_idx(c, ks, c.provs.len, 0);
    i = 0;
    while i < ks.len {
        let p = c.provs.buf[u64(u32(ks.buf[i]))];
        c = es(c, "(unprov ");
        c = eqs(c, p.k);
        c = ec(c, u8(41));
        c = rec(c);
        i = i + 1;
    }
    let w = vec.Vec<PV>::new(c.heap);
    i = 0;
    while i < c.provs.len {
        let p = c.provs.buf[i];
        c = key_root(c, p.k);
        if dead_has(c, dead, c.res) == 0 { w = w.push(p); }
        i = i + 1;
    }
    c.provs.destroy();
    c.provs = w;
    ks.destroy();
    return c;
}

fn cons_retain_dead(own c: Checker, read dead: vec.Vec<u32>) -> Checker {
    let ks = vec.Vec<u64>::new(c.heap);
    let i: u64 = 0;
    while i < c.cons.len {
        c = key_root(c, c.cons.buf[i].k);
        if dead_has(c, dead, c.res) == 1 { ks = ks.push(i); }
        i = i + 1;
    }
    ks = sort_key_idx(c, ks, c.cons.len, 3);
    i = 0;
    while i < ks.len {
        let f = c.cons.buf[u64(u32(ks.buf[i]))];
        c = es(c, "(uncons ");
        c = eqs(c, f.k);
        c = ec(c, u8(41));
        c = rec(c);
        i = i + 1;
    }
    let w = vec.Vec<CF>::new(c.heap);
    i = 0;
    while i < c.cons.len {
        let f = c.cons.buf[i];
        c = key_root(c, f.k);
        if dead_has(c, dead, c.res) == 0 { w = w.push(f); }
        i = i + 1;
    }
    c.cons.destroy();
    c.cons = w;
    ks.destroy();
    return c;
}

fn init_retain_dead(own c: Checker, read dead: vec.Vec<u32>) -> Checker {
    let ks = vec.Vec<u64>::new(c.heap);
    let i: u64 = 0;
    while i < c.init.len {
        c = key_root(c, c.init.buf[i].k);
        if dead_has(c, dead, c.res) == 1 { ks = ks.push(i); }
        i = i + 1;
    }
    ks = sort_key_idx(c, ks, c.init.len, 1);
    i = 0;
    while i < ks.len {
        let f = c.init.buf[u64(u32(ks.buf[i]))];
        c = es(c, "(uninit ");
        c = eqs(c, f.k);
        c = ec(c, u8(41));
        c = rec(c);
        i = i + 1;
    }
    let w = vec.Vec<MapE2>::new(c.heap);
    i = 0;
    while i < c.init.len {
        let f = c.init.buf[i];
        c = key_root(c, f.k);
        if dead_has(c, dead, c.res) == 0 { w = w.push(f); }
        i = i + 1;
    }
    c.init.destroy();
    c.init = w;
    ks.destroy();
    return c;
}

fn tag_retain_dead(own c: Checker, read dead: vec.Vec<u32>) -> Checker {
    let ks = vec.Vec<u64>::new(c.heap);
    let i: u64 = 0;
    while i < c.tag.len {
        c = key_root(c, c.tag.buf[i].k);
        if dead_has(c, dead, c.res) == 1 { ks = ks.push(i); }
        i = i + 1;
    }
    ks = sort_key_idx(c, ks, c.tag.len, 2);
    i = 0;
    while i < ks.len {
        let f = c.tag.buf[u64(u32(ks.buf[i]))];
        c = es(c, "(untag ");
        c = eqs(c, f.k);
        c = ec(c, u8(41));
        c = rec(c);
        i = i + 1;
    }
    let w = vec.Vec<TG>::new(c.heap);
    i = 0;
    while i < c.tag.len {
        let f = c.tag.buf[i];
        c = key_root(c, f.k);
        if dead_has(c, dead, c.res) == 0 { w = w.push(f); }
        i = i + 1;
    }
    c.tag.destroy();
    c.tag = w;
    ks.destroy();
    return c;
}

/// key field of entry `i` in the `which` table:
/// 0 = provs, 1 = init, 2 = tag, 3 = cons.
fn tbl_key(read c: Checker, i: u64, which: u8) -> u32 {
    if which == 0 { return c.provs.buf[i].k; }
    if which == 2 { return c.tag.buf[i].k; }
    if which == 3 { return c.cons.buf[i].k; }
    return c.init.buf[i].k;
}

/// insertion-sort index table by the `k` key bytes of entries.
fn sort_key_idx(read c: Checker, own ks: vec.Vec<u64>,
                n: u64, which: u8) -> vec.Vec<u64> {
    let i: u64 = 1;
    while i < ks.len {
        let x = ks.buf[i];
        let kx = tbl_key(c, u64(u32(x)), which);
        let j = i;
        while j > 0 {
            let ky = tbl_key(c, u64(u32(ks.buf[j - 1])), which);
            if kless(c, kx, ky) == 0 { break; }
            ks.buf[j] = ks.buf[j - 1];
            j = j - 1;
        }
        ks.buf[j] = x;
        i = i + 1;
    }
    return ks;
}

// ---- expire_scope ---------------------------------------------------------

/// name bytes of a key — up to `#`.
fn push_kname(own v: vec.Vec<u8>, read c: Checker, k: u32) -> vec.Vec<u8> {
    let sp = c.kns.buf[u64(k)];
    let i: u64 = 0;
    while i < u64(sp.len) {
        let b = c.kbyt.buf[u64(sp.off) + i];
        if b == u8(35) { break; }
        v = v.push(b);
        i = i + 1;
    }
    return v;
}

fn task_find(read c: Checker, k: u32) -> u32 {
    let i: u64 = 0;
    while i < c.tasks.len {
        if c.tasks.buf[i].key == k { return u32(i); }
        i = i + 1;
    }
    return NONE();
}

/// Scope-exit teardown: survivors re-insert, dead place roots drive
/// task/own diagnostics and the structural retains, `(pop)` last.
fn expire_scope(own c: Checker, own popped: vec.Vec<KK>,
                el: u32, ec: u32, has_exit: u8,
                phrase: str) -> Checker {
    let cur = cur_region(c);
    // partition — survivors (owner < cur) re-bind in the outer scope.
    // Same-scope rebinds (`let v = …` twice) push two bnames entries;
    // stage-0's scope map replaces in place, so only the LAST insert
    // (= first in pop order) joins dead — the shadowed binding's
    // storage facts are left to die silently.
    let survivors = vec.Vec<KK>::new(c.heap);
    let dead_b = vec.Vec<KK>::new(c.heap);
    let seen = vec.Vec<u32>::new(c.heap);
    let i: u64 = 0;
    while i < popped.len {
        let nm = popped.buf[i].k;
        if vhas(seen, nm) == 1 { i = i + 1; continue; }
        seen = seen.push(nm);
        let b = c.binds.buf[u64(popped.buf[i].v)];
        if b.owner < cur {
            survivors = survivors.push(popped.buf[i]);
        } else {
            dead_b = dead_b.push(popped.buf[i]);
        }
        i = i + 1;
    }
    seen.destroy();
    popped.destroy();
    // sort dead_binds by name bytes
    i = 1;
    while i < dead_b.len {
        let x = dead_b.buf[i];
        let j = i;
        while j > 0 && rless(c, x.k, dead_b.buf[j - 1].k) == 1 {
            dead_b.buf[j] = dead_b.buf[j - 1];
            j = j - 1;
        }
        dead_b.buf[j] = x;
        i = i + 1;
    }
    // survivors into the outer scope (now scopes.top-1 after the pop)
    i = 0;
    while i < survivors.len {
        c.bnames = c.bnames.push(survivors.buf[i]);
        i = i + 1;
    }
    survivors.destroy();
    // dead root keys
    let dead = vec.Vec<u32>::new(c.heap);
    i = 0;
    while i < dead_b.len {
        let b = c.binds.buf[u64(dead_b.buf[i].v)];
        c = key_of(c, dead_b.buf[i].k, b.epoch);
        dead = dead.push(c.res);
        i = i + 1;
    }
    if c.terminated == 0 {
        // task escapes: h is a live task, t's root dies here
        let esc = vec.Vec<KK>::new(c.heap);
        i = 0;
        while i < c.edges.len {
            let e = c.edges.buf[i];
            if task_find(c, e.h) != NONE() && dead_has(c, dead, e.h) == 0 {
                c = key_root(c, e.t);
                if dead_has(c, dead, c.res) == 1 {
                    esc = esc.push(KK { k: e.h, v: e.t });
                }
            }
            i = i + 1;
        }
        // sort by (h, t)
        i = 1;
        while i < esc.len {
            let x = esc.buf[i];
            let j = i;
            while j > 0 {
                let y = esc.buf[j - 1];
                let less = u8(0);
                if kless(c, x.k, y.k) == 1 { less = 1; }
                else { if y.k == x.k { less = kless(c, x.v, y.v); } }
                if less == 0 { break; }
                esc.buf[j] = esc.buf[j - 1];
                j = j - 1;
            }
            esc.buf[j] = x;
            i = i + 1;
        }
        i = 0;
        while i < esc.len {
            let h = esc.buf[i].k;
            let t = esc.buf[i].v;
            let ti = task_find(c, h);
            let tl = c.tasks.buf[u64(ti)].line;
            let tc = c.tasks.buf[u64(ti)].col;
            let m = vec.Vec<u8>::new(c.heap);
            let m2 = resolve.bputs(m, "task `");
            let m3 = push_kname(m2, c, h);
            let m4 = resolve.bputs(m3, "` escapes its target's region: it still holds `");
            c = key_root(c, t);
            let m5 = push_kname(m4, c, c.res);
            let m6 = resolve.bputs(m5, "`, which dies at the end of this scope");
            c = pdiag(c, tl, tc, m6.as_slice());
            m6.destroy();
            i = i + 1;
        }
        esc.destroy();
        // unjoined tasks dying here
        i = 0;
        while i < dead.len {
            let d = dead.buf[i];
            if task_find(c, d) != NONE() && cons_covers(c, d) == 0 {
                let ti = task_find(c, d);
                let tl = c.tasks.buf[u64(ti)].line;
                let tc = c.tasks.buf[u64(ti)].col;
                let m = vec.Vec<u8>::new(c.heap);
                let m2 = resolve.bputs(m, "task `");
                let m3 = push_kname(m2, c, d);
                let m4 = resolve.bputs(m3, "` goes out of scope without `join`");
                c = pdiag(c, tl, tc, m4.as_slice());
                m4.destroy();
            }
            i = i + 1;
        }
        if c.diverged == 0 {
            c = flag_abandoned(c, dead_b, el, ec, has_exit, phrase);
        } else {
            dead_b.destroy();
        }
    } else {
        dead_b.destroy();
    }
    // structural retains
    c = edges_retain_dead(c, dead);
    c = caps_retain_dead(c, dead);
    c = provs_retain_dead(c, dead);
    c = cons_retain_dead(c, dead);
    c = init_retain_dead(c, dead);
    c = tag_retain_dead(c, dead);
    dead.destroy();
    return c;
}

/// resolver-name byte order (for dead_binds' name sort).
fn rless(read c: Checker, a: u32, b: u32) -> u8 {
    let sa = c.r.rns.buf[u64(a)];
    let sb = c.r.rns.buf[u64(b)];
    let i: u64 = 0;
    let e = u64(sa.len);
    if u64(sb.len) < e { e = u64(sb.len); }
    while i < e {
        let x = c.r.rbyt.buf[u64(sa.off) + i];
        let y = c.r.rbyt.buf[u64(sb.off) + i];
        if x != y { if x < y { return 1; } return 0; }
        i = i + 1;
    }
    if sa.len < sb.len { return 1; }
    return 0;
}

// ---- expression layer ------------------------------------------------------
// expr_tv(eid) -> res=tyid, res2=prov_k, res3=prov_v
// The want-context variant is expr_tv_w; `init_ok` gates require_init
// for place arms (mirroring Rust's expr_tv_go init_ok flag).

/// primitive tyid by TK kind — resolver pre-seeds prims? find or make.
fn rty_prim(own c: Checker, kind: u8) -> Checker {
    let i: u64 = 0;
    while i < c.r.rtys.len {
        let t = c.r.rtys.buf[i];
        if t.kind == kind && t.name == 0 && t.a == 0 && t.w == 0 {
            c.res = u32(i);
            return c;
        }
        i = i + 1;
    }
    c.r.rtys = c.r.rtys.push(resolve.RTy {
        kind: kind, name: 0, a: 0, b: 0, c: 0, w: 0 });
    c.res = u32(c.r.rtys.len) - 1;
    return c;
}

/// `*const u8` — the str literal ty.
fn rty_strlit(own c: Checker) -> Checker {
    c = rty_prim(c, 0);              // u8
    let e = c.res;
    let i: u64 = 0;
    while i < c.r.rtys.len {
        let t = c.r.rtys.buf[i];
        if t.kind == 16 && t.a == e && t.b == 0 {
            c.res = u32(i);
            return c;
        }
        i = i + 1;
    }
    c.r.rtys = c.r.rtys.push(resolve.RTy {
        kind: 16, name: 0, a: e, b: 0, c: 0, w: 0 });
    c.res = u32(c.r.rtys.len) - 1;
    return c;
}

/// init cert of `k` — 0 absent, 1 def, 2 maybe. Parent-fact lookup:
/// `x.f` is Init iff `x` or `x.f` facts say so (conservative v1:
/// longest-prefix fact wins).
fn init_cert(read c: Checker, k: u32) -> u8 {
    let best: u8 = 0;
    let i: u64 = 0;
    while i < c.init.len {
        let f = c.init.buf[i];
        if f.k == k { return f.cert; }
        // `x.f` inits when `x` is fully Def — a parent Def covers it
        if kprefix(c, f.k, k) == 1 && f.cert == 1 { best = 1; }
        i = i + 1;
    }
    return best;
}

/// consumed state — 0 live, 1 cons, 2 maybe.
// (cons_state above)

/// does `k` hold any out-edge? (Rust: `edges.keys().any(h == k)` —
/// killed edges leave via the retain, so presence is liveness.)
fn live_out_edge(read c: Checker, k: u32) -> u8 {
    let i: u64 = 0;
    while i < c.edges.len {
        if c.edges.buf[i].h == k { return 1; }
        i = i + 1;
    }
    return 0;
}


/// ek_num — EK discriminant (match-only enum dispatch).
pub fn ek_num(read k: ast.EK) -> u8 {
    match k {
        Int => { return 0; }
        Bool => { return 1; }
        Var => { return 2; }
        Str => { return 3; }
        Unary => { return 4; }
        Bin => { return 5; }
        Call => { return 6; }
        Field => { return 7; }
        Index => { return 8; }
        IndexRange => { return 9; }
        StructLit => { return 10; }
        AddrOf => { return 11; }
        Handle => { return 12; }
        Spawn => { return 13; }
        Join => { return 14; }
        Mutex => { return 15; }
        Deref => { return 16; }
        Alloc => { return 17; }
        Sizeof => { return 18; }
        MethodCall => { return 19; }
        AssocFn => { return 20; }
        Try => { return 21; }
        Match => { return 22; }
    }
}

/// sk_num — SK discriminant.
pub fn sk_num(read k: ast.SK) -> u8 {
    match k {
        Let => { return 0; }
        Assign => { return 1; }
        Return => { return 2; }
        If => { return 3; }
        While => { return 4; }
        Break => { return 5; }
        Continue => { return 6; }
        Expr => { return 7; }
        Match => { return 8; }
        Region => { return 9; }
        Promote => { return 10; }
        Consume => { return 11; }
        Defer => { return 12; }
    }
}

/// `k` is under `root` (equal or `./[` descendant).
fn key_under(read c: Checker, k: u32, root: u32) -> u8 {
    return kprefix(c, root, k);
}

/// place identity — Var/Field/Index path → key | NONE.
/// Handles Deref through a single live edge/cap target.
fn place_id(own c: Checker, read p: ast.Parser, eid: u32) -> Checker {
    let e = xexp(c, p, eid);
    c.res = NONE();
    let kind = ek_num(e.kind);
    let rvn = rv_find(c, eid);
    if kind == 2 || rvn != NONE() {             // Var | $rv temp
        let vn = rvn;
        if vn == NONE() {
            c.r = resolve.intern_pname(c.r, p, e.a);
            vn = c.r.res;
        }
        let bi = bfind(c, vn);
        if i64(bi) < 0 { return c; }
        let b = c.binds.buf[u64(bi)];
        c = key_of(c, vn, b.epoch);
        return c;
    }
    if kind == 7 {                              // Field — `k.f`
        c.r = resolve.intern_pname(c.r, p, e.b);
        let fnid = c.r.res;
        let g = guard_base(c, p, e.a);
        if g == NONE() {
            c = place_id(c, p, e.a);
            if c.res == NONE() { return c; }
            c = key_field(c, c.res, fnid);
        } else {
            c = key_field(c, g, fnid);
        }
        return c;
    }
    if kind == 8 {                              // Index — `k[]`
        let g = guard_base(c, p, e.a);
        if g == NONE() {
            c = place_id(c, p, e.a);
            if c.res == NONE() { return c; }
            c = key_cat(c, c.res, "[]");
        } else {
            c = key_cat(c, g, "[]");
        }
        return c;
    }
    if kind == 9 {                              // IndexRange — `k[..]`
        c = place_id(c, p, e.a);
        if c.res == NONE() { return c; }
        c = key_cat(c, c.res, "[..]");
        return c;
    }
    if kind == 16 {                             // Deref — `*k`
        let ie = p.exps.buf[u64(e.a)];
        if ek_num(ie.kind) == 2 {
            let g = guard_base(c, p, e.a);
            if g != NONE() { c.res = g; return c; }
        }
        c = place_id(c, p, e.a);
        if c.res == NONE() { return c; }
        c = key_pstar(c, c.res);
        return c;
    }
    return c;
}


/// expr_var — Var / lowered $rv temp arm of expr_tv_w.
fn expr_var(own c: Checker, read p: ast.Parser,
            eid: u32) -> Checker {
    let e = xexp(c, p, eid);
    let rvn = rv_find(c, eid);
        let vn = rvn;
        if vn == NONE() {
            c.r = resolve.intern_pname(c.r, p, e.a);
            vn = c.r.res;
        }
        let bi = bfind(c, vn);
        if i64(bi) < 0 {
            let m = vec.Vec<u8>::new(c.heap);
            let m2 = resolve.bputs(m, "undefined variable `");
            let m3 = push_rname(m2, c, vn);
            let m4 = resolve.bputs(m3, "`");
            c = pdiag(c, e.line, e.col, m4.as_slice());
            m4.destroy();
            c = rty_prim(c, 9);              // void
            return c;
        }
        let b = c.binds.buf[u64(bi)];
        c = key_of(c, vn, b.epoch);
        let key = c.res;
        let st = cons_covers(c, key);
        if st != 0 {
            c = use_check(c, p, eid, key);
        } else {
            c = init_state(c, key, b.ty);
            if c.res == 1 {
                let tk = c.r.rtys.buf[u64(b.ty)].kind;
                if (tk == 15 || tk == 17) && b.auth == 0
                    && vhas(c.foreign, key) == 0 {
                    if live_out_edge(c, key) == 0 {
                        let m = vec.Vec<u8>::new(c.heap);
                        let m2 = resolve.bputs(m,
                            "use of moved reference `");
                        let m3 = push_rname(m2, c, vn);
                        let m4 = resolve.bputs(m3, "`");
                        c = pdiag(c, e.line, e.col, m4.as_slice());
                        m4.destroy();
                    }
                } else { if b.auth != 0 {
                    if live_out_edge(c, key) == 0 {
                        let m = vec.Vec<u8>::new(c.heap);
                        let m2 = resolve.bputs(m,
                            "use of moved authority `");
                        let m3 = push_rname(m2, c, vn);
                        let m4 = resolve.bputs(m3, "`");
                        c = pdiag(c, e.line, e.col, m4.as_slice());
                        m4.destroy();
                    }
                    if live_out_edge(c, key) == 1 {
                        c = resolve_place(c, p, eid);
                        let n = c.res4;
                        let i: u64 = 0;
                        while i < u64(n) {
                            let t = c.pstash.buf[i];
                            c = access_check_excl(c, p, eid, t,
                                                  0, key);
                            i = i + 1;
                        }
                    }
                } else {
                    c = place_id(c, p, eid);
                    if c.res != NONE() {
                        c = access_check(c, p, eid, c.res, 0);
                    }
                } }
            }
        }
        // enum-typed: last_tag tracks
        if is_enum_ty(c, b.ty) == 1 {
            let tv = tagv_at(c, key);
            c.has_tag = 1;
            if tv != NONE() { c.tag_v = tv; c.tag_has = 1; }
            else { c.tag_v = NONE(); c.tag_has = 0; }
        }
        c.res = b.ty;
        c.res2 = u32(b.prov_k);
        c.res3 = b.prov_v;
        return c;
}



/// cons_covers — worst ConsState over entries covering `k`
/// (k == cf.k, or k under cf.k's path). Port of Stage-0's
/// consumed_state — `p.a` is covered when `p` was consumed.
fn cons_covers(read c: Checker, k: u32) -> u8 {
    let worst: u8 = 0;
    let i: u64 = 0;
    while i < c.cons.len {
        let cf = c.cons.buf[i];
        if cf.k == k || kprefix(c, cf.k, k) == 1 {
            if worst != 1 { worst = cf.st; }
        }
        i = i + 1;
    }
    return worst;
}

/// use_check — transit, then consumed-state diags (with labels).
fn use_check(own c: Checker, read p: ast.Parser,
             eid: u32, k: u32) -> Checker {
    c = transit_check(c, p, eid, k);
    if c.res == 1 { return c; }
    let st = cons_covers(c, k);
    if st == 0 { return c; }
    let e = xexp(c, p, eid);
    let l0 = c.dlab.len;
    c = consume_labels(c, k);
    let l1 = c.dlab.len;
    let m = vec.Vec<u8>::new(c.heap);
    if st == 1 {
        m = resolve.bputs(m, "use after consume `");
    }
    if st == 2 {
        m = resolve.bputs(m, "use of maybe-consumed `");
    }
    let m2 = tn_into(m, c, p, eid);
    let m3 = m2.push(u8(96));
    c = pdiag_l(c, e.line, e.col, m3.as_slice(), u32(l0), u32(l1));
    m3.destroy();
    return c;
}

/// consume_labels — stage "consumed here" labels for covering facts.
/// Dedup is per-call (Stage-0's `seen` is a call-local Vec) — earlier
/// diags keep their own copies of shared spans.
fn consume_labels(own c: Checker, k: u32) -> Checker {
    let base = c.dlab.len;
    let i: u64 = 0;
    while i < c.cons.len {
        let cf = c.cons.buf[i];
        let covers: u8 = 0;
        if cf.k == k { covers = 1; }
        if covers == 0 && kprefix(c, cf.k, k) == 1 { covers = 1; }
        if covers == 0 && kprefix(c, k, cf.k) == 1 {
            // `[]`-keyed children don't cover their parent
            if kcontains(c, cf.k, "[]") == 0 { covers = 1; }
        }
        if covers == 1 {
            if cf.k != k && kcontains(c, cf.k, "[]") == 1 {
                covers = 0;
            }
        }
        if covers == 1 {
            let j: u64 = 0;
            while j < u64(cf.alen) {
                let l2 = c.atspans.buf[u64(cf.aoff) + j * 2];
                let c2 = c.atspans.buf[u64(cf.aoff) + j * 2 + 1];
                // dedup by span — only against this call's labels
                let seen: u8 = 0;
                let q: u64 = base;
                while q < c.dlab.len {
                    if c.dlab.buf[q].line == l2
                        && c.dlab.buf[q].col == c2 { seen = 1; }
                    q = q + 1;
                }
                if seen == 0 {
                    let m = resolve.bputs(vec.Vec<u8>::new(c.heap),
                                          "consumed here");
                    c = msg(c, m.as_slice());
                    c.dlab = c.dlab.push(CLab {
                        line: l2, col: c2, m0: c.res, m1: c.res2 });
                    m.destroy();
                }
                j = j + 1;
            }
        }
        i = i + 1;
    }
    return c;
}

/// key contains byte-substring `sub` (str literal)?
fn kcontains(read c: Checker, k: u32, sub: str) -> u8 {
    let sp = c.kns.buf[u64(k)];
    let n = u64(sp.len);
    let m = u64(sub.len);
    if m > n { return 0; }
    let i: u64 = 0;
    while i + m <= n {
        let eq: u8 = 1;
        let j: u64 = 0;
        while j < m {
            if c.kbyt.buf[u64(sp.off) + i + j] != u8(sub.bytes[j]) {
                eq = 0;
            }
            j = j + 1;
        }
        if eq == 1 { return 1; }
        i = i + 1;
    }
    return 0;
}

/// pdiag_l — a diag with staged labels [l0, l1).
fn pdiag_l(own c: Checker, line: u32, col: u32, m: slice u8,
           l0: u32, l1: u32) -> Checker {
    c = msg(c, m);
    let m0 = c.res;
    let m1 = c.res2;
    c = err_rec(c, line, col, &c.ebyt.buf[u64(m0)..u64(m1)],
        l0, l1, u32(c.dnote.len), u32(c.dnote.len));
    c.errs = c.errs.push(CDiag {
        line: line, col: col, m0: m0, m1: m1,
        l0: l0, l1: l1, n0: 0, n1: 0 });
    return c;
}

/// expr_tv — the (ty, prov) of `eid` under `want` (NONE = none).
fn expr_tv_w(own c: Checker, read p: ast.Parser, eid: u32,
             want: u32, init_ok: u8) -> Checker {
    let e = xexp(c, p, eid);
    let kind = ek_num(e.kind);
    c.res = 0; c.res2 = 0; c.res3 = 0;
    // N18 — a value read requires definite init; path prefixes eval
    // with init_ok=0 so only the leaf carries the requirement.
    if init_ok == 1 {
        if kind == 2 || kind == 7 || kind == 8 || kind == 16 {
            c = require_init(c, p, eid);
        }
    }
    if kind == 0 {                          // Int
        // adopt want's unatomic int ty; else i32 — range-checked
        if want != NONE() {
            let wid = want;
            let wt = c.r.rtys.buf[u64(wid)];
            if wt.kind == 20 {              // unatomic
                wid = wt.a;
                wt = c.r.rtys.buf[u64(wid)];
            }
            if wt.kind <= 7 {
                let lo: i64 = 0;
                let hi: i64 = 0;
                let chk: u8 = 1;
                if wt.kind == 0 { hi = 255; }
                if wt.kind == 1 { hi = 65535; }
                if wt.kind == 2 { hi = 4294967295; }
                if wt.kind == 3 { hi = 9223372036854775807; }
                if wt.kind == 4 { lo = 0 - 128; hi = 127; }
                if wt.kind == 5 { lo = 0 - 32768; hi = 32767; }
                if wt.kind == 6 {
                    lo = 0 - 2147483648; hi = 2147483647;
                }
                if wt.kind == 7 { chk = 0; }
                if chk == 1 && (e.w < lo || e.w > hi) {
                    let m = vec.Vec<u8>::new(c.heap);
                    let m2 = resolve.bputs(m, "integer literal ");
                    let m3 = loader.bpush_i64(m2, e.w);
                    let m4 = resolve.bputs(m3, " does not fit ");
                    let t1 = push_ty(m4, c, wid);
                    c = t1.c;
                    c = pdiag(c, e.line, e.col, t1.m.as_slice());
                    t1.m.destroy();
                }
                c.res = wid; c.res2 = 0; c.res3 = 0;
                return c;
            }
        }
        c = rty_prim(c, 6);                  // i32 default
        return c;
    }
    if kind == 1 {                          // Bool
        c = rty_prim(c, 8);
        return c;
    }
    if kind == 18 {                         // Sizeof -> u64
        c = rty_prim(c, 3);
        return c;
    }
    if kind == 3 {                          // Str -> *const u8
        c = rty_strlit(c);
        return c;
    }
    let rvn = rv_find(c, eid);
    if kind == 2 || rvn != NONE() {
        return expr_var(c, p, eid);
    }
    if kind == 4 {                          // Unary
        return expr_unary(c, p, eid, want);
    }
    if kind == 5 {                          // Bin
        return expr_bin(c, p, eid, want, init_ok);
    }
    if kind == 7 {                          // Field
        return expr_field(c, p, eid);
    }
    if kind == 8 {                          // Index
        return expr_index(c, p, eid);
    }
    if kind == 10 {                         // StructLit
        return expr_structlit(c, p, eid);
    }
    if kind == 19 {                         // MethodCall — desugar
        return expr_mcall(c, p, eid, want, init_ok);
    }
    if kind == 20 {                         // AssocFn — call or variant
        return expr_assoc(c, p, eid, want, init_ok);
    }
    if kind == 12 {                         // Handle(place)
        return expr_handle(c, p, eid);
    }
    if kind == 15 {                         // Mutex(operand)
        return expr_mutex(c, p, eid);
    }
    if kind == 16 {                         // Deref
        return expr_deref(c, p, eid, init_ok);
    }
    if kind == 17 {                         // Alloc — alloc<T>(a)
        return expr_alloc(c, p, eid);
    }
    if kind == 22 {                         // Match — N28 value
        return check_match2(c, p, e.a, e.b, e.c,
                            e.line, e.col, c.fn_ret, want);
    }
    if kind == 21 {                         // Try — `expr?`
        return expr_try(c, p, eid);
    }
    if kind == 11 {                         // AddrOf
        return expr_addrof(c, p, eid);
    }
    if kind == 9 {                          // bare IndexRange — a
        // range only names storage under `&`/`&mut`
        let e = xexp(c, p, eid);
        let m = vec.Vec<u8>::new(c.heap);
        let m2 = resolve.bputs(m,
            "a range `a[lo..hi]` only names storage under `&`/`&mut` — a slice is a view, not a value");
        c = pdiag(c, e.line, e.col, m2.as_slice());
        m2.destroy();
        c = rty_prim(c, 9); c.res2 = 0; c.res3 = 0;
        return c;
    }
    if kind == 13 {                         // Spawn
        return expr_spawn(c, p, eid);
    }
    if kind == 14 {                         // Join
        return expr_join(c, p, eid);
    }
    if kind == 6 {                          // Call
        c = check_call(c, p, eid, want, init_ok);
        return c;
    }
    // unhandled kinds -> void
    c = rty_prim(c, 9);
    return c;
}

/// expr_unary — Unary arm of expr_tv_w.
fn expr_unary(own c: Checker, read p: ast.Parser, eid: u32, want: u32) -> Checker {
    let e = xexp(c, p, eid);
        let op = e.a;
        // uw — want filtered: neg → signed int, bitnot → int
        let uw: u32 = NONE();
        if want != NONE() {
            let wid = want;
            let wt = c.r.rtys.buf[u64(wid)];
            if wt.kind == 20 {
                wid = wt.a;
                wt = c.r.rtys.buf[u64(wid)];
            }
            if op == 0 && wt.kind >= 4 && wt.kind <= 7 { uw = want; }
            if op == 2 && wt.kind <= 7 { uw = want; }
        }
        // `-LIT` under signed T — magnitude check at the literal
        if op == 0 && uw != NONE() {
            let ie = p.exps.buf[u64(e.b)];
            if ek_num(ie.kind) == 0 {
                let wid = uw;
                let wt = c.r.rtys.buf[u64(wid)];
                if wt.kind == 20 {
                    wid = wt.a;
                    wt = c.r.rtys.buf[u64(wid)];
                }
                let mag: i64 = 0;
                let has: u8 = 1;
                if wt.kind == 4 { mag = 128; }
                if wt.kind == 5 { mag = 32768; }
                if wt.kind == 6 { mag = 2147483648; }
                if wt.kind == 7 { has = 0; }
                if has == 1 && ie.w > mag {
                    let m = vec.Vec<u8>::new(c.heap);
                    let m2 = resolve.bputs(m, "integer literal -");
                    let m3 = loader.bpush_i64(m2, ie.w);
                    let m4 = resolve.bputs(m3, " does not fit ");
                    let t1 = push_ty(m4, c, wid);
                    c = t1.c;
                    c = pdiag(c, ie.line, ie.col, t1.m.as_slice());
                    t1.m.destroy();
                }
                c.res = wid; c.res2 = 0; c.res3 = 0;
                return c;
            }
        }
        c = expr_tv_w(c, p, e.b, uw, 1);
        let t = c.res;
        let tk: u8 = 9;
        if t != NONE() { tk = c.r.rtys.buf[u64(t)].kind; }
        if op == 0 {
            if tk > 7 {
                let m = vec.Vec<u8>::new(c.heap);
                let m2 = resolve.bputs(m,
                    "`-` requires an integer, found ");
                let t1 = push_ty(m2, c, t);
                c = t1.c;
                c = pdiag(c, e.line, e.col, t1.m.as_slice());
                t1.m.destroy();
            }
            c.res = t; c.res2 = 0; c.res3 = 0;
            return c;
        }
        if op == 1 {
            if tk != 8 {
                let m = vec.Vec<u8>::new(c.heap);
                let m2 = resolve.bputs(m, "`!` requires bool, found ");
                let t1 = push_ty(m2, c, t);
                c = t1.c;
                c = pdiag(c, e.line, e.col, t1.m.as_slice());
                t1.m.destroy();
            }
            c = rty_prim(c, 8);
            return c;
        }
        // bitnot
        if tk > 7 {
            let m = vec.Vec<u8>::new(c.heap);
            let m2 = resolve.bputs(m,
                "`~` requires an integer, found ");
            let t1 = push_ty(m2, c, t);
            c = t1.c;
            c = pdiag(c, e.line, e.col, t1.m.as_slice());
            t1.m.destroy();
        }
        c.res = t; c.res2 = 0; c.res3 = 0;
        return c;
}

/// expr_bin — Bin arm of expr_tv_w.
fn expr_bin(own c: Checker, read p: ast.Parser, eid: u32,
            want: u32, init_ok: u8) -> Checker {
    let e = xexp(c, p, eid);
        let op = e.a;
        // `a && b` / `a || b` — b runs only when a's result demands
        // it; b's effects join against the never-ran snapshot.
        if op == 16 || op == 17 {
            c = expr_tv_w(c, p, e.b, NONE(), init_ok);
            let ta = c.res;
            if ta != NONE() {
                if c.r.rtys.buf[u64(ta)].kind != 8 {
                    let m = vec.Vec<u8>::new(c.heap);
                    m = m.push(u8(96));
                    if op == 16 {
                        m = resolve.bputs(m, "&&");
                    } else {
                        m = resolve.bputs(m, "||");
                    }
                    m = resolve.bputs(m,
                        " requires bool operands, found ");
                    let t1 = push_ty(m, c, ta);
                    c = t1.c;
                    c = pdiag(c, e.line, e.col, t1.m.as_slice());
                    t1.m.destroy();
                }
            }
            let sv = bs_take(c);
            c = sv.c;
            let st = sv.bs;
            c = expr_tv_w(c, p, e.c, NONE(), init_ok);
            let tb = c.res;
            if tb != NONE() {
                if c.r.rtys.buf[u64(tb)].kind != 8 {
                    let m = vec.Vec<u8>::new(c.heap);
                    m = m.push(u8(96));
                    if op == 16 {
                        m = resolve.bputs(m, "&&");
                    } else {
                        m = resolve.bputs(m, "||");
                    }
                    m = resolve.bputs(m,
                        " requires bool operands, found ");
                    let t1 = push_ty(m, c, tb);
                    c = t1.c;
                    c = pdiag(c, e.line, e.col, t1.m.as_slice());
                    t1.m.destroy();
                }
            }
            c = join_land(c, st);
            bs_free(st);
            c = rec_joined(c, p, e.line, e.col);
            c = rty_prim(c, 8);
            c.res2 = 0;
            c.res3 = 0;
            return c;
        }
        // cmp (5..10) + logical (16,17) yield bool — nothing forwards.
        let is_cmp: u8 = 0;
        if (op >= 5 && op <= 10) || op == 16 || op == 17 { is_cmp = 1; }
        // iw — want forwarded to literal operands of int-preserving
        // ops (`0 - n` under `i64` types the `0` i64); a shift
        // forwards to the LHS only — the amount is its own integer.
        let iw: u32 = NONE();
        if want != NONE() && is_cmp == 0 {
            let wid = want;
            let wt = c.r.rtys.buf[u64(wid)];
            if wt.kind == 20 {
                wid = wt.a;
                wt = c.r.rtys.buf[u64(wid)];
            }
            if wt.kind <= 7 { iw = want; }
        }
        let bw = iw;
        if op == 11 || op == 12 { bw = NONE(); }
        c = expr_tv_w(c, p, e.b, iw, init_ok);
        let ta = c.res;
        c = expr_tv_w(c, p, e.c, bw, init_ok);
        let tb = c.res;
        let tk: u8 = 99;
        if ta != NONE() { tk = c.r.rtys.buf[u64(ta)].kind; }
        let rk: u8 = 99;
        if tb != NONE() { rk = c.r.rtys.buf[u64(tb)].kind; }
        // `str == str` — value equality; a literal operand adopts
        // `str` through coerce, anything else rejects there.
        if (op == 5 || op == 6) && (tk == 10 || rk == 10) {
            if tk != 10 {
                c = coerce(c, p, tb, e.b, ta);
            } else { if rk != 10 {
                c = coerce(c, p, ta, e.c, tb);
            } }
            c = rty_prim(c, 8);
            return c;
        }
        // Peer-operand propagation: an unadopted literal takes the
        // concrete sibling's type (any pure-literal tree folds).
        // i32 kind = INT_DEFAULT; the const_int guard keeps a
        // non-literal i32 operand from "adopting".
        if tb != NONE() && rk <= 7 && tk == 6 {
            c = const_int(c, p, e.b, tb);
            if c.res5 == 1 {
                c = coerce(c, p, tb, e.b, ta);
                ta = c.res;
                tk = c.r.rtys.buf[u64(ta)].kind;
            }
        }
        if ta != NONE() && tk <= 7 && rk == 6 {
            c = const_int(c, p, e.c, ta);
            if c.res5 == 1 {
                c = coerce(c, p, ta, e.c, tb);
                tb = c.res;
                rk = c.r.rtys.buf[u64(tb)].kind;
            }
        }
        if ta == NONE() || tb == NONE() || tk > 7 || rk > 7 {
            let m = vec.Vec<u8>::new(c.heap);
            let m2 = resolve.bputs(m,
                "arithmetic on non-integers: ");
            let t1 = push_ty(m2, c, ta);
            c = t1.c;
            let m4 = resolve.bputs(t1.m, " and ");
            let t2 = push_ty(m4, c, tb);
            c = t2.c;
            c = pdiag(c, e.line, e.col, t2.m.as_slice());
            t2.m.destroy();
        } else { if !resolve.ty_eq(c.r, ta, tb) {
            let m = vec.Vec<u8>::new(c.heap);
            let m2 = resolve.bputs(m,
                "integer width/sign mismatch: ");
            let t1 = push_ty(m2, c, ta);
            c = t1.c;
            let m4 = resolve.bputs(t1.m, " vs ");
            let t2 = push_ty(m4, c, tb);
            c = t2.c;
            c = pdiag(c, e.line, e.col, t2.m.as_slice());
            t2.m.destroy();
        } }
        // N25A — a constant shift amount must fit the operand's width
        if (op == 11 || op == 12) && ta != NONE() {
            let ce = p.exps.buf[u64(e.c)];
            if ek_num(ce.kind) == 0 {
                let w: i64 = 64;
                if tk == 0 || tk == 4 { w = 8; }
                if tk == 1 || tk == 5 { w = 16; }
                if tk == 2 || tk == 6 { w = 32; }
                if ce.w < 0 || ce.w >= w {
                    let m = vec.Vec<u8>::new(c.heap);
                    let m2 = resolve.bputs(m, "shift amount ");
                    let m3 = loader.bpush_i64(m2, ce.w);
                    let m4 = resolve.bputs(m3,
                        " out of range for ");
                    let t1 = push_ty(m4, c, ta);
                    c = t1.c;
                    let m5 = resolve.bputs(t1.m, " (0..");
                    let m6 = loader.bpush_i64(m5, w);
                    let m7 = m6.push(u8(41));
                    c = pdiag(c, e.line, e.col, m7.as_slice());
                    m7.destroy();
                }
            }
        }
        // N29 — a fully-literal tree folds at the operand type and
        // faces the same bar a bare literal does.
        if is_cmp == 0 && ta != NONE() && tk <= 7
            && resolve.ty_eq(c.r, ta, tb) {
            if op == 3 || op == 4 {
                c = const_int(c, p, e.c, ta);
                if c.res5 == 1 && c.llen == 0 {
                    let m = vec.Vec<u8>::new(c.heap);
                    let m2 = resolve.bputs(m,
                        "division by zero in constant expression");
                    c = pdiag(c, e.line, e.col, m2.as_slice());
                    m2.destroy();
                }
            }
            c = const_int(c, p, eid, ta);
            if c.res5 == 1 {
                let v = c.llen;
                let bad: u8 = 0;
                if tk == 0 { if v < 0 || v > 255 { bad = 1; } }
                if tk == 1 { if v < 0 || v > 65535 { bad = 1; } }
                if tk == 2 { if v < 0 || v > 4294967295 { bad = 1; } }
                if tk == 3 { if v < 0 { bad = 1; } }
                if tk == 4 {
                    if v < 0 - 128 || v > 127 { bad = 1; }
                }
                if tk == 5 {
                    if v < 0 - 32768 || v > 32767 { bad = 1; }
                }
                if tk == 6 {
                    if v < 0 - 2147483648 || v > 2147483647 {
                        bad = 1;
                    }
                }
                if bad == 1 {
                    let m = vec.Vec<u8>::new(c.heap);
                    let m2 = resolve.bputs(m,
                        "constant expression folds to ");
                    let m3 = loader.bpush_i64(m2, v);
                    let m4 = resolve.bputs(m3,
                        ", which does not fit ");
                    let t1 = push_ty(m4, c, ta);
                    c = t1.c;
                    c = pdiag(c, e.line, e.col, t1.m.as_slice());
                    t1.m.destroy();
                }
            }
        }
        if is_cmp == 1 {
            c = rty_prim(c, 8);
            return c;
        }
        c.res = ta;
        c.res2 = 0;
        c.res3 = 0;
        return c;
}

fn expr_field(own c: Checker, read p: ast.Parser, eid: u32) -> Checker {
    let e = xexp(c, p, eid);
        // base is a path prefix — eval with init_ok=0 (N18).
        c = expr_tv_w(c, p, e.a, NONE(), 0);
        let bt = c.res;
        c.r = resolve.intern_pname(c.r, p, e.b);
        let fnid = c.r.res;
        let btn = c.r.rtys.buf[u64(bt)];
        let bs = c.r.rns.buf[u64(fnid)];
        // `.len`/`.ptr` on slice — computed members, not places;
        // their provenance is Unknown (stage-0), not the base's.
        if btn.kind == 17 {
            if u64(bs.len) == 3
                && c.r.rbyt.buf[u64(bs.off)] == u8(108)
                && c.r.rbyt.buf[u64(bs.off) + 1] == u8(101)
                && c.r.rbyt.buf[u64(bs.off) + 2] == u8(110) {
                c = rty_prim(c, 3);
                c.res2 = 0; c.res3 = 0;
                return c;
            }
            if u64(bs.len) == 3
                && c.r.rbyt.buf[u64(bs.off)] == u8(112)
                && c.r.rbyt.buf[u64(bs.off) + 1] == u8(116)
                && c.r.rbyt.buf[u64(bs.off) + 2] == u8(114) {
                c = rty_ptr(c, btn.a, btn.b);
                c.res2 = 0; c.res3 = 0;
                return c;
            }
            let m = vec.Vec<u8>::new(c.heap);
            let m2 = resolve.bputs(m, "no member `.");
            let m3 = resolve.bpush(m2, rns_bytes(c, fnid));
            let m4 = resolve.bputs(m3,
                "` on a slice (has `.len`, `.ptr`)");
            c = pdiag(c, e.line, e.col, m4.as_slice());
            m4.destroy();
            c = rty_prim(c, 9); c.res2 = 0; c.res3 = 0;
            return c;
        }
        if btn.kind == 25 {                     // box slice
            if u64(bs.len) == 3
                && c.r.rbyt.buf[u64(bs.off)] == u8(108)
                && c.r.rbyt.buf[u64(bs.off) + 1] == u8(101)
                && c.r.rbyt.buf[u64(bs.off) + 2] == u8(110) {
                c = rty_prim(c, 3);
                c.res2 = 0; c.res3 = 0;
                return c;
            }
            if u64(bs.len) == 3
                && c.r.rbyt.buf[u64(bs.off)] == u8(112)
                && c.r.rbyt.buf[u64(bs.off) + 1] == u8(116)
                && c.r.rbyt.buf[u64(bs.off) + 2] == u8(114) {
                c = rty_ptr(c, btn.a, 1);
                c.res2 = 0; c.res3 = 0;
                return c;
            }
            let m = vec.Vec<u8>::new(c.heap);
            let m2 = resolve.bputs(m, "no member `.");
            let m3 = resolve.bpush(m2, rns_bytes(c, fnid));
            let m4 = resolve.bputs(m3,
                "` on a box slice (has `.len`, `.ptr`)");
            c = pdiag(c, e.line, e.col, m4.as_slice());
            m4.destroy();
            c = rty_prim(c, 9); c.res2 = 0; c.res3 = 0;
            return c;
        }
        if btn.kind == 10 {                     // str — .len/.bytes
            if u64(bs.len) == 3
                && c.r.rbyt.buf[u64(bs.off)] == u8(108)
                && c.r.rbyt.buf[u64(bs.off) + 1] == u8(101)
                && c.r.rbyt.buf[u64(bs.off) + 2] == u8(110) {
                c = rty_prim(c, 3);
                c.res2 = 0; c.res3 = 0;
                return c;
            }
            if u64(bs.len) == 5
                && c.r.rbyt.buf[u64(bs.off)] == u8(98)
                && c.r.rbyt.buf[u64(bs.off) + 1] == u8(121)
                && c.r.rbyt.buf[u64(bs.off) + 2] == u8(116)
                && c.r.rbyt.buf[u64(bs.off) + 3] == u8(101)
                && c.r.rbyt.buf[u64(bs.off) + 4] == u8(115) {
                c = rty_prim(c, 0);
                let u8t = c.res;
                c = rty_slice(c, u8t, 0);
                c.res2 = 0; c.res3 = 0;
                return c;
            }
            if u64(bs.len) == 3
                && c.r.rbyt.buf[u64(bs.off)] == u8(112)
                && c.r.rbyt.buf[u64(bs.off) + 1] == u8(116)
                && c.r.rbyt.buf[u64(bs.off) + 2] == u8(114) {
                let m = vec.Vec<u8>::new(c.heap);
                let m2 = resolve.bputs(m,
                    "no `.ptr` on `str` — use `s.bytes.ptr` (len-delimited) or `cstr(s)` (NUL-terminated)");
                c = pdiag(c, e.line, e.col, m2.as_slice());
                m2.destroy();
            } else {
                let m = vec.Vec<u8>::new(c.heap);
                let m2 = resolve.bputs(m, "no member `.");
                let m3 = resolve.bpush(m2, rns_bytes(c, fnid));
                let m4 = resolve.bputs(m3,
                    "` on `str` (has `.len`, `.bytes`)");
                c = pdiag(c, e.line, e.col, m4.as_slice());
                m4.destroy();
            }
            c = rty_prim(c, 9); c.res2 = 0; c.res3 = 0;
            return c;
        }
        // enum-typed base: payload access needs the static tag
        let vfty: u32 = NONE();
        if (btn.kind == 12 || btn.kind == 13)
            && is_enum_ty(c, bt) == 1 {
            let ei = edecl_of(c, btn.name);
            if ei != NONE() {
                let ed = c.r.edecls.buf[u64(ei)];
                // instantiated payload tys for a generic enum —
                // `x.Some` on `Maybe<i32>` has field-ty `i32`
                // (Stage-0's enum clone registers a pseudo-struct).
                let fvoff = u64(ed.vs_off);
                if btn.kind == 13 {
                    fvoff = c.r.vars.len;
                    c.r = resolve.subst_variants(
                        c.r, ei, btn.b, btn.c);
                    if c.r.suberr != 0 {
                        fvoff = u64(ed.vs_off);
                    }
                }
                let j: u64 = 0;
                while j < u64(ed.vs_len) {
                    let vd = c.r.vars.buf[fvoff + j];
                    if vd.name == fnid {
                        if vd.ty == NONE() {
                            c = rty_prim(c, 9);
                            vfty = c.res;
                            let m = vec.Vec<u8>::new(c.heap);
                            let m2 = resolve.bputs(m, "variant `");
                            let m3 = resolve.bpush(m2,
                                rns_bytes(c, fnid));
                            let m4 = resolve.bputs(m3, "` of `");
                            let m5 = resolve.bpush(m4,
                                rns_bytes(c, btn.name));
                            let m6 = resolve.bputs(m5,
                                "` carries no payload");
                            c = pdiag(c, e.line, e.col,
                                m6.as_slice());
                            m6.destroy();
                        } else {
                            vfty = vd.ty;
                            c = resolve_place(c, p, e.a);
                            let bi: u64 = 0;
                            while bi < u64(c.res4) {
                                let bk = c.pstash.buf[bi];
                                let tv = tagv_at(c, bk);
                                if tv != fnid {
                                    let m = vec.Vec<u8>::new(
                                        c.heap);
                                    let m2 = resolve.bputs(m,
                                        "cannot access `");
                                    let m3 = resolve.bpush(m2,
                                        rns_bytes(c, fnid));
                                    let m4 = resolve.bputs(m3,
                                        "` payload: active variant is not statically `");
                                    let m5 = resolve.bpush(m4,
                                        rns_bytes(c, fnid));
                                    let m6 = resolve.bputs(m5,
                                        "` — `match` on it first");
                                    c = pdiag(c, e.line, e.col,
                                        m6.as_slice());
                                    m6.destroy();
                                }
                                bi = bi + 1;
                            }
                        }
                    }
                    j = j + 1;
                }
            }
        }
        let fty = vfty;
        if fty == NONE() {
            c = field_ty(c, p, bt, fnid, e.line, e.col);
            fty = c.res;
        }
        // read machinery — place_id → use/holds → moved-view → prov
        let kk: u32 = NONE();
        c = place_id(c, p, eid);
        if c.res != NONE() {
            kk = c.res;
            c = use_check(c, p, eid, kk);
            c = root_guard(c, p, eid);
            if c.res == 1 {
                let gk = c.res2; let gdom = c.res3;
                let gbi = c.res5;
                c = guarded_check(c, p, eid, kk, 0, gk, gdom, gbi);
            } else {
                c = unguarded_check(c, p, eid, kk);
                c = transit_check(c, p, eid, kk);
                c = record_hold(c, kk, 1);
            }
            let mv: u8 = 0;
            let fk = c.r.rtys.buf[u64(fty)].kind;
            if fk == 15 {
                let pv0 = prov_at(c, kk);
                if pv0.pk != 0 && live_out_edge(c, kk) == 0 {
                    mv = 1;
                }
            }
            if fk == 17 {
                if ek_cert(c, kk) != 0 && vhas(c.foreign, kk) == 0
                    && live_out_edge(c, kk) == 0 {
                    mv = 1;
                }
            }
            if mv == 1 {
                let m = vec.Vec<u8>::new(c.heap);
                let m2 = resolve.bputs(m,
                    "use of moved reference `");
                let m3 = tn_into(m2, c, p, eid);
                let m4 = m3.push(u8(96));
                c = pdiag(c, e.line, e.col, m4.as_slice());
                m4.destroy();
            }
            let pv = prov_at(c, kk);
            c.res = fty; c.res2 = u32(pv.pk); c.res3 = pv.pv;
        } else {
            c.res = fty; c.res2 = 0; c.res3 = 0;
        }
        if is_enum_ty(c, fty) == 1 {
            c.has_tag = 1;
            if kk != NONE() {
                let tv = tagv_at(c, kk);
                if tv != NONE() { c.tag_v = tv; c.tag_has = 1; }
                else { c.tag_v = NONE(); c.tag_has = 0; }
            } else { c.tag_v = NONE(); c.tag_has = 0; }
        }
        return c;
    return c;
}

/// expr_index — expr_tv_w's arm, extracted to keep its frame small.
fn expr_index(own c: Checker, read p: ast.Parser, eid: u32) -> Checker {
    let e = xexp(c, p, eid);
        c = expr_tv_w(c, p, e.a, NONE(), 0);
        let bt = c.res;
        let btn = c.r.rtys.buf[u64(bt)];
        // `s[i]` on a `str` rejects — bytes go through `.bytes`
        if btn.kind == 10 {
            let m = vec.Vec<u8>::new(c.heap);
            let m2 = resolve.bputs(m,
                "`str` is not element-indexed — byte access is explicit: `s.bytes[i]`");
            c = pdiag(c, e.line, e.col, m2.as_slice());
            m2.destroy();
            c = rty_prim(c, 9); c.res2 = 0; c.res3 = 0;
            return c;
        }
        c = expr_tv(c, p, e.b);
        let it = c.res;
        let ik = c.r.rtys.buf[u64(it)].kind;
        if ik > 7 {
            let m = vec.Vec<u8>::new(c.heap);
            let m2 = resolve.bputs(m,
                "array index must be an integer, found ");
            let ie2 = p.exps.buf[u64(e.b)];
            let t1 = push_ty(m2, c, it);
            c = t1.c;
            c = pdiag(c, ie2.line, ie2.col, t1.m.as_slice());
            t1.m.destroy();
        }
        if btn.kind == 14 {                     // [T; n]
            let ie = p.exps.buf[u64(e.b)];
            if ek_num(ie.kind) == 0 {
                if ie.w < 0 || ie.w >= i64(btn.w) {
                    let m = vec.Vec<u8>::new(c.heap);
                    let m2 = resolve.bputs(m, "index ");
                    let m3 = resolve.bu32(m2, u64(ie.w));
                    let m4 = resolve.bputs(m3,
                        " out of bounds for [");
                    let m5 = resolve.bu32(m4, btn.w);
                    let m6 = m5.push(u8(93));
                    c = pdiag(c, ie.line, ie.col, m6.as_slice());
                    m6.destroy();
                }
            }
            c = place_id(c, p, eid);
            if c.res != NONE() {
                let k = c.res;
                c = use_check(c, p, eid, k);
                c = root_guard(c, p, eid);
                if c.res == 1 {
                    let gk = c.res2; let gdom = c.res3;
                    let gbi = c.res5;
                    c = guarded_check(c, p, eid, k, 0, gk,
                                      gdom, gbi);
                } else {
                    c = unguarded_check(c, p, eid, k);
                    c = transit_check(c, p, eid, k);
                    c = record_hold(c, k, 1);
                }
                let pv = prov_at(c, k);
                c.res = btn.a; c.res2 = u32(pv.pk);
                c.res3 = pv.pv;
                return c;
            }
            c.res = btn.a; c.res2 = 0; c.res3 = 0;
            return c;
        }
        if btn.kind == 17 || btn.kind == 25 {   // slice | box slice
            let ie = p.exps.buf[u64(e.b)];
            if ek_num(ie.kind) == 0 {
                if ie.w < 0 {
                    let m = vec.Vec<u8>::new(c.heap);
                    let m2 = resolve.bputs(m, "negative index ");
                    let m3 = resolve.bu32(m2, u64(ie.w));
                    let m4 = resolve.bputs(m3, " into a slice");
                    c = pdiag(c, ie.line, ie.col, m4.as_slice());
                    m4.destroy();
                } else {
                    c = slice_len_of(c, p, e.a);
                    if c.llen_has == 1 && ie.w >= c.llen {
                        let m = vec.Vec<u8>::new(c.heap);
                        let m2 = resolve.bputs(m, "index ");
                        let m3 = resolve.bu32(m2, u64(ie.w));
                        let m4 = resolve.bputs(m3,
                            " out of bounds for slice of length ");
                        let m5 = resolve.bu32(m4, u64(c.llen));
                        c = pdiag(c, ie.line, ie.col, m5.as_slice());
                        m5.destroy();
                    }
                }
            }
            c = place_id(c, p, eid);
            if c.res != NONE() {
                c = use_check(c, p, eid, c.res);
            }
            c = path_holders(c, p, eid);
            let hh = clone_u(c.heap, c.hstash);
            c = resolve_place(c, p, eid);
            let n = c.res4;
            let i: u64 = 0;
            while i < u64(n) {
                let t = c.pstash.buf[i];
                i = i + 1;
                c = unguarded_check(c, p, eid, t);
                c = transit_check(c, p, eid, t);
                c = record_hold(c, t, 1);
                // another holder's Write/Own blocks the read
                c = edges_to(c, t);
                let m2 = c.res4;
                let j: u64 = 0;
                while j < u64(m2) {
                    let h = c.pstash.buf[j];
                    j = j + 1;
                    if vhas(hh, h) == 1 { continue; }
                    let fk: u8 = 0; let fbl: u32 = 0;
                    let fbc: u32 = 0;
                    let q: u64 = 0;
                    while q < c.edges.len {
                        let ed = c.edges.buf[q];
                        if ed.h == h && overlap(c, ed.t, t) == 1 {
                            fk = ed.kind; fbl = ed.bl;
                            fbc = ed.bc;
                        }
                        q = q + 1;
                    }
                    if fk == 1 { continue; }
                    let l0 = c.dlab.len;
                    c = born_label(c, h, fk, fbl, fbc);
                    let l1 = c.dlab.len;
                    let m = vec.Vec<u8>::new(c.heap);
                    let m2b = resolve.bputs(m, "cannot read `");
                    let m3 = tn_into(m2b, c, p, eid);
                    let m4 = resolve.bputs(m3,
                        "`: it is mutably borrowed");
                    c = pdiag_l(c, e.line, e.col, m4.as_slice(),
                                u32(l0), u32(l1));
                    m4.destroy();
                    j = u64(m2);
                }
            }
            hh.destroy();
            c.res = btn.a; c.res2 = 1; c.res3 = 0;
            return c;
        }
        // indexing non-array
        let m = vec.Vec<u8>::new(c.heap);
        let m2 = resolve.bputs(m, "indexing non-array ");
        let t1 = push_ty(m2, c, bt);
        c = t1.c;
        c = pdiag(c, e.line, e.col, t1.m.as_slice());
        t1.m.destroy();
        c = rty_prim(c, 9);
        return c;
    return c;
}

/// expr_structlit — expr_tv_w's arm, extracted to keep its frame small.
fn expr_structlit(own c: Checker, read p: ast.Parser, eid: u32) -> Checker {
    let e = xexp(c, p, eid);
        c.r = resolve.intern_pname(c.r, p, e.a);
        let tnid = c.r.res;
        c.r = resolve.qualify_ty(c.r, tnid);
        tnid = c.r.res;
        // an enum name rejects — variants construct with `::V`
        if edecl_of(c, tnid) != NONE() {
            let m = vec.Vec<u8>::new(c.heap);
            let m2 = m.push(u8(96));
            let m3 = resolve.bpush(m2, rns_bytes(c, tnid));
            let m4 = resolve.bputs(m3,
                "` is an enum — construct a variant: `");
            let m5 = resolve.bpush(m4, rns_bytes(c, tnid));
            let m6 = resolve.bputs(m5, "::V(..)`");
            c = pdiag(c, e.line, e.col, m6.as_slice());
            m6.destroy();
            c = rty_prim(c, 9);
            return c;
        }
        let si = sdecl_of(c, tnid);
        if si == NONE() {
            let m = vec.Vec<u8>::new(c.heap);
            let m2 = resolve.bputs(m, "unknown struct `");
            let m3 = resolve.bpush(m2, rns_bytes(c, tnid));
            let m4 = m3.push(u8(96));
            c = pdiag(c, e.line, e.col, m4.as_slice());
            m4.destroy();
            c = rty_prim(c, 9);
            return c;
        }
        let sd = c.r.sdecls.buf[u64(si)];
        // u32s range: [nt, targs..., nf, (name,expr)*]
        let nt = u64(p.u32s.buf[u64(e.b)]);
        // instantiated ty — the resolver's row covers both bare
        // (`T` inferred from field values) and written targs
        let litty: u32 = lits_find(c, e.line, e.col);
        if litty == NONE() { if nt == 0 {
            c = rty_named(c, 12, tnid); litty = c.res;
        } else {
            let t0 = u32(c.r.targs.len);
            let ti: u64 = 0;
            while ti < nt {
                c.r = resolve.cnv_ty(c.r, p,
                    p.u32s.buf[u64(e.b) + 1 + ti]);
                c.r.targs = c.r.targs.push(c.r.res);
                ti = ti + 1;
            }
            c.r = resolve.mk2(c.r, 13, tnid, t0, u32(nt));
            litty = c.r.res;
        } }
        // subst'd field range — decl's own or clone's
        c = sfields_of(c, litty);
        let f0 = c.res; let fn2 = c.res2;
        let nf = u64(p.u32s.buf[u64(e.b) + 1 + nt]);
        // pass 1 — eval fields in WRITTEN order
        let seen = vec.Vec<u32>::new(c.heap);
        let fprovs = vec.Vec<PV>::new(c.heap);   // (k=fnid, pk, pv)
        let litpk: u8 = 1; let litpv: u32 = 0;   // lit_prov = Param
        let any_ref: u8 = 0;
        let i: u64 = 0;
        while i < nf {
            let fpid = p.u32s.buf[u64(e.b) + 2 + nt + i * 2];
            let fe = p.u32s.buf[u64(e.b) + 3 + nt + i * 2];
            i = i + 1;
            c.r = resolve.intern_pname(c.r, p, fpid);
            let fnid = c.r.res;
            if vhas(seen, fnid) == 1 {
                let m = vec.Vec<u8>::new(c.heap);
                let m2 = resolve.bputs(m, "field `");
                let m3 = resolve.bpush(m2, rns_bytes(c, fnid));
                let m4 = resolve.bputs(m3,
                    "` initialized twice in `");
                let m5 = resolve.bpush(m4, rns_bytes(c, tnid));
                let m6 = m5.push(u8(96));
                c = pdiag(c, e.line, e.col, m6.as_slice());
                m6.destroy();
                continue;
            }
            seen = seen.push(fnid);
            let fdty: u32 = NONE();
            let j: u64 = 0;
            while j < u64(fn2) {
                let fd = c.r.sfields.buf[u64(f0) + j];
                if fd.name == fnid { fdty = fd.ty; }
                j = j + 1;
            }
            if fdty == NONE() {
                let m = vec.Vec<u8>::new(c.heap);
                let m2 = resolve.bputs(m, "no field `");
                let m3 = resolve.bpush(m2, rns_bytes(c, fnid));
                let m4 = resolve.bputs(m3, "` on struct `");
                let m5 = resolve.bpush(m4, rns_bytes(c, tnid));
                let m6 = m5.push(u8(96));
                c = pdiag(c, e.line, e.col, m6.as_slice());
                m6.destroy();
            } else {
                c = expr_tv_w(c, p, fe, fdty, 1);
                let got = c.res;
                let gpk = u8(c.res2); let gpv = c.res3;
                fprovs = fprovs.push(
                    PV { k: fnid, pk: gpk, pv: gpv });
                let fee = p.exps.buf[u64(fe)];
                c = coerce(c, p, fdty, fe, got);
                let wk = c.r.rtys.buf[u64(fdty)].kind;
                if wk == 15 || wk == 17 {
                    any_ref = 1;
                    c = jprov(c, litpk, litpv, gpk, gpv);
                    litpk = u8(c.res); litpv = c.res2;
                }
            }
        }
        // missing fields — decl order
        let j: u64 = 0;
        while j < u64(fn2) {
            let fd = c.r.sfields.buf[u64(f0) + j];
            if vhas(seen, fd.name) == 0 {
                let m = vec.Vec<u8>::new(c.heap);
                let m2 = resolve.bputs(m, "missing field `");
                let m3 = resolve.bpush(m2, rns_bytes(c, fd.name));
                let m4 = resolve.bputs(m3, "` in `");
                let m5 = resolve.bpush(m4, rns_bytes(c, tnid));
                let m6 = resolve.bputs(m5, "` literal");
                c = pdiag(c, e.line, e.col, m6.as_slice());
                m6.destroy();
            }
            j = j + 1;
        }
        // lit_* side-channel — field packets ride into the dest place
        let led = vec.Vec<RLE>::new(c.heap);
        let lcp = vec.Vec<RLE2>::new(c.heap);
        i = 0;
        while i < nf {
            let fpid = p.u32s.buf[u64(e.b) + 2 + nt + i * 2];
            let fe = p.u32s.buf[u64(e.b) + 3 + nt + i * 2];
            i = i + 1;
            c.r = resolve.intern_pname(c.r, p, fpid);
            let fnid = c.r.res;
            // rel key = the field name's bytes
            let fsp = c.r.rns.buf[u64(fnid)];
            let i2: u64 = 0;
            while i2 < u64(fsp.len) {
                c.ksc = c.ksc.push(
                    c.r.rbyt.buf[u64(fsp.off) + i2]);
                i2 = i2 + 1;
            }
            let n2 = u64(c.ksc.len);
            c = kin(c, &c.ksc.buf[0..n2]);
            while c.ksc.len > 0 { c.ksc.pop(); }
            let rel = c.res;
            c = push_place_lit(c, p, fe);
            c = consume_owned_src(c, p, fe, e.line, e.col);
            c = refs_of(c, p, fe);
            if c.lrefs_has == 1 {
                let toff = u32(c.ri_to.len);
                let q: u64 = 0;
                while q < c.lrefs_to.len {
                    c.ri_to = c.ri_to.push(c.lrefs_to.buf[q]);
                    q = q + 1;
                }
                c.rinfos = c.rinfos.push(RefInf {
                    toff: toff, tlen: u32(c.ri_to.len) - toff,
                    mut_: c.lrefs_mut, mf: c.lrefs_mf,
                    foreign: c.lrefs_foreign });
                led = led.push(RLE {
                    rel: rel, ri: u32(c.rinfos.len) - 1 });
            }
            // nested literal edges — prefix `f.` onto each rel
            let q: u64 = 0;
            while q < c.lit_edges.len {
                let le2 = c.lit_edges.buf[q];
                c = key_join_rel(c, rel, le2.rel);
                led = led.push(RLE { rel: c.res, ri: le2.ri });
                q = q + 1;
            }
            while c.lit_edges.len > 0 { c.lit_edges.pop(); }
            c = caps_of(c, p, fe);
            if c.lcaps_has == 1 {
                let coff = u32(c.rlc_keys.len);
                let q: u64 = 0;
                while q < c.lcaps.len {
                    c.rlc_keys = c.rlc_keys.push(c.lcaps.buf[q]);
                    q = q + 1;
                }
                lcp = lcp.push(RLE2 {
                    rel: rel, off: coff, len: u32(c.lcaps.len) });
            }
            let q: u64 = 0;
            while q < c.lit_caps.len {
                let lc2 = c.lit_caps.buf[q];
                let coff = u32(c.rlc_keys.len);
                let j2: u64 = 0;
                while j2 < u64(lc2.len) {
                    c.rlc_keys = c.rlc_keys.push(
                        c.rlc_keys.buf[u64(lc2.off) + j2]);
                    j2 = j2 + 1;
                }
                c = key_join_rel(c, rel, lc2.rel);
                lcp = lcp.push(RLE2 {
                    rel: c.res, off: coff, len: lc2.len });
                q = q + 1;
            }
            while c.lit_caps.len > 0 { c.lit_caps.pop(); }
        }
        c.lit_edges.destroy();
        c.lit_edges = led;
        c.lit_caps.destroy();
        c.lit_caps = lcp;
        // last_lit — per-field provs (Unknown where lookup missed),
        // kept only when some field carries a reference
        while c.last_lit.len > 0 { c.last_lit.pop(); }
        if any_ref == 1 {
            i = 0;
            while i < nf {
                let fpid = p.u32s.buf[u64(e.b) + 2 + nt + i * 2];
                i = i + 1;
                c.r = resolve.intern_pname(c.r, p, fpid);
                let fnid = c.r.res;
                let pk: u8 = 0; let pv: u32 = 0;
                let q: u64 = 0;
                while q < fprovs.len {
                    if fprovs.buf[q].k == fnid {
                        pk = fprovs.buf[q].pk;
                        pv = fprovs.buf[q].pv;
                    }
                    q = q + 1;
                }
                let fsp = c.r.rns.buf[u64(fnid)];
                let i2: u64 = 0;
                while i2 < u64(fsp.len) {
                    c.ksc = c.ksc.push(
                        c.r.rbyt.buf[u64(fsp.off) + i2]);
                    i2 = i2 + 1;
                }
                let n2 = u64(c.ksc.len);
                c = kin(c, &c.ksc.buf[0..n2]);
                while c.ksc.len > 0 { c.ksc.pop(); }
                c.last_lit = c.last_lit.push(
                    PV { k: c.res, pk: pk, pv: pv });
            }
        }
        seen.destroy();
        fprovs.destroy();
        // the literal's ty — the canonical (possibly App) rty
        c.res = litty;
        c.res2 = 0; c.res3 = 0;
        if any_ref == 1 {
            c.res2 = u32(litpk); c.res3 = litpv;
        }
        return c;
    return c;
}

/// expr_enumlit — AssocFn arm of expr_tv_w: `E::V` / `E::V(payload)`
/// construction. Mirrors Stage-0's Expr::EnumLit: the payload checks
/// against the variant's declared ty, is consumed into the literal,
/// and its interior facts are re-rooted under the `V` rel so the dest
/// install lands them at `key.V`. The variant rides `tag_v/tag_has`.
fn expr_enumlit(own c: Checker, read p: ast.Parser, eid: u32) -> Checker {
    let e = xexp(c, p, eid);
    c.r = resolve.cnv_ty(c.r, p, e.a);
    let et = c.r.res;
    let ename = c.r.rtys.buf[u64(et)].name;
    c.r = resolve.intern_pname(c.r, p, e.b);
    let vn = c.r.res;
    let edi = edecl_of(c, ename);
    if edi == NONE() {
        let m = vec.Vec<u8>::new(c.heap);
        let m2 = resolve.bputs(m, "unknown enum `");
        let pt_ = push_ty(m2, c, et);
        c = pt_.c;
        let m3 = pt_.m;
        let m4 = m3.push(u8(96));
        c = pdiag(c, e.line, e.col, m4.as_slice());
        m4.destroy();
        c = rty_prim(c, 9);
        c.res2 = 0; c.res3 = 0;
        return c;
    }
    let ed = c.r.edecls.buf[u64(edi)];
    // `ctx.enums` holds only enums visible in this module — a
    // private dep enum resolves in the decl table but can't be
    // named across the boundary. Bare names get the private diag;
    // an instantiated `Hidden<i32>` reads as unknown (Stage-0's
    // private_syms keys the unapplied spelling).
    if ed.prog != c.r.who && ed.pub_ == 0 {
        let etn0 = c.r.rtys.buf[u64(et)];
        if etn0.kind == 12 {
            let m = vec.Vec<u8>::new(c.heap);
            let m2 = m.push(u8(96));
            let m3 = push_rname(m2, c, ename);
            let m4 = resolve.bputs(m3,
                "` is private to its module");
            c = pdiag(c, e.line, e.col, m4.as_slice());
            m4.destroy();
        } else {
            let m = vec.Vec<u8>::new(c.heap);
            let m2 = resolve.bputs(m, "unknown enum `");
            let pt_ = push_ty(m2, c, et);
            c = pt_.c;
            let m3 = pt_.m;
            let m4 = m3.push(u8(96));
            c = pdiag(c, e.line, e.col, m4.as_slice());
            m4.destroy();
        }
        c = rty_prim(c, 9);
        c.res2 = 0; c.res3 = 0;
        return c;
    }
    // instantiated variant range — `Maybe<i32>` substitutes `T := i32`
    let voff = u64(ed.vs_off);
    let vlen = u64(ed.vs_len);
    let etn = c.r.rtys.buf[u64(et)];
    if etn.kind == 13 {
        voff = c.r.vars.len;
        c.r = resolve.subst_variants(c.r, edi, etn.b, etn.c);
        if c.r.suberr != 0 { voff = u64(ed.vs_off); }
    }
    let wt: u32 = NONE();
    let found: u8 = 0;
    let i: u64 = 0;
    while i < vlen {
        let vd = c.r.vars.buf[voff + i];
        if vd.name == vn { wt = vd.ty; found = 1; }
        i = i + 1;
    }
    if found == 0 {
        let m = vec.Vec<u8>::new(c.heap);
        let m2 = resolve.bputs(m, "enum `");
        let pt_ = push_ty(m2, c, et);
        c = pt_.c;
        let m3 = pt_.m;
        let m4 = resolve.bputs(m3, "` has no variant `");
        let m5 = push_rname(m4, c, vn);
        let m6 = m5.push(u8(96));
        c = pdiag(c, e.line, e.col, m6.as_slice());
        m6.destroy();
        c = rty_prim(c, 9);
        c.res2 = 0; c.res3 = 0;
        return c;
    }
    let npay: u64 = u64(e.d);
    let anyref: u8 = 0;
    let lpk: u8 = 0;
    let lpv: u32 = 0;
    if wt != NONE() && npay == 1 {
        let pe = p.u32s.buf[u64(e.c)];
        c = expr_tv_w(c, p, pe, wt, 1);
        let pk = u8(c.res2);
        let pv = c.res3;
        let got = c.res;
        // bare `Maybe::Some(x)` — the tparams are inferred from the
        // payload's ty, then `et` upgrades to the App (Stage-0's
        // ctx.enums lookup sees the clone `Maybe<i32>`).
        if etn.kind == 12 && ed.tps_len > 0 {
            let tps = resolve.tps_slice(c.r, ed.tps_off, ed.tps_len);
            let mx = resolve.RM {
                r: c.r, m: vec.Vec<resolve.MapE>::new(c.r.heap) };
            let mx2 = resolve.match_ty(mx, wt, got, tps);
            tps.destroy();
            c.r = mx2.r;
            let imap = mx2.m;
            let tb = u32(c.r.targs.len);
            let ti: u64 = 0;
            let iok: u8 = 1;
            while ti < u64(ed.tps_len) {
                let tp = c.r.tnids.buf[u64(ed.tps_off) + ti];
                c.r = resolve.map_get(c.r, imap.as_slice(), tp);
                if c.r.res == NONE() { iok = 0; }
                else { c.r.targs = c.r.targs.push(c.r.res); }
                ti = ti + 1;
            }
            imap.destroy();
            if iok == 1 {
                c.r = resolve.mk2(c.r, 13, ename, tb, ed.tps_len);
                et = c.r.res;
                let vb2 = c.r.vars.len;
                c.r = resolve.subst_variants(c.r, edi, tb, ed.tps_len);
                if c.r.suberr == 0 {
                    let i3: u64 = 0;
                    while i3 < u64(ed.vs_len) {
                        let vd3 = c.r.vars.buf[vb2 + i3];
                        if vd3.name == vn { wt = vd3.ty; }
                        i3 = i3 + 1;
                    }
                }
            }
        }
        c = coerce(c, p, wt, pe, got);
        c = push_place_lit(c, p, pe);
        c = consume_owned_src(c, p, pe, e.line, e.col);
        // variant rel key — the variant name's bytes
        let vsp = c.r.rns.buf[u64(vn)];
        let i2: u64 = 0;
        while i2 < u64(vsp.len) {
            c.ksc = c.ksc.push(c.r.rbyt.buf[u64(vsp.off) + i2]);
            i2 = i2 + 1;
        }
        let n2 = u64(c.ksc.len);
        c = kin(c, &c.ksc.buf[0..n2]);
        while c.ksc.len > 0 { c.ksc.pop(); }
        let vrel = c.res;
        // interior facts re-root under `V` — same shape as a
        // struct literal's field packets.
        let led = vec.Vec<RLE>::new(c.heap);
        let lcp = vec.Vec<RLE2>::new(c.heap);
        c = refs_of(c, p, pe);
        if c.lrefs_has == 1 {
            let toff = u32(c.ri_to.len);
            let q: u64 = 0;
            while q < c.lrefs_to.len {
                c.ri_to = c.ri_to.push(c.lrefs_to.buf[q]);
                q = q + 1;
            }
            c.rinfos = c.rinfos.push(RefInf {
                toff: toff, tlen: u32(c.ri_to.len) - toff,
                mut_: c.lrefs_mut, mf: c.lrefs_mf,
                foreign: c.lrefs_foreign });
            led = led.push(RLE {
                rel: vrel, ri: u32(c.rinfos.len) - 1 });
        }
        let q: u64 = 0;
        while q < c.lit_edges.len {
            let le2 = c.lit_edges.buf[q];
            c = key_join_rel(c, vrel, le2.rel);
            led = led.push(RLE { rel: c.res, ri: le2.ri });
            q = q + 1;
        }
        while c.lit_edges.len > 0 { c.lit_edges.pop(); }
        c = caps_of(c, p, pe);
        if c.lcaps_has == 1 {
            let coff = u32(c.rlc_keys.len);
            let q: u64 = 0;
            while q < c.lcaps.len {
                c.rlc_keys = c.rlc_keys.push(c.lcaps.buf[q]);
                q = q + 1;
            }
            lcp = lcp.push(RLE2 {
                rel: vrel, off: coff, len: u32(c.lcaps.len) });
        }
        let q: u64 = 0;
        while q < c.lit_caps.len {
            let lc2 = c.lit_caps.buf[q];
            let coff = u32(c.rlc_keys.len);
            let j2: u64 = 0;
            while j2 < u64(lc2.len) {
                c.rlc_keys = c.rlc_keys.push(
                    c.rlc_keys.buf[u64(lc2.off) + j2]);
                j2 = j2 + 1;
            }
            c = key_join_rel(c, vrel, lc2.rel);
            lcp = lcp.push(RLE2 {
                rel: c.res, off: coff, len: lc2.len });
            q = q + 1;
        }
        while c.lit_caps.len > 0 { c.lit_caps.pop(); }
        c.lit_edges.destroy();
        c.lit_edges = led;
        c.lit_caps.destroy();
        c.lit_caps = lcp;
        // a ref/slice payload — prov rides the bind + last_lit
        let wtn = c.r.rtys.buf[u64(wt)];
        if wtn.kind == 15 || wtn.kind == 17 {
            anyref = 1;
            lpk = pk;
            lpv = pv;
            while c.last_lit.len > 0 { c.last_lit.pop(); }
            c.last_lit = c.last_lit.push(
                PV { k: vrel, pk: pk, pv: pv });
        }
    }
    if wt != NONE() && npay == 0 {
        let m = vec.Vec<u8>::new(c.heap);
        let m2 = resolve.bputs(m, "variant `");
        let m3 = push_rname(m2, c, vn);
        let m4 = resolve.bputs(m3, "` of `");
        let pt_ = push_ty(m4, c, et);
        c = pt_.c;
        let m5 = pt_.m;
        let m6 = resolve.bputs(m5, "` takes a payload");
        c = pdiag(c, e.line, e.col, m6.as_slice());
        m6.destroy();
    }
    if wt == NONE() && npay >= 1 {
        let m = vec.Vec<u8>::new(c.heap);
        let m2 = resolve.bputs(m, "variant `");
        let m3 = push_rname(m2, c, vn);
        let m4 = resolve.bputs(m3, "` of `");
        let pt_ = push_ty(m4, c, et);
        c = pt_.c;
        let m5 = pt_.m;
        let m6 = resolve.bputs(m5, "` takes no payload");
        c = pdiag(c, e.line, e.col, m6.as_slice());
        m6.destroy();
    }
    c.tag_v = vn;
    c.tag_has = 1;
    c.res = et;
    c.res2 = 0;
    c.res3 = 0;
    if anyref == 1 {
        c.res2 = u32(lpk);
        c.res3 = lpv;
    }
    return c;
}

/// expr_alloc — `alloc<T>(a)` / `alloc_slice<T>(a, n)` — a heap
/// storage root whose lifetime ends at `free`, not a scope. The
/// allocator operand must carry the `alloc` token; the result owns
/// `box T`/`box slice T` at the current region.
fn expr_alloc(own c: Checker, read p: ast.Parser, eid: u32) -> Checker {
    let e = xexp(c, p, eid);
    c.r = resolve.cnv_ty(c.r, p, e.a);
    let el = c.r.res;
    c = expr_tv_w(c, p, e.b, NONE(), 0);
    let at = c.res;
    if c.r.rtys.buf[u64(at)].kind != 11 {
        let ae = p.exps.buf[u64(e.b)];
        let m = vec.Vec<u8>::new(c.heap);
        let m2 = resolve.bputs(m,
            "`alloc` takes an `alloc` token (e.g. system_allocator()), found ");
        let pt_ = push_ty(m2, c, at);
        c = pt_.c;
        let m3 = pt_.m;
        c = pdiag(c, ae.line, ae.col, m3.as_slice());
        m3.destroy();
    }
    if e.c == NONE() {
        c = rty_mk_wrap(c, 24, el);
    } else {
        c = expr_tv_w(c, p, e.c, NONE(), 0);
        let nt = c.res;
        let ntn = c.r.rtys.buf[u64(nt)];
        let isint: u8 = 0;
        let k2 = ntn.kind;
        let n2 = ntn;
        if k2 == 20 {
            n2 = c.r.rtys.buf[u64(ntn.a)];
            k2 = n2.kind;
        }
        if k2 <= 7 { isint = 1; }
        if isint == 0 {
            let ae = p.exps.buf[u64(e.c)];
            let m = vec.Vec<u8>::new(c.heap);
            let m2 = resolve.bputs(m,
                "`alloc_slice` count must be an integer, found ");
            let pt_ = push_ty(m2, c, nt);
            c = pt_.c;
            let m3 = pt_.m;
            c = pdiag(c, ae.line, ae.col, m3.as_slice());
            m3.destroy();
        }
        c = rty_mk_wrap(c, 25, el);
    }
    let rt = c.res;
    c.res = rt;
    c.res2 = 2; c.res3 = cur_region(c);
    return c;
}

/// intern_lit — a string literal into the resolver nid table.
fn intern_lit(own c: Checker, s: str) -> Checker {
    let v = vec.Vec<u8>::new(c.heap);
    let v2 = resolve.bputs(v, s);
    c.r = resolve.intern(c.r, v2.as_slice());
    v2.destroy();
    return c;
}

/// result_parts — `Result<T,E>` is a SHAPE: an enum with exactly
/// `Ok(payload)` + `Err(payload)`. res = Ok ty | NONE, res2 = Err ty.
fn result_parts(own c: Checker, ty: u32) -> Checker {
    c.res = NONE();
    c.res2 = NONE();
    let tn = c.r.rtys.buf[u64(ty)];
    let en: u32 = NONE();
    if tn.kind == 12 || tn.kind == 13 { en = tn.name; }
    if en == NONE() { return c; }
    let edi = edecl_of(c, en);
    if edi == NONE() { return c; }
    let ed = c.r.edecls.buf[u64(edi)];
    if ed.vs_len != 2 { return c; }
    let voff = u64(ed.vs_off);
    let vlen = u64(ed.vs_len);
    if tn.kind == 13 {
        voff = c.r.vars.len;
        c.r = resolve.subst_variants(c.r, u32(edi), tn.b, tn.c);
        if c.r.suberr != 0 { voff = u64(ed.vs_off); }
    }
    c = intern_lit(c, "Ok");
    let okn = c.r.res;
    c = intern_lit(c, "Err");
    let ern = c.r.res;
    let okt: u32 = NONE(); let ert: u32 = NONE();
    let i: u64 = 0;
    while i < vlen {
        let vd = c.r.vars.buf[voff + i];
        if vd.ty != NONE() {
            if vd.name == okn { okt = vd.ty; }
            if vd.name == ern { ert = vd.ty; }
        }
        i = i + 1;
    }
    if okt != NONE() && ert != NONE() {
        c.res = okt; c.res2 = ert;
    }
    return c;
}

/// EK::Try — `expr?` desugars to `match expr { Ok(v) => v, Err(e) =>
/// return Err(e) }` (N23). The Ok payload moves out like a `let v =
/// scrut.Ok`; the Err arm's facts are snapshotted, audited like
/// `return` (defers replay, live-own abandon check), and discarded.
fn expr_try(own c: Checker, read p: ast.Parser, eid: u32) -> Checker {
    let e = xexp(c, p, eid);
    c = es(c, "(try @");
    c = eu(c, u64(e.line));
    c = ec(c, u8(58));
    c = eu(c, u64(e.col));
    c = ec(c, u8(41));
    c = rec(c);
    c = expr_tv_w(c, p, e.a, NONE(), 1);
    let st = c.res;
    let sprov_k = u8(c.res2); let sprov_v = c.res3;
    c = result_parts(c, st);
    if c.res == NONE() {
        let m = vec.Vec<u8>::new(c.heap);
        let m2 = resolve.bputs(m,
            "`?` requires a `Result<T,E>` value (an enum with `Ok`/`Err` payloads), found ");
        let t1 = push_ty(m2, c, st);
        c = t1.c;
        c = pdiag(c, e.line, e.col, t1.m.as_slice());
        t1.m.destroy();
        c = rty_prim(c, 9); c.res2 = 0; c.res3 = 0;
        return c;
    }
    let ok_ty = c.res; let err_ty = c.res2;
    if c.task_ret != NONE() {
        c = pdiag_s(c, e.line, e.col,
            "`?` inside `spawn` is not supported — a task's result is not a propagation channel");
    } else {
        // the fn's return must be Result<_, E> with the SAME error ty
        c = result_parts(c, c.fn_ret);
        let ferr = c.res2;
        let ok: u8 = 0;
        if c.res != NONE() && resolve.ty_eq(c.r, ferr, err_ty) { ok = 1; }
        if ok == 0 {
            let m = vec.Vec<u8>::new(c.heap);
            let m2 = resolve.bputs(m, "`?` propagates `Err(");
            let t1 = push_ty(m2, c, err_ty);
            c = t1.c;
            let m3 = resolve.bputs(t1.m,
                ")`, but this function returns `");
            let t2 = push_ty(m3, c, c.fn_ret);
            c = t2.c;
            let m4 = resolve.bputs(t2.m, "`");
            c = pdiag(c, e.line, e.col, m4.as_slice());
            m4.destroy();
        }
    }
    c = resolve_place(c, p, e.a);
    let nkeys = c.res4;
    if nkeys == 0 {
        c.res = ok_ty;
        c.res2 = u32(sprov_k); c.res3 = sprov_v;
        return c;
    }
    let skeys = vec.Vec<u32>::new(c.heap);
    let i: u64 = 0;
    while i < u64(nkeys) {
        skeys = skeys.push(c.pstash.buf[i]);
        i = i + 1;
    }
    c = intern_lit(c, "Ok");
    let okn = c.r.res;
    c = intern_lit(c, "Err");
    let ern = c.r.res;
    let dead_ok: u8 = 1; let dead_err: u8 = 1;
    i = 0;
    while i < skeys.len {
        let tv = tagv_at(c, skeys.buf[i]);
        if tv == NONE() || tv == okn { dead_ok = 0; }
        if tv != okn { dead_err = 0; }
        i = i + 1;
    }
    // The derivation matrix (cap_check's "our own authority" branch)
    // needs the scrutinee's holder set and `scrut.V` display names.
    c = path_holders(c, p, e.a);
    let hh = vec.Vec<u32>::new(c.heap);
    i = 0;
    while i < c.hstash.len {
        hh = hh.push(c.hstash.buf[i]);
        i = i + 1;
    }
    let dn_ok = vec.Vec<u8>::new(c.heap);
    dn_ok = tn_into(dn_ok, c, p, e.a);
    dn_ok = dn_ok.push(u8(46));
    dn_ok = push_rname(dn_ok, c, okn);
    let dn_err = vec.Vec<u8>::new(c.heap);
    dn_err = tn_into(dn_err, c, p, e.a);
    dn_err = dn_err.push(u8(46));
    dn_err = push_rname(dn_err, c, ern);
    // ---- err-path — snapshot, audit, discard ----
    let sv_cons = clone_cf(c.heap, c.cons);
    let sv_edges = clone_e2(c.heap, c.edges);
    let sv_ekills = clone_me2(c.heap, c.ekills);
    let sv_holds = clone_km(c.heap, c.holds);
    let sv_dres = clone_dr(c.heap, c.dres);
    c = es(c, "(err-path)");
    c = rec(c);
    i = 0;
    while i < skeys.len {
        c = tag_set(c, skeys.buf[i], ern);
        i = i + 1;
    }
    // consume_owned_src(scrut.Err) — the propagation move is checked
    // exactly like an Ok-arm payload move, then thrown away.
    i = 0;
    while i < skeys.len {
        c = try_consume(c, skeys.buf[i], ern, err_ty,
                        e.line, e.col, hh, dn_err);
        i = i + 1;
    }
    if dead_err == 0 && c.terminated == 0 && c.task_ret == NONE() {
        c = replay_all_defers(c, p);
        let all = vec.Vec<KK>::new(c.heap);
        let j: u64 = 0;
        while j < c.bnames.len {
            all = all.push(c.bnames.buf[j]);
            j = j + 1;
        }
        c = flag_abandoned(c, all, e.line, e.col, 1,
                           "this `?` can return");
    }
    c.cons.destroy(); c.cons = sv_cons;
    c.edges.destroy(); c.edges = sv_edges;
    c.ekills.destroy(); c.ekills = sv_ekills;
    c.holds.destroy(); c.holds = sv_holds;
    c.dres.destroy(); c.dres = sv_dres;
    // ---- ok-path — persists: tag refines, payload moves out ----
    c = es(c, "(ok-path)");
    c = rec(c);
    i = 0;
    while i < skeys.len {
        c = tag_set(c, skeys.buf[i], okn);
        i = i + 1;
    }
    // expr_tv(scrut.Ok) — base hold per resolved scrutinee key, leaf
    // hold at the place_id payload path (same key for a var scrutinee).
    i = 0;
    while i < skeys.len {
        c = record_hold(c, skeys.buf[i], 1);
        i = i + 1;
    }
    c = place_id(c, p, e.a);
    let pidk = c.res;
    if pidk != NONE() {
        c = key_field(c, pidk, okn);
        pidk = c.res;
        c = record_hold(c, pidk, 1);
    }
    i = 0;
    while i < skeys.len {
        c = try_consume(c, skeys.buf[i], okn, ok_ty,
                        e.line, e.col, hh, dn_ok);
        i = i + 1;
    }
    if dead_ok == 1 {
        c.diverged = 1;
        c = rec_flags(c);
    }
    skeys.destroy();
    hh.destroy();
    dn_ok.destroy(); dn_err.destroy();
    let got = ok_ty;
    if got == NONE() { c = rty_prim(c, 9); got = c.res; }
    c.res = got;
    if pidk == NONE() {
        c.res2 = u32(sprov_k); c.res3 = sprov_v;
    } else {
        let pv = prov_at(c, pidk);
        c.res2 = u32(pv.pk); c.res3 = pv.pv;
    }
    // enum Ok payload propagates its tag as last_tag
    if is_enum_ty(c, got) == 1 {
        c.tag_has = 1;
        c.tag_v = tagv_at(c, pidk);
    }
    return c;
}

/// try_consume — the key-level `consume_owned_src` the synthesized
/// `scrut.V` field carries: a payload embedding own authority is held
/// Own, derivation-checked, consumed, killed, and its holder edges
/// dropped; anything else copies silently. `hh` holds the scrutinee's
/// holder keys (cap_check's "our own authority" set); `dn` is the
/// `scrut.V` display name.
fn try_consume(own c: Checker, k: u32, vn: u32, pt: u32,
               line: u32, col: u32, read hh: vec.Vec<u32>,
               read dn: vec.Vec<u8>) -> Checker {
    c = key_field(c, k, vn);
    let pk2 = c.res;
    let ptn = c.r.rtys.buf[u64(pt)];
    let owns: u8 = 0;
    if ptn.kind == 24 || ptn.kind == 25 { owns = 1; }
    if owns == 0
        && (ptn.kind == 12 || ptn.kind == 13 || ptn.kind == 14) {
        c = live_own_at(c, pk2, pt);
        if c.res != NONE() { owns = 1; }
        let j: u64 = 0;
        while owns == 0 && j < c.edges.len {
            let eh = c.edges.buf[j].h;
            if eh != pk2 && kprefix(c, pk2, eh) == 1 { owns = 1; }
            j = j + 1;
        }
        j = 0;
        while owns == 0 && j < c.caps.len {
            let ch = c.caps.buf[j].h;
            if ch != pk2 && kprefix(c, pk2, ch) == 1 { owns = 1; }
            j = j + 1;
        }
    }
    if owns == 1 {
        c = record_hold(c, pk2, 3);
        // cap_check's derivation matrix — an own transfer through a
        // holder's non-Own edge is a diag (e.g. `read` param borrow).
        let i: u64 = 0;
        while i < c.edges.len {
            let ed = c.edges.buf[i];
            if vhas(hh, ed.h) == 1 && overlap(c, ed.t, pk2) == 1
                && ed.kind != 3 {
                let m = vec.Vec<u8>::new(c.heap);
                m = resolve.bputs(m,
                    "cannot transfer own authority through a borrow of `");
                let j2: u64 = 0;
                while j2 < dn.len {
                    m = m.push(dn.buf[j2]);
                    j2 = j2 + 1;
                }
                m = m.push(u8(96));
                c = pdiag(c, line, col, m.as_slice());
                m.destroy();
            }
            i = i + 1;
        }
        c = cons1(c, pk2, 1, line, col);
        c = kill_set(c, pk2, 1);
        c = edges_retain_holder(c, pk2);
    }
    return c;
}

/// EK::Handle — identity edge over a place; no authority.
fn expr_handle(own c: Checker, read p: ast.Parser,
                eid: u32) -> Checker {
    let e = xexp(c, p, eid);
    c = builtin_shadow(c, "handle", e.line, e.col);
    let pe = p.exps.buf[u64(e.a)];
    let pk = ek_num(pe.kind);
    // place_operand materialized the operand — it IS `Var($rvN)`
    if rv_find(c, e.a) != NONE() { pk = 2; }
    if pk != 2 && pk != 7 && pk != 8 && pk != 16 {
        let m = vec.Vec<u8>::new(c.heap);
        let m2 = resolve.bputs(m,
            "`handle` requires a place (a variable or path)");
        c = pdiag(c, e.line, e.col, m2.as_slice());
        m2.destroy();
        c = rty_prim(c, 9); c.res2 = 0; c.res3 = 0;
        return c;
    }
    c = place_tv(c, p, e.a);
    let pt = c.res;
    let i: u64 = 0;
    while i < c.r.rtys.len {
        let t = c.r.rtys.buf[i];
        if t.kind == 18 && t.a == pt {
            c.res = u32(i); c.res2 = 0; c.res3 = 0;
            return c;
        }
        i = i + 1;
    }
    c.r.rtys = c.r.rtys.push(resolve.RTy {
        kind: 18, name: 0, a: pt, b: 0, c: 0, w: 0 });
    c.res = u32(c.r.rtys.len) - 1;
    c.res2 = 0; c.res3 = 0;
    return c;
    return c;
}

/// EK::Deref — read through ref/box/guard/handle.
fn expr_deref(own c: Checker, read p: ast.Parser,
               eid: u32, init_ok: u8) -> Checker {
    let e = xexp(c, p, eid);
    // `*r` liveness rides on the inner eval: Var/path reads of a
    // moved or uninit reference are diagnosed there already.
    c = expr_tv_w(c, p, e.a, NONE(), init_ok);
    let bt = c.res;
    let bk = c.res2; let bv = c.res3;
    if bt == NONE() {
        c = rty_prim(c, 9); c.res2 = 0; c.res3 = 0;
        return c;
    }
    let btn = c.r.rtys.buf[u64(bt)];
    if btn.kind == 15 || btn.kind == 24 {
        c.res = btn.a; c.res2 = bk; c.res3 = bv;
        return c;
    }
    if btn.kind == 22 {                 // Guard — domain payload
        c = root_guard(c, p, eid);
        if c.res == 1 {
            let gk = c.res2; let gdom = c.res3;
            let gbi = c.res5;
            c = resolve_place(c, p, eid);
            let n2 = c.res4;
            let i2: u64 = 0;
            while i2 < u64(n2) {
                c = guarded_check(c, p, eid,
                    c.pstash.buf[i2], 0, gk, gdom, gbi);
                i2 = i2 + 1;
            }
        }
        c.res = btn.a; c.res2 = bk; c.res3 = bv;
        return c;
    }
    if btn.kind == 18 {                 // Handle — identity use
        c = stale_check(c, p, e.a, e.line, e.col);
        c = resolve_place(c, p, eid);
        let n2 = c.res4;
        let i2: u64 = 0;
        while i2 < u64(n2) {
            c = access_check(c, p, eid, c.pstash.buf[i2], 0);
            i2 = i2 + 1;
        }
        c.res = btn.a; c.res2 = 1; c.res3 = 0;
        return c;
    }
    let m = vec.Vec<u8>::new(c.heap);
    let m2 = resolve.bputs(m,
        "`*` requires a reference, found ");
    let t1 = push_ty(m2, c, bt);
    c = t1.c;
    c = push_err(c, e.line, e.col, t1.m.as_slice());
    t1.m.destroy();
    c = rty_prim(c, 9); c.res2 = 0; c.res3 = 0;
    return c;
    return c;
}

/// EK::AddrOf — `&[mut] place` -> `&T` + cap_check.
fn expr_addrof(own c: Checker, read p: ast.Parser,
               eid: u32) -> Checker {
    let e = xexp(c, p, eid);
    let pe = p.exps.buf[u64(e.b)];
    let pk = ek_num(pe.kind);
    // place_operand materialized the operand — it IS `Var($rvN)`
    if rv_find(c, e.b) != NONE() { pk = 2; }
    if pk != 2 && pk != 7 && pk != 8 && pk != 9 && pk != 16 {
        let m = vec.Vec<u8>::new(c.heap);
        let m2 = resolve.bputs(m,
            "`&` requires a place (a variable or path)");
        c = pdiag(c, e.line, e.col, m2.as_slice());
        m2.destroy();
        c = rty_prim(c, 9); c.res2 = 0; c.res3 = 0;
        return c;
    }
    // `&*p`/`&b[i]` read the base to compute the address.
    c = require_place_bases(c, p, e.b);
    if pk == 9 {
        // `&a[lo..hi]` / `&mut a[lo..hi]` — a `slice` view: the
        // binding's edge onto the base's keys IS the span's
        // authority, so `s[i]` rides the ordinary borrow rules.
        c = place_tv(c, p, pe.a);
        let bt = c.res;
        let btk: u8 = 99;
        if bt != NONE() { btk = c.r.rtys.buf[u64(bt)].kind; }
        let elem: u32 = NONE();
        let arrn: i64 = 0;
        let has_n: u8 = 0;
        if btk == 14 {                      // [T; n]
            elem = c.r.rtys.buf[u64(bt)].a;
            arrn = i64(c.r.rtys.buf[u64(bt)].w);
            has_n = 1;
        } else { if btk == 25 {             // box slice T
            elem = c.r.rtys.buf[u64(bt)].a;
        } else { if btk == 17 {             // slice T
            // `&mut` needs a mutable view — a read-only slice has
            // no edge claim to refuse it otherwise, so the TYPE gates.
            if e.a != 0 && c.r.rtys.buf[u64(bt)].b == 0 {
                let m = vec.Vec<u8>::new(c.heap);
                let m2 = resolve.bputs(m,
                    "cannot derive `slice mut` from a read-only view");
                c = pdiag(c, e.line, e.col, m2.as_slice());
                m2.destroy();
            }
            elem = c.r.rtys.buf[u64(bt)].a;
        } else {
            let m = vec.Vec<u8>::new(c.heap);
            let m2 = resolve.bputs(m, "cannot slice `");
            let wbt = bt;
            if wbt == NONE() { c = rty_prim(c, 9); wbt = c.res; }
            let t1 = push_ty(m2, c, wbt);
            c = t1.c;
            let m3 = resolve.bputs(t1.m,
                "`: want an array or slice");
            c = pdiag(c, e.line, e.col, m3.as_slice());
            m3.destroy();
            c = rty_prim(c, 9); c.res2 = 0; c.res3 = 0;
            return c;
        }}}
        // bounds are plain int exprs — `self.len` etc.
        let bi2: u64 = 0;
        while bi2 < 2 {
            let bnd = pe.b;
            if bi2 == 1 { bnd = pe.c; }
            if bnd != NONE() {
                let be = p.exps.buf[u64(bnd)];
                c = expr_tv(c, p, bnd);
                let it = c.res;
                let isint: u8 = 0;
                if it != NONE()
                    && c.r.rtys.buf[u64(it)].kind <= 7 {
                    isint = 1;
                }
                if isint == 0 {
                    let m = vec.Vec<u8>::new(c.heap);
                    let m2 = resolve.bputs(m,
                        "slice bound must be an integer, found ");
                    let wit = it;
                    if wit == NONE() {
                        c = rty_prim(c, 9); wit = c.res;
                    }
                    let t1 = push_ty(m2, c, wit);
                    c = t1.c;
                    c = pdiag(c, be.line, be.col, t1.m.as_slice());
                    t1.m.destroy();
                }
            }
            bi2 = bi2 + 1;
        }
        // provably-invalid ranges die here; dynamic bounds get a
        // runtime check at slice birth.
        let lim: i64 = arrn;
        let lim_has: u8 = has_n;
        if lim_has == 0 {
            c = slice_len_at(c, p, pe.a);
            if c.llen_has == 1 { lim = c.llen; lim_has = 1; }
        }
        if lim_has == 1 {
            // arm split is by bound PRESENCE; each arm then requires
            // Int literal(s) — `a[i..5]` hits the both-present arm
            // and skips the check (stage-0 semantics).
            if pe.b != NONE() && pe.c != NONE() {
                let le = p.exps.buf[u64(pe.b)];
                let he = p.exps.buf[u64(pe.c)];
                if ek_num(le.kind) == 0 && ek_num(he.kind) == 0 {
                if le.w < 0 || he.w < le.w || he.w > lim {
                    let m = vec.Vec<u8>::new(c.heap);
                    let m2 = resolve.bputs(m, "range ");
                    let m3 = loader.bpush_i64(m2, le.w);
                    let m4 = resolve.bputs(m3, "..");
                    let m5 = loader.bpush_i64(m4, he.w);
                    let m6 = resolve.bputs(m5,
                        " out of bounds for length ");
                    let m7 = loader.bpush_i64(m6, lim);
                    c = pdiag(c, he.line, he.col, m7.as_slice());
                    m7.destroy();
                }
                }
            } else { if pe.b != NONE() {
                let le = p.exps.buf[u64(pe.b)];
                if ek_num(le.kind) == 0 {
                if le.w < 0 || le.w > lim {
                    let m = vec.Vec<u8>::new(c.heap);
                    let m2 = resolve.bputs(m, "range ");
                    let m3 = loader.bpush_i64(m2, le.w);
                    let m4 = resolve.bputs(m3,
                        ".. out of bounds for length ");
                    let m5 = loader.bpush_i64(m4, lim);
                    c = pdiag(c, le.line, le.col, m5.as_slice());
                    m5.destroy();
                }
                }
            } else { if pe.c != NONE() {
                let he = p.exps.buf[u64(pe.c)];
                if ek_num(he.kind) == 0 {
                if he.w < 0 || he.w > lim {
                    let m = vec.Vec<u8>::new(c.heap);
                    let m2 = resolve.bputs(m, "range ..");
                    let m3 = loader.bpush_i64(m2, he.w);
                    let m4 = resolve.bputs(m3,
                        " out of bounds for length ");
                    let m5 = loader.bpush_i64(m4, lim);
                    c = pdiag(c, he.line, he.col, m5.as_slice());
                    m5.destroy();
                }
                }
            }}}
        }
        c = place_req(c, p, e.b);
        let pk2 = c.res2; let pv2 = c.res3;
        let rq: u8 = 1;
        if e.a != 0 { rq = 2; }
        c = cap_check(c, p, e.b, rq);
        c = rty_slice(c, elem, u8(e.a));
        c.res2 = pk2; c.res3 = pv2;
        return c;
    }
    c = place_tv(c, p, e.b);
    let pt = c.res;
    c = place_req(c, p, e.b);
    let pk2 = c.res2; let pv2 = c.res3;
    if e.a != 0 {
        c = read_only_slice_hop(c, p, e.b);
        if c.res == 1 {
            let m = vec.Vec<u8>::new(c.heap);
            let m2 = resolve.bputs(m,
                "cannot take `&mut` through a read-only `slice` view");
            c = pdiag(c, e.line, e.col, m2.as_slice());
            m2.destroy();
        }
    }
    let rq: u8 = 1;
    if e.a != 0 { rq = 2; }
    c = cap_check(c, p, e.b, rq);
    let i: u64 = 0;
    while i < c.r.rtys.len {
        let t = c.r.rtys.buf[i];
        if t.kind == 15 && t.a == pt && t.b == e.a {
            c.res = u32(i); c.res2 = pk2; c.res3 = pv2;
            return c;
        }
        i = i + 1;
    }
    c.r.rtys = c.r.rtys.push(resolve.RTy {
        kind: 15, name: 0, a: pt, b: e.a, c: 0, w: 0 });
    c.res = u32(c.r.rtys.len) - 1;
    c.res2 = pk2;
    c.res3 = pv2;
    return c;
    return c;
}
fn expr_tv(own c: Checker, read p: ast.Parser, eid: u32) -> Checker {
    return expr_tv_w(c, p, eid, NONE(), 1);
}

/// access_check — plain place read/write exclusivity.
fn access_check(own c: Checker, read p: ast.Parser,
                eid: u32, k: u32, w: u8) -> Checker {
    return access_check_excl(c, p, eid, k, w, NONE());
}

/// access_check_excl — `excl` holder's own edges don't block the
/// access it authorizes.
fn access_check_excl(own c: Checker, read p: ast.Parser,
                     eid: u32, k: u32, w: u8, excl: u32) -> Checker {
    c = unguarded_check(c, p, eid, k);
    c = transit_check(c, p, eid, k);
    if w == 1 { c = record_hold(c, k, 2); }
    else { c = record_hold(c, k, 1); }
    let e = xexp(c, p, eid);
    c = edges_to(c, k);
    let n = c.res4;
    let i: u64 = 0;
    while i < u64(n) {
        let h = c.pstash.buf[i];
        i = i + 1;
        if h == excl { continue; }
        // find the edge's kind/born for h->~k
        let fk: u8 = 0;
        let fbl: u32 = 0;
        let fbc: u32 = 0;
        let q: u64 = 0;
        while q < c.edges.len {
            let ed = c.edges.buf[q];
            if ed.h == h && overlap(c, ed.t, k) == 1 {
                fk = ed.kind; fbl = ed.bl; fbc = ed.bc;
            }
            q = q + 1;
        }
        // conflict matrix
        let bad: u8 = 0;
        if w == 1 { bad = 1; }
        else {
            if fk == 2 || fk == 3 { bad = 1; }   // Write|Own -> mutably borrowed
            if fk == 4 { bad = 2; }              // Atomic
            if fk == 5 { bad = 3; }              // Sync
        }
        if bad == 0 { continue; }
        let l0 = c.dlab.len;
        c = born_label(c, h, fk, fbl, fbc);
        let l1 = c.dlab.len;
        if task_has(c, h) == 1 {
            let m = vec.Vec<u8>::new(c.heap);
            if w == 1 {
                m = resolve.bputs(m, "cannot write to `");
            } else {
                m = resolve.bputs(m, "cannot read `");
            }
            m = tn_into(m, c, p, eid);
            if fk == 4 {
                m = resolve.bputs(m,
                    "`: atomically held by unjoined task `");
            } else {
                m = resolve.bputs(m,
                    "`: held by unjoined task `");
            }
            m = push_kname(m, c, h);
            m = m.push(u8(96));
            c = pdiag_l(c, e.line, e.col, m.as_slice(),
                        u32(l0), u32(l1));
            m.destroy();
            return c;
        }
        let m = vec.Vec<u8>::new(c.heap);
        if w == 1 {
            m = resolve.bputs(m, "cannot write to `");
            m = tn_into(m, c, p, eid);
            m = resolve.bputs(m, "`: it is borrowed");
        }
        if w == 0 {
            m = resolve.bputs(m, "cannot read `");
            m = tn_into(m, c, p, eid);
            if bad == 1 {
                m = resolve.bputs(m, "`: it is mutably borrowed");
            }
            if bad == 2 {
                m = resolve.bputs(m, "`: atomically held");
            }
            if bad == 3 {
                m = resolve.bputs(m, "`: held by a lock");
            }
        }
        c = pdiag_l(c, e.line, e.col, m.as_slice(), u32(l0), u32(l1));
        m.destroy();
        return c;
    }
    return c;
}

/// born_label — stage the "X borrows it here" label for holder h's
/// edge born at (bl,bc); no-op when bl==0.
fn born_label(own c: Checker, h: u32, kind: u8,
              bl: u32, bc: u32) -> Checker {
    if bl == 0 && bc == 0 { return c; }
    let m = vec.Vec<u8>::new(c.heap);
    if task_has(c, h) == 1 {
        m = resolve.bputs(m, "task `");
        m = push_kname(m, c, h);
        m = resolve.bputs(m, "` claimed it here");
    } else {
        // internal holder (name starts with $)?
        let sp = c.kns.buf[u64(h)];
        let internal: u8 = 0;
        if sp.len > 0 && c.kbyt.buf[u64(sp.off)] == u8(36) {
            internal = 1;
        }
        if internal == 1 {
            if kind == 2 {
                m = resolve.bputs(m, "mutably borrowed here");
            } else {
                m = resolve.bputs(m, "borrowed here");
            }
        } else {
            m = m.push(u8(96));
            m = push_kname(m, c, h);
            if kind == 2 {
                m = resolve.bputs(m, "` mutably borrows it here");
            }
            if kind == 5 {
                m = resolve.bputs(m, "` locked it here");
            }
            if kind == 4 {
                m = resolve.bputs(m,
                    "` claimed it atomically here");
            }
            if kind != 2 && kind != 5 && kind != 4 {
                m = resolve.bputs(m, "` borrows it here");
            }
        }
    }
    c = msg(c, m.as_slice());
    c.dlab = c.dlab.push(CLab {
        line: bl, col: bc, m0: c.res, m1: c.res2 });
    m.destroy();
    return c;
}

/// call checking — `(call)` event + builtin/decl dispatch. v1:
/// emit the event, type the args, return callee ret | void.
/// `$tmp{i}` key — transient per-call arg holder.
fn key_tmp(own c: Checker, i: u32) -> Checker {
    c.ksc = resolve.bputs(c.ksc, "$tmp");
    c.ksc = resolve.bu32(c.ksc, u64(i));
    let n = u64(c.ksc.len);
    c = kin(c, &c.ksc.buf[0..n]);
    while c.ksc.len > 0 { c.ksc.pop(); }
    return c;
}

/// translate_key — `$argN.rest` -> each caller base key + `.rest`.
/// Results land in c.tk_out (empty when k isn't $arg-rooted).
fn tkey(own c: Checker, k: u32) -> Checker {
    while c.tk_out.len > 0 { c.tk_out.pop(); }
    let sp = c.kns.buf[u64(k)];
    if u64(sp.len) < 5 { return c; }
    if c.kbyt.buf[u64(sp.off)] != u8(36)
        || c.kbyt.buf[u64(sp.off) + 1] != u8(97)
        || c.kbyt.buf[u64(sp.off) + 2] != u8(114)
        || c.kbyt.buf[u64(sp.off) + 3] != u8(103) { return c; }
    let i: u64 = 4;
    let n: u32 = 0;
    let nd: u64 = 0;
    while i < u64(sp.len) {
        let d = c.kbyt.buf[u64(sp.off) + i];
        if d < u8(48) || d > u8(57) { break; }
        n = n * 10 + u32(d - u8(48));
        i = i + 1; nd = nd + 1;
    }
    if nd == 0 || u64(n) >= c.cboff.len { return c; }
    let bo = c.cboff.buf[u64(n)];
    let bl = c.cblen.buf[u64(n)];
    let j: u64 = 0;
    while j < u64(bl) {
        let b = c.cbases.buf[u64(bo) + j];
        let bsp = c.kns.buf[u64(b)];
        let q: u64 = 0;
        while q < u64(bsp.len) {
            c.ksc = c.ksc.push(c.kbyt.buf[u64(bsp.off) + q]);
            q = q + 1;
        }
        q = i;
        while q < u64(sp.len) {
            c.ksc = c.ksc.push(c.kbyt.buf[u64(sp.off) + q]);
            q = q + 1;
        }
        let m = u64(c.ksc.len);
        c = kin(c, &c.ksc.buf[0..m]);
        while c.ksc.len > 0 { c.ksc.pop(); }
        c.tk_out = c.tk_out.push(c.res);
        j = j + 1;
    }
    return c;
}

/// apply_kill — Def removes k-subtree edges ((unedge) each,
/// sorted); Maybe weakens in place ((weakedge) each, sorted).
fn apply_kill(own c: Checker, k: u32, cert: u8) -> Checker {
    let ks = vec.Vec<u64>::new(c.heap);
    let i: u64 = 0;
    while i < c.edges.len {
        if kprefix(c, k, c.edges.buf[i].h) == 1 { ks = ks.push(i); }
        i = i + 1;
    }
    i = 1;
    while i < ks.len {
        let x = ks.buf[i];
        let ex = c.edges.buf[u64(u32(x))];
        let j = i;
        while j > 0 {
            let ey = c.edges.buf[u64(u32(ks.buf[j - 1]))];
            let less = u8(0);
            if kless(c, ex.h, ey.h) == 1 { less = 1; }
            else { if ey.h == ex.h { less = kless(c, ex.t, ey.t); } }
            if less == 0 { break; }
            ks.buf[j] = ks.buf[j - 1];
            j = j - 1;
        }
        ks.buf[j] = x;
        i = i + 1;
    }
    if cert == 2 {
        // weaken in place — sorted emit order
        i = 0;
        while i < ks.len {
            let q = ks.buf[i];
            c = es(c, "(weakedge ");
            c = eqs(c, c.edges.buf[q].h);
            c = es(c, " ");
            c = eqs(c, c.edges.buf[q].t);
            c = ec(c, u8(41));
            c = rec(c);
            c.edges.buf[q].cert = 2;
            i = i + 1;
        }
        ks.destroy();
        return c;
    }
    // Def — remove back-to-front
    i = ks.len;
    while i > 0 {
        c = es(c, "(unedge ");
        c = eqs(c, c.edges.buf[ks.buf[i - 1]].h);
        c = es(c, " ");
        c = eqs(c, c.edges.buf[ks.buf[i - 1]].t);
        c = ec(c, u8(41));
        c = rec(c);
        c.edges.swap_remove(ks.buf[i - 1]);
        i = i - 1;
    }
    ks.destroy();
    return c;
}

/// apply_cap_kill — same protocol over caps ((uncap)/(weakcap)).
fn apply_cap_kill(own c: Checker, k: u32, cert: u8) -> Checker {
    let ks = vec.Vec<u64>::new(c.heap);
    let i: u64 = 0;
    while i < c.caps.len {
        if kprefix(c, k, c.caps.buf[i].h) == 1 { ks = ks.push(i); }
        i = i + 1;
    }
    i = 1;
    while i < ks.len {
        let x = ks.buf[i];
        let cx = c.caps.buf[u64(u32(x))];
        let j = i;
        while j > 0 {
            let cy = c.caps.buf[u64(u32(ks.buf[j - 1]))];
            let less = u8(0);
            if kless(c, cx.h, cy.h) == 1 { less = 1; }
            else { if cy.h == cx.h { less = kless(c, cx.t, cy.t); } }
            if less == 0 { break; }
            ks.buf[j] = ks.buf[j - 1];
            j = j - 1;
        }
        ks.buf[j] = x;
        i = i + 1;
    }
    if cert == 2 {
        i = 0;
        while i < ks.len {
            let q = ks.buf[i];
            c = es(c, "(weakcap ");
            c = eqs(c, c.caps.buf[q].h);
            c = es(c, " ");
            c = eqs(c, c.caps.buf[q].t);
            c = ec(c, u8(41));
            c = rec(c);
            c.caps.buf[q].cert = 2;
            i = i + 1;
        }
        ks.destroy();
        return c;
    }
    i = ks.len;
    while i > 0 {
        c = es(c, "(uncap ");
        c = eqs(c, c.caps.buf[ks.buf[i - 1]].h);
        c = es(c, " ");
        c = eqs(c, c.caps.buf[ks.buf[i - 1]].t);
        c = ec(c, u8(41));
        c = rec(c);
        c.caps.swap_remove(ks.buf[i - 1]);
        i = i - 1;
    }
    ks.destroy();
    return c;
}

/// remove edges whose holder is exactly `k` (not the subtree) —
/// `(unedge h t)` per removed, sorted.
fn edges_retain_eq(own c: Checker, k: u32) -> Checker {
    let ks = vec.Vec<u64>::new(c.heap);
    let i: u64 = 0;
    while i < c.edges.len {
        if c.edges.buf[i].h == k { ks = ks.push(i); }
        i = i + 1;
    }
    i = 1;
    while i < ks.len {
        let x = ks.buf[i];
        let ex = c.edges.buf[u64(u32(x))];
        let j = i;
        while j > 0 {
            let ey = c.edges.buf[u64(u32(ks.buf[j - 1]))];
            if kless(c, ex.t, ey.t) == 0 { break; }
            ks.buf[j] = ks.buf[j - 1];
            j = j - 1;
        }
        ks.buf[j] = x;
        i = i + 1;
    }
    i = ks.len;
    while i > 0 {
        c = es(c, "(unedge ");
        c = eqs(c, k);
        c = es(c, " ");
        c = eqs(c, c.edges.buf[ks.buf[i - 1]].t);
        c = ec(c, u8(41));
        c = rec(c);
        c.edges.swap_remove(ks.buf[i - 1]);
        i = i - 1;
    }
    ks.destroy();
    return c;
}

/// sums_get — the fn-name nid's FSum idx (NONE when absent).
fn sums_get(read c: Checker, name: u32) -> u32 {
    let i: u64 = 0;
    while i < c.sums.len {
        if c.sums.buf[i].k == name { return c.sums.buf[i].v; }
        i = i + 1;
    }
    return NONE();
}

/// replay_summary — the callee's $argN-keyed effects through the
/// call's per-arg caller bases. sm_* slots are stored pre-sorted.
/// smap_win — sorted window of a MapE2 summary list. s0's
/// replay_summary sorts kills/cap_kills by key before replay; the
/// sm_* pools keep capture order, so sort a copy here.
fn smap_win(read c: Checker, read v: vec.Vec<MapE2>,
            off: u32, len: u32) -> vec.Vec<MapE2> {
    let w = vec.Vec<MapE2>::new(c.heap);
    let i: u64 = 0;
    while i < u64(len) { w = w.push(v.buf[u64(off) + i]); i = i + 1; }
    i = 1;
    while i < w.len {
        let x = w.buf[i];
        let j = i;
        while j > 0 && kless(c, x.k, w.buf[j - 1].k) == 1 {
            w.buf[j] = w.buf[j - 1];
            j = j - 1;
        }
        w.buf[j] = x;
        i = i + 1;
    }
    return w;
}

/// e2_win — sorted window of an E2 summary list by (h, t).
fn e2_win(read c: Checker, read v: vec.Vec<E2>,
          off: u32, len: u32) -> vec.Vec<E2> {
    let w = vec.Vec<E2>::new(c.heap);
    let i: u64 = 0;
    while i < u64(len) { w = w.push(v.buf[u64(off) + i]); i = i + 1; }
    i = 1;
    while i < w.len {
        let x = w.buf[i];
        let j = i;
        while j > 0 {
            let y = w.buf[j - 1];
            let lt = u8(0);
            if kless(c, x.h, y.h) == 1 { lt = 1; }
            else { if x.h == y.h && kless(c, x.t, y.t) == 1 { lt = 1; } }
            if lt == 0 { break; }
            w.buf[j] = w.buf[j - 1];
            j = j - 1;
        }
        w.buf[j] = x;
        i = i + 1;
    }
    return w;
}

/// c3_win — sorted window of a C3 summary list by (h, t).
fn c3_win(read c: Checker, read v: vec.Vec<C3>,
          off: u32, len: u32) -> vec.Vec<C3> {
    let w = vec.Vec<C3>::new(c.heap);
    let i: u64 = 0;
    while i < u64(len) { w = w.push(v.buf[u64(off) + i]); i = i + 1; }
    i = 1;
    while i < w.len {
        let x = w.buf[i];
        let j = i;
        while j > 0 {
            let y = w.buf[j - 1];
            let lt = u8(0);
            if kless(c, x.h, y.h) == 1 { lt = 1; }
            else { if x.h == y.h && kless(c, x.t, y.t) == 1 { lt = 1; } }
            if lt == 0 { break; }
            w.buf[j] = w.buf[j - 1];
            j = j - 1;
        }
        w.buf[j] = x;
        i = i + 1;
    }
    return w;
}

/// key_win — sorted copy of a rel-key window in sm_keys.
fn key_win(read c: Checker, read v: vec.Vec<u32>,
           off: u32, len: u32) -> vec.Vec<u32> {
    let w = vec.Vec<u32>::new(c.heap);
    let i: u64 = 0;
    while i < u64(len) { w = w.push(v.buf[u64(off) + i]); i = i + 1; }
    return ksort(c, w);
}

fn replay_summary(own c: Checker, fs: FSum,
                  el: u32, ec: u32) -> Checker {
    let wk = smap_win(c, c.sm_kills, fs.koff, fs.klen);
    let i: u64 = 0;
    while i < wk.len {
        let kk = wk.buf[i];
        c = tkey(c, kk.k);
        let j: u64 = 0;
        while j < c.tk_out.len {
            let ck = c.tk_out.buf[j];
            c = kill_set(c, ck, kk.cert);
            c = apply_kill(c, ck, kk.cert);
            j = j + 1;
        }
        i = i + 1;
    }
    wk.destroy();
    let wck = smap_win(c, c.sm_ckills, fs.ckoff, fs.cklen);
    i = 0;
    while i < wck.len {
        let kk = wck.buf[i];
        c = tkey(c, kk.k);
        let j: u64 = 0;
        while j < c.tk_out.len {
            let ck = c.tk_out.buf[j];
            c = capkill_set(c, ck, kk.cert);
            c = apply_cap_kill(c, ck, kk.cert);
            j = j + 1;
        }
        i = i + 1;
    }
    wck.destroy();
    let we = e2_win(c, c.sm_edges, fs.eoff, fs.elen);
    i = 0;
    while i < we.len {
        let ed = we.buf[i];
        c = tkey(c, ed.h);
        while c.tk_out2.len > 0 { c.tk_out2.pop(); }
        let j: u64 = 0;
        while j < c.tk_out.len {
            c.tk_out2 = c.tk_out2.push(c.tk_out.buf[j]);
            j = j + 1;
        }
        j = 0;
        while j < c.tk_out2.len {
            let ch = c.tk_out2.buf[j];
            c = tkey(c, ed.t);
            let q: u64 = 0;
            while q < c.tk_out.len {
                let ct = c.tk_out.buf[q];
                c = edge_set0(c, ch, ct, ed.kind, ed.cert,
                              el, ec, 1);
                // stored-ref prov = target root's owner region
                c = key_root(c, ct);
                let rk = c.res;
                let nn = root_name(c, rk);
                if nn != NONE() {
                    let bi = bfind(c, nn);
                    if i64(bi) >= 0 {
                        let b = c.binds.buf[u64(bi)];
                        c = key_of(c, nn, b.epoch);
                        if c.res == rk {
                            c = prov_set(c, ch, 2, b.owner);
                        }
                    }
                }
                q = q + 1;
            }
            j = j + 1;
        }
        i = i + 1;
    }
    we.destroy();
    let wc = c3_win(c, c.sm_ccaps, fs.coff, fs.clen);
    i = 0;
    while i < wc.len {
        let cp = wc.buf[i];
        c = tkey(c, cp.h);
        while c.tk_out2.len > 0 { c.tk_out2.pop(); }
        let j: u64 = 0;
        while j < c.tk_out.len {
            c.tk_out2 = c.tk_out2.push(c.tk_out.buf[j]);
            j = j + 1;
        }
        j = 0;
        while j < c.tk_out2.len {
            let ch = c.tk_out2.buf[j];
            c = tkey(c, cp.t);
            let q: u64 = 0;
            while q < c.tk_out.len {
                c = cap_set(c, ch, c.tk_out.buf[q], cp.cert);
                q = q + 1;
            }
            j = j + 1;
        }
        i = i + 1;
    }
    wc.destroy();
    let wsy = key_win(c, c.sm_keys, fs.syoff, fs.sylen);
    i = 0;
    while i < wsy.len {
        let dk = wsy.buf[i];
        c = tkey(c, dk);
        let j: u64 = 0;
        while j < c.tk_out.len {
            c = record_hold(c, c.tk_out.buf[j], 5);
            j = j + 1;
        }
        i = i + 1;
    }
    wsy.destroy();
    let wi = key_win(c, c.sm_keys, fs.ioff, fs.ilen);
    i = 0;
    while i < wi.len {
        let ik = wi.buf[i];
        c = tkey(c, ik);
        let j: u64 = 0;
        while j < c.tk_out.len {
            let ck = c.tk_out.buf[j];
            c = init_set(c, ck, 1);
            if k_is_arg(c, ck) == 1 && vhas(c.iw, ck) == 0 {
                c.iw = c.iw.push(ck);
            }
            j = j + 1;
        }
        i = i + 1;
    }
    wi.destroy();
    return c;
}

/// key_alive — liveness for stale-handle audits: root bind exists,
/// epoch-matches, unconsumed. `$arg` roots count as live.
/// res = 1 live | 0 dead.
fn key_alive(own c: Checker, t: u32) -> Checker {
    c = key_root(c, t);
    let rk = c.res;
    if k_is_arg(c, rk) == 1 { c.res = 1; return c; }
    c.res = 0;
    let nn = root_name(c, rk);
    if nn == NONE() { return c; }
    let bi = bfind(c, nn);
    if i64(bi) < 0 { return c; }
    let b = c.binds.buf[u64(bi)];
    c = key_of(c, nn, b.epoch);
    if c.res != rk { c.res = 0; return c; }
    if cons_covers(c, t) != 0 { c.res = 0; return c; }
    c.res = 1;
    return c;
}

/// stale_ts — liveness audit over a target list; one diag at the
/// place's own span when any target is dead. Consumes `ts`.
/// res = 1 when dead.
fn stale_ts(own c: Checker, read p: ast.Parser, tn_eid: u32,
            own ts: vec.Vec<u32>) -> Checker {
    let dead: u8 = 0;
    let i: u64 = 0;
    while i < ts.len {
        c = key_alive(c, ts.buf[i]);
        if c.res == 0 { dead = 1; }
        i = i + 1;
    }
    ts.destroy();
    if dead == 1 {
        let e = p.exps.buf[u64(tn_eid)];
        let m = vec.Vec<u8>::new(c.heap);
        m = resolve.bputs(m, "use of stale handle `");
        m = tn_into(m, c, p, tn_eid);
        m = resolve.bputs(m, "`: its target no longer exists");
        c = pdiag(c, e.line, e.col, m.as_slice());
        m.destroy();
    }
    c.res = u32(dead);
    return c;
}

/// EK::Mutex — `mutex e`. `mutex h` claims the referent's domain;
/// `mutex <value>` protects its own payload. Sets the has_mutex
/// side-channel (roots in glocks[mx_off..mx_off+mx_len]).
fn expr_mutex(own c: Checker, read p: ast.Parser,
             eid: u32) -> Checker {
    let e = xexp(c, p, eid);
    c = builtin_shadow(c, "mutex", e.line, e.col);
    c = expr_tv(c, p, e.a);
    let t = c.res;
    c.has_mutex = 1;
    c.mx_off = u32(c.glocks.len);
    c.mx_len = 0;
    let el: u32 = t;
    if t != NONE() && c.r.rtys.buf[u64(t)].kind == 18 {
        el = c.r.rtys.buf[u64(t)].a;
        c = caps_of(c, p, e.a);
        let ts = vec.Vec<u32>::new(c.heap);
        let i: u64 = 0;
        while i < c.lcaps.len {
            ts = ts.push(c.lcaps.buf[i]);
            c.glocks = c.glocks.push(c.lcaps.buf[i]);
            i = i + 1;
        }
        c.mx_len = u32(c.lcaps.len);
        c = stale_ts(c, p, e.a, ts);
    }
    let w = rty_wrap(c, 21, el);
    if w != NONE() {
        c.res = w;
    } else {
        c.r.rtys = c.r.rtys.push(resolve.RTy {
            kind: 21, name: 0, a: el, b: 0, c: 0, w: 0 });
        c.res = u32(c.r.rtys.len) - 1;
    }
    c.res2 = 0; c.res3 = 0;
    return c;
}

/// dom_held — a live guard in this ctx already claims `dom`.
/// `binds` is append-only — liveness is "still the current binding
/// for its name" (bnames hit), matching Stage-0's scopes scan.
fn dom_held(own c: Checker, dom: u32) -> Checker {
    c.res = 0;
    let i: u64 = 0;
    while i < c.binds.len {
        let b = c.binds.buf[i];
        let live = bfind(c, b.n);
        if live != i64(i) { i = i + 1; continue; }
        i = i + 1;
        if b.guard_dom != dom { continue; }
        c = key_of(c, b.n, b.epoch);
        if cons_covers(c, c.res) == 0 { c.res = 1; return c; }
    }
    c.res = 0;
    return c;
}

/// lock_op — builtin `lock`. Port of check.rs's lock_op: resolves the
/// place to mutex domains, audits existing claims, parks the pending
/// guard tuple in the has_lock side-channel.
pub struct LV { c: Checker, mts: vec.Vec<u32> }

/// lock_place — the `mutex_place` half of lock_op: resolves the arg
/// place to (dom, root, payload) triples. Handle referents are
/// liveness-audited (dead storage still lands in "not mutex
/// storage" via an empty result, matching Stage-0).
fn lock_place(own c: Checker, read p: ast.Parser, pe: u32,
              ptk: u8) -> LV {
    let i: u64 = 0;
    let j: u64 = 0;
    // the place itself when mutex-typed, else referents
    let targets = vec.Vec<u32>::new(c.heap);
    if ptk == 18 {
        c = caps_of(c, p, pe);
        while i < c.lcaps.len {
            targets = targets.push(c.lcaps.buf[i]);
            i = i + 1;
        }
    } else {
        c = resolve_place(c, p, pe);
        if ptk == 15 || ptk == 17 {
            while i < u64(c.res4) {
                let h = c.pstash.buf[i];
                i = i + 1;
                j = 0;
                while j < c.edges.len {
                    let ed = c.edges.buf[j];
                    if ed.h == h && vhas(targets, ed.t) == 0 {
                        targets = targets.push(ed.t);
                    }
                    j = j + 1;
                }
            }
        } else {
            while i < u64(c.res4) {
                targets = targets.push(c.pstash.buf[i]);
                i = i + 1;
            }
            if targets.len == 0 {
                c = place_id(c, p, pe);
                if c.res != NONE() {
                    targets = targets.push(c.res);
                }
            }
        }
    }
    if ptk == 18 {
        let dead: u8 = 0;
        i = 0;
        while i < targets.len {
            c = key_alive(c, targets.buf[i]);
            if c.res == 0 { dead = 1; }
            i = i + 1;
        }
        if dead == 1 {
            let pev = p.exps.buf[u64(pe)];
            let m = vec.Vec<u8>::new(c.heap);
            m = resolve.bputs(m, "use of stale handle `");
            m = tn_into(m, c, p, pe);
            m = resolve.bputs(m,
                "`: its target no longer exists");
            c = pdiag(c, pev.line, pev.col, m.as_slice());
            m.destroy();
            while targets.len > 0 { targets.pop(); }
        }
    }
    // collect mutex domains: (dom, root, payload) triples
    let mts = vec.Vec<u32>::new(c.heap);
    i = 0;
    while i < targets.len {
        let d = targets.buf[i];
        i = i + 1;
        c = mutex_inner(c, p, d);
        if c.res == NONE() { continue; }
        let pay = c.res;
        let root = dom_get(c, d);
        let seen: u8 = 0;
        let q: u64 = 0;
        while q + 2 < mts.len {
            if mts.buf[q] == d { seen = 1; }
            q = q + 3;
        }
        if seen == 0 {
            mts = mts.push(d);
            mts = mts.push(root);
            mts = mts.push(pay);
        }
    }
    targets.destroy();
    return LV { c: c, mts: mts };
}

fn lock_op(own c: Checker, read p: ast.Parser, eid: u32,
           na: u32, nt: u64) -> Checker {
    let e = xexp(c, p, eid);
    let i: u64 = 0;
    let j: u64 = 0;
    if u64(na) != 1 {
        c = pdiag_s(c, e.line, e.col, "`lock` takes 1 argument");
        c = rty_prim(c, 9);
        c.res2 = 0; c.res3 = 0;
        return c;
    }
    let pe = p.u32s.buf[u64(e.b) + 2 + nt];
    let pev = p.exps.buf[u64(pe)];
    let pk = ek_num(pev.kind);
    if pk != 2 && pk != 7 && pk != 8 && pk != 16 {
        c = pdiag_s(c, pev.line, pev.col,
            "`lock` requires a place (a mutex)");
        c = rty_prim(c, 9);
        c.res2 = 0; c.res3 = 0;
        return c;
    }
    c = place_tv(c, p, pe);
    let pt = c.res;
    let ptk: u8 = 9;
    if pt != NONE() { ptk = c.r.rtys.buf[u64(pt)].kind; }
    let lv = lock_place(c, p, pe, ptk);
    c = lv.c;
    let mts = lv.mts;
    if mts.len == 0 {
        let m = vec.Vec<u8>::new(c.heap);
        m = resolve.bputs(m, "cannot lock `");
        m = tn_into(m, c, p, pe);
        m = resolve.bputs(m, "`: not mutex storage");
        c = pdiag(c, e.line, e.col, m.as_slice());
        m.destroy();
        mts.destroy();
        c = rty_prim(c, 9);
        c.res2 = 0; c.res3 = 0;
        return c;
    }
    if mts.len > 3 {
        let m = vec.Vec<u8>::new(c.heap);
        m = resolve.bputs(m, "`lock` on `");
        m = tn_into(m, c, p, pe);
        m = resolve.bputs(m,
            "` is ambiguous: multiple targets");
        c = pdiag(c, e.line, e.col, m.as_slice());
        m.destroy();
        mts.destroy();
        c = rty_prim(c, 9);
        c.res2 = 0; c.res3 = 0;
        return c;
    }
    let dom = mts.buf[0];
    let root = mts.buf[1];
    let pay = mts.buf[2];
    mts.destroy();
    // `lock(m)` IS a use of m — a consumed mutex can't be claimed.
    if cons_covers(c, dom) != 0 {
        let l0 = c.dlab.len;
        c = consume_labels(c, dom);
        let l1 = c.dlab.len;
        let m = vec.Vec<u8>::new(c.heap);
        m = resolve.bputs(m, "use after consume `");
        m = tn_into(m, c, p, pe);
        m = m.push(u8(96));
        c = pdiag_l(c, e.line, e.col, m.as_slice(),
                    u32(l0), u32(l1));
        m.destroy();
    }
    // a `mutex h` domain is only as live as the referent it guards
    if root != dom {
        let ts = vec.Vec<u32>::new(c.heap);
        let ts = ts.push(root);
        c = stale_ts(c, p, pe, ts);
    }
    c = dom_held(c, dom);
    if c.res == 1 {
        let m = vec.Vec<u8>::new(c.heap);
        m = resolve.bputs(m, "mutex `");
        m = push_kname(m, c, dom);
        m = resolve.bputs(m,
            "` is already locked in this context");
        c = pdiag(c, e.line, e.col, m.as_slice());
        m.destroy();
    }
    // the lock borrows THROUGH the arg's holders — their edges onto
    // the domain are the derivation itself, not foreign claims; but
    // a Read edge can't grant interior mutation rights
    c = path_holders(c, p, pe);
    c = edges_to(c, dom);
    let hs = u64(c.res4);
    i = 0;
    while i < hs {
        let h = c.pstash.buf[i];
        i = i + 1;
        if vhas(c.hstash, h) == 1 {
            let fk: u8 = 0;
            j = 0;
            while j < c.edges.len {
                let ed = c.edges.buf[j];
                if ed.h == h && ed.t == dom { fk = ed.kind; }
                j = j + 1;
            }
            if fk == 1 {
                let m = vec.Vec<u8>::new(c.heap);
                m = resolve.bputs(m, "cannot lock `");
                m = tn_into(m, c, p, pe);
                m = resolve.bputs(m,
                    "` through read authority");
                c = pdiag(c, e.line, e.col, m.as_slice());
                m.destroy();
            }
            continue;
        }
        // foreign claim — Sync serializes, anything else races
        let fk: u8 = 0;
        j = 0;
        while j < c.edges.len {
            let ed = c.edges.buf[j];
            if ed.h == h && ed.t == dom { fk = ed.kind; }
            j = j + 1;
        }
        if fk == 5 { continue; }
        let m = vec.Vec<u8>::new(c.heap);
        if task_has(c, h) == 1 {
            m = resolve.bputs(m, "cannot lock `");
            m = tn_into(m, c, p, pe);
            m = resolve.bputs(m,
                "`: held by unjoined task `");
            m = push_kname(m, c, h);
            m = m.push(u8(96));
        } else {
            m = resolve.bputs(m, "cannot lock `");
            m = tn_into(m, c, p, pe);
            m = resolve.bputs(m, "`: it is borrowed");
        }
        c = pdiag(c, e.line, e.col, m.as_slice());
        m.destroy();
    }
    c = record_hold(c, dom, 5);
    // pending guard tuple — the Let site binds it
    c.has_lock = 1;
    c.lock_dom = dom;
    c.lock_root = root;
    c.lock_ty = pay;
    c.lock_off = u32(c.glocks.len);
    c.lock_len = u32(c.hstash.len);
    i = 0;
    while i < c.hstash.len {
        c.glocks = c.glocks.push(c.hstash.buf[i]);
        i = i + 1;
    }
    // Ty::Guard(payload)
    let w = rty_wrap(c, 22, pay);
    if w != NONE() {
        c.res = w;
    } else {
        c.r.rtys = c.r.rtys.push(resolve.RTy {
            kind: 22, name: 0, a: pay, b: 0, c: 0, w: 0 });
        c.res = u32(c.r.rtys.len) - 1;
    }
    c.res2 = 0; c.res3 = 0;
    return c;
}

/// unlock_op — builtin `unlock`. Affine release: the guard token is
/// consumed (double unlock is a double consume), its `g -> domain`
/// edge dies with it.
fn unlock_op(own c: Checker, read p: ast.Parser, eid: u32,
             na: u32, nt: u64) -> Checker {
    let e = xexp(c, p, eid);
    if u64(na) != 1 {
        c = pdiag_s(c, e.line, e.col, "`unlock` takes 1 argument");
        c = rty_prim(c, 9);
        c.res2 = 0; c.res3 = 0;
        return c;
    }
    let pe = p.u32s.buf[u64(e.b) + 2 + nt];
    c = root_guard(c, p, pe);
    if c.res == 1 {
        let gk = c.res2;
        if c.task_ret != NONE() && vhas(c.task_ext, gk) == 1 {
            let m = vec.Vec<u8>::new(c.heap);
            m = resolve.bputs(m, "guard `");
            m = tn_into(m, c, p, pe);
            m = resolve.bputs(m,
                "` cannot cross a spawn boundary");
            c = pdiag(c, e.line, e.col, m.as_slice());
            m.destroy();
            c = rty_prim(c, 9);
            c.res2 = 0; c.res3 = 0;
            return c;
        }
        c = consume_place(c, p, pe);
    } else {
        let m = vec.Vec<u8>::new(c.heap);
        m = resolve.bputs(m, "cannot unlock `");
        m = tn_into(m, c, p, pe);
        m = resolve.bputs(m, "`: not a lock guard");
        c = pdiag(c, e.line, e.col, m.as_slice());
        m.destroy();
    }
    c = rty_prim(c, 9);
    c.res2 = 0; c.res3 = 0;
    return c;
}

/// atomic_op — builtin `atomic_load`/`atomic_store`/`atomic_add`/
/// `compare_exchange`. Port of check.rs's atomic_op.
fn atomic_op(own c: Checker, read p: ast.Parser, eid: u32,
             vn: u32, na: u32, nt: u64) -> Checker {
    let e = xexp(c, p, eid);
    let arity: u32 = 3;
    if nid_lit_eq(c, vn, "atomic_load") { arity = 1; }
    if nid_lit_eq(c, vn, "atomic_store")
        || nid_lit_eq(c, vn, "atomic_add") { arity = 2; }
    let ns = p.names.buf[u64(e.a)];
    let i: u64 = 0;
    let j: u64 = 0;
    if u64(na) != u64(arity) {
        let m = vec.Vec<u8>::new(c.heap);
        m = m.push(u8(96));
        while i < u64(ns.len) {
            m = m.push(p.nbyt.buf[u64(ns.off) + i]);
            i = i + 1;
        }
        m = resolve.bputs(m, "` takes ");
        m = loader.bpush_u64(m, u64(arity));
        m = resolve.bputs(m, " argument(s), got ");
        m = loader.bpush_u64(m, u64(na));
        c = pdiag(c, e.line, e.col, m.as_slice());
        m.destroy();
        c = rty_prim(c, 9);
        c.res2 = 0; c.res3 = 0;
        return c;
    }
    let pe = p.u32s.buf[u64(e.b) + 2 + nt];
    let pev = p.exps.buf[u64(pe)];
    let pk = ek_num(pev.kind);
    if pk != 2 && pk != 7 && pk != 8 && pk != 16 {
        let m = vec.Vec<u8>::new(c.heap);
        m = m.push(u8(96));
        i = 0;
        while i < u64(ns.len) {
            m = m.push(p.nbyt.buf[u64(ns.off) + i]);
            i = i + 1;
        }
        m = resolve.bputs(m,
            "`'s first argument must name a place");
        c = pdiag(c, pev.line, pev.col, m.as_slice());
        m.destroy();
        c = rty_prim(c, 9);
        c.res2 = 0; c.res3 = 0;
        return c;
    }
    c = place_tv(c, p, pe);
    let pt = c.res;
    let ptk: u8 = 9;
    if pt != NONE() { ptk = c.r.rtys.buf[u64(pt)].kind; }
    c = path_holders(c, p, pe);
    let targets = vec.Vec<u32>::new(c.heap);
    if ptk == 18 {
        c = place_id(c, p, pe);
        if c.res != NONE() && vhas(c.hstash, c.res) == 0 {
            c.hstash = c.hstash.push(c.res);
        }
        c = caps_of(c, p, pe);
        while i < c.lcaps.len {
            targets = targets.push(c.lcaps.buf[i]);
            i = i + 1;
        }
    } else {
        c = resolve_place(c, p, pe);
        if ptk == 15 || ptk == 17 {
            while i < u64(c.res4) {
                let h = c.pstash.buf[i];
                i = i + 1;
                j = 0;
                while j < c.edges.len {
                    let ed = c.edges.buf[j];
                    if ed.h == h && vhas(targets, ed.t) == 0 {
                        targets = targets.push(ed.t);
                    }
                    j = j + 1;
                }
            }
        } else {
            while i < u64(c.res4) {
                targets = targets.push(c.pstash.buf[i]);
                i = i + 1;
            }
        }
    }
    // via_caps — handle access or a holder carrying caps
    let via: u8 = 0;
    if ptk == 18 { via = 1; }
    i = 0;
    while i < c.hstash.len {
        let h = c.hstash.buf[i];
        i = i + 1;
        j = 0;
        while j < c.caps.len {
            if c.caps.buf[j].h == h { via = 1; }
            j = j + 1;
        }
    }
    if via == 1 {
        i = 0;
        while i < targets.len {
            let t = targets.buf[i];
            i = i + 1;
            c = key_root(c, t);
            let rk = c.res;
            if k_is_arg(c, rk) == 1 { continue; }
            let nn = root_name(c, rk);
            let alive: u8 = 0;
            if nn != NONE() {
                let bi = bfind(c, nn);
                if i64(bi) >= 0 {
                    let b = c.binds.buf[u64(bi)];
                    c = key_of(c, nn, b.epoch);
                    if c.res == rk && cons_covers(c, t) == 0 {
                        alive = 1;
                    }
                }
            }
            if alive == 1 { continue; }
            let m = vec.Vec<u8>::new(c.heap);
            m = resolve.bputs(m, "use of stale handle `");
            m = tn_into(m, c, p, pe);
            m = resolve.bputs(m,
                "`: its target no longer exists");
            c = pdiag(c, e.line, e.col, m.as_slice());
            m.destroy();
            targets.destroy();
            c = rty_prim(c, 9);
            c.res2 = 0; c.res3 = 0;
            return c;
        }
    }
    let akeys = vec.Vec<u32>::new(c.heap);
    let itys = vec.Vec<u32>::new(c.heap);
    i = 0;
    while i < targets.len {
        c = atomic_inner(c, p, targets.buf[i]);
        if c.res != NONE() {
            akeys = akeys.push(targets.buf[i]);
            itys = itys.push(c.res);
        }
        i = i + 1;
    }
    targets.destroy();
    if akeys.len == 0 {
        let m = vec.Vec<u8>::new(c.heap);
        m = resolve.bputs(m, "non-atomic-op: `");
        m = tn_into(m, c, p, pe);
        m = resolve.bputs(m, "` is not atomic storage");
        c = pdiag(c, e.line, e.col, m.as_slice());
        m.destroy();
        akeys.destroy();
        itys.destroy();
        c = rty_prim(c, 9);
        c.res2 = 0; c.res3 = 0;
        return c;
    }
    i = 0;
    while i < akeys.len {
        let k = akeys.buf[i];
        i = i + 1;
        let gso: u64 = 0;
        let gsl: u64 = 0;
        c = root_guard(c, p, pe);
        if c.res == 1 {
            let gk = c.res2;
            let gbi = c.res5;
            c = use_check(c, p, pe, gk);
            if c.task_ret != NONE() && vhas(c.task_ext, gk) == 1 {
                let m = vec.Vec<u8>::new(c.heap);
                m = resolve.bputs(m, "guard `");
                m = tn_into(m, c, p, pe);
                m = resolve.bputs(m,
                    "` cannot cross a spawn boundary");
                c = pdiag(c, e.line, e.col, m.as_slice());
                m.destroy();
            }
            let gb = c.binds.buf[u64(gbi)];
            gso = u64(gb.goff);
            gsl = u64(gb.glen);
        } else {
            c = unguarded_check(c, p, pe, k);
            c = transit_check(c, p, pe, k);
        }
        c = record_hold(c, k, 4);
        c = edges_to(c, k);
        let hs = u64(c.res4);
        j = 0;
        while j < hs {
            let h = c.pstash.buf[j];
            let skip: u8 = 0;
            if vhas(c.hstash, h) == 1 { skip = 1; }
            let q: u64 = gso;
            while q < gso + gsl {
                if c.glocks.buf[q] == h { skip = 1; }
                q = q + 1;
            }
            if skip == 0 {
                let fk: u8 = 0;
                let q2: u64 = 0;
                while q2 < c.edges.len {
                    let ed = c.edges.buf[q2];
                    if ed.h == h && overlap(c, ed.t, k) == 1 {
                        fk = ed.kind;
                    }
                    q2 = q2 + 1;
                }
                if fk == 4 { skip = 1; }
            }
            if skip == 0 {
                let m = vec.Vec<u8>::new(c.heap);
                m = m.push(u8(96));
                let q2: u64 = 0;
                while q2 < u64(ns.len) {
                    m = m.push(p.nbyt.buf[u64(ns.off) + q2]);
                    q2 = q2 + 1;
                }
                m = resolve.bputs(m, "` on `");
                m = tn_into(m, c, p, pe);
                if task_has(c, h) == 1 {
                    m = resolve.bputs(m,
                        "` races unjoined task `");
                    m = push_kname(m, c, h);
                    m = resolve.bputs(m,
                        "`'s unsynchronized access");
                } else {
                    m = resolve.bputs(m,
                        "` conflicts with a live borrow");
                }
                c = pdiag(c, e.line, e.col, m.as_slice());
                m.destroy();
                j = hs;   // break
            }
            j = j + 1;
        }
    }
    let inner = itys.buf[0];
    akeys.destroy();
    itys.destroy();
    i = 1;
    while i < u64(na) {
        let a = p.u32s.buf[u64(e.b) + 2 + nt + i];
        i = i + 1;
        c = expr_tv(c, p, a);
        let got = c.res;
        c = coerce(c, p, inner, a, got);
    }
    if nid_lit_eq(c, vn, "atomic_add") {
        let ik = c.r.rtys.buf[u64(inner)].kind;
        if ik > 7 {
            let m = vec.Vec<u8>::new(c.heap);
            m = resolve.bputs(m,
                "`atomic_add` requires integer storage, found atomic ");
            let tm = push_ty(m, c, inner);
            c = tm.c;
            let m2 = tm.m;
            c = pdiag(c, e.line, e.col, m2.as_slice());
            m2.destroy();
        }
    }
    if nid_lit_eq(c, vn, "atomic_load") {
        c.res = inner;
        c.res2 = 0;
        c.res3 = 0;
        return c;
    }
    if nid_lit_eq(c, vn, "compare_exchange") {
        return rty_prim(c, 8);
    }
    c = rty_prim(c, 9);
    c.res2 = 0; c.res3 = 0;
    return c;
}

// ---- channels (N12): channel()/send/recv/close -------------------

/// chan_inner — key's ty is `channel T` → res = T | NONE.
fn chan_inner(own c: Checker, read p: ast.Parser, k: u32) -> Checker {
    c = key_ty(c, p, k);
    if c.res == NONE() { return c; }
    let t = c.r.rtys.buf[u64(c.res)];
    if t.kind != 23 { c.res = NONE(); return c; }
    c.res = t.a;
    return c;
}

/// owner_of_key — the region a place key's owner lives in. `$arg`/
/// `*` roots are caller-side (NONE = treated as outliving locals).
fn owner_of_key(own c: Checker, k: u32) -> Checker {
    c = key_root(c, k);
    let rk = c.res;
    if k_is_arg(c, rk) == 1 { c.res = NONE(); return c; }
    let sp = c.kns.buf[u64(rk)];
    if u64(sp.len) > 0 && c.kbyt.buf[u64(sp.off)] == u8(42) {
        c.res = NONE(); return c;
    }
    let nn = root_name(c, rk);
    if nn == NONE() { c.res = NONE(); return c; }
    let bi = bfind(c, nn);
    if i64(bi) < 0 { c.res = NONE(); return c; }
    c.res = c.binds.buf[u64(bi)].owner;
    return c;
}

/// kbstart — raw byte prefix (stage-0's `h.starts_with(&key)`), no
/// path-boundary requirement — `p#1` byte-prefixes `p#10` too.
fn kbstart(read c: Checker, a: u32, b: u32) -> u8 {
    let sa = c.kns.buf[u64(a)];
    let sb = c.kns.buf[u64(b)];
    if sa.len > sb.len { return 0; }
    let i: u64 = 0;
    while i < u64(sa.len) {
        if c.kbyt.buf[u64(sa.off) + i]
            != c.kbyt.buf[u64(sb.off) + i] { return 0; }
        i = i + 1;
    }
    return 1;
}

/// key_rel — `h` extends `k` at byte level: intern the suffix key.
fn key_rel(own c: Checker, h: u32, k: u32) -> Checker {
    let hsp = c.kns.buf[u64(h)];
    let ksp = c.kns.buf[u64(k)];
    let i: u64 = u64(ksp.len);
    while i < u64(hsp.len) {
        c.ksc = c.ksc.push(c.kbyt.buf[u64(hsp.off) + i]);
        i = i + 1;
    }
    let s0 = u64(c.ksc.len);
    c = kin(c, &c.ksc.buf[0..s0]);
    while u64(c.ksc.len) > 0 { c.ksc.pop(); }
    return c;
}

/// key_rel_nd — like key_rel but drops a leading `.` so the rel is
/// `f`-leading (`key_join_rel` re-adds the dot; `[` suffixes pass
/// through). Packet payloads use this convention.
fn key_rel_nd(own c: Checker, h: u32, k: u32) -> Checker {
    let hsp = c.kns.buf[u64(h)];
    let ksp = c.kns.buf[u64(k)];
    let i: u64 = u64(ksp.len);
    if i < u64(hsp.len)
        && c.kbyt.buf[u64(hsp.off) + i] == u8(46) {
        i = i + 1;
    }
    while i < u64(hsp.len) {
        c.ksc = c.ksc.push(c.kbyt.buf[u64(hsp.off) + i]);
        i = i + 1;
    }
    let s0 = u64(c.ksc.len);
    c = kin(c, &c.ksc.buf[0..s0]);
    while u64(c.ksc.len) > 0 { c.ksc.pop(); }
    return c;
}

/// edges_retain_x — `(unedge h t)` per removed edge, dropping only
/// exact holder `k` (no subtree). packet_for's derivation-source
/// kill; stage-0's `edges_retain(|(h,_),_| h != &src)`.
fn edges_retain_x(own c: Checker, k: u32) -> Checker {
    let ks = vec.Vec<u64>::new(c.heap);
    let i: u64 = 0;
    while i < c.edges.len {
        if c.edges.buf[i].h == k { ks = ks.push(i); }
        i = i + 1;
    }
    i = 1;
    while i < ks.len {
        let x = ks.buf[i];
        let ex = c.edges.buf[u64(u32(x))];
        let j = i;
        while j > 0 {
            let ey = c.edges.buf[u64(u32(ks.buf[j - 1]))];
            let less: u8 = 0;
            if kless(c, ex.h, ey.h) == 1 { less = 1; }
            else { if ey.h == ex.h { less = kless(c, ex.t, ey.t); } }
            if less == 0 { break; }
            ks.buf[j] = ks.buf[j - 1];
            j = j - 1;
        }
        ks.buf[j] = x;
        i = i + 1;
    }
    i = 0;
    while i < ks.len {
        let e = c.edges.buf[u64(u32(ks.buf[i]))];
        c = es(c, "(unedge ");
        c = eqs(c, e.h);
        c = ec(c, u8(32));
        c = eqs(c, e.t);
        c = ec(c, u8(41));
        c = rec(c);
        i = i + 1;
    }
    let w = vec.Vec<E2>::new(c.heap);
    i = 0;
    while i < c.edges.len {
        if c.edges.buf[i].h != k { w = w.push(c.edges.buf[i]); }
        i = i + 1;
    }
    let d = c.edges; d.destroy();
    c.edges = w;
    ks.destroy();
    return c;
}

/// chan_place — resolve a channel argument to endpoint keys: the
/// place itself when channel-typed, else its referent (`send(hc,..)`
/// through a handle names ch's endpoint, not hc's). res4 = count,
/// keys in pstash.
fn chan_place(own c: Checker, read p: ast.Parser, eid: u32) -> Checker {
    while c.pstash.len > 0 { c.pstash.pop(); }
    c.res4 = 0;
    c = place_tv(c, p, eid);
    let pt = c.res;
    let is_h: u8 = 0;
    if pt != NONE() && c.r.rtys.buf[u64(pt)].kind == 18 { is_h = 1; }
    let ts = vec.Vec<u32>::new(c.heap);
    if is_h == 1 {
        c = caps_of(c, p, eid);
        let i: u64 = 0;
        while i < c.lcaps.len {
            ts = ts.push(c.lcaps.buf[i]);
            i = i + 1;
        }
    } else {
        c = resolve_place(c, p, eid);
        let i: u64 = 0;
        while i < u64(c.res4) {
            ts = ts.push(c.pstash.buf[i]);
            i = i + 1;
        }
        if ts.len == 0 {
            c = place_id(c, p, eid);
            if c.res != NONE() { ts = ts.push(c.res); }
        }
    }
    if is_h == 1 && ts.len > 0 {
        let t2 = clone_u(c.heap, ts);
        c = stale_ts(c, p, eid, t2);
        if c.res == 1 {
            ts.destroy();
            while c.pstash.len > 0 { c.pstash.pop(); }
            c.res4 = 0;
            return c;
        }
    }
    let out = vec.Vec<u32>::new(c.heap);
    let i: u64 = 0;
    while i < ts.len {
        c = chan_inner(c, p, ts.buf[i]);
        if c.res != NONE() { out = out.push(ts.buf[i]); }
        i = i + 1;
    }
    ts.destroy();
    while c.pstash.len > 0 { c.pstash.pop(); }
    i = 0;
    while i < out.len {
        c.pstash = c.pstash.push(out.buf[i]);
        i = i + 1;
    }
    c.res4 = u32(out.len);
    out.destroy();
    return c;
}

/// chan_gate — endpoint prelude for every channel op: the endpoint
/// must exist, be channel storage, live, and untransited; the op is
/// a Sync claim. Yields (ep, inner|NONE) pairs in c.cg; res4 = #eps.
fn chan_gate(own c: Checker, read p: ast.Parser,
             eid: u32, ln: u32, cl: u32) -> Checker {
    while c.cg.len > 0 { c.cg.pop(); }
    c = chan_place(c, p, eid);
    if c.res4 == 0 {
        let m = vec.Vec<u8>::new(c.heap);
        m = m.push(u8(96));
        m = tn_into(m, c, p, eid);
        m = resolve.bputs(m, "` is not a channel endpoint");
        c = pdiag(c, ln, cl, m.as_slice());
        m.destroy();
        c.res4 = 0;
        return c;
    }
    // stage eps locally — the helpers below clobber pstash
    let eps = vec.Vec<u32>::new(c.heap);
    let i: u64 = 0;
    while i < u64(c.res4) { eps = eps.push(c.pstash.buf[i]); i = i + 1; }
    c = path_holders(c, p, eid);
    i = 0;
    while i < eps.len {
        let ep = eps.buf[i];
        let st = cons_covers(c, ep);
        if st != 0 {
            let l0 = c.dlab.len;
            c = consume_labels(c, ep);
            let l1 = c.dlab.len;
            let m = vec.Vec<u8>::new(c.heap);
            if st == 1 {
                m = resolve.bputs(m, "use after consume `");
            }
            if st == 2 {
                m = resolve.bputs(m, "use of maybe-consumed `");
            }
            m = tn_into(m, c, p, eid);
            m = m.push(u8(96));
            c = pdiag_l(c, ln, cl, m.as_slice(), u32(l0), u32(l1));
            m.destroy();
            i = i + 1;
            continue;
        }
        c = transit_check(c, p, eid, ep);
        if c.res == 1 { i = i + 1; continue; }
        c = record_hold(c, ep, 5);
        // conflict scan — edges targeting ep, sorted by (h,t)
        let ks = vec.Vec<u64>::new(c.heap);
        let j: u64 = 0;
        while j < c.edges.len {
            if overlap(c, c.edges.buf[j].t, ep) == 1 {
                ks = ks.push(j);
            }
            j = j + 1;
        }
        j = 1;
        while j < ks.len {
            let x = ks.buf[j];
            let ex = c.edges.buf[u64(u32(x))];
            let j2 = j;
            while j2 > 0 {
                let ey = c.edges.buf[u64(u32(ks.buf[j2 - 1]))];
                let less: u8 = 0;
                if kless(c, ex.h, ey.h) == 1 { less = 1; }
                else {
                    if ey.h == ex.h { less = kless(c, ex.t, ey.t); }
                }
                if less == 0 { break; }
                ks.buf[j2] = ks.buf[j2 - 1];
                j2 = j2 - 1;
            }
            ks.buf[j2] = x;
            j = j + 1;
        }
        let conflict: u8 = 0;
        j = 0;
        while j < ks.len {
            let fe = c.edges.buf[u64(u32(ks.buf[j]))];
            if vhas(c.hstash, fe.h) == 0 && fe.kind != 5 {
                conflict = 1;
                let m = vec.Vec<u8>::new(c.heap);
                m = resolve.bputs(m, "channel op on `");
                m = tn_into(m, c, p, eid);
                if task_has(c, fe.h) == 1 {
                    m = resolve.bputs(m,
                        "` races unjoined task `");
                    m = push_kname(m, c, fe.h);
                    m = resolve.bputs(m,
                        "`'s unsynchronized access");
                } else {
                    m = resolve.bputs(m,
                        "` conflicts with a live borrow");
                }
                c = pdiag(c, ln, cl, m.as_slice());
                m.destroy();
                j = ks.len;
            }
            j = j + 1;
        }
        ks.destroy();
        if conflict == 1 { i = i + 1; continue; }
        c = chan_inner(c, p, ep);
        c.cg = c.cg.push(ep);
        c.cg = c.cg.push(c.res);
        i = i + 1;
    }
    eps.destroy();
    c.res4 = u32(c.cg.len) / 2;
    return c;
}

/// pkt_commit — close out the open packet in the arenas; res =
/// pkt_stash idx.
fn pkt_commit(own c: Checker, ty: u32, eoff: u32, coff: u32,
              soff: u32, auth: u8, hnd: u8) -> Checker {
    c.pkt_stash = c.pkt_stash.push(Packet {
        ty: ty,
        eoff: eoff, elen: u32(c.pk_edges.len) - eoff,
        coff: coff, clen: u32(c.pk_caps.len) - coff,
        soff: soff, slen: u32(c.pk_sent.len) - soff,
        auth: auth, hnd: hnd });
    c.res = u32(c.pkt_stash.len) - 1;
    return c;
}

/// packet_for — cut the authority packet `send` moves into the
/// channel. Owned values move (affine consume); `&mut` refs move
/// exclusive authority into transit; `&` refs move a read cap;
/// handles move identity only. Embedded raw refs can't outlive the
/// boundary (send-escape); guards never cross (guard-escape).
/// res = pkt_stash idx.
fn packet_for(own c: Checker, read p: ast.Parser,
              eid: u32, ln: u32, cl: u32) -> Checker {
    let e = xexp(c, p, eid);
    let kind = ek_num(e.kind);
    let eoff = u32(c.pk_edges.len);
    let coff = u32(c.pk_caps.len);
    let soff = u32(c.pk_sent.len);
    c = rty_prim(c, 9);
    let pty = c.res;
    let auth: u8 = 0;
    let hnd: u8 = 0;
    c = kstr(c, "");
    let erel = c.res;
    if kind == 12 {                        // Handle(place)
        // Identity only — the ticket travels, the sender keeps its
        // authority over the target.
        c = expr_tv(c, p, eid);
        pty = c.res;
        hnd = 1;
        c = caps_of(c, p, eid);
        let i: u64 = 0;
        while i < c.lcaps.len {
            c.pk_caps = c.pk_caps.push(C3 {
                h: erel, t: c.lcaps.buf[i], cert: 1 });
            i = i + 1;
        }
        return pkt_commit(c, pty, eoff, coff, soff, auth, hnd);
    }
    if kind == 11 {                        // AddrOf(mut, place)
        // The capability law runs first (`&mut x` needs Write).
        c = expr_tv(c, p, eid);
        pty = c.res;
        auth = 1;
        if e.a != 0 { auth = 2; }
        c = refs_of(c, p, eid);
        let i: u64 = 0;
        while i < c.lrefs_to.len {
            c.pk_edges = c.pk_edges.push(E2 {
                h: erel, t: c.lrefs_to.buf[i],
                kind: auth, cert: 1, bl: ln, bc: cl });
            i = i + 1;
        }
        if e.a != 0 {
            // Exclusive authority moves: the derivation source's
            // edge dies (reborrow-move) and the targets transit.
            if c.lrefs_mf != NONE() {
                let mf = c.lrefs_mf;
                c = kill_set(c, mf, 1);
                c = edges_retain_x(c, mf);
            }
            i = u64(eoff);
            while i < c.pk_edges.len {
                let t = c.pk_edges.buf[i].t;
                if vhas(c.transit, t) == 1 {
                    let m = vec.Vec<u8>::new(c.heap);
                    m = m.push(u8(96));
                    m = tn_into(m, c, p, e.b);
                    m = resolve.bputs(m,
                        "`'s authority is already channel-held");
                    c = pdiag(c, ln, cl, m.as_slice());
                    m.destroy();
                } else {
                    let st = cons_covers(c, t);
                    if st != 0 {
                        let l0 = c.dlab.len;
                        c = consume_labels(c, t);
                        let l1 = c.dlab.len;
                        let m = vec.Vec<u8>::new(c.heap);
                        m = resolve.bputs(m, "use after consume `");
                        m = tn_into(m, c, p, e.b);
                        m = m.push(u8(96));
                        c = pdiag_l(c, ln, cl, m.as_slice(),
                                    u32(l0), u32(l1));
                        m.destroy();
                    } else {
                        c.pk_sent = c.pk_sent.push(t);
                        c = transit_set(c, t);
                        // channel-held, not held by THIS context —
                        // a sibling recv must see it free of our
                        // send's momentary claim.
                        c = unhold(c, t);
                    }
                }
                i = i + 1;
            }
        }
        return pkt_commit(c, pty, eoff, coff, soff, auth, hnd);
    }
    let rvn = rv_find(c, eid);
    if kind == 2 || rvn != NONE() {        // Var | $rv temp
        let vn = rvn;
        if vn == NONE() {
            c.r = resolve.intern_pname(c.r, p, e.a);
            vn = c.r.res;
        }
        let bi = bfind(c, vn);
        if i64(bi) < 0 {
            let ns = p.names.buf[u64(e.a)];
            let m = vec.Vec<u8>::new(c.heap);
            m = resolve.bputs(m, "undefined variable `");
            let i: u64 = 0;
            while i < u64(ns.len) {
                m = m.push(p.nbyt.buf[u64(ns.off) + i]);
                i = i + 1;
            }
            m = m.push(u8(96));
            c = pdiag(c, ln, cl, m.as_slice());
            m.destroy();
            return pkt_commit(c, pty, eoff, coff, soff, auth, hnd);
        }
        let b = c.binds.buf[u64(bi)];
        if b.guard_dom != NONE() {
            c = pdiag_s(c, ln, cl,
                "a lock guard cannot cross a channel boundary");
            return pkt_commit(c, pty, eoff, coff, soff, auth, hnd);
        }
        pty = b.ty;
        let bt = c.r.rtys.buf[u64(b.ty)];
        if bt.kind == 18 {
            // Identity copies across; the sender keeps the ticket.
            c = key_of(c, vn, b.epoch);
            c = use_check(c, p, eid, c.res);
            hnd = 1;
            c = resolve_place(c, p, eid);
            let i: u64 = 0;
            while i < u64(c.res4) {
                c.pk_caps = c.pk_caps.push(C3 {
                    h: erel, t: c.pstash.buf[i], cert: 1 });
                i = i + 1;
            }
            c = caps_of(c, p, eid);
            i = 0;
            while i < c.lcaps.len {
                c.pk_caps = c.pk_caps.push(C3 {
                    h: erel, t: c.lcaps.buf[i], cert: 1 });
                i = i + 1;
            }
            return pkt_commit(c, pty, eoff, coff, soff, auth, hnd);
        }
        if b.auth != 0 || bt.kind == 15 || bt.kind == 17
            || bt.kind == 10 {
            // A capability binding moves wholesale: its edges
            // travel, exclusive targets transit, the name dies.
            // Only FOREIGN claims on the targets race the transfer.
            let mutable: u8 = 0;
            if (bt.kind == 15 || bt.kind == 17) && bt.b != 0 {
                mutable = 1;
            }
            if b.auth == 2 || b.auth == 3 { mutable = 1; }
            c = key_of(c, vn, b.epoch);
            let key = c.res;
            c = resolve_place(c, p, eid);
            let ts = vec.Vec<u32>::new(c.heap);
            let i: u64 = 0;
            while i < u64(c.res4) {
                ts = ts.push(c.pstash.buf[i]);
                i = i + 1;
            }
            c = path_holders(c, p, eid);
            i = 0;
            while i < ts.len {
                let t = ts.buf[i];
                c = unguarded_check(c, p, eid, t);
                c = transit_check(c, p, eid, t);
                // foreign-edge scan on this target, sorted by (h,t)
                let ks = vec.Vec<u64>::new(c.heap);
                let j: u64 = 0;
                while j < c.edges.len {
                    if overlap(c, c.edges.buf[j].t, t) == 1 {
                        ks = ks.push(j);
                    }
                    j = j + 1;
                }
                j = 1;
                while j < ks.len {
                    let x = ks.buf[j];
                    let ex = c.edges.buf[u64(u32(x))];
                    let j2 = j;
                    while j2 > 0 {
                        let ey = c.edges.buf[u64(u32(ks.buf[j2 - 1]))];
                        let less: u8 = 0;
                        if kless(c, ex.h, ey.h) == 1 { less = 1; }
                        else {
                            if ey.h == ex.h {
                                less = kless(c, ex.t, ey.t);
                            }
                        }
                        if less == 0 { break; }
                        ks.buf[j2] = ks.buf[j2 - 1];
                        j2 = j2 - 1;
                    }
                    ks.buf[j2] = x;
                    j = j + 1;
                }
                j = 0;
                while j < ks.len {
                    let fe = c.edges.buf[u64(u32(ks.buf[j]))];
                    if vhas(c.hstash, fe.h) == 0 && fe.kind != 5 {
                        let l0 = c.dlab.len;
                        c = born_label(c, fe.h, fe.kind,
                                       fe.bl, fe.bc);
                        let l1 = c.dlab.len;
                        let ns = p.names.buf[u64(e.a)];
                        let m = vec.Vec<u8>::new(c.heap);
                        m = resolve.bputs(m, "cannot send `");
                        let q: u64 = 0;
                        while q < u64(ns.len) {
                            m = m.push(
                                p.nbyt.buf[u64(ns.off) + q]);
                            q = q + 1;
                        }
                        m = resolve.bputs(m,
                            "`: its referent is borrowed");
                        c = pdiag_l(c, ln, cl, m.as_slice(),
                                    u32(l0), u32(l1));
                        m.destroy();
                        j = ks.len;
                    }
                    j = j + 1;
                }
                ks.destroy();
                i = i + 1;
            }
            ts.destroy();
            // packet edges — key-held facts travel, re-born here
            i = 0;
            while i < c.edges.len {
                let ce = c.edges.buf[i];
                if ce.h == key {
                    c.pk_edges = c.pk_edges.push(E2 {
                        h: erel, t: ce.t, kind: ce.kind,
                        cert: ce.cert, bl: ln, bc: cl });
                } else {
                    if kprefix(c, key, ce.h) == 1 {
                        c = key_rel_nd(c, ce.h, key);
                        c.pk_edges = c.pk_edges.push(E2 {
                            h: c.res, t: ce.t, kind: ce.kind,
                            cert: ce.cert, bl: ln, bc: cl });
                    }
                }
                i = i + 1;
            }
            i = 0;
            while i < c.caps.len {
                let cp = c.caps.buf[i];
                if kbstart(c, key, cp.h) == 1 {
                    c = key_rel_nd(c, cp.h, key);
                    c.pk_caps = c.pk_caps.push(C3 {
                        h: c.res, t: cp.t, cert: cp.cert });
                }
                i = i + 1;
            }
            let aoff = u32(c.atspans.len);
            c.atspans = c.atspans.push(ln);
            c.atspans = c.atspans.push(cl);
            c = cons_set(c, key, 1, aoff, 1);
            c = kill_set(c, key, 1);
            c = capkill_set(c, key, 1);
            c = edges_retain_holder(c, key);
            c = caps_retain_holder(c, key);
            if mutable == 1 {
                auth = 2;
                i = u64(eoff);
                while i < c.pk_edges.len {
                    let t = c.pk_edges.buf[i].t;
                    c.pk_sent = c.pk_sent.push(t);
                    c = transit_set(c, t);
                    c = unhold(c, t);
                    i = i + 1;
                }
            } else {
                auth = 1;
            }
            return pkt_commit(c, pty, eoff, coff, soff, auth, hnd);
        }
        // An owned value moves. Embedded raw refs could not outlive
        // the transport boundary — send-escape.
        c = key_of(c, vn, b.epoch);
        let key = c.res;
        let esc: u8 = 0;
        let i: u64 = 0;
        while i < c.edges.len {
            let ce = c.edges.buf[i];
            if ce.h != key && kprefix(c, key, ce.h) == 1 { esc = 1; }
            i = i + 1;
        }
        if esc == 1 {
            let ns = p.names.buf[u64(e.a)];
            let m = vec.Vec<u8>::new(c.heap);
            m = resolve.bputs(m, "cannot send `");
            let i: u64 = 0;
            while i < u64(ns.len) {
                m = m.push(p.nbyt.buf[u64(ns.off) + i]);
                i = i + 1;
            }
            m = resolve.bputs(m,
                "`: it still carries a reference into sender memory");
            c = pdiag(c, ln, cl, m.as_slice());
            m.destroy();
            return pkt_commit(c, pty, eoff, coff, soff, auth, hnd);
        }
        // Embedded handles are identity — they travel.
        i = 0;
        while i < c.caps.len {
            let cp = c.caps.buf[i];
            if cp.h != key && kprefix(c, key, cp.h) == 1 {
                c = key_rel_nd(c, cp.h, key);
                c.pk_caps = c.pk_caps.push(C3 {
                    h: c.res, t: cp.t, cert: cp.cert });
            }
            i = i + 1;
        }
        c = consume_place(c, p, eid);
        return pkt_commit(c, pty, eoff, coff, soff, auth, hnd);
    }
    c = expr_tv(c, p, eid);
    pty = c.res;
    return pkt_commit(c, pty, eoff, coff, soff, auth, hnd);
}

/// chan_op — `send`/`recv`/`close`. The endpoint gate runs first;
/// `send` enqueues a cut packet, `recv` pops one into the has_recv
/// side-channel for the enclosing `let`/`=` to claim, `close`
/// consumes the endpoint via N7.
fn chan_op(own c: Checker, read p: ast.Parser, eid: u32,
           vn: u32, na: u32, nt: u64) -> Checker {
    let e = xexp(c, p, eid);
    if nid_lit_eq(c, vn, "send") {
        if na != 2 {
            c = push_err_s(c, e.line, e.col,
                "`send` takes (channel, value)");
            c = rty_prim(c, 9); c.res2 = 0; c.res3 = 0;
            return c;
        }
        let a0 = p.u32s.buf[u64(e.b) + 2 + nt];
        let a1 = p.u32s.buf[u64(e.b) + 3 + nt];
        c = chan_gate(c, p, a0, e.line, e.col);
        if c.res4 == 0 {
            c = rty_prim(c, 9); c.res2 = 0; c.res3 = 0;
            return c;
        }
        let ne = c.res4;
        c = packet_for(c, p, a1, e.line, e.col);
        let pi = c.res;
        let pkt = c.pkt_stash.buf[u64(pi)];
        let i: u64 = 0;
        while i < u64(ne) {
            let ep = c.cg.buf[i * 2];
            let want = c.cg.buf[i * 2 + 1];
            if want != NONE() {
                let wt = c.r.rtys.buf[u64(want)];
                if wt.kind != 9 {
                    // `channel T` declares the packet shape.
                    c = coerce(c, p, want, a1, pkt.ty);
                }
            }
            // send-escape: a transported authority must outlive the
            // endpoint (promotion-style closure; handles exempt —
            // identity goes stale at use, it can't dangle).
            c = owner_of_key(c, ep);
            if c.res != NONE() {
                let eo = c.res;
                let j: u64 = u64(pkt.eoff);
                while j < u64(pkt.eoff) + u64(pkt.elen) {
                    let t = c.pk_edges.buf[j].t;
                    c = owner_of_key(c, t);
                    if c.res != NONE() {
                        if ranc(c, c.res, eo) == 0 {
                            let m = vec.Vec<u8>::new(c.heap);
                            m = resolve.bputs(m,
                                "send-escape: `");
                            m = tn_into(m, c, p, a1);
                            m = resolve.bputs(m,
                                "`'s region does not outlive the channel");
                            c = pdiag(c, e.line, e.col,
                                      m.as_slice());
                            m.destroy();
                        }
                    }
                    j = j + 1;
                }
            }
            c = es(c, "(send ");
            c = eqs(c, ep);
            c = eat(c, 1, e.line, e.col);
            c = ec(c, u8(41));
            c = rec(c);
            let qi = chan_idx(c, ep);
            if qi == NONE() {
                let pk2 = vec.Vec<Packet>::new(c.heap);
                c.chans = c.chans.push(CQ { k: ep, pkts: pk2 });
            }
            let qi2 = chan_idx(c, ep);
            c.chans.buf[u64(qi2)].pkts =
                c.chans.buf[u64(qi2)].pkts.push(pkt);
            i = i + 1;
        }
        c = rty_prim(c, 9); c.res2 = 0; c.res3 = 0;
        return c;
    }
    if nid_lit_eq(c, vn, "recv") {
        if na != 1 {
            c = push_err_s(c, e.line, e.col, "`recv` takes (channel)");
            c = rty_prim(c, 9); c.res2 = 0; c.res3 = 0;
            return c;
        }
        let a0 = p.u32s.buf[u64(e.b) + 2 + nt];
        c = chan_gate(c, p, a0, e.line, e.col);
        c = rty_prim(c, 9);
        let ty = c.res;
        let pk: u8 = 0; let pv: u32 = 0;
        if c.res4 != 0 {
            let ep = c.cg.buf[0];
            let want = c.cg.buf[1];
            let qi = chan_idx(c, ep);
            if qi != NONE()
                && c.chans.buf[u64(qi)].pkts.len > 0 {
                let pkt = c.chans.buf[u64(qi)].pkts.buf[0];
                // pop the front packet — claim order is FIFO
                let i: u64 = 1;
                while i < c.chans.buf[u64(qi)].pkts.len {
                    c.chans.buf[u64(qi)].pkts.buf[i - 1] =
                        c.chans.buf[u64(qi)].pkts.buf[i];
                    i = i + 1;
                }
                c.chans.buf[u64(qi)].pkts.pop();
                c = es(c, "(recv ");
                c = eqs(c, ep);
                c = eat(c, 1, e.line, e.col);
                c = ec(c, u8(41));
                c = rec(c);
                // The claimed authority leaves transit HERE; the
                // binding install rides has_recv to `let`.
                i = u64(pkt.soff);
                while i < u64(pkt.soff) + u64(pkt.slen) {
                    c = untransit(c, c.pk_sent.buf[i]);
                    i = i + 1;
                }
                // An opaque endpoint yields void — bindable recv's
                // need a declared `channel T`.
                if want != NONE() {
                    let wt = c.r.rtys.buf[u64(want)];
                    if wt.kind != 9 { ty = pkt.ty; }
                }
                // A received capability/handle names remote storage
                // — Param prov. A received box is a live root.
                if pkt.auth != 0 || pkt.hnd != 0 {
                    pk = 1;
                } else {
                    let pt = c.r.rtys.buf[u64(pkt.ty)];
                    if pt.kind == 24 || pt.kind == 25 {
                        pk = 2; pv = cur_region(c);
                    }
                }
                c.pkt_stash = c.pkt_stash.push(pkt);
                c.has_recv = 1;
                c.recv_pkt = u32(c.pkt_stash.len) - 1;
            } else {
                // No recorded packet — an opaque live value of the
                // declared payload type.
                if want != NONE() { ty = want; }
            }
        }
        c.res = ty; c.res2 = u32(pk); c.res3 = pv;
        return c;
    }
    // close
    if na != 1 {
        c = push_err_s(c, e.line, e.col, "`close` takes (channel)");
        c = rty_prim(c, 9); c.res2 = 0; c.res3 = 0;
        return c;
    }
    let a0 = p.u32s.buf[u64(e.b) + 2 + nt];
    c = chan_gate(c, p, a0, e.line, e.col);
    if c.res4 != 0 {
        c = consume_place(c, p, a0);
    }
    c = rty_prim(c, 9); c.res2 = 0; c.res3 = 0;
    return c;
}

/// chan_ctor — `channel()`: a fresh endpoint. Its payload type
/// arrives via the `let` annotation (`channel void` = opaque until
/// then); sends enqueue authority packets.
fn chan_ctor(own c: Checker, read p: ast.Parser, eid: u32,
             na: u32) -> Checker {
    let e = xexp(c, p, eid);
    if na != 0 {
        c = push_err_s(c, e.line, e.col,
            "`channel` takes no arguments");
    }
    c = rty_prim(c, 9);
    let vo = c.res;
    let t = rty_wrap(c, 23, vo);
    if t == NONE() {
        c.r.rtys = c.r.rtys.push(resolve.RTy {
            kind: 23, name: 0, a: vo, b: 0, c: 0, w: 0 });
        c.res = u32(c.r.rtys.len) - 1;
    } else {
        c.res = t;
    }
    c.res2 = 0; c.res3 = 0;
    return c;
}

/// claim_packet — install a recv'd packet's graph delta at binding
/// key `key`: travelled edges/caps re-root under it (silent — the
/// receiver's view IS the packet), then the stale-target check.
fn claim_packet(own c: Checker, read p: ast.Parser,
                eid: u32, key: u32) -> Checker {
    let pkt = c.pkt_stash.buf[u64(c.recv_pkt)];
    let i: u64 = u64(pkt.eoff);
    while i < u64(pkt.eoff) + u64(pkt.elen) {
        let pe = c.pk_edges.buf[i];
        c = key_join_rel(c, key, pe.h);
        let h2 = c.res;
        let ei = edge_at(c, h2, pe.t);
        if ei >= 0 {
            c.edges.buf[u64(u32(ei))] = E2 {
                h: h2, t: pe.t, kind: pe.kind, cert: pe.cert,
                bl: pe.bl, bc: pe.bc };
        } else {
            c.edges = c.edges.push(E2 {
                h: h2, t: pe.t, kind: pe.kind, cert: pe.cert,
                bl: pe.bl, bc: pe.bc });
        }
        i = i + 1;
    }
    i = u64(pkt.coff);
    while i < u64(pkt.coff) + u64(pkt.clen) {
        let pc = c.pk_caps.buf[i];
        c = key_join_rel(c, key, pc.h);
        let h2 = c.res;
        let found: u8 = 0;
        let j: u64 = 0;
        while j < c.caps.len {
            if c.caps.buf[j].h == h2 && c.caps.buf[j].t == pc.t {
                c.caps.buf[j].cert = pc.cert;
                found = 1;
            }
            j = j + 1;
        }
        if found == 0 {
            c.caps = c.caps.push(C3 { h: h2, t: pc.t, cert: pc.cert });
        }
        i = i + 1;
    }
    // Received targets must still exist — a handle to storage that
    // died in flight is stale at claim time.
    i = u64(pkt.eoff);
    while i < u64(pkt.eoff) + u64(pkt.elen) {
        c = claim_stale(c, p, eid, c.pk_edges.buf[i].t);
        i = i + 1;
    }
    i = u64(pkt.coff);
    while i < u64(pkt.coff) + u64(pkt.clen) {
        c = claim_stale(c, p, eid, c.pk_caps.buf[i].t);
        i = i + 1;
    }
    return c;
}

/// claim_stale — one received target's liveness check.
fn claim_stale(own c: Checker, read p: ast.Parser,
               eid: u32, t: u32) -> Checker {
    c = key_root(c, t);
    let rk = c.res;
    if k_is_arg(c, rk) == 1 { return c; }
    let sp = c.kns.buf[u64(rk)];
    if u64(sp.len) > 0 && c.kbyt.buf[u64(sp.off)] == u8(42) {
        return c;
    }
    let alive: u8 = 0;
    let nn = root_name(c, rk);
    if nn != NONE() {
        let bi = bfind(c, nn);
        if i64(bi) >= 0 {
            let b = c.binds.buf[u64(bi)];
            c = key_of(c, nn, b.epoch);
            if c.res == rk && cons_covers(c, t) == 0 { alive = 1; }
        }
    }
    if alive == 0 {
        let e = xexp(c, p, eid);
        let m = vec.Vec<u8>::new(c.heap);
        m = resolve.bputs(m, "received `");
        m = tn_into(m, c, p, eid);
        m = resolve.bputs(m,
            "`: its target no longer exists (stale in transit)");
        c = pdiag(c, e.line, e.col, m.as_slice());
        m.destroy();
    }
    return c;
}

/// resolved callee for this call site — the resolver's `cres` row
/// (canon `m.f<..>` for generics, the desugared target for
/// method/assoc sugar), else NONE.
pub fn cres_find(read c: Checker, ln: u32, cl: u32) -> u32 {
    if c.cur_fn == NONE() { return NONE(); }
    let ctx = c.cur_fn;
    let i: u64 = 0;
    while i < c.r.cres.len {
        let cr = c.r.cres.buf[i];
        if cr.who == c.who && cr.ctx == ctx
            && cr.line == ln && cr.col == cl {
            return cr.callee;
        }
        i = i + 1;
    }
    return NONE();
}

/// lits_find — the resolver's ty for a struct literal at (ln,cl):
/// inferred `App` when the literal was bare on a template, the
/// written instantiation when explicit, bare name otherwise.
fn lits_find(read c: Checker, ln: u32, cl: u32) -> u32 {
    if c.cur_fn == NONE() { return NONE(); }
    let ctx = c.cur_fn;
    let i: u64 = 0;
    while i < c.r.lits.len {
        let lt = c.r.lits.buf[i];
        if lt.who == c.who && lt.ctx == ctx
            && lt.line == ln && lt.col == cl {
            return lt.ty;
        }
        i = i + 1;
    }
    return NONE();
}

/// synthetic-eid base — `xexps` entries address as `XBASE + idx`.
fn XBASE() -> u32 { return 0x40000000; }

/// expr fetch — overlay: synthetic receiver nodes live in `xexps`,
/// everything else in the parser's arena.
pub fn xexp(read c: Checker, read p: ast.Parser, eid: u32) -> ast.Expr {
    if eid >= XBASE() { return c.xexps.buf[u64(eid - XBASE())]; }
    return p.exps.buf[u64(eid)];
}

/// parser NameId by byte slice — `p.names`/`p.nbyt` linear scan.
fn pname_find(read c: Checker, read p: ast.Parser,
              read nid: u32) -> u32 {
    let sp = c.r.rns.buf[u64(nid)];
    let i: u64 = 0;
    while i < p.names.len {
        let nm = p.names.buf[i];
        if u64(nm.len) == u64(sp.len) {
            let j: u64 = 0; let eq: u8 = 1;
            while j < u64(nm.len) {
                if p.nbyt.buf[u64(nm.off) + j]
                    != c.r.rbyt.buf[u64(sp.off) + j] { eq = 0; }
                j = j + 1;
            }
            if eq == 1 { return u32(i); }
        }
        i = i + 1;
    }
    return NONE();
}

/// `v.m(..)` receiver — the resolver's cres row carries the bound
/// prefix nid (NONE for module calls / unbound paths).
fn mrecv_nid(own c: Checker, read p: ast.Parser, eid: u32) -> Checker {
    let e = xexp(c, p, eid);
    c.res = mrecv_at(c, e);
    return c;
}

/// the synthetic `Var(pre)` eid for a dotted-method Call — memoized
/// per call site so every arg-path consumer sees one node.
pub fn mrecv_eid(own c: Checker, read p: ast.Parser,
             eid: u32) -> Checker {
    c = mrecv_nid(c, p, eid);
    if c.res == NONE() { return c; }
    let pre = c.res;
    let i: u64 = 0;
    while i < c.xmap.len {
        if c.xmap.buf[i].k == eid { c.res = c.xmap.buf[i].v; return c; }
        i = i + 1;
    }
    let e = xexp(c, p, eid);
    let a = pname_find(c, p, pre);
    let xe = ast.Expr {
        kind: ast.EK::Var, line: e.line, col: e.col,
        a: a, b: 0, c: 0, d: 0, w: 0 };
    c.xexps = c.xexps.push(xe);
    let xeid = XBASE() + u32(c.xexps.len) - 1;
    c.xmap = c.xmap.push(KK { k: eid, v: xeid });
    c.res = xeid;
    return c;
}

/// arg i of the current call — `c.ovr` for desugared calls
/// (method recv / assoc-fn args), else the Call node's u32s layout.
fn carg(read c: Checker, read p: ast.Parser, e: ast.Expr,
        nt: u64, i: u64) -> u32 {
    if c.ovr_on == 1 { return c.ovr.buf[i]; }
    return p.u32s.buf[u64(e.b) + 2 + nt + i];
}

/// arg count / eid accessor for call-shaped exprs — Call's u32s
/// layout, MethodCall's recv prepended, AssocFn's plain range.
/// `v.m(..)` receiver, read-only — the cres row's `recv` field is
/// the bound prefix nid (NONE for non-method sites). Keyed on the
/// call node's span.
pub fn mrecv_at(read c: Checker, e: ast.Expr) -> u32 {
    if ek_num(e.kind) != 6 { return NONE(); }
    let i: u64 = 0;
    while i < c.r.cres.len {
        let cr = c.r.cres.buf[i];
        if cr.who == c.who && cr.ctx == c.cur_fn
            && cr.line == e.line && cr.col == e.col {
            return cr.recv;
        }
        i = i + 1;
    }
    return NONE();
}

pub fn call_nargs(read c: Checker, read p: ast.Parser, eid: u32) -> u64 {
    let e = xexp(c, p, eid);
    let k = ek_num(e.kind);
    if k == 6 {
        let nt = u64(p.u32s.buf[u64(e.b)]);
        let recv: u64 = 0;
        if mrecv_at(c, e) != NONE() { recv = 1; }
        return u64(p.u32s.buf[u64(e.b) + 1 + nt]) + recv;
    }
    if k == 19 {
        let nt = u64(p.u32s.buf[u64(e.c)]);
        return u64(p.u32s.buf[u64(e.c) + 1 + nt]) + 1;
    }
    return u64(e.d);                        // AssocFn
}
pub fn call_arg(own c: Checker, read p: ast.Parser, e: ast.Expr,
            eid: u32, i: u64) -> Checker {
    let k = ek_num(e.kind);
    if k == 6 {
        // `v.m(..)` — the receiver is arg0 of the desugared call
        if mrecv_at(c, e) != NONE() {
            if i == 0 {
                c = mrecv_eid(c, p, eid);
                return c;
            }
            let nt = u64(p.u32s.buf[u64(e.b)]);
            c.res = p.u32s.buf[u64(e.b) + 2 + nt + i - 1];
            return c;
        }
        let nt = u64(p.u32s.buf[u64(e.b)]);
        c.res = p.u32s.buf[u64(e.b) + 2 + nt + i];
        return c;
    }
    if k == 19 {
        if i == 0 { c.res = e.a; return c; }
        let nt = u64(p.u32s.buf[u64(e.c)]);
        c.res = p.u32s.buf[u64(e.c) + 2 + nt + i - 1];
        return c;
    }
    c.res = p.u32s.buf[u64(e.c) + i];
    return c;
}

/// callee nid for any call-shaped expr — Call (parser name, cres
/// redirect for generics) or MethodCall/AssocFn (cres carries the
/// desugared target; NONE when resolution failed or the AssocFn is
/// an enum variant).
pub fn callee_of(own c: Checker, read p: ast.Parser, eid: u32) -> Checker {
    let e = xexp(c, p, eid);
    let k = ek_num(e.kind);
    if k == 6 {
        c.r = resolve.intern_pname(c.r, p, e.a);
        let vn = c.r.res;
        let cr = cres_find(c, e.line, e.col);
        if cr != NONE() { vn = cr; }
        c.res = vn;
        return c;
    }
    c.res = cres_find(c, e.line, e.col);
    return c;
}

/// `recv.m(args)` — resolved `cres` target is an ordinary call with
/// the receiver prepended as arg0. Absent row = desugar diagnosed
/// at resolve (stage-0's survivor returns Void silently).
fn expr_mcall(own c: Checker, read p: ast.Parser, eid: u32,
              want: u32, init_ok: u8) -> Checker {
    let e = xexp(c, p, eid);
    let cr = cres_find(c, e.line, e.col);
    if cr == NONE() {
        c = rty_prim(c, 9); c.res2 = 0; c.res3 = 0;
        return c;
    }
    // desugared args: [recv, call args…] — u32s[e.c] is the Call
    // layout [nt, targs.., na, args..]
    let nt = u64(p.u32s.buf[u64(e.c)]);
    let na = p.u32s.buf[u64(e.c) + 1 + nt];
    while c.ovr.len > 0 { c.ovr.pop(); }
    c.ovr = c.ovr.push(e.a);
    let i: u64 = 0;
    while i < u64(na) {
        c.ovr = c.ovr.push(
            p.u32s.buf[u64(e.c) + 2 + nt + i]);
        i = i + 1;
    }
    c.ovr_on = 1;
    c = check_call2(c, p, eid, want, init_ok, cr, na + 1, nt);
    c.ovr_on = 0;
    return c;
}

/// `T::f(args)` — enum variant when no `cres` row exists (assoc_enum
/// handled it); else an ordinary desugared call over `e.c..e.c+e.d`.
fn expr_assoc(own c: Checker, read p: ast.Parser, eid: u32,
              want: u32, init_ok: u8) -> Checker {
    let e = xexp(c, p, eid);
    let cr = cres_find(c, e.line, e.col);
    if cr == NONE() { return expr_enumlit(c, p, eid); }
    while c.ovr.len > 0 { c.ovr.pop(); }
    let i: u64 = 0;
    while i < u64(e.d) {
        c.ovr = c.ovr.push(p.u32s.buf[u64(e.c) + i]);
        i = i + 1;
    }
    c.ovr_on = 1;
    c = check_call2(c, p, eid, want, init_ok, cr, e.d, 0);
    c.ovr_on = 0;
    return c;
}

fn check_call(own c: Checker, read p: ast.Parser, eid: u32,
              want: u32, init_ok: u8) -> Checker {
    let e = xexp(c, p, eid);
    // resolved callee — resolver's cres row wins (canon/generic);
    // else the interned parser name.
    c.r = resolve.intern_pname(c.r, p, e.a);
    let vn = c.r.res;
    let cr = cres_find(c, e.line, e.col);
    if cr != NONE() { vn = cr; }
    // args: u32s[e.b .. e.c] = [nt, targs.., na, args..]
    let nt = u64(p.u32s.buf[u64(e.b)]);
    let na = p.u32s.buf[u64(e.b) + 1 + nt];
    // `v.m(..)` — dotted name bound as a method: mono's desugar
    // prepends the receiver, synthesized here as `Var(pre)`.
    c = mrecv_eid(c, p, eid);
    if c.res != NONE() {
        let xeid = c.res;
        while c.ovr.len > 0 { c.ovr.pop(); }
        c.ovr = c.ovr.push(xeid);
        let i: u64 = 0;
        while i < u64(na) {
            c.ovr = c.ovr.push(
                p.u32s.buf[u64(e.b) + 2 + nt + i]);
            i = i + 1;
        }
        c.ovr_on = 1;
        c = check_call2(c, p, eid, want, init_ok, vn, na + 1, nt);
        c.ovr_on = 0;
        return c;
    }
    return check_call2(c, p, eid, want, init_ok, vn, na, nt);
}

/// shared call tail — `(call …)` event, fdecl scan, builtins,
/// `call_body`. `vn` is the resolved callee nid; `na`/`nt` describe
/// the u32s arg layout (ignored when `c.ovr_on` — desugared calls).
fn check_call2(own c: Checker, read p: ast.Parser, eid: u32,
               want: u32, init_ok: u8, vn: u32, na: u32,
               nt: u64) -> Checker {
    let e = xexp(c, p, eid);
    c = es(c, "(call ");
    let sp = c.r.rns.buf[u64(vn)];
    c = eqs_r(c, &c.r.rbyt.buf[u64(sp.off)..
        u64(sp.off) + u64(sp.len)]);
    c = es(c, " @");
    c = eu(c, u64(e.line));
    c = ec(c, u8(58));
    c = eu(c, u64(e.col));
    c = ec(c, u8(41));
    c = rec(c);
    let i: u64 = 0;
    let fi = NONE();
    let j: u64 = 0;
    while j < c.r.fdecls.len {
        let fd2 = c.r.fdecls.buf[j];
        // own module: any fn; dep: pub or extern only
        if fd2.name == vn && fd2.tps_len == 0
            && vhas(c.vprogs, fd2.prog) == 1
            && (fd2.prog == c.who || fd2.pub_ == 1
                || fd2.ext == 1) { fi = u32(j); }
        j = j + 1;
    }
    // reset call-arg state
    while c.cboff.len > 0 { c.cboff.pop(); }
    while c.cblen.len > 0 { c.cblen.pop(); }
    while c.cbases.len > 0 { c.cbases.pop(); }
    while c.ahold.len > 0 { c.ahold.pop(); }
    while c.rebs.len > 0 { c.rebs.pop(); }
    while c.reb_edges.len > 0 { c.reb_edges.pop(); }
    while c.reb_caps.len > 0 { c.reb_caps.pop(); }
    if fi == NONE() {
        // `u64(x)`/`i32(x)` — int→int casts (N24B). A user fn of
        // the same name would have produced an fdecl (`fi`), so
        // reaching here means the builtin.
        let ctk = resolve.int_cast_ty(c.r, vn);
        if ctk >= 0 {
            if na != 1 {
                let m = vec.Vec<u8>::new(c.heap);
                let m2 = m.push(u8(96));
                let sp2 = c.r.rns.buf[u64(vn)];
                let i2: u64 = 0;
                while i2 < u64(sp2.len) {
                    m2 = m2.push(
                        c.r.rbyt.buf[u64(sp2.off) + i2]);
                    i2 = i2 + 1;
                }
                let m3 = resolve.bputs(m2,
                    "` cast takes exactly one argument");
                c = pdiag(c, e.line, e.col, m3.as_slice());
                m3.destroy();
                c = rty_prim(c, 9);
                c.res2 = 0; c.res3 = 0;
                return c;
            }
            c = rty_prim(c, u8(ctk));
            let ty = c.res;
            c = call_arg(c, p, e, eid, 0);
            let a0 = c.res;
            c = expr_tv_w(c, p, a0, ty, init_ok);
            let at = c.res;
            let atk: u8 = 99;
            if at != NONE() {
                atk = c.r.rtys.buf[u64(at)].kind;
            }
            if atk <= 7 {
                c.res = ty; c.res2 = 0; c.res3 = 0;
                return c;
            }
            let ae = xexp(c, p, a0);
            let m = vec.Vec<u8>::new(c.heap);
            let m2 = m.push(u8(96));
            let sp2 = c.r.rns.buf[u64(vn)];
            let i2: u64 = 0;
            while i2 < u64(sp2.len) {
                m2 = m2.push(c.r.rbyt.buf[u64(sp2.off) + i2]);
                i2 = i2 + 1;
            }
            let m3 = resolve.bputs(m2,
                "` cast takes an int, found ");
            let t1 = push_ty(m3, c, at);
            c = t1.c;
            c = pdiag(c, ae.line, ae.col, t1.m.as_slice());
            t1.m.destroy();
            c = rty_prim(c, 9);
            c.res2 = 0; c.res3 = 0;
            return c;
        }
        if nid_lit_eq(c, vn, "unreachable") {
            // N32 — the path ends here: no unwind, no scope-exit
            // obligations past this point.
            if na != 0 {
                let m = vec.Vec<u8>::new(c.heap);
                let m2 = resolve.bputs(m,
                    "`unreachable` takes no arguments");
                c = pdiag(c, e.line, e.col, m2.as_slice());
                m2.destroy();
            }
            c.diverged = 1;
            c.terminated = 1;
            c = rec_flags(c);
            c = rty_prim(c, 9);
            c.res2 = 0; c.res3 = 0;
            return c;
        }
        if nid_lit_eq(c, vn, "slice") {
            // `slice(p, n)` — assert foreign storage as a span;
            // `*void` becomes a byte view.
            if na != 2 {
                let m = vec.Vec<u8>::new(c.heap);
                let m2 = resolve.bputs(m,
                    "slice() takes a pointer and a length");
                c = pdiag(c, e.line, e.col, m2.as_slice());
                m2.destroy();
                c = rty_prim(c, 9);
                c.res2 = 0; c.res3 = 0;
                return c;
            }
            c = call_arg(c, p, e, eid, 0);
            let a0 = c.res;
            c = expr_tv_w(c, p, a0, NONE(), init_ok);
            let pt = c.res;
            c = call_arg(c, p, e, eid, 1);
            let a1 = c.res;
            c = expr_tv_w(c, p, a1, NONE(), init_ok);
            let lt = c.res;
            if lt != NONE()
                && c.r.rtys.buf[u64(lt)].kind > 7 {
                let ae = xexp(c, p, a1);
                let m = vec.Vec<u8>::new(c.heap);
                let m2 = resolve.bputs(m,
                    "slice() length must be an integer, found ");
                let t1 = push_ty(m2, c, lt);
                c = t1.c;
                c = pdiag(c, ae.line, ae.col, t1.m.as_slice());
                t1.m.destroy();
            }
            let ptk: u8 = 99;
            if pt != NONE() {
                ptk = c.r.rtys.buf[u64(pt)].kind;
            }
            if ptk == 16 {
                let pn = c.r.rtys.buf[u64(pt)];
                let el = pn.a;
                if c.r.rtys.buf[u64(el)].kind == 9 {
                    c = rty_prim(c, 0);
                    el = c.res;
                }
                c.r = resolve.mk_un(c.r, 17, el, pn.b);
                c.res = c.r.res;
                c.res2 = 0; c.res3 = 0;
                return c;
            }
            let m = vec.Vec<u8>::new(c.heap);
            let m2 = resolve.bputs(m,
                "slice() requires a `*T`/`*const T` pointer, found ");
            let t1 = push_ty(m2, c, pt);
            c = t1.c;
            c = pdiag(c, e.line, e.col, t1.m.as_slice());
            t1.m.destroy();
            c = rty_prim(c, 9);
            c.res2 = 0; c.res3 = 0;
            return c;
        }
        if nid_lit_eq(c, vn, "cstr") {
            // `cstr(s)` — str → `*const u8` for NUL-terminated APIs;
            // only provably-terminated storage crosses.
            if na != 1 {
                let m = vec.Vec<u8>::new(c.heap);
                let m2 = resolve.bputs(m,
                    "`cstr` takes one string");
                c = pdiag(c, e.line, e.col, m2.as_slice());
                m2.destroy();
                c = rty_prim(c, 9);
                c.res2 = 0; c.res3 = 0;
                return c;
            }
            c = call_arg(c, p, e, eid, 0);
            let a0 = c.res;
            c = expr_tv_w(c, p, a0, NONE(), init_ok);
            let at = c.res;
            let ae = xexp(c, p, a0);
            let safe: u8 = 0;
            if ek_num(ae.kind) == 3 { safe = 1; }
            if ek_num(ae.kind) == 2 {
                c.r = resolve.intern_pname(c.r, p, ae.a);
                let vn2 = c.r.res;
                let bi = bfind(c, vn2);
                if i64(bi) >= 0 {
                    c = key_of(c, vn2, c.binds.buf[u64(bi)].epoch);
                    if vhas(c.csafe, c.res) == 1 { safe = 1; }
                }
            }
            if (at == NONE()
                || c.r.rtys.buf[u64(at)].kind != 10)
                && ek_num(ae.kind) != 3 {
                let m = vec.Vec<u8>::new(c.heap);
                let m2 = resolve.bputs(m,
                    "`cstr` takes a `str`, found ");
                let t1 = push_ty(m2, c, at);
                c = t1.c;
                c = pdiag(c, ae.line, ae.col, t1.m.as_slice());
                t1.m.destroy();
            } else { if safe == 0 {
                let m = vec.Vec<u8>::new(c.heap);
                let m2 = resolve.bputs(m,
                    "`cstr` requires storage known to be NUL-terminated — only literals and views bound from one qualify");
                c = pdiag(c, ae.line, ae.col, m2.as_slice());
                m2.destroy();
            } }
            // `*const u8`
            c = rty_strlit(c);
            c.res2 = 0; c.res3 = 0;
            return c;
        }
        if nid_lit_eq(c, vn, "str_from_utf8") {
            // the ONLY bytes→str door — runtime validates; the str
            // inherits the slice's Read claim.
            if na != 1 {
                let m = vec.Vec<u8>::new(c.heap);
                let m2 = resolve.bputs(m,
                    "`str_from_utf8` takes a `slice u8`");
                c = pdiag(c, e.line, e.col, m2.as_slice());
                m2.destroy();
                c = rty_prim(c, 9);
                c.res2 = 0; c.res3 = 0;
                return c;
            }
            c = call_arg(c, p, e, eid, 0);
            let a0 = c.res;
            c = expr_tv_w(c, p, a0, NONE(), init_ok);
            let at = c.res;
            let ok: u8 = 0;
            if at != NONE() {
                let an = c.r.rtys.buf[u64(at)];
                if an.kind == 17
                    && c.r.rtys.buf[u64(an.a)].kind == 0 {
                    ok = 1;
                }
            }
            if ok == 1 {
                c = rty_prim(c, 10);
                c.res2 = 0; c.res3 = 0;
                return c;
            }
            let ae = xexp(c, p, a0);
            let m = vec.Vec<u8>::new(c.heap);
            let m2 = resolve.bputs(m,
                "`str_from_utf8` takes a `slice u8`, found ");
            let t1 = push_ty(m2, c, at);
            c = t1.c;
            c = pdiag(c, ae.line, ae.col, t1.m.as_slice());
            t1.m.destroy();
            c = rty_prim(c, 9);
            c.res2 = 0; c.res3 = 0;
            return c;
        }
        if nid_lit_eq(c, vn, "atomic_load")
            || nid_lit_eq(c, vn, "atomic_store")
            || nid_lit_eq(c, vn, "atomic_add")
            || nid_lit_eq(c, vn, "compare_exchange") {
            return atomic_op(c, p, eid, vn, na, nt);
        }
        if nid_lit_eq(c, vn, "lock") {
            return lock_op(c, p, eid, na, nt);
        }
        if nid_lit_eq(c, vn, "unlock") {
            return unlock_op(c, p, eid, na, nt);
        }
        if nid_lit_eq(c, vn, "channel") {
            return chan_ctor(c, p, eid, na);
        }
        if nid_lit_eq(c, vn, "send") || nid_lit_eq(c, vn, "recv")
            || nid_lit_eq(c, vn, "close") {
            return chan_op(c, p, eid, vn, na, nt);
        }
        if nid_lit_eq(c, vn, "system_allocator") {
            if na != 0 {
                let m = vec.Vec<u8>::new(c.heap);
                let m2 = resolve.bputs(m,
                    "`system_allocator` takes no arguments");
                c = pdiag(c, e.line, e.col, m2.as_slice());
                m2.destroy();
            }
            c = rty_prim(c, 11);            // alloc
            c.res2 = 0; c.res3 = 0;
            return c;
        }
        if nid_lit_eq(c, vn, "free") {
            if na != 1 {
                let m = vec.Vec<u8>::new(c.heap);
                let m2 = resolve.bputs(m, "`free` takes one box");
                c = pdiag(c, e.line, e.col, m2.as_slice());
                m2.destroy();
                c = rty_prim(c, 9);
                c.res2 = 0; c.res3 = 0;
                return c;
            }
            let a0 = p.u32s.buf[u64(e.b) + 2 + nt];
            c = expr_tv_w(c, p, a0, NONE(), 1);
            let at = c.res;
            let atk = c.r.rtys.buf[u64(at)].kind;
            if atk == 24 || atk == 25 {
                c = consume_place(c, p, a0);
            } else {
                let ae = p.exps.buf[u64(a0)];
                let m = vec.Vec<u8>::new(c.heap);
                let m2 = resolve.bputs(m,
                    "`free` takes a `box`/`box slice`, found ");
                let pt_ = push_ty(m2, c, at);
                c = pt_.c;
                let m3 = pt_.m;
                c = pdiag(c, ae.line, ae.col, m3.as_slice());
                m3.destroy();
            }
            c = rty_prim(c, 9);
            c.res2 = 0; c.res3 = 0;
            return c;
        }
        if nid_lit_eq(c, vn, "replace") {
            // N40 — `replace(place, v)`: the old value moves OUT to
            // the result while `v` moves IN — the place never holds
            // a hole, so no overwrite-law audit runs.
            if na != 2 {
                c = pdiag_s(c, e.line, e.col,
                    "`replace` takes a place and a value");
                c = rty_prim(c, 9);
                c.res2 = 0; c.res3 = 0;
                return c;
            }
            let a0 = carg(c, p, e, nt, 0);
            let a1 = carg(c, p, e, nt, 1);
            let a0e = xexp(c, p, a0);
            let a0k = ek_num(a0e.kind);
            if a0k != 2 && a0k != 7 && a0k != 8 && a0k != 16 {
                c = pdiag_s(c, a0e.line, a0e.col,
                    "`replace` target is not a place");
                c = rty_prim(c, 9);
                c.res2 = 0; c.res3 = 0;
                return c;
            }
            c = place_tv(c, p, a0);
            let pt = c.res;
            let ppk = c.res2; let ppv = c.res3;
            c = expr_tv_w(c, p, a1, pt, init_ok);
            let vt = c.res;
            c = coerce(c, p, pt, a1, vt);
            c = check_store(c, p, a0, a1, vt, u8(c.res2), c.res3);
            c = require_place_bases(c, p, a0);
            c = require_init(c, p, a0);
            c = resolve_place(c, p, a0);
            let ks = vec.Vec<u32>::new(c.heap);
            let i: u64 = 0;
            while i < u64(c.res4) {
                ks = ks.push(c.pstash.buf[i]);
                i = i + 1;
            }
            if ks.len == 0 {
                c = place_id(c, p, a0);
                if c.res != NONE() { ks = ks.push(c.res); }
            }
            i = 0;
            while i < ks.len {
                c = use_check(c, p, a0, ks.buf[i]);
                i = i + 1;
            }
            // `replace(w, w.f)` would move the value into its own
            // subtree — reject any shared storage.
            c = resolve_place(c, p, a1);
            let vks = vec.Vec<u32>::new(c.heap);
            i = 0;
            while i < u64(c.res4) {
                vks = vks.push(c.pstash.buf[i]);
                i = i + 1;
            }
            i = 0;
            while i < ks.len {
                let j: u64 = 0;
                while j < vks.len {
                    if overlap(c, ks.buf[i], vks.buf[j]) == 1 {
                        let a1e = xexp(c, p, a1);
                        c = pdiag_s(c, a1e.line, a1e.col,
                            "`replace` value overlaps its target place");
                    }
                    j = j + 1;
                }
                i = i + 1;
            }
            vks.destroy();
            // The OLD packets leave before install_store rewrites
            // k — the result binding re-roots them.
            let pkts = vec.Vec<LPKT>::new(c.heap);
            i = 0;
            while i < ks.len {
                c = collect_lit_k(c, ks.buf[i]);
                let pr = pkt_drain(c);
                c = pr.c;
                pkts = pkts.push(pr.pk);
                i = i + 1;
            }
            // the result's root refs/caps = the saved "" rels'
            // union — `let r = replace(..)` reads them via
            // refs_of/caps_of.
            c = kstr(c, "");
            let erel = c.res;
            let ri_to = vec.Vec<u32>::new(c.heap);
            let ri_mut: u8 = 0;
            let ri_fr: u8 = 0;
            let ocaps = vec.Vec<u32>::new(c.heap);
            i = 0;
            while i < pkts.len {
                let q: u64 = 0;
                while q < pkts.buf[i].le_rel.len {
                    if pkts.buf[i].le_rel.buf[q] == erel {
                        let ri0 = pkts.buf[i].le_ri.buf[q];
                        if ri0.mut_ != 0 { ri_mut = 1; }
                        if ri0.foreign != 0 { ri_fr = 1; }
                        let w: u64 = 0;
                        while w < u64(ri0.tlen) {
                            let t = pkts.buf[i].le_pool.buf[
                                u64(ri0.toff) + w];
                            if vhas(ri_to, t) == 0 {
                                ri_to = ri_to.push(t);
                            }
                            w = w + 1;
                        }
                    }
                    q = q + 1;
                }
                q = 0;
                while q < pkts.buf[i].lc.len {
                    let c0 = pkts.buf[i].lc.buf[q];
                    if c0.rel == erel {
                        let w: u64 = 0;
                        while w < u64(c0.len) {
                            let t = pkts.buf[i].lc_keys.buf[
                                u64(c0.off) + w];
                            if vhas(ocaps, t) == 0 {
                                ocaps = ocaps.push(t);
                            }
                            w = w + 1;
                        }
                    }
                    q = q + 1;
                }
                i = i + 1;
            }
            c.repl_outs = c.repl_outs.push(RPO {
                ln: e.line, cl: e.col,
                ri_to: ri_to, ri_mut: ri_mut, ri_foreign: ri_fr,
                caps: ocaps });
            c = push_place_lit(c, p, a1);
            let a1e2 = xexp(c, p, a1);
            c = consume_owned_src(c, p, a1, a1e2.line, a1e2.col);
            i = 0;
            while i < ks.len {
                c = install_store(c, p, a1, ks.buf[i], pt, vt,
                                  a1e2.line, a1e2.col);
                i = i + 1;
            }
            // install_store drained the value's packet; the old
            // packets now re-enter for the result's let site.
            i = 0;
            while i < pkts.len {
                c = pkt_push(c, pkts.buf[i]);
                i = i + 1;
            }
            while pkts.len > 0 { pkt_free(pkts.pop()); }
            pkts.destroy();
            ks.destroy();
            c.res = pt; c.res2 = ppk; c.res3 = ppv;
            return c;
        }
        if nid_lit_eq(c, vn, "swap") {
            // `swap(a, b)` — two places exchange whole packets
            // atomically: each side's facts re-root under the other
            // key via the lit-channel machinery `let` uses.
            if na != 2 {
                c = pdiag_s(c, e.line, e.col,
                    "`swap` takes two places");
                c = rty_prim(c, 9);
                c.res2 = 0; c.res3 = 0;
                return c;
            }
            let a0 = carg(c, p, e, nt, 0);
            let a1 = carg(c, p, e, nt, 1);
            let bad: u8 = 0;
            let q2: u64 = 0;
            while q2 < 2 {
                let ax = a0;
                if q2 == 1 { ax = a1; }
                let axe = xexp(c, p, ax);
                let axk = ek_num(axe.kind);
                if axk != 2 && axk != 7 && axk != 8 && axk != 16 {
                    c = pdiag_s(c, axe.line, axe.col,
                        "`swap` operand is not a place");
                    bad = 1;
                }
                q2 = q2 + 1;
            }
            if bad == 1 {
                c = rty_prim(c, 9);
                c.res2 = 0; c.res3 = 0;
                return c;
            }
            c = place_tv(c, p, a0);
            let ta = c.res;
            let pak = c.res2; let pav = c.res3;
            c = place_tv(c, p, a1);
            let tb = c.res;
            let pbk = c.res2; let pbv = c.res3;
            if ta == NONE() { c = rty_prim(c, 9); ta = c.res; }
            if tb == NONE() { c = rty_prim(c, 9); tb = c.res; }
            if !resolve.ty_eq(c.r, ta, tb) {
                let m = vec.Vec<u8>::new(c.heap);
                let m2 = resolve.bputs(m,
                    "`swap` needs two places of the same type — ");
                let pt_ = push_ty(m2, c, ta);
                c = pt_.c;
                let m3 = resolve.bputs(pt_.m, " vs ");
                let pt2 = push_ty(m3, c, tb);
                c = pt2.c;
                c = pdiag(c, e.line, e.col, pt2.m.as_slice());
                pt2.m.destroy();
            }
            c = check_store(c, p, a0, a1, tb, u8(pbk), pbv);
            c = check_store(c, p, a1, a0, ta, u8(pak), pav);
            c = require_place_bases(c, p, a0);
            c = require_place_bases(c, p, a1);
            c = require_init(c, p, a0);
            c = require_init(c, p, a1);
            c = resolve_place(c, p, a0);
            let kas = vec.Vec<u32>::new(c.heap);
            let i: u64 = 0;
            while i < u64(c.res4) {
                kas = kas.push(c.pstash.buf[i]);
                i = i + 1;
            }
            if kas.len == 0 {
                c = place_id(c, p, a0);
                if c.res != NONE() { kas = kas.push(c.res); }
            }
            c = resolve_place(c, p, a1);
            let kbs = vec.Vec<u32>::new(c.heap);
            i = 0;
            while i < u64(c.res4) {
                kbs = kbs.push(c.pstash.buf[i]);
                i = i + 1;
            }
            if kbs.len == 0 {
                c = place_id(c, p, a1);
                if c.res != NONE() { kbs = kbs.push(c.res); }
            }
            i = 0;
            while i < kas.len {
                c = use_check(c, p, a0, kas.buf[i]);
                i = i + 1;
            }
            i = 0;
            while i < kbs.len {
                c = use_check(c, p, a1, kbs.buf[i]);
                i = i + 1;
            }
            // disjoint storage only — the `[]`-collapsed self-pair
            // (`swap(v[i], v[j])`) is the index-family swap: its
            // union fact set is invariant under the exchange.
            let ovl: u8 = 0;
            i = 0;
            while i < kas.len {
                let j: u64 = 0;
                while j < kbs.len {
                    let kk = kas.buf[i];
                    let k2 = kbs.buf[j];
                    let skip: u8 = 0;
                    if kk == k2 && k_ends_ii(c, kk) == 1 { skip = 1; }
                    if skip == 0 && overlap(c, kk, k2) == 1 {
                        let m = vec.Vec<u8>::new(c.heap);
                        let m2 = resolve.bputs(m, "cannot swap `");
                        let m3 = tn_into(m2, c, p, a0);
                        let m4 = resolve.bputs(m3, "` with `");
                        let m5 = tn_into(m4, c, p, a1);
                        let m6 = resolve.bputs(m5,
                            "` — the places overlap");
                        c = pdiag(c, e.line, e.col, m6.as_slice());
                        m6.destroy();
                        ovl = 1;
                    }
                    j = j + 1;
                }
                i = i + 1;
            }
            if ovl == 1 {
                kas.destroy(); kbs.destroy();
                c = rty_prim(c, 9);
                c.res2 = 0; c.res3 = 0;
                return c;
            }
            // both packets leave before either place rewrites
            let pka = vec.Vec<LPKT>::new(c.heap);
            i = 0;
            while i < kas.len {
                c = collect_lit_k(c, kas.buf[i]);
                let pr = pkt_drain(c);
                c = pr.c;
                pka = pka.push(pr.pk);
                i = i + 1;
            }
            let pkb = vec.Vec<LPKT>::new(c.heap);
            i = 0;
            while i < kbs.len {
                c = collect_lit_k(c, kbs.buf[i]);
                let pr = pkt_drain(c);
                c = pr.c;
                pkb = pkb.push(pr.pk);
                i = i + 1;
            }
            i = 0;
            while i < kas.len && i < pkb.len {
                let k = kas.buf[i];
                if vhas(kbs, k) == 0 {
                    c = swap_clear(c, k);
                    c = init_set(c, k, 1);
                    if k_is_arg(c, k) == 1 {
                        if vhas(c.iw, k) == 0 { c.iw = c.iw.push(k); }
                    }
                    c = pkt_push(c, pkb.buf[i]);
                    c = record_lit_fields(c, k, e.line, e.col, 1);
                }
                i = i + 1;
            }
            i = 0;
            while i < kbs.len && i < pka.len {
                let k = kbs.buf[i];
                if vhas(kas, k) == 0 {
                    c = swap_clear(c, k);
                    c = init_set(c, k, 1);
                    if k_is_arg(c, k) == 1 {
                        if vhas(c.iw, k) == 0 { c.iw = c.iw.push(k); }
                    }
                    c = pkt_push(c, pka.buf[i]);
                    c = record_lit_fields(c, k, e.line, e.col, 1);
                }
                i = i + 1;
            }
            while pka.len > 0 { pkt_free(pka.pop()); }
            pka.destroy();
            while pkb.len > 0 { pkt_free(pkb.pop()); }
            pkb.destroy();
            kas.destroy(); kbs.destroy();
            c = rty_prim(c, 9);
            c.res2 = 0; c.res3 = 0;
            return c;
        }
        let usp = c.r.rns.buf[u64(vn)];
        let m2: vec.Vec<u8> = vec.Vec<u8>::new(c.heap);
        if vhas(c.r.v_priv, vn) == 0 {
            m2 = resolve.bputs(m2, "undefined function `");
        } else {
            m2 = m2.push(u8(96));
        }
        i = 0;
        while i < u64(usp.len) {
            m2 = m2.push(c.r.rbyt.buf[u64(usp.off) + i]);
            i = i + 1;
        }
        if vhas(c.r.v_priv, vn) == 0 {
            m2 = m2.push(u8(96));
        } else {
            m2 = resolve.bputs(m2, "` is private to its module");
        }
        c = pdiag(c, e.line, e.col, m2.as_slice());
        m2.destroy();
        c = rty_prim(c, 9);
        return c;
    }
    return call_body(c, p, eid, init_ok, fi, vn, na, nt);
}

/// call_body — resolved-function call: per-arg checking, write
/// reborrow parking, summary replay, result typing. Split from
/// check_call so the builtin early-returns don't carry this frame.
fn call_body(own c: Checker, read p: ast.Parser, eid: u32,
             init_ok: u8, fi: u32, vn: u32,
             na: u32, nt: u64) -> Checker {
    let e = xexp(c, p, eid);
    let i: u64 = 0;
    let fd = c.r.fdecls.buf[u64(fi)];
    if u64(na) != u64(fd.ps_len) {
        let m = vec.Vec<u8>::new(c.heap);
        m = m.push(u8(96));
        let vsp = c.r.rns.buf[u64(vn)];
        i = 0;
        while i < u64(vsp.len) {
            m = m.push(c.r.rbyt.buf[u64(vsp.off) + i]);
            i = i + 1;
        }
        m = resolve.bputs(m, "` takes ");
        m = loader.bpush_u64(m, u64(fd.ps_len));
        m = resolve.bputs(m, " argument(s), got ");
        m = loader.bpush_u64(m, u64(na));
        c = pdiag(c, e.line, e.col, m.as_slice());
        m.destroy();
    }
    // N14 — `extern fn`: opaque transform, no summary. `*T` params
    // claim Write on the referent for the call's duration (`*const T`
    // claims Read) as transient `$tmp{i}` edges — same mechanics the
    // capability contracts use (stage-0's extern_call).
    if fd.ext != 0 {
        i = 0;
        while i < u64(na) {
            let a = carg(c, p, e, nt, i);
            let ae = xexp(c, p, a);
            c.cboff = c.cboff.push(u32(c.cbases.len));
            c.cblen = c.cblen.push(u32(0));
            if i >= u64(fd.ps_len) { i = i + 1; continue; }
            let pr = c.r.params.buf[u64(fd.ps_off) + i];
            let wt = c.r.rtys.buf[u64(pr.ty)];
            if wt.kind != 16 {
                // scalar param — plain value argument
                c = expr_tv_w(c, p, a, pr.ty, init_ok);
                let got = c.res;
                if got != NONE()
                    && c.r.rtys.buf[u64(got)].kind == 22 {
                    let m = vec.Vec<u8>::new(c.heap);
                    let m2 = resolve.bputs(m,
                        "a lock guard cannot cross a call boundary");
                    c = pdiag(c, ae.line, ae.col, m2.as_slice());
                    m2.destroy();
                }
                c = coerce(c, p, pr.ty, a, got);
                i = i + 1; continue;
            }
            // `*T` param — mutable claims Write, `*const` claims Read
            let req: u8 = 1;
            if wt.b != 0 { req = 2; }
            let elem = wt.a;
            let ev: u8 = 0;                  // elem is void
            if c.r.rtys.buf[u64(elem)].kind == 9 { ev = 1; }
            let ak = ek_num(ae.kind);
            let claimed: u8 = 0;
            if ak == 11 {                   // `&place` / `&mut place`
                if wt.b != 0 && ae.a == 0 {
                    let m = vec.Vec<u8>::new(c.heap);
                    m = m.push(u8(96));
                    m = push_rname(m, c, vn);
                    let m2 = resolve.bputs(m,
                        "` wants a writable `*T` — pass `&mut`");
                    c = pdiag(c, ae.line, ae.col, m2.as_slice());
                    m2.destroy();
                }
                c = place_tv(c, p, ae.b);
                let got = c.res;
                if ev == 0 {
                    c = coerce(c, p, elem, ae.b, got);
                }
                c = cap_check(c, p, ae.b, req);
                let n2 = c.res4;
                let q: u64 = 0;
                while q < u64(n2) {
                    c.cbases = c.cbases.push(c.pstash.buf[q]);
                    q = q + 1;
                }
                c.cblen.buf[i] = u32(n2);
                claimed = 1;
            }
            if ak == 12 {                   // `handle <place>`
                c = place_tv(c, p, ae.b);
                let got = c.res;
                if ev == 0 && (got == NONE()
                    || c.r.rtys.buf[u64(got)].kind != 18) {
                    c = coerce(c, p, elem, ae.b, got);
                }
                c = cap_check(c, p, ae.b, req);
                let n2 = c.res4;
                let q: u64 = 0;
                while q < u64(n2) {
                    c.cbases = c.cbases.push(c.pstash.buf[q]);
                    q = q + 1;
                }
                c.cblen.buf[i] = u32(n2);
                claimed = 1;
            }
            if ak == 3 {                    // `"lit"` — read-only
                if wt.b != 0 {
                    let m = vec.Vec<u8>::new(c.heap);
                    m = m.push(u8(96));
                    m = push_rname(m, c, vn);
                    let m2 = resolve.bputs(m,
                        "` wants a writable `*T` — a string literal is `*const`");
                    c = pdiag(c, ae.line, ae.col, m2.as_slice());
                    m2.destroy();
                }
                if ev == 0
                    && c.r.rtys.buf[u64(elem)].kind != 0 {
                    let m = vec.Vec<u8>::new(c.heap);
                    let m2 = resolve.bputs(m,
                        "string literal is `*const u8`, not `");
                    let t1 = push_ty(m2, c, pr.ty);
                    c = t1.c;
                    let m3 = t1.m.push(u8(96));
                    c = pdiag(c, ae.line, ae.col, m3.as_slice());
                    m3.destroy();
                }
            }
            // `0` — C's null pointer constant; no claim.
            let isptr: u8 = 0;
            if ak == 7 {                    // `s.ptr` — span claim
                c.r = resolve.intern_pname(c.r, p, ae.b);
                if nid_lit_eq(c, c.r.res, "ptr") {
                    c = ety_at(c, p, ae.a);
                    if c.res != NONE() {
                        let sbk = c.r.rtys.buf[u64(c.res)].kind;
                        if sbk == 17 || sbk == 25 { isptr = 1; }
                    }
                }
            }
            if isptr == 1 {
                // the slice's span rides along: a `*T` callee can
                // write through it — the FFI contract claims the
                // whole span the slice's edges name.
                c = ety_at(c, p, a);
                let gt = c.res;
                if gt != NONE() {
                    let g = c.r.rtys.buf[u64(gt)];
                    if g.kind == 16 {
                        if wt.b != 0 && g.b == 0 {
                            let m = vec.Vec<u8>::new(c.heap);
                            m = m.push(u8(96));
                            m = push_rname(m, c, vn);
                            let m2 = resolve.bputs(m,
                                "` wants a writable `*T`, found `");
                            let t1 = push_ty(m2, c, gt);
                            c = t1.c;
                            let m3 = t1.m.push(u8(96));
                            c = pdiag(c, ae.line, ae.col,
                                m3.as_slice());
                            m3.destroy();
                        }
                        if ev == 0
                            && c.r.rtys.buf[u64(g.a)].kind != 9 {
                            let teq: u8 = 0;
                            if resolve.ty_eq(c.r, g.a, elem) {
                                teq = 1;
                            }
                            if teq == 0 {
                                let m = vec.Vec<u8>::new(c.heap);
                                let m2 = resolve.bputs(m,
                                    "type mismatch: expected `");
                                let t1 = push_ty(m2, c, elem);
                                c = t1.c;
                                let m3 = resolve.bputs(t1.m,
                                    "`, found `");
                                let t2 = push_ty(m3, c, gt);
                                c = t2.c;
                                let m4 = t2.m.push(u8(96));
                                c = pdiag(c, ae.line, ae.col,
                                    m4.as_slice());
                                m4.destroy();
                            }
                        }
                    }
                }
                // holders = resolved base keys ∪ path_holders(base)
                c = resolve_place(c, p, ae.a);
                let hvec = vec.Vec<u32>::new(c.heap);
                let q: u64 = 0;
                while q < u64(c.res4) {
                    if vhas(hvec, c.pstash.buf[q]) == 0 {
                        hvec = hvec.push(c.pstash.buf[q]);
                    }
                    q = q + 1;
                }
                c = path_holders(c, p, ae.a);
                q = 0;
                while q < c.hstash.len {
                    if vhas(hvec, c.hstash.buf[q]) == 0 {
                        hvec = hvec.push(c.hstash.buf[q]);
                    }
                    q = q + 1;
                }
                // `box slice`'s span IS its root — no edge hop;
                // a `slice` claims through its edge targets.
                c = ety_at(c, p, ae.a);
                let bx: u8 = 0;
                if c.res != NONE()
                    && c.r.rtys.buf[u64(c.res)].kind == 25 {
                    bx = 1;
                }
                let ts = vec.Vec<u32>::new(c.heap);
                if bx == 1 {
                    c = resolve_place(c, p, ae.a);
                    q = 0;
                    while q < u64(c.res4) {
                        if vhas(ts, c.pstash.buf[q]) == 0 {
                            ts = ts.push(c.pstash.buf[q]);
                        }
                        q = q + 1;
                    }
                } else {
                    q = 0;
                    while q < hvec.len {
                        let hh = hvec.buf[q];
                        let q2: u64 = 0;
                        while q2 < c.edges.len {
                            let ed = c.edges.buf[q2];
                            if ed.h == hh && vhas(ts, ed.t) == 0 {
                                ts = ts.push(ed.t);
                            }
                            q2 = q2 + 1;
                        }
                        q = q + 1;
                    }
                }
                // every other claim on the span conflicts — the
                // slice's own edge is the authority (a holder).
                q = 0;
                while q < ts.len {
                    let t = ts.buf[q];
                    c = edges_to(c, t);
                    let q2: u64 = 0;
                    while q2 < u64(c.res4) {
                        let h2 = c.pstash.buf[q2];
                        if vhas(hvec, h2) == 0 {
                            let m = vec.Vec<u8>::new(c.heap);
                            m = m.push(u8(96));
                            m = push_rname(m, c, vn);
                            let m2 = resolve.bputs(m,
                                "`'s pointer reaches `");
                            let m3 = tn_into(m2, c, p, ae.a);
                            let m4 = resolve.bputs(m3,
                                "`: it is borrowed");
                            c = pdiag(c, ae.line, ae.col,
                                m4.as_slice());
                            m4.destroy();
                        }
                        q2 = q2 + 1;
                    }
                    q = q + 1;
                }
                // claim = ts → cbases
                q = 0;
                while q < ts.len {
                    c.cbases = c.cbases.push(ts.buf[q]);
                    q = q + 1;
                }
                c.cblen.buf[i] = u32(ts.len);
                ts.destroy();
                hvec.destroy();
                claimed = 1;
            }
            if claimed == 0 && ak != 3 && ak != 11 && ak != 12
                && (ak != 0 || ae.w != 0) {
                // pointer-ish values: `*T`, `&T`, `handle T` — ref/
                // handle vars carry real authority; foreign `*T`s
                // carry none (already opaque).
                c = expr_tv_w(c, p, a, pr.ty, init_ok);
                let got = c.res;
                let gk: u8 = 99;
                if got != NONE() {
                    gk = c.r.rtys.buf[u64(got)].kind;
                }
                if gk == 16 || gk == 15 {
                    let g = c.r.rtys.buf[u64(got)];
                    if wt.b != 0 && g.b == 0 {
                        let m = vec.Vec<u8>::new(c.heap);
                        m = m.push(u8(96));
                        m = push_rname(m, c, vn);
                        let m2 = resolve.bputs(m,
                            "` wants a writable `*T`, found `");
                        let t1 = push_ty(m2, c, got);
                        c = t1.c;
                        let m3 = t1.m.push(u8(96));
                        c = pdiag(c, ae.line, ae.col, m3.as_slice());
                        m3.destroy();
                    }
                    if ev == 0 && c.r.rtys.buf[u64(g.a)].kind != 9 {
                        let teq: u8 = 0;
                        if resolve.ty_eq(c.r, g.a, elem) { teq = 1; }
                        if teq == 0 {
                            let m = vec.Vec<u8>::new(c.heap);
                            let m2 = resolve.bputs(m,
                                "type mismatch: expected `");
                            let t1 = push_ty(m2, c, elem);
                            c = t1.c;
                            let m3 = resolve.bputs(t1.m, "`, found `");
                            let t2 = push_ty(m3, c, got);
                            c = t2.c;
                            let m4 = t2.m.push(u8(96));
                            c = pdiag(c, ae.line, ae.col, m4.as_slice());
                            m4.destroy();
                        }
                    }
                    if gk == 15 {
                        c = refs_of(c, p, a);
                        if c.lrefs_has == 1 {
                            let q: u64 = 0;
                            while q < c.lrefs_to.len {
                                c.cbases = c.cbases.push(
                                    c.lrefs_to.buf[q]);
                                q = q + 1;
                            }
                            c.cblen.buf[i] = u32(c.lrefs_to.len);
                        }
                    }
                } else { if gk == 18 {
                    c = caps_of(c, p, a);
                    let q: u64 = 0;
                    while q < c.lcaps.len {
                        c.cbases = c.cbases.push(c.lcaps.buf[q]);
                        q = q + 1;
                    }
                    c.cblen.buf[i] = u32(c.lcaps.len);
                } else {
                    c = coerce(c, p, pr.ty, a, got);
                }}
            }
            // `$tmp{i}` edges over this arg's claim — torn down
            // with ahold after the call.
            if u64(c.cblen.buf[i]) > 0 {
                c = key_tmp(c, u32(i));
                let h = c.res;
                let bo = u64(c.cboff.buf[i]);
                let q: u64 = 0;
                while q < u64(c.cblen.buf[i]) {
                    c = edge_set0(c, h,
                        c.cbases.buf[bo + q], req, 1,
                        e.line, e.col, 1);
                    q = q + 1;
                }
                c.ahold = c.ahold.push(h);
            }
            i = i + 1;
        }
        i = 0;
        while i < c.ahold.len {
            c = edges_retain_eq(c, c.ahold.buf[i]);
            i = i + 1;
        }
        c.res = fd.ret; c.res2 = 0; c.res3 = 0;
        return c;
    }
    // rprov — the joined prov of ref-bearing args
    let rp_set: u8 = 0;
    let rpk: u8 = 0; let rpv: u32 = 0;
    i = 0;
    while i < u64(na) {
        let a = carg(c, p, e, nt, i);
        let ae = xexp(c, p, a);
        // bases[i] — slot filled below
        c.cboff = c.cboff.push(u32(c.cbases.len));
        c.cblen = c.cblen.push(u32(0));
        if i >= u64(fd.ps_len) { i = i + 1; continue; }
        let pr = c.r.params.buf[u64(fd.ps_off) + i];
        if pr.auth == 1 || pr.auth == 2 {
            // capability param — place contract
            let ak = ek_num(ae.kind);
            if rv_find(c, a) != NONE() { ak = 2; }
            if ak != 2 && ak != 7 && ak != 8 && ak != 16 {
                let m = vec.Vec<u8>::new(c.heap);
                m = m.push(u8(96));
                if pr.auth == 1 {
                    m = resolve.bputs(m, "read");
                } else {
                    m = resolve.bputs(m, "write");
                }
                m = resolve.bputs(m,
                    "` parameter takes a place (a variable or path)");
                c = pdiag(c, ae.line, ae.col, m.as_slice());
                m.destroy();
            }
            c = place_tv(c, p, a);
            let got = c.res;
            c = coerce(c, p, pr.ty, a, got);
            if pr.auth != 2 { c = require_init(c, p, a); }
            c = cap_check(c, p, a, pr.auth);
            let n2 = c.res4;
            let q: u64 = 0;
            while q < u64(n2) {
                c.cbases = c.cbases.push(c.pstash.buf[q]);
                q = q + 1;
            }
            c.cblen.buf[i] = u32(n2);
            // rprov — join place_req
            c = place_req(c, p, a);
            if rp_set == 0 {
                rpk = u8(c.res2); rpv = c.res3; rp_set = 1;
            } else {
                c = jprov(c, rpk, rpv, u8(c.res2), c.res3);
                rpk = u8(c.res); rpv = u32(c.res2);
            }
            // write reborrow — park the derivation source
            if pr.auth == 2 {
                c = derivation_source(c, p, a);
                let src = c.res;
                if src != NONE() {
                    let eoff = u32(c.reb_edges.len);
                    let q2: u64 = 0;
                    while q2 < c.edges.len {
                        let ed = c.edges.buf[q2];
                        if kprefix(c, src, ed.h) == 1 {
                            c.reb_edges = c.reb_edges.push(ed);
                        }
                        q2 = q2 + 1;
                    }
                    let elen = u32(c.reb_edges.len) - eoff;
                    let coff = u32(c.reb_caps.len);
                    q2 = 0;
                    while q2 < c.caps.len {
                        let cp = c.caps.buf[q2];
                        if kprefix(c, src, cp.h) == 1 {
                            c.reb_caps = c.reb_caps.push(cp);
                        }
                        q2 = q2 + 1;
                    }
                    let clen = u32(c.reb_caps.len) - coff;
                    c = kill_set(c, src, 1);
                    c = capkill_set(c, src, 1);
                    c = apply_kill(c, src, 1);
                    c = apply_cap_kill(c, src, 1);
                    c.rebs = c.rebs.push(Reb {
                        src: src, eoff: eoff, elen: elen,
                        coff: coff, clen: clen });
                }
            }
            // $tmp{i} edges over ts
            c = key_tmp(c, u32(i));
            let h = c.res;
            let q: u64 = u64(c.cblen.buf[i]);
            let bo = c.cboff.buf[i];
            let q2: u64 = 0;
            while q2 < q {
                let t = c.cbases.buf[u64(bo) + q2];
                c = edge_set0(c, h, t, pr.auth, 1,
                              e.line, e.col, 1);
                q2 = q2 + 1;
            }
            c.ahold = c.ahold.push(h);
        }
        if pr.auth == 3 {                       // own — transfer
            c = resolve_place(c, p, a);
            let n2 = c.res4;
            let q: u64 = 0;
            while q < u64(n2) {
                c.cbases = c.cbases.push(c.pstash.buf[q]);
                q = q + 1;
            }
            c.cblen.buf[i] = u32(n2);
            c = expr_tv_w(c, p, a, pr.ty, init_ok);
            let got = c.res;
            // a lock guard cannot cross a call boundary
            if got != NONE()
                && c.r.rtys.buf[u64(got)].kind == 22 {
                let m = vec.Vec<u8>::new(c.heap);
                let m2 = resolve.bputs(m,
                    "a lock guard cannot cross a call boundary");
                c = pdiag(c, ae.line, ae.col, m2.as_slice());
                m2.destroy();
            }
            c = coerce(c, p, pr.ty, a, got);
            c = consume_place(c, p, a);
        }
        if pr.auth == 0 {                       // plain value arg
            c = expr_tv_w(c, p, a, pr.ty, init_ok);
            let got = c.res;
            let gpk = u8(c.res2); let gpv = c.res3;
            if got != NONE()
                && c.r.rtys.buf[u64(got)].kind == 22 {
                let m = vec.Vec<u8>::new(c.heap);
                let m2 = resolve.bputs(m,
                    "a lock guard cannot cross a call boundary");
                c = pdiag(c, ae.line, ae.col, m2.as_slice());
                m2.destroy();
            }
            c = coerce(c, p, pr.ty, a, got);
            c = consume_owned_src(c, p, a, ae.line, ae.col);
            let wt = c.r.rtys.buf[u64(pr.ty)];
            if wt.kind == 18 {                  // handle — caps
                c = caps_of(c, p, a);
                let q: u64 = 0;
                while q < c.lcaps.len {
                    c.cbases = c.cbases.push(c.lcaps.buf[q]);
                    q = q + 1;
                }
                c.cblen.buf[i] = u32(c.lcaps.len);
            }
            if wt.kind == 15 || wt.kind == 17 || wt.kind == 10 {
                // ref/slice/str — targets ride as bases
                c = refs_of(c, p, a);
                if c.lrefs_has == 1 {
                    let q: u64 = 0;
                    while q < c.lrefs_to.len {
                        c.cbases = c.cbases.push(c.lrefs_to.buf[q]);
                        q = q + 1;
                    }
                    c.cblen.buf[i] = u32(c.lrefs_to.len);
                }
                if rp_set == 0 {
                    rpk = gpk; rpv = gpv; rp_set = 1;
                } else {
                    c = jprov(c, rpk, rpv, gpk, gpv);
                    rpk = u8(c.res); rpv = u32(c.res2);
                }
                if ek_num(ae.kind) == 11 {
                    // &place arg — require_init unless mut; $tmp edge
                    if ae.a == 0 {
                        c = require_init(c, p, ae.b);
                    }
                    c = key_tmp(c, u32(i));
                    let h = c.res;
                    c = refs_of(c, p, a);
                    if c.lrefs_has == 1 {
                        c = record_edges(c, h, ae.line, ae.col, 1);
                        c.ahold = c.ahold.push(h);
                    }
                }
                if ek_num(ae.kind) == 2 {
                    // mut-ref Var arg — the callee retains authority
                    c.r = resolve.intern_pname(c.r, p, ae.a);
                    let vn = c.r.res;
                    let bi = bfind(c, vn);
                    if i64(bi) >= 0 {
                        let b = c.binds.buf[u64(bi)];
                        let bt = c.r.rtys.buf[u64(b.ty)];
                        if (bt.kind == 15 || bt.kind == 17)
                            && bt.b != 0 && b.auth == 0 {
                            c = key_of(c, vn, b.epoch);
                            let kk = c.res;
                            c = kill_set(c, kk, 1);
                            c = edges_retain_eq(c, kk);
                        }
                    }
                }
            }
        }
        i = i + 1;
    }
    // arg-holder teardown
    i = 0;
    while i < c.ahold.len {
        c = edges_retain_eq(c, c.ahold.buf[i]);
        i = i + 1;
    }
    // summary replay
    let si = sums_get(c, vn);
    if si != NONE() {
        let fs = c.fsums.buf[u64(si)];
        c = replay_summary(c, fs, e.line, e.col);
        // ret_lit_* — enum/struct returns carry per-variant payload
        // refs/caps/provs; they ride the lit channels so `let r = f()`
        // records `r.Ok`-rooted facts (targets translate like edges).
        i = 0;
        while i < u64(fs.lelen) {
            let rl = c.sm_rle.buf[u64(fs.leoff) + i];
            let ri0 = c.rinfos.buf[u64(rl.ri)];
            let toff = u32(c.ri_to.len);
            let q: u64 = 0;
            while q < u64(ri0.tlen) {
                let t = c.ri_to.buf[u64(ri0.toff) + q];
                c = tkey(c, t);
                if c.tk_out.len == 0 {
                    let dup: u8 = 0;
                    let j: u64 = u64(toff);
                    while j < c.ri_to.len {
                        if c.ri_to.buf[j] == t { dup = 1; }
                        j = j + 1;
                    }
                    if dup == 0 { c.ri_to = c.ri_to.push(t); }
                } else {
                    let j: u64 = 0;
                    while j < c.tk_out.len {
                        let u = c.tk_out.buf[j];
                        let dup: u8 = 0;
                        let q2: u64 = u64(toff);
                        while q2 < c.ri_to.len {
                            if c.ri_to.buf[q2] == u { dup = 1; }
                            q2 = q2 + 1;
                        }
                        if dup == 0 { c.ri_to = c.ri_to.push(u); }
                        j = j + 1;
                    }
                }
                q = q + 1;
            }
            c.rinfos = c.rinfos.push(RefInf {
                toff: toff, tlen: u32(c.ri_to.len) - toff,
                mut_: ri0.mut_, mf: NONE(), foreign: ri0.foreign });
            c.lit_edges = c.lit_edges.push(RLE {
                rel: rl.rel, ri: u32(c.rinfos.len) - 1 });
            i = i + 1;
        }
        i = 0;
        while i < u64(fs.lclen) {
            let rl = c.sm_rlc.buf[u64(fs.lcoff) + i];
            let coff = u32(c.rlc_keys.len);
            let q: u64 = 0;
            while q < u64(rl.len) {
                let t = c.rlc_keys.buf[u64(rl.off) + q];
                c = tkey(c, t);
                if c.tk_out.len == 0 {
                    let dup: u8 = 0;
                    let j: u64 = u64(coff);
                    while j < c.rlc_keys.len {
                        if c.rlc_keys.buf[j] == t { dup = 1; }
                        j = j + 1;
                    }
                    if dup == 0 { c.rlc_keys = c.rlc_keys.push(t); }
                } else {
                    let j: u64 = 0;
                    while j < c.tk_out.len {
                        let u = c.tk_out.buf[j];
                        let dup: u8 = 0;
                        let q2: u64 = u64(coff);
                        while q2 < c.rlc_keys.len {
                            if c.rlc_keys.buf[q2] == u { dup = 1; }
                            q2 = q2 + 1;
                        }
                        if dup == 0 {
                            c.rlc_keys = c.rlc_keys.push(u);
                        }
                        j = j + 1;
                    }
                }
                q = q + 1;
            }
            c.lit_caps = c.lit_caps.push(RLE2 {
                rel: rl.rel, off: coff,
                len: u32(c.rlc_keys.len) - coff });
            i = i + 1;
        }
        i = 0;
        while i < u64(fs.lplen) {
            let pv = c.sm_rlp.buf[u64(fs.lpoff) + i];
            c.last_lit = c.last_lit.push(pv);
            i = i + 1;
        }
        // unpark reborrows — summary exists
        i = 0;
        while i < c.rebs.len {
            let rb = c.rebs.buf[i];
            c = unkill(c, rb.src);
            c = uncapkill(c, rb.src);
            let q: u64 = 0;
            while q < u64(rb.elen) {
                let ed = c.reb_edges.buf[u64(rb.eoff) + q];
                c = edge_set0(c, ed.h, ed.t, ed.kind, ed.cert,
                              ed.bl, ed.bc, 1);
                q = q + 1;
            }
            q = 0;
            while q < u64(rb.clen) {
                let cp = c.reb_caps.buf[u64(rb.coff) + q];
                c = cap_set(c, cp.h, cp.t, cp.cert);
                q = q + 1;
            }
            i = i + 1;
        }
        if fs.diverges == 1 {
            c.diverged = 1;
            c.terminated = 1;
            c = rec_flags(c);
        }
    }
    // result — callee ret ty; prov = rprov or current region
    if rp_set == 1 { c.res2 = u32(rpk); c.res3 = rpv; }
    else { c.res2 = 2; c.res3 = cur_region(c); }
    c.res = fd.ret;
    return c;
}

// ---- refs/caps/len side channels ------------------------------------------

/// refs_of — fills lrefs_*; has=1 when the expr carries ref info.
/// name nid == literal bytes? `e.b` field-name checks.
fn nid_is(read c: Checker, nid: u32, lit: str) -> u8 {
    let sp = c.r.rns.buf[u64(nid)];
    if u64(sp.len) != u64(lit.len) { return 0; }
    let i: u64 = 0;
    while i < u64(sp.len) {
        if c.r.rbyt.buf[u64(sp.off) + i] != lit.bytes[i] { return 0; }
        i = i + 1;
    }
    return 1;
}

fn refs_of(own c: Checker, read p: ast.Parser, eid: u32) -> Checker {
    let e = xexp(c, p, eid);
    let kind = ek_num(e.kind);
    c.lrefs_has = 0;
    while c.lrefs_to.len > 0 { c.lrefs_to.pop(); }
    c.lrefs_mut = 0; c.lrefs_mf = NONE(); c.lrefs_foreign = 0;
    if kind == 11 {                         // AddrOf — a=mut, b=place
        c = resolve_place(c, p, e.b);
        let n = c.res4;
        if n == 0 {
            c = kstr(c, "*?");
            c.lrefs_to = c.lrefs_to.push(c.res);
        } else {
            let i: u64 = 0;
            while i < u64(n) {
                c.lrefs_to = c.lrefs_to.push(c.pstash.buf[i]);
                i = i + 1;
            }
        }
        c.lrefs_mut = u8(e.a);
        c.lrefs_has = 1;
        if e.a != 0 {
            c = derivation_source(c, p, e.b);
            c.lrefs_mf = c.res;
        }
        return c;
    }
    if kind == 22 {                         // Match — joined yield
        let i: u64 = 0;
        while i < c.myields.len {
            let my = c.myields.buf[i];
            if my.line == e.line && my.col == e.col {
                let mz = u64(my.z);
                if c.myinfos.buf[mz].ri_has == 1 {
                    let q: u64 = 0;
                    while q < c.myinfos.buf[mz].ri_to.len {
                        c.lrefs_to = c.lrefs_to.push(
                            c.myinfos.buf[mz].ri_to.buf[q]);
                        q = q + 1;
                    }
                    c.lrefs_mut = c.myinfos.buf[mz].ri_mut;
                    c.lrefs_mf = c.myinfos.buf[mz].ri_mf;
                    c.lrefs_foreign = c.myinfos.buf[mz].ri_foreign;
                    c.lrefs_has = 1;
                }
                return c;
            }
            i = i + 1;
        }
        return c;
    }
    if kind == 2 || rv_find(c, eid) != NONE() {
        // Var | $rv temp
        let vn = rv_find(c, eid);
        if vn == NONE() {
            c.r = resolve.intern_pname(c.r, p, e.a);
            vn = c.r.res;
        }
        let bi = bfind(c, vn);
        if i64(bi) < 0 { return c; }
        let b = c.binds.buf[u64(bi)];
        let bt = c.r.rtys.buf[u64(b.ty)];
        if bt.kind != 15 && bt.kind != 17 && bt.kind != 10 {
            return c;
        }
        c.lrefs_mut = 0;
        if (bt.kind == 15 || bt.kind == 17) && bt.b != 0 {
            c.lrefs_mut = 1;
        }
        c = key_of(c, vn, b.epoch);
        let key = c.res;
        if b.auth != 0 {
            // `*{key}` — star-prefixed opaque target
            c = key_pstar(c, key);
            c.lrefs_to = c.lrefs_to.push(c.res);
            c.lrefs_has = 1;
            if c.lrefs_mut != 0 { c.lrefs_mf = key; }
            return c;
        }
        let i: u64 = 0;
        while i < c.edges.len {
            if c.edges.buf[i].h == key {
                c.lrefs_to = c.lrefs_to.push(c.edges.buf[i].t);
            }
            i = i + 1;
        }
        c.lrefs_has = 1;
        if c.lrefs_mut != 0 { c.lrefs_mf = key; }
        if vhas(c.foreign, key) == 1 { c.lrefs_foreign = 1; }
        return c;
    }
    if kind == 7 || kind == 8 {             // Field | Index
        if kind == 7 {
            // `s.bytes` — the str's Read claim rides along on the
            // slice: inherit the base's refs, forced immutable.
            let fe = xexp(c, p, eid);
            c.r = resolve.intern_pname(c.r, p, fe.b);
            let nis = nid_is(c, c.r.res, "bytes");
            if nis == 1 {
                c = ety_at(c, p, fe.a);
                if c.res != NONE() {
                    let bt2 = c.r.rtys.buf[u64(c.res)];
                    if bt2.kind == 10 {
                        c = refs_of(c, p, fe.a);
                        c.lrefs_mut = 0; c.lrefs_mf = NONE();
                        return c;
                    }
                }
            }
        }
        c = place_id(c, p, eid);
        if c.res == NONE() { return c; }
        let key = c.res;
        c = ety_at(c, p, eid);
        if c.res == NONE() { return c; }
        let t = c.r.rtys.buf[u64(c.res)];
        if t.kind != 15 && t.kind != 17 && t.kind != 10 {
            return c;
        }
        c.lrefs_mut = 0;
        if (t.kind == 15 || t.kind == 17) && t.b != 0 {
            c.lrefs_mut = 1;
        }
        let i: u64 = 0;
        while i < c.edges.len {
            if c.edges.buf[i].h == key {
                c.lrefs_to = c.lrefs_to.push(c.edges.buf[i].t);
            }
            i = i + 1;
        }
        c.lrefs_has = 1;
        if c.lrefs_mut != 0 { c.lrefs_mf = key; }
        if vhas(c.foreign, key) == 1 { c.lrefs_foreign = 1; }
        return c;
    }
    if kind == 16 {                         // Deref — `*k` opaque target
        c = place_id(c, p, e.a);
        if c.res == NONE() { return c; }
        let k = c.res;
        c = key_pstar(c, k);
        c.lrefs_to = c.lrefs_to.push(c.res);
        c.lrefs_has = 1;
        c = ety_at(c, p, e.a);
        if c.res != NONE() {
            let t = c.r.rtys.buf[u64(c.res)];
            if t.kind == 15 && t.b != 0 { c.lrefs_mut = 1; }
        }
        return c;
    }
    if kind == 14 {                         // Join — task's ret_edges
        c = place_id(c, p, e.a);
        if c.res == NONE() { return c; }
        let ti = task_find(c, c.res);
        if ti == NONE() { return c; }
        let eff = c.teffs.buf[u64(c.tasks.buf[u64(ti)].eff)];
        if eff.relen == 0 { return c; }
        let i: u64 = u64(eff.reoff);
        while i < u64(eff.reoff) + u64(eff.relen) {
            let km = c.te_re.buf[i];
            c.lrefs_to = c.lrefs_to.push(km.k);
            if km.m != 0 { c.lrefs_mut = 1; }
            i = i + 1;
        }
        c.lrefs_has = 1;
        return c;
    }
    if kind == 6 { c = refs_of_call(c, p, eid); return c; }
    if kind == 19 || kind == 20 {
        // desugared call — cres row identifies MethodCall/assoc-fn
        // targets; a kind-20 without one is an enum variant.
        if cres_find(c, e.line, e.col) != NONE() {
            c = refs_of_call(c, p, eid);
        }
        return c;
    }
    return c;
}

/// refs_of — Call arm (kept out-of-line: union/summary replay).
fn refs_of_call(own c: Checker, read p: ast.Parser, eid: u32) -> Checker {
    let e = xexp(c, p, eid);
        c = callee_of(c, p, eid);
        let vn = c.res;
        // `slice(p, n)` — a trusted assertion over foreign storage:
        // no edges to claim, no authority to transfer.
        if nid_lit_eq(c, vn, "slice") {
            c.lrefs_has = 1;
            c.lrefs_foreign = 1;
            return c;
        }
        // `str_from_utf8(b)` — the str inherits the slice's claim
        // as Read regardless of the slice's own mutability.
        if nid_lit_eq(c, vn, "str_from_utf8") {
            c = call_arg(c, p, e, eid, 0);
            let a0 = c.res;
            c = refs_of(c, p, a0);
            c.lrefs_mut = 0;
            return c;
        }
        // `replace(place, v)` — the result is the OLD value; its
        // root edge was captured before the store rewrote it.
        if nid_lit_eq(c, vn, "replace")
            && vhas(c.r.local_fns, vn) == 0 {
            let i: u64 = 0;
            while i < c.repl_outs.len {
                if c.repl_outs.buf[i].ln == e.line
                    && c.repl_outs.buf[i].cl == e.col {
                    if c.repl_outs.buf[i].ri_to.len > 0
                        || c.repl_outs.buf[i].ri_foreign != 0 {
                        let q: u64 = 0;
                        while q < c.repl_outs.buf[i].ri_to.len {
                            c.lrefs_to = c.lrefs_to.push(
                                c.repl_outs.buf[i].ri_to.buf[q]);
                            q = q + 1;
                        }
                        c.lrefs_mut = c.repl_outs.buf[i].ri_mut;
                        c.lrefs_foreign =
                            c.repl_outs.buf[i].ri_foreign;
                        c.lrefs_has = 1;
                    }
                    return c;
                }
                i = i + 1;
            }
            return c;
        }
        let si = sums_get(c, vn);
        if si != NONE() {
            // summary — ret_edges translated through the call's bases
            let fs = c.fsums.buf[u64(si)];
            if fs.relen > 0 {
                let i: u64 = 0;
                let mutable: u8 = 0;
                while i < u64(fs.relen) {
                    let km = c.sm_re.buf[u64(fs.reoff) + i];
                    c = tkey(c, km.k);
                    if c.tk_out.len == 0 {
                        // opaque `*k` survives untranslated
                        if vhas(c.lrefs_to, km.k) == 0 {
                            c.lrefs_to = c.lrefs_to.push(km.k);
                        }
                    } else {
                        let j: u64 = 0;
                        while j < c.tk_out.len {
                            let u = c.tk_out.buf[j];
                            if vhas(c.lrefs_to, u) == 0 {
                                c.lrefs_to = c.lrefs_to.push(u);
                            }
                            j = j + 1;
                        }
                    }
                    if km.m != 0 { mutable = 1; }
                    i = i + 1;
                }
                if c.lrefs_to.len > 0 {
                    c.lrefs_has = 1;
                    c.lrefs_mut = mutable;
                    return c;
                }
            }
            // empty ret_edges proves the call hands back no refs
            return c;
        }
        // extern — opaque return; no caller-side view
        let fi2 = NONE();
        let j2: u64 = 0;
        while j2 < c.r.fdecls.len {
            let fd2 = c.r.fdecls.buf[j2];
            if fd2.name == vn && vhas(c.vprogs, fd2.prog) == 1 {
                fi2 = u32(j2);
            }
            j2 = j2 + 1;
        }
        if fi2 != NONE()
            && c.r.fdecls.buf[u64(fi2)].ext != 0 { return c; }
        // no summary — union of every ref arg's targets
        let l0 = c.tk_out.len;
        let na = call_nargs(c, p, eid);
        let i: u64 = 0;
        let mutable: u8 = 0;
        while i < na {
            c = call_arg(c, p, e, eid, i);
            let a = c.res;
            c = refs_of(c, p, a);
            if c.lrefs_has == 1 {
                if c.lrefs_mut != 0 { mutable = 1; }
                let j: u64 = 0;
                while j < c.lrefs_to.len {
                    let u = c.lrefs_to.buf[j];
                    let seen: u8 = 0;
                    let q: u64 = l0;
                    while q < c.tk_out.len {
                        if c.tk_out.buf[q] == u { seen = 1; }
                        q = q + 1;
                    }
                    if seen == 0 { c.tk_out = c.tk_out.push(u); }
                    j = j + 1;
                }
            }
            i = i + 1;
        }
        // the last arg's refs still sit in lrefs_to — clear before
        // the deduped union copies back, else they count twice
        while c.lrefs_to.len > 0 { c.lrefs_to.pop(); }
        i = l0;
        while i < c.tk_out.len {
            c.lrefs_to = c.lrefs_to.push(c.tk_out.buf[i]);
            i = i + 1;
        }
        while c.tk_out.len > l0 { c.tk_out.pop(); }
        if c.lrefs_to.len > 0 {
            c.lrefs_has = 1;
            c.lrefs_mut = mutable;
        } else {
            // an empty union is None in Stage-0 — an arg's inner
            // `lrefs_has` (str vars set it even with zero targets)
            // must not leak out and fire a phantom kill on `let`.
            c.lrefs_has = 0;
        }
    return c;
}

/// caps_of — fills lcaps/lcaps_has.
fn caps_of(own c: Checker, read p: ast.Parser, eid: u32) -> Checker {
    let e = xexp(c, p, eid);
    let kind = ek_num(e.kind);
    c.lcaps_has = 0;
    while c.lcaps.len > 0 { c.lcaps.pop(); }
    if kind == 12 {                         // Handle(place)
        c = resolve_place(c, p, e.a);
        let n = c.res4;
        let i: u64 = 0;
        while i < u64(n) {
            c.lcaps = c.lcaps.push(c.pstash.buf[i]);
            i = i + 1;
        }
        c.lcaps_has = 1;
        return c;
    }
    if kind == 22 {                         // Match — joined yield
        let i: u64 = 0;
        while i < c.myields.len {
            let my = c.myields.buf[i];
            if my.line == e.line && my.col == e.col {
                let mz = u64(my.z);
                if c.myinfos.buf[mz].cap_has == 1 {
                    let q: u64 = 0;
                    while q < c.myinfos.buf[mz].caps.len {
                        c.lcaps = c.lcaps.push(
                            c.myinfos.buf[mz].caps.buf[q]);
                        q = q + 1;
                    }
                    c.lcaps_has = 1;
                }
                return c;
            }
            i = i + 1;
        }
        return c;
    }
    if kind == 2 || rv_find(c, eid) != NONE() {
        // Var | $rv temp
        let vn = rv_find(c, eid);
        if vn == NONE() {
            c.r = resolve.intern_pname(c.r, p, e.a);
            vn = c.r.res;
        }
        let bi = bfind(c, vn);
        if i64(bi) < 0 { return c; }
        let b = c.binds.buf[u64(bi)];
        if c.r.rtys.buf[u64(b.ty)].kind != 18 { return c; }
        c = key_of(c, vn, b.epoch);
        let key = c.res;
        let i: u64 = 0;
        while i < c.caps.len {
            if c.caps.buf[i].h == key {
                c.lcaps = c.lcaps.push(c.caps.buf[i].t);
            }
            i = i + 1;
        }
        c.lcaps_has = 1;
        return c;
    }
    if kind == 7 || kind == 8 {
        c = place_id(c, p, eid);
        if c.res == NONE() { return c; }
        let key = c.res;
        c = ety_at(c, p, eid);
        if c.res == NONE() { return c; }
        if c.r.rtys.buf[u64(c.res)].kind != 18 { return c; }
        let i: u64 = 0;
        while i < c.caps.len {
            if c.caps.buf[i].h == key {
                c.lcaps = c.lcaps.push(c.caps.buf[i].t);
            }
            i = i + 1;
        }
        c.lcaps_has = 1;
        return c;
    }
    if kind == 14 {                         // Join — task's ret_caps
        c = place_id(c, p, e.a);
        if c.res == NONE() { return c; }
        let ti = task_find(c, c.res);
        if ti == NONE() { return c; }
        let eff = c.teffs.buf[u64(c.tasks.buf[u64(ti)].eff)];
        let i: u64 = u64(eff.rcoff);
        while i < u64(eff.rcoff) + u64(eff.rclen) {
            let t = c.te_rc.buf[i];
            if vhas(c.lcaps, t) == 0 {
                c.lcaps = c.lcaps.push(t);
            }
            i = i + 1;
        }
        if c.lcaps.len > 0 { c.lcaps_has = 1; }
        return c;
    }
    if kind == 6 || kind == 19 || kind == 20 {
        // Call | MethodCall | assoc-fn — summary ret_caps. A kind-20
        // without a cres row is an enum variant — no caller caps.
        c = callee_of(c, p, eid);
        if kind != 6 && c.res == NONE() { return c; }
        let vn = c.res;
        // `replace` — the OLD packet's ""-level caps ride the result
        if kind == 6 && nid_lit_eq(c, vn, "replace")
            && vhas(c.r.local_fns, vn) == 0 {
            let i: u64 = 0;
            while i < c.repl_outs.len {
                if c.repl_outs.buf[i].ln == e.line
                    && c.repl_outs.buf[i].cl == e.col {
                    let q: u64 = 0;
                    while q < c.repl_outs.buf[i].caps.len {
                        c.lcaps = c.lcaps.push(
                            c.repl_outs.buf[i].caps.buf[q]);
                        q = q + 1;
                    }
                    if c.lcaps.len > 0 { c.lcaps_has = 1; }
                    return c;
                }
                i = i + 1;
            }
            return c;
        }
        let si = sums_get(c, vn);
        let have_ret: u8 = 0;
        if si != NONE() {
            let fs = c.fsums.buf[u64(si)];
            let i: u64 = 0;
            while i < u64(fs.rclen) {
                let t = c.sm_rc.buf[u64(fs.rcoff) + i];
                c = tkey(c, t);
                if c.tk_out.len == 0 {
                    if vhas(c.lcaps, t) == 0 {
                        c.lcaps = c.lcaps.push(t);
                    }
                } else {
                    let j: u64 = 0;
                    while j < c.tk_out.len {
                        if vhas(c.lcaps, c.tk_out.buf[j]) == 0 {
                            c.lcaps = c.lcaps.push(c.tk_out.buf[j]);
                        }
                        j = j + 1;
                    }
                }
                i = i + 1;
            }
            if c.lcaps.len > 0 { c.lcaps_has = 1; have_ret = 1; }
            if have_ret == 1 { return c; }
        }
        // extern — an opaque return carries no caller-side caps
        let j2: u64 = 0;
        while j2 < c.r.fdecls.len {
            let fd2 = c.r.fdecls.buf[j2];
            if fd2.name == vn && vhas(c.vprogs, fd2.prog) == 1
                && fd2.ext != 0 {
                return c;
            }
            j2 = j2 + 1;
        }
        // arg union — the callee can only hand back what it was
        // handed (also the empty-ret_caps fallthrough).
        let na = call_nargs(c, p, eid);
        let i: u64 = 0;
        while i < na {
            c = call_arg(c, p, e, eid, i);
            let ae = c.res;
            let inner = vec.Vec<u32>::new(c.heap);
            let q: u64 = 0;
            while q < c.lcaps.len {
                inner = inner.push(c.lcaps.buf[q]);
                q = q + 1;
            }
            c = caps_of(c, p, ae);
            let j: u64 = 0;
            while j < c.lcaps.len {
                if vhas(inner, c.lcaps.buf[j]) == 0 {
                    inner = inner.push(c.lcaps.buf[j]);
                }
                j = j + 1;
            }
            c.lcaps.destroy();
            c.lcaps = inner;
            i = i + 1;
        }
        if c.lcaps.len > 0 { c.lcaps_has = 1; }
        return c;
    }
    return c;
}

/// slice_len_at — the recorded length of a PLACE: Var/Field/Index
/// `place_id` → `slens`; a str's `.bytes` re-reads the str's span.
/// Silent — fills llen/llen_has.
fn slice_len_at(own c: Checker, read p: ast.Parser, eid: u32) -> Checker {
    c.llen_has = 0;
    let e = xexp(c, p, eid);
    if ek_num(e.kind) == 7 {                  // `s.bytes` → the str's len
        c = ety_at(c, p, e.a);
        if c.res != NONE()
            && c.r.rtys.buf[u64(c.res)].kind == 10 {
            c.r = resolve.intern_pname(c.r, p, e.b);
            if nid_lit_eq(c, c.r.res, "bytes") {
                return slice_len_at(c, p, e.a);
            }
        }
    }
    c = place_id(c, p, eid);
    if c.res != NONE() {
        let k = c.res;
        let i: u64 = 0;
        while i < c.slens.len {
            if c.slens.buf[i].k == k {
                c.llen = c.slens.buf[i].n;
                c.llen_has = 1;
                return c;
            }
            i = i + 1;
        }
    }
    return c;
}

/// slice_len_of — fills llen/llen_has.
fn slice_len_of(own c: Checker, read p: ast.Parser, eid: u32) -> Checker {
    c.llen_has = 0;
    let e = xexp(c, p, eid);
    if ek_num(e.kind) == 3 {                    // Str literal — byte len
        c.llen = i64(u32(e.b) - e.a);
        c.llen_has = 1;
        return c;
    }
    if ek_num(e.kind) == 11 {                   // AddrOf — &place[lo..hi]
        let pl = p.exps.buf[u64(e.b)];
        if ek_num(pl.kind) == 9 {               // IndexRange
            // limit — array count, else the base's recorded len
            let limit: i64 = 0 - 1;
            c = ety_at(c, p, pl.a);
            if c.res != NONE()
                && c.r.rtys.buf[u64(c.res)].kind == 14 {
                limit = i64(c.r.rtys.buf[u64(c.res)].w);
            }
            if limit < 0 {
                c = slice_len_at(c, p, pl.a);
                if c.llen_has == 1 { limit = c.llen; }
                c.llen_has = 0;
            }
            if limit < 0 { return c; }
            let lov: i64 = 0;
            if pl.b != NONE() {
                let le = p.exps.buf[u64(pl.b)];
                if ek_num(le.kind) != 0 { return c; }
                lov = i64(le.w);
            }
            let hiv: i64 = limit;
            if pl.c != NONE() {
                let he = p.exps.buf[u64(pl.c)];
                if ek_num(he.kind) != 0 { return c; }
                hiv = i64(he.w);
            }
            if hiv >= lov {
                c.llen = hiv - lov;
                c.llen_has = 1;
            }
        }
        return c;
    }
    if ek_num(e.kind) == 17 {                   // Alloc — count Int
        if e.c != NONE() {
            let ce = p.exps.buf[u64(e.c)];
            if ek_num(ce.kind) == 0 {
                c.llen = ce.w;
                c.llen_has = 1;
            }
        }
        return c;
    }
    if ek_num(e.kind) == 22 {                   // Match — myields
        let i: u64 = 0;
        while i < c.myields.len {
            let my = c.myields.buf[i];
            if my.line == e.line && my.col == e.col
                && my.y != NONE() {
                c.llen = i64(c.mylens.buf[u64(my.y)]);
                c.llen_has = 1;
                return c;
            }
            i = i + 1;
        }
        return c;
    }
    if ek_num(e.kind) == 6 || ek_num(e.kind) == 19
        || ek_num(e.kind) == 20 {
        c = callee_of(c, p, eid);
        let vn = c.res;
        // a kind-19/20 without a cres row is an enum variant —
        // no caller-side slice length.
        if ek_num(e.kind) != 6 && vn == NONE() { return c; }
        // `slice(p, n)` — the span's length is the literal count.
        if nid_lit_eq(c, vn, "slice") {
            c = call_arg(c, p, e, eid, 1);
            if c.res != NONE() {
                let a1 = xexp(c, p, c.res);
                if ek_num(a1.kind) == 0 {
                    c.llen = a1.w;
                    c.llen_has = 1;
                }
            }
            return c;
        }
        // `str_from_utf8(b)` — the string's length is the slice's.
        if nid_lit_eq(c, vn, "str_from_utf8") {
            c = call_arg(c, p, e, eid, 0);
            if c.res != NONE() {
                c = slice_len_at(c, p, c.res);
            }
            return c;
        }
        return c;
    }
    if ek_num(e.kind) == 2 || ek_num(e.kind) == 7 || ek_num(e.kind) == 8 {
        return slice_len_at(c, p, eid);
    }
    return c;
}

// ---- place resolution -----------------------------------------------------
// `resolve_place` — the target set a place expr names, through live
// edges/caps. Fills `pstash`; count in res4.

/// raw key text — `kin` over a str's bytes (no quoting).
fn kstr(own c: Checker, s: str) -> Checker {
    let i: u64 = 0;
    while i < s.bytes.len {
        c.ksc = c.ksc.push(u8(s.bytes[i]));
        i = i + 1;
    }
    let n = u64(c.ksc.len);
    c = kin(c, &c.ksc.buf[0..n]);
    while c.ksc.len > 0 { c.ksc.pop(); }
    return c;
}

/// `key` + literal suffix — `k` ++ `s`.
fn key_cat(own c: Checker, k: u32, s: str) -> Checker {
    let sp = c.kns.buf[u64(k)];
    let i: u64 = 0;
    while i < u64(sp.len) {
        c.ksc = c.ksc.push(c.kbyt.buf[u64(sp.off) + i]);
        i = i + 1;
    }
    i = 0;
    while i < s.bytes.len {
        c.ksc = c.ksc.push(u8(s.bytes[i]));
        i = i + 1;
    }
    let n = u64(c.ksc.len);
    c = kin(c, &c.ksc.buf[0..n]);
    while c.ksc.len > 0 { c.ksc.pop(); }
    return c;
}

/// resolve_place — Var/Field/Index/Deref/AddrOf-target set.
/// Follows each live out-edge of the place's own key transitively
/// (sorted at return for canonical order).
/// expr_ty_at — the expr's ty WITHOUT authority side effects for
/// Var/Field/Index bases (place_tv is the silent path).
fn place_tv(own c: Checker, read p: ast.Parser, eid: u32) -> Checker {
    c.res = NONE(); c.res2 = 0; c.res3 = 0;
    let e = xexp(c, p, eid);
    let kind = ek_num(e.kind);
    if kind == 2 || rv_find(c, eid) != NONE() {
        // Var | $rv temp
        let vn = rv_find(c, eid);
        if vn == NONE() {
            c.r = resolve.intern_pname(c.r, p, e.a);
            vn = c.r.res;
        }
        let bi = bfind(c, vn);
        if i64(bi) < 0 {
            c = rty_prim(c, 9);
            return c;
        }
        let b = c.binds.buf[u64(bi)];
        c.res = b.ty; c.res2 = u32(b.prov_k); c.res3 = b.prov_v;
        return c;
    }
    if kind == 7 {                              // Field
        c = place_tv(c, p, e.a);
        let bt = c.res;
        if bt == NONE() { return c; }
        c.r = resolve.intern_pname(c.r, p, e.b);
        let fnid = c.r.res;
        let bn = c.r.rtys.buf[u64(bt)];
        let vfty: u32 = NONE();
        // enum-typed base: payload access needs the static tag
        if bn.kind == 12 || bn.kind == 13 {
            let eni = is_enum_ty(c, bt);
            if eni == 1 {
                // variant `f` w/ payload → require tag; store in res4
                let ei = edecl_of(c, bn.name);
                if ei != NONE() {
                    let ed = c.r.edecls.buf[u64(ei)];
                    // instantiated payload tys — `x.Some` on
                    // `Maybe<i32>` has field-ty `i32`.
                    let fvoff = u64(ed.vs_off);
                    if bn.kind == 13 {
                        fvoff = c.r.vars.len;
                        c.r = resolve.subst_variants(
                            c.r, ei, bn.b, bn.c);
                        if c.r.suberr != 0 {
                            fvoff = u64(ed.vs_off);
                        }
                    }
                    let j: u64 = 0;
                    while j < u64(ed.vs_len) {
                        let vd = c.r.vars.buf[
                            fvoff + j];
                        if vd.name == fnid {
                            // variant matched — `field_ty` must not
                            // also run: Stage-0's `structs.get(en)`
                            // misses enums and yields Void silently.
                            if vd.ty == NONE() {
                                c = rty_prim(c, 9);
                                vfty = c.res;
                                let m = vec.Vec<u8>::new(c.heap);
                                let m2 = resolve.bputs(m,
                                    "variant `");
                                let m3 = resolve.bpush(m2,
                                    rns_bytes(c, fnid));
                                let m4 = resolve.bputs(m3,
                                    "` of `");
                                let m5 = resolve.bpush(m4,
                                    rns_bytes(c, bn.name));
                                let m6 = resolve.bputs(m5,
                                    "` carries no payload");
                                c = pdiag(c, e.line, e.col,
                                    m6.as_slice());
                                m6.destroy();
                            } else {
                                vfty = vd.ty;
                                c = resolve_place(c, p, e.a);
                                let bi: u64 = 0;
                                while bi < u64(c.res4) {
                                    let bk = c.pstash.buf[bi];
                                    let tv = tagv_at(c, bk);
                                    if tv != fnid {
                                        let m = vec.Vec<u8>::new(
                                            c.heap);
                                        let m2 = resolve.bputs(m,
                                            "cannot access `");
                                        let m3 = resolve.bpush(m2,
                                            rns_bytes(c, fnid));
                                        let m4 = resolve.bputs(m3,
                                            "` payload: active variant is not statically `");
                                        let m5 = resolve.bpush(m4,
                                            rns_bytes(c, fnid));
                                        let m6 = resolve.bputs(m5,
                                            "` — `match` on it first");
                                        c = pdiag(c, e.line, e.col,
                                            m6.as_slice());
                                        m6.destroy();
                                    }
                                    bi = bi + 1;
                                }
                            }
                        }
                        j = j + 1;
                    }
                }
            }
        }
        // `s.bytes` — the str's bytes view (not a place field)
        if bn.kind == 10 {
            let bs = c.r.rns.buf[u64(fnid)];
            if u64(bs.len) == 5
                && c.r.rbyt.buf[u64(bs.off)] == u8(98)
                && c.r.rbyt.buf[u64(bs.off) + 1] == u8(121)
                && c.r.rbyt.buf[u64(bs.off) + 2] == u8(116)
                && c.r.rbyt.buf[u64(bs.off) + 3] == u8(101)
                && c.r.rbyt.buf[u64(bs.off) + 4] == u8(115) {
                // slice u8 (immutable)
                c = rty_prim(c, 0);
                let et = c.res;
                c = rty_slice(c, et, 0);
                c.res2 = 0; c.res3 = 0;
                return c;
            }
        }
        if vfty != NONE() {
            c.res = vfty; c.res2 = 0; c.res3 = 0; return c;
        }
        c = field_ty(c, p, bt, fnid, e.line, e.col);
        // stage-0's Field arm yields Prov::Unknown — the base's
        // bind prov must not leak through.
        c.res2 = 0; c.res3 = 0;
        return c;
    }
    if kind == 8 {                              // Index
        c = place_tv(c, p, e.a);
        let bt = c.res;
        // the index expr is really evaluated — holds + int check
        c = expr_tv(c, p, e.b);
        let ity = c.res;
        if ity == NONE() { c = rty_prim(c, 9); ity = c.res; }
        let itk = c.r.rtys.buf[u64(ity)].kind;
        let isint: u8 = 0;
        if itk <= 7 { isint = 1; }
        if itk == 20 {
            let el = c.r.rtys.buf[u64(ity)].a;
            if c.r.rtys.buf[u64(el)].kind <= 7 { isint = 1; }
        }
        if isint == 0 {
            let ie0 = p.exps.buf[u64(e.b)];
            let m = vec.Vec<u8>::new(c.heap);
            let m2 = resolve.bputs(m,
                "array index must be an integer, found ");
            let t1 = push_ty(m2, c, ity);
            c = t1.c;
            c = pdiag(c, ie0.line, ie0.col, t1.m.as_slice());
            t1.m.destroy();
        }
        if bt == NONE() {
            // Stage-0's place_tv returns Void for an unresolvable
            // base — the match then reports "indexing non-array void".
            c = rty_prim(c, 9);
            bt = c.res;
        }
        let bn = c.r.rtys.buf[u64(bt)];
        let ie = p.exps.buf[u64(e.b)];
        if bn.kind == 14 {                      // [T; n]
            if ek_num(ie.kind) == 0 {
                if ie.w < 0 || ie.w >= i64(bn.w) {
                    let m = vec.Vec<u8>::new(c.heap);
                    let m2 = resolve.bputs(m, "index ");
                    let m3 = loader.bpush_i64(m2, ie.w);
                    let m4 = resolve.bputs(m3, " out of bounds for [");
                    let m5 = resolve.bu32(m4, bn.w);
                    let m6 = m5.push(u8(93));
                    c = pdiag(c, ie.line, ie.col, m6.as_slice());
                    m6.destroy();
                }
            }
            c.res = bn.a;
            c.res2 = 0; c.res3 = 0;
            return c;
        }
        if bn.kind == 17 || bn.kind == 25 {     // slice | box slice
            if ek_num(ie.kind) == 0 {
                if ie.w < 0 {
                    let m = vec.Vec<u8>::new(c.heap);
                    let m2 = resolve.bputs(m, "negative index ");
                    let m3 = loader.bpush_i64(m2, ie.w);
                    let m4 = resolve.bputs(m3, " into a ");
                    if bn.kind == 25 {
                        m4 = resolve.bputs(m4, "box ");
                    }
                    let m5 = resolve.bputs(m4, "slice");
                    c = pdiag(c, ie.line, ie.col, m5.as_slice());
                    m5.destroy();
                } else {
                    c = slice_len_of(c, p, e.a);
                    if c.llen_has == 1 && ie.w >= c.llen {
                        let m = vec.Vec<u8>::new(c.heap);
                        let m2 = resolve.bputs(m, "index ");
                        let m3 = loader.bpush_i64(m2, ie.w);
                        let m4 = resolve.bputs(m3,
                            " out of bounds for ");
                        if bn.kind == 25 {
                            m4 = resolve.bputs(m4, "box ");
                        }
                        let m5 = resolve.bputs(m4,
                            "slice of length ");
                        let m6 = loader.bpush_i64(m5, c.llen);
                        c = pdiag(c, ie.line, ie.col,
                            m6.as_slice());
                        m6.destroy();
                    }
                }
            }
            c.res = bn.a;
            c.res2 = 0; c.res3 = 0;
            return c;
        }
        if bn.kind == 10 {                      // str — not indexed
            let m = vec.Vec<u8>::new(c.heap);
            let m2 = resolve.bputs(m,
                "`str` is not element-indexed — byte access is explicit: `s.bytes[i]`");
            c = pdiag(c, e.line, e.col, m2.as_slice());
            m2.destroy();
            c = rty_prim(c, 9); c.res2 = 0; c.res3 = 0;
            return c;
        }
        let m = vec.Vec<u8>::new(c.heap);
        let m2 = resolve.bputs(m, "indexing non-array ");
        let t2 = push_ty(m2, c, bt);
        c = t2.c;
        c = pdiag(c, e.line, e.col, t2.m.as_slice());
        t2.m.destroy();
        c = rty_prim(c, 9); c.res2 = 0; c.res3 = 0;
        return c;
    }
    if kind == 9 {                              // IndexRange -> slice
        c = place_tv(c, p, e.a);
        let bt = c.res;
        if bt == NONE() { return c; }
        let bn = c.r.rtys.buf[u64(bt)];
        if bn.kind == 14 || bn.kind == 17 || bn.kind == 25 {
            c = rty_slice(c, bn.a, 0);
            c.res2 = 0; c.res3 = 0;
            return c;
        }
        c.res2 = 0; c.res3 = 0;
        return c;
    }
    if kind == 16 {                             // Deref
        c = expr_tv(c, p, e.a);
        let it = c.res;
        let ip2 = c.res2; let ip3 = c.res3;
        if it == NONE() {
            c = rty_prim(c, 9); c.res2 = 0; c.res3 = 0;
            return c;
        }
        let tn = c.r.rtys.buf[u64(it)];
        if tn.kind == 15 || tn.kind == 16 || tn.kind == 18
            || tn.kind == 22 || tn.kind == 24 {
            c.res = tn.a; c.res2 = ip2; c.res3 = ip3;
        } else {
            c = rty_prim(c, 9); c.res2 = 0; c.res3 = 0;
        }
        return c;
    }
    if kind == 11 {                             // &place -> ref ty
        c = place_tv(c, p, e.b);
        let it = c.res;
        if it != NONE() {
            c = rty_ref(c, it, u8(e.a));
        }
        return c;
    }
    if kind == 12 {                             // Handle — ty only
        return ety_at(c, p, eid);
    }
    // non-place — Stage-0's place_tv returns (Void, Unknown)
    // WITHOUT evaluating the expression (no holds, no calls).
    c = rty_prim(c, 9); c.res2 = 0; c.res3 = 0;
    return c;
}

/// guard_base — Var bound as a lock guard → its protected root key.
fn guard_base(read c: Checker, read p: ast.Parser, eid: u32) -> u32 {
    let e = xexp(c, p, eid);
    if ek_num(e.kind) != 2 { return NONE(); }
    // intern is a pure lookup when the name exists
    let pid = e.a;
    let n = p.names.buf[u64(pid)];
    // manual nid match — scan binds for the name's bytes? The binds
    // carry rns nids; pid->nid requires intern_pname which mutates r.
    // Reuse a side table: scan rns for identical bytes.
    let nid = rns_find(c, p, pid);
    if nid == NONE() { return NONE(); }
    let bi = bfind(c, nid);
    if i64(bi) < 0 { return NONE(); }
    let b = c.binds.buf[u64(bi)];
    return b.guard_root;
}

/// rns name lookup by parser pid (read-only — no interning).
fn rns_find(read c: Checker, read p: ast.Parser, pid: u32) -> u32 {
    let n = p.names.buf[u64(pid)];
    let i: u64 = 0;
    while i < c.r.rns.len {
        let sp = c.r.rns.buf[i];
        if sp.len == n.len {
            let eq: u8 = 1;
            let j: u64 = 0;
            while j < u64(n.len) {
                if c.r.rbyt.buf[u64(sp.off) + j]
                    != p.nbyt.buf[u64(n.off) + j] { eq = 0; }
                j = j + 1;
            }
            if eq == 1 { return u32(i); }
        }
        i = i + 1;
    }
    return NONE();
}

/// name bytes slice helper for messages.
fn rns_bytes(read c: Checker, nid: u32) -> slice u8 {
    let sp = c.r.rns.buf[u64(nid)];
    return &c.r.rbyt.buf[u64(sp.off)..u64(sp.off) + u64(sp.len)];
}

/// resolver-name has `<` — an instantiated spelling?
fn nhas_angle(read c: Checker, nid: u32) -> u8 {
    let sp = c.r.rns.buf[u64(nid)];
    let i: u64 = 0;
    while i < u64(sp.len) {
        if c.r.rbyt.buf[u64(sp.off) + i] == u8(60) { return 1; }
        i = i + 1;
    }
    return 0;
}

/// cty — the checker's `check_ty`: an annotation may name only
/// decls visible in this module. kind-12 miss → `unknown struct`
/// (private dep structs land here — importers can't name them at
/// all); `guard` rejects declaration; wrappers recurse.
fn cty(own c: Checker, t: u32, ln: u32, cl: u32) -> Checker {
    if t == NONE() { return c; }
    let n = c.r.rtys.buf[u64(t)];
    if n.kind == 12 {
        let vis = vhas(c.r.v_structs, n.name);
        if nhas_angle(c, n.name) == 0 && vis == 0 {
            let m = vec.Vec<u8>::new(c.heap);
            let m2 = resolve.bputs(m, "unknown struct `");
            let m3 = resolve.bpush(m2, rns_bytes(c, n.name));
            let m4 = m3.push(u8(96));
            c = pdiag(c, ln, cl, m4.as_slice());
            m4.destroy();
        }
        return c;
    }
    if n.kind == 22 {
        let m = vec.Vec<u8>::new(c.heap);
        let m2 = resolve.bputs(m,
            "`guard` is not a declarable type — it comes from `lock`");
        c = pdiag(c, ln, cl, m2.as_slice());
        m2.destroy();
        return c;
    }
    if n.kind == 14 || (n.kind >= 15 && n.kind <= 25) {
        return cty(c, n.a, ln, cl);
    }
    return c;
}

/// edecl idx by name nid | NONE.
fn edecl_of(read c: Checker, name: u32) -> u32 {
    let i: u64 = 0;
    while i < c.r.edecls.len {
        if c.r.edecls.buf[i].name == name { return u32(i); }
        i = i + 1;
    }
    return NONE();
}

/// sdecl idx by name nid | NONE.
fn sdecl_of(read c: Checker, name: u32) -> u32 {
    if u64(name) >= c.r.tb_s.len { return NONE(); }
    let i = c.r.tb_s.buf[u64(name)];
    if i < 0 { return NONE(); }
    return u32(i);
}

/// field range for a struct rty — the decl's own fields, or a
/// `subst_fields` clone appended to `r.sfields` for `App<..>` bases.
/// res = `r.sfields` off | NONE, res2 = count.
fn sfields_of(own c: Checker, ty: u32) -> Checker {
    c.res = NONE(); c.res2 = 0;
    let tn = c.r.rtys.buf[u64(ty)];
    if tn.kind != 12 && tn.kind != 13 { return c; }
    let si = sdecl_of(c, tn.name);
    if si == NONE() { return c; }
    let sd = c.r.sdecls.buf[u64(si)];
    if sd.tps_len == 0 {
        c.res = sd.fs_off; c.res2 = sd.fs_len;
        return c;
    }
    if tn.kind != 13 { return c; }       // bare template name
    let f0 = u32(c.r.sfields.len);
    c.r = resolve.subst_fields(c.r, si, tn.b, tn.c);
    if c.r.suberr != 0 { return c; }
    c.res = f0; c.res2 = sd.fs_len;
    return c;
}

/// field_ty — struct field's rty; storage wrappers unwrap. Diags
/// mirror Stage-0's field_ty.
fn field_ty(own c: Checker, read p: ast.Parser, bt: u32,
            fname: u32, line: u32, col: u32) -> Checker {
    let bn = c.r.rtys.buf[u64(bt)];
    c.res = NONE();
    if bn.kind == 21 || bn.kind == 22 {         // mutex | guard
        return field_ty(c, p, bn.a, fname, line, col);
    }
    if bn.kind == 17 {
        let m = vec.Vec<u8>::new(c.heap);
        let m2 = resolve.bputs(m, "slice member `.");
        let m3 = resolve.bpush(m2, rns_bytes(c, fname));
        let m4 = resolve.bputs(m3,
            "` is a computed view, not a place");
        c = pdiag(c, line, col, m4.as_slice());
        m4.destroy();
        return rty_prim(c, 9);
    }
    if bn.kind == 10 {
        let m = vec.Vec<u8>::new(c.heap);
        let m2 = resolve.bputs(m, "str member `.");
        let m3 = resolve.bpush(m2, rns_bytes(c, fname));
        let m4 = resolve.bputs(m3,
            "` is a computed view, not a place");
        c = pdiag(c, line, col, m4.as_slice());
        m4.destroy();
        return rty_prim(c, 9);
    }
    if bn.kind == 25 {
        let m = vec.Vec<u8>::new(c.heap);
        let m2 = resolve.bputs(m, "box slice member `.");
        let m3 = resolve.bpush(m2, rns_bytes(c, fname));
        let m4 = resolve.bputs(m3, "` is computed, not a place");
        c = pdiag(c, line, col, m4.as_slice());
        m4.destroy();
        return rty_prim(c, 9);
    }
    if bn.kind == 12 || bn.kind == 13 {
        c = sfields_of(c, bt);
        if c.res != NONE() {
            let f0 = c.res; let fn2 = c.res2;
            let j: u64 = 0;
            while j < u64(fn2) {
                let fd = c.r.sfields.buf[u64(f0) + j];
                if fd.name == fname { c.res = fd.ty; return c; }
                j = j + 1;
            }
            c.res = NONE();
        }
        let m = vec.Vec<u8>::new(c.heap);
        let m2 = resolve.bputs(m, "no field `");
        let m3 = resolve.bpush(m2, rns_bytes(c, fname));
        let m4 = resolve.bputs(m3, "` on struct `");
        let m5 = resolve.bpush(m4, rns_bytes(c, bn.name));
        let m6 = m5.push(u8(96));
        c = pdiag(c, line, col, m6.as_slice());
        m6.destroy();
        return rty_prim(c, 9);
    }
    // non-struct base
    let m = vec.Vec<u8>::new(c.heap);
    let m2 = resolve.bputs(m, "field access on non-struct ");
    let t1 = push_ty(m2, c, bt);
    c = t1.c;
    c = pdiag(c, line, col, t1.m.as_slice());
    t1.m.destroy();
    return rty_prim(c, 9);
}

/// rty constructors — general interner.
fn rty_push(own c: Checker, kind: u8, a: u32, b: u32,
            cc: u32, w: u64) -> Checker {
    let i: u64 = 0;
    while i < c.r.rtys.len {
        let t = c.r.rtys.buf[i];
        if t.kind == kind && t.a == a && t.b == b
            && t.c == cc && t.w == w {
            c.res = u32(i);
            return c;
        }
        i = i + 1;
    }
    c.r.rtys = c.r.rtys.push(resolve.RTy {
        kind: kind, name: 0, a: a, b: b, c: cc, w: w });
    c.res = u32(c.r.rtys.len) - 1;
    return c;
}

fn rty_slice(own c: Checker, elem: u32, mut_: u8) -> Checker {
    c = rty_push(c, 17, elem, u32(mut_), 0, u64(0));
    return c;
}
/// named-struct rty — canonical per (kind, name), matching
/// resolve's mk_name dedup.
fn rty_named(own c: Checker, kind: u8, nm: u32) -> Checker {
    let i: u64 = 0;
    while i < c.r.rtys.len {
        let t = c.r.rtys.buf[i];
        if t.kind == kind && t.name == nm {
            c.res = u32(i);
            return c;
        }
        i = i + 1;
    }
    c.r.rtys = c.r.rtys.push(resolve.RTy {
        kind: kind, name: nm, a: 0, b: 0, c: 0, w: 0 });
    c.res = u32(c.r.rtys.len) - 1;
    return c;
}
fn rty_ref(own c: Checker, inner: u32, mut_: u8) -> Checker {
    c = rty_push(c, 15, inner, u32(mut_), 0, u64(0));
    return c;
}


/// expr_ty_at — Stage-0's silent shallow typer: Var/Field/Index/
/// Deref/Handle only; NO diagnostics. res = ty | NONE, prov unknown.
fn ety_at(own c: Checker, read p: ast.Parser, eid: u32) -> Checker {
    c.res = NONE(); c.res2 = 0; c.res3 = 0;
    let e = xexp(c, p, eid);
    let kind = ek_num(e.kind);
    let rvn = rv_find(c, eid);
    if kind == 2 || rvn != NONE() {             // Var | $rv temp
        let vn = rvn;
        if vn == NONE() {
            c.r = resolve.intern_pname(c.r, p, e.a);
            vn = c.r.res;
        }
        let bi = bfind(c, vn);
        if i64(bi) < 0 { return c; }
        c.res = c.binds.buf[u64(bi)].ty;
        return c;
    }
    if kind == 7 {                              // Field
        c = ety_at(c, p, e.a);
        if c.res == NONE() { return c; }
        c.r = resolve.intern_pname(c.r, p, e.b);
        let fnid = c.r.res;
        let tn = c.r.rtys.buf[u64(c.res)];
        let k = tn.kind;
        let inner = c.res;
        if k == 21 || k == 22 {                 // mutex | guard
            inner = tn.a;
            k = c.r.rtys.buf[u64(inner)].kind;
        }
        if k == 12 || k == 13 {                 // struct | enum
            let nm = c.r.rtys.buf[u64(inner)].name;
            let si = sdecl_of(c, nm);
            if si != NONE() {
                let sd = c.r.sdecls.buf[u64(si)];
                let f0 = u64(sd.fs_off);
                let fn2 = u64(sd.fs_len);
                if sd.tps_len != 0 && k == 13 {
                    let tn2 = c.r.rtys.buf[u64(inner)];
                    f0 = c.r.sfields.len;
                    c.r = resolve.subst_fields(
                        c.r, si, tn2.b, tn2.c);
                    if c.r.suberr != 0 {
                        f0 = u64(sd.fs_off);
                    }
                }
                let j: u64 = 0;
                while j < fn2 {
                    let fd = c.r.sfields.buf[f0 + j];
                    if fd.name == fnid { c.res = fd.ty; return c; }
                    j = j + 1;
                }
                c.res = NONE();
                return c;
            }
            // enum — variant `f`'s payload ty (silent: no tag check,
            // no diags — the read paths diagnose separately).
            let ei = edecl_of(c, nm);
            if ei == NONE() { c.res = NONE(); return c; }
            let ed = c.r.edecls.buf[u64(ei)];
            let fvoff = u64(ed.vs_off);
            if k == 13 {
                let tn2 = c.r.rtys.buf[u64(inner)];
                fvoff = c.r.vars.len;
                c.r = resolve.subst_variants(
                    c.r, ei, tn2.b, tn2.c);
                if c.r.suberr != 0 { fvoff = u64(ed.vs_off); }
            }
            let j: u64 = 0;
            while j < u64(ed.vs_len) {
                let vd = c.r.vars.buf[fvoff + j];
                if vd.name == fnid {
                    c.res = vd.ty; return c;
                }
                j = j + 1;
            }
            c.res = NONE();
            return c;
        }
        if k == 17 {                            // slice — len/ptr
            let bs = c.r.rns.buf[u64(fnid)];
            if u64(bs.len) == 3
                && c.r.rbyt.buf[u64(bs.off)] == u8(108)
                && c.r.rbyt.buf[u64(bs.off) + 1] == u8(101)
                && c.r.rbyt.buf[u64(bs.off) + 2] == u8(110) {
                c = rty_prim(c, 3);             // u64
                return c;
            }
            if u64(bs.len) == 3
                && c.r.rbyt.buf[u64(bs.off)] == u8(112)
                && c.r.rbyt.buf[u64(bs.off) + 1] == u8(116)
                && c.r.rbyt.buf[u64(bs.off) + 2] == u8(114) {
                c = rty_ptr(c, c.r.rtys.buf[u64(inner)].a,
                            c.r.rtys.buf[u64(inner)].b);
                return c;
            }
            c.res = NONE();
            return c;
        }
        if k == 10 {                            // str — len/bytes
            let bs = c.r.rns.buf[u64(fnid)];
            if u64(bs.len) == 3
                && c.r.rbyt.buf[u64(bs.off)] == u8(108)
                && c.r.rbyt.buf[u64(bs.off) + 1] == u8(101)
                && c.r.rbyt.buf[u64(bs.off) + 2] == u8(110) {
                c = rty_prim(c, 3);
                return c;
            }
            if u64(bs.len) == 5
                && c.r.rbyt.buf[u64(bs.off)] == u8(98)
                && c.r.rbyt.buf[u64(bs.off) + 1] == u8(121)
                && c.r.rbyt.buf[u64(bs.off) + 2] == u8(116)
                && c.r.rbyt.buf[u64(bs.off) + 3] == u8(101)
                && c.r.rbyt.buf[u64(bs.off) + 4] == u8(115) {
                c = rty_prim(c, 0);
                let u8t = c.res;
                c = rty_slice(c, u8t, 0);
                return c;
            }
            c.res = NONE();
            return c;
        }
        if k == 25 {                            // box slice — len/ptr
            let bs = c.r.rns.buf[u64(fnid)];
            if u64(bs.len) == 3
                && c.r.rbyt.buf[u64(bs.off)] == u8(108)
                && c.r.rbyt.buf[u64(bs.off) + 1] == u8(101)
                && c.r.rbyt.buf[u64(bs.off) + 2] == u8(110) {
                c = rty_prim(c, 3);
                return c;
            }
            if u64(bs.len) == 3
                && c.r.rbyt.buf[u64(bs.off)] == u8(112)
                && c.r.rbyt.buf[u64(bs.off) + 1] == u8(116)
                && c.r.rbyt.buf[u64(bs.off) + 2] == u8(114) {
                c = rty_ptr(c, c.r.rtys.buf[u64(inner)].a, 1);
                return c;
            }
            c.res = NONE();
            return c;
        }
        c.res = NONE();
        return c;
    }
    if kind == 8 {                              // Index — elem ty
        c = ety_at(c, p, e.a);
        if c.res == NONE() { return c; }
        let tn = c.r.rtys.buf[u64(c.res)];
        let k = tn.kind;
        let inner = c.res;
        if k == 21 || k == 22 {
            inner = tn.a;
            k = c.r.rtys.buf[u64(inner)].kind;
        }
        if k == 14 || k == 17 || k == 25 {
            c.res = c.r.rtys.buf[u64(inner)].a;
            return c;
        }
        c.res = NONE();
        return c;
    }
    if kind == 16 {                             // Deref — elem
        c = ety_at(c, p, e.a);
        if c.res == NONE() { return c; }
        let tn = c.r.rtys.buf[u64(c.res)];
        if tn.kind == 15 || tn.kind == 18 || tn.kind == 22
            || tn.kind == 24 {
            c.res = tn.a;
        } else { c.res = NONE(); }
        return c;
    }
    if kind == 12 {                             // Handle(place)
        c = ety_at(c, p, e.a);
        if c.res == NONE() { return c; }
        c.res = rty_wrap(c, 18, c.res);
        return c;
    }
    if kind == 22 {                             // Match — yield ty
        let i: u64 = 0;
        while i < c.myields.len {
            let my = c.myields.buf[i];
            if my.line == e.line && my.col == e.col {
                c.res = my.ty;
                c.res2 = u32(my.pk); c.res3 = my.pv;
                return c;
            }
            i = i + 1;
        }
        return c;
    }
    return c;
}

/// rty_ptr — `*T` (b=mut|0=const matches e_ty's kind-16 encoding).
fn rty_ptr(own c: Checker, elem: u32, mut_: u32) -> Checker {
    let i: u64 = 0;
    while i < c.r.rtys.len {
        let t = c.r.rtys.buf[i];
        if t.kind == 16 && t.a == elem && t.b == mut_ {
            c.res = u32(i);
            return c;
        }
        i = i + 1;
    }
    c.r.rtys = c.r.rtys.push(resolve.RTy {
        kind: 16, name: 0, a: elem, b: mut_, c: 0, w: 0 });
    c.res = u32(c.r.rtys.len) - 1;
    return c;
}

fn resolve_place(own c: Checker, read p: ast.Parser, eid: u32) -> Checker {
    while c.pstash.len > 0 { c.pstash.pop(); }
    c.res4 = 0;
    c = rp_inner(c, p, eid);
    // canonical order — insertion sort + dedup
    let i: u64 = 1;
    while i < c.pstash.len {
        let x = c.pstash.buf[i];
        let j = i;
        while j > 0 && kless(c, x, c.pstash.buf[j - 1]) == 1 {
            c.pstash.buf[j] = c.pstash.buf[j - 1];
            j = j - 1;
        }
        c.pstash.buf[j] = x;
        i = i + 1;
    }
    let w = vec.Vec<u32>::new(c.heap);
    i = 0;
    while i < c.pstash.len {
        if w.len == 0 || w.buf[w.len - 1] != c.pstash.buf[i] {
            w = w.push(c.pstash.buf[i]);
        }
        i = i + 1;
    }
    c.pstash.destroy();
    c.pstash = w;
    c.res4 = u32(c.pstash.len);
    return c;
}

/// raw edge+cap targets of holder h pushed onto pstash; `*h` when
/// none (the holder's own un-mapped span).
fn rp_targets(own c: Checker, h: u32) -> Checker {
    let n0 = c.pstash.len;
    let i: u64 = 0;
    while i < c.edges.len {
        if c.edges.buf[i].h == h {
            c.pstash = c.pstash.push(c.edges.buf[i].t);
        }
        i = i + 1;
    }
    i = 0;
    while i < c.caps.len {
        if c.caps.buf[i].h == h {
            c.pstash = c.pstash.push(c.caps.buf[i].t);
        }
        i = i + 1;
    }
    if c.pstash.len == n0 {
        c = key_pstar(c, h);
        c.pstash = c.pstash.push(c.res);
    }
    return c;
}

/// resolve_place_inner — raw (unordered) target set into pstash.
fn rp_inner(own c: Checker, read p: ast.Parser, eid: u32) -> Checker {
    let e = xexp(c, p, eid);
    let kind = ek_num(e.kind);
    if kind == 11 {                         // &place — the place itself
        return rp_inner(c, p, e.b);
    }
    if kind == 2 || rv_find(c, eid) != NONE() {
        // Var | $rv temp
        let vn = rv_find(c, eid);
        if vn == NONE() {
            c.r = resolve.intern_pname(c.r, p, e.a);
            vn = c.r.res;
        }
        let bi = bfind(c, vn);
        if i64(bi) < 0 { return c; }
        let b = c.binds.buf[u64(bi)];
        c = key_of(c, vn, b.epoch);
        if b.auth != 0 {
            // capability param — its edges' targets ARE the place
            let i: u64 = 0;
            while i < c.edges.len {
                if c.edges.buf[i].h == c.res {
                    c.pstash = c.pstash.push(c.edges.buf[i].t);
                }
                i = i + 1;
            }
            return c;
        }
        c.pstash = c.pstash.push(c.res);
        return c;
    }
    if kind == 7 {                          // Field
        c = ety_at(c, p, e.a);
        let bt = c.res;
        c.r = resolve.intern_pname(c.r, p, e.b);
        let fnid = c.r.res;
        if bt != NONE() && c.r.rtys.buf[u64(bt)].kind == 10 {
            // `s.bytes` resolves through the str's own edge
            let bs = c.r.rns.buf[u64(fnid)];
            if u64(bs.len) == 5
                && c.r.rbyt.buf[u64(bs.off)] == u8(98)
                && c.r.rbyt.buf[u64(bs.off) + 1] == u8(121)
                && c.r.rbyt.buf[u64(bs.off) + 2] == u8(116)
                && c.r.rbyt.buf[u64(bs.off) + 3] == u8(101)
                && c.r.rbyt.buf[u64(bs.off) + 4] == u8(115) {
                return rp_inner(c, p, e.a);
            }
        }
        let g = guard_base(c, p, e.a);
        if g != NONE() {
            c = key_field(c, g, fnid);
            c.pstash = c.pstash.push(c.res);
            return c;
        }
        c = rp_inner(c, p, e.a);
        let hh = c.pstash;
        c.pstash = vec.Vec<u32>::new(c.heap);
        let i: u64 = 0;
        while i < hh.len {
            c = key_field(c, hh.buf[i], fnid);
            c.pstash = c.pstash.push(c.res);
            i = i + 1;
        }
        hh.destroy();
        return c;
    }
    if kind == 8 {                          // Index
        c = ety_at(c, p, e.a);
        let bt = c.res;
        if bt != NONE() && c.r.rtys.buf[u64(bt)].kind == 17 {
            // slice — elements of its claimed span
            c = rp_inner(c, p, e.a);
            let hh = c.pstash;
            c.pstash = vec.Vec<u32>::new(c.heap);
            let i: u64 = 0;
            while i < hh.len {
                c = rp_targets(c, hh.buf[i]);
                i = i + 1;
            }
            hh.destroy();
            let hh2 = c.pstash;
            c.pstash = vec.Vec<u32>::new(c.heap);
            i = 0;
            while i < hh2.len {
                c = key_cat(c, hh2.buf[i], "[]");
                c.pstash = c.pstash.push(c.res);
                i = i + 1;
            }
            hh2.destroy();
            return c;
        }
        let g = guard_base(c, p, e.a);
        if g != NONE() {
            c = key_cat(c, g, "[]");
            c.pstash = c.pstash.push(c.res);
            return c;
        }
        c = rp_inner(c, p, e.a);
        let hh = c.pstash;
        c.pstash = vec.Vec<u32>::new(c.heap);
        let i: u64 = 0;
        while i < hh.len {
            c = key_cat(c, hh.buf[i], "[]");
            c.pstash = c.pstash.push(c.res);
            i = i + 1;
        }
        hh.destroy();
        return c;
    }
    if kind == 9 {                          // IndexRange
        c = ety_at(c, p, e.a);
        let bt = c.res;
        if bt != NONE() && c.r.rtys.buf[u64(bt)].kind == 17 {
            c = rp_inner(c, p, e.a);
            let hh = c.pstash;
            c.pstash = vec.Vec<u32>::new(c.heap);
            let i: u64 = 0;
            while i < hh.len {
                c = rp_targets(c, hh.buf[i]);
                i = i + 1;
            }
            hh.destroy();
            return c;
        }
        return rp_inner(c, p, e.a);
    }
    if kind == 16 {                         // Deref
        let g = guard_base(c, p, e.a);
        if g != NONE() {
            c.pstash = c.pstash.push(g);
            return c;
        }
        c = ety_at(c, p, e.a);
        let it = c.res;
        if it != NONE() && c.r.rtys.buf[u64(it)].kind == 24 {
            return rp_inner(c, p, e.a);
        }
        c = rp_inner(c, p, e.a);
        let hh = c.pstash;
        c.pstash = vec.Vec<u32>::new(c.heap);
        let i: u64 = 0;
        while i < hh.len {
            c = rp_targets(c, hh.buf[i]);
            i = i + 1;
        }
        hh.destroy();
        return c;
    }
    return c;
}

/// `&mut p` through a borrowed holder consumes the parent's edge —
/// the source key | NONE.
fn derivation_source(own c: Checker, read p: ast.Parser,
                     eid: u32) -> Checker {
    // v1: a Var place whose binding's own edges are borrowed-through
    // is its own move source.
    c.res = NONE();
    let e = xexp(c, p, eid);
    let kind = ek_num(e.kind);
    if kind == 2 || rv_find(c, eid) != NONE() {
        let vn = rv_find(c, eid);
        if vn == NONE() {
            c.r = resolve.intern_pname(c.r, p, e.a);
            vn = c.r.res;
        }
        let bi = bfind(c, vn);
        if i64(bi) < 0 { return c; }
        let b = c.binds.buf[u64(bi)];
        if b.auth != 0 {
            c = key_of(c, vn, b.epoch);
            return c;
        }
    }
    if kind == 7 {                              // Field — through base
        return derivation_source(c, p, e.a);
    }
    if kind == 8 || kind == 9 {                 // Index|IndexRange
        // `&mut s[i]`/`&mut s[..]` — slice reborrow moves span auth
        c = ety_at(c, p, e.a);
        if c.res != NONE()
            && c.r.rtys.buf[u64(c.res)].kind == 17 {
            c = place_id(c, p, e.a);
            return c;
        }
        return derivation_source(c, p, e.a);
    }
    if kind == 16 {                             // Deref — the place
        c = place_id(c, p, e.a);
        return c;
    }
    return c;
}

// ---- store/move helpers ----------------------------------------------------

/// consume_owned_src — an owning value moves out of its place:
/// `let q = p` consumes p's subtree when p's ty is own (box/struct/
/// enum/aggregate carrying authority).
fn consume_owned_src(own c: Checker, read p: ast.Parser,
                     eid: u32, el: u32, ec: u32) -> Checker {
    let e = xexp(c, p, eid);
    let kind = ek_num(e.kind);
    if kind != 2 && kind != 7 && kind != 8 && kind != 16
        && rv_find(c, eid) == NONE() {
        return c;
    }
    c = ety_at(c, p, eid);
    let tk0 = c.res;
    if tk0 == NONE() { return c; }
    let tk = c.r.rtys.buf[u64(tk0)].kind;
    let owns: u8 = 0;
    if tk == 24 || tk == 25 { owns = 1; }
    if tk == 12 || tk == 13 || tk == 14 {
        c = subtree_owned(c, p, eid);
        if c.res == 1 { owns = 1; }
    }
    if owns == 0 { return c; }
    return consume_place(c, p, eid);
}

/// subtree_owned — does any resolved place still carry own-capable
/// facts (live own authority, or claimed sub-edges/caps)?
fn subtree_owned(own c: Checker, read p: ast.Parser,
                 eid: u32) -> Checker {
    c.res = 0;
    c = ety_at(c, p, eid);
    let t = c.res;
    c = resolve_place(c, p, eid);
    let n = c.res4;
    let i: u64 = 0;
    while i < u64(n) {
        let k = c.pstash.buf[i];
        c = live_own_at(c, k, t);
        if c.res != NONE() { c.res = 1; return c; }
        // `k.` sub-holders in edges or caps
        let j: u64 = 0;
        while j < c.edges.len {
            let eh = c.edges.buf[j].h;
            if kprefix(c, k, eh) == 1 && eh != k {
                c.res = 1; return c;
            }
            j = j + 1;
        }
        j = 0;
        while j < c.caps.len {
            let ch2 = c.caps.buf[j].h;
            if kprefix(c, k, ch2) == 1 && ch2 != k {
                c.res = 1; return c;
            }
            j = j + 1;
        }
        i = i + 1;
    }
    return c;
}

/// cap_hold — a Write derivation over mutex storage claims Sync.
fn cap_hold(own c: Checker, read p: ast.Parser,
            t: u32, req: u8) -> Checker {
    c.res = u32(req);
    if req == 2 {
        c = mutex_inner(c, p, t);
        if c.res != NONE() { c.res = 5; return c; }
        c.res = 2;
    }
    return c;
}

/// cap_check — the capability law at a required-auth site.
/// Leaves resolved targets in pstash/res4.
fn cap_check(own c: Checker, read p: ast.Parser,
             eid: u32, req: u8) -> Checker {
    let e = xexp(c, p, eid);
    c = resolve_place(c, p, eid);
    let n = c.res4;
    // save targets — path_holders re-resolves Index/IndexRange/Deref
    // bases through pstash, so ts must ride in cbuf.
    while c.cbuf.len > 0 { c.cbuf.pop(); }
    let q0: u64 = 0;
    while q0 < u64(n) {
        c.cbuf = c.cbuf.push(c.pstash.buf[q0]);
        q0 = q0 + 1;
    }
    c = path_holders(c, p, eid);
    while c.pstash.len > 0 { c.pstash.pop(); }
    q0 = 0;
    while q0 < u64(n) {
        c.pstash = c.pstash.push(c.cbuf.buf[q0]);
        q0 = q0 + 1;
    }
    c.res4 = n;
    // record the required holds (cap_hold escalation)
    let i: u64 = 0;
    while i < u64(n) {
        let t = c.pstash.buf[i];
        c = cap_hold(c, p, t, req);
        let a = u8(c.res);
        c = record_hold(c, t, a);
        i = i + 1;
    }
    if n == 0 && c.hstash.len > 0 {
        let m = vec.Vec<u8>::new(c.heap);
        let m2 = resolve.bputs(m, "use of moved authority `");
        let m3 = tn_into(m2, c, p, eid);
        let m4 = m3.push(u8(96));
        c = pdiag(c, e.line, e.col, m4.as_slice());
        m4.destroy();
    }
    // reaching a target through a handle must prove liveness
    let via_handle: u8 = 0;
    i = 0;
    while i < c.hstash.len {
        let h = c.hstash.buf[i];
        let j: u64 = 0;
        while j < c.caps.len {
            if c.caps.buf[j].h == h { via_handle = 1; }
            j = j + 1;
        }
        i = i + 1;
    }
    if via_handle == 1 {
        i = 0;
        while i < u64(n) {
            let t = c.pstash.buf[i];
            c = key_root(c, t);
            let rk = c.res;
            if k_is_arg(c, rk) == 0 {
                let nn = root_name(c, rk);
                let alive: u8 = 0;
                if nn != NONE() {
                    let bi = bfind(c, nn);
                    if i64(bi) >= 0 {
                        let b = c.binds.buf[u64(bi)];
                        c = key_of(c, nn, b.epoch);
                        if c.res == rk && cons_covers(c, t) == 0 {
                            alive = 1;
                        }
                    }
                }
                if alive == 0 {
                    let m = vec.Vec<u8>::new(c.heap);
                    let m2 = resolve.bputs(m,
                        "use of stale handle `");
                    let m3 = tn_into(m2, c, p, eid);
                    let m4 = resolve.bputs(m3,
                        "`: its target no longer exists");
                    c = pdiag(c, e.line, e.col, m4.as_slice());
                    m4.destroy();
                    c.res4 = u32(n);
                    return c;
                }
            }
            i = i + 1;
        }
    }
    // exclusivity matrix per target
    i = 0;
    while i < u64(n) {
        let t = c.pstash.buf[i];
        c = unguarded_check(c, p, eid, t);
        c = transit_check(c, p, eid, t);
        // edges_to writes pstash — collect into hstash2-safe scratch:
        // Stage-0 iterates edges_to(t) while our pstash holds ts —
        // save ts first.
        i = i + 1;
    }
    // second pass with ts preserved in cbuf
    while c.cbuf.len > 0 { c.cbuf.pop(); }
    i = 0;
    while i < u64(n) {
        c.cbuf = c.cbuf.push(c.pstash.buf[i]);
        i = i + 1;
    }
    i = 0;
    while i < u64(n) {
        let t = c.cbuf.buf[i];
        // hh copy of hstash for the contains check
        let hh = clone_u(c.heap, c.hstash);
        c = edges_to(c, t);
        let m2 = c.res4;
        let j: u64 = 0;
        while j < u64(m2) {
            let h = c.pstash.buf[j];
            // the edge's kind/born first — the derivation matrix
            // reads it even when h is our own parent edge
            let fk: u8 = 0;
            let fbl: u32 = 0;
            let fbc: u32 = 0;
            let q: u64 = 0;
            while q < c.edges.len {
                let ed = c.edges.buf[q];
                if ed.h == h && overlap(c, ed.t, t) == 1 {
                    fk = ed.kind; fbl = ed.bl; fbc = ed.bc;
                }
                q = q + 1;
            }
            if vhas(hh, h) == 1 {
                // deriving through our own authority — the parent
                // edge: Read always ok; Write needs Write|Own; Own
                // needs Own; Atomic|Sync never derive.
                let ok: u8 = 0;
                if req == 1 { ok = 1; }
                if req == 2 { if fk == 2 || fk == 3 { ok = 1; } }
                if req == 3 { if fk == 3 { ok = 1; } }
                if ok == 0 {
                    let m = vec.Vec<u8>::new(c.heap);
                    if req == 2 {
                        m = resolve.bputs(m,
                            "cannot derive write authority from read on `");
                    } else {
                        m = resolve.bputs(m,
                            "cannot transfer own authority through a borrow of `");
                    }
                    m = tn_into(m, c, p, eid);
                    m = m.push(u8(96));
                    c = pdiag(c, e.line, e.col, m.as_slice());
                    m.destroy();
                }
                j = j + 1; continue;
            }
            // own-transfer: a holder INSIDE t dies with the root
            if req == 3 && key_under(c, h, t) == 1 {
                j = j + 1; continue;
            }
            // foreign claim — conflict vs required
            c = cap_hold(c, p, t, req);
            let req2 = u8(c.res);
            let conflict: u8 = 0;
            if req2 == 1 { if fk != 1 { conflict = 1; } }
            if req2 == 5 { if fk != 5 { conflict = 1; } }
            if req2 == 2 || req2 == 3 || req2 == 4 { conflict = 1; }
            if conflict == 1 {
                let l0 = c.dlab.len;
                c = born_label(c, h, fk, fbl, fbc);
                let l1 = c.dlab.len;
                let m = vec.Vec<u8>::new(c.heap);
                if task_has(c, h) == 1 {
                    m = resolve.bputs(m, "cannot touch `");
                    m = tn_into(m, c, p, eid);
                    m = resolve.bputs(m,
                        "`: held by unjoined task `");
                    m = push_kname(m, c, h);
                    m = m.push(u8(96));
                } else {
                    if req == 1 {
                        m = resolve.bputs(m, "cannot borrow `");
                        m = tn_into(m, c, p, eid);
                        m = resolve.bputs(m,
                            "` as shared: it is mutably borrowed");
                    }
                    if req == 3 {
                        m = resolve.bputs(m, "cannot consume `");
                        m = tn_into(m, c, p, eid);
                        m = resolve.bputs(m, "`: it is borrowed");
                    }
                    if req != 1 && req != 3 {
                        m = resolve.bputs(m, "cannot mutably borrow `");
                        m = tn_into(m, c, p, eid);
                        m = resolve.bputs(m, "`: already borrowed");
                    }
                }
                c = pdiag_l(c, e.line, e.col, m.as_slice(),
                            u32(l0), u32(l1));
                m.destroy();
            }
            j = j + 1;
        }
        hh.destroy();
        i = i + 1;
    }
    // restore ts
    while c.pstash.len > 0 { c.pstash.pop(); }
    i = 0;
    while i < u64(n) {
        c.pstash = c.pstash.push(c.cbuf.buf[i]);
        i = i + 1;
    }
    c.res4 = u32(n);
    return c;
}

/// consume_place — a read+move out of every place e resolves to.
fn consume_place(own c: Checker, read p: ast.Parser,
                 eid: u32) -> Checker {
    let e = xexp(c, p, eid);
    c = require_init(c, p, eid);
    c = path_holders(c, p, eid);
    // moving through a handle is identity-only, not authority
    let i: u64 = 0;
    while i < c.hstash.len {
        let h = c.hstash.buf[i];
        let via_cap: u8 = 0;
        let via_edge: u8 = 0;
        let j: u64 = 0;
        while j < c.caps.len {
            if c.caps.buf[j].h == h { via_cap = 1; }
            j = j + 1;
        }
        j = 0;
        while j < c.edges.len {
            if c.edges.buf[j].h == h { via_edge = 1; }
            j = j + 1;
        }
        if via_cap == 1 && via_edge == 0 {
            let m = vec.Vec<u8>::new(c.heap);
            let m2 = resolve.bputs(m,
                "cannot transfer ownership through a handle `");
            let m3 = tn_into(m2, c, p, eid);
            let m4 = m3.push(u8(96));
            c = pdiag(c, e.line, e.col, m4.as_slice());
            m4.destroy();
            return c;
        }
        i = i + 1;
    }
    c = cap_check(c, p, eid, 3);
    let n = c.res4;
    i = 0;
    while i < u64(n) {
        let t = c.pstash.buf[i];
        let dl = defer_conflict(c, t);
        if dl != NONE() {
            let m = vec.Vec<u8>::new(c.heap);
            let m2 = resolve.bputs(m, "cannot consume `");
            let m3 = tn_into(m2, c, p, eid);
            let m4 = resolve.bputs(m3,
                "`: it is reserved by the `defer` at line ");
            let m5 = resolve.bu32(m4, u64(dl));
            c = pdiag(c, e.line, e.col, m5.as_slice());
            m5.destroy();
            return c;
        }
        let ov = consumed_overlap(c, t);
        if ov == 1 {
            let l0 = c.dlab.len;
            c = consume_labels(c, t);
            let l1 = c.dlab.len;
            let m = vec.Vec<u8>::new(c.heap);
            let m2 = resolve.bputs(m, "double consume `");
            let m3 = tn_into(m2, c, p, eid);
            let m4 = m3.push(u8(96));
            c = pdiag_l(c, e.line, e.col, m4.as_slice(),
                        u32(l0), u32(l1));
            m4.destroy();
        }
        if ov == 2 {
            let l0 = c.dlab.len;
            c = consume_labels(c, t);
            let l1 = c.dlab.len;
            let m = vec.Vec<u8>::new(c.heap);
            let m2 = resolve.bputs(m, "cannot consume `");
            let m3 = tn_into(m2, c, p, eid);
            let m4 = resolve.bputs(m3,
                "`: it may be dead on another path");
            c = pdiag_l(c, e.line, e.col, m4.as_slice(),
                        u32(l0), u32(l1));
            m4.destroy();
        }
        c = cons1(c, t, 1, e.line, e.col);
        c = kill_set(c, t, 1);
        c = edges_retain_holder(c, t);
        i = i + 1;
    }
    return c;
}

/// consumed_overlap — worst ConsState covering k in EITHER direction.
/// 0 none, 1 Cons, 2 Maybe.
fn consumed_overlap(read c: Checker, k: u32) -> u8 {
    let worst = cons_covers(c, k);
    let i: u64 = 0;
    while i < c.cons.len {
        let cf = c.cons.buf[i];
        // `[]`-collapsed descendants aren't whole-place facts
        if cf.k != k && kcontains(c, cf.k, "[]") == 1 {
            i = i + 1; continue;
        }
        let covered: u8 = 0;
        if cf.k == k || kprefix(c, k, cf.k) == 1 { covered = 1; }
        if covered == 1 {
            if worst != 1 { worst = cf.st; }
        }
        i = i + 1;
    }
    return worst;
}

/// push_place_lit — stage the value's literal field info for
/// record_lit_fields. v1: mark absent.
fn push_place_lit(own c: Checker, read p: ast.Parser,
                  eid: u32) -> Checker {
    c.has_lit = 0;
    // result regs are a live channel here (let_eval re-derives the
    // init's prov after this call) — collect is scratch, restore.
    let s0 = c.res; let s2 = c.res2; let s3 = c.res3;
    let s4 = c.res4; let s5 = c.res5;
    let e = xexp(c, p, eid);
    if ek_num(e.kind) == 22 {               // Match — yield packets
        // `=> w`-style yields: the joined packet drains back into
        // the channels so `let r = match ..`, `s.f = match ..`,
        // `return match ..` re-root it downstream (N28).
        let i: u64 = 0;
        while i < c.myields.len {
            let my = c.myields.buf[i];
            if my.line == e.line && my.col == e.col {
                let mz = u64(my.z);
                let q: u64 = 0;
                while q < c.myinfos.buf[mz].le_rel.len {
                    let ri0 = c.myinfos.buf[mz].le_ri.buf[q];
                    let toff = u32(c.ri_to.len);
                    let w: u64 = 0;
                    while w < u64(ri0.tlen) {
                        c.ri_to = c.ri_to.push(
                            c.myinfos.buf[mz].le_pool.buf[
                                u64(ri0.toff) + w]);
                        w = w + 1;
                    }
                    c.rinfos = c.rinfos.push(RefInf {
                        toff: toff, tlen: ri0.tlen, mut_: ri0.mut_,
                        mf: ri0.mf, foreign: ri0.foreign });
                    c.lit_edges = c.lit_edges.push(RLE {
                        rel: c.myinfos.buf[mz].le_rel.buf[q],
                        ri: u32(c.rinfos.len) - 1 });
                    q = q + 1;
                }
                q = 0;
                while q < c.myinfos.buf[mz].lc.len {
                    let e0 = c.myinfos.buf[mz].lc.buf[q];
                    let coff = u32(c.rlc_keys.len);
                    let w: u64 = 0;
                    while w < u64(e0.len) {
                        c.rlc_keys = c.rlc_keys.push(
                            c.myinfos.buf[mz].lc_keys.buf[
                                u64(e0.off) + w]);
                        w = w + 1;
                    }
                    c.lit_caps = c.lit_caps.push(RLE2 {
                        rel: e0.rel, off: coff, len: e0.len });
                    q = q + 1;
                }
                q = 0;
                while q < c.myinfos.buf[mz].ld_rel.len {
                    c.lit_dead_cfs = c.lit_dead_cfs.push(
                        c.myinfos.buf[mz].ld_cf.buf[q]);
                    c.lit_dead = c.lit_dead.push(LCF {
                        rel: c.myinfos.buf[mz].ld_rel.buf[q],
                        cf: u32(c.lit_dead_cfs.len) - 1 });
                    q = q + 1;
                }
                q = 0;
                while q < c.myinfos.buf[mz].lp.len {
                    c.last_lit = c.last_lit.push(
                        c.myinfos.buf[mz].lp.buf[q]);
                    q = q + 1;
                }
                if c.myinfos.buf[mz].lp.len > 0 { c.has_lit = 1; }
                q = 0;
                while q < c.myinfos.buf[mz].ll.len {
                    c.lit_lens = c.lit_lens.push(
                        c.myinfos.buf[mz].ll.buf[q]);
                    q = q + 1;
                }
                q = 0;
                while q < c.myinfos.buf[mz].lt.len {
                    c.lit_tags = c.lit_tags.push(
                        c.myinfos.buf[mz].lt.buf[q]);
                    q = q + 1;
                }
            }
            i = i + 1;
        }
        c.res = s0; c.res2 = s2; c.res3 = s3;
        c.res4 = s4; c.res5 = s5;
        return c;
    }
    // aggregate place — collect the resolved keys' subtree packets
    c = ety_at(c, p, eid);
    let t = c.res;
    if t != NONE() {
        let tk = c.r.rtys.buf[u64(t)].kind;
        if tk == 12 || tk == 13 || tk == 14 {
            c = resolve_place(c, p, eid);
            let i: u64 = 0;
            while i < u64(c.res4) {
                let k = c.pstash.buf[i];
                c = collect_lit_k(c, k);
                i = i + 1;
            }
        }
    }
    c.res = s0; c.res2 = s2; c.res3 = s3;
    c.res4 = s4; c.res5 = s5;
    return c;
}

/// const_int — N29: the mathematical value of a pure-literal int
/// tree under `ty`'s semantics, in i64. res5 = has, llen = value.
/// (i64 domain — u64's top half folds are out of reach, matching
/// spelled-literal reality for every op but huge <<.)
fn const_int(own c: Checker, read p: ast.Parser, eid: u32,
             ty: u32) -> Checker {
    // `i64(lit)` truncates through i32 in stage-0 codegen — the
    // bounds must ride annotated locals, never literal casts.
    let imax: i64 = 9223372036854775807;
    let imin: i64 = 0 - imax - 1;
    c.res5 = 0;
    let e = xexp(c, p, eid);
    let kind = ek_num(e.kind);
    if kind == 0 {
        c.llen = e.w; c.res5 = 1;
        return c;
    }
    // unsigned when ty's range lo >= 0
    let tn = c.r.rtys.buf[u64(ty)];
    let tid = ty;
    if tn.kind == 20 { tid = tn.a; tn = c.r.rtys.buf[u64(tid)]; }
    let unsigned: u8 = 0;
    if tn.kind <= 3 { unsigned = 1; }
    if kind == 4 {                              // Unary
        if e.a == 0 {                           // neg
            c = const_int(c, p, e.b, ty);
            if c.res5 == 0 { return c; }
            let v = c.llen;
            // i64::MIN can't negate
            if v == imin {
                c.res5 = 0; return c;
            }
            c.llen = 0 - v;
            return c;
        }
        if e.a == 2 {                           // bitnot
            c = const_int(c, p, e.b, ty);
            if c.res5 == 0 { return c; }
            if unsigned == 1 {
                // hi - v at ty's width
                let hi: i64 = 0;
                if tn.kind == 0 { hi = 255; }
                if tn.kind == 1 { hi = 65535; }
                if tn.kind == 2 { hi = 4294967295; }
                if tn.kind == 3 {
                    c.res5 = 0; return c;       // u64 hi — i64 domain
                }
                c.llen = hi - c.llen;
                return c;
            }
            // signed: -v - 1 — checked
            let v = c.llen;
            if v == imax || v < 0 - imax {
                c.res5 = 0; return c;
            }
            c.llen = 0 - v - 1;
            return c;
        }
        c.res5 = 0;
        return c;
    }
    if kind == 5 {                              // Bin
        c = const_int(c, p, e.b, ty);
        if c.res5 == 0 { return c; }
        let x = c.llen;
        c = const_int(c, p, e.c, ty);
        if c.res5 == 0 { return c; }
        let y = c.llen;
        let op = e.a;
        // BinOp order — 0 Add, 1 Sub, 2 Mul, 3 Div, 4 Mod,
        // 5..=10 cmp, 11 Shl, 12 Shr, 13 BitAnd, 14 BitOr, 15 BitXor,
        // 16 LAnd, 17 LOr — same numbering as the Bin arm.
        let v: i64 = 0;
        let ok: u8 = 0;
        if op == 0 {
            if (x > 0 && y <= imax - x)
                || (x <= 0 && y >= imin - x) {
                v = x + y; ok = 1;
            }
        }
        if op == 1 {
            if (y > 0 && x >= imin + y)
                || (y <= 0 && x <= imax + y) {
                v = x - y; ok = 1;
            }
        }
        if op == 2 {
            // mul — bounded operands keep the product inside i64;
            // larger magnitudes decline (stage-0's checked_mul
            // declines overflow too, though its i128 accepts more)
            let ax: i64 = x; let ay: i64 = y;
            if ax < 0 { ax = 0 - ax; }
            if ay < 0 { ay = 0 - ay; }
            if ax <= 3037000499 && ay <= 3037000499 {
                v = x * y; ok = 1;
            }
        }
        if op == 3 || op == 4 {
            if y != 0 {
                if x == imin && y == 0 - 1 {
                    ok = 0;
                } else {
                    if op == 3 { v = x / y; ok = 1; }
                    else { v = x % y; ok = 1; }
                }
            }
        }
        if op == 11 {
            if y >= 0 && y <= 30 && x >= 0 && x <= 2147483647 {
                v = x << y; ok = 1;
            }
        }
        if op == 12 {
            if y >= 0 && y <= 62 {
                v = x >> y; ok = 1;
            }
        }
        if op == 13 { v = x & y; ok = 1; }
        if op == 14 { v = x | y; ok = 1; }
        if op == 15 { v = x ^ y; ok = 1; }
        c.llen = v; c.res5 = u32(ok);
        return c;
    }
    return c;
}

/// coerce — want vs got, stage-0's adoption rules then the
/// mismatch diag. res = resulting ty (want on most paths).
fn coerce(own c: Checker, read p: ast.Parser, want: u32, eid: u32,
          got: u32) -> Checker {
    let e = xexp(c, p, eid);
    if want == NONE() { c.res = got; return c; }
    if resolve.ty_eq(c.r, want, got) { c.res = got; return c; }
    let w = c.r.rtys.buf[u64(want)];
    let g = c.r.rtys.buf[u64(got)];
    // `slice mut T` weakens to `slice T` — never the reverse
    if w.kind == 17 && g.kind == 17 {
        if w.a == g.a && (w.b == 0 || g.b == 1) {
            c.res = want; return c;
        }
    }
    // `channel void` adopts the declared payload
    if w.kind == 23 && g.kind == 23 {
        let ge = c.r.rtys.buf[u64(g.a)];
        if ge.kind == 9 || w.a == g.a { c.res = want; return c; }
    }
    // `*T` → `*void`/`*const void` — const-strengthening only
    if w.kind == 16 && g.kind == 16 {
        let we = c.r.rtys.buf[u64(w.a)];
        if we.kind == 9 && (w.b == 0 || g.b == 1) {
            c.res = want; return c;
        }
    }
    // `*mut T` → `*const T`
    if w.kind == 16 && g.kind == 16 && w.b == 0 && g.b == 1 {
        if resolve.ty_eq(c.r, w.a, g.a) { c.res = want; return c; }
    }
    // atomic storage discipline — value-level the same bits
    let wu = want; let gu = got;
    let wn = w; let gn = g;
    if wn.kind == 20 { wu = wn.a; wn = c.r.rtys.buf[u64(wu)]; }
    if gn.kind == 20 { gu = gn.a; gn = c.r.rtys.buf[u64(gu)]; }
    if resolve.ty_eq(c.r, wu, gu) { c.res = want; return c; }
    let ek = ek_num(e.kind);
    // a literal IS the `str` view where wanted
    if wn.kind == 10 && ek == 3 { c.res = want; return c; }
    // str literal → `*const u8` | `*const void`
    if wn.kind == 16 && wn.b == 0 && ek == 3 {
        let we = c.r.rtys.buf[u64(wn.a)];
        if we.kind == 0 || we.kind == 9 { c.res = want; return c; }
    }
    // `0` is the null pointer constant
    if wn.kind == 16 && ek == 0 && e.w == 0 {
        c.res = want; return c;
    }
    // int literal in want's range → adopt
    if ek == 0 && wn.kind <= 7 {
        let lo: i64 = 0; let hi: i64 = 0;
        if wn.kind == 0 { hi = 255; }
        if wn.kind == 1 { hi = 65535; }
        if wn.kind == 2 { hi = 4294967295; }
        if wn.kind == 3 { hi = 9223372036854775807; }
        if wn.kind == 4 { lo = 0 - 128; hi = 127; }
        if wn.kind == 5 { lo = 0 - 32768; hi = 32767; }
        if wn.kind == 6 { lo = 0 - 2147483648; hi = 2147483647; }
        if wn.kind == 7 { lo = e.w; hi = e.w; }
        if e.w >= lo && e.w <= hi { c.res = want; return c; }
    }
    // N29 — pure-literal tree folds at want
    c = const_int(c, p, eid, wu);
    if c.res5 == 1 {
        let v = c.llen;
        let fits: u8 = 0;
        if wn.kind == 0 { if v >= 0 && v <= 255 { fits = 1; } }
        if wn.kind == 1 { if v >= 0 && v <= 65535 { fits = 1; } }
        if wn.kind == 2 { if v >= 0 && v <= 4294967295 { fits = 1; } }
        if wn.kind == 3 { if v >= 0 { fits = 1; } }
        if wn.kind == 4 { if v >= 0 - 128 && v <= 127 { fits = 1; } }
        if wn.kind == 5 {
            if v >= 0 - 32768 && v <= 32767 { fits = 1; }
        }
        if wn.kind == 6 {
            if v >= 0 - 2147483648 && v <= 2147483647 { fits = 1; }
        }
        if wn.kind == 7 { fits = 1; }
        if wn.kind <= 7 {
            if fits == 1 { c.res = want; return c; }
            let m = vec.Vec<u8>::new(c.heap);
            let m2 = resolve.bputs(m,
                "constant expression folds to ");
            let m3 = loader.bpush_i64(m2, v);
            let m4 = resolve.bputs(m3, ", which does not fit ");
            let t1 = push_ty(m4, c, want);
            c = t1.c;
            c = pdiag(c, e.line, e.col, t1.m.as_slice());
            t1.m.destroy();
            c.res = want;
            return c;
        }
    }
    // mismatch
    let m = vec.Vec<u8>::new(c.heap);
    let m2 = resolve.bputs(m, "type mismatch: expected `");
    let t1 = push_ty(m2, c, want);
    c = t1.c;
    let m4 = resolve.bputs(t1.m, "`, found `");
    let t2 = push_ty(m4, c, got);
    c = t2.c;
    t2.m = t2.m.push(u8(96));
    c = pdiag(c, e.line, e.col, t2.m.as_slice());
    t2.m.destroy();
    c.res = want;
    return c;
}

/// stage `e_ty`'s render into a message vec (ev-staging + copy back).
pub struct TM { c: Checker, m: vec.Vec<u8> }
fn push_ty(own m: vec.Vec<u8>, own c: Checker, t: u32) -> TM {
    let mark = u64(c.ev.len);
    c = e_ty(c, t);
    let i = mark;
    while i < c.ev.len {
        m = m.push(c.ev.buf[i]);
        i = i + 1;
    }
    while u64(c.ev.len) > mark { c.ev.pop(); }
    return TM { c: c, m: m };
}

/// outlives — prov ordering: Region(a) outlives Region(b) when a is
/// an ancestor-or-equal frame of b.
fn outlives(read c: Checker, pk: u8, pv: u32, qk: u8, qv: u32) -> u8 {
    if pk == 0 { return 1; }                 // unknown — diag'd elsewhere
    if qk == 1 {                             // want param: only param wins
        if pk == 1 { return 1; }
        return 0;
    }
    if pk == 1 { return 1; }                 // param outlives all
    if qk == 0 { return 1; }
    // Region(pv) outlives Region(qv) iff pv is on qv's parent chain
    let f = qv;
    while 1 == 1 {
        if f == pv { return 1; }
        let rf = c.regs.buf[u64(f)];
        if rf.parent == NONE() { return 0; }
        f = rf.parent;
    }
}

/// does prov render as the given region? — used by Let escape check.
fn prov_is_region(read c: Checker, pk: u8, pv: u32) -> u8 {
    if pk >= 2 { return 1; }
    return 0;
}

/// defer_name_conflict — a live reservation on a same-named root.
fn defer_name_conflict(read c: Checker, n: u32) -> u32 {
    let i: u64 = 0;
    while i < c.dres.len {
        let d = c.dres.buf[i];
        if dname_eq(c, d.k, n) == 1 { return d.line; }
        i = i + 1;
    }
    return NONE();
}

/// reservation key's root name equals resolver name `n`?
fn dname_eq(read c: Checker, k: u32, n: u32) -> u8 {
    let sp = c.kns.buf[u64(k)];
    let ns = c.r.rns.buf[u64(n)];
    if u64(ns.len) > u64(sp.len) { return 0; }
    let i: u64 = 0;
    while i < u64(ns.len) {
        if c.kbyt.buf[u64(sp.off) + i] != c.r.rbyt.buf[u64(ns.off) + i] {
            return 0;
        }
        i = i + 1;
    }
    // next char must be `#` (the root is `n#e`)
    if u64(sp.len) == u64(ns.len) { return 0; }
    if c.kbyt.buf[u64(sp.off) + u64(ns.len)] == u8(35) { return 1; }
    return 0;
}

/// defer_conflict — t is reserved or a strict ancestor of one.
fn defer_conflict(read c: Checker, t: u32) -> u32 {
    let i: u64 = 0;
    while i < c.dres.len {
        let d = c.dres.buf[i];
        if d.k == t || kprefix(c, t, d.k) == 1 { return d.line; }
        i = i + 1;
    }
    return NONE();
}

/// record_edges — rebind holder's edge set to the RefInfo.
fn record_edges(own c: Checker, key: u32, el: u32, ec: u32,
                has_span: u8) -> Checker {
    // kill holder subtree's edges
    c = kill_set(c, key, 1);
    c = edges_retain_holder(c, key);
    if c.lrefs_mf != NONE() {
        let mf = c.lrefs_mf;
        let dl = defer_conflict(c, mf);
        if dl != NONE() {
            let m = vec.Vec<u8>::new(c.heap);
            let m2 = resolve.bputs(m, "cannot move `");
            let m3 = push_ktail(m2, c, mf, 0);
            let m4 = resolve.bputs(m3,
                "`: it is reserved by the `defer` at line ");
            let m5 = loader.bpush_u64(m4, u64(dl));
            c = pdiag(c, el, ec, m5.as_slice());
            m5.destroy();
        }
        c = kill_set(c, mf, 1);
        c = edges_retain_holder(c, mf);
    }
    let kind: u8 = 1;
    if c.lrefs_mut != 0 { kind = 2; }
    let cert: u8 = 1;
    if c.lrefs_to.len > 1 { cert = 2; }
    let i: u64 = 0;
    while i < c.lrefs_to.len {
        let t = c.lrefs_to.buf[i];
        c = edge_set0(c, key, t, kind, cert, el, ec, has_span);
        i = i + 1;
    }
    return c;
}

/// remove every edge whose holder is `k` or a `k.`/`k[` descendant.
fn edges_retain_holder(own c: Checker, k: u32) -> Checker {
    let ks = vec.Vec<u64>::new(c.heap);
    let i: u64 = 0;
    while i < c.edges.len {
        if kprefix(c, k, c.edges.buf[i].h) == 1 { ks = ks.push(i); }
        i = i + 1;
    }
    // sort by (h,t) then emit+remove
    i = 1;
    while i < ks.len {
        let x = ks.buf[i];
        let ex = c.edges.buf[u64(u32(x))];
        let j = i;
        while j > 0 {
            let ey = c.edges.buf[u64(u32(ks.buf[j - 1]))];
            let less = u8(0);
            if kless(c, ex.h, ey.h) == 1 { less = 1; }
            else { if ey.h == ex.h { less = kless(c, ex.t, ey.t); } }
            if less == 0 { break; }
            ks.buf[j] = ks.buf[j - 1];
            j = j - 1;
        }
        ks.buf[j] = x;
        i = i + 1;
    }
    i = 0;
    while i < ks.len {
        let e = c.edges.buf[u64(u32(ks.buf[i]))];
        c = es(c, "(unedge ");
        c = eqs(c, e.h);
        c = ec(c, u8(32));
        c = eqs(c, e.t);
        c = ec(c, u8(41));
        c = rec(c);
        i = i + 1;
    }
    let w = vec.Vec<E2>::new(c.heap);
    i = 0;
    while i < c.edges.len {
        if kprefix(c, k, c.edges.buf[i].h) == 0 {
            w = w.push(c.edges.buf[i]);
        }
        i = i + 1;
    }
    c.edges.destroy();
    c.edges = w;
    ks.destroy();
    return c;
}

/// record_caps — install holder's identity edges to targets.
fn record_caps(own c: Checker, key: u32) -> Checker {
    c = capkill_set(c, key, 1);
    c = caps_retain_holder(c, key);
    let cert: u8 = 1;
    if c.lcaps.len > 1 { cert = 2; }
    let i: u64 = 0;
    while i < c.lcaps.len {
        let t = c.lcaps.buf[i];
        c = cap_set(c, key, t, cert);
        i = i + 1;
    }
    return c;
}

/// nid bytes == literal `s`?
pub fn nid_lit_eq(read c: Checker, nid: u32, s: str) -> bool {
    let sp = c.r.rns.buf[u64(nid)];
    if u64(sp.len) != s.len { return false; }
    let i: u64 = 0;
    while i < s.len {
        if c.r.rbyt.buf[u64(sp.off) + i] != s.bytes[i] { return false; }
        i = i + 1;
    }
    return true;
}

/// builtin_shadow_diag — a local fn named `name` is shadowed by the
/// builtin form (unless the current fn IS that name).
fn builtin_shadow(own c: Checker, name: str,
                  line: u32, col: u32) -> Checker {
    let hit: u8 = 0;
    let i: u64 = 0;
    while i < c.r.fdecls.len {
        let fd = c.r.fdecls.buf[i];
        if fd.prog == c.who && nid_lit_eq(c, fd.name, name) { hit = 1; }
        i = i + 1;
    }
    if hit == 0 { return c; }
    if nid_lit_eq(c, c.regs.buf[0].name, name) { return c; }
    let m = vec.Vec<u8>::new(c.heap);
    let m2 = resolve.bputs(m, "`");
    let m3 = resolve.bputs(m2, name);
    let m4 = resolve.bputs(m3,
        "` is a builtin form here, not a call to the fn `");
    let m5 = resolve.bputs(m4, name);
    let m6 = resolve.bputs(m5,
        "` declared in this module — rename the fn (it stays callable qualified as `mod.");
    let m7 = resolve.bputs(m6, name);
    let m8 = resolve.bputs(m7, "(..)`");
    let m9 = m8.push(u8(41));
    c = pdiag(c, line, col, m9.as_slice());
    m9.destroy();
    return c;
}

/// record_lit_fields / record_tag / bind_task — v1 stubs filling
/// only what the emit needs (expanded corpus-driven).
/// rel_depth — '.' + '[' count in a rel key's bytes. Lit edges
/// install shallow-first: `record_edges(h)` kills `h`'s subtree,
/// so `""`/`f` must land before `f.g` survives.
fn rel_depth(read c: Checker, rel: u32) -> u32 {
    let sp = c.kns.buf[u64(rel)];
    let d: u32 = 0;
    let i: u64 = 0;
    while i < u64(sp.len) {
        let b = c.kbyt.buf[u64(sp.off) + i];
        if b == u8(46) || b == u8(91) { d = d + 1; }
        i = i + 1;
    }
    return d;
}

/// record_lit_fields — install the literal's interior facts under
/// `key`: per-field provs, ref edges (RefInfo per rel), caps, dead
/// marks, slice lens, tags, cstr-safety. Stage-0 re-roots every
/// `(rel, fact)` the literal produced as `key.rel`.
fn record_lit_fields(own c: Checker, key: u32,
                     el: u32, ec: u32, has_span: u8) -> Checker {
    let i: u64 = 0;
    if c.last_lit.len > 0 {
        while i < c.last_lit.len {
            let pv = c.last_lit.buf[i];
            c = key_join_rel(c, key, pv.k);
            let h = c.res;
            c = prov_set(c, h, pv.pk, pv.pv);
            i = i + 1;
        }
        while c.last_lit.len > 0 { c.last_lit.pop(); }
    }
    // shallow-first edge order
    let ord = vec.Vec<u32>::new(c.heap);
    i = 0;
    while i < c.lit_edges.len {
        ord = ord.push(u32(i));
        i = i + 1;
    }
    i = 1;
    while i < ord.len {
        let x = ord.buf[i];
        let j = i;
        while j > 0 {
            let a = c.lit_edges.buf[u64(x)];
            let b = c.lit_edges.buf[u64(ord.buf[j - 1])];
            if rel_depth(c, a.rel) >= rel_depth(c, b.rel) { break; }
            ord.buf[j] = ord.buf[j - 1];
            j = j - 1;
        }
        ord.buf[j] = x;
        i = i + 1;
    }
    i = 0;
    while i < ord.len {
        let le = c.lit_edges.buf[u64(ord.buf[i])];
        let ri = c.rinfos.buf[u64(le.ri)];
        c = key_join_rel(c, key, le.rel);
        let h = c.res;
        if ri.foreign == 1 { c = foreign_set(c, h); }
        while c.lrefs_to.len > 0 { c.lrefs_to.pop(); }
        let q: u64 = 0;
        while q < u64(ri.tlen) {
            c.lrefs_to = c.lrefs_to.push(c.ri_to.buf[u64(ri.toff) + q]);
            q = q + 1;
        }
        c.lrefs_mut = ri.mut_;
        c.lrefs_mf = ri.mf;
        c = record_edges(c, h, el, ec, has_span);
        i = i + 1;
    }
    ord.destroy();
    while c.lit_edges.len > 0 { c.lit_edges.pop(); }
    i = 0;
    while i < c.lit_caps.len {
        let lc = c.lit_caps.buf[i];
        c = key_join_rel(c, key, lc.rel);
        let h = c.res;
        while c.lcaps.len > 0 { c.lcaps.pop(); }
        let q: u64 = 0;
        while q < u64(lc.len) {
            c.lcaps = c.lcaps.push(c.rlc_keys.buf[u64(lc.off) + q]);
            q = q + 1;
        }
        c = record_caps(c, h);
        i = i + 1;
    }
    while c.lit_caps.len > 0 { c.lit_caps.pop(); }
    i = 0;
    while i < c.lit_dead.len {
        let ld = c.lit_dead.buf[i];
        let cf = c.lit_dead_cfs.buf[u64(ld.cf)];
        c = key_join_rel(c, key, ld.rel);
        c = cons_set(c, c.res, cf.st, cf.aoff, cf.alen);
        i = i + 1;
    }
    while c.lit_dead.len > 0 { c.lit_dead.pop(); }
    i = 0;
    while i < c.lit_lens.len {
        let ll = c.lit_lens.buf[i];
        c = key_join_rel(c, key, ll.k);
        c = slen_set(c, c.res, ll.n);
        i = i + 1;
    }
    while c.lit_lens.len > 0 { c.lit_lens.pop(); }
    i = 0;
    while i < c.lit_tags.len {
        let lt = c.lit_tags.buf[i];
        c = key_join_rel(c, key, lt.k);
        c = tag_set(c, c.res, lt.v);
        i = i + 1;
    }
    while c.lit_tags.len > 0 { c.lit_tags.pop(); }
    i = 0;
    while i < c.lit_csafe.len {
        c = key_join_rel(c, key, c.lit_csafe.buf[i]);
        c = csafe_set(c, c.res);
        i = i + 1;
    }
    while c.lit_csafe.len > 0 { c.lit_csafe.pop(); }
    return c;
}
/// is `t` an enum-typed rty (kind 12/13 named after an edecl)?
fn is_enum_ty(read c: Checker, t: u32) -> u8 {
    if t == NONE() { return 0; }
    let n = c.r.rtys.buf[u64(t)];
    if n.kind != 12 && n.kind != 13 { return 0; }
    let i: u64 = 0;
    while i < c.r.edecls.len {
        if c.r.edecls.buf[i].name == n.name { return 1; }
        i = i + 1;
    }
    return 0;
}

/// `(untag k)` — remove the key's tag fact.
fn tag_unset(own c: Checker, k: u32) -> Checker {
    c = es(c, "(untag ");
    c = eqs(c, k);
    c = ec(c, u8(41));
    c = rec(c);
    let i: u64 = 0;
    while i < c.tag.len {
        if c.tag.buf[i].k == k {
            while i + 1 < c.tag.len {
                c.tag.buf[i] = c.tag.buf[i + 1];
                i = i + 1;
            }
            c.tag.pop();
            return c;
        }
        i = i + 1;
    }
    return c;
}

/// record_tag — enum tys take the value's tag (or `?`); everything
/// else clears.
fn record_tag(own c: Checker, read p: ast.Parser,
              eid: u32, has_init: u8, key: u32, ty: u32) -> Checker {
    if is_enum_ty(c, ty) == 0 {
        c = tag_unset(c, key);
        c.has_tag = 0;
        return c;
    }
    // enum: EnumLit|Var|Field|Index|Deref inits propagate last_tag;
    // all else get `?` — and clear last_tag either way.
    let prop: u8 = 0;
    if has_init == 1 {
        let k = ek_num(xexp(c, p, eid).kind);
        if k == 2 || k == 7 || k == 8 || k == 16 { prop = 1; }
        // EnumLit: StructLit under an enum ty is the variant form;
        // AssocFn `E::V(..)` is the other spelling.
        if k == 10 || k == 20 { prop = 1; }
    }
    if prop == 1 {
        let tv = c.tag_v;
        let th = c.tag_has;
        c.has_tag = 0;
        if th == 1 { return tag_set(c, key, tv); }
        return tag_set(c, key, NONE());
    }
    c.has_tag = 0;
    return tag_set(c, key, NONE());
}
/// bind_task — a `spawn` result meets its binding. `is_spawn`==0 when
/// the spawn wasn't the direct init/RHS: unbound tasks are rejected
/// outright (nobody can join them; dropping holds would lose the
/// child's claimed authority silently).
fn bind_task(own c: Checker, key: u32, is_spawn: u8) -> Checker {
    if c.has_spawn == 0 { return c; }
    c.has_spawn = 0;
    let line = c.sp_line;
    let col = c.sp_col;
    if is_spawn == 0 {
        c = pdiag_s(c, line, col,
            "a `spawn` must be bound directly: `let t = spawn { .. }`");
        return c;
    }
    let effi = c.spawn_eff;
    let hoff = c.sp_hoff;
    let hlen = c.sp_hlen;
    // Rebinding a task place abandons the old task: its hold edges die
    // with the binding.
    c = edges_retain_holder(c, key);
    // holds → `t -> k` edges, sorted by target; each propagates into
    // the enclosing task's window via record_hold (nested spawn).
    let ks = vec.Vec<KM>::new(c.heap);
    let i: u64 = u64(hoff);
    while i < u64(hoff) + u64(hlen) {
        ks = ks.push(c.tk_holds.buf[i]);
        i = i + 1;
    }
    i = 1;
    while i < ks.len {
        let x = ks.buf[i];
        let j = i;
        while j > 0 && kless(c, x.k, ks.buf[j - 1].k) == 1 {
            ks.buf[j] = ks.buf[j - 1];
            j = j - 1;
        }
        ks.buf[j] = x;
        i = i + 1;
    }
    i = 0;
    while i < ks.len {
        let h = ks.buf[i];
        c = edge_set(c, key, h.k, h.m, 1, line, col);
        c = record_hold(c, h.k, h.m);
        i = i + 1;
    }
    ks.destroy();
    c = es(c, "(task ");
    c = eqs(c, key);
    c = es(c, " @");
    c = eu(c, u64(line));
    c = ec(c, u8(58));
    c = eu(c, u64(col));
    c = ec(c, u8(41));
    c = rec(c);
    c.tasks = c.tasks.push(Task {
        key: key, line: line, col: col,
        hoff: hoff, hlen: hlen, eff: effi });
    return c;
}

/// kill_temp — a `$rvN` temp dies mid-block: unbind + expire facts.
fn kill_temp(own c: Checker, n: u32) -> Checker {
    // stage-0 removes from `scopes.last_mut()` only — the match-head
    // sweep calls us for every visible $rv, but a temp bound in an
    // OUTER scope is untouched there (no unbind, no unwind events).
    if c.scopes.len == 0 { return c; }
    let top = u64(c.scopes.buf[u64(c.scopes.len - 1)]);
    let i = c.bnames.len;
    let found: u8 = 0;
    while i > 0 {
        i = i - 1;
        if c.bnames.buf[i].k == n { found = 1; break; }
    }
    if found == 0 { return c; }
    if i < top { return c; }
    let b = c.binds.buf[u64(c.bnames.buf[i].v)];
    c = key_of(c, n, b.epoch);
    let k = c.res;
    while i + 1 < c.bnames.len {
        c.bnames.buf[i] = c.bnames.buf[i + 1];
        i = i + 1;
    }
    c.bnames.pop();
    // structural death on the single dead root
    let dead = vec.Vec<u32>::new(c.heap);
    dead = dead.push(k);
    c = edges_retain_dead(c, dead);
    c = caps_retain_dead(c, dead);
    c = provs_retain_dead(c, dead);
    c = cons_retain_dead(c, dead);
    c = init_retain_dead(c, dead);
    c = tag_retain_dead(c, dead);
    dead.destroy();
    return c;
}

/// pop_scope_defers — replay this scope's defer list LIFO; drop
/// reservations either way. expr replay needs the active parser.
fn pop_scope_defers(own c: Checker, read p: ast.Parser) -> Checker {
    let list = c.defers.pop();
    if c.terminated == 1 || c.diverged == 1 {
        let i: u64 = 0;
        while i < list.len {
            let dr = list.buf[i];
            let j: u64 = 0;
            while j < u64(dr.olen) {
                c = undres(c, c.df_keys.buf[u64(dr.ooff) + j]);
                j = j + 1;
            }
            j = 0;
            while j < u64(dr.clen) {
                c = undres(c, c.df_keys.buf[u64(dr.coff) + j]);
                j = j + 1;
            }
            i = i + 1;
        }
        list.destroy();
        return c;
    }
    let i = list.len;
    while i > 0 {
        i = i - 1;
        let dr = list.buf[i];
        c = es(c, "(defer-run @");
        let e = p.exps.buf[u64(dr.eid)];
        c = eu(c, u64(e.line));
        c = ec(c, u8(58));
        c = eu(c, u64(e.col));
        c = ec(c, u8(41));
        c = rec(c);
        let j: u64 = 0;
        while j < u64(dr.olen) {
            c = undres(c, c.df_keys.buf[u64(dr.ooff) + j]);
            j = j + 1;
        }
        j = 0;
        while j < u64(dr.clen) {
            c = undres(c, c.df_keys.buf[u64(dr.coff) + j]);
            j = j + 1;
        }
        c = expr_tv(c, p, dr.eid);
        i = i;
    }
    list.destroy();
    return c;
}

/// prefix bytes + key bytes — `*`++`k` opaque targets.
fn key_pre(own c: Checker, s: str, k: u32) -> Checker {
    let i: u64 = 0;
    while i < s.bytes.len {
        c.ksc = c.ksc.push(u8(s.bytes[i]));
        i = i + 1;
    }
    let sp = c.kns.buf[u64(k)];
    i = 0;
    while i < u64(sp.len) {
        c.ksc = c.ksc.push(c.kbyt.buf[u64(sp.off) + i]);
        i = i + 1;
    }
    let n = u64(c.ksc.len);
    c = kin(c, &c.ksc.buf[0..n]);
    while c.ksc.len > 0 { c.ksc.pop(); }
    return c;
}


/// push parser name pid's bytes.
fn push_pname(own v: vec.Vec<u8>, read p: ast.Parser,
              id: u32) -> vec.Vec<u8> {
    let n = p.names.buf[u64(id)];
    let i: u64 = 0;
    while i < u64(n.len) {
        v = v.push(p.nbyt.buf[u64(n.off) + i]);
        i = i + 1;
    }
    return v;
}

/// target_name — `x`, `x.f`, `a[i]`/`a[5]`, `a[..]`, `*p`.
fn tn_into(own v: vec.Vec<u8>, read c: Checker, read p: ast.Parser,
           eid: u32) -> vec.Vec<u8> {
    let e = xexp(c, p, eid);
    let k = ek_num(e.kind);
    let rvn = rv_find(c, eid);
    if rvn != NONE() { return push_rname(v, c, rvn); }   // $rv temp
    if k == 2 { return push_pname(v, p, e.a); }          // Var
    if k == 7 {                                          // Field
        v = tn_into(v, c, p, e.a);
        v = v.push(u8(46));
        return push_pname(v, p, e.b);
    }
    if k == 8 {                                          // Index
        v = tn_into(v, c, p, e.a);
        v = v.push(u8(91));
        let ie = p.exps.buf[u64(e.b)];
        if ek_num(ie.kind) == 0 {
            v = resolve.bu32(v, u64(ie.w));
        } else {
            v = v.push(u8(105));
        }
        return v.push(u8(93));
    }
    if k == 9 {                                          // IndexRange
        v = tn_into(v, c, p, e.a);
        return resolve.bputs(v, "[..]");
    }
    if k == 16 {                                         // Deref
        v = v.push(u8(42));
        return tn_into(v, c, p, e.a);
    }
    return resolve.bputs(v, "?");
}

/// auth rank — Read<Atomic<Sync<Write<Own (my codes).
fn auth_rank(a: u8) -> u8 {
    if a == 1 { return 0; }
    if a == 4 { return 1; }
    if a == 5 { return 2; }
    if a == 2 { return 3; }
    return 4;
}

/// record_hold — upsert to max auth, emit `(hold k auth)`.
fn record_hold(own c: Checker, k: u32, a: u8) -> Checker {
    let na = a;
    let i: u64 = 0;
    let found: u8 = 0;
    while i < c.holds.len {
        if c.holds.buf[i].k == k {
            found = 1;
            if auth_rank(c.holds.buf[i].m) >= auth_rank(a) {
                na = c.holds.buf[i].m;
            } else {
                c.holds.buf[i] = KM { k: k, m: a };
            }
            i = c.holds.len;
        }
        if found == 0 { i = i + 1; }
    }
    if found == 0 { c.holds = c.holds.push(KM { k: k, m: a }); }
    c = es(c, "(hold ");
    c = eqs(c, k);
    c = ec(c, u8(32));
    c = eauth(c, na);
    c = ec(c, u8(41));
    c = rec(c);
    return c;
}

/// transit_check — overlap against channel-transit keys; emits the
/// diag. res=1 on hit.
fn transit_check(own c: Checker, read p: ast.Parser,
                 eid: u32, k: u32) -> Checker {
    c.res = 0;
    let e = xexp(c, p, eid);
    let i: u64 = 0;
    while i < c.transit.len {
        if overlap(c, k, c.transit.buf[i]) == 1 {
            let m = vec.Vec<u8>::new(c.heap);
            let m2 = resolve.bputs(m, "cannot use `");
            let m3 = tn_into(m2, c, p, eid);
            let m4 = resolve.bputs(m3,
                "`: its authority was sent through a channel — `recv` must claim it first");
            c = pdiag(c, e.line, e.col, m4.as_slice());
            m4.destroy();
            c.res = 1;
            return c;
        }
        i = i + 1;
    }
    return c;
}

/// protecting_domain — a `mutex`-typed strict prefix of k, or a dom
/// root covering k (key_under — dom covers the ROOT itself).
fn protecting_domain(own c: Checker, read p: ast.Parser,
                     k: u32) -> Checker {
    c.res = NONE();
    let sp = c.kns.buf[u64(k)];
    let o = u64(sp.off);
    let n = u64(sp.len);
    let i: u64 = 0;
    while i < n {
        let x = c.kbyt.buf[o + i];
        if x == u8(46) || x == u8(91) {
            c = ksub(c, k, 0, i);
            let pk = c.res;
            c = key_ty(c, p, pk);
            if c.res != NONE()
                && c.r.rtys.buf[u64(c.res)].kind == 21 {
                c.res = pk;
                return c;
            }
        }
        i = i + 1;
    }
    i = 0;
    while i < c.doms.len {
        let d = c.doms.buf[i];
        if d.v != d.k && key_under(c, k, d.v) == 1 {
            c.res = d.k;
            return c;
        }
        i = i + 1;
    }
    c.res = NONE();
    return c;
}

/// unguarded_check — lock-domain access audit.
fn unguarded_check(own c: Checker, read p: ast.Parser,
                   eid: u32, k: u32) -> Checker {
    c = root_guard(c, p, eid);
    if c.res == 1 { return c; }
    c = protecting_domain(c, p, k);
    let d = c.res;
    if d == NONE() { return c; }
    let e = xexp(c, p, eid);
    let m = vec.Vec<u8>::new(c.heap);
    let m2 = resolve.bputs(m, "cannot access `");
    let m3 = tn_into(m2, c, p, eid);
    let m4 = resolve.bputs(m3, "`: `");
    let m5 = push_kname(m4, c, d);
    let m6 = resolve.bputs(m5,
        "`'s interior requires `lock`");
    c = pdiag(c, e.line, e.col, m6.as_slice());
    m6.destroy();
    return c;
}

/// edges_to — sorted holder keys of edges whose target overlaps k.
/// Fills pstash; res4 = count.
fn edges_to(own c: Checker, k: u32) -> Checker {
    while c.pstash.len > 0 { c.pstash.pop(); }
    let i: u64 = 0;
    while i < c.edges.len {
        if overlap(c, c.edges.buf[i].t, k) == 1 {
            c.pstash = c.pstash.push(c.edges.buf[i].h);
        }
        i = i + 1;
    }
    // insertion sort by key bytes
    i = 1;
    while i < c.pstash.len {
        let x = c.pstash.buf[i];
        let j = i;
        while j > 0 && kless(c, x, c.pstash.buf[j - 1]) == 1 {
            c.pstash.buf[j] = c.pstash.buf[j - 1];
            j = j - 1;
        }
        c.pstash.buf[j] = x;
        i = i + 1;
    }
    c.res4 = u32(c.pstash.len);
    return c;
}

/// caps_retain_holder — `(uncap h t)` per removed + drop k-subtree
/// holders.
fn caps_retain_holder(own c: Checker, k: u32) -> Checker {
    let ks = vec.Vec<u64>::new(c.heap);
    let i: u64 = 0;
    while i < c.caps.len {
        if kprefix(c, k, c.caps.buf[i].h) == 1 { ks = ks.push(i); }
        i = i + 1;
    }
    i = 1;
    while i < ks.len {
        let x = ks.buf[i];
        let ex = c.caps.buf[u64(u32(x))];
        let j = i;
        while j > 0 {
            let ey = c.caps.buf[u64(u32(ks.buf[j - 1]))];
            let less: u8 = 0;
            if kless(c, ex.h, ey.h) == 1 { less = 1; }
            else { if ey.h == ex.h { less = kless(c, ex.t, ey.t); } }
            if less == 0 { break; }
            ks.buf[j] = ks.buf[j - 1];
            j = j - 1;
        }
        ks.buf[j] = x;
        i = i + 1;
    }
    i = 0;
    while i < ks.len {
        let e = c.caps.buf[u64(u32(ks.buf[i]))];
        c = es(c, "(uncap ");
        c = eqs(c, e.h);
        c = ec(c, u8(32));
        c = eqs(c, e.t);
        c = ec(c, u8(41));
        c = rec(c);
        i = i + 1;
    }
    let w = vec.Vec<C3>::new(c.heap);
    i = 0;
    while i < c.caps.len {
        if kprefix(c, k, c.caps.buf[i].h) == 0 {
            w = w.push(c.caps.buf[i]);
        }
        i = i + 1;
    }
    c.caps.destroy();
    c.caps = w;
    ks.destroy();
    return c;
}

/// cons_retain_holder — `(uncons k)` per removed under k (store
/// overwrite resurrection).
fn cons_retain_holder(own c: Checker, k: u32,
                      reslot: u32, read tvars: vec.Vec<u32>) -> Checker {
    let ks = vec.Vec<u32>::new(c.heap);
    let i: u64 = 0;
    while i < c.cons.len {
        if kprefix(c, k, c.cons.buf[i].k) == 1 {
            // enum reslot: keep other-variant payload paths
            let keep: u8 = 0;
            if reslot != NONE() && tvars.len > 0
                && c.cons.buf[i].k != k {
                let j: u64 = 0;
                while j < tvars.len {
                    let tv = tvars.buf[j];
                    if tv != reslot
                        && seg_is(c, c.cons.buf[i].k, k, tv) == 1 {
                        keep = 1;
                    }
                    j = j + 1;
                }
            }
            if keep == 0 { ks = ks.push(c.cons.buf[i].k); }
        }
        i = i + 1;
    }
    let ks2 = ksort(c, ks);
    i = 0;
    while i < ks2.len {
        c = es(c, "(uncons ");
        c = eqs(c, ks2.buf[i]);
        c = ec(c, u8(41));
        c = rec(c);
        i = i + 1;
    }
    let w = vec.Vec<CF>::new(c.heap);
    i = 0;
    while i < c.cons.len {
        let hit: u8 = 0;
        let j: u64 = 0;
        while j < ks2.len {
            if ks2.buf[j] == c.cons.buf[i].k { hit = 1; }
            j = j + 1;
        }
        if hit == 0 { w = w.push(c.cons.buf[i]); }
        i = i + 1;
    }
    c.cons.destroy();
    c.cons = w;
    ks2.destroy();
    return c;
}

/// is `k`'s first segment after `base`'s prefix the name `vn`?
/// `x#1.Foo.rest` vs base `x#1` → compare "Foo" to vn's rns bytes.
fn seg_is(read c: Checker, k: u32, base: u32, vn: u32) -> u8 {
    let sk = c.kns.buf[u64(k)];
    let sb = c.kns.buf[u64(base)];
    if u64(sk.len) <= u64(sb.len) + 1 { return 0; }
    let i0 = u64(sb.off) + u64(sb.len) + 1;
    let vnsp = c.r.rns.buf[u64(vn)];
    let i = i0;
    let j: u64 = 0;
    while j < u64(vnsp.len) {
        if i >= u64(sk.off) + u64(sk.len) { return 0; }
        if c.kbyt.buf[i] != c.r.rbyt.buf[u64(vnsp.off) + j] {
            return 0;
        }
        i = i + 1;
        j = j + 1;
    }
    if i == u64(sk.off) + u64(sk.len) { return 1; }
    let b = c.kbyt.buf[i];
    if b == u8(46) || b == u8(91) { return 1; }
    return 0;
}

// ---- statements ------------------------------------------------------------// ---- statements ------------------------------------------------------------

/// `$rv` prefix on a resolver name?
fn n_is_rv(read c: Checker, n: u32) -> u8 {
    let sp = c.r.rns.buf[u64(n)];
    if sp.len < 3 { return 0; }
    if c.r.rbyt.buf[u64(sp.off)] == u8(36)
        && c.r.rbyt.buf[u64(sp.off) + 1] == u8(114)
        && c.r.rbyt.buf[u64(sp.off) + 2] == u8(118) {
        return 1;
    }
    return 0;
}

fn check_stmt(own c: Checker, read p: ast.Parser,
              sid: u32, ret: u32) -> Checker {
    // side-channels are consumed by their binding site or dropped —
    // a leftover pending lock/mutex/recv tuple never survives a stmt
    c.has_lock = 0;
    c.has_mutex = 0;
    c.has_recv = 0;
    let s = p.stmts.buf[u64(sid)];
    let k = sk_num(s.kind);
    if k == 0 {                             // Let
        c = check_let(c, p, s, ret);
    }
    if k == 1 {                             // Assign
        c = check_assign(c, p, s, ret);
    }
    if k == 2 {                             // Return
        c = check_return(c, p, s, ret);
    }
    if k == 3 {                             // If
        c = check_if(c, p, s, ret);
    }
    if k == 4 {                             // While
        c = check_while(c, p, s, ret);
    }
    if k == 5 || k == 6 {                   // Break | Continue
        c = check_brk(c, p, s, ret);
    }
    if k == 7 {                             // Expr
        c = expr_tv(c, p, s.a);
        if c.has_spawn == 1 {
            // a bare `spawn { .. }` stmt — nobody can join it.
            c.has_spawn = 0;
            let ex = p.exps.buf[u64(s.a)];
            c = pdiag_s(c, ex.line, ex.col,
                "a `spawn` must be bound directly: `let t = spawn { .. }`");
        }
    }
    if k == 8 {                             // Match
        c = check_match(c, p, s, ret);
    }
    if k == 9 {                             // Region
        c = check_region(c, p, s, ret);
    }
    if k == 10 {                            // Promote
        c = check_promote(c, p, s, ret);
    }
    if k == 11 {                            // Consume
        c = check_consume(c, p, s, ret);
    }
    if k == 12 {                            // Defer
        c = check_defer(c, p, s, ret);
    }
    // stage-0's check_stmt tail — a lit packet nobody claimed dies
    // with the stmt, and last_tag has no cross-stmt life either.
    c.has_tag = 0;
    c.tag_v = 0;
    c.tag_has = 0;
    while c.lit_edges.len > 0 { c.lit_edges.pop(); }
    while c.lit_caps.len > 0 { c.lit_caps.pop(); }
    while c.lit_dead.len > 0 { c.lit_dead.pop(); }
    while c.lit_dead_cfs.len > 0 { c.lit_dead_cfs.pop(); }
    while c.lit_lens.len > 0 { c.lit_lens.pop(); }
    while c.lit_tags.len > 0 { c.lit_tags.pop(); }
    while c.lit_csafe.len > 0 { c.lit_csafe.pop(); }
    while c.last_lit.len > 0 { c.last_lit.pop(); }
    c.has_lit = 0;
    return c;
}

/// Stmt::Let — bind install + init authority wiring.
fn check_let(own c: Checker, read p: ast.Parser,
             s: ast.Stmt, ret: u32) -> Checker {
    c.r = resolve.intern_pname(c.r, p, s.a);
    let n = c.r.res;
    // shadowing a defer-frozen name is rejected outright
    let dl = defer_name_conflict(c, n);
    if dl != NONE() {
        let m = vec.Vec<u8>::new(c.heap);
        let m2 = resolve.bputs(m, "cannot shadow `");
        let m3 = push_rname(m2, c, n);
        let m4 = resolve.bputs(m3,
            "`: it is reserved by the `defer` at line ");
        let m5 = loader.bpush_u64(m4, u64(dl));
        c = pdiag(c, s.d, s.e, m5.as_slice());
        m5.destroy();
        return c;
    }
    return check_let_n(c, p, n, s, ret);
}

/// check_let body — `n` already interned (synthetic `$rvN` lets
/// reach here directly; the parser path interns `s.a` first).
/// let_eval — initializer evaluation for `let`: computes the
/// binding type and provenance. res=t, res2=pk, res3=pv.
/// Split from check_let_n — this calls into expr_tv_w, the
/// deepest recursion path, so it must not share that frame.
fn let_eval(own c: Checker, read p: ast.Parser, n: u32,
            s: ast.Stmt, want: u32, owner: u32) -> Checker {
    let t: u32 = NONE();
    let pk: u8 = 0; let pv: u32 = 0;
    if s.b != NONE() && s.c != NONE() {
        // `let x: T = init`
        c = expr_tv_w(c, p, s.c, want, 1);
        let got = c.res;
        c = coerce(c, p, want, s.c, got);
        let t0 = c.res;
        c = push_place_lit(c, p, s.c);
        c = consume_owned_src(c, p, s.c, s.line, s.col);
        let gtk = c.r.rtys.buf[u64(got)].kind;
        if gtk == 15 || gtk == 17 {
            let pk2 = c.res2; let pv2 = c.res3;
            // prov regs are consumed above — re-derive from expr_tv_w
            c = expr_prov(c);
            if outlives(c, u8(c.res2), c.res3, 2, owner) == 0 {
                let m = vec.Vec<u8>::new(c.heap);
                let m2 = resolve.bputs(m,
                    "reference escapes region: value lives in ");
                let m3 = prov_into(m2, c, u8(pk2), pv2);
                let m4 = resolve.bputs(m3, ", but `");
                let m5 = push_rname(m4, c, n);
                let m6 = resolve.bputs(m5, "` requires ");
                let m7 = prov_into(m6, c, 2, owner);
                c = pdiag(c, s.line, s.col, m7.as_slice());
                m7.destroy();
            }
            t = t0;
            pk = u8(c.res2); pv = c.res3;
        } else { if gtk == 18 || t0 == NONE() { t = t0; pk = 2; pv = owner; }
        else {
            let tk2 = c.r.rtys.buf[u64(t0)].kind;
            if tk2 == 10 || tk2 == 24 || tk2 == 25 {
                t = t0; pk = 2; pv = owner;
            } else { t = t0; pk = 0; pv = 0; }
        } }
    } else { if s.b != NONE() {
        t = want;
    } else { if s.c != NONE() {
        c = expr_tv(c, p, s.c);
        let got = c.res;
        // prov rides res2/res3 — capture before consume clobbers
        let epk = u8(c.res2); let epv = c.res3;
        c = push_place_lit(c, p, s.c);
        c = consume_owned_src(c, p, s.c, s.line, s.col);
        let gtk = c.r.rtys.buf[u64(got)].kind;
        if gtk == 18 || gtk == 10 {
            t = got; pk = 2; pv = owner;
        } else {
            t = got; pk = epk; pv = epv;
        }
    } else {
        let m = vec.Vec<u8>::new(c.heap);
        let m2 = resolve.bputs(m, "`");
        let m3 = push_rname(m2, c, n);
        let m4 = resolve.bputs(m3,
            "` needs a type annotation or an initializer");
        c = pdiag(c, s.line, s.col, m4.as_slice());
        m4.destroy();
        c = rty_prim(c, 9);
        t = c.res;
    } } }
    if c.r.rtys.buf[u64(t)].kind == 9 {
        let m = vec.Vec<u8>::new(c.heap);
        let m2 = resolve.bputs(m, "`");
        let m3 = push_rname(m2, c, n);
        let m4 = resolve.bputs(m3, "` binds a void value");
        c = push_err(c, s.line, s.col, m4.as_slice());
        m4.destroy();
    }
    c.res = t; c.res2 = u32(pk); c.res3 = pv;
    return c;
}

fn check_let_n(own c: Checker, read p: ast.Parser, n: u32,
               s: ast.Stmt, ret: u32) -> Checker {
    let owner = cur_region(c);
    let want: u32 = NONE();
    if s.b != NONE() {
        c.r = resolve.cnv_ty(c.r, p, s.b);
        want = c.r.res;
        // `let x: T` — the annotation names only visible decls
        c = cty(c, want, s.line, s.col);
    }
    c = let_eval(c, p, n, s, want, owner);
    let t = c.res;
    let pk = u8(c.res2); let pv = c.res3;
    c.next_epoch = c.next_epoch + 1;
    let epoch = c.next_epoch;
    c = key_of(c, n, epoch);
    let key = c.res;
    if s.c != NONE() { c = let_edges(c, p, s, key, t); }
    // `let g = lock(m)` / `let m = mutex e` / `let g2 = g` —
    // bind-side domain ops (see let_ops: res=guard_dom,
    // res2=guard_root, res3=goff, res4=glen).
    let gdom: u32 = NONE();
    let groot: u32 = NONE();
    let ggoff: u32 = 0;
    let gglen: u32 = 0;
    if s.c != NONE() {
        c = let_ops(c, p, s, key);
        gdom = c.res;
        groot = c.res2;
        ggoff = c.res3;
        gglen = c.res4;
    }
    let lel = s.line; let lec = s.col;
    if s.c != NONE() {
        let ve3 = p.exps.buf[u64(s.c)];
        lel = ve3.line; lec = ve3.col;
    }
    c = record_lit_fields(c, key, lel, lec, 1);
    let thas: u8 = 0;
    if s.c != NONE() { thas = 1; }
    c = record_tag(c, p, s.c, thas, key, t);
    let isp: u8 = 0;
    if s.c != NONE() {
        if ek_num(p.exps.buf[u64(s.c)].kind) == 13 { isp = 1; }
    }
    c = bind_task(c, key, isp);
    // (bind …) emit
    c = es(c, "(bind ");
    c = eqs(c, key);
    c = es(c, " @");
    c = eu(c, u64(s.line));
    c = ec(c, u8(58));
    c = eu(c, u64(s.col));
    c = ec(c, u8(32));
    c = ec(c, u8(34));
    c = e_ty(c, t);
    c = ec(c, u8(34));
    c = ec(c, u8(32));
    c = eprov(c, pk, pv);
    c = ec(c, u8(32));
    c = eprov(c, 2, owner);
    if gdom != NONE() {
        c = es(c, " (guard ");
        c = eqs(c, gdom);
        c = ec(c, u8(32));
        c = eqs(c, groot);
        c = ec(c, u8(41));
    }
    c = es(c, ")");
    c = rec(c);
    c.binds = c.binds.push(CBind {
        n: n, epoch: epoch, ty: t,
        prov_k: pk, prov_v: pv,
        owner: owner, auth: 0,
        line: s.line, col: s.col,
        guard_dom: gdom, guard_root: groot,
        goff: ggoff, glen: gglen });
    c.bnames = c.bnames.push(KK { k: n, v: u32(c.binds.len) - 1 });
    return c;
}

/// let_edges — edge/cap/len attach for `let x = init`: init
/// flag, ref edges from the initializer, caps, slice len, and
/// str NUL-provenance. Split from check_let_n for frame size.
fn let_edges(own c: Checker, read p: ast.Parser,
             s: ast.Stmt, key: u32, t: u32) -> Checker {
    c = init_set(c, key, 1);
    c = refs_of(c, p, s.c);
    if c.lrefs_has == 1 {
        if c.lrefs_foreign == 1 { c = foreign_set(c, key); }
        let i: u64 = 0;
        c = kill_set(c, key, 1);
        c = edges_retain_holder(c, key);
        if c.lrefs_mf != NONE() {
            let mf = c.lrefs_mf;
            let dl2 = defer_conflict(c, mf);
            if dl2 != NONE() {
                let m = vec.Vec<u8>::new(c.heap);
                let m2 = resolve.bputs(m, "cannot move `");
                let m3 = push_ktail(m2, c, mf, 0);
                let m4 = resolve.bputs(m3,
                    "`: it is reserved by the `defer` at line ");
                let m5 = loader.bpush_u64(m4, u64(dl2));
                // born span = the init expr's (s0 passes `born`)
                let ve = xexp(c, p, s.c);
                c = pdiag(c, ve.line, ve.col, m5.as_slice());
                m5.destroy();
            }
            c = kill_set(c, mf, 1);
            c = edges_retain_holder(c, mf);
        }
        let kind: u8 = 1;
        if c.lrefs_mut != 0 { kind = 2; }
        let cert: u8 = 1;
        if c.lrefs_to.len > 1 { cert = 2; }
        let ie = p.exps.buf[u64(s.c)];
        while i < c.lrefs_to.len {
            let tg = c.lrefs_to.buf[i];
            c = edge_set0(c, key, tg, kind, cert,
                ie.line, ie.col, 1);
            i = i + 1;
        }
    }
    c = caps_of(c, p, s.c);
    if c.lcaps_has == 1 {
        c = record_caps(c, key);
    }
    c = slice_len_of(c, p, s.c);
    if c.llen_has == 1 {
        c = slen_set(c, key, c.llen);
    }
    // str NUL-provenance
    if c.r.rtys.buf[u64(t)].kind == 10 {
        let ie = p.exps.buf[u64(s.c)];
        if ek_num(ie.kind) == 3 {
            c = csafe_set(c, key);
        } else { if ek_num(ie.kind) == 2 {
            let bi = bfind(c, ie.a);
            if i64(bi) >= 0 {
                let vb = c.binds.buf[u64(bi)];
                c = key_of(c, ie.a, vb.epoch);
                if vhas(c.csafe, c.res) == 1 {
                    c = csafe_set(c, key);
                }
            }
        } }
    }
    return c;
}

/// let_ops — bind-side domain ops for `let`. res=guard_dom,
/// res2=guard_root, res3=goff, res4=glen (NONE/0 when not a guard).
/// `let g = lock(m)`: the pending lock tuple becomes a guard —
/// `g -> domain` rides the edge map silently (Stage-0 inserts it
/// directly, no (edge) event). `let m = mutex e`: register the
/// domain. `let g2 = g`: affine move — the domain hands to g2.
fn let_ops(own c: Checker, read p: ast.Parser,
           s: ast.Stmt, key: u32) -> Checker {
    c.res = NONE(); c.res2 = NONE(); c.res3 = 0; c.res4 = 0;
    let ie2 = p.exps.buf[u64(s.c)];
    let ik2 = ek_num(ie2.kind);
    if ik2 == 6 && c.has_lock == 1 {
        c.r = resolve.intern_pname(c.r, p, ie2.a);
        if nid_lit_eq(c, c.r.res, "lock") {
            c.edges = c.edges.push(E2 {
                h: key, t: c.lock_dom, kind: 5, cert: 1,
                bl: s.line, bc: s.col });
            c.res = c.lock_dom;
            c.res2 = c.lock_root;
            c.res3 = c.lock_off;
            c.res4 = c.lock_len;
        }
        c.has_lock = 0;
    }
    if ik2 == 15 && c.has_mutex == 1 {
        let r2 = key;
        if c.mx_len > 0 {
            r2 = c.glocks.buf[u64(c.mx_off)];
        }
        c = dom_set(c, key, r2);
        c.has_mutex = 0;
    }
    // `let g = recv(ch)` — the popped packet's graph delta installs
    // here: a `&mut` packet binds as an ordinary Ref local, handle
    // packets get identity edges, value packets re-root their
    // travelled subtree edges.
    if ik2 == 6 && c.has_recv == 1 {
        c.r = resolve.intern_pname(c.r, p, ie2.a);
        if nid_lit_eq(c, c.r.res, "recv") {
            c = claim_packet(c, p, u32(s.c), key);
        }
        c.has_recv = 0;
        // recv binds carry no guard domain — res must read NONE for
        // the caller's guard-emit gate (claim left it as a key).
        c.res = NONE(); c.res2 = NONE(); c.res3 = 0; c.res4 = 0;
    }
    if ik2 == 2 {
        c.r = resolve.intern_pname(c.r, p, ie2.a);
        let bi2 = bfind(c, c.r.res);
        if i64(bi2) >= 0 {
            let vb2 = c.binds.buf[u64(bi2)];
            if vb2.guard_dom != NONE() {
                c = key_of(c, c.r.res, vb2.epoch);
                let old = c.res;
                c = cons1(c, old, 1, s.line, s.col);
                c = edges_retain_holder(c, old);
                c.edges = c.edges.push(E2 {
                    h: key, t: vb2.guard_dom,
                    kind: 5, cert: 1,
                    bl: s.line, bc: s.col });
                c.res = vb2.guard_dom;
                c.res2 = vb2.guard_root;
                c.res3 = vb2.goff;
                c.res4 = vb2.glen;
            }
        }
    }
    return c;
}

/// expr prov — expr_tv_w's res2/res3 survive into here via c; the
/// callers snapshot immediately. no-op placeholder.
fn expr_prov(own c: Checker) -> Checker { return c; }

/// prov text into a message vec (like push_ty — ev-staged).
fn prov_into(own v: vec.Vec<u8>, read c: Checker,
             pk: u8, pv: u32) -> vec.Vec<u8> {
    if pk == 1 { v = resolve.bputs(v, "param"); }
    else { if pk == 0 { v = resolve.bputs(v, "?"); }
    else {
        let rf = c.regs.buf[u64(pv)];
        let sp = c.r.rns.buf[u64(rf.name)];
        let i: u64 = 0;
        while i < u64(sp.len) {
            v = v.push(c.r.rbyt.buf[u64(sp.off) + i]);
            i = i + 1;
        }
    } }
    return v;
}


/// bind lookup by a root key `name#epoch` — name nid | NONE.
fn root_name(read c: Checker, rk: u32) -> u32 {
    let sp = c.kns.buf[u64(rk)];
    let i: u64 = 0;
    while i < u64(sp.len) {
        if c.kbyt.buf[u64(sp.off) + i] == u8(35) { break; }
        i = i + 1;
    }
    // rns scan by bytes
    let j: u64 = 0;
    while j < c.r.rns.len {
        let np = c.r.rns.buf[j];
        if u64(np.len) == i {
            let eq: u8 = 1;
            let x: u64 = 0;
            while x < i {
                if c.r.rbyt.buf[u64(np.off) + x]
                    != c.kbyt.buf[u64(sp.off) + x] { eq = 0; }
                x = x + 1;
            }
            if eq == 1 { return u32(j); }
        }
        j = j + 1;
    }
    return NONE();
}

/// does root key rk start with `$`?
fn k_is_arg(read c: Checker, rk: u32) -> u8 {
    let sp = c.kns.buf[u64(rk)];
    if sp.len == 0 { return 0; }
    if c.kbyt.buf[u64(sp.off)] == u8(36) { return 1; }
    return 0;
}

/// the name nid an `$argN`-key encodes → NONE when not `$argN`.
fn kk_lookup(read v: vec.Vec<KK>, k: u32) -> u32 {
    let i: u64 = 0;
    while i < v.len {
        if v.buf[i].k == k { return v.buf[i].v; }
        i = i + 1;
    }
    return NONE();
}

/// key_ty — the place key's rty via bind ty + arg side tables +
/// path walk. res = ty | NONE.
fn key_ty(own c: Checker, read p: ast.Parser, k: u32) -> Checker {
    c.res = NONE();
    c = key_root(c, k);
    let rk = c.res;
    let ty: u32 = NONE();
    if k_is_arg(c, rk) == 1 {
        let i = kk_lookup(c.arg_atomic, rk);
        if i != NONE() {
            ty = rty_wrap(c, 20, i);
        } else {
            let i2 = kk_lookup(c.arg_mutex, rk);
            if i2 != NONE() {
                ty = rty_wrap(c, 21, i2);
            } else {
                let i3 = kk_lookup(c.arg_chan, rk);
                if i3 != NONE() { ty = rty_wrap(c, 23, i3); }
            }
        }
        if ty == NONE() { c.res = NONE(); return c; }
    } else {
        let nn = root_name(c, rk);
        if nn == NONE() { c.res = NONE(); return c; }
        let bi = bfind(c, nn);
        if i64(bi) < 0 { c.res = NONE(); return c; }
        let b = c.binds.buf[u64(bi)];
        c = key_of(c, nn, b.epoch);
        if c.res != rk { c.res = NONE(); return c; }
        ty = b.ty;
    }
    // path walk — the key's tail after the root
    let sp = c.kns.buf[u64(k)];
    let rsp = c.kns.buf[u64(rk)];
    let pos = u64(sp.off) + u64(rsp.len);
    let end = u64(sp.off) + u64(sp.len);
    while pos < end {
        // storage wrappers are transparent
        let tn = c.r.rtys.buf[u64(ty)];
        if tn.kind == 21 || tn.kind == 22 || tn.kind == 20
            || tn.kind == 23 {
            ty = tn.a;
        }
        let x = c.kbyt.buf[pos];
        if x == u8(91) {                        // `[`
            let tn2 = c.r.rtys.buf[u64(ty)];
            if tn2.kind == 14 { ty = tn2.a; }
            if tn2.kind != 14 { c.res = NONE(); return c; }
            // skip to `]`
            let q = pos;
            while q < end && c.kbyt.buf[q] != u8(93) { q = q + 1; }
            pos = q + 1;
        }
        if x == u8(46) {                        // `.f`
            let q = pos + 1;
            while q < end {
                let y = c.kbyt.buf[q];
                if y == u8(46) || y == u8(91) { break; }
                q = q + 1;
            }
            let tn2 = c.r.rtys.buf[u64(ty)];
            if tn2.kind != 12 && tn2.kind != 13 {
                c.res = NONE(); return c;
            }
            c = sfields_of(c, ty);
            if c.res == NONE() { c.res = NONE(); return c; }
            let f0 = c.res; let fn2 = c.res2;
            let fid = rns_find_kbytes(c, pos + 1, q - pos - 1);
            if fid == NONE() { c.res = NONE(); return c; }
            let j: u64 = 0;
            let found: u32 = NONE();
            while j < u64(fn2) {
                let fd = c.r.sfields.buf[u64(f0) + j];
                if fd.name == fid { found = fd.ty; }
                j = j + 1;
            }
            if found == NONE() { c.res = NONE(); return c; }
            ty = found;
            pos = q;
        }
        if x != u8(91) && x != u8(46) {
            c.res = NONE(); return c;
        }
    }
    c.res = ty;
    return c;
}

/// rns lookup by kbyt byte range (absolute offsets into kbyt).
fn rns_find_kbytes(read c: Checker, off: u64, len: u64) -> u32 {
    let j: u64 = 0;
    while j < c.r.rns.len {
        let np = c.r.rns.buf[j];
        if u64(np.len) == len {
            let eq: u8 = 1;
            let x: u64 = 0;
            while x < len {
                if c.r.rbyt.buf[u64(np.off) + x]
                    != c.kbyt.buf[off + x] { eq = 0; }
                x = x + 1;
            }
            if eq == 1 { return u32(j); }
        }
        j = j + 1;
    }
    return NONE();
}

/// wrapper ty (mutex/atomic/channel/guard around `i`).
fn rty_wrap(read c: Checker, kind: u8, i: u32) -> u32 {
    let j: u64 = 0;
    while j < c.r.rtys.len {
        let t = c.r.rtys.buf[j];
        if t.kind == kind && t.a == i { return u32(j); }
        j = j + 1;
    }
    return NONE();
}

/// mutex_inner — key's ty is mutex → inner ty | NONE.
fn mutex_inner(own c: Checker, read p: ast.Parser, k: u32) -> Checker {
    c = key_ty(c, p, k);
    if c.res == NONE() { return c; }
    let t = c.r.rtys.buf[u64(c.res)];
    if t.kind == 21 { c.res = t.a; return c; }
    c.res = NONE();
    return c;
}

/// atomic_inner — key's ty is atomic → inner ty | NONE.
fn atomic_inner(own c: Checker, read p: ast.Parser, k: u32) -> Checker {
    c = key_ty(c, p, k);
    if c.res == NONE() { return c; }
    let t = c.r.rtys.buf[u64(c.res)];
    if t.kind == 20 { c.res = t.a; return c; }
    c.res = NONE();
    return c;
}

/// init_canon — `k[..]` normalizes to `k[]`.
fn init_canon(own c: Checker, k: u32) -> Checker {
    let sp = c.kns.buf[u64(k)];
    let n = u64(sp.len);
    if n >= 4 {
        let o = u64(sp.off);
        if c.kbyt.buf[o + n - 4] == u8(91)
            && c.kbyt.buf[o + n - 3] == u8(46)
            && c.kbyt.buf[o + n - 2] == u8(46)
            && c.kbyt.buf[o + n - 1] == u8(93) {
            // rebuild: k[0..n-4] + "[]"
            c.ksc = resolve.bpush(c.ksc,
                &c.kbyt.buf[o..o + n - 4]);
            c.ksc = c.ksc.push(u8(91));
            c.ksc = c.ksc.push(u8(93));
            let s0 = u64(c.ksc.len);
            c = kin(c, &c.ksc.buf[0..s0]);
            while u64(c.ksc.len) > 0 { c.ksc.pop(); }
            return c;
        }
    }
    c.res = k;
    return c;
}

/// init_parent — the parent key | NONE.
fn init_parent(own c: Checker, k: u32) -> Checker {
    c.res = NONE();
    let sp = c.kns.buf[u64(k)];
    let n = u64(sp.len);
    let o = u64(sp.off);
    if n >= 4
        && c.kbyt.buf[o + n - 4] == u8(91)
        && c.kbyt.buf[o + n - 3] == u8(46)
        && c.kbyt.buf[o + n - 2] == u8(46)
        && c.kbyt.buf[o + n - 1] == u8(93) {
        return ksub(c, k, 0, n - 4);
    }
    if n >= 2 && c.kbyt.buf[o + n - 2] == u8(91)
        && c.kbyt.buf[o + n - 1] == u8(93) {
        return ksub(c, k, 0, n - 2);
    }
    if n >= 1 && c.kbyt.buf[o] == u8(42) {     // `*` prefix
        return ksub(c, k, 1, n);
    }
    // rsplit `.`
    let i = n;
    while i > 0 {
        i = i - 1;
        if c.kbyt.buf[o + i] == u8(46) {
            return ksub(c, k, 0, i);
        }
    }
    return c;
}


/// init_state — 0 uninit, 1 init, 2 maybe.
fn init_state(own c: Checker, k0: u32, ty: u32) -> Checker {
    c.res = 0;
    c = init_canon(c, k0);
    let k = c.res;
    let cur = k;
    let spine_maybe: u8 = 0;
    while cur != NONE() {
        let cert = init_get(c, cur);
        if cert == 1 { c.res = 1; return c; }
        if cert == 2 { spine_maybe = 1; }
        let ck = cur;
        c = init_parent(c, ck);
        cur = c.res;
    }
    if ty != NONE() {
        let tn = c.r.rtys.buf[u64(ty)];
        if tn.kind == 12 || tn.kind == 13 {
            c = sfields_of(c, ty);
            if c.res != NONE() {
                let f0 = c.res; let fn2 = c.res2;
                let any: u8 = 0;
                let all: u8 = 1;
                let j: u64 = 0;
                while j < u64(fn2) {
                    let fd = c.r.sfields.buf[u64(f0) + j];
                    c = key_field(c, k, fd.name);
                    let fk = c.res;
                    c = init_state(c, fk, fd.ty);
                    if c.res == 1 { any = 1; }
                    if c.res == 2 { any = 1; all = 0; }
                    if c.res == 0 { all = 0; }
                    j = j + 1;
                }
                if all == 1 { c.res = 1; return c; }
                if any == 0 && spine_maybe == 0 { c.res = 0; return c; }
                c.res = 2;
                return c;
            }
        }
        if tn.kind == 14 {
            c = key_cat(c, k, "[]");
            let ek = c.res;
            c = init_state(c, ek, tn.a);
            if c.res == 1 { c.res = 1; return c; }
            if c.res == 0 && spine_maybe == 0 { c.res = 0; return c; }
            c.res = 2;
            return c;
        }
    }
    if spine_maybe == 1 { c.res = 2; return c; }
    c.res = 0;
    return c;
}

/// has_diag — an identical (span,msg) diag already queued?
fn has_diag(read c: Checker, line: u32, col: u32,
            m: slice u8) -> u8 {
    let i: u64 = 0;
    while i < c.errs.len {
        let d = c.errs.buf[i];
        if d.line == line && d.col == col {
            let dl = u64(d.m1) - u64(d.m0);
            if dl == u64(m.len) {
                let eq: u8 = 1;
                let j: u64 = 0;
                while j < dl {
                    if c.ebyt.buf[u64(d.m0) + j] != m[j] { eq = 0; }
                    j = j + 1;
                }
                if eq == 1 { return 1; }
            }
        }
        i = i + 1;
    }
    return 0;
}

/// require_init — the read-needs-value gate.
fn require_init(own c: Checker, read p: ast.Parser,
                eid: u32) -> Checker {
    let e = xexp(c, p, eid);
    let kind = ek_num(e.kind);
    if kind == 7 {
        // `.len`/`.ptr` on slice-ish bases — the storage IS the proof
        c.r = resolve.intern_pname(c.r, p, e.b);
        let bs = c.r.rns.buf[u64(c.r.res)];
        let islp: u8 = 0;
        if u64(bs.len) == 3
            && c.r.rbyt.buf[u64(bs.off)] == u8(108)
            && c.r.rbyt.buf[u64(bs.off) + 1] == u8(101)
            && c.r.rbyt.buf[u64(bs.off) + 2] == u8(110) { islp = 1; }
        if u64(bs.len) == 3
            && c.r.rbyt.buf[u64(bs.off)] == u8(112)
            && c.r.rbyt.buf[u64(bs.off) + 1] == u8(116)
            && c.r.rbyt.buf[u64(bs.off) + 2] == u8(114) { islp = 1; }
        if islp == 1 {
            c = ety_at(c, p, e.a);
            let bt = c.res;
            if bt != NONE() {
                let bk = c.r.rtys.buf[u64(bt)].kind;
                if bk == 17 || bk == 25 || bk == 10 {
                    return require_init(c, p, e.a);
                }
            }
        }
    }
    c = ety_at(c, p, eid);
    let ty = c.res;
    c = resolve_place(c, p, eid);
    let n = c.res4;
    let i: u64 = 0;
    while i < u64(n) {
        let k = c.pstash.buf[i];
        let k2 = k;
        if kind == 9 {
            c = key_cat(c, k, "[]");
            k2 = c.res;
        }
        c = init_state(c, k2, ty);
        let st = c.res;
        if st != 1 {
            let m = vec.Vec<u8>::new(c.heap);
            if st == 2 {
                m = resolve.bputs(m, "use of possibly-uninitialized `");
            }
            if st == 0 {
                m = resolve.bputs(m, "use of uninitialized `");
            }
            let m3 = tn_into(m, c, p, eid);
            let m4 = m3.push(u8(96));
            if has_diag(c, e.line, e.col, m4.as_slice()) == 0 {
                c = pdiag(c, e.line, e.col, m4.as_slice());
            }
            m4.destroy();
        }
        i = i + 1;
    }
    return c;
}

/// require_place_bases — `*p`/`s[i]` read the base's pointer first.
fn require_place_bases(own c: Checker, read p: ast.Parser,
                       eid: u32) -> Checker {
    let e = xexp(c, p, eid);
    let kind = ek_num(e.kind);
    if kind == 16 {
        c = require_init(c, p, e.a);
        return require_place_bases(c, p, e.a);
    }
    if kind == 8 || kind == 9 {
        c = ety_at(c, p, e.a);
        let bt = c.res;
        let is_slice: u8 = 0;
        if bt != NONE() {
            let bk = c.r.rtys.buf[u64(bt)].kind;
            if bk == 17 { is_slice = 1; }
            if bk == 17 || bk == 25 {
                c = require_init(c, p, e.a);
            }
        }
        if is_slice == 1 {
            c = place_id(c, p, e.a);
            let k = c.res;
            if k != NONE() {
                let killed: u8 = 0;
                let i: u64 = 0;
                while i < c.ekills.len {
                    if c.ekills.buf[i].k == k { killed = 1; }
                    i = i + 1;
                }
                let foreign: u8 = 0;
                i = 0;
                while i < c.foreign.len {
                    if c.foreign.buf[i] == k { foreign = 1; }
                    i = i + 1;
                }
                if killed == 1 && foreign == 0
                    && live_out_edge(c, k) == 0 {
                    let be = p.exps.buf[u64(e.a)];
                    let m = vec.Vec<u8>::new(c.heap);
                    let m2 = resolve.bputs(m,
                        "use of moved reference `");
                    let m3 = tn_into(m2, c, p, e.a);
                    let m4 = m3.push(u8(96));
                    c = pdiag(c, be.line, be.col, m4.as_slice());
                    m4.destroy();
                }
            }
        }
        return require_place_bases(c, p, e.a);
    }
    if kind == 7 {
        return require_place_bases(c, p, e.a);
    }
    return c;
}

/// path_holders — the holder keys traversed. Returns via hstash.
fn path_holders(own c: Checker, read p: ast.Parser,
                eid: u32) -> Checker {
    while c.hstash.len > 0 { c.hstash.pop(); }
    return ph_inner(c, p, eid);
}
fn ph_inner(own c: Checker, read p: ast.Parser,
            eid: u32) -> Checker {
    let e = xexp(c, p, eid);
    let kind = ek_num(e.kind);
    if kind == 2 || rv_find(c, eid) != NONE() {
        let vn = rv_find(c, eid);
        if vn == NONE() {
            c.r = resolve.intern_pname(c.r, p, e.a);
            vn = c.r.res;
        }
        let bi = bfind(c, vn);
        if i64(bi) < 0 { return c; }
        let b = c.binds.buf[u64(bi)];
        if b.auth != 0 || b.guard_dom != NONE() {
            c = key_of(c, vn, b.epoch);
            if vhas(c.hstash, c.res) == 0 {
                c.hstash = c.hstash.push(c.res);
            }
        }
        return c;
    }
    if kind == 7 { return ph_inner(c, p, e.a); }
    if kind == 8 || kind == 9 {
        c = ph_inner(c, p, e.a);
        c = ety_at(c, p, e.a);
        if c.res != NONE()
            && c.r.rtys.buf[u64(c.res)].kind == 17 {
            // slice base — its resolved keys are holders too
            c = resolve_place(c, p, e.a);
            let i: u64 = 0;
            while i < u64(c.res4) {
                if vhas(c.hstash, c.pstash.buf[i]) == 0 {
                    c.hstash = c.hstash.push(c.pstash.buf[i]);
                }
                i = i + 1;
            }
        }
        return c;
    }
    if kind == 16 {
        c = ph_inner(c, p, e.a);
        c = place_id(c, p, e.a);
        if c.res != NONE() && vhas(c.hstash, c.res) == 0 {
            c.hstash = c.hstash.push(c.res);
        }
        return c;
    }
    return c;
}

/// root_var — eid of the root Var in a place path | NONE.
fn root_var(read p: ast.Parser, eid: u32) -> u32 {
    let e = p.exps.buf[u64(eid)];
    let kind = ek_num(e.kind);
    if kind == 2 { return eid; }
    if kind == 7 || kind == 8 { return root_var(p, e.a); }
    return NONE();
}

/// root_auth — (has, auth, name nid, epoch) via res/res2/res3/res4.
fn root_auth(own c: Checker, read p: ast.Parser,
             eid: u32) -> Checker {
    c.res = 0; c.res2 = 0; c.res3 = 0; c.res4 = 0;
    let rv = root_var(p, eid);
    if rv == NONE() { return c; }
    let ve = p.exps.buf[u64(rv)];
    c.r = resolve.intern_pname(c.r, p, ve.a);
    let nn = c.r.res;
    let bi = bfind(c, nn);
    if i64(bi) < 0 { return c; }
    let b = c.binds.buf[u64(bi)];
    c.res = 1; c.res2 = u32(b.auth);
    c.res3 = nn; c.res4 = b.epoch;
    return c;
}

/// root_guard — guard triple via res fields:
/// res=has, res2=gk, res3=dom, res4=root, res5=bind idx.
fn root_guard(own c: Checker, read p: ast.Parser,
              eid: u32) -> Checker {
    c.res = 0;
    let e = xexp(c, p, eid);
    let kind = ek_num(e.kind);
    if kind == 7 || kind == 8 || kind == 16 {
        return root_guard(c, p, e.a);
    }
    if kind != 2 { return c; }
    c.r = resolve.intern_pname(c.r, p, e.a);
    let bi = bfind(c, c.r.res);
    if i64(bi) < 0 { return c; }
    let b = c.binds.buf[u64(bi)];
    if b.guard_dom == NONE() { return c; }
    c = key_of(c, c.r.res, b.epoch);
    c.res2 = c.res;                    // gk
    c.res3 = b.guard_dom;
    c.res4 = b.guard_root;
    c.res5 = u32(bi);
    c.res = 1;
    return c;
}

/// task membership — `ctx.tasks.contains_key(k)`.
fn task_has(read c: Checker, k: u32) -> u8 {
    let i: u64 = 0;
    while i < c.tasks.len {
        if c.tasks.buf[i].key == k { return 1; }
        i = i + 1;
    }
    return 0;
}

/// doms lookup — value of key d | d when absent.
fn dom_get(read c: Checker, d: u32) -> u32 {
    let i: u64 = 0;
    while i < c.doms.len {
        if c.doms.buf[i].k == d { return c.doms.buf[i].v; }
        i = i + 1;
    }
    return d;
}

/// sync_scan — Sync-edge domain conflict audit.
fn sync_scan(own c: Checker, read p: ast.Parser,
             eid: u32, k: u32, accessor_dom: u32) -> Checker {
    let i: u64 = 0;
    while i < c.edges.len {
        let ed = c.edges.buf[i];
        i = i + 1;
        if ed.kind != 5 { continue; }          // Sync
        let r = dom_get(c, ed.t);
        let covers: u8 = 0;
        if r == ed.t {
            if k != r && key_under(c, k, r) == 1 { covers = 1; }
        } else {
            if key_under(c, k, r) == 1 { covers = 1; }
        }
        if covers == 0 || ed.t == accessor_dom { continue; }
        let e = xexp(c, p, eid);
        if task_has(c, ed.h) == 1 {
            let ma = vec.Vec<u8>::new(c.heap);
            let ma = ma.push(u8(96));
            let ma = tn_into(ma, c, p, eid);
            let ma = resolve.bputs(ma, "` under mutex `");
            let ma = push_ktail(ma, c, ed.t, 0);
            let ma = resolve.bputs(ma,
                "` races unjoined task `");
            let ma = push_kname(ma, c, ed.h);
            let ma = resolve.bputs(ma,
                "`'s synchronized access (a different mutex domain)");
            c = pdiag(c, e.line, e.col, ma.as_slice());
            ma.destroy();
            return c;
        }
        let mb = vec.Vec<u8>::new(c.heap);
        let mb = mb.push(u8(96));
        let mb = tn_into(mb, c, p, eid);
        let mb = resolve.bputs(mb, "` under mutex `");
        let mb = push_ktail(mb, c, ed.t, 0);
        let mb = resolve.bputs(mb,
            "` conflicts with a different mutex domain");
        c = pdiag(c, e.line, e.col, mb.as_slice());
        mb.destroy();
        return c;
    }
    return c;
}

/// guarded_check — the under-lock access rule.
fn guarded_check(own c: Checker, read p: ast.Parser,
                 eid: u32, k: u32, wr: u8, gk: u32, dom: u32,
                 gbi: u32) -> Checker {
    let e = xexp(c, p, eid);
    c = use_check(c, p, eid, gk);
    if c.task_ret != NONE() {
        if vhas(c.task_ext, gk) == 1 {
            let m = vec.Vec<u8>::new(c.heap);
            let m2 = resolve.bputs(m, "guard `");
            let m3 = tn_into(m2, c, p, eid);
            let m4 = resolve.bputs(m3,
                "` cannot cross a spawn boundary");
            c = pdiag(c, e.line, e.col, m4.as_slice());
            m4.destroy();
            return c;
        }
    }
    c = sync_scan(c, p, eid, k, dom);
    c = transit_check(c, p, eid, k);
    c = record_hold(c, dom, 5);
    let gb = c.binds.buf[u64(gbi)];
    let goff = u64(gb.goff);
    let glen = u64(gb.glen);
    c = edges_to(c, k);
    let i: u64 = 0;
    while i < u64(c.res4) {
        let h = c.pstash.buf[i];
        i = i + 1;
        if h == gk { continue; }
        // in srcs?
        let in_srcs: u8 = 0;
        let j: u64 = goff;
        while j < goff + glen {
            if c.glocks.buf[j] == h { in_srcs = 1; }
            j = j + 1;
        }
        if in_srcs == 1 { continue; }
        // find its kind
        let fk: u8 = 0;
        let q: u64 = 0;
        while q < c.edges.len {
            if c.edges.buf[q].h == h
                && overlap(c, c.edges.buf[q].t, k) == 1 {
                fk = c.edges.buf[q].kind;
            }
            q = q + 1;
        }
        if fk == 5 { continue; }
        let bad: u8 = 0;
        if wr == 1 { bad = 1; }
        else { if fk != 1 { bad = 1; } }
        if bad == 0 { continue; }
        if task_has(c, h) == 1 {
            let ma = vec.Vec<u8>::new(c.heap);
            let ma = ma.push(u8(96));
            let ma = tn_into(ma, c, p, eid);
            let ma = resolve.bputs(ma,
                "` under a lock races unjoined task `");
            let ma = push_kname(ma, c, h);
            let ma = resolve.bputs(ma,
                "`'s unsynchronized access");
            c = pdiag(c, e.line, e.col, ma.as_slice());
            ma.destroy();
            return c;
        }
        let mb = vec.Vec<u8>::new(c.heap);
        let mb = mb.push(u8(96));
        let mb = tn_into(mb, c, p, eid);
        let mb = resolve.bputs(mb,
            "` under a lock conflicts with a live borrow");
        c = pdiag(c, e.line, e.col, mb.as_slice());
        mb.destroy();
        return c;
    }
    return c;
}

/// stale_check — handle targets must still be live.
fn stale_check(own c: Checker, read p: ast.Parser,
               inner: u32, use_line: u32, use_col: u32) -> Checker {
    c = resolve_place(c, p, inner);
    let n = c.res4;
    let i: u64 = 0;
    while i < u64(n) {
        let hk = c.pstash.buf[i];
        i = i + 1;
        let j: u64 = 0;
        while j < c.caps.len {
            let cp = c.caps.buf[j];
            j = j + 1;
            if cp.h != hk { continue; }
            let t = cp.t;
            c = key_root(c, t);
            let rk = c.res;
            if k_is_arg(c, rk) == 1 { continue; }
            let nn = root_name(c, rk);
            let alive: u8 = 0;
            if nn != NONE() {
                let bi = bfind(c, nn);
                if i64(bi) >= 0 {
                    let b = c.binds.buf[u64(bi)];
                    c = key_of(c, nn, b.epoch);
                    if c.res == rk && cons_covers(c, t) == 0 {
                        alive = 1;
                    }
                }
            }
            if alive == 0 {
                let m = vec.Vec<u8>::new(c.heap);
                let m2 = resolve.bputs(m, "use of stale handle `");
                let m3 = tn_into(m2, c, p, inner);
                let m4 = resolve.bputs(m3,
                    "`: its target no longer exists");
                c = pdiag(c, use_line, use_col, m4.as_slice());
                m4.destroy();
                return c;
            }
        }
    }
    return c;
}

/// place_req — required provenance of a store target.
fn place_req(own c: Checker, read p: ast.Parser,
             eid: u32) -> Checker {
    c.res2 = 0; c.res3 = 0;
    let e = xexp(c, p, eid);
    let kind = ek_num(e.kind);
    if kind == 2 || rv_find(c, eid) != NONE() {
        let vn = rv_find(c, eid);
        if vn == NONE() {
            c.r = resolve.intern_pname(c.r, p, e.a);
            vn = c.r.res;
        }
        let bi = bfind(c, vn);
        if i64(bi) < 0 { return c; }
        let b = c.binds.buf[u64(bi)];
        if b.auth != 0 { c.res2 = 1; c.res3 = 0; return c; }
        c.res2 = 2; c.res3 = b.owner;
        return c;
    }
    if kind == 7 { return place_req(c, p, e.a); }
    if kind == 8 {
        c = place_tv(c, p, e.a);
        if c.res != NONE()
            && c.r.rtys.buf[u64(c.res)].kind == 17 {
            c = expr_tv(c, p, e.a);
            return c;
        }
        return place_req(c, p, e.a);
    }
    if kind == 9 { return place_req(c, p, e.a); }
    if kind == 16 {
        c = expr_tv(c, p, e.a);
        return c;
    }
    return c;
}

/// record_prov — a stored ref's provenance onto the place.
fn record_prov(own c: Checker, read p: ast.Parser,
               eid: u32, pk: u8, pv: u32) -> Checker {
    let e = xexp(c, p, eid);
    if ek_num(e.kind) == 2 {
        c.r = resolve.intern_pname(c.r, p, e.a);
        let bi = bfind(c, c.r.res);
        if i64(bi) >= 0 {
            c.binds.buf[u64(bi)].prov_k = pk;
            c.binds.buf[u64(bi)].prov_v = pv;
        }
        return c;
    }
    c = place_id(c, p, eid);
    if c.res != NONE() {
        c = prov_set(c, c.res, pk, pv);
    }
    return c;
}

/// read_only_slice_hop — `slice` (not `slice mut`) on the path.
fn read_only_slice_hop(own c: Checker, read p: ast.Parser,
                       eid: u32) -> Checker {
    c.res = 0;
    let e = xexp(c, p, eid);
    let kind = ek_num(e.kind);
    if kind == 8 {
        c = ety_at(c, p, e.a);
        if c.res != NONE() {
            let t = c.r.rtys.buf[u64(c.res)];
            if t.kind == 17 && t.b == 0 { c.res = 1; return c; }
        }
        return read_only_slice_hop(c, p, e.a);
    }
    if kind == 7 {
        return read_only_slice_hop(c, p, e.a);
    }
    return c;
}

/// check_store — the write rule.
fn check_store(own c: Checker, read p: ast.Parser,
               tid: u32, vid: u32, vty: u32,
               vpk: u8, vpv: u32) -> Checker {
    let te = p.exps.buf[u64(tid)];
    let tkind = ek_num(te.kind);
    if tkind != 2 && tkind != 7 && tkind != 8 && tkind != 16 {
        c = pdiag_s(c, te.line, te.col,
            "assignment target is not a place");
        return c;
    }
    // capability law for writes
    c = root_auth(c, p, tid);
    if c.res == 1 {
        let ra = u8(c.res2);
        let rn = c.res3;
        let re = c.res4;
        if ra == 1 {                          // read
            let m = vec.Vec<u8>::new(c.heap);
            let m2 = resolve.bputs(m,
                "cannot write through read capability `");
            let m3 = resolve.bpush(m2, rns_bytes(c, rn));
            let m4 = m3.push(u8(96));
            c = pdiag(c, te.line, te.col, m4.as_slice());
            m4.destroy();
            return c;
        }
        if ra != 0 {
            c = key_of(c, rn, re);
            if live_out_edge(c, c.res) == 0 {
                let m = vec.Vec<u8>::new(c.heap);
                let m2 = resolve.bputs(m,
                    "use of moved authority `");
                let m3 = resolve.bpush(m2, rns_bytes(c, rn));
                let m4 = m3.push(u8(96));
                c = pdiag(c, te.line, te.col, m4.as_slice());
                m4.destroy();
                return c;
            }
        }
    }
    c = path_holders(c, p, tid);
    c = root_guard(c, p, tid);
    let g_has = c.res;
    let gk = c.res2;
    let gdom = c.res3;
    let gbi = c.res5;
    c = resolve_place(c, p, tid);
    let n = c.res4;
    let i: u64 = 0;
    while i < u64(n) {
        let t = c.pstash.buf[i];
        let dl = defer_conflict(c, t);
        if dl != NONE() {
            let m = vec.Vec<u8>::new(c.heap);
            let m2 = resolve.bputs(m, "cannot write to `");
            let m3 = tn_into(m2, c, p, tid);
            let m4 = resolve.bputs(m3,
                "`: it is reserved by the `defer` at line ");
            let m5 = resolve.bu32(m4, u64(dl));
            c = pdiag(c, te.line, te.col, m5.as_slice());
            m5.destroy();
            return c;
        }
        if g_has == 1 {
            c = guarded_check(c, p, tid, t, 1, gk, gdom, gbi);
            i = i + 1;
            continue;
        }
        c = unguarded_check(c, p, tid, t);
        c = transit_check(c, p, tid, t);
        c = record_hold(c, t, 2);
        // other holders into t block the write — hh = hstash copy
        // (hstash must stay owned by c across edges_to).
        let hh = clone_u(c.heap, c.hstash);
        c = edges_to(c, t);
        let m2 = c.res4;
        let j: u64 = 0;
        let bad: u8 = 0;
        let bad_h: u32 = 0;
        while j < u64(m2) {
            let h = c.pstash.buf[j];
            if vhas(hh, h) == 1 { j = j + 1; continue; }
            bad = 1; bad_h = h;
            j = u64(m2);
        }
        hh.destroy();
        if bad == 1 {
            if task_has(c, bad_h) == 1 {
                let ma = vec.Vec<u8>::new(c.heap);
                let ma = resolve.bputs(ma, "cannot write to `");
                let ma = tn_into(ma, c, p, tid);
                let ma = resolve.bputs(ma,
                    "`: held by unjoined task `");
                let ma = push_kname(ma, c, bad_h);
                let ma = ma.push(u8(96));
                c = pdiag(c, te.line, te.col, ma.as_slice());
                ma.destroy();
                return c;
            }
            let mb = vec.Vec<u8>::new(c.heap);
            let mb = resolve.bputs(mb, "cannot write to `");
            let mb = tn_into(mb, c, p, tid);
            let mb = resolve.bputs(mb, "`: it is borrowed");
            c = pdiag(c, te.line, te.col, mb.as_slice());
            mb.destroy();
            return c;
        }
        i = i + 1;
    }
    // `.bytes` is not a place
    if tkind == 7 {
        c = ety_at(c, p, te.a);
        if c.res != NONE()
            && c.r.rtys.buf[u64(c.res)].kind == 10 {
            c.r = resolve.intern_pname(c.r, p, te.b);
            let bs = c.r.rns.buf[u64(c.r.res)];
            if u64(bs.len) == 5
                && c.r.rbyt.buf[u64(bs.off)] == u8(98) {
                c = pdiag_s(c, te.line, te.col,
                    "cannot assign to `.bytes` — a `str`'s view is not a place");
                return c;
            }
        }
    }
    c = read_only_slice_hop(c, p, tid);
    if c.res == 1 {
        c = pdiag_s(c, te.line, te.col,
            "cannot write through `slice` (needs `slice mut`)");
        return c;
    }
    if tkind == 16 {
        c = expr_tv(c, p, te.a);
        if c.res != NONE() {
            let rt = c.r.rtys.buf[u64(c.res)];
            if rt.kind == 15 && rt.b == 0 {
                // Stage-0: ctx.errs.push — list-only, no (err) event
                let m = vec.Vec<u8>::new(c.heap);
                let m2 = resolve.bputs(m,
                    "cannot write through `&` (needs `&mut`)");
                c = push_err(c, te.line, te.col, m2.as_slice());
                m2.destroy();
            }
            if rt.kind == 18 {
                c = stale_check(c, p, te.a, te.line, te.col);
            }
        }
    }
    c = place_req(c, p, tid);
    let rpk = u8(c.res2);
    let rpv = c.res3;
    // vpk/vpv come pre-evaluated (Stage-0 uses vtv)
    if vty != NONE() {
        let vk = c.r.rtys.buf[u64(vty)].kind;
        if vk == 15 || vk == 17 {
            if outlives(c, vpk, vpv, rpk, rpv) == 0 {
                let ve = p.exps.buf[u64(vid)];
                let m = vec.Vec<u8>::new(c.heap);
                let m2 = resolve.bputs(m,
                    "reference escapes region: value lives in ");
                let m3 = prov_desc(m2, c, vpk, vpv);
                let m4 = resolve.bputs(m3, ", but `");
                let m5 = tn_into(m4, c, p, tid);
                let m6 = resolve.bputs(m5,
                    "` requires it to outlive ");
                let m7 = prov_desc(m6, c, rpk, rpv);
                c = pdiag(c, ve.line, ve.col, m7.as_slice());
                m7.destroy();
                return c;
            }
            c = record_prov(c, p, tid, vpk, vpv);
        }
    }
    return c;
}

/// Prov::describe — `uninitialized`/`the caller's frame`/`region `n``.
fn prov_desc(own v: vec.Vec<u8>, read c: Checker,
             pk: u8, pv: u32) -> vec.Vec<u8> {
    if pk == 1 { v = resolve.bputs(v, "the caller's frame"); }
    else { if pk == 0 { v = resolve.bputs(v, "uninitialized"); }
    else {
        let rf = c.regs.buf[u64(pv)];
        let sp = c.r.rns.buf[u64(rf.name)];
        v = resolve.bputs(v, "region `");
        let i: u64 = 0;
        while i < u64(sp.len) {
            v = v.push(c.r.rbyt.buf[u64(sp.off) + i]);
            i = i + 1;
        }
        v = v.push(u8(96));
    } }
    return v;
}

fn check_assign(own c: Checker, read p: ast.Parser,
                s: ast.Stmt, ret: u32) -> Checker {
    c = place_tv(c, p, s.a);
    let tt = c.res;
    c = expr_tv_w(c, p, s.b, tt, 1);
    let vt = c.res;
    c = coerce(c, p, tt, s.b, vt);
    c = check_store(c, p, s.a, s.b, vt,
                    u8(c.res2), c.res3);
    c = require_place_bases(c, p, s.a);
    c = push_place_lit(c, p, s.b);
    c = consume_owned_src(c, p, s.b, s.line, s.col);
    c = resolve_place(c, p, s.a);
    let n = c.res4;
    if n == 0 {
        c = place_id(c, p, s.a);
        if c.res != NONE() {
            c.pstash = c.pstash.push(c.res);
            c.res4 = 1;
        }
    }
    let n2 = c.res4;
    // overwrite-of-live-own audit
    let i: u64 = 0;
    while i < u64(n2) {
        let k = c.pstash.buf[i];
        c = live_own_at(c, k, tt);
        let held = c.res;
        if held != NONE() {
            let t0 = tail_off(c, k, held);
            let ve = p.exps.buf[u64(s.b)];
            let m = vec.Vec<u8>::new(c.heap);
            let m2 = resolve.bputs(m, "cannot overwrite `");
            let m3 = tn_into(m2, c, p, s.a);
            let m4 = resolve.bputs(m3,
                "`: the value it holds still owns `");
            let m5 = push_ktail(m4, c, k, 0);
            if t0 != NONE() {
                m5 = push_ktail(m5, c, held, t0);
            }
            let m6 = resolve.bputs(m5,
                "` — move or `free` it first");
            c = pdiag(c, ve.line, ve.col, m6.as_slice());
            m6.destroy();
        }
        i = i + 1;
    }
    // install_store per resolved place — born span is the VALUE's
    let ve2 = p.exps.buf[u64(s.b)];
    i = 0;
    while i < u64(n2) {
        let k = c.pstash.buf[i];
        c = install_store(c, p, s.b, k, tt, vt, ve2.line, ve2.col);
        i = i + 1;
    }
    // handle-assign refreshes the target's provenance
    if vt != NONE() && c.r.rtys.buf[u64(vt)].kind == 18 {
        let te = p.exps.buf[u64(s.a)];
        if ek_num(te.kind) == 2 {
            c.r = resolve.intern_pname(c.r, p, te.a);
            let bi = bfind(c, c.r.res);
            if i64(bi) >= 0 {
                c.binds.buf[u64(bi)].prov_k = 2;
                c.binds.buf[u64(bi)].prov_v = cur_region(c);
            }
        }
    }
    // `x = recv(ch)` — the packet's travelled delta (non-cap only)
    let ve2 = p.exps.buf[u64(s.b)];
    if ek_num(ve2.kind) == 6 {
        let ns = p.names.buf[u64(ve2.a)];
        if u64(ns.len) == 4
            && p.nbyt.buf[u64(ns.off)] == u8(114)
            && p.nbyt.buf[u64(ns.off) + 1] == u8(101)
            && p.nbyt.buf[u64(ns.off) + 2] == u8(99)
            && p.nbyt.buf[u64(ns.off) + 3] == u8(118) {
            if c.has_recv == 1 {
                let pkt = c.pkt_stash.buf[u64(c.recv_pkt)];
                if pkt.auth != 0 || c.r.rtys.buf[u64(pkt.ty)].kind == 18 {
                    let m = vec.Vec<u8>::new(c.heap);
                    let m2 = resolve.bputs(m,
                        "a `recv` of a capability or handle packet must bind a fresh `let`");
                    c = pdiag(c, ve2.line, ve2.col, m2.as_slice());
                    m2.destroy();
                } else {
                    i = 0;
                    while i < u64(n2) {
                        let k = c.pstash.buf[i];
                        let j: u64 = u64(pkt.eoff);
                        while j < u64(pkt.eoff) + u64(pkt.elen) {
                            let pe = c.pk_edges.buf[j];
                            c = key_join_rel(c, k, pe.h);
                            c = edge_set0(c, c.res, pe.t, pe.kind,
                                          pe.cert, ve2.line, ve2.col, 1);
                            j = j + 1;
                        }
                        j = u64(pkt.coff);
                        while j < u64(pkt.coff) + u64(pkt.clen) {
                            let pc = c.pk_caps.buf[j];
                            c = key_join_rel(c, k, pc.h);
                            c = cap_set(c, c.res, pc.t, pc.cert);
                            j = j + 1;
                        }
                        i = i + 1;
                    }
                }
                c.has_recv = 0;
            }
        }
    }
    c = place_id(c, p, s.a);
    if c.res != NONE() {
        let k = c.res;
        let is_spawn: u8 = 0;
        if ek_num(ve2.kind) == 13 { is_spawn = 1; }
        c = bind_task(c, k, is_spawn);
    }
    return c;
}

/// `{key}{rel}` — join a rel-keyed packet fact onto a place root.
fn key_join_rel(own c: Checker, k: u32, rel: u32) -> Checker {
    let rsp = c.kns.buf[u64(rel)];
    let ksp = c.kns.buf[u64(k)];
    // rel=="" -> k; "["-leading -> k++rel; else k.rel
    let i: u64 = 0;
    while i < u64(ksp.len) {
        c.ksc = c.ksc.push(c.kbyt.buf[u64(ksp.off) + i]);
        i = i + 1;
    }
    if u64(rsp.len) > 0
        && c.kbyt.buf[u64(rsp.off)] != u8(91) {
        c.ksc = c.ksc.push(u8(46));
    }
    i = 0;
    while i < u64(rsp.len) {
        c.ksc = c.ksc.push(c.kbyt.buf[u64(rsp.off) + i]);
        i = i + 1;
    }
    let s0 = u64(c.ksc.len);
    c = kin(c, &c.ksc.buf[0..s0]);
    while u64(c.ksc.len) > 0 { c.ksc.pop(); }
    return c;
}

/// install_store — a store writes the value's authority into `k`.
fn install_store(own c: Checker, read p: ast.Parser, vid: u32,
                 k: u32, tt: u32, vty: u32,
                 el: u32, ec: u32) -> Checker {
    // reslot — enum literal's variant name | NONE (AssocFn carries
    // `E::V(..)`; StructLit's b is a u32s range, NOT a name)
    let reslot: u32 = NONE();
    let ve = p.exps.buf[u64(vid)];
    if ek_num(ve.kind) == 20 {
        c.r = resolve.intern_pname(c.r, p, ve.b);
        reslot = c.r.res;
    }
    // tvars — enum decl idx when tt is enum-typed
    let ed: u32 = NONE();
    if tt != NONE() {
        let tn = c.r.rtys.buf[u64(tt)];
        if tn.kind == 12 || tn.kind == 13 {
            if is_enum_ty(c, tt) == 1 {
                ed = edecl_of(c, tn.name);
            }
        }
    }
    // edges: value's refs rebind the holder, else kill the subtree
    c = refs_of(c, p, vid);
    if c.lrefs_has == 1 {
        c = record_edges(c, k, el, ec, 1);
    } else {
        c = kill_set(c, k, 1);
        c = edges_retain_holder(c, k);
    }
    c = caps_of(c, p, vid);
    if c.lcaps_has == 1 {
        c = record_caps(c, k);
    } else {
        c = capkill_set(c, k, 1);
        c = caps_retain_holder(c, k);
    }
    // literal interior facts
    if ek_num(ve.kind) == 10 || c.lit_edges.len > 0
        || c.lit_caps.len > 0 || c.lit_dead.len > 0
        || c.lit_lens.len > 0 || c.lit_tags.len > 0
        || c.last_lit.len > 0 {
        c = record_lit_fields(c, k, el, ec, 1);
    }
    c = record_tag(c, p, vid, 1, k, tt);
    // resurrection: a store revives k's subtree — a reslot keeps
    // OTHER variants' payload paths dead.
    let dead = vec.Vec<u32>::new(c.heap);
    let i: u64 = 0;
    while i < c.cons.len {
        let ck = c.cons.buf[i].k;
        if ck == k || kprefix(c, k, ck) == 1 {
            if reslot != NONE() && ed != NONE() && ck != k {
                // segment right after `k.`
                let ksp = c.kns.buf[u64(k)];
                let csp = c.kns.buf[u64(ck)];
                let seg0 = u64(csp.off) + u64(ksp.len) + 1;
                let seg1 = seg0;
                while seg1 < u64(csp.off) + u64(csp.len) {
                    let x = c.kbyt.buf[seg1];
                    if x == u8(46) || x == u8(91) { break; }
                    seg1 = seg1 + 1;
                }
                let edd = c.r.edecls.buf[u64(ed)];
                let keep = 0;
                let j: u64 = 0;
                while j < u64(edd.vs_len) {
                    let vd = c.r.vars.buf[u64(edd.vs_off) + j];
                    let vsp = c.r.rns.buf[u64(vd.name)];
                    if u64(vsp.len) == seg1 - seg0 {
                        let eq: u8 = 1;
                        let q: u64 = 0;
                        while q < u64(vsp.len) {
                            if c.r.rbyt.buf[u64(vsp.off) + q]
                                != c.kbyt.buf[seg0 + q] { eq = 0; }
                            q = q + 1;
                        }
                        if eq == 1 && vd.name != reslot { keep = 1; }
                    }
                    j = j + 1;
                }
                if keep == 1 { i = i + 1; continue; }
            }
            dead = dead.push(u32(i));
        }
        i = i + 1;
    }
    // sorted-descend removal, emitting `(uncons …)` — Stage-0 removes
    // in retain order; emit sorted for canon.
    let di = dead.len;
    while di > 0 {
        di = di - 1;
        let idx = u64(dead.buf[di]);
        let cf = c.cons.buf[idx];
        c = es(c, "(uncons ");
        c = eqs(c, cf.k);
        c = ec(c, u8(41));
        c = rec(c);
        c.cons.buf[idx] = c.cons.buf[c.cons.len - 1];
        c.cons.pop();
    }
    dead.destroy();
    // init
    c = init_set(c, k, 1);
    if k_is_arg(c, k) == 1 {
        if vhas(c.iw, k) == 0 { c.iw = c.iw.push(k); }
    }
    // slice bookkeeping
    if vty != NONE() && c.r.rtys.buf[u64(vty)].kind == 17 {
        c = slice_len_of(c, p, vid);
        if c.llen_has == 1 {
            c = slen_set(c, k, c.llen);
        } else {
            c = unslen(c, k);
        }
        if c.lrefs_foreign == 1 {
            c = foreign_set(c, k);
        } else {
            c = unforeign(c, k);
        }
    }
    // str bookkeeping
    if vty != NONE() && c.r.rtys.buf[u64(vty)].kind == 10 {
        c = slice_len_of(c, p, vid);
        if c.llen_has == 1 {
            c = slen_set(c, k, c.llen);
        } else {
            c = unslen(c, k);
        }
        let safe: u8 = 0;
        if ek_num(ve.kind) == 3 { safe = 1; }
        if ek_num(ve.kind) == 2 {
            c.r = resolve.intern_pname(c.r, p, ve.a);
            let bi = bfind(c, c.r.res);
            if i64(bi) >= 0 {
                let b = c.binds.buf[u64(bi)];
                c = key_of(c, c.r.res, b.epoch);
                if vhas(c.csafe, c.res) == 1 { safe = 1; }
            }
        }
        if safe == 1 { c = csafe_set(c, k); }
        else { c = uncsafe(c, k); }
        // root bind's prov freshens to the current region
        c = key_root(c, k);
        let rk = c.res;
        let nn = root_name(c, rk);
        if nn != NONE() {
            let bi = bfind(c, nn);
            if i64(bi) >= 0 {
                let b = c.binds.buf[u64(bi)];
                if b.prov_k == 0 {
                    c.binds.buf[u64(bi)].prov_k = 2;
                    c.binds.buf[u64(bi)].prov_v = cur_region(c);
                }
            }
        }
    }
    return c;
}

/// rv_eval — evaluate a hoisted expr as a VALUE, not as its bound
/// temp: the `$rv` fast-path in expr_tv_w would read the stale
/// binding. Dispatch straight to the kind's eval arm.
fn rv_eval(own c: Checker, read p: ast.Parser,
           eid: u32, want: u32) -> Checker {
    let e = xexp(c, p, eid);
    let k = ek_num(e.kind);
    if k == 6 { return check_call(c, p, eid, want, 1); }
    if k == 19 { return expr_mcall(c, p, eid, want, 1); }
    if k == 20 { return expr_assoc(c, p, eid, want, 1); }
    if k == 21 { return expr_try(c, p, eid); }
    if k == 17 { return expr_alloc(c, p, eid); }
    if k == 13 { return expr_spawn(c, p, eid); }
    if k == 14 { return expr_join(c, p, eid); }
    return expr_tv_w(c, p, eid, want, 1);
}

/// `$rvN = <call>` — the loop-back re-materialization the lowering
/// appends to a `while` body: the call re-evaluates and the result
/// overwrites the already-bound temp through the assign ritual.
/// The place resolves to the temp's own key — a bare `Var` has no
/// aliases, no cap authority, no defer reservation to audit.
fn rv_assign(own c: Checker, read p: ast.Parser,
             vn: u32, eid: u32) -> Checker {
    let bi = bfind(c, vn);
    if i64(bi) < 0 { return c; }
    let tt = c.binds.buf[u64(bi)].ty;
    let ve = xexp(c, p, eid);
    c = rv_eval(c, p, eid, tt);
    let vt = c.res;
    c = coerce(c, p, tt, eid, vt);
    c = key_of(c, vn, c.binds.buf[u64(bi)].epoch);
    let k = c.res;
    c = record_hold(c, k, 2);
    c = push_place_lit(c, p, eid);
    c = consume_owned_src(c, p, eid, ve.line, ve.col);
    c = live_own_at(c, k, tt);
    let held = c.res;
    if held != NONE() {
        let t0 = tail_off(c, k, held);
        let m = vec.Vec<u8>::new(c.heap);
        let m2 = resolve.bputs(m, "cannot overwrite `");
        let m3 = push_rname(m2, c, vn);
        let m4 = resolve.bputs(m3,
            "`: the value it holds still owns `");
        let m5 = push_ktail(m4, c, k, 0);
        if t0 != NONE() {
            m5 = push_ktail(m5, c, held, t0);
        }
        let m6 = resolve.bputs(m5,
            "` — move or `free` it first");
        c = pdiag(c, ve.line, ve.col, m6.as_slice());
        m6.destroy();
    }
    c = install_store(c, p, eid, k, tt, vt, ve.line, ve.col);
    return c;
}

/// rv_remat — the lowering's appended `while`-body tail: every cond
/// hoist in rv_map[lo..hi) re-materializes in source order.
fn rv_remat(own c: Checker, read p: ast.Parser,
            lo: u32, hi: u32, ret: u32) -> Checker {
    let i = u64(lo);
    while i < u64(hi) {
        let kk = c.rv_map.buf[i];
        c = rv_assign(c, p, kk.v, kk.k);
        i = i + 1;
    }
    return c;
}

fn check_return(own c: Checker, read p: ast.Parser,
                s: ast.Stmt, ret: u32) -> Checker {
    c = es(c, "(return @");
    c = eu(c, u64(s.line));
    c = ec(c, u8(58));
    c = eu(c, u64(s.col));
    c = ec(c, u8(41));
    c = rec(c);
    c.diverged = 1;
    c = rec_flags(c);
    if c.task_ret != NONE() {
        // Inside a spawn body this is the task's RESULT, not the
        // enclosing fn's — its effects are already suspended; only
        // the value/edges re-enter at `join`.
        if s.a != NONE() {
            let tw = c.task_ret;
            let twk = c.r.rtys.buf[u64(tw)].kind;
            let wnt: u32 = NONE();
            if twk <= 7 { wnt = tw; }
            if twk == 20 {
                let te2 = c.r.rtys.buf[u64(tw)].a;
                if c.r.rtys.buf[u64(te2)].kind <= 7 { wnt = tw; }
            }
            c = expr_tv_w(c, p, s.a, wnt, 1);
            let got = c.res;
            if got != NONE()
                && c.r.rtys.buf[u64(got)].kind == 22 {
                c = pdiag_s(c, s.line, s.col,
                    "a lock guard cannot leave its scope");
            }
            c = consume_owned_src(c, p, s.a, s.line, s.col);
            if twk == 9 { c.task_ret = got; }
            else {
                if got != NONE() {
                    let gk = c.r.rtys.buf[u64(got)].kind;
                    if gk != 9 && got != tw {
                        let m = vec.Vec<u8>::new(c.heap);
                        let m2 = resolve.bputs(m, "task returns ");
                        let t1 = push_ty(m2, c, got);
                        c = t1.c;
                        let m4 = resolve.bputs(t1.m,
                            ", but an earlier return yielded ");
                        let t2 = push_ty(m4, c, tw);
                        c = t2.c;
                        c = pdiag(c, s.line, s.col, t2.m.as_slice());
                        t2.m.destroy();
                    }
                }
            }
            if got != NONE() {
                let gk2 = c.r.rtys.buf[u64(got)].kind;
                if gk2 == 15 || gk2 == 17 || gk2 == 10 {
                    // Ref/Slice/Str — a returned view must name
                    // storage that predates the spawn.
                    let mut_: u8 = 0;
                    if gk2 != 10 {
                        mut_ = u8(c.r.rtys.buf[u64(got)].b);
                    }
                    c = refs_of(c, p, s.a);
                    if c.lrefs_has == 1 {
                        let i: u64 = 0;
                        while i < c.lrefs_to.len {
                            let t2 = c.lrefs_to.buf[i];
                            c = key_root(c, t2);
                            let rk2 = c.res;
                            let ok: u8 = 0;
                            if k_is_arg(c, rk2) == 1 { ok = 1; }
                            if vhas(c.task_ext, rk2) == 1 { ok = 1; }
                            if ok == 1 {
                                c.ret_edges = c.ret_edges.push(KM {
                                    k: t2, m: mut_ });
                            } else {
                                let nm2 = root_name(c, rk2);
                                let m = vec.Vec<u8>::new(c.heap);
                                let m2 = m;
                                if gk2 == 10 {
                                    m2 = resolve.bputs(m2,
                                        "task returns a view of task-local `");
                                } else {
                                    m2 = resolve.bputs(m2,
                                        "task returns a reference to task-local `");
                                }
                                let m5 = m2;
                                if nm2 != NONE() {
                                    m5 = push_rname(m5, c, nm2);
                                }
                                let m6 = resolve.bputs(m5,
                                    "`, which dies with the body");
                                c = pdiag(c, s.line, s.col,
                                          m6.as_slice());
                                m6.destroy();
                            }
                            i = i + 1;
                        }
                    }
                }
                if gk2 == 18 {
                    c = caps_of(c, p, s.a);
                    if c.lcaps_has == 1 {
                        let i: u64 = 0;
                        while i < c.lcaps.len {
                            c.ret_caps = c.ret_caps.push(
                                c.lcaps.buf[i]);
                            i = i + 1;
                        }
                    }
                }
            }
        } else {
            if c.r.rtys.buf[u64(c.task_ret)].kind != 9 {
                c = pdiag_s(c, s.line, s.col,
                    "bare `return` in a task that returns a value");
            }
        }
        c = replay_all_defers(c, p);
        return c;
    }
    let rk = c.r.rtys.buf[u64(ret)].kind;
    if s.a != NONE() && rk == 9 {
        // value returned out of a void fn
        let m = vec.Vec<u8>::new(c.heap);
        let m2 = resolve.bputs(m,
            "returning a value from a void function");
        c = pdiag(c, s.line, s.col, m2.as_slice());
        m2.destroy();
    }
    if s.a != NONE() && rk != 9 {
        let ve = p.exps.buf[u64(s.a)];
        c = expr_tv_w(c, p, s.a, ret, 1);
        let got = c.res;
        let gpk = u8(c.res2); let gpv = c.res3;
        if got != NONE() && c.r.rtys.buf[u64(got)].kind == 22 {
            let m = vec.Vec<u8>::new(c.heap);
            let m2 = resolve.bputs(m,
                "a lock guard cannot leave its scope");
            c = pdiag(c, s.line, s.col, m2.as_slice());
            m2.destroy();
        }
        c = coerce(c, p, ret, s.a, got);
        // ret_edges — Ref want: outlives + targets; Slice/Str: targets
        if rk == 15 {
            if outlives(c, gpk, gpv, 1, 0) == 0 {
                let m = vec.Vec<u8>::new(c.heap);
                let m2 = resolve.bputs(m,
                    "reference escapes region: returned value lives in ");
                let m3 = m2;
                if gpk == 0 {
                    m3 = resolve.bputs(m3, "uninitialized");
                }
                if gpk == 1 {
                    m3 = resolve.bputs(m3, "the caller's frame");
                }
                if gpk == 2 {
                    let rf = c.regs.buf[u64(gpv)];
                    m3 = resolve.bputs(m3, "region `");
                    m3 = push_rname(m3, c, rf.name);
                    m3 = m3.push(u8(96));
                }
                c = pdiag(c, s.line, s.col, m3.as_slice());
                m3.destroy();
            }
            c = refs_of(c, p, s.a);
            if c.lrefs_has == 1 {
                let i: u64 = 0;
                while i < c.lrefs_to.len {
                    c.ret_edges = c.ret_edges.push(KM {
                        k: c.lrefs_to.buf[i], m: c.lrefs_mut });
                    i = i + 1;
                }
            }
        }
        if rk == 17 || rk == 10 {
            let mut_: u8 = 0;
            if rk == 17 && c.r.rtys.buf[u64(ret)].b != 0 { mut_ = 1; }
            c = refs_of(c, p, s.a);
            if c.lrefs_has == 1 {
                let i: u64 = 0;
                while i < c.lrefs_to.len {
                    c.ret_edges = c.ret_edges.push(KM {
                        k: c.lrefs_to.buf[i], m: mut_ });
                    i = i + 1;
                }
            }
        }
        // struct/enum wants — aggregate lit exports (push_place_lit)
        if rk == 12 || rk == 13 {
            c = push_place_lit(c, p, s.a);
            let i: u64 = 0;
            while i < c.lit_edges.len {
                c.ret_lit_edges = c.ret_lit_edges.push(
                    c.lit_edges.buf[i]);
                i = i + 1;
            }
            while c.lit_edges.len > 0 { c.lit_edges.pop(); }
            i = 0;
            while i < c.lit_caps.len {
                let lc = c.lit_caps.buf[i];
                c.ret_lit_caps = c.ret_lit_caps.push(lc);
                i = i + 1;
            }
            while c.lit_caps.len > 0 { c.lit_caps.pop(); }
            i = 0;
            while i < c.last_lit.len {
                c.ret_lit_provs = c.ret_lit_provs.push(
                    c.last_lit.buf[i]);
                i = i + 1;
            }
            while c.last_lit.len > 0 { c.last_lit.pop(); }
        }
        if rk == 18 {
            c = caps_of(c, p, s.a);
            if c.lcaps_has == 1 {
                let i: u64 = 0;
                while i < c.lcaps.len {
                    c.ret_caps = c.ret_caps.push(c.lcaps.buf[i]);
                    i = i + 1;
                }
            }
        }
        c = consume_owned_src(c, p, s.a, s.line, s.col);
    }
    if s.a == NONE() && rk != 9 {
        // bare `return` in a value-returning fn
        let m = vec.Vec<u8>::new(c.heap);
        let m2 = resolve.bputs(m,
            "bare `return` in a function returning ");
        let t1 = push_ty(m2, c, ret);
        c = t1.c;
        c = pdiag(c, s.line, s.col, t1.m.as_slice());
        t1.m.destroy();
    }
    if c.terminated == 0 {
        c = replay_all_defers(c, p);
        let all = vec.Vec<KK>::new(c.heap);
        let i: u64 = 0;
        while i < c.bnames.len {
            all = all.push(c.bnames.buf[i]);
            i = i + 1;
        }
        c = flag_abandoned(c, all, s.line, s.col, 1,
                           "this `return` exits");
    }
    return c;
}

fn replay_all_defers(own c: Checker, read p: ast.Parser) -> Checker {
    let lv = c.defers.len;
    while lv > 0 {
        lv = lv - 1;
        let i = c.defers.buf[lv].len;
        while i > 0 {
            i = i - 1;
            let dr = c.defers.buf[lv].buf[i];
            let e = p.exps.buf[u64(dr.eid)];
            c = es(c, "(defer-run @");
            c = eu(c, u64(e.line));
            c = ec(c, u8(58));
            c = eu(c, u64(e.col));
            c = ec(c, u8(41));
            c = rec(c);
            let j: u64 = 0;
            while j < u64(dr.olen) {
                c = undres(c, c.df_keys.buf[u64(dr.ooff) + j]);
                j = j + 1;
            }
            j = 0;
            while j < u64(dr.clen) {
                c = undres(c, c.df_keys.buf[u64(dr.coff) + j]);
                j = j + 1;
            }
            c = expr_tv(c, p, dr.eid);
        }
    }
    return c;
}

// ---- control-flow joins ---------------------------------------------------
// Snapshot = copy of all path-sensitive channels. Branch merges emit
// `(joined …)` snapshots; the merge discipline is per-channel.

/// snapshot the full path state.
fn snap_take(own c: Checker) -> Checker {
    c.snap_edges.destroy(); c.snap_edges = clone_e2(c.heap, c.edges);
    c.snap_caps.destroy(); c.snap_caps = clone_c3(c.heap, c.caps);
    c.snap_cons.destroy(); c.snap_cons = clone_cf(c.heap, c.cons);
    c.snap_init.destroy(); c.snap_init = clone_me2(c.heap, c.init);
    c.snap_ekills.destroy(); c.snap_ekills = clone_me2(c.heap, c.ekills);
    c.snap_ckills.destroy(); c.snap_ckills = clone_me2(c.heap, c.ckills);
    c.snap_provs.destroy(); c.snap_provs = clone_pv(c.heap, c.provs);
    c.snap_transit.destroy();
    c.snap_transit = clone_u(c.heap, c.transit);
    c.snap_tag.destroy(); c.snap_tag = clone_tg(c.heap, c.tag);
    c.snap_chans.destroy(); c.snap_chans = clone_cq(c.heap, c.chans);
    c.snap_defers.destroy();
    c.snap_defers = clone_df(c.heap, c.defers);
    c.snap_dres.destroy(); c.snap_dres = clone_dr(c.heap, c.dres);
    c.snap_diverged = c.diverged;
    c.snap_terminated = c.terminated;
    return c;
}

