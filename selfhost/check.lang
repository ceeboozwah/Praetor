//! selfhost/check — N72. The Stage-1 half of the authority-engine
//! differential: `ourc --dump-check` (Stage 0) and `selfhost/dumpcheck`
//! must emit byte-identical event streams. The surface is a scan-order
//! log of every semantic commit — binds, params, edges, caps, cons,
//! init, tags, provs, holds, doms, sends/recvs, spawns/joins, defers,
//! calls, joins, flags, summaries, diagnostics — bracketed per module.
//!
//! The driver mirrors dumpsyms: parse root, run the loader (keeping
//! per-module parsers), `resolve::register` for the global decl
//! tables, then check each program in postorder + root against its
//! direct deps' interfaces. Stage-0's mono/lower are virtualized:
//! MethodCall/AssocFn desugar inline at walk time, `$rvN` temps mint
//! inline, clone bodies check under a tparam subst map.

import std.vec;
import lexer;
import parser;
import ast;
import loader;
import resolve;

pub fn NONE() -> u32 { return 0xFFFFFFFF; }

// ---- Prov codes: 0 Unknown, 1 Param, 2+2*idx Region ----------------
// (2 + region index keeps Prov in one u32; RegionFrame idx = prov-2.)

// ---- the checker world ----------------------------------------------

/// One scope binding — the place it names is `n#{epoch}`; `auth != 0`
/// marks a capability param (place alias through its `$argN` edge).
/// guard_* carry a live `lock` token: dom/root keys + locker keys.
pub struct CBind {
    n: u32, epoch: u32, ty: u32,
    prov_k: u8, prov_v: u32,
    owner: u32, auth: u8,
    line: u32, col: u32,
    guard_dom: u32, guard_root: u32,
    goff: u32, glen: u32,          // locker keys into glocks
}

/// Region frame — name nid + parent idx | NONE.
pub struct RegF { name: u32, parent: u32 }

/// Alias edge: (holder, target) keys, kind/cert, born span.
pub struct E2 { h: u32, t: u32, kind: u8, cert: u8, bl: u32, bc: u32 }

/// Identity edge.
pub struct C3 { h: u32, t: u32, cert: u8 }

/// Affine fact — `at` = consume sites into `atspans` (pairs).
pub struct CF { k: u32, st: u8, aoff: u32, alen: u32 }

/// Path prov.
pub struct PV { k: u32, pk: u8, pv: u32 }

/// One channel packet — payload ty + travelled facts, rel-keyed.
pub struct Packet {
    ty: u32,
    eoff: u32, elen: u32,          // Vec<E2> range in pk_edges
    coff: u32, clen: u32,          // Vec<C3> range in pk_caps
    soff: u32, slen: u32,          // sent keys in pk_sent
    auth: u8,
    hnd: u8,                       // handle packet — identity only
}

/// Suspended task diff — lands at join.
pub struct TaskEff {
    eoff: u32, elen: u32,          // creates (E2) in te_edges
    koff: u32, klen: u32,          // kills (MapE-cert) in te_kills
    coff: u32, clen: u32,          // creates_caps (C3) in te_ccaps
    ckoff: u32, cklen: u32,        // cap_kills in te_ckills
    doff: u32, dlen: u32,          // consumed (CF) in te_cons
    poff: u32, plen: u32,          // path_provs (PV) in te_provs
    reoff: u32, relen: u32,        // ret_edges (key,mut) in te_re
    rcoff: u32, rclen: u32,        // ret_caps in te_rc
    ret: u32,
}

pub struct Task {
    key: u32, line: u32, col: u32,
    hoff: u32, hlen: u32,          // holds (key,auth) in tk_holds
    eff: u32,                      // TaskEff idx
}

pub struct DeferRec {
    eid: u32,                       // the deferred call's expr id
    ooff: u32, olen: u32,           // operand keys in df_keys
    coff: u32, clen: u32,           // consume keys in df_keys
}

/// Fn summary — the cross-module contract in `$argN` vocabulary.
pub struct FSum {
    eoff: u32, elen: u32,           // creates (E2) in sm_edges
    koff: u32, klen: u32,           // kills in sm_kills
    coff: u32, clen: u32,           // creates_caps in sm_ccaps
    ckoff: u32, cklen: u32,         // cap_kills in sm_ckills
    ioff: u32, ilen: u32,           // init_paths in sm_keys
    reoff: u32, relen: u32,         // ret_edges in sm_re
    rcoff: u32, rclen: u32,         // ret_caps in sm_rc
    leoff: u32, lelen: u32,         // ret_lit_edges in sm_rle
    lcoff: u32, lclen: u32,         // ret_lit_caps in sm_rlc
    lpoff: u32, lplen: u32,         // ret_lit_provs in sm_rlp
    syoff: u32, sylen: u32,         // syncs in sm_keys
    diverges: u8,
}

/// Loop snapshot — take_snap/restore_snap state.
pub struct LSnap {
    edges: vec.Vec<E2>, caps: vec.Vec<C3>, cons: vec.Vec<CF>,
    init: vec.Vec<MapE2>, ekills: vec.Vec<MapE2>,
    ckills: vec.Vec<MapE2>, provs: vec.Vec<PV>,
    transit: vec.Vec<u32>, tag: vec.Vec<TG>,
    chans: vec.Vec<CQ>, defers: vec.Vec<vec.Vec<DeferRec>>,
    dres: vec.Vec<DR>,
}
pub struct MapE2 { k: u32, cert: u8 }
pub struct TG { k: u32, v: u32, has: u8 }   // v=variant nid|NONE, has=1 known-enum
pub struct CQ { k: u32, pkts: vec.Vec<Packet> }
pub struct DR { k: u32, line: u32, col: u32 }

/// BS — an if-arm state. Stage-0's saved set: edges/caps/cons/init/
/// kills/provs/scopes/defers/dres + transit/chans (saved but restored
/// only by lit/survivor paths). tag/holds/doms persist across arms.
pub struct BS {
    edges: vec.Vec<E2>, caps: vec.Vec<C3>, cons: vec.Vec<CF>,
    init: vec.Vec<MapE2>, ekills: vec.Vec<MapE2>,
    ckills: vec.Vec<MapE2>, provs: vec.Vec<PV>,
    transit: vec.Vec<u32>, chans: vec.Vec<CQ>,
    defers: vec.Vec<vec.Vec<DeferRec>>, dres: vec.Vec<DR>,
    binds: vec.Vec<CBind>, bnames: vec.Vec<KK>,
    scopes: vec.Vec<u32>,
    diverged: u8, terminated: u8,
}
pub struct BSC { c: Checker, bs: BS }

/// write-param reborrow — parked edge/cap facts by source key.
pub struct Reb { src: u32, eoff: u32, elen: u32, coff: u32, clen: u32 }

pub struct LoopCtx {
    depth: u32,
    breaks: vec.Vec<LSnap>, conts: vec.Vec<LSnap>,
}

pub struct Checker {
    heap: alloc,
    r: resolve.Resolver,            // decl tables + name interning
    // place-key interning — `x#3`, `$arg0.f`, `a#0[]` as nids
    kbyt: vec.Vec<u8>, kns: vec.Vec<loader.Span2>,
    ksc: vec.Vec<u8>,               // key scratch
    // event stream
    ev: vec.Vec<u8>,
    ebyt: vec.Vec<u8>,              // diag message arena
    // diag queue — (line, col, msg span, labels range, notes range)
    errs: vec.Vec<CDiag>,
    dlab: vec.Vec<CLab>,
    dnote: vec.Vec<loader.Span2>,
    // module-level context
    who: u32,                        // prog idx
    fbase: u32,                      // fdecls base of the module in flight
    // call-arg machinery — per-arg caller key sets (bases),
    // $tmpN holders, write-reborrow parking
    cboff: vec.Vec<u32>, cblen: vec.Vec<u32>, cbases: vec.Vec<u32>,
    tk_out: vec.Vec<u32>, tk_out2: vec.Vec<u32>,
    ahold: vec.Vec<u32>,
    rebs: vec.Vec<Reb>,
    reb_edges: vec.Vec<E2>, reb_caps: vec.Vec<C3>,
    sums: vec.Vec<MapE3>,            // fname nid -> FSum idx (fsums)
    fsums: vec.Vec<FSum>,
    sm_edges: vec.Vec<E2>, sm_kills: vec.Vec<MapE2>,
    sm_ccaps: vec.Vec<C3>, sm_ckills: vec.Vec<MapE2>,
    sm_keys: vec.Vec<u32>,
    sm_re: vec.Vec<KM>, sm_rc: vec.Vec<u32>,
    sm_rle: vec.Vec<RLE>, sm_rlc: vec.Vec<RLE2>, sm_rlp: vec.Vec<PV>,
    // fn-local ctx
    scopes: vec.Vec<u32>,            // per-scope start idx into binds
    binds: vec.Vec<CBind>,
    bnames: vec.Vec<KK>,             // flat stack: name nid -> binds idx
    regs: vec.Vec<RegF>,
    edges: vec.Vec<E2>,
    caps: vec.Vec<C3>,
    cons: vec.Vec<CF>,
    atspans: vec.Vec<u32>,           // (line,col) pairs
    init: vec.Vec<MapE2>,
    tag: vec.Vec<TG>,
    provs: vec.Vec<PV>,
    ekills: vec.Vec<MapE2>,
    ckills: vec.Vec<MapE2>,
    holds: vec.Vec<KM>,
    transit: vec.Vec<u32>,
    doms: vec.Vec<KK>,
    slens: vec.Vec<KI>,
    csafe: vec.Vec<u32>,
    foreign: vec.Vec<u32>,
    abandoned: vec.Vec<u32>,
    iw: vec.Vec<u32>,                // init_writes
    arg_atomic: vec.Vec<KK>,         // (argkey, ty)
    arg_mutex: vec.Vec<KK>,
    arg_chan: vec.Vec<KK>,
    // lit side channels
    last_lit: vec.Vec<PV>,           // has_lit flag in res regs
    lit_edges: vec.Vec<RLE>,
    lit_caps: vec.Vec<RLE2>,
    lit_dead: vec.Vec<LCF>,
    lit_dead_cfs: vec.Vec<CF>,      // ConsFacts indexed by LCF.cf
    lit_lens: vec.Vec<KI>,
    lit_tags: vec.Vec<TG>,
    lit_csafe: vec.Vec<u32>,
    // refs_of/caps_of/slice_len_of last-value channels
    lrefs_has: u8, lrefs_mut: u8, lrefs_mf: u32, lrefs_foreign: u8,
    lrefs_to: vec.Vec<u32>,
    lcaps_has: u8, lcaps: vec.Vec<u32>,
    llen_has: u8, llen: i64,
    pstash: vec.Vec<u32>,            // resolve_place result keys
    // $rv lowering — eid->temp-name nid map, source-order eid->seq,
    // temp-name nids minted for the stmt currently checking
    rv_map: vec.Vec<KK>, rv_names: vec.Vec<KK>, rv_new: vec.Vec<u32>,
    // ret channels
    ret_edges: vec.Vec<KM>,
    ret_caps: vec.Vec<u32>,
    ret_lit_edges: vec.Vec<RLE>,
    ret_lit_caps: vec.Vec<RLE2>,
    ret_lit_provs: vec.Vec<PV>,
    rinfos: vec.Vec<RefInf>, ri_to: vec.Vec<u32>,
    rlc_keys: vec.Vec<u32>,
    // tasks/channels
    tasks: vec.Vec<Task>,
    te_edges: vec.Vec<E2>, te_kills: vec.Vec<MapE2>,
    te_ccaps: vec.Vec<C3>, te_ckills: vec.Vec<MapE2>,
    te_cons: vec.Vec<CF>, te_provs: vec.Vec<PV>,
    te_re: vec.Vec<KM>, te_rc: vec.Vec<u32>,
    chans: vec.Vec<CQ>,
    pk_edges: vec.Vec<E2>, pk_caps: vec.Vec<C3>, pk_sent: vec.Vec<u32>,
    // defers
    defers: vec.Vec<vec.Vec<DeferRec>>,
    df_keys: vec.Vec<u32>,
    dres: vec.Vec<DR>,
    // loops
    loops: vec.Vec<LoopCtx>,
    // last_* side channels
    has_lit: u8, has_tag: u8, tag_v: u32, tag_has: u8,
    has_lock: u8, lock_dom: u32, lock_root: u32, lock_ty: u32,
    lock_off: u32, lock_len: u32,    // locker keys in glocks
    has_mutex: u8, mx_off: u32, mx_len: u32,
    has_recv: u8, recv_pkt: u32,     // packet idx in stash
    cg: vec.Vec<u32>,                // chan_gate scratch — (ep,inner) pairs
    has_spawn: u8, spawn_eff: u32,   // TaskEff idx
    last_spawn_tk: u32,              // task key nid
    sp_line: u32, sp_col: u32,       // last_spawn span
    sp_hoff: u32, sp_hlen: u32,      // last_spawn holds range in tk_holds
    teffs: vec.Vec<TaskEff>,
    glocks: vec.Vec<u32>,
    pkt_stash: vec.Vec<Packet>,
    tk_holds: vec.Vec<KM>,
    task_ret: u32,                   // task fn ret ty (NONE when not in task)
    task_ext: vec.Vec<u32>,          // external keys bound at spawn
    fn_ret: u32,
    next_epoch: u32,
    diverged: u8, terminated: u8,
    // clone context — tparam subst map active while checking a clone
    cmap: vec.Vec<resolve.MapE>,
    // lowering — `$rvN` counter (per-program) + while-cond refresh
    rvnext: u32, cond_depth: u32,
    refresh: vec.Vec<Refresh>,
    // match yields — span -> arm yield info for expr match
    myields: vec.Vec<MY>, mylens: vec.Vec<i64>,
    // path snapshots (branch/loop merges) + message scratch
    snap_edges: vec.Vec<E2>, snap_caps: vec.Vec<C3>,
    snap_cons: vec.Vec<CF>, snap_init: vec.Vec<MapE2>,
    snap_ekills: vec.Vec<MapE2>, snap_ckills: vec.Vec<MapE2>,
    snap_provs: vec.Vec<PV>, snap_transit: vec.Vec<u32>,
    snap_tag: vec.Vec<TG>, snap_chans: vec.Vec<CQ>,
    snap_defers: vec.Vec<vec.Vec<DeferRec>>,
    snap_dres: vec.Vec<DR>,
    snap_diverged: u8, snap_terminated: u8,
    scrv: vec.Vec<u8>,
    // call-graph scratch (module order DFS)
    cbuf: vec.Vec<u32>,
    // result registers
    hstash: vec.Vec<u32>,
    res: u32, res2: u32, res3: u32, res4: u32, res5: u32,
}

pub fn destroy(own c: Checker) {
    c.kbyt.destroy(); c.kns.destroy(); c.ksc.destroy();
    c.ev.destroy(); c.ebyt.destroy();
    c.errs.destroy(); c.dlab.destroy(); c.dnote.destroy();
    c.cboff.destroy(); c.cblen.destroy(); c.cbases.destroy();
    c.tk_out.destroy(); c.tk_out2.destroy();
    c.ahold.destroy(); c.rebs.destroy();
    c.reb_edges.destroy(); c.reb_caps.destroy();
    c.sums.destroy(); c.fsums.destroy();
    c.sm_edges.destroy(); c.sm_kills.destroy();
    c.sm_ccaps.destroy(); c.sm_ckills.destroy();
    c.sm_keys.destroy(); c.sm_re.destroy(); c.sm_rc.destroy();
    c.sm_rle.destroy(); c.sm_rlc.destroy(); c.sm_rlp.destroy();
    c.scopes.destroy(); c.binds.destroy(); c.bnames.destroy();
    c.regs.destroy(); c.edges.destroy(); c.caps.destroy();
    c.cons.destroy(); c.atspans.destroy(); c.init.destroy();
    c.tag.destroy(); c.provs.destroy();
    c.ekills.destroy(); c.ckills.destroy();
    c.holds.destroy(); c.transit.destroy(); c.doms.destroy();
    c.slens.destroy(); c.csafe.destroy(); c.foreign.destroy();
    c.abandoned.destroy(); c.iw.destroy();
    c.arg_atomic.destroy(); c.arg_mutex.destroy();
    c.arg_chan.destroy();
    c.last_lit.destroy(); c.lit_edges.destroy();
    c.lit_caps.destroy(); c.lit_dead.destroy();
    c.lit_dead_cfs.destroy();
    c.lit_lens.destroy(); c.lit_tags.destroy();
    c.lit_csafe.destroy();
    c.lrefs_to.destroy(); c.lcaps.destroy(); c.pstash.destroy();
    c.rv_map.destroy(); c.rv_names.destroy(); c.rv_new.destroy();
    c.ret_edges.destroy(); c.ret_caps.destroy();
    c.ret_lit_edges.destroy(); c.ret_lit_caps.destroy();
    c.ret_lit_provs.destroy();
    c.rinfos.destroy(); c.ri_to.destroy(); c.rlc_keys.destroy();
    c.tasks.destroy(); c.teffs.destroy();
    c.te_edges.destroy(); c.te_kills.destroy();
    c.te_ccaps.destroy(); c.te_ckills.destroy();
    c.te_cons.destroy(); c.te_provs.destroy();
    c.te_re.destroy(); c.te_rc.destroy();
    let i: u64 = 0;
    while i < c.chans.len {
        c.chans.buf[i].pkts.destroy();
        i = i + 1;
    }
    c.chans.destroy();
    c.pk_edges.destroy(); c.pk_caps.destroy(); c.pk_sent.destroy();
    i = 0;
    while i < c.defers.len {
        c.defers.buf[i].destroy();
        i = i + 1;
    }
    c.defers.destroy();
    c.df_keys.destroy(); c.dres.destroy();
    i = 0;
    while i < c.loops.len {
        let j: u64 = 0;
        while j < c.loops.buf[i].breaks.len {
            lsnap_destroy(c.loops.buf[i].breaks.buf[j]);
            j = j + 1;
        }
        c.loops.buf[i].breaks.destroy();
        j = 0;
        while j < c.loops.buf[i].conts.len {
            lsnap_destroy(c.loops.buf[i].conts.buf[j]);
            j = j + 1;
        }
        c.loops.buf[i].conts.destroy();
        i = i + 1;
    }
    c.loops.destroy();
    c.glocks.destroy(); c.pkt_stash.destroy(); c.cg.destroy();
    c.task_ext.destroy(); c.cmap.destroy(); c.refresh.destroy();
    c.myields.destroy(); c.mylens.destroy();
    c.snap_edges.destroy(); c.snap_caps.destroy();
    c.snap_cons.destroy(); c.snap_init.destroy();
    c.snap_ekills.destroy(); c.snap_ckills.destroy();
    c.snap_provs.destroy(); c.snap_transit.destroy();
    c.snap_tag.destroy(); c.snap_chans.destroy();
    i = 0;
    while i < c.snap_defers.len {
        c.snap_defers.buf[i].destroy();
        i = i + 1;
    }
    c.snap_defers.destroy();
    c.snap_dres.destroy();
    c.scrv.destroy(); c.cbuf.destroy();
    resolve.destroy(c.r);
}

fn lsnap_destroy(own s: LSnap) {
    s.edges.destroy(); s.caps.destroy(); s.cons.destroy();
    s.init.destroy(); s.ekills.destroy(); s.ckills.destroy();
    s.provs.destroy(); s.transit.destroy(); s.tag.destroy();
}

pub struct MapE3 { k: u32, v: u32 }   // generic nid->idx
pub struct KK { k: u32, v: u32 }      // generic nid->nid (doms)
pub struct KM { k: u32, m: u8 }       // (key, mut flag|auth code)
pub struct KI { k: u32, n: i64 }
pub struct RLE { rel: u32, ri: u32 }  // (rel key, RefInfo idx in rinfos)
pub struct RLE2 { rel: u32, off: u32, len: u32 }  // (rel, cap keys in rlc_keys)
pub struct RefInf { toff: u32, tlen: u32, mut_: u8, mf: u32, foreign: u8 }
pub struct LCF { rel: u32, cf: u32 }  // (rel, CF idx in lit_dead_cfs)
pub struct Refresh { name: u32, eid: u32, line: u32, col: u32 }
pub struct MY { line: u32, col: u32, y: u32 }  // span -> yield info idx
pub struct CDiag { line: u32, col: u32, m0: u32, m1: u32,
                   l0: u32, l1: u32, n0: u32, n1: u32 }
pub struct CLab { line: u32, col: u32, m0: u32, m1: u32 }

