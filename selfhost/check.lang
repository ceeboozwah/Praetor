/// restore a snapshot (moves the clone fields back into channels).
fn snap_put(own c: Checker) -> Checker {
    c.edges.destroy(); c.edges = clone_e2(c.heap, c.snap_edges);
    c.caps.destroy(); c.caps = clone_c3(c.heap, c.snap_caps);
    c.cons.destroy(); c.cons = clone_cf(c.heap, c.snap_cons);
    c.init.destroy(); c.init = clone_me2(c.heap, c.snap_init);
    c.ekills.destroy();
    c.ekills = clone_me2(c.heap, c.snap_ekills);
    c.ckills.destroy();
    c.ckills = clone_me2(c.heap, c.snap_ckills);
    c.provs.destroy(); c.provs = clone_pv(c.heap, c.snap_provs);
    c.transit.destroy();
    c.transit = clone_u(c.heap, c.snap_transit);
    c.tag.destroy(); c.tag = clone_tg(c.heap, c.snap_tag);
    c.chans.destroy(); c.chans = clone_cq(c.heap, c.snap_chans);
    c.defers.destroy();
    c.defers = clone_df(c.heap, c.snap_defers);
    c.dres.destroy(); c.dres = clone_dr(c.heap, c.snap_dres);
    c.diverged = c.snap_diverged;
    c.terminated = c.snap_terminated;
    return c;
}

/// merge branch states — pathwise join then `(joined)` snapshot.
/// v1: Def survives iff both paths carry it; else Maybe.
fn join_states(own c: Checker) -> Checker {
    // edges: (h,t) live in both → Def when both Def; else Maybe
    let w = vec.Vec<E2>::new(c.heap);
    let i: u64 = 0;
    while i < c.edges.len {
        let e = c.edges.buf[i];
        let cert = edge_cert_in(c, c.snap_edges, e.h, e.t);
        if cert != 0 {
            w = w.push(E2 { h: e.h, t: e.t, kind: e.kind,
                cert: jcert(e.cert, cert), bl: e.bl, bc: e.bc });
        }
        i = i + 1;
    }
    // edges only in the OTHER path → Maybe here too
    i = 0;
    while i < c.snap_edges.len {
        let e = c.snap_edges.buf[i];
        if edge_cert_in(c, c.edges, e.h, e.t) == 0 {
            w = w.push(E2 { h: e.h, t: e.t, kind: e.kind,
                cert: 2, bl: e.bl, bc: e.bc });
        }
        i = i + 1;
    }
    c.edges.destroy();
    c.edges = w;
    // caps
    let wc = vec.Vec<C3>::new(c.heap);
    i = 0;
    while i < c.caps.len {
        let e = c.caps.buf[i];
        let cert = cap_cert_in(c, c.snap_caps, e.h, e.t);
        if cert != 0 {
            wc = wc.push(C3 { h: e.h, t: e.t,
                cert: jcert(e.cert, cert) });
        }
        i = i + 1;
    }
    i = 0;
    while i < c.snap_caps.len {
        let e = c.snap_caps.buf[i];
        if cap_cert_in(c, c.caps, e.h, e.t) == 0 {
            wc = wc.push(C3 { h: e.h, t: e.t, cert: 2 });
        }
        i = i + 1;
    }
    c.caps.destroy();
    c.caps = wc;
    // cons: fact survives; Def iff both Def, Maybe else
    let wf = vec.Vec<CF>::new(c.heap);
    i = 0;
    while i < c.cons.len {
        let f = c.cons.buf[i];
        let ost = cons_in(c, c.snap_cons, f.k);
        let st: u8 = 2;
        if f.st == 1 && ost == 1 { st = 1; }
        wf = wf.push(CF { k: f.k, st: st, aoff: f.aoff, alen: f.alen });
        i = i + 1;
    }
    i = 0;
    while i < c.snap_cons.len {
        let f = c.snap_cons.buf[i];
        if cons_in(c, c.cons, f.k) == 0 {
            wf = wf.push(CF { k: f.k, st: 2,
                aoff: f.aoff, alen: f.alen });
        }
        i = i + 1;
    }
    c.cons.destroy();
    c.cons = wf;
    // init
    let wi = vec.Vec<MapE2>::new(c.heap);
    i = 0;
    while i < c.init.len {
        let f = c.init.buf[i];
        let oc = init_in(c, c.snap_init, f.k);
        let ce: u8 = 2;
        if f.cert == 1 && oc == 1 { ce = 1; }
        wi = wi.push(MapE2 { k: f.k, cert: ce });
        i = i + 1;
    }
    i = 0;
    while i < c.snap_init.len {
        let f = c.snap_init.buf[i];
        if init_in(c, c.init, f.k) == 0 {
            wi = wi.push(MapE2 { k: f.k, cert: 2 });
        }
        i = i + 1;
    }
    c.init.destroy();
    c.init = wi;
    // provs/tags/transit/chans/defers — v1: keep current-path state
    // (expanded with the merge lattice).
    c.diverged = 0;
    if c.diverged == 1 && c.snap_diverged == 1 { c.diverged = 1; }
    c.terminated = 0;
    if c.terminated == 1 && c.snap_terminated == 1 { c.terminated = 1; }
    return c;
}

fn edge_cert_in(read c: Checker, read v: vec.Vec<E2>,
                h: u32, t: u32) -> u8 {
    let i: u64 = 0;
    while i < v.len {
        if v.buf[i].h == h && v.buf[i].t == t { return v.buf[i].cert; }
        i = i + 1;
    }
    return 0;
}
fn cap_cert_in(read c: Checker, read v: vec.Vec<C3>,
               h: u32, t: u32) -> u8 {
    let i: u64 = 0;
    while i < v.len {
        if v.buf[i].h == h && v.buf[i].t == t { return v.buf[i].cert; }
        i = i + 1;
    }
    return 0;
}
fn cons_in(read c: Checker, read v: vec.Vec<CF>, k: u32) -> u8 {
    let i: u64 = 0;
    while i < v.len {
        if v.buf[i].k == k { return v.buf[i].st; }
        i = i + 1;
    }
    return 0;
}
fn init_in(read c: Checker, read v: vec.Vec<MapE2>, k: u32) -> u8 {
    let i: u64 = 0;
    while i < v.len {
        if v.buf[i].k == k { return v.buf[i].cert; }
        i = i + 1;
    }
    return 0;
}

/// Stmt::If — cond, then-branch, optional else, join.
/// bs_take — clone the live state into a branch snapshot.
fn bs_take(own c: Checker) -> BSC {
    let b = BS {
        edges: clone_e2(c.heap, c.edges),
        caps: clone_c3(c.heap, c.caps),
        cons: clone_cf(c.heap, c.cons),
        init: clone_me2(c.heap, c.init),
        ekills: clone_me2(c.heap, c.ekills),
        ckills: clone_me2(c.heap, c.ckills),
        provs: clone_pv(c.heap, c.provs),
        transit: clone_u(c.heap, c.transit),
        chans: clone_cq(c.heap, c.chans),
        defers: clone_df(c.heap, c.defers),
        dres: clone_dr(c.heap, c.dres),
        binds: clone_cb(c.heap, c.binds),
        bnames: clone_kk(c.heap, c.bnames),
        scopes: clone_u(c.heap, c.scopes),
        diverged: c.diverged, terminated: c.terminated };
    return BSC { c: c, bs: b };
}

/// bs_dup — clone a snapshot (snapshot fields stay live).
fn bs_dup(own c: Checker, read b: BS) -> BSC {
    let d = BS {
        edges: clone_e2(c.heap, b.edges),
        caps: clone_c3(c.heap, b.caps),
        cons: clone_cf(c.heap, b.cons),
        init: clone_me2(c.heap, b.init),
        ekills: clone_me2(c.heap, b.ekills),
        ckills: clone_me2(c.heap, b.ckills),
        provs: clone_pv(c.heap, b.provs),
        transit: clone_u(c.heap, b.transit),
        chans: clone_cq(c.heap, b.chans),
        defers: clone_df(c.heap, b.defers),
        dres: clone_dr(c.heap, b.dres),
        binds: clone_cb(c.heap, b.binds),
        bnames: clone_kk(c.heap, b.bnames),
        scopes: clone_u(c.heap, b.scopes),
        diverged: b.diverged, terminated: b.terminated };
    return BSC { c: c, bs: d };
}

/// bs_free — destroy a snapshot's arenas.
fn bs_free(own b: BS) {
    b.edges.destroy(); b.caps.destroy(); b.cons.destroy();
    b.init.destroy(); b.ekills.destroy(); b.ckills.destroy();
    b.provs.destroy(); b.transit.destroy(); b.chans.destroy();
    let i: u64 = 0;
    while i < b.defers.len { b.defers.buf[i].destroy(); i = i + 1; }
    b.defers.destroy(); b.dres.destroy();
    b.binds.destroy(); b.bnames.destroy(); b.scopes.destroy();
}

/// bs_install — wholesale state replace (mid-arm restore, lit-true).
fn bs_install(own c: Checker, own b: BS) -> Checker {
    c.edges.destroy(); c.edges = b.edges;
    c.caps.destroy(); c.caps = b.caps;
    c.cons.destroy(); c.cons = b.cons;
    c.init.destroy(); c.init = b.init;
    c.ekills.destroy(); c.ekills = b.ekills;
    c.ckills.destroy(); c.ckills = b.ckills;
    c.provs.destroy(); c.provs = b.provs;
    c.transit.destroy(); c.transit = b.transit;
    c.chans.destroy(); c.chans = b.chans;
    c.defers.destroy(); c.defers = b.defers;
    c.dres.destroy(); c.dres = b.dres;
    c.binds.destroy(); c.binds = b.binds;
    c.bnames.destroy(); c.bnames = b.bnames;
    c.scopes.destroy(); c.scopes = b.scopes;
    c.diverged = b.diverged; c.terminated = b.terminated;
    return c;
}

/// bs_install_surv — the diverged-arm survivor set: everything EXCEPT
/// chans/tag/flags (chans keep the post-else accumulation).
fn bs_install_surv(own c: Checker, own b: BS) -> Checker {
    c.edges.destroy(); c.edges = b.edges;
    c.caps.destroy(); c.caps = b.caps;
    c.cons.destroy(); c.cons = b.cons;
    c.init.destroy(); c.init = b.init;
    c.ekills.destroy(); c.ekills = b.ekills;
    c.ckills.destroy(); c.ckills = b.ckills;
    c.provs.destroy(); c.provs = b.provs;
    c.transit.destroy(); c.transit = b.transit;
    b.chans.destroy();
    c.defers.destroy(); c.defers = b.defers;
    c.dres.destroy(); c.dres = b.dres;
    c.binds.destroy(); c.binds = b.binds;
    c.bnames.destroy(); c.bnames = b.bnames;
    c.scopes.destroy(); c.scopes = b.scopes;
    return c;
}

/// Spawn snapshot — the parent's full mutable fn ctx, moved out while
/// the task body runs on cloned (inherited) or reset (fresh) channels.
/// Restored wholesale at task-end; the suspended diff is captured into
/// locals between the body's end and the restore.
pub struct SSnap {
    scopes: vec.Vec<u32>, binds: vec.Vec<CBind>, bnames: vec.Vec<KK>,
    regs: vec.Vec<RegF>,
    edges: vec.Vec<E2>, caps: vec.Vec<C3>, cons: vec.Vec<CF>,
    init: vec.Vec<MapE2>, tag: vec.Vec<TG>, provs: vec.Vec<PV>,
    transit: vec.Vec<u32>, doms: vec.Vec<KK>,
    slens: vec.Vec<KI>, csafe: vec.Vec<u32>, foreign: vec.Vec<u32>,
    arg_atomic: vec.Vec<KK>, arg_mutex: vec.Vec<KK>, arg_chan: vec.Vec<KK>,
    chans: vec.Vec<CQ>, myields: vec.Vec<MY>, mylens: vec.Vec<i64>,
    ekills: vec.Vec<MapE2>, ckills: vec.Vec<MapE2>,
    holds: vec.Vec<KM>, tasks: vec.Vec<Task>, teffs: vec.Vec<TaskEff>,
    tk_holds: vec.Vec<KM>, task_ext: vec.Vec<u32>,
    te_edges: vec.Vec<E2>, te_kills: vec.Vec<MapE2>,
    te_ccaps: vec.Vec<C3>, te_ckills: vec.Vec<MapE2>,
    te_cons: vec.Vec<CF>, te_provs: vec.Vec<PV>,
    te_re: vec.Vec<KM>, te_rc: vec.Vec<u32>,
    ret_edges: vec.Vec<KM>, ret_caps: vec.Vec<u32>,
    ret_lit_edges: vec.Vec<RLE>, ret_lit_caps: vec.Vec<RLE2>,
    ret_lit_provs: vec.Vec<PV>,
    ri_to: vec.Vec<u32>, rlc_keys: vec.Vec<u32>,
    last_lit: vec.Vec<PV>,
    lit_edges: vec.Vec<RLE>, lit_caps: vec.Vec<RLE2>,
    lit_dead: vec.Vec<LCF>, lit_lens: vec.Vec<KI>,
    lit_tags: vec.Vec<TG>, lit_csafe: vec.Vec<u32>,
    lrefs_to: vec.Vec<u32>, lcaps: vec.Vec<u32>,
    pstash: vec.Vec<u32>, hstash: vec.Vec<u32>,
    rv_new: vec.Vec<u32>, abandoned: vec.Vec<u32>, iw: vec.Vec<u32>,
    pkt_stash: vec.Vec<Packet>, glocks: vec.Vec<u32>,
    defers: vec.Vec<vec.Vec<DeferRec>>, df_keys: vec.Vec<u32>,
    dres: vec.Vec<DR>, loops: vec.Vec<LoopCtx>,
    refresh: vec.Vec<Refresh>,
    cboff: vec.Vec<u32>, cblen: vec.Vec<u32>, cbases: vec.Vec<u32>,
    tk_out: vec.Vec<u32>, tk_out2: vec.Vec<u32>,
    ahold: vec.Vec<u32>, rebs: vec.Vec<Reb>,
    reb_edges: vec.Vec<E2>, reb_caps: vec.Vec<C3>,
    diverged: u8, terminated: u8,
    has_lit: u8, has_tag: u8, tag_v: u32, tag_has: u8,
    has_lock: u8, lock_dom: u32, lock_root: u32, lock_ty: u32,
    lock_off: u32, lock_len: u32,
    has_mutex: u8, mx_off: u32, mx_len: u32,
    has_recv: u8, recv_pkt: u32,
    has_spawn: u8, spawn_eff: u32, last_spawn_tk: u32,
    sp_line: u32, sp_col: u32, sp_hoff: u32, sp_hlen: u32,
    task_ret: u32,
    lrefs_has: u8, lrefs_mut: u8, lrefs_mf: u32, lrefs_foreign: u8,
    lcaps_has: u8, llen_has: u8, llen: i64,
    cond_depth: u32,
}
pub struct SSC { c: Checker, s: SSnap }

/// ss_take — move the parent's channels into the snap; leave the child
/// a clone (inherited channels) or an empty arena (fresh channels).
fn ss_take(own c: Checker) -> SSC {
    // inherited — parent moves out, child runs on a clone.
    let s_scopes = c.scopes; c.scopes = clone_u(c.heap, s_scopes);
    let s_binds = c.binds; c.binds = clone_cb(c.heap, s_binds);
    let s_bnames = c.bnames; c.bnames = clone_kk(c.heap, s_bnames);
    let s_regs = c.regs; c.regs = clone_regf(c.heap, s_regs);
    let s_edges = c.edges; c.edges = clone_e2(c.heap, s_edges);
    let s_caps = c.caps; c.caps = clone_c3(c.heap, s_caps);
    let s_cons = c.cons; c.cons = clone_cf(c.heap, s_cons);
    let s_init = c.init; c.init = clone_me2(c.heap, s_init);
    let s_tag = c.tag; c.tag = clone_tg(c.heap, s_tag);
    let s_provs = c.provs; c.provs = clone_pv(c.heap, s_provs);
    let s_transit = c.transit; c.transit = clone_u(c.heap, s_transit);
    let s_doms = c.doms; c.doms = clone_kk(c.heap, s_doms);
    let s_slens = c.slens; c.slens = clone_ki(c.heap, s_slens);
    let s_csafe = c.csafe; c.csafe = clone_u(c.heap, s_csafe);
    let s_foreign = c.foreign; c.foreign = clone_u(c.heap, s_foreign);
    let s_arg_atomic = c.arg_atomic;
    c.arg_atomic = clone_kk(c.heap, s_arg_atomic);
    let s_arg_mutex = c.arg_mutex;
    c.arg_mutex = clone_kk(c.heap, s_arg_mutex);
    let s_arg_chan = c.arg_chan;
    c.arg_chan = clone_kk(c.heap, s_arg_chan);
    let s_chans = c.chans; c.chans = clone_cq(c.heap, s_chans);
    let s_myields = c.myields;
    c.myields = clone_my(c.heap, s_myields);
    let s_mylens = c.mylens; c.mylens = clone_i64(c.heap, s_mylens);
    // fresh — parent moves out, child starts empty.
    let s_ekills = c.ekills;
    c.ekills = vec.Vec<MapE2>::new(c.heap);
    let s_ckills = c.ckills;
    c.ckills = vec.Vec<MapE2>::new(c.heap);
    let s_holds = c.holds; c.holds = vec.Vec<KM>::new(c.heap);
    let s_tasks = c.tasks; c.tasks = vec.Vec<Task>::new(c.heap);
    let s_teffs = c.teffs; c.teffs = vec.Vec<TaskEff>::new(c.heap);
    let s_tk_holds = c.tk_holds;
    c.tk_holds = vec.Vec<KM>::new(c.heap);
    let s_task_ext = c.task_ext;
    c.task_ext = vec.Vec<u32>::new(c.heap);
    let s_te_edges = c.te_edges;
    c.te_edges = vec.Vec<E2>::new(c.heap);
    let s_te_kills = c.te_kills;
    c.te_kills = vec.Vec<MapE2>::new(c.heap);
    let s_te_ccaps = c.te_ccaps;
    c.te_ccaps = vec.Vec<C3>::new(c.heap);
    let s_te_ckills = c.te_ckills;
    c.te_ckills = vec.Vec<MapE2>::new(c.heap);
    let s_te_cons = c.te_cons;
    c.te_cons = vec.Vec<CF>::new(c.heap);
    let s_te_provs = c.te_provs;
    c.te_provs = vec.Vec<PV>::new(c.heap);
    let s_te_re = c.te_re; c.te_re = vec.Vec<KM>::new(c.heap);
    let s_te_rc = c.te_rc; c.te_rc = vec.Vec<u32>::new(c.heap);
    let s_ret_edges = c.ret_edges;
    c.ret_edges = vec.Vec<KM>::new(c.heap);
    let s_ret_caps = c.ret_caps;
    c.ret_caps = vec.Vec<u32>::new(c.heap);
    let s_ret_lit_edges = c.ret_lit_edges;
    c.ret_lit_edges = vec.Vec<RLE>::new(c.heap);
    let s_ret_lit_caps = c.ret_lit_caps;
    c.ret_lit_caps = vec.Vec<RLE2>::new(c.heap);
    let s_ret_lit_provs = c.ret_lit_provs;
    c.ret_lit_provs = vec.Vec<PV>::new(c.heap);
    let s_ri_to = c.ri_to; c.ri_to = vec.Vec<u32>::new(c.heap);
    let s_rlc_keys = c.rlc_keys;
    c.rlc_keys = vec.Vec<u32>::new(c.heap);
    let s_last_lit = c.last_lit;
    c.last_lit = vec.Vec<PV>::new(c.heap);
    let s_lit_edges = c.lit_edges;
    c.lit_edges = vec.Vec<RLE>::new(c.heap);
    let s_lit_caps = c.lit_caps;
    c.lit_caps = vec.Vec<RLE2>::new(c.heap);
    let s_lit_dead = c.lit_dead;
    c.lit_dead = vec.Vec<LCF>::new(c.heap);
    let s_lit_lens = c.lit_lens;
    c.lit_lens = vec.Vec<KI>::new(c.heap);
    let s_lit_tags = c.lit_tags;
    c.lit_tags = vec.Vec<TG>::new(c.heap);
    let s_lit_csafe = c.lit_csafe;
    c.lit_csafe = vec.Vec<u32>::new(c.heap);
    let s_lrefs_to = c.lrefs_to;
    c.lrefs_to = vec.Vec<u32>::new(c.heap);
    let s_lcaps = c.lcaps; c.lcaps = vec.Vec<u32>::new(c.heap);
    let s_pstash = c.pstash; c.pstash = vec.Vec<u32>::new(c.heap);
    let s_hstash = c.hstash; c.hstash = vec.Vec<u32>::new(c.heap);
    let s_rv_new = c.rv_new; c.rv_new = vec.Vec<u32>::new(c.heap);
    let s_abandoned = c.abandoned;
    c.abandoned = vec.Vec<u32>::new(c.heap);
    let s_iw = c.iw; c.iw = vec.Vec<u32>::new(c.heap);
    // pk_edges/pk_caps/pk_sent are shared append-only arenas — a
    // packet cut in the child must stay dereferenceable after join,
    // so they are NOT snapshotted (like kns/kbyt).
    let s_pkt_stash = c.pkt_stash;
    c.pkt_stash = vec.Vec<Packet>::new(c.heap);
    let s_glocks = c.glocks; c.glocks = vec.Vec<u32>::new(c.heap);
    let s_defers = c.defers;
    c.defers = vec.Vec<vec.Vec<DeferRec>>::new(c.heap);
    let di: u64 = 0;
    while di < c.scopes.len {
        c.defers = c.defers.push(vec.Vec<DeferRec>::new(c.heap));
        di = di + 1;
    }
    let s_df_keys = c.df_keys;
    c.df_keys = vec.Vec<u32>::new(c.heap);
    let s_dres = c.dres; c.dres = vec.Vec<DR>::new(c.heap);
    let s_loops = c.loops; c.loops = vec.Vec<LoopCtx>::new(c.heap);
    let s_refresh = c.refresh;
    c.refresh = vec.Vec<Refresh>::new(c.heap);
    let s_cboff = c.cboff; c.cboff = vec.Vec<u32>::new(c.heap);
    let s_cblen = c.cblen; c.cblen = vec.Vec<u32>::new(c.heap);
    let s_cbases = c.cbases; c.cbases = vec.Vec<u32>::new(c.heap);
    let s_tk_out = c.tk_out; c.tk_out = vec.Vec<u32>::new(c.heap);
    let s_tk_out2 = c.tk_out2; c.tk_out2 = vec.Vec<u32>::new(c.heap);
    let s_ahold = c.ahold; c.ahold = vec.Vec<u32>::new(c.heap);
    let s_rebs = c.rebs; c.rebs = vec.Vec<Reb>::new(c.heap);
    let s_reb_edges = c.reb_edges;
    c.reb_edges = vec.Vec<E2>::new(c.heap);
    let s_reb_caps = c.reb_caps;
    c.reb_caps = vec.Vec<C3>::new(c.heap);
    // scalars — saved, then reset for the child.
    let s = SSnap {
        scopes: s_scopes, binds: s_binds, bnames: s_bnames,
        regs: s_regs,
        edges: s_edges, caps: s_caps, cons: s_cons,
        init: s_init, tag: s_tag, provs: s_provs,
        transit: s_transit, doms: s_doms,
        slens: s_slens, csafe: s_csafe, foreign: s_foreign,
        arg_atomic: s_arg_atomic, arg_mutex: s_arg_mutex,
        arg_chan: s_arg_chan,
        chans: s_chans, myields: s_myields, mylens: s_mylens,
        ekills: s_ekills, ckills: s_ckills,
        holds: s_holds, tasks: s_tasks, teffs: s_teffs,
        tk_holds: s_tk_holds, task_ext: s_task_ext,
        te_edges: s_te_edges, te_kills: s_te_kills,
        te_ccaps: s_te_ccaps, te_ckills: s_te_ckills,
        te_cons: s_te_cons, te_provs: s_te_provs,
        te_re: s_te_re, te_rc: s_te_rc,
        ret_edges: s_ret_edges, ret_caps: s_ret_caps,
        ret_lit_edges: s_ret_lit_edges,
        ret_lit_caps: s_ret_lit_caps,
        ret_lit_provs: s_ret_lit_provs,
        ri_to: s_ri_to, rlc_keys: s_rlc_keys,
        last_lit: s_last_lit,
        lit_edges: s_lit_edges, lit_caps: s_lit_caps,
        lit_dead: s_lit_dead, lit_lens: s_lit_lens,
        lit_tags: s_lit_tags, lit_csafe: s_lit_csafe,
        lrefs_to: s_lrefs_to, lcaps: s_lcaps,
        pstash: s_pstash, hstash: s_hstash,
        rv_new: s_rv_new, abandoned: s_abandoned, iw: s_iw,
        pkt_stash: s_pkt_stash, glocks: s_glocks,
        defers: s_defers, df_keys: s_df_keys,
        dres: s_dres, loops: s_loops, refresh: s_refresh,
        cboff: s_cboff, cblen: s_cblen, cbases: s_cbases,
        tk_out: s_tk_out, tk_out2: s_tk_out2,
        ahold: s_ahold, rebs: s_rebs,
        reb_edges: s_reb_edges, reb_caps: s_reb_caps,
        diverged: c.diverged, terminated: c.terminated,
        has_lit: c.has_lit, has_tag: c.has_tag,
        tag_v: c.tag_v, tag_has: c.tag_has,
        has_lock: c.has_lock, lock_dom: c.lock_dom,
        lock_root: c.lock_root, lock_ty: c.lock_ty,
        lock_off: c.lock_off, lock_len: c.lock_len,
        has_mutex: c.has_mutex, mx_off: c.mx_off, mx_len: c.mx_len,
        has_recv: c.has_recv, recv_pkt: c.recv_pkt,
        has_spawn: c.has_spawn, spawn_eff: c.spawn_eff,
        last_spawn_tk: c.last_spawn_tk,
        sp_line: c.sp_line, sp_col: c.sp_col,
        sp_hoff: c.sp_hoff, sp_hlen: c.sp_hlen,
        task_ret: c.task_ret,
        lrefs_has: c.lrefs_has, lrefs_mut: c.lrefs_mut,
        lrefs_mf: c.lrefs_mf, lrefs_foreign: c.lrefs_foreign,
        lcaps_has: c.lcaps_has, llen_has: c.llen_has, llen: c.llen,
        cond_depth: c.cond_depth,
    };
    c.diverged = 0; c.terminated = 0;
    c.has_lit = 0; c.has_tag = 0; c.tag_v = 0; c.tag_has = 0;
    c.has_lock = 0; c.lock_dom = 0; c.lock_root = 0; c.lock_ty = 0;
    c.lock_off = 0; c.lock_len = 0;
    c.has_mutex = 0; c.mx_off = 0; c.mx_len = 0;
    c.has_recv = 0; c.recv_pkt = 0;
    c.has_spawn = 0; c.spawn_eff = 0; c.last_spawn_tk = 0;
    c.sp_line = 0; c.sp_col = 0; c.sp_hoff = 0; c.sp_hlen = 0;
    c.task_ret = NONE();
    c.lrefs_has = 0; c.lrefs_mut = 0; c.lrefs_mf = 0; c.lrefs_foreign = 0;
    c.lcaps_has = 0; c.llen_has = 0; c.llen = 0;
    c.cond_depth = 0;
    return SSC { c: c, s: s };
}

/// ss_restore — the parent's state moves back; the child's live
/// channels are destroyed (their suspended diff was captured first).
fn ss_restore(own c: Checker, own s: SSnap) -> Checker {
    c.scopes.destroy(); c.scopes = s.scopes;
    c.binds.destroy(); c.binds = s.binds;
    c.bnames.destroy(); c.bnames = s.bnames;
    c.regs.destroy(); c.regs = s.regs;
    c.edges.destroy(); c.edges = s.edges;
    c.caps.destroy(); c.caps = s.caps;
    c.cons.destroy(); c.cons = s.cons;
    c.init.destroy(); c.init = s.init;
    c.tag.destroy(); c.tag = s.tag;
    c.provs.destroy(); c.provs = s.provs;
    c.transit.destroy(); c.transit = s.transit;
    c.doms.destroy(); c.doms = s.doms;
    c.slens.destroy(); c.slens = s.slens;
    c.csafe.destroy(); c.csafe = s.csafe;
    c.foreign.destroy(); c.foreign = s.foreign;
    c.arg_atomic.destroy(); c.arg_atomic = s.arg_atomic;
    c.arg_mutex.destroy(); c.arg_mutex = s.arg_mutex;
    c.arg_chan.destroy(); c.arg_chan = s.arg_chan;
    c.chans.destroy(); c.chans = s.chans;
    c.myields.destroy(); c.myields = s.myields;
    c.mylens.destroy(); c.mylens = s.mylens;
    c.ekills.destroy(); c.ekills = s.ekills;
    c.ckills.destroy(); c.ckills = s.ckills;
    c.holds.destroy(); c.holds = s.holds;
    c.tasks.destroy(); c.tasks = s.tasks;
    c.teffs.destroy(); c.teffs = s.teffs;
    c.tk_holds.destroy(); c.tk_holds = s.tk_holds;
    c.task_ext.destroy(); c.task_ext = s.task_ext;
    c.te_edges.destroy(); c.te_edges = s.te_edges;
    c.te_kills.destroy(); c.te_kills = s.te_kills;
    c.te_ccaps.destroy(); c.te_ccaps = s.te_ccaps;
    c.te_ckills.destroy(); c.te_ckills = s.te_ckills;
    c.te_cons.destroy(); c.te_cons = s.te_cons;
    c.te_provs.destroy(); c.te_provs = s.te_provs;
    c.te_re.destroy(); c.te_re = s.te_re;
    c.te_rc.destroy(); c.te_rc = s.te_rc;
    c.ret_edges.destroy(); c.ret_edges = s.ret_edges;
    c.ret_caps.destroy(); c.ret_caps = s.ret_caps;
    c.ret_lit_edges.destroy(); c.ret_lit_edges = s.ret_lit_edges;
    c.ret_lit_caps.destroy(); c.ret_lit_caps = s.ret_lit_caps;
    c.ret_lit_provs.destroy(); c.ret_lit_provs = s.ret_lit_provs;
    c.ri_to.destroy(); c.ri_to = s.ri_to;
    c.rlc_keys.destroy(); c.rlc_keys = s.rlc_keys;
    c.last_lit.destroy(); c.last_lit = s.last_lit;
    c.lit_edges.destroy(); c.lit_edges = s.lit_edges;
    c.lit_caps.destroy(); c.lit_caps = s.lit_caps;
    c.lit_dead.destroy(); c.lit_dead = s.lit_dead;
    c.lit_lens.destroy(); c.lit_lens = s.lit_lens;
    c.lit_tags.destroy(); c.lit_tags = s.lit_tags;
    c.lit_csafe.destroy(); c.lit_csafe = s.lit_csafe;
    c.lrefs_to.destroy(); c.lrefs_to = s.lrefs_to;
    c.lcaps.destroy(); c.lcaps = s.lcaps;
    c.pstash.destroy(); c.pstash = s.pstash;
    c.hstash.destroy(); c.hstash = s.hstash;
    c.rv_new.destroy(); c.rv_new = s.rv_new;
    c.abandoned.destroy(); c.abandoned = s.abandoned;
    c.iw.destroy(); c.iw = s.iw;
    c.pkt_stash.destroy(); c.pkt_stash = s.pkt_stash;
    c.glocks.destroy(); c.glocks = s.glocks;
    let i: u64 = 0;
    while i < c.defers.len { c.defers.buf[i].destroy(); i = i + 1; }
    c.defers.destroy(); c.defers = s.defers;
    c.df_keys.destroy(); c.df_keys = s.df_keys;
    c.dres.destroy(); c.dres = s.dres;
    c.loops.destroy(); c.loops = s.loops;
    c.refresh.destroy(); c.refresh = s.refresh;
    c.cboff.destroy(); c.cboff = s.cboff;
    c.cblen.destroy(); c.cblen = s.cblen;
    c.cbases.destroy(); c.cbases = s.cbases;
    c.tk_out.destroy(); c.tk_out = s.tk_out;
    c.tk_out2.destroy(); c.tk_out2 = s.tk_out2;
    c.ahold.destroy(); c.ahold = s.ahold;
    c.rebs.destroy(); c.rebs = s.rebs;
    c.reb_edges.destroy(); c.reb_edges = s.reb_edges;
    c.reb_caps.destroy(); c.reb_caps = s.reb_caps;
    c.diverged = s.diverged; c.terminated = s.terminated;
    c.has_lit = s.has_lit; c.has_tag = s.has_tag;
    c.tag_v = s.tag_v; c.tag_has = s.tag_has;
    c.has_lock = s.has_lock; c.lock_dom = s.lock_dom;
    c.lock_root = s.lock_root; c.lock_ty = s.lock_ty;
    c.lock_off = s.lock_off; c.lock_len = s.lock_len;
    c.has_mutex = s.has_mutex; c.mx_off = s.mx_off; c.mx_len = s.mx_len;
    c.has_recv = s.has_recv; c.recv_pkt = s.recv_pkt;
    c.has_spawn = s.has_spawn; c.spawn_eff = s.spawn_eff;
    c.last_spawn_tk = s.last_spawn_tk;
    c.sp_line = s.sp_line; c.sp_col = s.sp_col;
    c.sp_hoff = s.sp_hoff; c.sp_hlen = s.sp_hlen;
    c.task_ret = s.task_ret;
    c.lrefs_has = s.lrefs_has; c.lrefs_mut = s.lrefs_mut;
    c.lrefs_mf = s.lrefs_mf; c.lrefs_foreign = s.lrefs_foreign;
    c.lcaps_has = s.lcaps_has; c.llen_has = s.llen_has; c.llen = s.llen;
    c.cond_depth = s.cond_depth;
    return c;
}

// ---- tasks: spawn / join --------------------------------------------------

/// is_external — the key's root starts `$` or was a live bind at
/// spawn (task_ext holds `name#epoch` roots). res = 1|0.
fn is_ext(own c: Checker, k: u32) -> Checker {
    c = key_root(c, k);
    let rk = c.res;
    if k_is_arg(c, rk) == 1 { c.res = 1; return c; }
    c.res = u32(vhas(c.task_ext, rk));
    return c;
}

/// wrapper rty — Task/Handle/etc: (kind, a) canonical, find-or-push.
fn rty_mk_wrap(own c: Checker, kind: u8, a: u32) -> Checker {
    let i: u64 = 0;
    while i < c.r.rtys.len {
        let t = c.r.rtys.buf[i];
        if t.kind == kind && t.name == 0 && t.a == a
            && t.b == 0 && t.w == 0 {
            c.res = u32(i);
            return c;
        }
        i = i + 1;
    }
    c.r.rtys = c.r.rtys.push(resolve.RTy {
        kind: kind, name: 0, a: a, b: 0, c: 0, w: 0 });
    c.res = u32(c.r.rtys.len) - 1;
    return c;
}

/// key-order sorts for the suspended-diff capture (canonical replay
/// order at join). Insertion sort — these lists are small.
fn srt_e2(read c: Checker, own v: vec.Vec<E2>) -> vec.Vec<E2> {
    let i: u64 = 1;
    while i < v.len {
        let x = v.buf[i];
        let j = i;
        while j > 0 {
            let y = v.buf[j - 1];
            let less: u8 = 0;
            if kless(c, x.h, y.h) == 1 { less = 1; }
            else { if y.h == x.h { less = kless(c, x.t, y.t); } }
            if less == 0 { break; }
            v.buf[j] = v.buf[j - 1];
            j = j - 1;
        }
        v.buf[j] = x;
        i = i + 1;
    }
    return v;
}
fn srt_c3(read c: Checker, own v: vec.Vec<C3>) -> vec.Vec<C3> {
    let i: u64 = 1;
    while i < v.len {
        let x = v.buf[i];
        let j = i;
        while j > 0 {
            let y = v.buf[j - 1];
            let less: u8 = 0;
            if kless(c, x.h, y.h) == 1 { less = 1; }
            else { if y.h == x.h { less = kless(c, x.t, y.t); } }
            if less == 0 { break; }
            v.buf[j] = v.buf[j - 1];
            j = j - 1;
        }
        v.buf[j] = x;
        i = i + 1;
    }
    return v;
}
fn srt_me2(read c: Checker, own v: vec.Vec<MapE2>) -> vec.Vec<MapE2> {
    let i: u64 = 1;
    while i < v.len {
        let x = v.buf[i];
        let j = i;
        while j > 0 && kless(c, x.k, v.buf[j - 1].k) == 1 {
            v.buf[j] = v.buf[j - 1];
            j = j - 1;
        }
        v.buf[j] = x;
        i = i + 1;
    }
    return v;
}
fn srt_cf(read c: Checker, own v: vec.Vec<CF>) -> vec.Vec<CF> {
    let i: u64 = 1;
    while i < v.len {
        let x = v.buf[i];
        let j = i;
        while j > 0 && kless(c, x.k, v.buf[j - 1].k) == 1 {
            v.buf[j] = v.buf[j - 1];
            j = j - 1;
        }
        v.buf[j] = x;
        i = i + 1;
    }
    return v;
}
fn srt_pv(read c: Checker, own v: vec.Vec<PV>) -> vec.Vec<PV> {
    let i: u64 = 1;
    while i < v.len {
        let x = v.buf[i];
        let j = i;
        while j > 0 && kless(c, x.k, v.buf[j - 1].k) == 1 {
            v.buf[j] = v.buf[j - 1];
            j = j - 1;
        }
        v.buf[j] = x;
        i = i + 1;
    }
    return v;
}
fn srt_km(read c: Checker, own v: vec.Vec<KM>) -> vec.Vec<KM> {
    let i: u64 = 1;
    while i < v.len {
        let x = v.buf[i];
        let j = i;
        while j > 0 && kless(c, x.k, v.buf[j - 1].k) == 1 {
            v.buf[j] = v.buf[j - 1];
            j = j - 1;
        }
        v.buf[j] = x;
        i = i + 1;
    }
    return v;
}

/// Expr::Spawn — fork the world, run the body on the child state,
/// diff the suspended transform back, leave `has_spawn` for the
/// binding site (bind_task / the unbound-spawn diagnostic).
fn expr_spawn(own c: Checker, read p: ast.Parser, eid: u32) -> Checker {
    let e = p.exps.buf[u64(eid)];
    c = es(c, "(spawn @");
    c = eu(c, u64(e.line));
    c = ec(c, u8(58));
    c = eu(c, u64(e.col));
    c = ec(c, u8(41));
    c = rec(c);
    // ext — every live bind key (`{name}#{epoch}`)
    let ext = vec.Vec<u32>::new(c.heap);
    let i: u64 = 0;
    while i < c.bnames.len {
        let b = c.binds.buf[u64(c.bnames.buf[i].v)];
        c = key_of(c, b.n, b.epoch);
        if vhas(ext, c.res) == 0 { ext = ext.push(c.res); }
        i = i + 1;
    }
    let base_regs = u32(c.regs.len);
    let sline = e.line; let scol = e.col;
    let sb = e.b; let se = e.c;
    // fork — parent channels into the snap, child on clones/resets.
    let t = ss_take(c);
    c = t.c;
    let snap = t.s;
    c.task_ext.destroy();
    c.task_ext = ext;
    c = rty_prim(c, 9);
    c.task_ret = c.res;
    let tret = c.task_ret;
    c = es(c, "(task-begin)");
    c = rec(c);
    c = check_block(c, p, sb, sb + se, 0, tret);
    c = es(c, "(task-end)");
    c = rec(c);
    return spawn_commit(c, snap, base_regs, sline, scol);
}

/// spawn_commit — suspended-diff + parent merge of Expr::Spawn
/// (own frame so nested spawn recursion stays cheap).
fn spawn_commit(own c: Checker, own snap: SSnap,
                base_regs: u32, sline: u32, scol: u32) -> Checker {
    // suspended diff — capture into locals (child state still live).
    let i: u64 = 0;
    let ret = c.task_ret;
    let d_edges = vec.Vec<E2>::new(c.heap);
    i = 0;
    while i < c.edges.len {
        let x = c.edges.buf[i];
        c = is_ext(c, x.h);
        let he = c.res;
        c = is_ext(c, x.t);
        if he == 1 && c.res == 1 {
            let same: u8 = 0;
            let j: u64 = 0;
            while j < snap.edges.len {
                let pe = snap.edges.buf[j];
                if pe.h == x.h && pe.t == x.t
                    && pe.kind == x.kind && pe.cert == x.cert { same = 1; }
                j = j + 1;
            }
            if same == 0 { d_edges = d_edges.push(x); }
        }
        i = i + 1;
    }
    let d_kills = vec.Vec<MapE2>::new(c.heap);
    i = 0;
    while i < c.ekills.len {
        let m = c.ekills.buf[i];
        c = is_ext(c, m.k);
        if c.res == 1 { d_kills = d_kills.push(m); }
        i = i + 1;
    }
    let d_ccaps = vec.Vec<C3>::new(c.heap);
    i = 0;
    while i < c.caps.len {
        let x = c.caps.buf[i];
        c = is_ext(c, x.h);
        let he = c.res;
        c = is_ext(c, x.t);
        if he == 1 && c.res == 1 {
            let same: u8 = 0;
            let j: u64 = 0;
            while j < snap.caps.len {
                let pc = snap.caps.buf[j];
                if pc.h == x.h && pc.t == x.t
                    && pc.cert == x.cert { same = 1; }
                j = j + 1;
            }
            if same == 0 { d_ccaps = d_ccaps.push(x); }
        }
        i = i + 1;
    }
    let d_ckills = vec.Vec<MapE2>::new(c.heap);
    i = 0;
    while i < c.ckills.len {
        let m = c.ckills.buf[i];
        c = is_ext(c, m.k);
        if c.res == 1 { d_ckills = d_ckills.push(m); }
        i = i + 1;
    }
    let d_cons = vec.Vec<CF>::new(c.heap);
    i = 0;
    while i < c.cons.len {
        let f = c.cons.buf[i];
        c = is_ext(c, f.k);
        if c.res == 1 {
            let pst: u8 = 0;
            let j: u64 = 0;
            while j < snap.cons.len {
                if snap.cons.buf[j].k == f.k {
                    pst = snap.cons.buf[j].st;
                }
                j = j + 1;
            }
            if pst != f.st { d_cons = d_cons.push(f); }
        }
        i = i + 1;
    }
    let d_provs = vec.Vec<PV>::new(c.heap);
    i = 0;
    while i < c.provs.len {
        let v = c.provs.buf[i];
        c = is_ext(c, v.k);
        if c.res == 1 {
            // region ids >= base_regs name child-internal regions —
            // meaningless to the parent, filtered.
            if v.pk == 2 && v.pv >= base_regs { }
            else { d_provs = d_provs.push(v); }
        }
        i = i + 1;
    }
    let d_re = clone_km(c.heap, c.ret_edges);
    let d_rc = clone_u(c.heap, c.ret_caps);
    let d_holds = vec.Vec<KM>::new(c.heap);
    i = 0;
    while i < c.holds.len {
        let h = c.holds.buf[i];
        c = is_ext(c, h.k);
        if c.res == 1 { d_holds = d_holds.push(h); }
        i = i + 1;
    }
    // channel world — external transit + queues merge back at spawn.
    let d_transit = vec.Vec<u32>::new(c.heap);
    i = 0;
    while i < c.transit.len {
        let tk = c.transit.buf[i];
        c = is_ext(c, tk);
        if c.res == 1 { d_transit = d_transit.push(tk); }
        i = i + 1;
    }
    let d_chans = vec.Vec<CQ>::new(c.heap);
    i = 0;
    while i < c.chans.len {
        let qk = c.chans.buf[i].k;
        c = is_ext(c, qk);
        if c.res == 1 {
            let np = vec.Vec<Packet>::new(c.heap);
            let j: u64 = 0;
            while j < c.chans.buf[i].pkts.len {
                np = np.push(c.chans.buf[i].pkts.buf[j]);
                j = j + 1;
            }
            d_chans = d_chans.push(CQ { k: qk, pkts: np });
        }
        i = i + 1;
    }
    // back to the parent world.
    c = ss_restore(c, snap);
    c.transit.destroy();
    c.transit = d_transit;
    // Stage-0 sorts child channel queues by key before landing them.
    let qks = vec.Vec<u32>::new(c.heap);
    i = 0;
    while i < d_chans.len {
        qks = qks.push(d_chans.buf[i].k); i = i + 1;
    }
    let qks2 = ksort(c, qks);
    i = 0;
    while i < qks2.len {
        let qk = qks2.buf[i];
        let di: u64 = 0;
        while di < d_chans.len {
            if d_chans.buf[di].k == qk { break; }
            di = di + 1;
        }
        let qn = u64(d_chans.buf[di].pkts.len);
        c = es(c, "(chan ");
        c = eqs(c, qk);
        c = ec(c, u8(32));
        c = eu(c, qn);
        c = ec(c, u8(41));
        c = rec(c);
        let hit: i64 = 0 - 1;
        let j: u64 = 0;
        while j < c.chans.len {
            if c.chans.buf[j].k == qk { hit = i64(j); }
            j = j + 1;
        }
        if hit >= 0 {
            let np = vec.Vec<Packet>::new(c.heap);
            let j2: u64 = 0;
            while j2 < qn {
                np = np.push(d_chans.buf[di].pkts.buf[j2]);
                j2 = j2 + 1;
            }
            c.chans.buf[u64(hit)].pkts.destroy();
            c.chans.buf[u64(hit)].pkts = np;
        }
        if hit < 0 {
            let np = vec.Vec<Packet>::new(c.heap);
            let j2: u64 = 0;
            while j2 < qn {
                np = np.push(d_chans.buf[di].pkts.buf[j2]);
                j2 = j2 + 1;
            }
            c.chans = c.chans.push(CQ { k: qk, pkts: np });
        }
        i = i + 1;
    }
    while d_chans.len > 0 {
        let dq = d_chans.pop();
        dq.pkts.destroy();
    }
    d_chans.destroy();
    qks2.destroy();
    // eff + holds into the arenas — sorted for canonical join replay.
    let d_e2 = srt_e2(c, d_edges);
    let d_k2 = srt_me2(c, d_kills);
    let d_c2 = srt_c3(c, d_ccaps);
    let d_ck2 = srt_me2(c, d_ckills);
    let d_f2 = srt_cf(c, d_cons);
    let d_p2 = srt_pv(c, d_provs);
    let effi = u32(c.teffs.len);
    let eo = u32(c.te_edges.len);
    i = 0;
    while i < d_e2.len { c.te_edges = c.te_edges.push(d_e2.buf[i]); i = i + 1; }
    let ko = u32(c.te_kills.len);
    i = 0;
    while i < d_k2.len { c.te_kills = c.te_kills.push(d_k2.buf[i]); i = i + 1; }
    let co = u32(c.te_ccaps.len);
    i = 0;
    while i < d_c2.len { c.te_ccaps = c.te_ccaps.push(d_c2.buf[i]); i = i + 1; }
    let cko = u32(c.te_ckills.len);
    i = 0;
    while i < d_ck2.len { c.te_ckills = c.te_ckills.push(d_ck2.buf[i]); i = i + 1; }
    let dof = u32(c.te_cons.len);
    i = 0;
    while i < d_f2.len { c.te_cons = c.te_cons.push(d_f2.buf[i]); i = i + 1; }
    let po = u32(c.te_provs.len);
    i = 0;
    while i < d_p2.len { c.te_provs = c.te_provs.push(d_p2.buf[i]); i = i + 1; }
    let reo = u32(c.te_re.len);
    i = 0;
    while i < d_re.len { c.te_re = c.te_re.push(d_re.buf[i]); i = i + 1; }
    let rco = u32(c.te_rc.len);
    i = 0;
    while i < d_rc.len { c.te_rc = c.te_rc.push(d_rc.buf[i]); i = i + 1; }
    c.teffs = c.teffs.push(TaskEff {
        eoff: eo, elen: u32(c.te_edges.len) - eo,
        koff: ko, klen: u32(c.te_kills.len) - ko,
        coff: co, clen: u32(c.te_ccaps.len) - co,
        ckoff: cko, cklen: u32(c.te_ckills.len) - cko,
        doff: dof, dlen: u32(c.te_cons.len) - dof,
        poff: po, plen: u32(c.te_provs.len) - po,
        reoff: reo, relen: u32(c.te_re.len) - reo,
        rcoff: rco, rclen: u32(c.te_rc.len) - rco,
        ret: ret });
    d_e2.destroy(); d_k2.destroy(); d_c2.destroy(); d_ck2.destroy();
    d_f2.destroy(); d_p2.destroy(); d_re.destroy(); d_rc.destroy();
    c.sp_hoff = u32(c.tk_holds.len);
    let d_h2 = srt_km(c, d_holds);
    i = 0;
    while i < d_h2.len { c.tk_holds = c.tk_holds.push(d_h2.buf[i]); i = i + 1; }
    c.sp_hlen = u32(c.tk_holds.len) - c.sp_hoff;
    d_h2.destroy();
    c.has_spawn = 1;
    c.spawn_eff = effi;
    c.sp_line = sline;
    c.sp_col = scol;
    c = rty_mk_wrap(c, 19, ret);
    c.res2 = 0;
    c.res3 = 0;
    return c;
}

/// Expr::Join — the suspended transform lands: kills then creates
/// then caps (summary-replay order), hold edges die, token is spent.
fn expr_join(own c: Checker, read p: ast.Parser, eid: u32) -> Checker {
    let e = p.exps.buf[u64(eid)];
    c = builtin_shadow(c, "join", e.line, e.col);
    c = expr_tv(c, p, e.a);
    let t = c.res;
    let tn = c.r.rtys.buf[u64(t)];
    if tn.kind != 19 {
        let m = vec.Vec<u8>::new(c.heap);
        let m2 = resolve.bputs(m, "`join` requires a task, found ");
        let t1 = push_ty(m2, c, t);
        c = t1.c;
        c = pdiag(c, e.line, e.col, t1.m.as_slice());
        t1.m.destroy();
        c = rty_prim(c, 9);
        c.res2 = 0;
        c.res3 = 0;
        return c;
    }
    let ret = tn.a;
    c = place_id(c, p, e.a);
    let key = c.res;
    let ti: u32 = NONE();
    if key != NONE() { ti = task_find(c, key); }
    if ti == NONE() {
        let m = vec.Vec<u8>::new(c.heap);
        let m2 = resolve.bputs(m,
            "join of unknown or already-joined task `");
        let m3 = tn_into(m2, c, p, e.a);
        let m4 = m3.push(u8(96));
        c = pdiag(c, e.line, e.col, m4.as_slice());
        m4.destroy();
        c.res = ret;
        c.res2 = 1;
        c.res3 = 0;
        return c;
    }
    c = es(c, "(task-join ");
    c = eqs(c, key);
    c = es(c, " @");
    c = eu(c, u64(e.line));
    c = ec(c, u8(58));
    c = eu(c, u64(e.col));
    c = ec(c, u8(41));
    c = rec(c);
    if cons_state(c, key) == 1 {
        c.res = ret;
        c.res2 = 1;
        c.res3 = 0;
        return c;
    }
    let tk = c.tasks.buf[u64(ti)];
    let eff = c.teffs.buf[u64(tk.eff)];
    let i: u64 = u64(eff.koff);
    while i < u64(eff.koff) + u64(eff.klen) {
        let m = c.te_kills.buf[i];
        c = kill_set(c, m.k, m.cert);
        c = apply_kill(c, m.k, m.cert);
        i = i + 1;
    }
    i = u64(eff.ckoff);
    while i < u64(eff.ckoff) + u64(eff.cklen) {
        let m = c.te_ckills.buf[i];
        c = capkill_set(c, m.k, m.cert);
        c = apply_cap_kill(c, m.k, m.cert);
        i = i + 1;
    }
    i = u64(eff.eoff);
    while i < u64(eff.eoff) + u64(eff.elen) {
        let x = c.te_edges.buf[i];
        c = edge_set(c, x.h, x.t, x.kind, x.cert, x.bl, x.bc);
        // region-prov backfill — target root names a live bind
        c = key_root(c, x.t);
        let rk = c.res;
        let nm = root_name(c, rk);
        if nm != NONE() {
            let bi = bfind(c, nm);
            if i64(bi) >= 0 {
                let b = c.binds.buf[u64(bi)];
                c = key_of(c, nm, b.epoch);
                if c.res == rk {
                    c = prov_set(c, x.h, 2, b.owner);
                }
            }
        }
        i = i + 1;
    }
    i = u64(eff.coff);
    while i < u64(eff.coff) + u64(eff.clen) {
        let x = c.te_ccaps.buf[i];
        c = cap_set(c, x.h, x.t, x.cert);
        i = i + 1;
    }
    i = u64(eff.doff);
    while i < u64(eff.doff) + u64(eff.dlen) {
        let f = c.te_cons.buf[i];
        c = cons_set(c, f.k, f.st, f.aoff, f.alen);
        i = i + 1;
    }
    i = u64(eff.poff);
    while i < u64(eff.poff) + u64(eff.plen) {
        let v = c.te_provs.buf[i];
        c = prov_set(c, v.k, v.pk, v.pv);
        i = i + 1;
    }
    c = edges_retain_holder(c, key);
    c = cons1(c, key, 1, e.line, e.col);
    c.res = ret;
    c.res2 = 1;
    c.res3 = 0;
    return c;
}

/// join_prov — res = pk, res2 = pv of the joined prov.
fn jprov(own c: Checker, apk: u8, apv: u32,
         bpk: u8, bpv: u32) -> Checker {
    if apk == 0 { c.res = u32(bpk); c.res2 = bpv; return c; }
    if bpk == 0 { c.res = u32(apk); c.res2 = apv; return c; }
    if apk == 1 && bpk == 1 { c.res = 1; c.res2 = 0; return c; }
    if apk == 1 { c.res = u32(bpk); c.res2 = bpv; return c; }
    if bpk == 1 { c.res = u32(apk); c.res2 = apv; return c; }
    // region x region -> lca
    c.res = 2; c.res2 = rlca(c, apv, bpv);
    return c;
}

/// region lca via parent chains.
fn rlca(read c: Checker, a: u32, b: u32) -> u32 {
    // walk a's ancestors; return first that is an ancestor of b
    let cur = a;
    while cur != NONE() {
        if ranc(c, cur, b) == 1 { return cur; }
        cur = c.regs.buf[u64(cur)].parent;
    }
    return 0;
}

/// is `a` an ancestor-or-self of `b`?
fn ranc(read c: Checker, a: u32, b: u32) -> u8 {
    let cur = b;
    while cur != NONE() {
        if cur == a { return 1; }
        cur = c.regs.buf[u64(cur)].parent;
    }
    return 0;
}

/// init_covered — Def cert at k's canon or any ancestor in `m`.
fn icov(own c: Checker, read m: vec.Vec<MapE2>, k0: u32) -> Checker {
    c.res = 0;
    c = init_canon(c, k0);
    let cur = c.res;
    while cur != NONE() {
        let i: u64 = 0;
        while i < m.len {
            if m.buf[i].k == cur && m.buf[i].cert == 1 {
                c.res = 1; return c;
            }
            i = i + 1;
        }
        let ck = cur;
        c = init_parent(c, ck);
        cur = c.res;
    }
    return c;
}

/// icov over the live init map.
fn icov_c(own c: Checker, k0: u32) -> Checker {
    c.res = 0;
    c = init_canon(c, k0);
    let cur = c.res;
    while cur != NONE() {
        let i: u64 = 0;
        while i < c.init.len {
            if c.init.buf[i].k == cur && c.init.buf[i].cert == 1 {
                c.res = 1; return c;
            }
            i = i + 1;
        }
        let ck = cur;
        c = init_parent(c, ck);
        cur = c.res;
    }
    return c;
}

/// cert of k in a MapE2 vec: 1 def, 2 maybe, 0 absent.
fn me_get(read v: vec.Vec<MapE2>, k: u32) -> u8 {
    let i: u64 = 0;
    while i < v.len {
        if v.buf[i].k == k { return v.buf[i].cert; }
        i = i + 1;
    }
    return 0;
}

fn e2_has(read v: vec.Vec<E2>, h: u32, t: u32) -> i64 {
    let i: u64 = 0;
    while i < v.len {
        if v.buf[i].h == h && v.buf[i].t == t { return i64(i); }
        i = i + 1;
    }
    return 0 - 1;
}

fn c3_get(read v: vec.Vec<C3>, h: u32, t: u32) -> u8 {
    let i: u64 = 0;
    while i < v.len {
        if v.buf[i].h == h && v.buf[i].t == t { return v.buf[i].cert; }
        i = i + 1;
    }
    return 0;
}

fn cf_get(read v: vec.Vec<CF>, k: u32) -> i64 {
    let i: u64 = 0;
    while i < v.len {
        if v.buf[i].k == k { return i64(i); }
        i = i + 1;
    }
    return 0 - 1;
}

fn pv_get(read v: vec.Vec<PV>, k: u32) -> i64 {
    let i: u64 = 0;
    while i < v.len {
        if v.buf[i].k == k { return i64(i); }
        i = i + 1;
    }
    return 0 - 1;
}

/// merge_origins for cons `at` spans — appends b's sites to a's
/// (dedup, cap 4) and returns a fresh (off,len) into c.atspans.
/// alen == NONE() means the side had no fact.
fn ats_merge(own c: Checker, aoff: u32, alen: u32,
             boff: u32, blen: u32) -> Checker {
    let off = u32(c.atspans.len);
    let n: u32 = 0;
    if alen != NONE() {
        let j: u64 = 0;
        while j < u64(alen) * 2 {
            c.atspans = c.atspans.push(c.atspans.buf[u64(aoff) + j]);
            j = j + 1;
        }
        n = alen;
    }
    if blen != NONE() {
        let j: u64 = 0;
        while j < u64(blen) {
            let sl = c.atspans.buf[u64(boff) + j * 2];
            let sc = c.atspans.buf[u64(boff) + j * 2 + 1];
            let dup: u8 = 0;
            let q: u64 = u64(off);
            while q < c.atspans.len {
                if c.atspans.buf[q] == sl
                    && c.atspans.buf[q + 1] == sc { dup = 1; }
                q = q + 2;
            }
            if dup == 0 && n < 4 {
                c.atspans = c.atspans.push(sl);
                c.atspans = c.atspans.push(sc);
                n = n + 1;
            }
            j = j + 1;
        }
    }
    c.res = off; c.res2 = n;
    return c;
}

/// if_merge — the full two-path join: c holds the else state, `then`
/// is the other arm. pre provs feed the prov-join fallback.
fn if_merge(own c: Checker, own t: BS, read pre: BS) -> Checker {
    // edges: union; Def iff both Def && same kind; born then-first
    let w = vec.Vec<E2>::new(c.heap);
    let i: u64 = 0;
    while i < t.edges.len {
        let e = t.edges.buf[i];
        let cert: u8 = 2;
        let bi = e2_has(c.edges, e.h, e.t);
        if bi >= 0 {
            let o = c.edges.buf[u64(bi)];
            if o.cert == 1 && e.cert == 1 && o.kind == e.kind {
                cert = 1;
            }
        }
        w = w.push(E2 { h: e.h, t: e.t, kind: e.kind,
            cert: cert, bl: e.bl, bc: e.bc });
        i = i + 1;
    }
    i = 0;
    while i < c.edges.len {
        let e = c.edges.buf[i];
        if e2_has(t.edges, e.h, e.t) < 0 {
            w = w.push(E2 { h: e.h, t: e.t, kind: e.kind,
                cert: 2, bl: e.bl, bc: e.bc });
        }
        i = i + 1;
    }
    c.edges.destroy(); c.edges = w;
    // caps: same both-Def rule on (h,t)
    let w2 = vec.Vec<C3>::new(c.heap);
    i = 0;
    while i < t.caps.len {
        let e = t.caps.buf[i];
        let cert: u8 = 2;
        if c3_get(c.caps, e.h, e.t) == 1 && e.cert == 1 { cert = 1; }
        w2 = w2.push(C3 { h: e.h, t: e.t, cert: cert });
        i = i + 1;
    }
    i = 0;
    while i < c.caps.len {
        let e = c.caps.buf[i];
        let in_then: u8 = 0;
        let j: u64 = 0;
        while j < t.caps.len {
            if t.caps.buf[j].h == e.h && t.caps.buf[j].t == e.t {
                in_then = 1;
            }
            j = j + 1;
        }
        if in_then == 0 {
            w2 = w2.push(C3 { h: e.h, t: e.t, cert: 2 });
        }
        i = i + 1;
    }
    c.caps.destroy(); c.caps = w2;
    // cons: union keys; Cons iff both Cons; merged at-sites
    let w3 = vec.Vec<CF>::new(c.heap);
    i = 0;
    while i < t.cons.len {
        let f = t.cons.buf[i];
        let k = f.k;
        let bi = cf_get(c.cons, k);
        let st: u8 = 2;
        let bo: u32 = 0; let bl: u32 = NONE();
        if bi >= 0 {
            bo = c.cons.buf[u64(bi)].aoff;
            bl = c.cons.buf[u64(bi)].alen;
            if f.st == 1 && c.cons.buf[u64(bi)].st == 1 { st = 1; }
        }
        c = ats_merge(c, f.aoff, f.alen, bo, bl);
        let ao = c.res; let al = u32(c.res2);
        w3 = w3.push(CF { k: k, st: st, aoff: ao, alen: al });
        i = i + 1;
    }
    i = 0;
    while i < c.cons.len {
        let f = c.cons.buf[i];
        if cf_get(t.cons, f.k) < 0 {
            c = ats_merge(c, 0, NONE(), f.aoff, f.alen);
            let ao = c.res; let al = u32(c.res2);
            w3 = w3.push(CF { k: f.k, st: 2, aoff: ao, alen: al });
        }
        i = i + 1;
    }
    c.cons.destroy(); c.cons = w3;
    // init: union keys; Def iff init_covered on both
    let w4 = vec.Vec<MapE2>::new(c.heap);
    i = 0;
    while i < t.init.len {
        let k = t.init.buf[i].k;
        c = icov(c, t.init, k);
        let ca = c.res;
        c = icov_c(c, k);
        let cb = c.res;
        if ca == 1 && cb == 1 {
            w4 = w4.push(MapE2 { k: k, cert: 1 });
        } else { if ca != cb || ca == 1 || cb == 1 {
            w4 = w4.push(MapE2 { k: k, cert: 2 });
        } }
        i = i + 1;
    }
    i = 0;
    while i < c.init.len {
        let k = c.init.buf[i].k;
        let in_then: u8 = 0;
        let j: u64 = 0;
        while j < t.init.len {
            if t.init.buf[j].k == k { in_then = 1; }
            j = j + 1;
        }
        if in_then == 0 {
            c = icov(c, t.init, k);
            let ca = c.res;
            c = icov_c(c, k);
            let cb = c.res;
            if ca == 1 && cb == 1 {
                w4 = w4.push(MapE2 { k: k, cert: 1 });
            } else { if ca != cb || ca == 1 || cb == 1 {
                w4 = w4.push(MapE2 { k: k, cert: 2 });
            } }
        }
        i = i + 1;
    }
    c.init.destroy(); c.init = w4;
    // kills: union; Def iff both Def
    c = join_killmap(c, t.ekills, 0);
    c = join_killmap(c, t.ckills, 1);
    // provs: base = else (c); then keys join vs else|pre
    i = 0;
    while i < t.provs.len {
        let pv2 = t.provs.buf[i];
        let bi = pv_get(c.provs, pv2.k);
        let opk: u8 = 0; let opv: u32 = 0;
        let have: u8 = 0;
        if bi >= 0 {
            let o = c.provs.buf[u64(bi)];
            opk = o.pk; opv = o.pv; have = 1;
        } else {
            let pi = pv_get(pre.provs, pv2.k);
            if pi >= 0 {
                let o = pre.provs.buf[u64(pi)];
                opk = o.pk; opv = o.pv; have = 1;
            }
        }
        if have == 0 { opk = pv2.pk; opv = pv2.pv; }
        c = jprov(c, pv2.pk, pv2.pv, opk, opv);
        let pk2 = u8(c.res); let pv3 = c.res2;
        // upsert into c.provs
        if bi >= 0 {
            c.provs.buf[u64(bi)].pk = pk2;
            c.provs.buf[u64(bi)].pv = pv3;
        } else {
            c.provs = c.provs.push(
                PV { k: pv2.k, pk: pk2, pv: pv3 });
        }
        i = i + 1;
    }
    // scopes: merge_envs(then, else)
    c = merge_envs2(c, t);
    // defers/dres
    c = merge_dframes(c, t);
    let j2: u64 = 0;
    while j2 < t.dres.len {
        let dr = t.dres.buf[j2];
        let has: u8 = 0;
        let q: u64 = 0;
        while q < c.dres.len {
            if c.dres.buf[q].k == dr.k { has = 1; }
            q = q + 1;
        }
        if has == 0 { c.dres = c.dres.push(dr); }
        j2 = j2 + 1;
    }
    // transit union + chan max-len
    i = 0;
    while i < t.transit.len {
        if vhas(c.transit, t.transit.buf[i]) == 0 {
            c.transit = c.transit.push(t.transit.buf[i]);
        }
        i = i + 1;
    }
    i = 0;
    while i < t.chans.len {
        let ck2 = t.chans.buf[i].k;
        let tn = t.chans.buf[i].pkts.len;
        let j: u64 = 0;
        while j < c.chans.len {
            if c.chans.buf[j].k == ck2 {
                if tn > c.chans.buf[j].pkts.len {
                    let np = vec.Vec<Packet>::new(c.heap);
                    let q: u64 = 0;
                    while q < tn {
                        np = np.push(t.chans.buf[i].pkts.buf[q]);
                        q = q + 1;
                    }
                    c.chans.buf[j].pkts.destroy();
                    c.chans.buf[j].pkts = np;
                }
            }
            j = j + 1;
        }
        i = i + 1;
    }
    bs_free(t);
    return c;
}

/// join_cert_map of two maps into a fresh vec.
fn jkm(h: alloc, read t: vec.Vec<MapE2>,
       read m: vec.Vec<MapE2>) -> vec.Vec<MapE2> {
    let w = vec.Vec<MapE2>::new(h);
    let i: u64 = 0;
    while i < t.len {
        let k = t.buf[i].k;
        let cert: u8 = 2;
        if t.buf[i].cert == 1 && me_get(m, k) == 1 { cert = 1; }
        w = w.push(MapE2 { k: k, cert: cert });
        i = i + 1;
    }
    i = 0;
    while i < m.len {
        let k = m.buf[i].k;
        let in_t: u8 = 0;
        let j: u64 = 0;
        while j < t.len {
            if t.buf[j].k == k { in_t = 1; }
            j = j + 1;
        }
        if in_t == 0 { w = w.push(MapE2 { k: k, cert: 2 }); }
        i = i + 1;
    }
    return w;
}

/// join_cert_map into c.ekills (which=0) or c.ckills (which=1).
fn join_killmap(own c: Checker, read t: vec.Vec<MapE2>,
                which: u8) -> Checker {
    if which == 0 {
        let w = jkm(c.heap, t, c.ekills);
        c.ekills.destroy(); c.ekills = w;
    } else {
        let w = jkm(c.heap, t, c.ckills);
        c.ckills.destroy(); c.ckills = w;
    }
    return c;
}

/// merge_envs over a branch-state's scopes (a = then base).
fn merge_envs2(own c: Checker, read a: BS) -> Checker {
    return merge_envs_v(c, a.binds, a.bnames, a.scopes);
}

/// merge_defer_frames — frame-wise union, dedup by call span.
fn merge_dframes(own c: Checker, read t: BS) -> Checker {
    let n = c.defers.len;
    if t.defers.len > n { n = t.defers.len; }
    let w = vec.Vec<vec.Vec<DeferRec>>::new(c.heap);
    let i: u64 = 0;
    while i < n {
        let f = vec.Vec<DeferRec>::new(c.heap);
        if i < c.defers.len {
            let j: u64 = 0;
            while j < c.defers.buf[i].len {
                f = f.push(c.defers.buf[i].buf[j]);
                j = j + 1;
            }
        }
        if i < t.defers.len {
            let j: u64 = 0;
            while j < t.defers.buf[i].len {
                let r = t.defers.buf[i].buf[j];
                // dedup by eid's span
                let has: u8 = 0;
                let q: u64 = 0;
                while q < f.len {
                    if f.buf[q].eid == r.eid { has = 1; }
                    q = q + 1;
                }
                if has == 0 { f = f.push(r); }
                j = j + 1;
            }
        }
        w = w.push(f);
        i = i + 1;
    }
    i = 0;
    while i < c.defers.len { c.defers.buf[i].destroy(); i = i + 1; }
    c.defers.destroy(); c.defers = w;
    return c;
}

fn check_if(own c: Checker, read p: ast.Parser,
            s: ast.Stmt, ret: u32) -> Checker {
    c = expr_tv(c, p, s.a);
    let pre_dead = c.diverged;
    let pre_term = c.terminated;
    // u32s[b..] = [nt, then..., haselse, else...]
    let nt = p.u32s.buf[u64(s.b)];
    let r0 = bs_take(c);
    c = r0.c; let pre = r0.bs;
    c = check_block(c, p, s.b + 1, s.b + 1 + nt, 0, ret);
    let then_d = c.diverged;
    let then_t = c.terminated;
    let r1 = bs_take(c);
    c = r1.c; let then = r1.bs;
    // restore pre for the else walk; flags reset live/cont
    let r2 = bs_dup(c, pre);
    c = r2.c;
    c = bs_install(c, r2.bs);
    c.diverged = 0; c.terminated = 0;
    c = rec_flags(c);
    let has_else = p.u32s.buf[u64(s.b) + 1 + u64(nt)];
    if has_else == 1 {
        c = check_block(c, p, s.b + 2 + nt, s.b + s.c, 1, ret);
    }
    let else_d = c.diverged;
    let else_t = c.terminated;
    // statically-known arm? `if true`/`if false`
    let ce = p.exps.buf[u64(s.a)];
    let lit: u32 = NONE();
    if ek_num(ce.kind) == 1 { lit = ce.a; }
    if lit != NONE() {
        if lit == 1 {
            // install the then state wholesale
            bs_free(pre);
            c = bs_install(c, then);
            c.diverged = then_d;
            c.terminated = then_t;
            c = rec_flags(c);
        } else {
            // else (or pre when absent) is already installed
            bs_free(pre);
            bs_free(then);
        }
    } else {
        if then_d == 1 || else_d == 1 {
            // a diverged arm contributes nothing — survivor wholesale
            if then_d == 1 {
                // else is already live; but chans keep post-else
                bs_free(then);
            } else {
                c = bs_install_surv(c, then);
            }
            bs_free(pre);
        } else {
            c = if_merge(c, then, pre);
            c = rec_joined(c, p, s.line, s.col);
            bs_free(pre);
        }
        // flags: diverged only when BOTH live arms diverge
        c.diverged = pre_dead;
        if has_else == 1 && then_d == 1 && else_d == 1 {
            c.diverged = 1;
        }
        c.terminated = pre_term;
        if then_t == 1 && else_t == 1 { c.terminated = 1; }
        c = rec_flags(c);
    }
    return c;
}

/// lsnap_take — clone live channels into a LoopSnap.
fn lsnap_take(own c: Checker) -> LSC {
    let s = LSnap {
        edges: clone_e2(c.heap, c.edges),
        caps: clone_c3(c.heap, c.caps),
        cons: clone_cf(c.heap, c.cons),
        init: clone_me2(c.heap, c.init),
        ekills: clone_me2(c.heap, c.ekills),
        ckills: clone_me2(c.heap, c.ckills),
        provs: clone_pv(c.heap, c.provs),
        transit: clone_u(c.heap, c.transit),
        tag: clone_tg(c.heap, c.tag),
        chans: clone_cq(c.heap, c.chans),
        defers: clone_df(c.heap, c.defers),
        dres: clone_dr(c.heap, c.dres) };
    return LSC { c: c, s: s };
}
pub struct LSC { c: Checker, s: LSnap }

/// restore_snap — wholesale channel install (no scopes/flags).
fn lsnap_install(own c: Checker, own s: LSnap) -> Checker {
    c.edges.destroy(); c.edges = s.edges;
    c.caps.destroy(); c.caps = s.caps;
    c.cons.destroy(); c.cons = s.cons;
    c.init.destroy(); c.init = s.init;
    c.ekills.destroy(); c.ekills = s.ekills;
    c.ckills.destroy(); c.ckills = s.ckills;
    c.provs.destroy(); c.provs = s.provs;
    c.transit.destroy(); c.transit = s.transit;
    c.tag.destroy(); c.tag = s.tag;
    c.chans.destroy(); c.chans = s.chans;
    c.defers.destroy(); c.defers = s.defers;
    c.dres.destroy(); c.dres = s.dres;
    return c;
}

/// join_snap — ctx := join(ctx, s): both-Def rules, unions for
/// transit/chans, tag same-variant-else-None; `(joined)` snapshot.
fn join_snap2(own c: Checker, read p: ast.Parser,
                own s: LSnap) -> Checker {
    // edges: union; Def iff both Def && same kind; born current-first
    let w = vec.Vec<E2>::new(c.heap);
    let i: u64 = 0;
    while i < c.edges.len {
        let e = c.edges.buf[i];
        let cert: u8 = 2;
        let bi = e2_has(s.edges, e.h, e.t);
        if bi >= 0 {
            let o = s.edges.buf[u64(bi)];
            if o.cert == 1 && e.cert == 1 && o.kind == e.kind {
                cert = 1;
            }
        }
        w = w.push(E2 { h: e.h, t: e.t, kind: e.kind,
            cert: cert, bl: e.bl, bc: e.bc });
        i = i + 1;
    }
    i = 0;
    while i < s.edges.len {
        let e = s.edges.buf[i];
        if e2_has(c.edges, e.h, e.t) < 0 {
            w = w.push(E2 { h: e.h, t: e.t, kind: e.kind,
                cert: 2, bl: e.bl, bc: e.bc });
        }
        i = i + 1;
    }
    c.edges.destroy(); c.edges = w;
    // caps
    let w2 = vec.Vec<C3>::new(c.heap);
    i = 0;
    while i < c.caps.len {
        let e = c.caps.buf[i];
        let cert: u8 = 2;
        if c3_get(s.caps, e.h, e.t) == 1 && e.cert == 1 { cert = 1; }
        w2 = w2.push(C3 { h: e.h, t: e.t, cert: cert });
        i = i + 1;
    }
    i = 0;
    while i < s.caps.len {
        let e = s.caps.buf[i];
        let in_cur: u8 = 0;
        let j: u64 = 0;
        while j < c.caps.len {
            if c.caps.buf[j].h == e.h && c.caps.buf[j].t == e.t {
                in_cur = 1;
            }
            j = j + 1;
        }
        if in_cur == 0 {
            w2 = w2.push(C3 { h: e.h, t: e.t, cert: 2 });
        }
        i = i + 1;
    }
    c.caps.destroy(); c.caps = w2;
    // cons: union; Cons iff both Cons
    let w3 = vec.Vec<CF>::new(c.heap);
    i = 0;
    while i < c.cons.len {
        let f = c.cons.buf[i];
        let bi = cf_get(s.cons, f.k);
        let st: u8 = 2;
        let bo: u32 = 0; let bl: u32 = NONE();
        if bi >= 0 {
            bo = s.cons.buf[u64(bi)].aoff;
            bl = s.cons.buf[u64(bi)].alen;
            if f.st == 1 && s.cons.buf[u64(bi)].st == 1 { st = 1; }
        }
        c = ats_merge(c, f.aoff, f.alen, bo, bl);
        let ao = c.res; let al = u32(c.res2);
        w3 = w3.push(CF { k: f.k, st: st, aoff: ao, alen: al });
        i = i + 1;
    }
    i = 0;
    while i < s.cons.len {
        let f = s.cons.buf[i];
        if cf_get(c.cons, f.k) < 0 {
            c = ats_merge(c, 0, NONE(), f.aoff, f.alen);
            let ao = c.res; let al = u32(c.res2);
            w3 = w3.push(CF { k: f.k, st: 2, aoff: ao, alen: al });
        }
        i = i + 1;
    }
    c.cons.destroy(); c.cons = w3;
    // init: union keys; Def iff init_covered on both
    let w4 = vec.Vec<MapE2>::new(c.heap);
    i = 0;
    while i < c.init.len {
        let k = c.init.buf[i].k;
        c = icov_c(c, k);
        let ca = c.res;
        c = icov(c, s.init, k);
        let cb = c.res;
        if ca == 1 && cb == 1 {
            w4 = w4.push(MapE2 { k: k, cert: 1 });
        } else { if ca != cb || ca == 1 || cb == 1 {
            w4 = w4.push(MapE2 { k: k, cert: 2 });
        } }
        i = i + 1;
    }
    i = 0;
    while i < s.init.len {
        let k = s.init.buf[i].k;
        let in_cur: u8 = 0;
        let j: u64 = 0;
        while j < c.init.len {
            if c.init.buf[j].k == k { in_cur = 1; }
            j = j + 1;
        }
        if in_cur == 0 {
            c = icov_c(c, k);
            let ca = c.res;
            c = icov(c, s.init, k);
            let cb = c.res;
            if ca == 1 && cb == 1 {
                w4 = w4.push(MapE2 { k: k, cert: 1 });
            } else { if ca != cb || ca == 1 || cb == 1 {
                w4 = w4.push(MapE2 { k: k, cert: 2 });
            } }
        }
        i = i + 1;
    }
    c.init.destroy(); c.init = w4;
    // kills: join_cert_map (current, snap)
    let wk = jkm(c.heap, c.ekills, s.ekills);
    c.ekills.destroy(); c.ekills = wk;
    let wk2 = jkm(c.heap, c.ckills, s.ckills);
    c.ckills.destroy(); c.ckills = wk2;
    // provs: base = snap's; current keys join vs snap
    let wp = clone_pv(c.heap, s.provs);
    i = 0;
    while i < c.provs.len {
        let pv2 = c.provs.buf[i];
        let bi = pv_get(s.provs, pv2.k);
        let opk = pv2.pk; let opv = pv2.pv;
        if bi >= 0 {
            opk = s.provs.buf[u64(bi)].pk;
            opv = s.provs.buf[u64(bi)].pv;
        }
        c = jprov(c, pv2.pk, pv2.pv, opk, opv);
        let pk2 = u8(c.res); let pv3 = c.res2;
        // upsert into wp (snap base)
        let has: i64 = pv_get(wp, pv2.k);
        if has >= 0 {
            wp.buf[u64(has)].pk = pk2;
            wp.buf[u64(has)].pv = pv3;
        } else {
            wp = wp.push(PV { k: pv2.k, pk: pk2, pv: pv3 });
        }
        i = i + 1;
    }
    c.provs.destroy(); c.provs = wp;
    // transit union
    i = 0;
    while i < s.transit.len {
        if vhas(c.transit, s.transit.buf[i]) == 0 {
            c.transit = c.transit.push(s.transit.buf[i]);
        }
        i = i + 1;
    }
    // chans: per-key max len
    i = 0;
    while i < s.chans.len {
        let ck2 = s.chans.buf[i].k;
        let sn = s.chans.buf[i].pkts.len;
        let j: u64 = 0;
        let seen: u8 = 0;
        while j < c.chans.len {
            if c.chans.buf[j].k == ck2 {
                seen = 1;
                if sn > c.chans.buf[j].pkts.len {
                    let np = vec.Vec<Packet>::new(c.heap);
                    let q: u64 = 0;
                    while q < sn {
                        np = np.push(s.chans.buf[i].pkts.buf[q]);
                        q = q + 1;
                    }
                    c.chans.buf[j].pkts.destroy();
                    c.chans.buf[j].pkts = np;
                }
            }
            j = j + 1;
        }
        if seen == 0 {
            let np = vec.Vec<Packet>::new(c.heap);
            let q: u64 = 0;
            while q < sn {
                np = np.push(s.chans.buf[i].pkts.buf[q]);
                q = q + 1;
            }
            c.chans = c.chans.push(CQ { k: ck2, pkts: np });
        }
        i = i + 1;
    }
    // tag: union keys; same definite variant survives, else None
    i = 0;
    while i < s.tag.len {
        let tk = s.tag.buf[i].k;
        let sv = s.tag.buf[i].v;
        let has: i64 = 0 - 1;
        let j: u64 = 0;
        while j < c.tag.len {
            if c.tag.buf[j].k == tk { has = i64(j); }
            j = j + 1;
        }
        if has < 0 {
            // key only on the other path -> known-enum unknown-variant
            c.tag = c.tag.push(TG { k: tk, v: NONE(), has: 1 });
        } else {
            let cv = c.tag.buf[u64(has)].v;
            let same: u8 = 0;
            if cv != NONE() && sv != NONE() && cv == sv { same = 1; }
            if same == 0 {
                c.tag.buf[u64(has)].v = NONE();
                c.tag.buf[u64(has)].has = 1;
            }
        }
        i = i + 1;
    }
    i = 0;
    while i < c.tag.len {
        let tk = c.tag.buf[i].k;
        let in_s: u8 = 0;
        let j: u64 = 0;
        while j < s.tag.len {
            if s.tag.buf[j].k == tk { in_s = 1; }
            j = j + 1;
        }
        if in_s == 0 {
            c.tag.buf[i].v = NONE();
            c.tag.buf[i].has = 1;
        }
        i = i + 1;
    }
    // defers/dres union-merge
    let n = c.defers.len;
    if s.defers.len > n { n = s.defers.len; }
    let w5 = vec.Vec<vec.Vec<DeferRec>>::new(c.heap);
    i = 0;
    while i < n {
        let f = vec.Vec<DeferRec>::new(c.heap);
        if i < c.defers.len {
            let j: u64 = 0;
            while j < c.defers.buf[i].len {
                f = f.push(c.defers.buf[i].buf[j]);
                j = j + 1;
            }
        }
        if i < s.defers.len {
            let j: u64 = 0;
            while j < s.defers.buf[i].len {
                let r = s.defers.buf[i].buf[j];
                let has: u8 = 0;
                let q: u64 = 0;
                while q < f.len {
                    if f.buf[q].eid == r.eid { has = 1; }
                    q = q + 1;
                }
                if has == 0 { f = f.push(r); }
                j = j + 1;
            }
        }
        w5 = w5.push(f);
        i = i + 1;
    }
    i = 0;
    while i < c.defers.len { c.defers.buf[i].destroy(); i = i + 1; }
    c.defers.destroy(); c.defers = w5;
    i = 0;
    while i < s.dres.len {
        let dr = s.dres.buf[i];
        let has: u8 = 0;
        let q: u64 = 0;
        while q < c.dres.len {
            if c.dres.buf[q].k == dr.k { has = 1; }
            q = q + 1;
        }
        if has == 0 { c.dres = c.dres.push(dr); }
        i = i + 1;
    }
    lsnap_destroy(s);
    c = rec_joined(c, p, NONE(), NONE());
    return c;
}

/// merge_envs over explicit scope vecs (a = out base, c = other).
fn merge_envs_v(own c: Checker, read ab: vec.Vec<CBind>,
                read abn: vec.Vec<KK>,
                read asc: vec.Vec<u32>) -> Checker {
    let bn = vec.Vec<KK>::new(c.heap);
    let sc = vec.Vec<u32>::new(c.heap);
    let nb = clone_cb(c.heap, ab);
    let lv: u64 = 0;
    while lv < asc.len {
        let ao = u64(asc.buf[lv]);
        let ae = abn.len;
        if lv + 1 < asc.len {
            ae = u64(asc.buf[lv + 1]);
        }
        sc = sc.push(u32(bn.len));
        let j: u64 = ao;
        while j < ae {
            let nm = abn.buf[j];
            let bind = nb.buf[u64(nm.v)];
            let skip: u8 = 0;
            if bind.prov_k == 2 && bind.prov_v >= u32(c.regs.len) {
                skip = 1;
            }
            if skip == 0 {
                let found: i64 = 0 - 1;
                if lv < c.scopes.len {
                    let co = u64(c.scopes.buf[lv]);
                    let ce = c.bnames.len;
                    if lv + 1 < c.scopes.len {
                        ce = u64(c.scopes.buf[lv + 1]);
                    }
                    let q = ce;
                    while q > co {
                        q = q - 1;
                        if c.bnames.buf[q].k == nm.k {
                            found = i64(q); break;
                        }
                    }
                }
                if found < 0 {
                    j = j + 1; continue;
                }
                let ob = c.binds.buf[
                    u64(c.bnames.buf[u64(found)].v)];
                c = jprov(c, bind.prov_k, bind.prov_v,
                          ob.prov_k, ob.prov_v);
                nb.buf[u64(nm.v)].prov_k = u8(c.res);
                nb.buf[u64(nm.v)].prov_v = c.res2;
                if ob.owner > bind.owner {
                    nb.buf[u64(nm.v)].owner = ob.owner;
                }
            }
            bn = bn.push(KK { k: nm.k, v: nm.v });
            j = j + 1;
        }
        lv = lv + 1;
    }
    c.binds.destroy(); c.binds = nb;
    c.bnames.destroy(); c.bnames = bn;
    c.scopes.destroy(); c.scopes = sc;
    return c;
}

/// Stmt::While — cond, body, loop-exit join per exit snapshot.
fn check_while(own c: Checker, read p: ast.Parser,
               s: ast.Stmt, ret: u32) -> Checker {
    c = es(c, "(while @");
    c = eu(c, u64(s.line));
    c = ec(c, u8(58));
    c = eu(c, u64(s.col));
    c = ec(c, u8(41));
    c = rec(c);
    c = expr_tv(c, p, s.a);
    let pre_dead = c.diverged;
    let pre_term = c.terminated;
    let sb = clone_cb(c.heap, c.binds);
    let sbn = clone_kk(c.heap, c.bnames);
    let ssc = clone_u(c.heap, c.scopes);
    let r0 = lsnap_take(c);
    c = r0.c; let pre = r0.s;
    c.loops = c.loops.push(LoopCtx {
        depth: u32(c.scopes.len),
        breaks: vec.Vec<LSnap>::new(c.heap),
        conts: vec.Vec<LSnap>::new(c.heap) });
    c = check_block(c, p, s.b, s.b + s.c, 0, ret);
    let lc = c.loops.pop();
    let body_d = c.diverged;
    let body_t = c.terminated;
    // body scopes <-> saved scopes
    let bb = clone_cb(c.heap, c.binds);
    let bbn = clone_kk(c.heap, c.bnames);
    let bsc = clone_u(c.heap, c.scopes);
    c.binds.destroy(); c.binds = sb;
    c.bnames.destroy(); c.bnames = sbn;
    c.scopes.destroy(); c.scopes = ssc;
    let r1 = lsnap_take(c);
    c = r1.c; let body_snap = r1.s;
    // exit list: breaks, conts (!is_true), fall-through (!d).
    // `exits` is built REVERSED so pop_own yields forward order.
    let ce = p.exps.buf[u64(s.a)];
    let is_true: u8 = 0;
    if ek_num(ce.kind) == 1 && ce.a == 1 { is_true = 1; }
    let exits = vec.Vec<LSnap>::new(c.heap);
    if is_true == 0 {
        if body_d == 0 { exits = exits.push(body_snap); }
        else { lsnap_destroy(body_snap); }
        while lc.conts.len > 0 {
            let pp = lc.conts.pop_own();
            lc.conts = pp.v;
            exits = exits.push(pp.x);
        }
        while lc.breaks.len > 0 {
            let pp = lc.breaks.pop_own();
            lc.breaks = pp.v;
            exits = exits.push(pp.x);
        }
    } else {
        lsnap_destroy(body_snap);
        while lc.conts.len > 0 {
            let pp = lc.conts.pop_own();
            lc.conts = pp.v;
            lsnap_destroy(pp.x);
        }
        while lc.breaks.len > 0 {
            let pp = lc.breaks.pop_own();
            lc.breaks = pp.v;
            exits = exits.push(pp.x);
        }
    }
    let no_out: u8 = 0;
    if exits.len == 0 { no_out = 1; }
    if is_true == 1 && no_out == 0 {
        let pp = exits.pop_own();
        exits = pp.v;
        c = lsnap_install(c, pp.x);
        lsnap_destroy(pre);
    } else {
        c = lsnap_install(c, pre);
    }
    while exits.len > 0 {
        let pp = exits.pop_own();
        exits = pp.v;
        c = join_snap2(c, p, pp.x);
    }
    exits.destroy();
    if is_true == 1 && no_out == 1 {
        c.diverged = 1;
        c.terminated = body_t;
        c = rec_flags(c);
    } else {
        c.diverged = pre_dead;
        c.terminated = pre_term;
        c = rec_flags(c);
    }
    lc.breaks.destroy(); lc.conts.destroy();
    c = merge_envs_v(c, bb, bbn, bsc);
    bb.destroy(); bbn.destroy(); bsc.destroy();
    return c;
}

fn check_brk(own c: Checker, read p: ast.Parser,
             s: ast.Stmt, ret: u32) -> Checker {
    c.diverged = 1;
    c = rec_flags(c);
    return c;
}

fn check_match(own c: Checker, read p: ast.Parser,
               s: ast.Stmt, ret: u32) -> Checker {
    c = es(c, "(match @");
    c = eu(c, u64(s.line));
    c = ec(c, u8(58));
    c = eu(c, u64(s.col));
    c = ec(c, u8(41));
    c = rec(c);
    c = expr_tv(c, p, s.a);
    // v1: check each arm's body independently against pre-state —
    // arm joins port with match-arm authority.
    let i: u64 = u64(s.b);
    while i < u64(s.c) {
        let arm = p.arms.buf[i];
        c = check_block(c, p, arm.off,
            arm.off + arm.len, 0, ret);
        i = i + 1;
    }
    return c;
}

fn check_region(own c: Checker, read p: ast.Parser,
                s: ast.Stmt, ret: u32) -> Checker {
    c.r = resolve.intern_pname(c.r, p, s.a);
    let n = c.r.res;
    c.regs = c.regs.push(RegF { name: n, parent: cur_region(c) });
    // (region "n" "parent" @L:C) — parent is the ENCLOSING frame name
    c = es(c, "(region ");
    c = eqs_r(c, &c.r.rbyt.buf[u64(c.r.rns.buf[u64(n)].off)..
        u64(c.r.rns.buf[u64(n)].off) + u64(c.r.rns.buf[u64(n)].len)]);
    c = ec(c, u8(32));
    let pr = c.regs.buf[u64(cur_region(c))].parent;
    if pr != NONE() {
        let pn = c.regs.buf[u64(pr)].name;
        let sp = c.r.rns.buf[u64(pn)];
        c = eqs_r(c, &c.r.rbyt.buf[u64(sp.off)..
            u64(sp.off) + u64(sp.len)]);
    } else { c = es(c, "?"); }
    c = es(c, " @");
    c = eu(c, u64(s.line));
    c = ec(c, u8(58));
    c = eu(c, u64(s.col));
    c = rec(c);
    c = check_block(c, p, s.b, s.b + s.c, 0, ret);
    c = es(c, "(region-pop ");
    c = eqs_r(c, &c.r.rbyt.buf[u64(c.r.rns.buf[u64(n)].off)..
        u64(c.r.rns.buf[u64(n)].off) + u64(c.r.rns.buf[u64(n)].len)]);
    c = ec(c, u8(41));
    c = rec(c);
    c.regs.pop();
    return c;
}

fn check_promote(own c: Checker, read p: ast.Parser,
                 s: ast.Stmt, ret: u32) -> Checker {
    // promote moves the binding's owner one region out; every alias
    // edge held inside x's subtree must target a place that outlives
    // the destination (edge closure, not a graph walk).
    let e = p.exps.buf[u64(s.a)];
    if ek_num(e.kind) != 2 {
        let m = vec.Vec<u8>::new(c.heap);
        let m2 = resolve.bputs(m, "promote requires a variable");
        c = pdiag(c, s.line, s.col, m2.as_slice());
        m2.destroy();
        return c;
    }
    c.r = resolve.intern_pname(c.r, p, e.a);
    let n = c.r.res;
    let bi = bfind(c, n);
    if i64(bi) < 0 {
        let m = vec.Vec<u8>::new(c.heap);
        let m2 = resolve.bputs(m, "undefined variable `");
        let m3 = push_rname(m2, c, n);
        let m4 = m3.push(u8(96));
        c = pdiag(c, s.line, s.col, m4.as_slice());
        m4.destroy();
        return c;
    }
    let b = c.binds.buf[u64(bi)];
    let pr = c.regs.buf[u64(b.owner)].parent;
    if pr == NONE() {
        let m = vec.Vec<u8>::new(c.heap);
        let m2 = resolve.bputs(m, "cannot promote `");
        let m3 = push_rname(m2, c, n);
        let m4 = resolve.bputs(m3, "` out of the function frame");
        c = pdiag(c, s.line, s.col, m4.as_slice());
        m4.destroy();
        return c;
    }
    let dest = pr;
    c = key_of(c, n, b.epoch);
    let key = c.res;
    let dl = defer_conflict(c, key);
    if dl != NONE() {
        let m = vec.Vec<u8>::new(c.heap);
        let m2 = resolve.bputs(m, "cannot promote `");
        let m3 = push_rname(m2, c, n);
        let m4 = resolve.bputs(m3,
            "`: it is reserved by the `defer` at line ");
        let m5 = loader.bpush_u64(m4, u64(dl));
        c = pdiag(c, s.line, s.col, m5.as_slice());
        m5.destroy();
        return c;
    }
    let i: u64 = 0;
    while i < c.edges.len {
        let eg = c.edges.buf[i];
        // under_x = h == key || h under `key.`/`key[`; internal edges
        // (target rooted at key) move with the value.
        if kroot_eq(c, key, eg.h) == 1
            && kroot_eq(c, key, eg.t) == 0 {
            let tsp = c.kns.buf[u64(eg.t)];
            let rend: u64 = 0;
            while rend < u64(tsp.len) {
                let x = c.kbyt.buf[u64(tsp.off) + rend];
                if x == u8(46) || x == u8(91) { break; }
                rend = rend + 1;
            }
            let nend: u64 = 0;
            while nend < rend {
                if c.kbyt.buf[u64(tsp.off) + nend] == u8(35) { break; }
                nend = nend + 1;
            }
            let tnid = rns_find_kbytes(c, u64(tsp.off), nend);
            let towner = NONE();
            if tnid != NONE() {
                let bj = bfind(c, tnid);
                if i64(bj) >= 0 {
                    let bb = c.binds.buf[u64(bj)];
                    c = key_of(c, tnid, bb.epoch);
                    if kroot_eq(c, c.res, eg.t) == 1 {
                        towner = bb.owner;
                    }
                }
            }
            if towner != NONE()
                && outlives(c, 2, towner, 2, dest) == 0 {
                let m = vec.Vec<u8>::new(c.heap);
                let m2 = resolve.bputs(m,
                    "dangling edge after promote: `");
                let m3 = push_rname(m2, c, n);
                let m4 = resolve.bputs(m3,
                    "` holds a reference to `");
                let m5 = push_rname(m4, c, tnid);
                let m6 = resolve.bputs(m5,
                    "`, which dies in region `");
                let m7 = push_rname(m6, c,
                    c.regs.buf[u64(towner)].name);
                let m8 = m7.push(u8(96));
                c = pdiag(c, s.line, s.col, m8.as_slice());
                m8.destroy();
            }
        }
        i = i + 1;
    }
    // identity edges out of x never block — a stale handle is a
    // use-site error, not a promote error.
    c.binds.buf[u64(bi)].owner = dest;
    return c;
}

fn check_consume(own c: Checker, read p: ast.Parser,
                 s: ast.Stmt, ret: u32) -> Checker {
    // `consume p` — the standalone affine transfer (same law as an
    // `own` call arg, minus the call).
    return consume_place(c, p, s.a);
}

fn check_defer(own c: Checker, read p: ast.Parser,
               s: ast.Stmt, ret: u32) -> Checker {
    c = es(c, "(defer @");
    c = eu(c, u64(s.line));
    c = ec(c, u8(58));
    c = eu(c, u64(s.col));
    c = ec(c, u8(41));
    c = rec(c);
    // operand place keys + consume keys — v1: collect resolve_place
    // of the call args; dry-run suppressed for now.
    let ooff = u32(c.df_keys.len);
    let e = p.exps.buf[u64(s.a)];
    let olen: u32 = 0;
    if ek_num(e.kind) == 6 {
        let nt = u64(p.u32s.buf[u64(e.b)]);
        let na = p.u32s.buf[u64(e.b) + 1 + nt];
        let i: u64 = 0;
        while i < u64(na) {
            let a = p.u32s.buf[u64(e.b) + 2 + nt + i];
            c = resolve_place(c, p, a);
            let j: u64 = 0;
            while j < u64(c.res4) {
                c.df_keys = c.df_keys.push(c.pstash.buf[j]);
                j = j + 1;
            }
            i = i + 1;
        }
        olen = u32(c.df_keys.len) - ooff;
    }
    let frame = c.defers.buf[u64(c.defers.len - 1)];
    let f2 = frame.push(DeferRec {
        eid: s.a, ooff: ooff, olen: olen,
        coff: u32(c.df_keys.len), clen: 0 });
    c.defers.buf[u64(c.defers.len - 1)] = f2;
    // register reservations — emit (dres k @L:C)
    let i: u64 = u64(ooff);
    while i < u64(ooff) + u64(olen) {
        c = dres_set(c, c.df_keys.buf[i], s.line, s.col);
        i = i + 1;
    }
    return c;
}

/// check_block — `(scope)` … stmt list … `(pop)`.
fn check_block(own c: Checker, read p: ast.Parser,
               b: u32, e_: u32, has: u8, ret: u32) -> Checker {
    c = push_scope(c);
    // b..e when has==0 is a u32s range [stmts]; when has==1 it's the
    // else-half: p.u32s[b-?] — callers pass the sub-range indices
    // directly (b/e are u32s positions).
    let pending = vec.Vec<u32>::new(c.heap);
    let i: u64 = u64(b);
    let last_l: u32 = 0; let last_c: u32 = 0; let has_last: u8 = 0;
    while i < u64(e_) {
        let sid = p.u32s.buf[i];
        let st = p.stmts.buf[u64(sid)];
        if c.terminated == 1 { break; }
        c = lower_s(c, p, sid, ret, 1);
        c = check_stmt(c, p, sid, ret);
        while c.rv_new.len > 0 {
            let rvn = c.rv_new.pop();
            c = kill_temp(c, rvn);
        }
        last_l = st.line; last_c = st.col; has_last = 1;
        if sk_num(st.kind) == 0 {
            c.r = resolve.intern_pname(c.r, p, st.a);
            if n_is_rv(c, c.r.res) == 1 {
                pending = pending.push(c.r.res);
                i = i + 1;
                continue;
            }
        }
        while pending.len > 0 {
            let pn = pending.pop();
            c = kill_temp(c, pn);
        }
        i = i + 1;
    }
    pending.destroy();
    c = pop_scope_defers(c, p);
    let cp = pop_scope_names(c);
    c = cp.c;
    c = expire_scope(c, cp.popped, last_l, last_c, has_last,
        "the enclosing scope ends");
    c = es(c, "(pop)");
    c = rec(c);
    return c;
}

// ---- functions --------------------------------------------------------------

/// per-fn state reset — every channel a Ctx::new would zero.
fn ctx_reset(own c: Checker) -> Checker {
    while c.binds.len > 0 { c.binds.pop(); }
    while c.bnames.len > 0 { c.bnames.pop(); }
    while c.scopes.len > 0 { c.scopes.pop(); }
    while c.regs.len > 0 { c.regs.pop(); }
    while c.edges.len > 0 { c.edges.pop(); }
    while c.caps.len > 0 { c.caps.pop(); }
    while c.cons.len > 0 { c.cons.pop(); }
    while c.init.len > 0 { c.init.pop(); }
    while c.tag.len > 0 { c.tag.pop(); }
    while c.provs.len > 0 { c.provs.pop(); }
    while c.ekills.len > 0 { c.ekills.pop(); }
    while c.ckills.len > 0 { c.ckills.pop(); }
    while c.holds.len > 0 { c.holds.pop(); }
    while c.transit.len > 0 { c.transit.pop(); }
    while c.doms.len > 0 { c.doms.pop(); }
    while c.slens.len > 0 { c.slens.pop(); }
    while c.csafe.len > 0 { c.csafe.pop(); }
    while c.foreign.len > 0 { c.foreign.pop(); }
    while c.abandoned.len > 0 { c.abandoned.pop(); }
    while c.iw.len > 0 { c.iw.pop(); }
    while c.arg_atomic.len > 0 { c.arg_atomic.pop(); }
    while c.arg_mutex.len > 0 { c.arg_mutex.pop(); }
    while c.arg_chan.len > 0 { c.arg_chan.pop(); }
    while c.ret_edges.len > 0 { c.ret_edges.pop(); }
    while c.ret_caps.len > 0 { c.ret_caps.pop(); }
    while c.ret_lit_edges.len > 0 { c.ret_lit_edges.pop(); }
    while c.ret_lit_caps.len > 0 { c.ret_lit_caps.pop(); }
    while c.ret_lit_provs.len > 0 { c.ret_lit_provs.pop(); }
    while c.tasks.len > 0 { c.tasks.pop(); }
    while c.teffs.len > 0 { c.teffs.pop(); }
    while c.tk_holds.len > 0 { c.tk_holds.pop(); }
    while c.te_edges.len > 0 { c.te_edges.pop(); }
    while c.te_kills.len > 0 { c.te_kills.pop(); }
    while c.te_ccaps.len > 0 { c.te_ccaps.pop(); }
    while c.te_ckills.len > 0 { c.te_ckills.pop(); }
    while c.te_cons.len > 0 { c.te_cons.pop(); }
    while c.te_provs.len > 0 { c.te_provs.pop(); }
    while c.te_re.len > 0 { c.te_re.pop(); }
    while c.te_rc.len > 0 { c.te_rc.pop(); }
    while c.chans.len > 0 { c.chans.pop(); }
    while c.pkt_stash.len > 0 { c.pkt_stash.pop(); }
    while c.rv_new.len > 0 { c.rv_new.pop(); }
    while c.refresh.len > 0 { c.refresh.pop(); }
    while c.mylens.len > 0 { c.mylens.pop(); }
    while c.defers.len > 0 { c.defers.pop().destroy(); }
    while c.df_keys.len > 0 { c.df_keys.pop(); }
    while c.dres.len > 0 { c.dres.pop(); }
    while c.loops.len > 0 { c.loops.pop(); }
    while c.glocks.len > 0 { c.glocks.pop(); }
    while c.task_ext.len > 0 { c.task_ext.pop(); }
    c.has_lit = 0; c.has_tag = 0; c.has_lock = 0;
    c.has_mutex = 0; c.has_recv = 0; c.has_spawn = 0;
    c.lrefs_has = 0; c.lcaps_has = 0; c.llen_has = 0;
    c.task_ret = NONE();
    c.sp_line = 0; c.sp_col = 0; c.sp_hoff = 0; c.sp_hlen = 0;
    c.diverged = 0; c.terminated = 0;
    c.next_epoch = 0;
    return c;
}

/// `$arg{i}` key.
fn arg_key(own c: Checker, i: u64) -> Checker {
    c.ksc = c.ksc.push(u8(36));
    c.ksc = c.ksc.push(u8(97));
    c.ksc = c.ksc.push(u8(114));
    c.ksc = c.ksc.push(u8(103));
    c.ksc = loader.bpush_u64(c.ksc, i);
    let n = u64(c.ksc.len);
    c = kin(c, &c.ksc.buf[0..n]);
    while c.ksc.len > 0 { c.ksc.pop(); }
    return c;
}

/// check_fn — params, body, summary. `fd` = fdecl idx; `p` = its parser.
fn check_fn(own c: Checker, read p: ast.Parser, fd: u32) -> Checker {
    c = ctx_reset(c);
    let f = c.r.fdecls.buf[u64(fd)];
    let fdef = p.fns.buf[u64(f.idx)];
    c.fn_ret = f.ret;
    c.regs = c.regs.push(RegF { name: f.name, parent: NONE() });
    c.scopes = c.scopes.push(u32(0));
    c.defers = c.defers.push(vec.Vec<DeferRec>::new(c.heap));
    // (fn "name" @L:C
    c = es(c, "(fn ");
    let sp = c.r.rns.buf[u64(f.name)];
    c = eqs_r(c, &c.r.rbyt.buf[u64(sp.off)..
        u64(sp.off) + u64(sp.len)]);
    c = es(c, " @");
    c = eu(c, u64(f.line));
    c = ec(c, u8(58));
    c = eu(c, u64(f.col));
    c = rec(c);
    // params
    let i: u64 = 0;
    while i < u64(f.ps_len) {
        let pr = c.r.params.buf[u64(f.ps_off) + i];
        let pt = c.r.rtys.buf[u64(pr.ty)];
        let pk: u8 = 0;
        if pt.kind == 15 || pt.kind == 18 || pt.kind == 17
            || pt.kind == 10 || pr.auth != 0 {
            pk = 1;
        }
        c.next_epoch = c.next_epoch + 1;
        let epoch = c.next_epoch;
        c = key_of(c, pr.name, epoch);
        let key = c.res;
        c = init_set(c, key, 1);
        c = arg_key(c, i);
        let ak = c.res;
        c = init_set(c, ak, 1);
        if pr.auth != 0 {
            c = edge_set0(c, key, ak, pr.auth, 1, 0, 0, 0);
        } else { if pt.kind == 18 {
            c = cap_set(c, key, ak, 1);
        } else { if pt.kind == 15 || pt.kind == 17 {
            let kd: u8 = 1;
            if pt.b != 0 { kd = 2; }
            c = edge_set0(c, key, ak, kd, 1, 0, 0, 0);
        } else { if pt.kind == 10 {
            c = edge_set0(c, key, ak, 1, 1, 0, 0, 0);
        } } } }
        // atomic/mutex/chan param storage registration
        let mut_el: u32 = NONE();
        if pt.kind == 20 { mut_el = pt.a; }
        else { if pt.kind == 15 || pt.kind == 17 {
            let ee = c.r.rtys.buf[u64(pt.a)];
            if ee.kind == 20 { mut_el = ee.a; }
        } }
        if mut_el != NONE() {
            c.arg_atomic = c.arg_atomic.push(KK { k: ak, v: mut_el });
        }
        let mx: u32 = NONE();
        if pt.kind == 21 { mx = pt.a; }
        else { if pt.kind == 15 || pt.kind == 18 {
            let ee = c.r.rtys.buf[u64(pt.a)];
            if ee.kind == 21 { mx = ee.a; }
        } }
        if mx != NONE() {
            c.arg_mutex = c.arg_mutex.push(KK { k: ak, v: mx });
            c = dom_set(c, ak, ak);
        }
        let chn: u32 = NONE();
        if pt.kind == 23 { chn = pt.a; }
        else { if pt.kind == 15 || pt.kind == 18 {
            let ee = c.r.rtys.buf[u64(pt.a)];
            if ee.kind == 23 { chn = ee.a; }
        } }
        if chn != NONE() {
            c.arg_chan = c.arg_chan.push(KK { k: ak, v: chn });
        }
        // (param key @L:C "ty" prov auth)
        c = es(c, "(param ");
        c = eqs(c, key);
        c = es(c, " @");
        c = eu(c, u64(f.line));
        c = ec(c, u8(58));
        c = eu(c, u64(f.col));
        c = ec(c, u8(32));
        c = ec(c, u8(34));
        c = e_ty(c, pr.ty);
        c = ec(c, u8(34));
        c = ec(c, u8(32));
        c = eprov(c, pk, 0);
        c = ec(c, u8(32));
        if pr.auth == 0 { c = es(c, "-"); }
        else { c = eauth(c, pr.auth); }
        c = es(c, ")");
        c = rec(c);
        c.binds = c.binds.push(CBind {
            n: pr.name, epoch: epoch, ty: pr.ty,
            prov_k: pk, prov_v: 0,
            owner: 0, auth: pr.auth,
            line: f.line, col: f.col,
            guard_dom: NONE(), guard_root: NONE(),
            goff: 0, glen: 0 });
        c.bnames = c.bnames.push(KK {
            k: pr.name, v: u32(c.binds.len) - 1 });
        i = i + 1;
    }
    // body — u32s[body_off..body_off+body_len] stmt ids
    c = check_block(c, p, fdef.body_off,
        fdef.body_off + fdef.body_len, 0, f.ret);
    // summary — $arg-rooted facts in callee vocabulary
    c = fn_summary(c, f, fd);
    return c;
}

/// is key `$argN` / `$argN.*` rooted?
fn is_arg(read c: Checker, k: u32) -> u8 {
    return k_starts_arg(c, k);
}

/// key rooted at `$arg{i}`? (own-param filter)
fn arg_rooted(read c: Checker, k: u32, arg: u32) -> u8 {
    return kprefix(c, arg, k);
}

/// build + emit the fn summary; install in fsums unless cyclic.
fn fn_summary(own c: Checker, f: resolve.FDecl, fd: u32) -> Checker {
    // own-param arg keys
    let owns = vec.Vec<u32>::new(c.heap);
    let i: u64 = 0;
    while i < u64(f.ps_len) {
        let pr = c.r.params.buf[u64(f.ps_off) + i];
        if pr.auth == 3 {
            c = arg_key(c, i);
            owns = owns.push(c.res);
        }
        i = i + 1;
    }
    let se0 = u32(c.sm_edges.len);
    i = 0;
    while i < c.edges.len {
        let e = c.edges.buf[i];
        if is_arg(c, e.h) == 1 && is_arg(c, e.t) == 1
            && arg_in(c, owns, e.h) == 0 && arg_in(c, owns, e.t) == 0 {
            c.sm_edges = c.sm_edges.push(e);
        }
        i = i + 1;
    }
    let se1 = u32(c.sm_edges.len);
    let sk0 = u32(c.sm_kills.len);
    i = 0;
    while i < c.ekills.len {
        let k = c.ekills.buf[i];
        if is_arg(c, k.k) == 1 && arg_in(c, owns, k.k) == 0 {
            c.sm_kills = c.sm_kills.push(k);
        }
        i = i + 1;
    }
    let sk1 = u32(c.sm_kills.len);
    let sc0 = u32(c.sm_ccaps.len);
    i = 0;
    while i < c.caps.len {
        let e = c.caps.buf[i];
        if is_arg(c, e.h) == 1 && is_arg(c, e.t) == 1
            && arg_in(c, owns, e.h) == 0 && arg_in(c, owns, e.t) == 0 {
            c.sm_ccaps = c.sm_ccaps.push(e);
        }
        i = i + 1;
    }
    let sc1 = u32(c.sm_ccaps.len);
    let sck0 = u32(c.sm_ckills.len);
    i = 0;
    while i < c.ckills.len {
        let k = c.ckills.buf[i];
        if is_arg(c, k.k) == 1 && arg_in(c, owns, k.k) == 0 {
            c.sm_ckills = c.sm_ckills.push(k);
        }
        i = i + 1;
    }
    let sck1 = u32(c.sm_ckills.len);
    let si0 = u32(c.sm_keys.len);
    i = 0;
    while i < c.iw.len {
        let k = c.iw.buf[i];
        if arg_in(c, owns, k) == 0 && init_get(c, k) == 1 {
            c.sm_keys = c.sm_keys.push(k);
        }
        i = i + 1;
    }
    let si1 = u32(c.sm_keys.len);
    let re0 = u32(c.sm_re.len);
    i = 0;
    while i < c.ret_edges.len {
        c.sm_re = c.sm_re.push(c.ret_edges.buf[i]);
        i = i + 1;
    }
    let re1 = u32(c.sm_re.len);
    let rc0 = u32(c.sm_rc.len);
    i = 0;
    while i < c.ret_caps.len {
        c.sm_rc = c.sm_rc.push(c.ret_caps.buf[i]);
        i = i + 1;
    }
    let rc1 = u32(c.sm_rc.len);
    // syncs: holds entries with m==5 (sync) on $arg keys → own range
    let sy0 = u32(c.sm_keys.len);
    i = 0;
    while i < c.holds.len {
        let h = c.holds.buf[i];
        if h.m == 5 && is_arg(c, h.k) == 1 && arg_in(c, owns, h.k) == 0 {
            c.sm_keys = c.sm_keys.push(h.k);
        }
        i = i + 1;
    }
    let sy1 = u32(c.sm_keys.len);
    // ret_lit_* — Vec-order copy (Stage-0 emits in Vec order)
    let sle0 = u32(c.sm_rle.len);
    i = 0;
    while i < c.ret_lit_edges.len {
        c.sm_rle = c.sm_rle.push(c.ret_lit_edges.buf[i]);
        i = i + 1;
    }
    let sle1 = u32(c.sm_rle.len);
    let slc0 = u32(c.sm_rlc.len);
    i = 0;
    while i < c.ret_lit_caps.len {
        c.sm_rlc = c.sm_rlc.push(c.ret_lit_caps.buf[i]);
        i = i + 1;
    }
    let slc1 = u32(c.sm_rlc.len);
    let slp0 = u32(c.sm_rlp.len);
    i = 0;
    while i < c.ret_lit_provs.len {
        c.sm_rlp = c.sm_rlp.push(c.ret_lit_provs.buf[i]);
        i = i + 1;
    }
    let slp1 = u32(c.sm_rlp.len);
    let fs = FSum {
        eoff: se0, elen: se1 - se0,
        koff: sk0, klen: sk1 - sk0,
        coff: sc0, clen: sc1 - sc0,
        ckoff: sck0, cklen: sck1 - sck0,
        ioff: si0, ilen: si1 - si0,
        reoff: re0, relen: re1 - re0,
        rcoff: rc0, rclen: rc1 - rc0,
        leoff: sle0, lelen: sle1 - sle0,
        lcoff: slc0, lclen: slc1 - slc0,
        lpoff: slp0, lplen: slp1 - slp0,
        syoff: sy0, sylen: sy1 - sy0,
        diverges: c.terminated };
    c.fsums = c.fsums.push(fs);
    let fi = u32(c.fsums.len) - 1;
    c.sums = c.sums.push(MapE3 { k: f.name, v: fi });
    c = rec_sum(c, f.name, fi);
    owns.destroy();
    return c;
}


/// `(summary "name" (cr …)… diverges)` — every segment sorted
/// canonically except ret_lit_* (Vec order, like Stage-0).
fn rec_sum(own c: Checker, name: u32, fi: u32) -> Checker {
    let fs = c.fsums.buf[u64(fi)];
    c = es(c, "(summary ");
    let sp = c.r.rns.buf[u64(name)];
    c = eqs_r(c, &c.r.rbyt.buf[u64(sp.off)..
        u64(sp.off) + u64(sp.len)]);
    // (cr "h" "t" auth cert) by (h,t)
    let ix = vec.Vec<u32>::new(c.heap);
    let i: u64 = 0;
    while i < u64(fs.elen) { ix = ix.push(fs.eoff + u32(i)); i = i + 1; }
    i = 1;
    while i < ix.len {
        let x = ix.buf[i];
        let j = i;
        while j > 0 && e2less(c, sm_e2(c, x), sm_e2(c, ix.buf[j - 1])) == 1 {
            ix.buf[j] = ix.buf[j - 1];
            j = j - 1;
        }
        ix.buf[j] = x;
        i = i + 1;
    }
    i = 0;
    while i < ix.len {
        let e = c.sm_edges.buf[u64(ix.buf[i])];
        c = es(c, " (cr ");
        c = eqs(c, e.h);
        c = es(c, " ");
        c = eqs(c, e.t);
        c = ec(c, u8(32));
        c = eauth(c, e.kind);
        c = ec(c, u8(32));
        c = ecert(c, e.cert);
        c = ec(c, u8(41));
        i = i + 1;
    }
    ix.destroy();
    c = sum_kl(c, fs.koff, fs.klen);
    c = sum_cc(c, fs.coff, fs.clen);
    c = sum_ck(c, fs.ckoff, fs.cklen);
    c = sum_ip(c, fs.ioff, fs.ilen);
    c = sum_re(c, fs.reoff, fs.relen);
    c = sum_rc(c, fs.rcoff, fs.rclen);
    c = sum_sy(c, fs.syoff, fs.sylen);
    // ret_lit_* — Vec order
    i = 0;
    while i < u64(fs.lelen) {
        let rl = c.sm_rle.buf[u64(fs.leoff) + i];
        let ri = c.rinfos.buf[u64(rl.ri)];
        c = es(c, " (rle ");
        c = eqs(c, rl.rel);
        let j: u64 = 0;
        while j < u64(ri.tlen) {
            c = ec(c, u8(32));
            c = eqs(c, c.ri_to.buf[u64(ri.toff) + j]);
            j = j + 1;
        }
        if ri.mut_ == 1 { c = es(c, " mut"); } else { c = es(c, " im"); }
        if ri.mf == NONE() { c = es(c, " -"); }
        else { c = ec(c, u8(32)); c = eqs(c, ri.mf); }
        if ri.foreign == 1 { c = es(c, " foreign"); }
        else { c = es(c, " local"); }
        c = ec(c, u8(41));
        i = i + 1;
    }
    i = 0;
    while i < u64(fs.lclen) {
        let rl = c.sm_rlc.buf[u64(fs.lcoff) + i];
        c = es(c, " (rlc ");
        c = eqs(c, rl.rel);
        let j: u64 = 0;
        while j < u64(rl.len) {
            c = ec(c, u8(32));
            c = eqs(c, c.rlc_keys.buf[u64(rl.off) + j]);
            j = j + 1;
        }
        c = ec(c, u8(41));
        i = i + 1;
    }
    i = 0;
    while i < u64(fs.lplen) {
        let pv = c.sm_rlp.buf[u64(fs.lpoff) + i];
        c = es(c, " (rlp ");
        c = eqs(c, pv.k);
        c = ec(c, u8(32));
        c = eprov(c, pv.pk, pv.pv);
        c = ec(c, u8(41));
        i = i + 1;
    }
    if fs.diverges == 1 { c = es(c, " diverges"); }
    c = ec(c, u8(41));
    c = rec(c);
    return c;
}

fn sm_e2(read c: Checker, i: u32) -> E2 {
    return c.sm_edges.buf[u64(i)];
}

/// (h,t) key-byte order on E2.
fn e2less(read c: Checker, a: E2, b: E2) -> u8 {
    if kless(c, a.h, b.h) == 1 { return 1; }
    if a.h == b.h { return kless(c, a.t, b.t); }
    return 0;
}
fn c3less(read c: Checker, a: C3, b: C3) -> u8 {
    if kless(c, a.h, b.h) == 1 { return 1; }
    if a.h == b.h { return kless(c, a.t, b.t); }
    return 0;
}

/// sort key-idx range in-place-ish via index vec — returns sorted idxs
/// (k = arena position, emitted order by key bytes).
fn sort_range(read c: Checker, off: u32, len: u32) -> vec.Vec<u32> {
    let ix = vec.Vec<u32>::new(c.heap);
    let i: u64 = 0;
    while i < u64(len) { ix = ix.push(off + u32(i)); i = i + 1; }
    i = 1;
    while i < ix.len {
        let x = ix.buf[i];
        let j = i;
        while j > 0 && kless(c, c.sm_keys.buf[u64(x)],
            c.sm_keys.buf[u64(ix.buf[j - 1])]) == 1 {
            ix.buf[j] = ix.buf[j - 1];
            j = j - 1;
        }
        ix.buf[j] = x;
        i = i + 1;
    }
    return ix;
}

/// (kl "k" cert) sorted by k.
fn sum_kl(own c: Checker, off: u32, len: u32) -> Checker {
    let ix = vec.Vec<u32>::new(c.heap);
    let i: u64 = 0;
    while i < u64(len) { ix = ix.push(off + u32(i)); i = i + 1; }
    i = 1;
    while i < ix.len {
        let x = ix.buf[i];
        let j = i;
        while j > 0 && kless(c, c.sm_kills.buf[u64(x)].k,
            c.sm_kills.buf[u64(ix.buf[j - 1])].k) == 1 {
            ix.buf[j] = ix.buf[j - 1];
            j = j - 1;
        }
        ix.buf[j] = x;
        i = i + 1;
    }
    i = 0;
    while i < ix.len {
        let e = c.sm_kills.buf[u64(ix.buf[i])];
        c = es(c, " (kl ");
        c = eqs(c, e.k);
        c = ec(c, u8(32));
        c = ecert(c, e.cert);
        c = ec(c, u8(41));
        i = i + 1;
    }
    ix.destroy();
    return c;
}

/// (cc "h" "t" cert) by (h,t).
fn sum_cc(own c: Checker, off: u32, len: u32) -> Checker {
    let ix = vec.Vec<u32>::new(c.heap);
    let i: u64 = 0;
    while i < u64(len) { ix = ix.push(off + u32(i)); i = i + 1; }
    i = 1;
    while i < ix.len {
        let x = ix.buf[i];
        let j = i;
        while j > 0 && c3less(c, c.sm_ccaps.buf[u64(x)],
            c.sm_ccaps.buf[u64(ix.buf[j - 1])]) == 1 {
            ix.buf[j] = ix.buf[j - 1];
            j = j - 1;
        }
        ix.buf[j] = x;
        i = i + 1;
    }
    i = 0;
    while i < ix.len {
        let e = c.sm_ccaps.buf[u64(ix.buf[i])];
        c = es(c, " (cc ");
        c = eqs(c, e.h);
        c = es(c, " ");
        c = eqs(c, e.t);
        c = ec(c, u8(32));
        c = ecert(c, e.cert);
        c = ec(c, u8(41));
        i = i + 1;
    }
    ix.destroy();
    return c;
}

