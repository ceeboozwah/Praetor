/// (re "k" mut|im) by k.
fn sum_re(own c: Checker, off: u32, len: u32) -> Checker {
    let ix = vec.Vec<u32>::new(c.heap);
    let i: u64 = 0;
    while i < u64(len) { ix = ix.push(off + u32(i)); i = i + 1; }
    i = 1;
    while i < ix.len {
        let x = ix.buf[i];
        let j = i;
        while j > 0 && kless(c, c.sm_re.buf[u64(x)].k,
            c.sm_re.buf[u64(ix.buf[j - 1])].k) == 1 {
            ix.buf[j] = ix.buf[j - 1];
            j = j - 1;
        }
        ix.buf[j] = x;
        i = i + 1;
    }
