fn vhas(read v: vec.Vec<u32>, k: u32) -> u8 {
    let i: u64 = 0;
    while i < v.len {
        if v.buf[i] == k { return 1; }
        i = i + 1;
    }
    return 0;
}

/// sort a Vec<u32> of keys by key bytes (insertion — lists are small).
fn ksort(read c: Checker, own v: vec.Vec<u32>) -> vec.Vec<u32> {
    let i: u64 = 1;
    while i < v.len {
        let x = v.buf[i];
        let j = i;
        while j > 0 && kless(c, x, v.buf[j - 1]) == 1 {
            v.buf[j] = v.buf[j - 1];
            j = j - 1;
        }
        v.buf[j] = x;
        i = i + 1;
    }
    return v;
}

fn unedge(own c: Checker, h: u32, t: u32) -> Checker {
    c = es(c, "(unedge ");
    c = eqs(c, h);
    c = ec(c, u8(32));
    c = eqs(c, t);
    c = ec(c, u8(41));
    c = rec(c);
    let i: u64 = 0;
    while i < c.edges.len {
        let e = c.edges.buf[i];
        if e.h == h && e.t == t {
            c.edges.swap_remove(i);
            return c;
