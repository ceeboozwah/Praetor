        heap: heap,
        r: r,
        kbyt: vec.Vec<u8>::new(heap), kns: vec.Vec<loader.Span2>::new(heap),
        ksc: vec.Vec<u8>::new(heap),
        ev: vec.Vec<u8>::new(heap),
        ebyt: vec.Vec<u8>::new(heap),
        errs: vec.Vec<CDiag>::new(heap),
