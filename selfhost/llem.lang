//! selfhost.llvm — N74 LLVM text emission: a byte-exact port of
//! Stage-0's `backend_llvm::emit` reading the structured module
//! `ir.lang` records alongside the own-IR text (the same `Module`
//! shape s0 hands `emit`). String-builder style throughout.
//!
//! Record layout (all in `ir.G`):
//!   iri/iri64 — 8 slots per instr (kind in iri[0]); an opnd is a
//!     u32 kind slot + the i64 slot at the SAME index.
//!   irb/irb64 — [lbl, ioff, ilen, tk, a, b, c, d] per block:
//!     tk 0 ret(a=hasv,b=ty,c=k,i64[6]=v) 1 br(a=k,b=t,c=e,i64[4]=cv)
//!     2 jmp(a=lbl) 3 dead.
//!   irf — [name, ret, paoff, palen, aroff, arlen, bloff, bllen].
//!   irpa — (nid, auth, ty) triples shared by fns and externs.
//!   irar — arg regs per fn.  irx — [name, ret, paoff, palen].
//!   irst — [name, foff, flen]; irsf — (nid, ty) pairs.
//!   irpl — [root, valf, rty, lty, peoff, pelen]; irpe — PE records.

import std.vec;
import lexer;
import ast;
import loader;
import resolve;
import check;
import ir;

fn OK_REG() -> u32 { return 0; }
fn OK_IMM() -> u32 { return 1; }
fn OK_FUN() -> u32 { return 2; }

/// emitter state — `out` is the .ll text; `tmp` is the %pN counter
/// (per fn, s0's `tmp`); `curty`/`akind`/`anum` carry emit_place's
/// running aggregate type and address (akind 0 = %v, 1 = %p).
///
/// N78 — the big-aggregate ABI state rides the same struct (s0's
/// `Fx`): aggregates wider than two registers never travel by value.
/// `own`/plain big-agg params arrive as `ptr` into caller storage;
/// big-agg returns write through a hidden `ptr %sret` first param.
/// `rp_*` is s0's `rptr` map — reg → the LLVM name where its value
/// currently lives — so call args pass `ptr` to existing storage
/// instead of materializing copies. `scr` is the per-ty free pool of
/// `%sN` scratch slots; the pre-pass (`l_analyze`) sizes it.
pub struct LE {
    heap: alloc,
    out: vec.Vec<u8>,
    tmp: u32,
    curty: u32,
    akind: u32,
    anum: u32,
    nav: vec.Vec<u8>,
    uses: vec.Vec<u32>,     // reg -> use count (grown on demand)
    ali_s: vec.Vec<u32>,    // slot reg ->
    ali_p: vec.Vec<u32>,    //   incoming own-big param reg it aliases
    ren: vec.Vec<u32>,      // arg regs rebound to a %a<r> load at entry
    skp: vec.Vec<u64>,      // suppressed instr coords: (bi<<32)|ii
    rp_r: vec.Vec<u32>,     // rptr: reg ->
    rp_k: vec.Vec<u32>,     //   addr kind: 0=%v 1=%p 2=%sret 3=%s
    rp_n: vec.Vec<u32>,     //   addr num
    rp_o: vec.Vec<u32>,     //   root slot reg (NONE = global)
    sc_n: vec.Vec<u32>,     // scratch name nums referenced by rp_*
    sc_t: vec.Vec<u32>,     //   their pool keys (for pool return)
    scr: vec.Vec<u64>,      // free scratch slots: (key<<32)|num
    sal_t: vec.Vec<u32>,    // hoisted scratch alloca tyids
    sal_n: vec.Vec<u32>,    //   their name nums (entry splices these)
    tk_t: vec.Vec<u32>,     // tyid -> pool key memo (s0 keys pools by
    tk_k: vec.Vec<u32>,     //   llty text — two rtys nodes spelling
    tk_x: vec.Vec<u8>,      //   the same type share one pool)
    tk_sp: vec.Vec<u64>,    //   rendered-text spans per key
    tk_r: vec.Vec<u32>,     //   representative tyid per key
    tkk: u32,               // ltyk's out-slot
    hom_r: vec.Vec<u32>,    // call dst regs whose sret wrote a place
    hom_p: vec.Vec<u32>,    //   the place idx it wrote
    cak: vec.Vec<u32>,      // pending call-arg specs: 0 normal, 1 ptr
    cat: vec.Vec<u32>,      //   normal: tyid
    cok: vec.Vec<u32>,      //   normal: opnd kind
    cov: vec.Vec<i64>,      //   normal: opnd val
    cpk: vec.Vec<u32>,      //   ptr: addr kind
    cpn: vec.Vec<u32>,      //   ptr: addr num
    sret: u8,               // this fn returns a big agg via %sret
    mm: u8,                 // some fn emitted a memmove call
    nxt: u64,               // next instr's iri base (NONE when none)
    cbb: u64,               // current block's irb base (term access)
    scn: u32,               // scratch name counter
    scgot: u32,             // scr_take's out-slot (a %sN name num)
}

pub fn new(heap: alloc) -> LE {
    return LE {
        heap: heap,
        out: vec.Vec<u8>::new(heap),
        tmp: 0, curty: 0, akind: 0, anum: 0,
        nav: vec.Vec<u8>::new(heap),
        uses: vec.Vec<u32>::new(heap),
        ali_s: vec.Vec<u32>::new(heap),
        ali_p: vec.Vec<u32>::new(heap),
        ren: vec.Vec<u32>::new(heap),
        skp: vec.Vec<u64>::new(heap),
        rp_r: vec.Vec<u32>::new(heap),
        rp_k: vec.Vec<u32>::new(heap),
        rp_n: vec.Vec<u32>::new(heap),
        rp_o: vec.Vec<u32>::new(heap),
        sc_n: vec.Vec<u32>::new(heap),
        sc_t: vec.Vec<u32>::new(heap),
        scr: vec.Vec<u64>::new(heap),
        sal_t: vec.Vec<u32>::new(heap),
        sal_n: vec.Vec<u32>::new(heap),
        tk_t: vec.Vec<u32>::new(heap),
        tk_k: vec.Vec<u32>::new(heap),
        tk_x: vec.Vec<u8>::new(heap),
        tk_sp: vec.Vec<u64>::new(heap),
        tk_r: vec.Vec<u32>::new(heap),
        tkk: 0,
        hom_r: vec.Vec<u32>::new(heap),
        hom_p: vec.Vec<u32>::new(heap),
        cak: vec.Vec<u32>::new(heap),
        cat: vec.Vec<u32>::new(heap),
        cok: vec.Vec<u32>::new(heap),
        cov: vec.Vec<i64>::new(heap),
        cpk: vec.Vec<u32>::new(heap),
        cpn: vec.Vec<u32>::new(heap),
        sret: 0, mm: 0, nxt: u64(ir.NONE()), cbb: 0, scn: 0,
        scgot: 0,
    };
}
pub fn destroy(own le: LE) {
    le.out.destroy(); le.nav.destroy();
    le.uses.destroy(); le.ali_s.destroy(); le.ali_p.destroy();
    le.ren.destroy(); le.skp.destroy();
    le.rp_r.destroy(); le.rp_k.destroy(); le.rp_n.destroy();
    le.rp_o.destroy(); le.sc_n.destroy(); le.sc_t.destroy();
    le.scr.destroy(); le.sal_t.destroy(); le.sal_n.destroy();
    le.tk_t.destroy(); le.tk_k.destroy(); le.tk_x.destroy();
    le.tk_sp.destroy(); le.tk_r.destroy();
    le.hom_r.destroy(); le.hom_p.destroy();
    le.cak.destroy(); le.cat.destroy(); le.cok.destroy();
    le.cov.destroy(); le.cpk.destroy(); le.cpn.destroy();
}

// ---- text helpers ---------------------------------------------------

fn lputs(own le: LE, s: str) -> LE {
    le.out = resolve.bputs(le.out, s);
    return le;
}
fn li64(own le: LE, n: i64) -> LE {
    if n < 0 {
        le.out = le.out.push(u8(45));
        le.out = resolve.bu32(le.out, u64(0 - n));
        return le;
    }
    le.out = resolve.bu32(le.out, u64(n));
    return le;
}
fn lu32(own le: LE, n: u32) -> LE {
    le.out = resolve.bu32(le.out, u64(n));
    return le;
}
fn lvr(own le: LE, r: u32) -> LE {
    le.out = resolve.bputs(le.out, "%v");
    return lu32(le, r);
}
fn lpr(own le: LE, t: u32) -> LE {
    le.out = resolve.bputs(le.out, "%p");
    return lu32(le, t);
}

/// name byte at (nid, i) — resolver arena access.
fn nbyte(read r: resolve.Resolver, nid: u32, i: u64) -> u8 {
    let sp = r.rns.buf[u64(nid)];
    return r.rbyt.buf[u64(sp.off) + i];
}
fn nlen(read r: resolve.Resolver, nid: u32) -> u64 {
    return u64(r.rns.buf[u64(nid)].len);
}
/// `llsym` byte transform — alnum/_/./$ keep, else `-`.
fn lsym_b(own le: LE, b: u8) -> LE {
    let alnum = (b >= u8(48) && b <= u8(57))
        || (b >= u8(65) && b <= u8(90))
        || (b >= u8(97) && b <= u8(122));
    if alnum || b == u8(95) || b == u8(46) || b == u8(36) {
        le.out = le.out.push(b);
    } else {
        le.out = le.out.push(u8(45));
    }
    return le;
}
/// `llsym` over a name nid.
fn llsym(own le: LE, read r: resolve.Resolver, nid: u32) -> LE {
    let i: u64 = 0;
    let n = nlen(r, nid);
    while i < n {
        le = lsym_b(le, nbyte(r, nid, i));
        i = i + 1;
    }
    return le;
}
/// `llsym` over an App ty's canonical name — `name<targs>` bytes
/// built by the resolver's own canon formatter (read-only).
fn llsym_app(own le: LE, read r: resolve.Resolver,
             ty: resolve.RTy) -> LE {
    let cv = resolve.canon_push(
        vec.Vec<u8>::new(le.heap), r, ty.name, ty.b, ty.c);
    let i: u64 = 0;
    while i < cv.len {
        le = lsym_b(le, cv.buf[i]);
        i = i + 1;
    }
    cv.destroy();
    return le;
}
/// name starts with the given literal.
fn nstarts(read r: resolve.Resolver, nid: u32, s: str) -> u8 {
    if nlen(r, nid) < s.len { return 0; }
    let i: u64 = 0;
    while i < s.len {
        if nbyte(r, nid, i) != s.bytes[i] { return 0; }
        i = i + 1;
    }
    return 1;
}
/// byte-order less-than over name text — BTreeSet's ordering.
fn nless(read r: resolve.Resolver, a: u32, b: u32) -> u8 {
    let na = nlen(r, a);
    let nb = nlen(r, b);
    let i: u64 = 0;
    while i < na && i < nb {
        let ba = nbyte(r, a, i);
        let bb = nbyte(r, b, i);
        if ba < bb { return 1; }
        if ba > bb { return 0; }
        i = i + 1;
    }
    if na < nb { return 1; }
    return 0;
}

// ---- llty -----------------------------------------------------------

/// `llty(t)` — the LLVM type spell for a resolver tyid.
fn lty(own le: LE, read r: resolve.Resolver, t: u32) -> LE {
    let ty = r.rtys.buf[u64(t)];
    let k = u32(ty.kind);
    if k == 0 || k == 4 { return lputs(le, "i8"); }
    if k == 1 || k == 5 { return lputs(le, "i16"); }
    if k == 2 || k == 6 { return lputs(le, "i32"); }
    if k == 3 || k == 7 { return lputs(le, "i64"); }
    if k == 8 { return lputs(le, "i1"); }
    if k == 9 { return lputs(le, "void"); }
    if k == 12 {
        le.out = le.out.push(u8(37));
        return llsym(le, r, ty.name);
    }
    if k == 13 {
        le.out = le.out.push(u8(37));
        return llsym_app(le, r, ty);
    }
    if k == 14 {
        le.out = le.out.push(u8(91));
        le.out = resolve.bu32(le.out, ty.w);
        le = lputs(le, " x ");
        le = lty(le, r, ty.a);
        le.out = le.out.push(u8(93));
        return le;
    }
    if k == 20 { return lty(le, r, ty.a); }
    if k == 17 || k == 10 || k == 25 {
        return lputs(le, "{ptr, i64}");
    }
    // 11 alloc, 15 ref, 16 ptr, 18 handle, 19 task, 21 mutex,
    // 22 guard, 23 channel, 24 box — all `ptr`.
    return lputs(le, "ptr");
}

/// `Ty::signed()` — i8..i64 kinds only.
fn lsigned(read r: resolve.Resolver, t: u32) -> u8 {
    let k = u32(r.rtys.buf[u64(t)].kind);
    if k >= 4 && k <= 7 { return 1; }
    return 0;
}
/// `Ty::bits()` — bool counts 32; atomics transparent.
fn lbits(read r: resolve.Resolver, t: u32) -> u32 {
    let ty = r.rtys.buf[u64(t)];
    let k = u32(ty.kind);
    if k == 0 || k == 4 { return u32(8); }
    if k == 1 || k == 5 { return u32(16); }
    if k == 2 || k == 6 || k == 8 { return u32(32); }
    if k == 3 || k == 7 { return u32(64); }
    if k == 20 { return lbits(r, ty.a); }
    return 0;
}
/// cast width table — emit.rs's `w` closure.
fn lcastw(read r: resolve.Resolver, t: u32) -> u32 {
    let k = u32(r.rtys.buf[u64(t)].kind);
    if k == 8 { return u32(1); }
    if k == 0 || k == 4 { return u32(8); }
    if k == 1 || k == 5 { return u32(16); }
    if k == 2 || k == 6 { return u32(32); }
    return u32(64);
}
/// `t.is_ptr_like()` — own-param noalias eligibility.
fn lptrlike(read r: resolve.Resolver, t: u32) -> u8 {
    let k = u32(r.rtys.buf[u64(t)].kind);
    if k == 15 || k == 16 || k == 18 || k == 19 || k == 21
        || k == 22 || k == 23 || k == 24 || k == 11 || k == 26 {
        return 1;
    }
    return 0;
}

/// `o(opnd)` — `%vN` / immediate / `@sym`.
fn lop(own le: LE, read g: ir.G, k: u32, v: i64) -> LE {
    if k == OK_REG() { return lvr(le, u32(v)); }
    if k == OK_FUN() {
        le.out = le.out.push(u8(64));
        return llsym(le, g.c.r, u32(v));
    }
    return li64(le, v);
}

// ---- N78: large-aggregate ABI ----------------------------------------
// Aggregates wider than two registers (>16B) never travel by value —
// s0's comment in emit.rs explains the convention; this block ports it.
//   - `own`/plain param of big-agg type → `ptr` into caller storage;
//     a param whose only use is its homing store aliases that storage
//     in place (no alloca, no copy). `own` is a move, so the callee
//     may scribble on storage the caller no longer owns.
//   - big-agg return → hidden `ptr %sret` + `ret void`; the callee
//     memmoves the result into the destination.
//   - call sites pass the eventual store target (or `%sret` for tail
//     `return f(g)` chains) as the sret pointer; big-agg args pass
//     `ptr` to wherever the value already lives (`rp_*`).
//   - values with no backing storage materialize into pooled `%sN`
//     scratch slots, freed back on use.
// Scalars and ≤16B aggregates keep the register convention; externs
// keep the C ABI. `noalias` eligibility is unchanged.

/// align bits → log2 (all aligns are powers of two).
fn lal2(al: u64) -> u64 {
    if al <= 8 { return 3; }
    if al <= 16 { return 4; }
    if al <= 32 { return 5; }
    return 6;
}
/// `ty_layout` — packed (size<<4)|align-log2, sizes/aligns in bits.
fn llay(read g: ir.G, t: u32) -> u64 {
    let ty = g.c.r.rtys.buf[u64(t)];
    let k = u32(ty.kind);
    if k == 0 || k == 4 || k == 8 { return u64(131); }  // (8,8)
    if k == 1 || k == 5 { return u64(260); }            // (16,16)
    if k == 2 || k == 6 { return u64(517); }            // (32,32)
    if k == 3 || k == 7 { return u64(1030); }           // (64,64)
    if k == 9 { return u64(3); }                        // void (0,8)
    if k == 14 {
        let e = llay(g, ty.a);
        let ea = u64(1) << (e % 16);
        let es = e / 16;
        let st = u64(ty.w) * ((es + ea - 1) / ea * ea);
        return st * 16 + e % 16;
    }
    if k == 12 || k == 13 {
        let nm = ty.name;
        if k == 13 {
            let cv = resolve.canon_push(
                vec.Vec<u8>::new(g.heap), g.c.r, ty.name, ty.b, ty.c);
            let f = resolve.intern_at(g.c.r, cv.as_slice());
            cv.destroy();
            if f == ir.NONE() { return u64(3); }        // missing → (0,8)
            nm = f;
        }
        let off: u64 = 0;
        let al: u64 = 8;
        let j: u64 = 0;
        while j * 3 < g.irst.len {
            let sb = j * 3;
            if g.irst.buf[sb] == nm {
                let fo = u64(g.irst.buf[sb + 1]);
                let fl = u64(g.irst.buf[sb + 2]);
                let q: u64 = 0;
                while q < fl {
                    let fe = llay(g, g.irsf.buf[fo + q * 2 + 1]);
                    let fa = u64(1) << (fe % 16);
                    let fs = fe / 16;
                    off = (off + fa - 1) / fa * fa + fs;
                    if fa > al { al = fa; }
                    q = q + 1;
                }
                break;
            }
            j = j + 1;
        }
        return ((off + al - 1) / al * al) * 16 + lal2(al);
    }
    if k == 20 { return llay(g, ty.a); }
    if k == 17 || k == 10 || k == 25 { return u64(2054); } // (128,64)
    return u64(1030);                                      // ptr (64,64)
}
/// `big_agg` — struct/app/array wider than the two-register budget.
fn lbig(read g: ir.G, t: u32) -> u8 {
    let k = u32(g.c.r.rtys.buf[u64(t)].kind);
    if k != 12 && k != 13 && k != 14 { return 0; }
    if llay(g, t) / 16 > 128 { return 1; }
    return 0;
}
/// extern-name membership — irx holds `[name, ret, paoff, palen]`.
fn lext(read g: ir.G, nid: u32) -> u8 {
    let i: u64 = 0;
    while i * 4 < g.irx.len {
        if g.irx.buf[i * 4] == nid { return 1; }
        i = i + 1;
    }
    return 0;
}

/// `ov` — renamed own-big params print their materialized %a<r>.
fn lov(own le: LE, read g: ir.G, k: u32, v: i64) -> LE {
    if k == OK_REG() {
        let i: u64 = 0;
        while i < le.ren.len {
            if le.ren.buf[i] == u32(v) {
                le.out = resolve.bputs(le.out, "%a");
                return lu32(le, u32(v));
            }
            i = i + 1;
        }
    }
    return lop(le, g, k, v);
}
/// render a packed rptr address — (kind, num).
fn lpak(own le: LE, k: u32, n: u32) -> LE {
    if k == 0 { return lvr(le, n); }
    if k == 1 { return lpr(le, n); }
    if k == 2 { return lputs(le, "%sret"); }
    le.out = resolve.bputs(le.out, "%s");
    return lu32(le, n);
}

// rptr — reg → where its value currently lives -------------------------

fn rp_find(read le: LE, r: u32) -> u64 {
    let i: u64 = 0;
    while i < le.rp_r.len {
        if le.rp_r.buf[i] == r { return i; }
        i = i + 1;
    }
    return u64(ir.NONE());
}
/// return a scratch name to its type's pool (s0's rptr_free_one).
fn rp_free_name(own le: LE, k: u32, n: u32) -> LE {
    if k != 3 { return le; }
    let i: u64 = 0;
    while i < le.sc_n.len {
        if le.sc_n.buf[i] == n {
            let t = le.sc_t.buf[i];
            let j = i;
            while j + 1 < le.sc_n.len {
                le.sc_n.buf[j] = le.sc_n.buf[j + 1];
                le.sc_t.buf[j] = le.sc_t.buf[j + 1];
                j = j + 1;
            }
            le.sc_n.pop(); le.sc_t.pop();
            le.scr = le.scr.push(u64(t) * (u64(1) << 32) + u64(n));
            return le;
        }
        i = i + 1;
    }
    return le;
}
/// drop the rptr table — a write of unknown reach happened (s0's
/// rptr_clear); scratch names go back to their pools.
fn rp_clear(own le: LE) -> LE {
    while le.rp_r.len > 0 {
        let i = le.rp_r.len - 1;
        let k = le.rp_k.buf[i];
        let n = le.rp_n.buf[i];
        le.rp_r.pop(); le.rp_k.pop(); le.rp_n.pop(); le.rp_o.pop();
        le = rp_free_name(le, k, n);
    }
    return le;
}
/// drop rptr entries rooted at `root` — a store wrote inside it.
fn rp_kill(own le: LE, root: u32) -> LE {
    let i: u64 = 0;
    while i < le.rp_r.len {
        if le.rp_o.buf[i] == root {
            let k = le.rp_k.buf[i];
            let n = le.rp_n.buf[i];
            let j = i;
            while j + 1 < le.rp_r.len {
                le.rp_r.buf[j] = le.rp_r.buf[j + 1];
                le.rp_k.buf[j] = le.rp_k.buf[j + 1];
                le.rp_n.buf[j] = le.rp_n.buf[j + 1];
                le.rp_o.buf[j] = le.rp_o.buf[j + 1];
                j = j + 1;
            }
            le.rp_r.pop(); le.rp_k.pop(); le.rp_n.pop(); le.rp_o.pop();
            le = rp_free_name(le, k, n);
        } else {
            i = i + 1;
        }
    }
    return le;
}
/// record `r` living at (k,n); `st` pool key when the addr is scratch.
fn rp_set(own le: LE, r: u32, k: u32, n: u32, root: u32, st: u32) -> LE {
    if k == 3 && st != ir.NONE() {
        le.sc_n = le.sc_n.push(n);
        le.sc_t = le.sc_t.push(st);
    }
    let i = rp_find(le, r);
    if i == u64(ir.NONE()) {
        le.rp_r = le.rp_r.push(r); le.rp_k = le.rp_k.push(k);
        le.rp_n = le.rp_n.push(n); le.rp_o = le.rp_o.push(root);
        return le;
    }
    le.rp_k.buf[i] = k; le.rp_n.buf[i] = n; le.rp_o.buf[i] = root;
    return le;
}
/// canonical pool key for tyid `t` — s0 keys scratch pools by the
/// rendered `llty` string, so two rtys nodes spelling the same type
/// (e.g. distinct `vec.Vec<u8>` app nodes) share one pool. `tkk`
/// carries the key out; the memo persists across fns.
fn ltyk(own le: LE, read g: ir.G, t: u32) -> LE {
    let i: u64 = 0;
    while i < le.tk_t.len {
        if le.tk_t.buf[i] == t { le.tkk = le.tk_k.buf[i]; return le; }
        i = i + 1;
    }
    let b2: vec.Vec<u8> = ltyb(vec.Vec<u8>::new(le.heap), g, t);
    let k: u64 = 0;
    while k < le.tk_sp.len {
        let e = le.tk_sp.buf[k];
        let off = e / (u64(1) << 32);
        let ln = e % (u64(1) << 32);
        if ln == b2.len {
            let same: u8 = 1;
            let j: u64 = 0;
            while j < ln {
                if le.tk_x.buf[off + j] != b2.buf[j] {
                    same = 0; break;
                }
                j = j + 1;
            }
            if same == 1 {
                le.tkk = u32(k);
                le.tk_t = le.tk_t.push(t);
                le.tk_k = le.tk_k.push(u32(k));
                b2.destroy();
                return le;
            }
        }
        k = k + 1;
    }
    let off = le.tk_x.len;
    let j: u64 = 0;
    while j < b2.len { le.tk_x = le.tk_x.push(b2.buf[j]); j = j + 1; }
    le.tk_sp = le.tk_sp.push(off * (u64(1) << 32) + b2.len);
    le.tk_r = le.tk_r.push(t);
    let nk = u32(le.tk_sp.len) - 1;
    le.tkk = nk;
    le.tk_t = le.tk_t.push(t);
    le.tk_k = le.tk_k.push(nk);
    b2.destroy();
    return le;
}
/// take a scratch slot of ty `t` — LIFO-per-type over the packed free
/// list (s0 pops the per-type Vec; scanning from the end reproduces
/// the same order). `scgot` carries the name num out.
fn scr_take(own le: LE, read g: ir.G, t: u32) -> LE {
    le = ltyk(le, g, t);
    let t = le.tkk;
    let i = le.scr.len;
    while i > 0 {
        let e = le.scr.buf[i - 1];
        if e / (u64(1) << 32) == u64(t) {
            le.scgot = u32(e % (u64(1) << 32));
            let j = i - 1;
            while j + 1 < le.scr.len {
                le.scr.buf[j] = le.scr.buf[j + 1];
                j = j + 1;
            }
            le.scr.pop();
            return le;
        }
        i = i - 1;
    }
    // the pre-pass sizes the pool — reaching here means the sim and
    // the emitter disagree; a poisoned name fails loudly in the diff.
    le.scgot = u32(99999999);
    return le;
}

// use counts + the analyzer's maps -------------------------------------

fn u_bump(own le: LE, r: u32) -> LE {
    while le.uses.len <= u64(r) { le.uses = le.uses.push(u32(0)); }
    le.uses.buf[u64(r)] = le.uses.buf[u64(r)] + 1;
    return le;
}
fn u_cnt(read le: LE, r: u32) -> u32 {
    if u64(r) >= le.uses.len { return 0; }
    return le.uses.buf[u64(r)];
}
fn obump(own le: LE, k: u32, v: i64) -> LE {
    if k == OK_REG() { le = u_bump(le, u32(v)); }
    return le;
}
/// index-opnd regs inside a place's path.
fn pl_regs(own le: LE, read g: ir.G, pi: u32) -> LE {
    let pb = u64(pi) * 6;
    let po = u64(g.irpl.buf[pb + 4]);
    let pl = u64(g.irpl.buf[pb + 5]);
    let i: u64 = 0;
    while i < pl {
        let pe = g.irpe.buf[po + i];
        if pe.kind != u8(0) && u32(pe.kind) - 1 == 0 {
            le = u_bump(le, u32(pe.ov));
        }
        i = i + 1;
    }
    return le;
}
/// every `Opnd::R` use in an instruction — s0's `opnd_regs`.
fn i_regs(own le: LE, read g: ir.G, ib: u64) -> LE {
    let kind = g.iri.buf[ib];
    if kind == 3 || kind == 5 || kind == 6 || kind == 7 {
        return pl_regs(le, g, g.iri.buf[ib + 2]);
    }
    if kind == 4 || kind == 8 {
        le = pl_regs(le, g, g.iri.buf[ib + 1]);
        return obump(le, g.iri.buf[ib + 2], g.iri64.buf[ib + 2]);
    }
    if kind == 9 {
        le = pl_regs(le, g, g.iri.buf[ib + 2]);
        return obump(le, g.iri.buf[ib + 3], g.iri64.buf[ib + 3]);
    }
    if kind == 10 {
        le = pl_regs(le, g, g.iri.buf[ib + 2]);
        le = obump(le, g.iri.buf[ib + 3], g.iri64.buf[ib + 3]);
        return obump(le, g.iri.buf[ib + 4], g.iri64.buf[ib + 4]);
    }
    if kind == 11 {
        le = obump(le, g.iri.buf[ib + 4], g.iri64.buf[ib + 4]);
        return obump(le, g.iri.buf[ib + 5], g.iri64.buf[ib + 5]);
    }
    if kind == 12 || kind == 14 {
        return obump(le, g.iri.buf[ib + 4], g.iri64.buf[ib + 4]);
    }
    if kind == 15 {
        return obump(le, g.iri.buf[ib + 3], g.iri64.buf[ib + 3]);
    }
    if kind == 16 {
        let ao = u64(g.iri.buf[ib + 4]);
        let al = u64(g.iri.buf[ib + 5]);
        let i: u64 = 0;
        while i < al {
            let ax = g.irax.buf[ao + i];
            le = obump(le, ax.k, ax.v);
            i = i + 1;
        }
        return le;
    }
    return le;
}

// tiny (k,v) map over packed u64 entries — k<<32|v ---------------------

fn mq_get(read m: vec.Vec<u64>, k: u32) -> u32 {
    let i: u64 = 0;
    while i < m.len {
        if u32(m.buf[i] / (u64(1) << 32)) == k {
            return u32(m.buf[i] % (u64(1) << 32));
        }
        i = i + 1;
    }
    return ir.NONE();
}
fn mq_has(read m: vec.Vec<u64>, k: u32) -> u8 {
    let i: u64 = 0;
    while i < m.len {
        if u32(m.buf[i] / (u64(1) << 32)) == k { return 1; }
        i = i + 1;
    }
    return 0;
}
fn mq_put(own m: vec.Vec<u64>, k: u32, v: u32) -> vec.Vec<u64> {
    let i: u64 = 0;
    while i < m.len {
        if u32(m.buf[i] / (u64(1) << 32)) == k {
            m.buf[i] = u64(k) * (u64(1) << 32) + u64(v);
            return m;
        }
        i = i + 1;
    }
    return m.push(u64(k) * (u64(1) << 32) + u64(v));
}
/// delete every entry whose VALUE equals `v` (s0's live.retain ≠ k).
fn mq_delv(own m: vec.Vec<u64>, v: u32) -> vec.Vec<u64> {
    let i: u64 = 0;
    while i < m.len {
        if u32(m.buf[i] % (u64(1) << 32)) == v {
            let j = i;
            while j + 1 < m.len {
                m.buf[j] = m.buf[j + 1];
                j = j + 1;
            }
            m.pop();
        } else {
            i = i + 1;
        }
    }
    return m;
}

// llty text for pool-sort determinism -----------------------------------

/// the lsym transform onto a byte vec.
fn tb_sym(own o: vec.Vec<u8>, b: u8) -> vec.Vec<u8> {
    let alnum = (b >= u8(48) && b <= u8(57))
        || (b >= u8(65) && b <= u8(90))
        || (b >= u8(97) && b <= u8(122));
    if alnum || b == u8(95) || b == u8(46) || b == u8(36) {
        return o.push(b);
    }
    return o.push(u8(45));
}
fn tb_name(own o: vec.Vec<u8>, read r: resolve.Resolver, nid: u32)
        -> vec.Vec<u8> {
    let i: u64 = 0;
    while i < nlen(r, nid) {
        o = tb_sym(o, nbyte(r, nid, i));
        i = i + 1;
    }
    return o;
}
fn tb_app(own o: vec.Vec<u8>, read g: ir.G, ty: resolve.RTy)
        -> vec.Vec<u8> {
    let cv = resolve.canon_push(
        vec.Vec<u8>::new(g.heap), g.c.r, ty.name, ty.b, ty.c);
    let i: u64 = 0;
    while i < cv.len {
        o = tb_sym(o, cv.buf[i]);
        i = i + 1;
    }
    cv.destroy();
    return o;
}
/// `lty` rendered into a byte vec — the pool sort key.
fn ltyb(own o: vec.Vec<u8>, read g: ir.G, t: u32) -> vec.Vec<u8> {
    let ty = g.c.r.rtys.buf[u64(t)];
    let k = u32(ty.kind);
    if k == 0 || k == 4 { return resolve.bputs(o, "i8"); }
    if k == 1 || k == 5 { return resolve.bputs(o, "i16"); }
    if k == 2 || k == 6 { return resolve.bputs(o, "i32"); }
    if k == 3 || k == 7 { return resolve.bputs(o, "i64"); }
    if k == 8 { return resolve.bputs(o, "i1"); }
    if k == 9 { return resolve.bputs(o, "void"); }
    if k == 12 {
        o = o.push(u8(37));
        return tb_name(o, g.c.r, ty.name);
    }
    if k == 13 {
        o = o.push(u8(37));
        return tb_app(o, g, ty);
    }
    if k == 14 {
        o = o.push(u8(91));
        o = resolve.bu32(o, ty.w);
        o = resolve.bputs(o, " x ");
        o = ltyb(o, g, ty.a);
        o = o.push(u8(93));
        return o;
    }
    if k == 20 { return ltyb(o, g, ty.a); }
    if k == 17 || k == 10 || k == 25 {
        return resolve.bputs(o, "{ptr, i64}");
    }
    return resolve.bputs(o, "ptr");
}
/// byte-order less-than over (off,len) spans of a shared arena.
fn tless(read tb: vec.Vec<u8>, ao: u64, al: u64, bo: u64, bl: u64) -> u8 {
    let i: u64 = 0;
    while i < al && i < bl {
        if tb.buf[ao + i] < tb.buf[bo + i] { return 1; }
        if tb.buf[ao + i] > tb.buf[bo + i] { return 0; }
        i = i + 1;
    }
    if al < bl { return 1; }
    return 0;
}

// ---- noalias (N51B) --------------------------------------------------

/// `self_carrier` — buf[0] is the result flag, buf[1..] the seen
/// set (s0's `HashSet<String>` — nids dedup the same).
fn l_selfc(read g: ir.G, t: u32, own seen: vec.Vec<u32>)
        -> vec.Vec<u32> {
    let ty = g.c.r.rtys.buf[u64(t)];
    let k = u32(ty.kind);
    if k == 16 || k == 18 || k == 15 || k == 17 || k == 10 {
        return push_flag(seen, 1);
    }
    if k == 14 || k == 20 || k == 21 || k == 22 || k == 23
        || k == 19 || k == 24 || k == 25 || k == 26 {
        return l_selfc(g, ty.a, seen);
    }
    if k == 12 || k == 13 {
        // s0's `Ty::Struct(n)|App(n)` names are the canon text —
        // the kind-13 RTy splits it into base+targs, so rebuild.
        let nm = ty.name;
        if k == 13 {
            let cv = resolve.canon_push(
                vec.Vec<u8>::new(g.heap), g.c.r,
                ty.name, ty.b, ty.c);
            let f = resolve.intern_at(g.c.r, cv.as_slice());
            cv.destroy();
            if f == ir.NONE() { return seen; }
            nm = f;
        }
        let i: u64 = 0;
        while i + 1 < seen.len {
            if seen.buf[i + 1] == nm { return seen; }
            i = i + 1;
        }
        seen = seen.push(nm);
        // struct fields — scan irst for the name
        let j: u64 = 0;
        while j * 3 < g.irst.len {
            let base = j * 3;
            if g.irst.buf[base] == nm {
                let fo = u64(g.irst.buf[base + 1]);
                let fl = u64(g.irst.buf[base + 2]);
                let q: u64 = 0;
                while q < fl {
                    seen = l_selfc(g, g.irsf.buf[fo + q * 2 + 1],
                                   seen);
                    if seen.buf[0] == 1 { return seen; }
                    q = q + 1;
                }
                return seen;
            }
            j = j + 1;
        }
        return seen;
    }
    return seen;
}
/// `sib_carrier` — only `*T`/`handle` poison sibling scans.
fn l_sibc(read g: ir.G, t: u32, own seen: vec.Vec<u32>)
        -> vec.Vec<u32> {
    let ty = g.c.r.rtys.buf[u64(t)];
    let k = u32(ty.kind);
    if k == 16 || k == 18 { return push_flag(seen, 1); }
    if k == 14 || k == 20 || k == 21 || k == 22 || k == 23
        || k == 19 || k == 24 || k == 25 || k == 26 {
        return l_sibc(g, ty.a, seen);
    }
    if k == 12 || k == 13 {
        let nm = ty.name;
        if k == 13 {
            let cv = resolve.canon_push(
                vec.Vec<u8>::new(g.heap), g.c.r,
                ty.name, ty.b, ty.c);
            let f = resolve.intern_at(g.c.r, cv.as_slice());
            cv.destroy();
            if f == ir.NONE() { return seen; }
            nm = f;
        }
        let i: u64 = 0;
        while i + 1 < seen.len {
            if seen.buf[i + 1] == nm { return seen; }
            i = i + 1;
        }
        seen = seen.push(nm);
        let j: u64 = 0;
        while j * 3 < g.irst.len {
            let base = j * 3;
            if g.irst.buf[base] == nm {
                let fo = u64(g.irst.buf[base + 1]);
                let fl = u64(g.irst.buf[base + 2]);
                let q: u64 = 0;
                while q < fl {
                    seen = l_sibc(g, g.irsf.buf[fo + q * 2 + 1],
                                  seen);
                    if seen.buf[0] == 1 { return seen; }
                    q = q + 1;
                }
                return seen;
            }
            j = j + 1;
        }
        return seen;
    }
    return seen;
}
/// flag-in-slot-0 convention: buf[0] is the result, buf[1..] seen.
fn push_flag(own seen: vec.Vec<u32>, f: u32) -> vec.Vec<u32> {
    seen.buf[0] = f;
    return seen;
}

/// `noalias_flags` — fills le.nav per the current fn's params.
fn l_noalias(own le: LE, read g: ir.G, fb: u64) -> LE {
    while le.nav.len > 0 { le.nav.pop(); }
    let poff = u64(g.irf.buf[fb + 2]);
    let plen = u64(g.irf.buf[fb + 3]);
    // sibling scan — sib_carrier per param (fresh seen each).
    let sib = vec.Vec<u8>::new(le.heap);
    let i: u64 = 0;
    while i < plen {
        let pt = g.irpa.buf[poff + i * 3 + 2];
        let sv = vec.Vec<u32>::new(le.heap);
        let sv2 = sv.push(u32(0));
        let sv3 = l_sibc(g, pt, sv2);
        sib = sib.push(u8(sv3.buf[0]));
        sv3.destroy();
        i = i + 1;
    }
    i = 0;
    while i < plen {
        let pa = poff + i * 3;
        let auth = g.irpa.buf[pa + 1];
        let pt = g.irpa.buf[pa + 2];
        let exclusive: u8 = 0;
        if auth == 2 { exclusive = 1; }
        if auth == 3 && lptrlike(g.c.r, pt) == 1 { exclusive = 1; }
        let flag: u8 = 0;
        if exclusive == 1 {
            let sv = vec.Vec<u32>::new(le.heap);
            let sv2 = sv.push(u32(0));
            let sv3 = l_selfc(g, pt, sv2);
            let selfc = sv3.buf[0];
            sv3.destroy();
            if selfc == 0 {
                let bad: u8 = 0;
                let j: u64 = 0;
                while j < plen {
                    if j != i && sib.buf[j] == u8(1) { bad = 1; }
                    j = j + 1;
                }
                if bad == 0 { flag = 1; }
            }
        }
        le.nav = le.nav.push(flag);
        i = i + 1;
    }
    sib.destroy();
    return le;
}

// ---- analyze (N78) ----------------------------------------------------
// Per-fn pre-pass — s0's `analyze`: use counts drive the call lowering;
// an own-big param whose only use is its homing `store arg → slot`
// makes the slot alias the incoming ptr (no alloca, no copy); other
// own-big params get one entry `load` rebound to %a<r>. The second
// half simulates the emitter's place-backedness rules to size the
// `%sN` scratch pools — over-allocation is safe, under is not.
fn l_analyze(own le: LE, read g: ir.G, fb: u64) -> LE {
    // reset per-fn state — `le` persists across fns.
    while le.uses.len > 0 { le.uses.pop(); }
    while le.ali_s.len > 0 { le.ali_s.pop(); le.ali_p.pop(); }
    while le.ren.len > 0 { le.ren.pop(); }
    while le.skp.len > 0 { le.skp.pop(); }
    while le.rp_r.len > 0 {
        le.rp_r.pop(); le.rp_k.pop(); le.rp_n.pop(); le.rp_o.pop();
    }
    while le.sc_n.len > 0 { le.sc_n.pop(); le.sc_t.pop(); }
    while le.scr.len > 0 { le.scr.pop(); }
    while le.sal_t.len > 0 { le.sal_t.pop(); le.sal_n.pop(); }
    while le.hom_r.len > 0 { le.hom_r.pop(); le.hom_p.pop(); }
    le.sret = lbig(g, g.irf.buf[fb + 1]);
    le.scn = 0;

    let bo = u64(g.irf.buf[fb + 6]);
    let bl = u64(g.irf.buf[fb + 7]);
    // ---- use counts over every Opnd::R
    let b: u64 = 0;
    while b < bl {
        let bb = (bo + b) * 8;
        let io = u64(g.irb.buf[bb + 1]);
        let il = u64(g.irb.buf[bb + 2]);
        let i: u64 = 0;
        while i < il {
            le = i_regs(le, g, (io + i) * 8);
            i = i + 1;
        }
        let tk = g.irb.buf[bb + 3];
        if tk == 0 {
            if g.irb.buf[bb + 4] != 0 {
                le = obump(le, g.irb.buf[bb + 6], g.irb64.buf[bb + 6]);
            }
        }
        if tk == 1 {
            le = obump(le, g.irb.buf[bb + 4], g.irb64.buf[bb + 4]);
        }
        b = b + 1;
    }
    // ---- own-big params: alias the home slot, or rebind as %a<r>.
    let poff = u64(g.irf.buf[fb + 2]);
    let plen = u64(g.irf.buf[fb + 3]);
    let aro = u64(g.irf.buf[fb + 4]);
    let pi: u64 = 0;
    while pi < plen {
        let auth = g.irpa.buf[poff + pi * 3 + 1];
        let pt = g.irpa.buf[poff + pi * 3 + 2];
        if auth != 1 && auth != 2 && lbig(g, pt) == 1 {
            let ar = g.irar.buf[aro + pi];
            // the homing store — first `store ar → <bare Slot place>`
            // of the param's type, in instr order.
            let hb: u64 = u64(ir.NONE());
            let hs: u32 = ir.NONE();
            let b2: u64 = 0;
            while b2 < bl && hb == u64(ir.NONE()) {
                let bb2 = (bo + b2) * 8;
                let io2 = u64(g.irb.buf[bb2 + 1]);
                let il2 = u64(g.irb.buf[bb2 + 2]);
                let k2: u64 = 0;
                while k2 < il2 && hb == u64(ir.NONE()) {
                    let ib2 = (io2 + k2) * 8;
                    if g.iri.buf[ib2] == 4 && g.iri.buf[ib2 + 2] == 0
                        && u32(g.iri64.buf[ib2 + 2]) == ar {
                        let pl2 = u64(g.iri.buf[ib2 + 1]) * 6;
                        if g.irpl.buf[pl2 + 5] == 0
                            && g.irpl.buf[pl2 + 1] == 0
                            && g.irpl.buf[pl2 + 3] == pt {
                            hb = b2 * (u64(1) << 32) + k2;
                            hs = g.irpl.buf[pl2];
                        }
                    }
                    k2 = k2 + 1;
                }
                b2 = b2 + 1;
            }
            let u = u_cnt(le, ar);
            if u == 1 && hb != u64(ir.NONE()) {
                le.ali_s = le.ali_s.push(hs);
                le.ali_p = le.ali_p.push(ar);
                le.skp = le.skp.push(hb);
            }
            if u > 1 || (u == 1 && hb == u64(ir.NONE())) {
                le.ren = le.ren.push(ar);
            }
        }
        pi = pi + 1;
    }
    // ---- scratch sizing — simulate the emitter's place-backedness:
    // a reg is place-backed after a Load / sret dst / Store of it;
    // every Call or through-pointer store invalidates the whole set.
    let live: vec.Vec<u64> = vec.Vec<u64>::new(le.heap);   // reg -> root key
    let held: vec.Vec<u64> = vec.Vec<u64>::new(le.heap);   // tyid -> count
    let need: vec.Vec<u64> = vec.Vec<u64>::new(le.heap);   // tyid -> max
    b = 0;
    while b < bl {
        let bb = (bo + b) * 8;
        let io = u64(g.irb.buf[bb + 1]);
        let il = u64(g.irb.buf[bb + 2]);
        let i: u64 = 0;
        while i < il {
            let ib = (io + i) * 8;
            let kind = g.iri.buf[ib];
            if kind == 3 {                          // Load → backed
                live = mq_put(live, g.iri.buf[ib + 1],
                              g.irpl.buf[u64(g.iri.buf[ib + 2]) * 6]);
            }
            if kind == 4 || kind == 8 || kind == 9 || kind == 10 {
                let px = g.iri.buf[ib + 1];
                if kind == 9 || kind == 10 {
                    px = g.iri.buf[ib + 2];
                }
                let pb2 = u64(px) * 6;
                if g.irpl.buf[pb2 + 1] != 0 {
                    // through-pointer write — drop everything
                    while live.len > 0 { live.pop(); }
                    while held.len > 0 { held.pop(); }
                } else {
                    live = mq_delv(live, g.irpl.buf[pb2]);
                }
            }
            if kind == 16 {
                let ext = lext(g, g.iri.buf[ib + 3]);
                let ret = g.iri.buf[ib + 2];
                let d = g.iri.buf[ib + 1];
                let ao3 = u64(g.iri.buf[ib + 4]);
                let al3 = u64(g.iri.buf[ib + 5]);
                let burst: vec.Vec<u64> = vec.Vec<u64>::new(le.heap);
                let j: u64 = 0;
                while j < al3 {
                    let ax = g.irax.buf[ao3 + j];
                    if ext == 0 && lbig(g, ax.ty) == 1 && ax.k == 0
                        && mq_has(live, u32(ax.v)) == 0 {
                        le = ltyk(le, g, ax.ty);
                        let cur = mq_get(burst, le.tkk);
                        if cur == ir.NONE() {
                            burst = mq_put(burst, le.tkk, 1);
                        } else {
                            burst = mq_put(burst, le.tkk, cur + 1);
                        }
                    }
                    j = j + 1;
                }
                // dst scratch? — the slot is acquired alongside the
                // burst while previously-held scratches still occupy.
                let dty: u32 = ir.NONE();
                if ext == 0 && lbig(g, ret) == 1 {
                    le = ltyk(le, g, ret);
                    if d == ir.NONE() {
                        dty = le.tkk;
                    } else {
                        let homes: u8 = 0;
                        if i + 1 < il {
                            let nib = (io + i + 1) * 8;
                            if g.iri.buf[nib] == 4
                                && g.iri.buf[nib + 2] == 0
                                && u32(g.iri64.buf[nib + 2]) == d {
                                homes = 1;
                            }
                        }
                        let tail: u8 = 0;
                        if le.sret == 1 && g.irb.buf[bb + 3] == 0
                            && g.irb.buf[bb + 4] != 0
                            && g.irb.buf[bb + 6] == 0
                            && u32(g.irb64.buf[bb + 6]) == d
                            && u_cnt(le, d) == 1 {
                            tail = 1;
                        }
                        if homes == 1 || tail == 1 {
                            live = mq_put(live, d, ir.NONE());
                        } else {
                            dty = le.tkk;
                        }
                    }
                }
                // max held+burst+dst per type
                let j2: u64 = 0;
                while j2 < burst.len {
                    let bt = u32(burst.buf[j2] / (u64(1) << 32));
                    let bc = u32(burst.buf[j2] % (u64(1) << 32));
                    let h = mq_get(held, bt);
                    let hc: u32 = 0;
                    if h != ir.NONE() { hc = h; }
                    let co = hc + bc;
                    if dty == bt { co = co + 1; }
                    let nd = mq_get(need, bt);
                    let nc: u32 = 0;
                    if nd != ir.NONE() { nc = nd; }
                    if co > nc { need = mq_put(need, bt, co); }
                    j2 = j2 + 1;
                }
                if dty != ir.NONE() && mq_get(burst, dty) == ir.NONE() {
                    let h = mq_get(held, dty);
                    let hc: u32 = 0;
                    if h != ir.NONE() { hc = h; }
                    let co = hc + 1;
                    let nd = mq_get(need, dty);
                    let nc: u32 = 0;
                    if nd != ir.NONE() { nc = nd; }
                    if co > nc { need = mq_put(need, dty, co); }
                }
                burst.destroy();
                // invalidation frees everything; the new dst scratch
                // becomes the held one until the NEXT write barrier.
                while live.len > 0 { live.pop(); }
                while held.len > 0 { held.pop(); }
                if d != ir.NONE() && dty != ir.NONE() {
                    held = mq_put(held, dty, 1);
                    live = mq_put(live, d, ir.NONE());
                }
            }
            i = i + 1;
        }
        // a Ret operand with no backing storage takes a scratch.
        if g.irb.buf[bb + 3] == 0 && g.irb.buf[bb + 4] != 0
            && g.irb.buf[bb + 6] == 0 {
            let ty2 = g.irb.buf[bb + 5];
            if lbig(g, ty2) == 1
                && mq_has(live, u32(g.irb64.buf[bb + 6])) == 0 {
                le = ltyk(le, g, ty2);
                let h = mq_get(held, le.tkk);
                let hc: u32 = 0;
                if h != ir.NONE() { hc = h; }
                let co = hc + 1;
                let nd = mq_get(need, le.tkk);
                let nc: u32 = 0;
                if nd != ir.NONE() { nc = nd; }
                if co > nc { need = mq_put(need, le.tkk, co); }
            }
        }
        b = b + 1;
    }
    // materialize pools — types sorted by llty text for deterministic
    // %sN naming (s0 sorts the type-key strings). need's keys are
    // pool keys; tk_r gives a representative tyid for rendering.
    let tb: vec.Vec<u8> = vec.Vec<u8>::new(le.heap);      // shared arena
    let tys: vec.Vec<u32> = vec.Vec<u32>::new(le.heap);    // pool keys
    let tsp: vec.Vec<u64> = vec.Vec<u64>::new(le.heap);    // (off<<32)|len
    let i: u64 = 0;
    while i < need.len {
        let t = u32(need.buf[i] / (u64(1) << 32));
        let off = tb.len;
        tb = ltyb(tb, g, le.tk_r.buf[u64(t)]);
        tys = tys.push(t);
        tsp = tsp.push(off * (u64(1) << 32) + (tb.len - off));
        i = i + 1;
    }
    // insertion sort by rendered text
    i = 1;
    while i < tys.len {
        let x = tys.buf[i];
        let xs = tsp.buf[i];
        let j = i;
        while j > 0 {
            let ys = tsp.buf[j - 1];
            if tless(tb, xs / (u64(1) << 32), xs % (u64(1) << 32),
                     ys / (u64(1) << 32), ys % (u64(1) << 32)) == 1 {
                tys.buf[j] = tys.buf[j - 1];
                tsp.buf[j] = tsp.buf[j - 1];
                j = j - 1;
            } else { break; }
        }
        tys.buf[j] = x;
        tsp.buf[j] = xs;
        i = i + 1;
    }
    i = 0;
    while i < tys.len {
        let t = tys.buf[i];
        let cnt = mq_get(need, t);
        let n: u32 = 0;
        if cnt != ir.NONE() { n = cnt; }
        let q: u32 = 0;
        while q < n {
            le.sal_t = le.sal_t.push(le.tk_r.buf[u64(t)]);
            le.sal_n = le.sal_n.push(le.scn);
            le.scr = le.scr.push(u64(t) * (u64(1) << 32) + u64(le.scn));
            le.scn = le.scn + 1;
            q = q + 1;
        }
        i = i + 1;
    }
    live.destroy(); held.destroy(); need.destroy();
    tb.destroy(); tys.destroy(); tsp.destroy();
    return le;
}

// ---- emit_place ------------------------------------------------------

/// the `%v`/`%p` name of the running address.
fn l_addr(own le: LE) -> LE {
    if le.akind == 1 { return lpr(le, le.anum); }
    return lvr(le, le.anum);
}
/// `deref_wrap` — mutex/guard aggregates route through
/// `mml_mutex_data` before the next hop.
fn l_deref_wrap(own le: LE, read g: ir.G) -> LE {
    let ty = g.c.r.rtys.buf[u64(le.curty)];
    let k = u32(ty.kind);
    if k != 21 && k != 22 { return le; }
    let inner = ty.a;
    le = lputs(le, "    ");
    le = lpr(le, le.tmp);
    let base = le.tmp;
    le.tmp = le.tmp + 1;
    le = lputs(le, " = load ptr, ptr ");
    le = l_addr(le);
    le.out = le.out.push(u8(10));
    le = lputs(le, "    ");
    le = lpr(le, le.tmp);
    le.tmp = le.tmp + 1;
    le = lputs(le, " = call ptr @mml_mutex_data(ptr ");
    le = lpr(le, base);
    le = lputs(le, ")\n");
    le.curty = inner;
    le.akind = 1;
    le.anum = le.tmp - 1;
    return le;
}
/// GEP chain for the recorded place `pi` — result in akind/anum.
fn l_place(own le: LE, read g: ir.G, pi: u32) -> LE {
    let pb = u64(pi) * 6;
    let root = g.irpl.buf[pb];
    le.curty = g.irpl.buf[pb + 2];
    le.akind = 0;
    le.anum = root;
    // a `local` slot aliases the incoming param ptr when it homes an
    // own-big argument — the slot name never materializes (N78).
    if g.irpl.buf[pb + 1] == 0 {
        let i: u64 = 0;
        while i < le.ali_s.len {
            if le.ali_s.buf[i] == root {
                le.anum = le.ali_p.buf[i];
                break;
            }
            i = i + 1;
        }
    }
    let po = u64(g.irpl.buf[pb + 4]);
    let pl = u64(g.irpl.buf[pb + 5]);
    let i: u64 = 0;
    while i < pl {
        let pe = g.irpe.buf[po + i];
        le = l_deref_wrap(le, g);
        // (sel printed inline below; `next`/`direct` per hop kind)
        let direct: u8 = 0;
        let next: u32 = 0;
        if pe.kind == u8(0) {
            next = pe.ty;
        } else {
            let cty = g.c.r.rtys.buf[u64(le.curty)];
            if u32(cty.kind) == 14 {
                next = cty.a;
            } else {
                // `*T` index — single-index GEP on the pointee.
                next = cty.a;
                direct = 1;
            }
        }
        let gnum = le.tmp;
        le.tmp = le.tmp + 1;
        le = lputs(le, "    ");
        le = lpr(le, gnum);
        le = lputs(le, " = getelementptr ");
        if direct == 1 {
            le = lty(le, g.c.r, next);
            le = lputs(le, ", ptr ");
            le = l_addr(le);
            le = lputs(le, ", ");
            le = lty(le, g.c.r, pe.ty);
            le.out = le.out.push(u8(32));
            le = lop(le, g, u32(pe.kind) - 1, pe.ov);
            le.out = le.out.push(u8(10));
        } else {
            // `*v.field` — GEP the pointee, not `ptr` itself.
            let cty2 = g.c.r.rtys.buf[u64(le.curty)];
            let pointee = le.curty;
            if u32(cty2.kind) == 16 { pointee = cty2.a; }
            le = lty(le, g.c.r, pointee);
            le = lputs(le, ", ptr ");
            le = l_addr(le);
            le = lputs(le, ", i32 0, ");
            if pe.kind == u8(0) {
                le = lputs(le, "i32 ");
                le = lu32(le, pe.idx);
            } else {
                le = lty(le, g.c.r, pe.ty);
                le.out = le.out.push(u8(32));
                le = lop(le, g, u32(pe.kind) - 1, pe.ov);
            }
            le.out = le.out.push(u8(10));
        }
        le.akind = 1;
        le.anum = gnum;
        le.curty = next;
        i = i + 1;
    }
    return le;
}

// ---- binop / instr ----------------------------------------------------

fn l_binop(own le: LE, read g: ir.G, op: u32, t: u32) -> LE {
    let s = lsigned(g.c.r, t);
    if op == 0 { return lputs(le, "add"); }
    if op == 1 { return lputs(le, "sub"); }
    if op == 2 { return lputs(le, "mul"); }
    if op == 3 {
        if s == 1 { return lputs(le, "sdiv"); }
        return lputs(le, "udiv");
    }
    if op == 4 {
        if s == 1 { return lputs(le, "srem"); }
        return lputs(le, "urem");
    }
    if op == 5 { return lputs(le, "icmp eq"); }
    if op == 6 { return lputs(le, "icmp ne"); }
    if op == 7 {
        if s == 1 { return lputs(le, "icmp slt"); }
        return lputs(le, "icmp ult");
    }
    if op == 8 {
        if s == 1 { return lputs(le, "icmp sgt"); }
        return lputs(le, "icmp ugt");
    }
    if op == 9 {
        if s == 1 { return lputs(le, "icmp sle"); }
        return lputs(le, "icmp ule");
    }
    if op == 10 {
        if s == 1 { return lputs(le, "icmp sge"); }
        return lputs(le, "icmp uge");
    }
    if op == 11 { return lputs(le, "shl"); }
    if op == 12 {
        if s == 1 { return lputs(le, "ashr"); }
        return lputs(le, "lshr");
    }
    if op == 13 { return lputs(le, "and"); }
    if op == 14 { return lputs(le, "or"); }
    return lputs(le, "xor");
}

/// emit one instruction — `ib` = its iri slot base.
fn l_instr(own le: LE, read g: ir.G, ib: u64) -> LE {
    let kind = g.iri.buf[ib];
    if kind == 0 { return le; }                  // Arg — no instr
    if kind == 1 {                               // Local → alloca
        // an own-big param's home aliases the incoming ptr — the
        // slot never materializes (N78).
        let i: u64 = 0;
        while i < le.ali_s.len {
            if le.ali_s.buf[i] == g.iri.buf[ib + 1] { return le; }
            i = i + 1;
        }
        le = lputs(le, "    ");
        le = lvr(le, g.iri.buf[ib + 1]);
        le = lputs(le, " = alloca ");
        le = lty(le, g.c.r, g.iri.buf[ib + 2]);
        le.out = le.out.push(u8(10));
        return le;
    }
    if kind == 2 {                               // Const
        let dst = g.iri.buf[ib + 1];
        let ty = g.iri.buf[ib + 2];
        let val = g.iri64.buf[ib + 3];
        // is the llty "ptr" / aggregate / scalar? classify by kind.
        let tk = u32(g.c.r.rtys.buf[u64(ty)].kind);
        let isptr = tk == 11 || tk == 15 || tk == 16 || tk == 18
            || tk == 19 || tk == 21 || tk == 22 || tk == 23
            || tk == 24 || tk == 26;
        // aggregate == llty starts '%' or '[' — s0's string check;
        // `{ptr, i64}` kinds (str/slice/boxslice) fall to `add`.
        let isagg = tk == 12 || tk == 13 || tk == 14;
        le = lputs(le, "    ");
        if isptr {
            le = lvr(le, dst);
            le = lputs(le, " = inttoptr i64 ");
            le = li64(le, val);
            le = lputs(le, " to ptr\n");
            return le;
        }
        if isagg {
            let s = le.tmp;
            le.tmp = le.tmp + 1;
            le = lpr(le, s);
            le = lputs(le, " = alloca ");
            le = lty(le, g.c.r, ty);
            le = lputs(le, "\n    store ");
            le = lty(le, g.c.r, ty);
            le = lputs(le, " zeroinitializer, ptr ");
            le = lpr(le, s);
            le = lputs(le, "\n    ");
            le = lvr(le, dst);
            le = lputs(le, " = load ");
            le = lty(le, g.c.r, ty);
            le = lputs(le, ", ptr ");
            le = lpr(le, s);
            le.out = le.out.push(u8(10));
            // the zeroed slot backs the value — usable as an arg
            // address directly (N78).
            le = rp_set(le, dst, 1, s, ir.NONE(), ir.NONE());
            return le;
        }
        le = lvr(le, dst);
        le = lputs(le, " = add ");
        le = lty(le, g.c.r, ty);
        le = lputs(le, " 0, ");
        le = li64(le, val);
        le.out = le.out.push(u8(10));
        return le;
    }
    if kind == 3 {                               // Load
        let pi = g.iri.buf[ib + 2];
        le = l_place(le, g, pi);
        le = lputs(le, "    ");
        le = lvr(le, g.iri.buf[ib + 1]);
        le = lputs(le, " = load ");
        le = lty(le, g.c.r, g.irpl.buf[u64(pi) * 6 + 3]);
        le = lputs(le, ", ptr ");
        le = l_addr(le);
        le.out = le.out.push(u8(10));
        le = rp_set(le, g.iri.buf[ib + 1], le.akind, le.anum,
                    g.irpl.buf[u64(pi) * 6], ir.NONE());
        return le;
    }
    if kind == 4 {                               // Store
        let pi = g.iri.buf[ib + 1];
        // a call's sret already wrote straight into this place —
        // the store is dead (N78 homed-dest).
        if g.iri.buf[ib + 2] == 0 {
            let v = u32(g.iri64.buf[ib + 2]);
            let i: u64 = 0;
            while i < le.hom_r.len {
                if le.hom_r.buf[i] == v {
                    let mp = le.hom_p.buf[i];
                    let j = i;
                    while j + 1 < le.hom_r.len {
                        le.hom_r.buf[j] = le.hom_r.buf[j + 1];
                        le.hom_p.buf[j] = le.hom_p.buf[j + 1];
                        j = j + 1;
                    }
                    le.hom_r.pop(); le.hom_p.pop();
                    if mp == pi { return le; }
                    break;
                }
                i = i + 1;
            }
        }
        le = l_place(le, g, pi);
        // storing a value into the address it already occupies — a
        // self-copy the new arg convention leaves behind.
        if g.iri.buf[ib + 2] == 0 {
            let v = u32(g.iri64.buf[ib + 2]);
            let ri = rp_find(le, v);
            if ri != u64(ir.NONE()) && le.rp_k.buf[ri] == le.akind
                && le.rp_n.buf[ri] == le.anum {
                return le;
            }
        }
        le = lputs(le, "    store ");
        le = lty(le, g.c.r, g.irpl.buf[u64(pi) * 6 + 3]);
        le.out = le.out.push(u8(32));
        le = lov(le, g, g.iri.buf[ib + 2], g.iri64.buf[ib + 2]);
        le = lputs(le, ", ptr ");
        le = l_addr(le);
        le.out = le.out.push(u8(10));
        // a store writes memory — invalidate the whole root (or
        // everything for a through-pointer write), then record the
        // stored reg as living at this address.
        let pb = u64(pi) * 6;
        let rk = g.irpl.buf[pb];
        if g.irpl.buf[pb + 1] == 0 {
            le = rp_kill(le, rk);
        } else {
            le = rp_clear(le);
            rk = ir.NONE();
        }
        if g.iri.buf[ib + 2] == 0 {
            le = rp_set(le, u32(g.iri64.buf[ib + 2]), le.akind,
                        le.anum, rk, ir.NONE());
        }
        return le;
    }
    if kind == 5 || kind == 6 {                  // Addr / MakeHandle
        le = l_place(le, g, g.iri.buf[ib + 2]);
        le = lputs(le, "    ");
        le = lvr(le, g.iri.buf[ib + 1]);
        le = lputs(le, " = getelementptr ");
        le = lty(le, g.c.r,
                 g.irpl.buf[u64(g.iri.buf[ib + 2]) * 6 + 3]);
        le = lputs(le, ", ptr ");
        le = l_addr(le);
        le = lputs(le, ", i32 0\n");
        return le;
    }
    if kind == 7 {                               // ALoad
        let pi = g.iri.buf[ib + 2];
        le = l_place(le, g, pi);
        let lt = g.irpl.buf[u64(pi) * 6 + 3];
        let al = lbits(g.c.r, lt) / 8;
        if al == 0 { al = 1; }
        le = lputs(le, "    ");
        le = lvr(le, g.iri.buf[ib + 1]);
        le = lputs(le, " = load atomic ");
        le = lty(le, g.c.r, lt);
        le = lputs(le, ", ptr ");
        le = l_addr(le);
        le = lputs(le, " seq_cst, align ");
        le = lu32(le, al);
        le.out = le.out.push(u8(10));
        le = rp_set(le, g.iri.buf[ib + 1], le.akind, le.anum,
                    g.irpl.buf[u64(pi) * 6], ir.NONE());
        return le;
    }
    if kind == 8 {                               // AStore
        let pi = g.iri.buf[ib + 1];
        le = l_place(le, g, pi);
        let lt = g.irpl.buf[u64(pi) * 6 + 3];
        let al = lbits(g.c.r, lt) / 8;
        if al == 0 { al = 1; }
        le = lputs(le, "    store atomic ");
        le = lty(le, g.c.r, lt);
        le.out = le.out.push(u8(32));
        le = lop(le, g, g.iri.buf[ib + 2], g.iri64.buf[ib + 2]);
        le = lputs(le, ", ptr ");
        le = l_addr(le);
        le = lputs(le, " seq_cst, align ");
        le = lu32(le, al);
        le.out = le.out.push(u8(10));
        if g.irpl.buf[u64(pi) * 6 + 1] == 0 {
            le = rp_kill(le, g.irpl.buf[u64(pi) * 6]);
        } else {
            le = rp_clear(le);
        }
        return le;
    }
    if kind == 9 {                               // AAdd
        le = l_place(le, g, g.iri.buf[ib + 2]);
        let lt = g.irpl.buf[u64(g.iri.buf[ib + 2]) * 6 + 3];
        le = lputs(le, "    ");
        le = lvr(le, g.iri.buf[ib + 1]);
        le = lputs(le, " = atomicrmw add ptr ");
        le = l_addr(le);
        le = lputs(le, ", ");
        le = lty(le, g.c.r, lt);
        le.out = le.out.push(u8(32));
        le = lop(le, g, g.iri.buf[ib + 3], g.iri64.buf[ib + 3]);
        le = lputs(le, " seq_cst\n");
        return le;
    }
    if kind == 10 {                              // ACas
        let pi = g.iri.buf[ib + 2];
        le = l_place(le, g, pi);
        let lt = g.irpl.buf[u64(pi) * 6 + 3];
        let al = lbits(g.c.r, lt) / 8;
        if al == 0 { al = 1; }
        let pair = le.tmp;
        le.tmp = le.tmp + 1;
        le = lputs(le, "    ");
        le = lpr(le, pair);
        le = lputs(le, " = cmpxchg ptr ");
        le = l_addr(le);
        le = lputs(le, ", ");
        le = lty(le, g.c.r, lt);
        le.out = le.out.push(u8(32));
        le = lop(le, g, g.iri.buf[ib + 3], g.iri64.buf[ib + 3]);
        le = lputs(le, ", ");
        le = lty(le, g.c.r, lt);
        le.out = le.out.push(u8(32));
        le = lop(le, g, g.iri.buf[ib + 4], g.iri64.buf[ib + 4]);
        le = lputs(le, " seq_cst seq_cst, align ");
        le = lu32(le, al);
        le = lputs(le, "\n    ");
        le = lvr(le, g.iri.buf[ib + 1]);
        le = lputs(le, " = extractvalue {");
        le = lty(le, g.c.r, lt);
        le = lputs(le, ", i1} ");
        le = lpr(le, pair);
        le = lputs(le, ", 1\n");
        if g.irpl.buf[u64(pi) * 6 + 1] == 0 {
            le = rp_kill(le, g.irpl.buf[u64(pi) * 6]);
        } else {
            le = rp_clear(le);
        }
        return le;
    }
    if kind == 11 {                              // Bin
        le = lputs(le, "    ");
        le = lvr(le, g.iri.buf[ib + 1]);
        le = lputs(le, " = ");
        le = l_binop(le, g, g.iri.buf[ib + 2], g.iri.buf[ib + 3]);
        le.out = le.out.push(u8(32));
        le = lty(le, g.c.r, g.iri.buf[ib + 3]);
        le.out = le.out.push(u8(32));
        le = lop(le, g, g.iri.buf[ib + 4], g.iri64.buf[ib + 4]);
        le = lputs(le, ", ");
        le = lop(le, g, g.iri.buf[ib + 5], g.iri64.buf[ib + 5]);
        le.out = le.out.push(u8(10));
        return le;
    }
    if kind == 12 {                              // Unary
        let op = g.iri.buf[ib + 2];
        let ty = g.iri.buf[ib + 3];
        le = lputs(le, "    ");
        le = lvr(le, g.iri.buf[ib + 1]);
        if op == 0 {                             // neg
            le = lputs(le, " = sub ");
            le = lty(le, g.c.r, ty);
            le = lputs(le, " 0, ");
        }
        if op == 1 {                             // not
            le = lputs(le, " = icmp eq ");
            le = lty(le, g.c.r, ty);
            le = lputs(le, " 0, ");
        }
        if op == 2 {                             // bnot
            le = lputs(le, " = xor ");
            le = lty(le, g.c.r, ty);
            le = lputs(le, " -1, ");
        }
        le = lop(le, g, g.iri.buf[ib + 4], g.iri64.buf[ib + 4]);
        le.out = le.out.push(u8(10));
        return le;
    }
    if kind == 13 {                              // StrAddr
        le = lputs(le, "    ");
        le = lvr(le, g.iri.buf[ib + 1]);
        le = lputs(le, " = getelementptr inbounds [");
        le = li64(le, g.iri64.buf[ib + 2]);
        le = lputs(le, " x i8], ptr @.str.");
        le = li64(le, g.iri64.buf[ib + 1]);
        le = lputs(le, ", i32 0, i32 0\n");
        return le;
    }
    if kind == 14 {                              // Cast
        let dst = g.iri.buf[ib + 1];
        let to = g.iri.buf[ib + 2];
        let from = g.iri.buf[ib + 3];
        let fw = lcastw(g.c.r, from);
        let tw = lcastw(g.c.r, to);
        le = lputs(le, "    ");
        le = lvr(le, dst);
        if fw == tw {
            le = lputs(le, " = add ");
            le = lty(le, g.c.r, to);
            le.out = le.out.push(u8(32));
            le = lop(le, g, g.iri.buf[ib + 4], g.iri64.buf[ib + 4]);
            le = lputs(le, ", 0\n");
            return le;
        }
        if fw < tw {
            if lsigned(g.c.r, from) == 1 {
                le = lputs(le, " = sext ");
            } else {
                le = lputs(le, " = zext ");
            }
        } else {
            le = lputs(le, " = trunc ");
        }
        le = lty(le, g.c.r, from);
        le.out = le.out.push(u8(32));
        le = lop(le, g, g.iri.buf[ib + 4], g.iri64.buf[ib + 4]);
        le = lputs(le, " to ");
        le = lty(le, g.c.r, to);
        le.out = le.out.push(u8(10));
        return le;
    }
    if kind == 15 {                              // Extract
        le = lputs(le, "    ");
        le = lvr(le, g.iri.buf[ib + 1]);
        le = lputs(le, " = extractvalue {ptr, i64} ");
        le = lov(le, g, g.iri.buf[ib + 3], g.iri64.buf[ib + 3]);
        le = lputs(le, ", ");
        le = lu32(le, g.iri.buf[ib + 4]);
        le.out = le.out.push(u8(10));
        return le;
    }
    // kind == 16 — Call (N78 convention for non-extern big-agg fns)
    let d = g.iri.buf[ib + 1];
    let ret = g.iri.buf[ib + 2];
    let nm = g.iri.buf[ib + 3];
    let ao = u64(g.iri.buf[ib + 4]);
    let al = u64(g.iri.buf[ib + 5]);
    let ext = lext(g, nm);
    let sret2: u8 = 0;
    if ext == 0 && lbig(g, ret) == 1 { sret2 = 1; }
    // sret destination: the slot the result would be stored to (the
    // store lookahead), %sret for `return f(g)` chains, or a pooled
    // scratch slot when the value has no dedicated home.
    let dk: u32 = 0;
    let dn: u32 = 0;
    let dscr: u8 = 0;
    let dtk: u32 = ir.NONE();
    let drk: u32 = ir.NONE();
    let homk: u8 = 0;                    // 0 none 1 place 2 sret 3 scratch
    if sret2 == 1 {
        if d != ir.NONE() {
            let homed: u8 = 0;
            if le.nxt != u64(ir.NONE()) && g.iri.buf[le.nxt] == 4
                && g.iri.buf[le.nxt + 2] == 0
                && u32(g.iri64.buf[le.nxt + 2]) == d {
                homed = 1;
            }
            if homed == 1 {
                let npi = g.iri.buf[le.nxt + 1];
                le = l_place(le, g, npi);
                le.hom_r = le.hom_r.push(d);
                le.hom_p = le.hom_p.push(npi);
                drk = g.irpl.buf[u64(npi) * 6];
                dk = le.akind;
                dn = le.anum;
                homk = 1;
            } else {
                let tail: u8 = 0;
                if le.sret == 1 && g.irb.buf[le.cbb + 3] == 0
                    && g.irb.buf[le.cbb + 4] != 0
                    && g.irb.buf[le.cbb + 6] == 0
                    && u32(g.irb64.buf[le.cbb + 6]) == d
                    && u_cnt(le, d) == 1 {
                    tail = 1;
                }
                if tail == 1 {
                    dk = 2; dn = 0; homk = 2;
                } else {
                    le = scr_take(le, g, ret);
                    dk = 3; dn = le.scgot; dscr = 1; homk = 3;
                    dtk = le.tkk;
                }
            }
        } else {
            le = scr_take(le, g, ret);
            dk = 3; dn = le.scgot; dscr = 1;
            dtk = le.tkk;
        }
    }
    // args — big-agg operands go by pointer to their current storage;
    // unbacked values materialize into pool slots first. Pending
    // specs ride le.cak/cat/cok/cov/cpk/cpn until the line prints.
    while le.cak.len > 0 {
        le.cak.pop(); le.cat.pop(); le.cok.pop();
        le.cov.pop(); le.cpk.pop(); le.cpn.pop();
    }
    let freed: vec.Vec<u64> = vec.Vec<u64>::new(le.heap);
    let i: u64 = 0;
    while i < al {
        let ax = g.irax.buf[ao + i];
        if ext == 1 || lbig(g, ax.ty) == 0 {
            le.cak = le.cak.push(u32(0));
            le.cat = le.cat.push(ax.ty);
            le.cok = le.cok.push(ax.k);
            le.cov = le.cov.push(ax.v);
            le.cpk = le.cpk.push(u32(0));
            le.cpn = le.cpn.push(u32(0));
        } else {
            let ak2: u32 = 0;
            let an2: u32 = 0;
            let have: u8 = 0;
            if ax.k == 0 {
                let ri = rp_find(le, u32(ax.v));
                if ri != u64(ir.NONE()) {
                    ak2 = le.rp_k.buf[ri];
                    an2 = le.rp_n.buf[ri];
                    have = 1;
                }
            }
            if have == 0 {
                le = scr_take(le, g, ax.ty);
                let sn = le.scgot;
                le = lputs(le, "    store ");
                le = lty(le, g.c.r, ax.ty);
                le.out = le.out.push(u8(32));
                le = lov(le, g, ax.k, ax.v);
                le = lputs(le, ", ptr %s");
                le = lu32(le, sn);
                le.out = le.out.push(u8(10));
                freed = freed.push(
                    u64(le.tkk) * (u64(1) << 32) + u64(sn));
                ak2 = 3;
                an2 = sn;
            }
            le.cak = le.cak.push(u32(1));
            le.cat = le.cat.push(u32(0));
            le.cok = le.cok.push(u32(0));
            le.cov = le.cov.push(i64(0));
            le.cpk = le.cpk.push(ak2);
            le.cpn = le.cpn.push(an2);
        }
        i = i + 1;
    }
    le = lputs(le, "    ");
    if sret2 == 1 {
        le = lputs(le, "call void @");
        le = llsym(le, g.c.r, nm);
        le.out = le.out.push(u8(40));
        le = lputs(le, "ptr ");
        le = lpak(le, dk, dn);
        i = 0;
        while i < al {
            le = lputs(le, ", ");
            if le.cak.buf[i] == 0 {
                le = lty(le, g.c.r, le.cat.buf[i]);
                le.out = le.out.push(u8(32));
                le = lov(le, g, le.cok.buf[i], le.cov.buf[i]);
            } else {
                le = lputs(le, "ptr ");
                le = lpak(le, le.cpk.buf[i], le.cpn.buf[i]);
            }
            i = i + 1;
        }
        le = lputs(le, ")\n");
    } else {
        if d != ir.NONE() {
            le = lvr(le, d);
            le = lputs(le, " = call ");
        } else {
            le = lputs(le, "call ");
        }
        le = lty(le, g.c.r, ret);
        le = lputs(le, " @");
        le = llsym(le, g.c.r, nm);
        le.out = le.out.push(u8(40));
        i = 0;
        while i < al {
            if i > 0 { le = lputs(le, ", "); }
            if le.cak.buf[i] == 0 {
                le = lty(le, g.c.r, le.cat.buf[i]);
                le.out = le.out.push(u8(32));
                le = lov(le, g, le.cok.buf[i], le.cov.buf[i]);
            } else {
                le = lputs(le, "ptr ");
                le = lpak(le, le.cpk.buf[i], le.cpn.buf[i]);
            }
            i = i + 1;
        }
        le = lputs(le, ")\n");
    }
    // the call may write anywhere — cached addresses are dead; arg
    // scratches are consumed and recycle.
    le = rp_clear(le);
    let fi2: u64 = 0;
    while fi2 < freed.len {
        le.scr = le.scr.push(freed.buf[fi2]);
        fi2 = fi2 + 1;
    }
    freed.destroy();
    if sret2 == 1 && d != ir.NONE() {
        // value-uses of the dst beyond the homed store / tail ret
        // need the reg bound — one reload.
        let covered: u32 = 0;
        if homk == 1 || homk == 2 { covered = 1; }
        if u_cnt(le, d) > covered {
            le = lputs(le, "    ");
            le = lvr(le, d);
            le = lputs(le, " = load ");
            le = lty(le, g.c.r, ret);
            le = lputs(le, ", ptr ");
            le = lpak(le, dk, dn);
            le.out = le.out.push(u8(10));
        }
        let st = ir.NONE();
        if dscr == 1 { st = dtk; }
        le = rp_set(le, d, dk, dn, drk, st);
    }
    if sret2 == 1 && d == ir.NONE() && dscr == 1 {
        le.scr = le.scr.push(u64(dtk) * (u64(1) << 32) + u64(dn));
    }
    return le;
}

/// emit a block terminator — `bb` = its irb slot base.
fn l_term(own le: LE, read g: ir.G, bb: u64) -> LE {
    let tk = g.irb.buf[bb + 3];
    if tk == 0 {                                 // Ret
        if g.irb.buf[bb + 4] == 0 {
            le = lputs(le, "    ret void\n");
            return le;
        }
        if le.sret == 1 {
            // the result goes to the caller's destination — a tail
            // call already wrote it there (self-copy elided).
            let vty = g.irb.buf[bb + 5];
            let sk: u32 = 0;
            let sn: u32 = 0;
            let have: u8 = 0;
            if g.irb.buf[bb + 6] == 0 {
                let ri = rp_find(le, u32(g.irb64.buf[bb + 6]));
                if ri != u64(ir.NONE()) {
                    sk = le.rp_k.buf[ri];
                    sn = le.rp_n.buf[ri];
                    have = 1;
                }
            }
            if have == 0 {
                le = scr_take(le, g, vty);
                let n = le.scgot;
                le = lputs(le, "    store ");
                le = lty(le, g.c.r, vty);
                le.out = le.out.push(u8(32));
                le = lov(le, g, g.irb.buf[bb + 6],
                         g.irb64.buf[bb + 6]);
                le = lputs(le, ", ptr %s");
                le = lu32(le, n);
                le.out = le.out.push(u8(10));
                sk = 3;
                sn = n;
            }
            if sk != 2 {
                let bytes = llay(g, vty) / 16 / 8;
                le = lputs(le, "    call void @llvm.memmove.p0.p0.i64(ptr %sret, ptr ");
                le = lpak(le, sk, sn);
                le = lputs(le, ", i64 ");
                le = li64(le, i64(bytes));
                le = lputs(le, ", i1 false)\n");
                le.mm = 1;
            }
            le = lputs(le, "    ret void\n");
            return le;
        }
        le = lputs(le, "    ret ");
        le = lty(le, g.c.r, g.irb.buf[bb + 5]);
        le.out = le.out.push(u8(32));
        le = lov(le, g, g.irb.buf[bb + 6], g.irb64.buf[bb + 6]);
        le.out = le.out.push(u8(10));
        return le;
    }
    if tk == 1 {                                 // Br
        le = lputs(le, "    br i1 ");
        le = lov(le, g, g.irb.buf[bb + 4], g.irb64.buf[bb + 4]);
        le = lputs(le, ", label %");
        le = l_lbl(le, g, g.irb.buf[bb + 5]);
        le = lputs(le, ", label %");
        le = l_lbl(le, g, g.irb.buf[bb + 6]);
        le.out = le.out.push(u8(10));
        return le;
    }
    if tk == 2 {                                 // Jmp
        le = lputs(le, "    br label %");
        le = l_lbl(le, g, g.irb.buf[bb + 4]);
        le.out = le.out.push(u8(10));
        return le;
    }
    le = lputs(le, "    unreachable\n");
    return le;
}
/// the label's text from the shared arena.
fn l_lbl(own le: LE, read g: ir.G, id: u32) -> LE {
    let sp = g.lbls.buf[u64(id)];
    let i = u64(sp.off);
    let jn = i + u64(sp.len);
    while i < jn {
        le.out = le.out.push(g.lbyt.buf[i]);
        i = i + 1;
    }
    return le;
}

// ---- runtime declares --------------------------------------------------

/// `rt_sig` — le.work[0]=is-rt, work[1]=ret-kind-code... instead
/// emit the declare line directly when `nm` names a runtime fn.
fn l_rtdecl(own le: LE, read g: ir.G, nid: u32) -> LE {
    le = lputs(le, "declare ");
    // ret + arg spell per name — the table walks rns text.

    if nstarts(g.c.r, nid, "mml_task_spawn") == 1 {
        le = lputs(le, "ptr @mml_task_spawn(ptr, ptr)\n");
        return le;
    }
    if nstarts(g.c.r, nid, "mml_task_join") == 1 {
        le = lputs(le, "void @mml_task_join(ptr)\n");
        return le;
    }
    if nstarts(g.c.r, nid, "mml_mutex_new") == 1 {
        le = lputs(le, "ptr @mml_mutex_new(i64)\n");
        return le;
    }
    if nstarts(g.c.r, nid, "mml_mutex_wrap") == 1 {
        le = lputs(le, "ptr @mml_mutex_wrap(ptr)\n");
        return le;
    }
    if nstarts(g.c.r, nid, "mml_mutex_data") == 1 {
        le = lputs(le, "ptr @mml_mutex_data(ptr)\n");
        return le;
    }
    if nstarts(g.c.r, nid, "mml_mutex_lock") == 1 {
        le = lputs(le, "ptr @mml_mutex_lock(ptr)\n");
        return le;
    }
    if nstarts(g.c.r, nid, "mml_mutex_unlock") == 1 {
        le = lputs(le, "void @mml_mutex_unlock(ptr)\n");
        return le;
    }
    if nstarts(g.c.r, nid, "mml_chan_new_bounded") == 1 {
        le = lputs(le, "ptr @mml_chan_new_bounded(i64, i64)\n");
        return le;
    }
    if nstarts(g.c.r, nid, "mml_chan_send_bounded") == 1 {
        le = lputs(le, "i32 @mml_chan_send_bounded(ptr, ptr)\n");
        return le;
    }
    if nstarts(g.c.r, nid, "mml_chan_new") == 1 {
        le = lputs(le, "ptr @mml_chan_new(i64)\n");
        return le;
    }
    if nstarts(g.c.r, nid, "mml_chan_send") == 1 {
        le = lputs(le, "void @mml_chan_send(ptr, ptr)\n");
        return le;
    }
    if nstarts(g.c.r, nid, "mml_chan_recv_bounded") == 1 {
        le = lputs(le, "i32 @mml_chan_recv_bounded(ptr, ptr)\n");
        return le;
    }
    if nstarts(g.c.r, nid, "mml_chan_recv") == 1 {
        le = lputs(le, "void @mml_chan_recv(ptr, ptr)\n");
        return le;
    }
    if nstarts(g.c.r, nid, "mml_chan_close") == 1 {
        le = lputs(le, "void @mml_chan_close(ptr)\n");
        return le;
    }
    if nstarts(g.c.r, nid, "mml_bounds_check") == 1 {
        le = lputs(le, "void @mml_bounds_check(i64, i64)\n");
        return le;
    }
    if nstarts(g.c.r, nid, "mml_bounds_fail") == 1 {
        le = lputs(le, "void @mml_bounds_fail(i64, i64)");
        le = lputs(le, " noreturn cold\n");
        return le;
    }
    if nstarts(g.c.r, nid, "mml_range_check") == 1 {
        le = lputs(le, "void @mml_range_check(i64, i64, i64)\n");
        return le;
    }
    if nstarts(g.c.r, nid, "mml_shift_check") == 1 {
        le = lputs(le, "void @mml_shift_check(i64, i64)\n");
        return le;
    }
    if nstarts(g.c.r, nid, "mml_str_eq") == 1 {
        le = lputs(le, "i32 @mml_str_eq(ptr, i64, ptr, i64)\n");
        return le;
    }
    if nstarts(g.c.r, nid, "mml_str_validate") == 1 {
        le = lputs(le, "void @mml_str_validate(ptr, i64)\n");
        return le;
    }
    if nstarts(g.c.r, nid, "mml_alloc_slice") == 1 {
        le = lputs(le, "ptr @mml_alloc_slice(i64, i64)\n");
        return le;
    }
    if nstarts(g.c.r, nid, "mml_alloc") == 1 {
        le = lputs(le, "ptr @mml_alloc(i64)\n");
        return le;
    }
    if nstarts(g.c.r, nid, "mml_free") == 1 {
        le = lputs(le, "void @mml_free(ptr)\n");
        return le;
    }
    return le;
}
/// is `nid` one of the rt_sig names? — same table, boolean answer.
fn l_is_rt(read r: resolve.Resolver, nid: u32) -> u8 {
    if nstarts(r, nid, "mml_task_spawn") == 1 { return 1; }
    if nstarts(r, nid, "mml_task_join") == 1 { return 1; }
    if nstarts(r, nid, "mml_mutex_new") == 1 { return 1; }
    if nstarts(r, nid, "mml_mutex_wrap") == 1 { return 1; }
    if nstarts(r, nid, "mml_mutex_data") == 1 { return 1; }
    if nstarts(r, nid, "mml_mutex_lock") == 1 { return 1; }
    if nstarts(r, nid, "mml_mutex_unlock") == 1 { return 1; }
    if nstarts(r, nid, "mml_chan_new_bounded") == 1 { return 1; }
    if nstarts(r, nid, "mml_chan_send_bounded") == 1 { return 1; }
    if nstarts(r, nid, "mml_chan_recv_bounded") == 1 { return 1; }
    if nstarts(r, nid, "mml_chan_new") == 1 { return 1; }
    if nstarts(r, nid, "mml_chan_send") == 1 { return 1; }
    if nstarts(r, nid, "mml_chan_recv") == 1 { return 1; }
    if nstarts(r, nid, "mml_chan_close") == 1 { return 1; }
    if nstarts(r, nid, "mml_bounds_check") == 1 { return 1; }
    if nstarts(r, nid, "mml_bounds_fail") == 1 { return 1; }
    if nstarts(r, nid, "mml_range_check") == 1 { return 1; }
    if nstarts(r, nid, "mml_shift_check") == 1 { return 1; }
    if nstarts(r, nid, "mml_str_eq") == 1 { return 1; }
    if nstarts(r, nid, "mml_str_validate") == 1 { return 1; }
    if nstarts(r, nid, "mml_alloc_slice") == 1 { return 1; }
    if nstarts(r, nid, "mml_alloc") == 1 { return 1; }
    if nstarts(r, nid, "mml_free") == 1 { return 1; }
    return 0;
}

// ---- emit ---------------------------------------------------------------

/// `emit(m, triple)` — full .ll text from the recorded module.
pub fn emit(own le: LE, read g: ir.G, triple: str) -> LE {

    le = lputs(le, "target triple = \"");
    le = lputs(le, triple);
    le = lputs(le, "\"\n\n");
    // runtime declares — mml_* callees, dedup'd + sorted by name
    // text (BTreeSet<String> semantics).
    let used = vec.Vec<u32>::new(le.heap);
    let fi: u64 = 0;
    while fi * 8 < g.irf.len {
        let fb = fi * 8;
        let bo = u64(g.irf.buf[fb + 6]);
        let bl = u64(g.irf.buf[fb + 7]);
        let b: u64 = 0;
        while b < bl {
            let bb = (bo + b) * 8;
            let io = u64(g.irb.buf[bb + 1]);
            let il = u64(g.irb.buf[bb + 2]);
            let ii: u64 = 0;
            while ii < il {
                let ib = (io + ii) * 8;
                if g.iri.buf[ib] == 16 {
                    let nm = g.iri.buf[ib + 3];
                    if nstarts(g.c.r, nm, "mml_") == 1
                        && l_is_rt(g.c.r, nm) == 1 {
                        // dedup by nid
                        let have: u8 = 0;
                        let q: u64 = 0;
                        while q < used.len {
                            if used.buf[q] == nm { have = 1; }
                            q = q + 1;
                        }
                        if have == 0 {
                            used = used.push(nm);
                        }
                    }
                }
                ii = ii + 1;
            }
            b = b + 1;
        }
        fi = fi + 1;
    }
    // insertion-sort by name text
    let i: u64 = 1;
    while i < used.len {
        let x = used.buf[i];
        let j = i;
        while j > 0 {
            let y = used.buf[j - 1];
            if nless(g.c.r, x, y) == 1 {
                used.buf[j] = y;
                j = j - 1;
            } else { break; }
        }
        used.buf[j] = x;
        i = i + 1;
    }
    i = 0;
    while i < used.len {
        le = l_rtdecl(le, g, used.buf[i]);
        i = i + 1;
    }
    used.destroy();
    // extern declares
    i = 0;
    while i * 4 < g.irx.len {
        let xb = i * 4;
        le = lputs(le, "declare ");
        le = lty(le, g.c.r, g.irx.buf[xb + 1]);
        le = lputs(le, " @");
        le = llsym(le, g.c.r, g.irx.buf[xb]);
        le.out = le.out.push(u8(40));
        let po = u64(g.irx.buf[xb + 2]);
        let pl = u64(g.irx.buf[xb + 3]);
        let j: u64 = 0;
        while j < pl {
            if j > 0 { le = lputs(le, ", "); }
            le = lty(le, g.c.r, g.irpa.buf[po + j * 3 + 2]);
            j = j + 1;
        }
        le = lputs(le, ")\n");
        i = i + 1;
    }
    // string globals — private unnamed_addr constant [N x i8]
    i = 0;
    while i < g.strings.len {
        let sp = g.strings.buf[i];
        le = lputs(le, "@.str.");
        le.out = resolve.bu32(le.out, i);
        le = lputs(le, " = private unnamed_addr constant [");
        le.out = resolve.bu32(le.out, u64(sp.len) + 1);
        le = lputs(le, " x i8] c\"");
        let j = u64(sp.off);
        let jn = j + u64(sp.len);
        while j < jn {
            let b = g.sbyt.buf[j];
            if b >= u8(32) && b <= u8(126)
                && b != u8(34) && b != u8(92) {
                le.out = le.out.push(b);
            } else {
                le.out = le.out.push(u8(92));
                let hi = b / 16;
                let lo = b % 16;
                le.out = le.out.push(hexdig(hi));
                le.out = le.out.push(hexdig(lo));
            }
            j = j + 1;
        }
        le = lputs(le, "\\00\"\n");
        i = i + 1;
    }
    // blank line iff the last line ended `)` — s0's quirk.
    if le.out.len >= 2 {
        if le.out.buf[le.out.len - 2] == u8(41) {
            le.out = le.out.push(u8(10));
        }
    }
    // struct defs
    i = 0;
    while i * 3 < g.irst.len {
        let sb = i * 3;
        le.out = le.out.push(u8(37));
        le = llsym(le, g.c.r, g.irst.buf[sb]);
        le = lputs(le, " = type { ");
        let fo = u64(g.irst.buf[sb + 1]);
        let fl = u64(g.irst.buf[sb + 2]);
        let j: u64 = 0;
        while j < fl {
            if j > 0 { le = lputs(le, ", "); }
            le = lty(le, g.c.r, g.irsf.buf[fo + j * 2 + 1]);
            j = j + 1;
        }
        le = lputs(le, " }\n");
        i = i + 1;
    }
    if g.irst.len > 0 {
        le.out = le.out.push(u8(10));
    }
    // fns
    let mainf: u64 = u64(ir.NONE());
    i = 0;
    while i * 8 < g.irf.len {
        let fb = i * 8;
        let nm = g.irf.buf[fb];
        if nlen(g.c.r, nm) == 4 && nstarts(g.c.r, nm, "main") == 1 {
            mainf = i;
        }
        le.tmp = 0;
        le = l_noalias(le, g, fb);
        le = l_analyze(le, g, fb);
        // define line — sret fns return void with a hidden dest ptr.
        le = lputs(le, "define ");
        if le.sret == 1 {
            le = lputs(le, "void");
        } else {
            le = lty(le, g.c.r, g.irf.buf[fb + 1]);
        }
        le = lputs(le, " @");
        if nlen(g.c.r, nm) == 4 && nstarts(g.c.r, nm, "main") == 1 {
            le = lputs(le, "mml_main");
        } else {
            le = llsym(le, g.c.r, nm);
        }
        le.out = le.out.push(u8(40));
        let poff = u64(g.irf.buf[fb + 2]);
        let plen = u64(g.irf.buf[fb + 3]);
        let aro = u64(g.irf.buf[fb + 4]);
        if le.sret == 1 {
            le = lputs(le, "ptr %sret");
        }
        let j: u64 = 0;
        while j < plen {
            if j > 0 || le.sret == 1 { le = lputs(le, ", "); }
            let auth = g.irpa.buf[poff + j * 3 + 1];
            let pt = g.irpa.buf[poff + j * 3 + 2];
            if auth == 1 || auth == 2 || lbig(g, pt) == 1 {
                le = lputs(le, "ptr");
            } else {
                le = lty(le, g.c.r, pt);
            }
            if le.nav.buf[j] == u8(1) {
                le = lputs(le, " noalias");
            }
            le.out = le.out.push(u8(32));
            le = lvr(le, g.irar.buf[aro + j]);
            j = j + 1;
        }
        le = lputs(le, ") {\n");
        // hoisted locals — all `Local` instrs land in entry.
        let bo = u64(g.irf.buf[fb + 6]);
        let bl = u64(g.irf.buf[fb + 7]);
        // collect (block,instr) coords of kind-1 instrs in order —
        // emit them right after the entry label prints.
        let b: u64 = 0;
        while b < bl {
            let bb = (bo + b) * 8;
            le = l_lbl(le, g, g.irb.buf[bb]);
            le = lputs(le, ":\n");
            if b == 0 {
                // hoisted locals in source order
                let b2: u64 = 0;
                while b2 < bl {
                    let bb2 = (bo + b2) * 8;
                    let io2 = u64(g.irb.buf[bb2 + 1]);
                    let il2 = u64(g.irb.buf[bb2 + 2]);
                    let k2: u64 = 0;
                    while k2 < il2 {
                        let ib2 = (io2 + k2) * 8;
                        if g.iri.buf[ib2] == 1 {
                            le = l_instr(le, g, ib2);
                        }
                        k2 = k2 + 1;
                    }
                    b2 = b2 + 1;
                }
                // N78 scratch slots + own-big param value rebinds.
                let si: u64 = 0;
                while si < le.sal_t.len {
                    le = lputs(le, "    %s");
                    le = lu32(le, le.sal_n.buf[si]);
                    le = lputs(le, " = alloca ");
                    le = lty(le, g.c.r, le.sal_t.buf[si]);
                    le.out = le.out.push(u8(10));
                    si = si + 1;
                }
                let pj: u64 = 0;
                while pj < plen {
                    let ar2 = g.irar.buf[aro + pj];
                    let isren: u8 = 0;
                    let ri: u64 = 0;
                    while ri < le.ren.len {
                        if le.ren.buf[ri] == ar2 { isren = 1; }
                        ri = ri + 1;
                    }
                    if isren == 1 {
                        le = lputs(le, "    %a");
                        le = lu32(le, ar2);
                        le = lputs(le, " = load ");
                        le = lty(le, g.c.r,
                                 g.irpa.buf[poff + pj * 3 + 2]);
                        le = lputs(le, ", ptr %v");
                        le = lu32(le, ar2);
                        le.out = le.out.push(u8(10));
                    }
                    pj = pj + 1;
                }
            }
            let io = u64(g.irb.buf[bb + 1]);
            let il = u64(g.irb.buf[bb + 2]);
            let k: u64 = 0;
            while k < il {
                let ib = (io + k) * 8;
                // suppressed instrs — s0's `fx.skip` (homing stores).
                let pk = b * (u64(1) << 32) + k;
                let skip: u8 = 0;
                let si: u64 = 0;
                while si < le.skp.len {
                    if le.skp.buf[si] == pk { skip = 1; }
                    si = si + 1;
                }
                if skip == 0 && g.iri.buf[ib] != 1 {
                    le.nxt = u64(ir.NONE());
                    if k + 1 < il { le.nxt = (io + k + 1) * 8; }
                    le.cbb = bb;
                    le = l_instr(le, g, ib);
                }
                k = k + 1;
            }
            le = l_term(le, g, bb);
            b = b + 1;
        }
        le = lputs(le, "}\n\n");
        i = i + 1;
    }
    // N78 — sret'd returns move through memmove; declare on use.
    if le.mm == 1 {
        le = lputs(le, "declare void @llvm.memmove.p0.p0.i64(ptr, ptr, i64, i1)\n\n");
    }
    // mml_main_args shim — the runtime's C-ABI entry.
    if mainf != u64(ir.NONE()) {
        let fb = mainf * 8;
        let ret = g.irf.buf[fb + 1];
        let plen = u64(g.irf.buf[fb + 3]);
        le = lputs(le, "define i64 @mml_main_args(");
        le = lputs(le, "{ptr, i64} %mml_args) {\nentry:\n");
        le = lputs(le, "    %r = call ");
        le = lty(le, g.c.r, ret);
        le = lputs(le, " @mml_main(");
        if plen > 0 {
            le = lputs(le, "{ptr, i64} %mml_args");
        }
        le = lputs(le, ")\n");
        if lbits(g.c.r, ret) == 64 {
            le = lputs(le, "    ret i64 %r\n}\n\n");
        } else {
            le = lputs(le, "    %w = ");
            if lsigned(g.c.r, ret) == 1 {
                le = lputs(le, "sext ");
            } else {
                le = lputs(le, "zext ");
            }
            le = lty(le, g.c.r, ret);
            le = lputs(le, " %r to i64\n    ret i64 %w\n}\n\n");
        }
    }
    return le;
}

fn hexdig(n: u8) -> u8 {
    if n < u8(10) { return n + u8(48); }
    return n - u8(10) + u8(65);
}
