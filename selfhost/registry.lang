/// registry.lang — the self-hosted port of s0's driver/registry.rs
/// (N81-C). The directory registry: `index/<name>.toml` lists
/// versions with their canonical tree hash, toolchain requirement,
/// and yank flag; `src/<name>/<version>/` holds the unpacked trees.
/// The dep cache lives at `$OUR_HOME/registry` (default
/// `~/.our/registry`). Remote registries are http(s) roots fetched
/// per-file through curl.
import std.vec;
import std.result;
import std.fs;
import std.process;
import semver;
import toml;
import sha256;
import toolv;
import loader;
import resolve;

/// A registry root: 0 = none, 1 = local directory, 2 = remote base
/// URL. Same layout either way — `index/` + `src/` — only the
/// transport differs.
pub struct RegRoot { kind: u8, path: vec.Vec<u8> }

/// One `[version]` block in an index file.
pub struct IndexEntry {
    version: semver.Ver,
    sha256: vec.Vec<u8>,
    req: semver.Req,
    has_req: u8,
    yanked: u8,
    files: vec.Vec<vec.Vec<u8>>,
}

fn starts_with(s: slice u8, p: str) -> bool {
    if s.len < p.len { return false; }
    let i: u64 = 0;
    while i < p.len {
        if s[i] != p.bytes[i] { return false; }
        i = i + 1;
    }
    return true;
}

fn eq_bytes(a: slice u8, b: slice u8) -> bool {
    if a.len != b.len { return false; }
    let i: u64 = 0;
    while i < u64(a.len) {
        if a[i] != b[i] { return false; }
        i = i + 1;
    }
    return true;
}

fn key_eq(k: slice u8, s: str) -> bool {
    if k.len != s.len { return false; }
    let i: u64 = 0;
    while i < s.len {
        if k[i] != s.bytes[i] { return false; }
        i = i + 1;
    }
    return true;
}

/// string literal → slice u8 (bare literals bind *const u8).
fn lb(s: str) -> slice u8 {
    return s.bytes;
}

/// Append n raw bytes — the `*const u8` arg carries no borrow, so
/// the accumulator can outlive the source's destroy (the source is
/// copied byte-wise; callers keep it alive for the call itself).
pub fn catp(own v: vec.Vec<u8>, p: *const u8, n: u64) -> vec.Vec<u8> {
    let s: slice u8 = slice(p, n);   // foreign-storage assertion
    let i: u64 = 0;
    while i < n {
        v = v.push(s[i]);
        i = i + 1;
    }
    return v;
}

pub fn cat(own v: vec.Vec<u8>, b: slice u8) -> vec.Vec<u8> {
    let i: u64 = 0;
    while i < u64(b.len) {
        v = v.push(b[i]);
        i = i + 1;
    }
    return v;
}

pub fn catz(own v: vec.Vec<u8>, s: str) -> vec.Vec<u8> {
    return cat(v, s.bytes);
}

/// a + sep + b — s0's PathBuf::join (no absolute-b case needed).
/// Host-native separator (N79C #7). Skips the sep when `a` ends in
/// any host separator ("C:\" roots and caller-passed trailing "\"
/// included). FILESYSTEM paths only — URL joins keep '/'.
pub fn pjoin(own v: vec.Vec<u8>, a: slice u8, b: slice u8) -> vec.Vec<u8> {
    let hs = loader.host_sep();
    v = cat(v, a);
    if a.len > 0
            && loader.is_sep(v.buf[v.len - 1],
                             loader.host_win()) == 0 {
        v = v.push(hs);
    }
    // bpush_fs: filesystem tails may carry '/' (manifest values) —
    // verbatim \\?\ prefixes reject them (N79C #10).
    return loader.bpush_fs(v, b);
}

/// a + "/" + literal.
pub fn pjoinz(own v: vec.Vec<u8>, a: slice u8, s: str) -> vec.Vec<u8> {
    return pjoin(v, a, s.bytes);
}

/// The registry root: `$OUR_REGISTRY` (a directory or `http(s)://`
/// base), else `<project>/registry` when it exists.
pub fn registry_root(heap: alloc, proj_root: slice u8) -> RegRoot {
    let r = RegRoot { kind: 0, path: vec.Vec<u8>::new(heap) };
    match process.env("OUR_REGISTRY") {
        Ok(e) => {
            r.path = cat(r.path, e.bytes);
            let remote = starts_with(r.path.as_slice(), "http://")
                || starts_with(r.path.as_slice(), "https://");
            if remote {
                while r.path.len > 0 && r.path.buf[r.path.len - 1] == 47 {
                    r.path.len = r.path.len - 1;
                }
                r.kind = 2;
                return r;
            }
            let isdir = fs.is_dir(r.path.as_slice());
            if isdir {
                r.kind = 1;
                return r;
            }
        }
        Err(_) => {}
    }
    let hs = loader.host_sep();
    let local = vec.Vec<u8>::new(heap);
    local = cat(local, proj_root);
    local = local.push(hs);
    local = catz(local, "registry");
    let isdir = fs.is_dir(local.as_slice());
    if isdir {
        r.path.destroy();
        r.path = local;
        r.kind = 1;
        return r;
    }
    local.destroy();
    return r;
}

/// The dep cache root: `$OUR_HOME/registry`, default
/// `~/.our/registry`.
pub fn cache_root(heap: alloc) -> vec.Vec<u8> {
    let hs = loader.host_sep();
    let d = vec.Vec<u8>::new(heap);
    match process.env("OUR_HOME") {
        Ok(e) => { d = cat(d, e.bytes); }
        Err(_) => {
            match process.env("HOME") {
                Ok(h) => {
                    d = cat(d, h.bytes);
                    d = d.push(hs);
                    d = catz(d, ".our");
                }
                Err(_) => { d = catz(d, ".registry"); return d; }
            }
        }
    }
    d = d.push(hs);
    return catz(d, "registry");
}

// ---- remote transport (curl → tempfile → slurp) --------------------

/// NUL-separated argv block helper.
fn argz(own v: vec.Vec<u8>, b: slice u8) -> vec.Vec<u8> {
    v = cat(v, b);
    return v.push(u8(0));
}

extern fn mml_proc_run(exe: *const u8, elen: i64, args: *const u8,
                       alen: i64, cwd: *const u8, clen: i64) -> i64;
extern fn mml_proc_run_cap(exe: *const u8, elen: i64,
                           args: *const u8, alen: i64,
                           cwd: *const u8, clen: i64,
                           cap: *const u8, caplen: i64,
                           which: i64) -> i64;

/// Leading+trailing ASCII whitespace trim — Rust's `str::trim`.
fn trim(own v: vec.Vec<u8>) -> vec.Vec<u8> {
    let a: u64 = 0;
    while a < v.len && v.buf[a] < 33 { a = a + 1; }
    let b: u64 = v.len;
    while b > a && v.buf[b - 1] < 33 { b = b - 1; }
    let out = vec.Vec<u8>::new(v.heap);
    let i: u64 = a;
    while i < b {
        out = out.push(v.buf[i]);
        i = i + 1;
    }
    v.destroy();
    return out;
}

/// `env::temp_dir` mirror — same chain as our.lang's tmp_dir:
/// $TMPDIR→/tmp on POSIX, $TMP→$TEMP→"." on Windows.
fn tmp_dir(heap: alloc) -> vec.Vec<u8> {
    let v = vec.Vec<u8>::new(heap);
    match process.env("TMPDIR") {
        Ok(e) => { v = cat(v, e.bytes); return v; }
        Err(_) => {}
    }
    if loader.host_win() == 1 {
        match process.env("TMP") {
            Ok(e) => { v = cat(v, e.bytes); return v; }
            Err(_) => {}
        }
        match process.env("TEMP") {
            Ok(e) => { v = cat(v, e.bytes); return v; }
            Err(_) => {}
        }
        return catz(v, ".");
    }
    return resolve.bputs(v, "/tmp");
}

/// `GET` via curl — `-o tmp` carries the body (s0 pipes stdout into
/// `out.stdout`; the tempfile is the same bytes); stderr goes to a
/// second tempfile so a failed fetch can quote it, exactly like s0's
/// `Command::output()` + `stderr.trim()`.
fn fetch(heap: alloc, own urlv: vec.Vec<u8>)
        -> result.Result<vec.Vec<u8>, vec.Vec<u8>> {
    let tmp = tmp_dir(heap);
    if tmp.len > 0
            && loader.is_sep(tmp.buf[tmp.len - 1],
                             loader.host_win()) == 0 {
        let hs = loader.host_sep();
        tmp = tmp.push(hs);
    }
    tmp = resolve.bputs(tmp, "our-fetch-");
    tmp = resolve.bu32(tmp, u64(process.pid()));
    tmp = resolve.bputs(tmp, ".tmp");
    let capf = cat(vec.Vec<u8>::new(heap), tmp.as_slice());
    capf = resolve.bputs(capf, ".err");
    let args = vec.Vec<u8>::new(heap);
    args = argz(args, lb("-fsSL"));
    args = argz(args, lb("--max-time"));
    args = argz(args, lb("30"));
    args = argz(args, lb("-o"));
    args = argz(args, tmp.as_slice());
    args = argz(args, urlv.as_slice());
    let zexe = vec.Vec<u8>::new(heap);
    zexe = catz(zexe, "curl");
    let st = mml_proc_run_cap(&zexe.buf[0], 4, args.buf.ptr,
                              i64(args.len), 0, 0,
                              capf.buf.ptr, i64(capf.len), 2);
    zexe.destroy();
    args.destroy();
    if st != 0 {
        // spawn failure (<0 = -errno) vs non-zero exit — s0 splits
        // the same two messages.
        if st < 0 {
            let m = vec.Vec<u8>::new(heap);
            m = resolve.bputs(m, "fetch `");
            m = catp(m, urlv.buf.ptr, urlv.len);
            m = resolve.bputs(m, "`: cannot spawn curl: ");
            let sm = fs.strerror(heap, i32(0 - st));
            m = catp(m, sm.buf.ptr, sm.len);
            sm.destroy();
            m = resolve.bputs(m, " (os error ");
            m = resolve.bu32(m, u64(0 - st));
            m = m.push(u8(41));
            urlv.destroy();
            match fs.remove(str_from_utf8(tmp.as_slice())) {
                Ok(_) => {} Err(_) => {}
            }
            match fs.remove(str_from_utf8(capf.as_slice())) {
                Ok(_) => {} Err(_) => {}
            }
            tmp.destroy();
            capf.destroy();
            return result.Result<vec.Vec<u8>,
                vec.Vec<u8>>::Err(m);
        }
        let em = vec.Vec<u8>::new(heap);
        let emz = cat(vec.Vec<u8>::new(heap), capf.as_slice());
        emz = emz.push(u8(0));
        match fs.slurp_r(heap, emz.buf.ptr) {
            Ok(b) => { em = catp(em, b.buf.ptr, b.len); b.destroy(); }
            Err(_) => {}
        }
        emz.destroy();
        em = trim(em);
        let m = vec.Vec<u8>::new(heap);
        m = resolve.bputs(m, "fetch `");
        m = catp(m, urlv.buf.ptr, urlv.len);
        m = resolve.bputs(m, "`: ");
        m = catp(m, em.buf.ptr, em.len);
        em.destroy();
        urlv.destroy();
        match fs.remove(str_from_utf8(tmp.as_slice())) {
            Ok(_) => {} Err(_) => {}
        }
        match fs.remove(str_from_utf8(capf.as_slice())) {
            Ok(_) => {} Err(_) => {}
        }
        tmp.destroy();
        capf.destroy();
        return result.Result<vec.Vec<u8>, vec.Vec<u8>>::Err(m);
    }
    match fs.remove(str_from_utf8(capf.as_slice())) {
        Ok(_) => {} Err(_) => {}
    }
    capf.destroy();
    let tz = vec.Vec<u8>::new(heap);
    tz = cat(tz, tmp.as_slice());
    tz = tz.push(u8(0));
    let sr = fs.slurp_r(heap, tz.buf.ptr);
    tmp.destroy();
    tz.destroy();
    match sr {
        Ok(b) => {
            urlv.destroy();
            return result.Result<vec.Vec<u8>, vec.Vec<u8>>::Ok(b);
        }
        Err(e) => {
            let m = vec.Vec<u8>::new(heap);
            m = resolve.bputs(m, "fetch `");
            m = catp(m, urlv.buf.ptr, urlv.len);
            m = resolve.bputs(m, "`: cannot read response");
            urlv.destroy();
            return result.Result<vec.Vec<u8>, vec.Vec<u8>>::Err(m);
        }
    }
}

// ---- index parsing ---------------------------------------------------

fn fresh_entry(heap: alloc) -> IndexEntry {
    return IndexEntry {
        version: semver.Ver { maj: 0, min: 0, pat: 0 },
        sha256: vec.Vec<u8>::new(heap),
        req: semver.Req { exact: 0,
            base: semver.Ver { maj: 0, min: 0, pat: 0 } },
        has_req: 0, yanked: 0,
        files: vec.Vec<vec.Vec<u8>>::new(heap),
    };
}

fn entry_free(own e: IndexEntry) {
    e.sha256.destroy();
    let i: u64 = 0;
    while i < e.files.len {
        e.files.buf[i].destroy();
        i = i + 1;
    }
    e.files.destroy();
}

pub fn free_entries(own v: vec.Vec<IndexEntry>) {
    let i: u64 = 0;
    while i < v.len {
        entry_free(v.buf[i]);
        i = i + 1;
    }
    v.destroy();
}

fn free_files(own v: vec.Vec<vec.Vec<u8>>) {
    let i: u64 = 0;
    while i < v.len {
        v.buf[i].destroy();
        i = i + 1;
    }
    v.destroy();
}

fn is_ver_hdr(line: slice u8) -> bool {
    // "[[version]]"
    if line.len != 11 { return false; }
    let s: str = "[[version]]";
    let i: u64 = 0;
    while i < 11 {
        if line[i] != s.bytes[i] { return false; }
        i = i + 1;
    }
    return true;
}

fn find_eq(line: slice u8) -> u64 {
    let i: u64 = 0;
    while i < line.len {
        if line[i] == 61 { return i; }
        i = i + 1;
    }
    return u64(line.len);
}

/// `where:ln: msg` appended into `m` — move-rebind keeps the
/// deferred-error pattern legal under ownership.
fn perr_into(own m: vec.Vec<u8>, where_: slice u8, ln: u64, msg: str)
        -> vec.Vec<u8> {
    m = resolve.bpush(m, where_);
    m = m.push(u8(58));
    m = resolve.bu32(m, ln);
    m = resolve.bputs(m, ": ");
    m = resolve.bputs(m, msg);
    return m;
}

/// Parse index-file bytes — `[version]` blocks of `key = value`
/// lines (s0's index grammar: `[[version]]` in text form is
/// `[version]` headers — the manifest TOML subset plus a
/// `files = [...]` array).
pub fn parse_index(heap: alloc, where_: slice u8, bytes: slice u8)
        -> result.Result<vec.Vec<IndexEntry>, vec.Vec<u8>> {
    let out = vec.Vec<IndexEntry>::new(heap);
    let cur = fresh_entry(heap);
    let has_cur: u8 = 0;
    // deferred error: the byte scan borrows `bytes`, so cleanup
    // happens after the loop
    let err = vec.Vec<u8>::new(heap);
    let failed: u8 = 0;
    let i: u64 = 0;
    let ln: u64 = 1;
    while i < u64(bytes.len) && failed == 0 {
        let e0 = i;
        while i < u64(bytes.len) && bytes[i] != 10 {
            i = i + 1;
        }
        let line = toml.trim(toml.strip_comment(&bytes[e0..i]));
        i = i + 1;
        if line.len == 0 {
            // blank — count the line, nothing else
        } else {
            if is_ver_hdr(line) {
                if has_cur == 1 { out = out.push(cur); }
                else { entry_free(cur); }
                cur = fresh_entry(heap);
                has_cur = 1;
            } else {
                let eq = find_eq(line);
                if eq >= u64(line.len) {
                    err = perr_into(err, where_, ln, "expected `key = value`");
                    failed = 1;
                } else {
                    if has_cur == 0 {
                let m = vec.Vec<u8>::new(heap);
                m = resolve.bpush(m, where_);
                m = m.push(u8(58));
                m = resolve.bu32(m, ln);
                m = resolve.bputs(m, ": `");
                m = resolve.bpush(m, line);
                err = cat(err, m.as_slice());
                m.destroy();
                failed = 1;
                }
                if failed == 0 {
                let kk = toml.trim(&line[0..eq]);
                let vv = toml.trim(&line[eq + 1..line.len]);
                if key_eq(kk, "files") {
                    match toml.parse_str_array(heap, vv) {
                        Err(e) => {
                            err = perr_into(err, where_, ln, "bad `files`");
                            err = catz(err, " — ");
                            err = cat(err, e.as_slice());
                            e.destroy();
                            failed = 1;
                        }
                        Ok(fl) => {
                            let old = replace(cur.files, fl);
                            free_files(old);
                        }
                    }
                } if key_eq(kk, "version") {
                    match toml.parse_scalar(heap, vv) {
                        Err(e) => {
                            err = perr_into(err, where_, ln, "bad `version`");
                            err = catz(err, " — ");
                            err = cat(err, e.as_slice());
                            e.destroy();
                            failed = 1;
                        }
                        Ok(sv) => {
                            match semver.parse_ver(heap, sv.as_slice()) {
                                Err(e) => {
                                    err = perr_into(err, where_, ln,
                                               "bad `version`");
                                    err = catz(err, " — ");
                                    err = cat(err, e.as_slice());
                                    e.destroy();
                                    failed = 1;
                                }
                                Ok(v2) => { cur.version = v2; }
                            }
                            sv.destroy();
                        }
                    }
                } if key_eq(kk, "sha256") {
                    match toml.parse_scalar(heap, vv) {
                        Err(e) => {
                            err = perr_into(err, where_, ln, "bad `sha256`");
                            err = catz(err, " — ");
                            err = cat(err, e.as_slice());
                            e.destroy();
                            failed = 1;
                        }
                        Ok(sv) => {
                            cur.sha256.destroy();
                            cur.sha256 = sv;
                        }
                    }
                } if key_eq(kk, "requires") {
                    match toml.parse_scalar(heap, vv) {
                        Err(e) => {
                            err = perr_into(err, where_, ln, "bad `requires`");
                            err = catz(err, " — ");
                            err = cat(err, e.as_slice());
                            e.destroy();
                            failed = 1;
                        }
                        Ok(sv) => {
                            match semver.parse_req(heap, sv.as_slice()) {
                                Err(e) => {
                                    err = perr_into(err, where_, ln,
                                               "bad `requires`");
                                    err = catz(err, " — ");
                                    err = cat(err, e.as_slice());
                                    e.destroy();
                                    failed = 1;
                                }
                                Ok(r2) => { cur.req = r2; cur.has_req = 1; }
                            }
                            sv.destroy();
                        }
                    }
                } if key_eq(kk, "yanked") {
                    match toml.parse_scalar(heap, vv) {
                        Err(e) => {
                            err = perr_into(err, where_, ln, "bad `yanked`");
                            err = catz(err, " — ");
                            err = cat(err, e.as_slice());
                            e.destroy();
                            failed = 1;
                        }
                        Ok(sv) => {
                            if sv.len == 4 && sv.buf[0] == 116
                            && sv.buf[1] == 114 && sv.buf[2] == 117
                            && sv.buf[3] == 101 {
                                cur.yanked = 1;
                            }
                            sv.destroy();
                        }
                    }
                }
                // unknown keys are ignored (forward-compat) — s0
                // skips them too
            }
            }
            }
        }
        ln = ln + 1;
    }
    if failed == 1 {
        if has_cur == 1 { entry_free(cur); }
        else { entry_free(cur); }
        free_entries(out);
        return result.Result<vec.Vec<IndexEntry>, vec.Vec<u8>>::Err(err);
    }
    err.destroy();
    if has_cur == 1 { out = out.push(cur); }
    else { entry_free(cur); }
    return result.Result<vec.Vec<IndexEntry>, vec.Vec<u8>>::Ok(out);
}

/// Fetch + parse `index/<name>.toml`.
pub fn load_index(heap: alloc, read root: RegRoot, name: slice u8)
        -> result.Result<vec.Vec<IndexEntry>, vec.Vec<u8>> {
    let where_ = vec.Vec<u8>::new(heap);
    let bytes: vec.Vec<u8>;
    if root.kind == 1 {
        where_ = pjoinz(where_, root.path.as_slice(), "index");
        let hs = loader.host_sep();
        where_ = where_.push(hs);
        where_ = cat(where_, name);
        where_ = catz(where_, ".toml");
        let z = vec.Vec<u8>::new(heap);
        z = cat(z, where_.as_slice());
        z = z.push(u8(0));
        let sr = fs.slurp_r(heap, z.buf.ptr);
        z.destroy();
        match sr {
            Ok(b) => { bytes = b; }
            Err(_) => {
                where_.destroy();
                let m = vec.Vec<u8>::new(heap);
                m = resolve.bputs(m, "package `");
                m = cat(m, name);
                m = resolve.bputs(m, "` is not in the registry index");
                return result.Result<vec.Vec<IndexEntry>, vec.Vec<u8>>::Err(m);
            }
        }
    } else {
        where_ = cat(where_, root.path.as_slice());
        where_ = catz(where_, "/index/");
        where_ = cat(where_, name);
        where_ = catz(where_, ".toml");
        let fr = fetch(heap, cat(vec.Vec<u8>::new(heap),
                               where_.as_slice()));
        match fr {
            Ok(b) => { bytes = b; }
            Err(e) => {
                let m = vec.Vec<u8>::new(heap);
                m = resolve.bputs(m, "package `");
                m = cat(m, name);
                m = resolve.bputs(m, "`: ");
                m = cat(m, e.as_slice());
                e.destroy();
                where_.destroy();
                return result.Result<vec.Vec<IndexEntry>, vec.Vec<u8>>::Err(m);
            }
        }
    }
    let pr = parse_index(heap, where_.as_slice(), bytes.as_slice());
    where_.destroy();
    bytes.destroy();
    return pr;
}

// ---- version selection -------------------------------------------------

/// The running tool version — CARGO_PKG_VERSION, from toolv.
pub fn tool_ver() -> semver.Ver {
    return semver.Ver { maj: toolv.tool_maj(),
                        min: toolv.tool_min(),
                        pat: toolv.tool_pat() };
}

/// The highest version satisfying `req`, visible to this toolchain,
/// and not yanked. `locked` re-admits a yanked version already in
/// the lockfile. Returns the entry's index — s0's `select`.
pub fn select(heap: alloc, read entries: vec.Vec<IndexEntry>,
              name: slice u8, read req: semver.Req,
              read locked: semver.Ver, has_locked: u8)
        -> result.Result<u64, vec.Vec<u8>> {
    let tool = tool_ver();
    let best: i64 = 0 - 1;
    let any: u8 = 0;
    let i: u64 = 0;
    while i < entries.len {
        let ev = entries.buf[i].version;
        if semver.satisfies(req, ev) {
            any = 1;
            let skip: u8 = 0;
            if entries.buf[i].yanked == 1 {
                let re_admit: u8 = 0;
                if has_locked == 1 {
                    if semver.ver_eq(locked, ev) {
                        re_admit = 1;
                    }
                }
                if re_admit == 0 { skip = 1; }
            }
            if skip == 0 && entries.buf[i].has_req == 1 {
                if !semver.satisfies(entries.buf[i].req, tool) { skip = 1; }
            }
            if skip == 0 {
                if best < 0 {
                    best = i64(i);
                } else {
                    if semver.ver_gt(ev,
                                     entries.buf[u64(best)].version) {
                        best = i64(i);
                    }
                }
            }
        }
        i = i + 1;
    }
    if best >= 0 {
        return result.Result<u64, vec.Vec<u8>>::Ok(u64(best));
    }
    let rd = semver.req_display(heap, req);
    let m = vec.Vec<u8>::new(heap);
    m = m.push(u8(96));
    m = cat(m, name);
    if any == 1 {
        m = resolve.bputs(m, "`: every version satisfying `");
        m = cat(m, rd.as_slice());
        m = resolve.bputs(m, "` is yanked or needs a newer ourc");
    } else {
        m = resolve.bputs(m, "`: no version satisfies `");
        m = cat(m, rd.as_slice());
        m = m.push(u8(96));
    }
    rd.destroy();
    return result.Result<u64, vec.Vec<u8>>::Err(m);
}

// ---- tree walking / canonical hashing --------------------------------

/// Rust PathBuf ordering — component-wise byte compare, NOT raw
/// byte compare ("a-b" > "a/c" because components order first).
/// The canonical tree hash and fingerprint depend on this. Host
/// separators bound components (Windows: '\' too — PathBuf::cmp
/// splits on both there).
pub fn path_cmp(a: slice u8, b: slice u8) -> i32 {
    let w = loader.host_win();
    let ia: u64 = 0;
    let ib: u64 = 0;
    while true {
        let ea = ia;
        while ea < a.len && loader.is_sep(a[ea], w) == 0 {
            ea = ea + 1;
        }
        let eb = ib;
        while eb < b.len && loader.is_sep(b[eb], w) == 0 {
            eb = eb + 1;
        }
        let ca = ea - ia;
        let cb = eb - ib;
        let n = ca;
        if cb < n { n = cb; }
        let k: u64 = 0;
        let d: i32 = 0;
        while k < n {
            if a[ia + k] != b[ib + k] {
                if a[ia + k] < b[ib + k] { d = 0 - 1; } else { d = 1; }
                k = n;
            }
            k = k + 1;
        }
        if d == 0 && ca != cb {
            if ca < cb { d = 0 - 1; } else { d = 1; }
        }
        if d != 0 { return d; }
        if ea == a.len && eb == b.len { return 0; }
        if ea == a.len { return 0 - 1; }
        if eb == b.len { return 1; }
        ia = ea + 1;
        ib = eb + 1;
    }
    return 0;
}

/// sort Vec<Vec<u8>> by path_cmp — insertion sort (lists are small).
pub fn sort_paths(own v: vec.Vec<vec.Vec<u8>>) -> vec.Vec<vec.Vec<u8>> {
    let i: u64 = 1;
    while i < v.len {
        let j: u64 = i;
        let cont: bool = j > 0;
        while cont {
            if j == 0 { break; }
            let lt = path_cmp(v.buf[j].as_slice(),
                              v.buf[j - 1].as_slice()) < 0;
            if !lt { break; }
            let t = v.buf[j];
            v.buf[j] = v.buf[j - 1];
            v.buf[j - 1] = t;
            j = j - 1;
        }
        i = i + 1;
    }
    return v;
}

/// Recursively collect relative paths — `build/` and `.git/`
/// excluded AT TOP LEVEL ONLY (s0's collect_tree). `cur`/`rel` are
/// OWNED vecs: slice args would hold a borrow for the life of the
/// returned `out`, so ownership transfers instead (the callee
/// destroys them once `dl` is released).
fn collect_tree(heap: alloc, own cur: vec.Vec<u8>, own rel: vec.Vec<u8>,
                own out: vec.Vec<vec.Vec<u8>>) -> vec.Vec<vec.Vec<u8>> {
    let dr = fs.read_dir(heap, str_from_utf8(cur.as_slice()));
    match dr {
        Err(_) => {
            cur.destroy(); rel.destroy();
            return out;
        }
        Ok(dl) => {
            let i: u64 = 0;
            while i < fs.dir_len(dl) {
                let e = fs.dir_ent(dl, i);
                let nm = fs.ent_name(dl, e);
                if e.kind == 2 {
                    let skip = rel.len == 0 &&
                        (key_eq(nm.bytes, "build")
                        || key_eq(nm.bytes, ".git"));
                    if !skip {
                        let cp = pjoin(vec.Vec<u8>::new(heap),
                                       cur.as_slice(), nm.bytes);
                        let rp = pjoin(vec.Vec<u8>::new(heap),
                                       rel.as_slice(), nm.bytes);
                        out = collect_tree(heap, cp, rp, out);
                    }
                } else {
                    let rp = pjoin(vec.Vec<u8>::new(heap),
                                   rel.as_slice(), nm.bytes);
                    out = out.push(rp);
                }
                i = i + 1;
            }
            fs.free_dir_list(dl);
        }
    }
    cur.destroy(); rel.destroy();
    return out;
}

/// SHA-256 over `relpath \0 bytes \0` for every file under `root`,
/// path_cmp order — `.git/` and `build/` excluded, `tests/`
/// included. PACKAGES.md's canonical tree hash.
pub fn tree_sha256(heap: alloc, root: slice u8)
        -> result.Result<vec.Vec<u8>, vec.Vec<u8>> {
    let files = vec.Vec<vec.Vec<u8>>::new(heap);
    let rv = cat(vec.Vec<u8>::new(heap), root);
    let ev = vec.Vec<u8>::new(heap);
    let files2 = collect_tree(heap, rv, ev, files);
    let files3 = sort_paths(files2);
    let buf = vec.Vec<u8>::new(heap);
    let i: u64 = 0;
    let err = vec.Vec<u8>::new(heap);
    let failed: u8 = 0;
    while i < files3.len && failed == 0 {
        buf = cat(buf, files3.buf[i].as_slice());
        buf = buf.push(u8(0));
        let fp = pjoin(vec.Vec<u8>::new(heap), root,
                       files3.buf[i].as_slice());
        let z = cat(vec.Vec<u8>::new(heap), fp.as_slice());
        z = z.push(u8(0));
        let sr = fs.slurp_r(heap, z.buf.ptr);
        match sr {
            Ok(b) => {
                buf = cat(buf, b.as_slice());
                b.destroy();
            }
            Err(e) => {
                err = resolve.bpush(err, fp.as_slice());
                err = resolve.bputs(err, ": ");
                let sm = fs.strerror(heap, e);
                err = cat(err, sm.as_slice());
                sm.destroy();
                failed = 1;
            }
        }
        z.destroy();
        fp.destroy();
        buf = buf.push(u8(0));
        i = i + 1;
    }
    free_files(files3);
    if failed == 1 {
        buf.destroy();
        return result.Result<vec.Vec<u8>, vec.Vec<u8>>::Err(err);
    }
    err.destroy();
    let h = sha256.sha256_hex(vec.Vec<u8>::new(heap), buf.as_slice());
    buf.destroy();
    return result.Result<vec.Vec<u8>, vec.Vec<u8>>::Ok(h);
}

// ---- file copy --------------------------------------------------------

/// write `bytes` to `path` (create/truncate, 0644) — 0 ok, errno else.
fn wf(heap: alloc, path: slice u8, bytes: slice u8) -> i32 {
    let pz = cat(vec.Vec<u8>::new(heap), path);
    pz = pz.push(u8(0));
    let or_ = fs.open(pz.buf.ptr,
        fs.o_write() + fs.o_create() + fs.o_trunc(), 420);
    pz.destroy();
    let fd: i32 = 0 - 1;
    match or_ {
        Ok(f) => { fd = f; }
        Err(e) => { return e; }
    }
    let off: u64 = 0;
    while off < u64(bytes.len) {
        let n = u64(bytes.len) - off;
        let w = fs.fd_write(fd, &bytes[off..u64(bytes.len)], n);
        if w <= 0 { let c = fs.close(fd); return 5; }
        off = off + u64(w);
    }
    let c = fs.close(fd);
    return 0;
}

/// Copy `src`'s tree to `dst` — `build/` and `.git/` top-level
/// excluded (s0's copy_tree). Owned path args: slice args would
/// hold a borrow for the life of the result in every caller block.
fn copy_tree(heap: alloc, own src: vec.Vec<u8>, own dst: vec.Vec<u8>)
        -> result.Result<i32, vec.Vec<u8>> {
    match fs.mkdir_all(heap, dst.as_slice()) {
        Err(e) => {
            let m = vec.Vec<u8>::new(heap);
            m = resolve.bputs(m, "mkdir ");
            m = cat(m, dst.as_slice());
            m = resolve.bputs(m, ": ");
            m = resolve.bu32(m, u64(e));
            src.destroy(); dst.destroy();
            return result.Result<i32, vec.Vec<u8>>::Err(m);
        }
        Ok(_) => {}
    }
    let dr = fs.read_dir(heap, str_from_utf8(src.as_slice()));
    match dr {
        Err(e) => {
            let m = vec.Vec<u8>::new(heap);
            m = resolve.bputs(m, "read_dir ");
            m = cat(m, src.as_slice());
            m = resolve.bputs(m, ": ");
            m = resolve.bu32(m, u64(e));
            src.destroy(); dst.destroy();
            return result.Result<i32, vec.Vec<u8>>::Err(m);
        }
        Ok(dl) => {
            let i: u64 = 0;
            let err = vec.Vec<u8>::new(heap);
            let failed: u8 = 0;
            while i < fs.dir_len(dl) && failed == 0 {
                let e = fs.dir_ent(dl, i);
                let nm = fs.ent_name(dl, e);
                if e.kind == 2 {
                    let skip = key_eq(nm.bytes, "build")
                        || key_eq(nm.bytes, ".git");
                    if !skip {
                        let from = pjoin(vec.Vec<u8>::new(heap),
                                         src.as_slice(), nm.bytes);
                        let to = pjoin(vec.Vec<u8>::new(heap),
                                       dst.as_slice(), nm.bytes);
                        let rr = copy_tree(heap, from, to);
                        match rr {
                            Err(m) => {
                                err = cat(err, m.as_slice());
                                m.destroy();
                                failed = 1;
                            }
                            Ok(_) => {}
                        }
                    }
                } else {
                    let from = pjoin(vec.Vec<u8>::new(heap),
                                     src.as_slice(), nm.bytes);
                    let to = pjoin(vec.Vec<u8>::new(heap),
                                   dst.as_slice(), nm.bytes);
                    let zf = cat(vec.Vec<u8>::new(heap),
                                 from.as_slice());
                    zf = zf.push(u8(0));
                    match fs.slurp_r(heap, zf.buf.ptr) {
                        Ok(b) => {
                            let wr = wf(heap, to.as_slice(),
                                        b.as_slice());
                            b.destroy();
                            if wr != 0 {
                                err = resolve.bputs(err,
                                    "cannot copy ");
                                err = cat(err, from.as_slice());
                                failed = 1;
                            }
                        }
                        Err(e2) => {
                            err = resolve.bputs(err, "cannot read ");
                            err = cat(err, from.as_slice());
                            failed = 1;
                        }
                    }
                    zf.destroy();
                    from.destroy(); to.destroy();
                }
                i = i + 1;
            }
            fs.free_dir_list(dl);
            src.destroy(); dst.destroy();
            if failed == 1 {
                return result.Result<i32, vec.Vec<u8>>::Err(err);
            }
            err.destroy();
        }
    }
    return result.Result<i32, vec.Vec<u8>>::Ok(0);
}

/// dirname as a slice view (points into `p`).
fn dir_of(p: slice u8) -> slice u8 {
    let w = loader.host_win();
    let i: i64 = i64(p.len) - 1;
    while i >= 0 {
        if loader.is_sep(p[u64(i)], w) == 1 { break; }
        i = i - 1;
    }
    if i <= loader.root_sep(p, w) { return &p[0..0]; }
    return &p[0..u64(i)];
}

fn firstn(b: slice u8, n: u64) -> slice u8 {
    if b.len <= n { return b; }
    return &b[0..n];
}

/// QA-001 — canonical registry relpath: non-empty, '/'-separated
/// normal components only. Rejects absolute paths, drive/UNC
/// prefixes, '.', '..', and every backslash/colon/NUL byte — a malicious
/// `files[]` entry can never steer a write outside the package
/// scratch tree. Mirrors s0's `relpath_ok`.
fn relpath_ok(v: slice u8) -> u8 {
    if v.len == 0 { return 0; }
    if v[0] == 47 { return 0; }
    let i: u64 = 0;
    while i < v.len {
        let c = v[i];
        if c == 0 || c == 58 || c == 92 { return 0; }
        i = i + 1;
    }
    let cs: u64 = 0;
    i = 0;
    while i <= v.len {
        if i == v.len || v[i] == 47 {
            let n = i - cs;
            if n == 0 { return 0; }
            if n == 1 && v[cs] == 46 { return 0; }
            if n == 2 && v[cs] == 46 && v[cs + 1] == 46 { return 0; }
            cs = i + 1;
        }
        i = i + 1;
    }
    return 1;
}

/// hash `tree` and compare to `e.sha256` — s0's cache-verify step.
fn verify_tree(heap: alloc, read tree: slice u8, name: slice u8,
               read e: IndexEntry)
        -> result.Result<i32, vec.Vec<u8>> {
    match tree_sha256(heap, tree) {
        Err(em) => {
            return result.Result<i32, vec.Vec<u8>>::Err(em);
        }
        Ok(actual) => {
            let same = eq_bytes(actual.as_slice(),
                                e.sha256.as_slice());
            if !same {
                let m = vec.Vec<u8>::new(heap);
                m = m.push(u8(96));
                m = cat(m, name);
                m = resolve.bputs(m, "` ");
                let v4 = semver.ver_show(vec.Vec<u8>::new(heap),
                                         e.version);
                m = cat(m, v4.as_slice());
                v4.destroy();
                m = resolve.bputs(m,
                    ": cache hash mismatch — index says ");
                m = cat(m, firstn(e.sha256.as_slice(), 12));
                m = resolve.bputs(m, ", tree is ");
                m = cat(m, firstn(actual.as_slice(), 12));
                actual.destroy();
                return result.Result<i32, vec.Vec<u8>>::Err(m);
            }
            actual.destroy();
        }
    }
    return result.Result<i32, vec.Vec<u8>>::Ok(0);
}

// ---- the cache -------------------------------------------------------

/// Ensure `<cache>/<name>/<version>` exists and matches `sha256`:
/// a directory registry copies `src/<name>/<ver>/`; a remote registry
/// fetches every `files[]` member over GET into the same scratch
/// tree. The canonical hash verifies the assembled bytes either way.
/// Returns the cached package root — s0's `ensure_cached`.
pub fn ensure_cached(heap: alloc, read root: RegRoot, name: slice u8,
                     read e: IndexEntry)
        -> result.Result<vec.Vec<u8>, vec.Vec<u8>> {
    let cr = cache_root(heap);
    let cd = pjoin(vec.Vec<u8>::new(heap), cr.as_slice(), name);
    let v0 = semver.ver_show(vec.Vec<u8>::new(heap), e.version);
    let cache = pjoin(vec.Vec<u8>::new(heap), cd.as_slice(),
                      v0.as_slice());
    let mfp = pjoinz(vec.Vec<u8>::new(heap), cache.as_slice(),
                     "project.toml");
    let cached = fs.is_file(mfp.as_slice());
    if !cached {
        // tmp staging dir: <cache_root>/.tmp-<name>-<ver>
        let tmp = vec.Vec<u8>::new(heap);
        tmp = cat(tmp, cr.as_slice());
        let hs = loader.host_sep();
        tmp = tmp.push(hs);
        tmp = catz(tmp, ".tmp-");
        tmp = cat(tmp, name);
        tmp = tmp.push(u8(45));
        tmp = cat(tmp, v0.as_slice());
        let texists = fs.exists(tmp.as_slice());
        if texists {
            let ts = str_from_utf8(tmp.as_slice());
            match fs.remove_tree(heap, ts) {
                Ok(_) => {} Err(_) => {}
            }
        }
        if root.kind == 1 {
            // reg/src/<name>/<ver>
            let src = pjoinz(vec.Vec<u8>::new(heap),
                             root.path.as_slice(), "src");
            let hs = loader.host_sep();
            src = src.push(hs);
            src = cat(src, name);
            src = src.push(hs);
            src = cat(src, v0.as_slice());
            let smp = pjoinz(vec.Vec<u8>::new(heap), src.as_slice(),
                             "project.toml");
            let hasman = fs.is_file(smp.as_slice());
            smp.destroy();
            if !hasman {
                let m = vec.Vec<u8>::new(heap);
                m = m.push(u8(96));
                m = cat(m, name);
                m = resolve.bputs(m, "` ");
                m = cat(m, v0.as_slice());
                m = resolve.bputs(m, ": index has no `src/");
                m = cat(m, name);
                m = resolve.bputs(m, "/");
                m = cat(m, v0.as_slice());
                m = resolve.bputs(m, "` tree");
                src.destroy();
                tmp.destroy(); mfp.destroy(); v0.destroy();
                cache.destroy(); cd.destroy(); cr.destroy();
                return result.Result<vec.Vec<u8>, vec.Vec<u8>>::Err(m);
            }
            let ctr = copy_tree(heap, src, cat(vec.Vec<u8>::new(heap),
                                              tmp.as_slice()));
            match ctr {
                Err(em) => {
                    let m = vec.Vec<u8>::new(heap);
                    m = resolve.bputs(m, "cache `");
                    m = cat(m, name);
                    m = resolve.bputs(m, "` ");
                    m = cat(m, v0.as_slice());
                    m = resolve.bputs(m, ": ");
                    m = cat(m, em.as_slice());
                    em.destroy();
                    tmp.destroy(); mfp.destroy();
                    v0.destroy(); cache.destroy(); cd.destroy();
                    cr.destroy();
                    return result.Result<vec.Vec<u8>, vec.Vec<u8>>::Err(m);
                }
                Ok(_) => {}
            }
        } else {
            // remote: fetch each files[] member
            if e.files.len == 0 {
                let m = vec.Vec<u8>::new(heap);
                m = m.push(u8(96));
                m = cat(m, name);
                m = resolve.bputs(m, "` ");
                m = cat(m, v0.as_slice());
                m = resolve.bputs(m,
                    ": remote index entry has no `files` list");
                tmp.destroy(); mfp.destroy(); v0.destroy();
                cache.destroy(); cd.destroy(); cr.destroy();
                return result.Result<vec.Vec<u8>, vec.Vec<u8>>::Err(m);
            }
            // QA-001 — validate EVERY relpath before the first
            // fetch: a hostile index must never steer a write
            // outside `tmp`, and validation fails closed.
            let vi: u64 = 0;
            while vi < e.files.len {
                if relpath_ok(e.files.buf[vi].as_slice()) == 0 {
                    let m = vec.Vec<u8>::new(heap);
                    m = m.push(u8(96));
                    m = cat(m, name);
                    m = resolve.bputs(m, "` ");
                    m = cat(m, v0.as_slice());
                    m = resolve.bputs(m,
                        ": unsafe registry relpath `");
                    m = cat(m, e.files.buf[vi].as_slice());
                    m = resolve.bputs(m, "`");
                    match fs.remove_tree(heap,
                                         str_from_utf8(tmp.as_slice())) {
                        Ok(_) => {} Err(_) => {}
                    }
                    tmp.destroy(); mfp.destroy(); v0.destroy();
                    cache.destroy(); cd.destroy(); cr.destroy();
                    return result.Result<vec.Vec<u8>, vec.Vec<u8>>::Err(m);
                }
                vi = vi + 1;
            }
            let fi: u64 = 0;
            let fe = vec.Vec<u8>::new(heap);
            let failed: u8 = 0;
            while fi < e.files.len && failed == 0 {
                let url = vec.Vec<u8>::new(heap);
                url = cat(url, root.path.as_slice());
                url = catz(url, "/src/");
                url = cat(url, name);
                url = url.push(u8(47));
                url = cat(url, v0.as_slice());
                url = url.push(u8(47));
                url = cat(url, e.files.buf[fi].as_slice());
                let fr = fetch(heap, url);
                match fr {
                    Err(em) => {
                        fe = cat(fe, em.as_slice());
                        em.destroy();
                        failed = 1;
                    }
                    Ok(b) => {
                        let to = pjoin(vec.Vec<u8>::new(heap),
                                       tmp.as_slice(),
                                       e.files.buf[fi].as_slice());
                        let dp = vec.Vec<u8>::new(heap);
                        let dsz = dir_of(to.as_slice()).len;
                        dp = cat(dp, &to.as_slice()[0..dsz]);
                        match fs.mkdir_all(heap, dp.as_slice()) {
                            Err(_) => {} Ok(_) => {}
                        }
                        dp.destroy();
                        let wr = wf(heap, to.as_slice(),
                                    b.as_slice());
                        b.destroy(); to.destroy();
                        if wr != 0 {
                            fe = resolve.bputs(fe,
                                "cache write failed");
                            failed = 1;
                        }
                    }
                }
                fi = fi + 1;
            }
            if failed == 1 {
                tmp.destroy(); mfp.destroy(); v0.destroy();
                cache.destroy(); cd.destroy(); cr.destroy();
                return result.Result<vec.Vec<u8>, vec.Vec<u8>>::Err(fe);
            }
            fe.destroy();
        }
        // PACKAGES.md order: verify the assembled bytes, THEN
        // promote — a bad tree never reaches the cache.
        match verify_tree(heap, tmp.as_slice(), name, e) {
            Err(em) => {
                match fs.remove_tree(heap,
                                     str_from_utf8(tmp.as_slice())) {
                    Ok(_) => {} Err(_) => {}
                }
                tmp.destroy(); mfp.destroy(); v0.destroy();
                cache.destroy(); cd.destroy(); cr.destroy();
                return result.Result<vec.Vec<u8>, vec.Vec<u8>>::Err(em);
            }
            Ok(_) => {}
        }
        // tmp → cache (create cache's parent, drop any stale dir)
        match fs.mkdir_all(heap, cd.as_slice()) {
            Err(_) => {} Ok(_) => {}
        }
        let cexists = fs.exists(cache.as_slice());
        if cexists {
            let cs = str_from_utf8(cache.as_slice());
            match fs.remove_tree(heap, cs) {
                Ok(_) => {} Err(_) => {}
            }
        }
        match fs.rename(tmp.as_slice(), cache.as_slice()) {
            Err(re) => {
                let m = vec.Vec<u8>::new(heap);
                m = resolve.bputs(m, "rename failed: ");
                m = resolve.bu32(m, u64(re));
                tmp.destroy(); mfp.destroy(); v0.destroy();
                cache.destroy(); cd.destroy(); cr.destroy();
                return result.Result<vec.Vec<u8>, vec.Vec<u8>>::Err(m);
            }
            Ok(_) => {}
        }
        tmp.destroy();
        mfp.destroy();
        v0.destroy();
        cd.destroy();
        cr.destroy();
        return result.Result<vec.Vec<u8>, vec.Vec<u8>>::Ok(cache);
    }
    mfp.destroy();
    v0.destroy();
    cd.destroy();
    cr.destroy();
    // cached path — verify the on-disk tree every call.
    match verify_tree(heap, cache.as_slice(), name, e) {
        Err(em) => {
            cache.destroy();
            return result.Result<vec.Vec<u8>, vec.Vec<u8>>::Err(em);
        }
        Ok(_) => {}
    }
    return result.Result<vec.Vec<u8>, vec.Vec<u8>>::Ok(cache);
}
