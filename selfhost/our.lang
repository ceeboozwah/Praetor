    free_sibs(pool);
    return 0;
}

/// `our --dump-project <dir>` — the N81 oracle surface.
fn cmd_dump(heap: alloc) -> i32 {
    let opts = oopts();
    let dir: str = ".";
    let i: i64 = 2;
    while i < process.argc() {
        match process.arg(i) {
            Ok(a) => {
                if !iscmd(a, "--locked") && !iscmd(a, "--offline") {
                    dir = a;
                }
            }
            Err(_) => {}
        }
        i = i + 1;
    }
    match project.discover(heap, dir.bytes) {
        Err(e) => { ourfail(heap, e); return 1; }
        Ok(p) => {
            match project.dump_project(heap, p, opts) {
                Err(e) => {
                    ourfail(heap, e);
                    project.free_project(p);
                    return 1;
                }
                Ok(s) => {
                    io.print(str_from_utf8(s.as_slice()));
                    s.destroy();
                    project.free_project(p);
                    return 0;
                }
            }
        }
    }
}

fn proj_main(heap: alloc, cmd: str) -> i32 {
    if iscmd(cmd, "--version") || iscmd(cmd, "-V") {
        io.println("our 0.1.0");
        return 0;
    }
    if iscmd(cmd, "new") { return cmd_new(heap); }
    if iscmd(cmd, "--dump-project") { return cmd_dump(heap); }
    if iscmd(cmd, "toolchain") { return cmd_toolchain(heap); }
    if iscmd(cmd, "check") { return cmd_check(heap); }
    if iscmd(cmd, "build") { return cmd_build(heap); }
    if iscmd(cmd, "run") { return cmd_run(heap); }
    if iscmd(cmd, "test") { return cmd_test(heap); }
    if iscmd(cmd, "clean") { return cmd_clean(heap, 0); }
    if iscmd(cmd, "rebuild") {
        let r = cmd_clean(heap, 1);
        if r != 0 { return r; }
        return cmd_build(heap);
    }
    if iscmd(cmd, "deps") { return cmd_deps(heap); }
    if iscmd(cmd, "fmt") { return cmd_fmt(heap); }
    if iscmd(cmd, "doc") { return cmd_doc(heap); }
    return 2;
}

// ---- our fmt — token-stream formatting (N82-A) -------------------

/// s0's `collect_lang_files` — recursive `.lang` walk under `dir`
/// (consumed). Missing/unreadable dirs yield nothing, not errors.
fn collect_lang_files(heap: alloc, own files: vec.Vec<vec.Vec<u8>>,
                      own dir: vec.Vec<u8>) -> vec.Vec<vec.Vec<u8>> {
    match fs.read_dir(heap, str_from_utf8(dir.as_slice())) {
        Err(_) => {}
        Ok(dl) => {
            let i: u64 = 0;
            while i < fs.dir_len(dl) {
                let e = fs.dir_ent(dl, i);
                let nm = fs.ent_name(dl, e);
                if e.kind == 2 {
                    files = collect_lang_files(heap, files,
                        joinp(vec.Vec<u8>::new(heap), dir.as_slice(),
                              nm.bytes));
                } else {
                    if e.kind == 1 && nm.len > 5
                    && nm.bytes[nm.len - 5] == 46
                    && nm.bytes[nm.len - 4] == 108
                    && nm.bytes[nm.len - 3] == 97
                    && nm.bytes[nm.len - 2] == 110
                    && nm.bytes[nm.len - 1] == 103 {
                        files = files.push(joinp(
                            vec.Vec<u8>::new(heap), dir.as_slice(),
                            nm.bytes));
                    }
                }
                i = i + 1;
            }
            fs.free_dir_list(dl);
        }
    }
    dir.destroy();
    return files;
}

/// s1-compact render of a formatter lex failure — `{f}:{l}:{c}:
/// error: {msg}` + the gutter source line (N82-C upgrades this to
/// the pretty renderer everywhere at once).
fn fmt_errs(heap: alloc, own v: vec.Vec<u8>, path: slice u8,
            read lx: lexer.Lexer) -> vec.Vec<u8> {
    let i: u64 = 0;
    while i < lx.errs.len {
        let d = lx.errs.buf[i];
        v = catb(v, path);
        v = v.push(u8(58));
        v = loader.bpush_u64(v, u64(d.line));
        v = v.push(u8(58));
        v = loader.bpush_u64(v, u64(d.col));
        v = resolve.bputs(v, ": error: ");
        let j: u64 = u64(d.m0);
        while j < u64(d.m1) {
            v = v.push(lx.emsg.buf[j]);
            j = j + 1;
        }
        v = v.push(u8(10));
        let ln: u64 = u64(d.line);
        if ln > 0 {
            let cur: u64 = 1;
            let s0: u64 = 0;
            let e0: u64 = u64(lx.src.len);
            let i2: u64 = 0;
            while i2 < u64(lx.src.len) {
                if lx.src.buf[i2] == 10 {
                    if cur == ln { e0 = i2; i2 = u64(lx.src.len); }
                    cur = cur + 1;
                    if i2 < u64(lx.src.len) { s0 = i2 + 1; }
                }
                i2 = i2 + 1;
            }
            v = loader.bpush_u64(v, ln);
            v = resolve.bputs(v, " | ");
            while s0 < e0 {
                if lx.src.buf[s0] == 9 {
                    v = resolve.bputs(v, "    ");
                } else {
                    v = v.push(lx.src.buf[s0]);
                }
                s0 = s0 + 1;
            }
            v = v.push(u8(10));
        }
        i = i + 1;
    }
    return v;
}

/// `our fmt [--check]` — s0's cmd_fmt: format `src/` + `tests/` in
/// place; under `--check` report and fail when files would change.
fn cmd_fmt(heap: alloc) -> i32 {
    match cwd_project(heap) {
        Err(e) => { ourfail(heap, e); return 1; }
        Ok(p) => {
            maybe_dispatch(heap, p);
            let check: bool = has_flag("--check");
            let files = vec.Vec<vec.Vec<u8>>::new(heap);
            files = collect_lang_files(heap, files,
                joinp(vec.Vec<u8>::new(heap), p.root.as_slice(),
                      lb("src")));
            files = collect_lang_files(heap, files,
                project.tests_dir(heap, p));
            files = registry.sort_paths(files);
            let dirty: u64 = 0;
            let rc: i32 = 0;
            let done: bool = false;
            let i: u64 = 0;
            while i < files.len && !done {
                let z = zterm(vec.Vec<u8>::new(heap),
                              files.buf[i].as_slice());
                match fs.slurp_r(heap, z.buf.ptr) {
                    Err(e) => {
                        z.destroy();
                        let m = lits(heap, "our fmt: ");
                        m = catb(m, files.buf[i].as_slice());
                        m = resolve.bputs(m, ": ");
                        let sm = fs.strerror(heap, e);
                        m = catb(m, sm.as_slice());
                        sm.destroy();
                        m = m.push(u8(10));
                        wfd(2, m.as_slice());
                        m.destroy();
                        rc = 1; done = true;
                    }
                    Ok(src) => {
                        z.destroy();
                        let r = fmt.format_source(heap, src);
                        if r.ok == 0 {
                            let m = fmt_errs(heap,
                                vec.Vec<u8>::new(heap),
                                files.buf[i].as_slice(), r.lx);
                            wfd(2, m.as_slice());
                            m.destroy();
                            fmt.fout_free(r);
                            rc = 1; done = true;
                        } else {
                            let changed: bool = r.out.len != r.lx.src.len;
                            if !changed {
                                let k: u64 = 0;
                                while k < r.out.len {
                                    if r.out.buf[k] != r.lx.src.buf[k] {
                                        changed = true;
                                        k = r.out.len;
                                    }
                                    k = k + 1;
                                }
                            }
                            if changed {
                                dirty = dirty + 1;
                                if check {
                                    let m = lits(heap, "would reformat ");
                                    m = catb(m, files.buf[i].as_slice());
                                    m = m.push(u8(10));
                                    io.print(str_from_utf8(m.as_slice()));
                                    m.destroy();
                                } else {
                                    let wr = write_file(heap,
                                        files.buf[i].as_slice(),
                                        r.out.as_slice());
                                    if wr == 0 {
                                        let m = lits(heap, "formatted ");
                                        m = catb(m, files.buf[i].as_slice());
                                        m = m.push(u8(10));
                                        io.print(str_from_utf8(m.as_slice()));
                                        m.destroy();
                                    } else {
                                        let m = lits(heap, "our fmt: ");
                                        m = catb(m, files.buf[i].as_slice());
                                        m = resolve.bputs(m, ": ");
                                        let sm = fs.strerror(heap, wr);
                                        m = catb(m, sm.as_slice());
                                        sm.destroy();
                                        m = m.push(u8(10));
                                        wfd(2, m.as_slice());
                                        m.destroy();
                                        fmt.fout_free(r);
                                        rc = 1; done = true;
                                    }
                                }
                            }
                            if !done { fmt.fout_free(r); }
                        }
                    }
                }
                i = i + 1;
            }
            if !done && check {
                if dirty > 0 {
                    let m = vec.Vec<u8>::new(heap);
                    m = loader.bpush_u64(m, dirty);
                    m = resolve.bputs(m, " file(s) would change\n");
                    wfd(2, m.as_slice());
                    m.destroy();
                    rc = 1;
                } else {
                    let m = vec.Vec<u8>::new(heap);
                    m = loader.bpush_u64(m, u64(files.len));
                    m = resolve.bputs(m, " file(s) already formatted\n");
                    io.print(str_from_utf8(m.as_slice()));
                    m.destroy();
                }
            }
            i = 0;
            while i < files.len {
                files.buf[i].destroy();
                i = i + 1;
            }
            files.destroy();
            project.free_project(p);
            return rc;
        }
    }
}

/// `our doc <pkg>.<mod>` — s0's cmd_doc: works outside projects
/// (`std.*` always resolves); inside one it honors the toolchain
/// pin like every project command.
fn cmd_doc(heap: alloc) -> i32 {
    match process.arg(2) {
        Err(_) => {
            io.eprintln("usage: our doc <pkg>.<mod>");
            return 1;
        }
        Ok(a) => {
            let buf2: [4096]u8;
            buf2[0] = 0;
            match process.cwd(&mut buf2[0..4096]) {
                Err(_) => {}
                Ok(cw) => {
                    match project.discover(heap, cw.bytes) {
                        Err(e) => { e.destroy(); }
                        Ok(p) => {
                            maybe_dispatch(heap, p);
                            project.free_project(p);
                        }
                    }
                }
            }
            match doc.run(heap, a.bytes) {
                Err(e) => {
                    let m = lits(heap, "our doc: ");
                    m = catb(m, e.as_slice());
                    m = m.push(u8(10));
                    wfd(2, m.as_slice());
                    m.destroy(); e.destroy();
                    return 1;
                }
                Ok(out) => {
                    io.print(str_from_utf8(out.as_slice()));
                    out.destroy();
                    return 0;
                }
            }
        }
    }
}

// ---- our test — the ntest runner (N60 directive corpus) --------------

/// One parsed `tests/*.lang` case — s0's `ntest::Case`.
pub struct TCase {
    path: vec.Vec<u8>,
    has_exit: u8, exit: i64,
    cerr: vec.Vec<u8>, has_cerr: u8,
    args: vec.Vec<vec.Vec<u8>>,
    ir_has: vec.Vec<vec.Vec<u8>>,
    ir_lacks: vec.Vec<vec.Vec<u8>>,
}

fn tcase_free(own c: TCase) {
    c.path.destroy(); c.cerr.destroy();
    let i: u64 = 0;
    while i < c.args.len { c.args.buf[i].destroy(); i = i + 1; }
    c.args.destroy();
    i = 0;
    while i < c.ir_has.len { c.ir_has.buf[i].destroy(); i = i + 1; }
    c.ir_has.destroy();
    i = 0;
    while i < c.ir_lacks.len { c.ir_lacks.buf[i].destroy(); i = i + 1; }
    c.ir_lacks.destroy();
}

/// signed parse for `@exit` values (`-1` = abnormal termination).
fn parse_i64s(s: slice u8) -> result.Result<i64, i32> {
    if s.len == 0 { return result.Result<i64, i32>::Err(1); }
    let neg: u8 = 0;
    let i: u64 = 0;
    if s[0] == 45 { neg = 1; i = 1; }
    if i == u64(s.len) { return result.Result<i64, i32>::Err(1); }
    let v: i64 = 0;
    while i < u64(s.len) {
        let c = s[i];
        if c < 48 || c > 57 {
            return result.Result<i64, i32>::Err(1);
        }
        v = v * 10 + i64(c - 48);
        i = i + 1;
    }
    if neg == 1 { v = 0 - v; }
    return result.Result<i64, i32>::Ok(v);
}

/// `// @exit`-style directive tails — `line` is trimmed; `pfx`
/// includes the `// @` prefix; returns the trimmed rest or none.
fn dir_tail(line: slice u8, pfx: str) -> slice u8 {
    let b = pfx.bytes;
    if u64(line.len) < u64(b.len) {
        return &line[0..0];
    }
    let i: u64 = 0;
    while i < u64(b.len) {
        if line[i] != b[i] { return &line[0..0]; }
        i = i + 1;
    }
    return toml_trim(&line[u64(b.len)..line.len]);
}

fn toml_trim(s: slice u8) -> slice u8 {
    let a: u64 = 0;
    while a < s.len && (s[a] == 32 || s[a] == 9) { a = a + 1; }
    let e = u64(s.len);
    while e > a && (s[e - 1] == 32 || s[e - 1] == 9
                    || s[e - 1] == 13 || s[e - 1] == 10) {
        e = e - 1;
    }
    return &s[a..e];
}

/// `@args` tokens — whitespace-separated, `"..."` groups, `""` is
/// an empty argument (s0's parse_args).
fn parse_targs(own out: vec.Vec<vec.Vec<u8>>, s: slice u8)
        -> vec.Vec<vec.Vec<u8>> {
    let heap = out.heap;
    let cur = vec.Vec<u8>::new(heap);
    let in_q: u8 = 0;
    let seen: u8 = 0;
    let i: u64 = 0;
    while i < u64(s.len) {
        let c = s[i];
        if c == 34 {
            if in_q == 1 { in_q = 0; } else { in_q = 1; }
            seen = 1;
        } else {
            if (c == 32 || c == 9 || c == 10 || c == 13)
            && in_q == 0 {
                if seen == 1 || cur.len > 0 {
                    out = out.push(cur);
                    cur = vec.Vec<u8>::new(heap);
                    seen = 0;
                }
            } else {
                cur = cur.push(c);
                seen = 1;
            }
        }
        i = i + 1;
    }
    if seen == 1 || cur.len > 0 {
        out = out.push(cur);
    } else {
        cur.destroy();
    }
    return out;
}

/// Parse one test file — Err(msg) means SKIP (no directives).
fn parse_tcase(heap: alloc, path: slice u8)
        -> result.Result<TCase, vec.Vec<u8>> {
    let c = TCase {
        path: catb(vec.Vec<u8>::new(heap), path),
        has_exit: 0, exit: 0,
        cerr: vec.Vec<u8>::new(heap), has_cerr: 0,
        args: vec.Vec<vec.Vec<u8>>::new(heap),
        ir_has: vec.Vec<vec.Vec<u8>>::new(heap),
        ir_lacks: vec.Vec<vec.Vec<u8>>::new(heap),
    };
    let z = zterm(vec.Vec<u8>::new(heap), path);
    let src: vec.Vec<u8>;
    match fs.slurp_r(heap, z.buf.ptr) {
        Err(e) => {
            z.destroy();
            let m = catb(vec.Vec<u8>::new(heap), path);
            m = resolve.bputs(m, ": ");
            let sm = fs.strerror(heap, e);
            m = catb(m, sm.as_slice());
            sm.destroy();
            tcase_free(c);
            return result.Result<TCase, vec.Vec<u8>>::Err(m);
        }
        Ok(b) => { src = b; }
    }
    z.destroy();
    let bad: u8 = 0;
    let i: u64 = 0;
    while i < src.len && bad == 0 {
        let e0 = i;
        while i < src.len && src.buf[i] != 10 { i = i + 1; }
        let line = toml_trim(&src.as_slice()[e0..i]);
        i = i + 1;
        let t = dir_tail(line, "// @exit");
        if t.len > 0 {
            match parse_i64s(t) {
                Ok(n) => { c.exit = n; c.has_exit = 1; }
                Err(_) => { bad = 1; }
            }
        }
        let t2 = dir_tail(line, "// @compile-error");
        if t2.len > 0 {
            c.cerr = catb(c.cerr, t2);
            c.has_cerr = 1;
        }
        let t3 = dir_tail(line, "// @args");
        if t3.len > 0 {
            c.args = parse_targs(c.args, t3);
        }
        let t4 = dir_tail(line, "// @ir-has");
        if t4.len > 0 {
            c.ir_has = c.ir_has.push(
                catb(vec.Vec<u8>::new(heap), t4));
        }
        let t5 = dir_tail(line, "// @ir-lacks");
        if t5.len > 0 {
            c.ir_lacks = c.ir_lacks.push(
                catb(vec.Vec<u8>::new(heap), t5));
        }
    }
    src.destroy();
    if bad == 1 {
        let m = catb(vec.Vec<u8>::new(heap), path);
        m = resolve.bputs(m, ": bad @exit value");
        tcase_free(c);
        return result.Result<TCase, vec.Vec<u8>>::Err(m);
    }
    if c.has_exit == 0 && c.has_cerr == 0
    && c.ir_has.len == 0 && c.ir_lacks.len == 0 {
        let m = catb(vec.Vec<u8>::new(heap), path);
        m = resolve.bputs(m,
            ": no @exit/@compile-error/@ir-has/@ir-lacks directive");
        tcase_free(c);
        return result.Result<TCase, vec.Vec<u8>>::Err(m);
    }
    return result.Result<TCase, vec.Vec<u8>>::Ok(c);
}

/// bytes-contains — `msg.contains(want)` for @compile-error/@ir-*.
fn has_sub(hp: *const u8, hn: u64, np: *const u8, nn: u64) -> bool {
    if nn == 0 { return true; }
    if hn < nn { return false; }
    let hay: slice u8 = slice(hp, hn);
    let needle: slice u8 = slice(np, nn);
    let i: u64 = 0;
    while i + nn <= hn {
        let ok: u8 = 1;
        let j: u64 = 0;
        while j < nn {
            if hay[i + j] != needle[j] { ok = 0; }
            j = j + 1;
        }
        if ok == 1 { return true; }
        i = i + 1;
    }
    return false;
}

/// clone the roots table — compile_roots consumes it per case.
fn clone_lroots(heap: alloc, read v: vec.Vec<loader.LRoot>)
        -> vec.Vec<loader.LRoot> {
    let out = vec.Vec<loader.LRoot>::new(heap);
    let i: u64 = 0;
    while i < v.len {
        out = out.push(loader.LRoot {
            name: catb(vec.Vec<u8>::new(heap), v.buf[i].name.as_slice()),
            dir: catb(vec.Vec<u8>::new(heap), v.buf[i].dir.as_slice()),
        });
        i = i + 1;
    }
    return out;
}

/// the file's basename for `  ok  name ...` report lines.
fn base_name(s: slice u8) -> slice u8 {
    let bs: u64 = 0;
    let i: u64 = 0;
    while i < u64(s.len) {
        if s[i] == 47 { bs = i + 1; }
        i = i + 1;
    }
    return &s[bs..s.len];
}

/// Run one parsed case — appends the report line, returns
/// 0 pass / 1 fail via res. `rep` is the accumulating report.
fn ntest_one(heap: alloc, read c: TCase,
             read roots: vec.Vec<loader.LRoot>, workdir: slice u8,
             own rep: vec.Vec<u8>) -> vec.Vec<u8> {
    // res channel: rep is chained through; result via caller reads
    // the returned vec's marker — instead keep (rep, pass) simple:
    // callers use ntest_one2 which returns rep with a trailing
    // sentinel byte handled by ntest_dir.
    let name = base_name(c.path.as_slice());
    let stem = stem_of(vec.Vec<u8>::new(heap), name);
    let roots2 = clone_lroots(heap, roots);
    match build_one(heap, c.path.as_slice(), roots2,
                    workdir, stem.as_slice(), 0) {
        Err(msg) => {
            stem.destroy();
            if c.has_cerr == 1 {
                if has_sub(msg.buf.ptr, u64(msg.len),
                           c.cerr.buf.ptr, u64(c.cerr.len)) {
                    rep = resolve.bputs(rep, "  ok    ");
                    rep = catb(rep, name);
                    rep = resolve.bputs(rep,
                        " (compile error matched)\n");
                    msg.destroy();
                    rep = rep.push(u8(1));   // pass marker
                    return rep;
                }
                rep = resolve.bputs(rep, "  FAIL  ");
                rep = catb(rep, name);
                rep = resolve.bputs(rep, ": wanted error containing `");
                rep = catb(rep, c.cerr.as_slice());
                rep = resolve.bputs(rep, "`, got:\n");
                rep = catb(rep, msg.as_slice());
                rep = rep.push(u8(10));
                msg.destroy();
                rep = rep.push(u8(0));
                return rep;
            }
            rep = resolve.bputs(rep, "  FAIL  ");
            rep = catb(rep, name);
            rep = resolve.bputs(rep, ": compile failed:\n");
            rep = catb(rep, msg.as_slice());
            msg.destroy();
            rep = rep.push(u8(0));
            return rep;
        }
        Ok(exe) => {
            if c.has_cerr == 1 {
                stem.destroy(); exe.destroy();
                rep = resolve.bputs(rep, "  FAIL  ");
                rep = catb(rep, name);
                rep = resolve.bputs(rep,
                    ": compiled but wanted error `");
                rep = catb(rep, c.cerr.as_slice());
                rep = resolve.bputs(rep, "`\n");
                rep = rep.push(u8(0));
                return rep;
            }
            // ir shape: <workdir>/<stem>.ll
            let llp = joinp(vec.Vec<u8>::new(heap), workdir,
                            stem.as_slice());
            llp = catb(llp, lb(".ll"));
            let z = zterm(vec.Vec<u8>::new(heap), llp.as_slice());
            let llok: u8 = 0;
            match fs.slurp_r(heap, z.buf.ptr) {
                Err(_) => { z.destroy(); }
                Ok(txt) => {
                    z.destroy();
                    llok = 1;
                    let i: u64 = 0;
                    let bad: u8 = 0;
                    while i < c.ir_has.len {
                        if !has_sub(txt.buf.ptr, u64(txt.len),
                                c.ir_has.buf[i].buf.ptr,
                                u64(c.ir_has.buf[i].len)) {
                            bad = bad + 1;
                            rep = resolve.bputs(rep, "  FAIL  ");
                            rep = catb(rep, name);
                            rep = resolve.bputs(rep, ": .ll lacks `");
                            rep = catb(rep, c.ir_has.buf[i].as_slice());
                            rep = resolve.bputs(rep, "`\n");
                        }
                        i = i + 1;
                    }
                    i = 0;
                    while i < c.ir_lacks.len {
                        if has_sub(txt.buf.ptr, u64(txt.len),
                                c.ir_lacks.buf[i].buf.ptr,
                                u64(c.ir_lacks.buf[i].len)) {
                            bad = bad + 1;
                            rep = resolve.bputs(rep, "  FAIL  ");
                            rep = catb(rep, name);
                            rep = resolve.bputs(rep,
                                ": .ll contains forbidden `");
                            rep = catb(rep,
                                c.ir_lacks.buf[i].as_slice());
                            rep = resolve.bputs(rep, "`\n");
                        }
                        i = i + 1;
                    }
                    txt.destroy();
                    if bad > 0 {
                        stem.destroy(); llp.destroy(); exe.destroy();
                        rep = rep.push(u8(100 + bad)); // multi-fail
                        return rep;
                    }
                }
            }
            llp.destroy();
            if c.has_exit == 0 {
                stem.destroy(); exe.destroy();
                rep = resolve.bputs(rep, "  ok    ");
                rep = catb(rep, name);
                rep = resolve.bputs(rep, " (ir shape)\n");
                rep = rep.push(u8(1));
                return rep;
            }
            // run the exe with @args — captured (s0 `output()`:
            // the child's stdio never reaches the report stream),
            // POSIX signal death maps to code -1 like s0's
            // `status.code().unwrap_or(-1)`.
            let ab = vec.Vec<u8>::new(heap);
            let i: u64 = 0;
            while i < c.args.len {
                ab = argp(ab, c.args.buf[i].as_slice());
                i = i + 1;
            }
            let ncap = tmpcap(heap);
            let st = run_cap(heap, exe.as_slice(), ab,
                             ncap.as_slice(), 3);
            ab.destroy(); ncap.destroy(); stem.destroy();
            if st < 0 {
                exe.destroy();
                rep = resolve.bputs(rep, "  FAIL  ");
                rep = catb(rep, name);
                rep = resolve.bputs(rep, ": run failed\n");
                rep = rep.push(u8(0));
                return rep;
            }
            let code: i64 = st;
            if st >= 128 { code = 0 - 1; }
            let matched: u8 = 0;
            if c.exit == 0 - 1 {
                if code == 0 - 1 || code == 3 { matched = 1; }
            } else {
                if code == c.exit { matched = 1; }
            }
            exe.destroy();
            if matched == 1 {
                rep = resolve.bputs(rep, "  ok    ");
                rep = catb(rep, name);
                rep = resolve.bputs(rep, " -> exit ");
                if code < 0 {
                    rep = rep.push(u8(45));
                    rep = resolve.bu32(rep, u64(0 - code));
                } else {
                    rep = resolve.bu32(rep, u64(code));
                }
                rep = rep.push(u8(10));
                rep = rep.push(u8(1));
                return rep;
            }
            rep = resolve.bputs(rep, "  FAIL  ");
            rep = catb(rep, name);
            rep = resolve.bputs(rep, ": exit ");
            if code < 0 {
                rep = rep.push(u8(45));
                rep = resolve.bu32(rep, u64(0 - code));
            } else {
                rep = resolve.bu32(rep, u64(code));
            }
            rep = resolve.bputs(rep, ", wanted ");
            if c.exit < 0 {
                rep = rep.push(u8(45));
                rep = resolve.bu32(rep, u64(0 - c.exit));
            } else {
                rep = resolve.bu32(rep, u64(c.exit));
            }
            rep = rep.push(u8(10));
            rep = rep.push(u8(0));
            return rep;
        }
    }
}

/// `our test` — ntest::run_dir over <project>/tests with dep roots.
fn cmd_test(heap: alloc) -> i32 {
    match cwd_project(heap) {
        Err(e) => { ourfail(heap, e); return 1; }
        Ok(p) => {
            maybe_dispatch(heap, p);
            let opts = oopts();
            let deps = resolved_deps(heap, p, opts);
            if true {
                    let td = project.tests_dir(heap, p);
                    if !fs.is_dir_p(td.buf.ptr, i64(td.len)) {
                        let m = lits(heap,
                            "our test: no `tests/` directory in ");
                        let m2 = catb(m, p.root.as_slice());
                        m2 = m2.push(u8(10));
                        wfd(2, m2.as_slice());
                        m2.destroy();
                        td.destroy(); project.free_deps(deps);
                        project.free_project(p);
                        return 1;
                    }
                    let pr = project.roots_with_self(heap, p, deps);
                    let roots = lroots(heap, pr);
                    project.free_proots(pr);
                    project.free_deps(deps);
                    // collect .lang files, byte-sorted (one level —
                    // byte order == component order for basenames)
                    let cases = vec.Vec<TCase>::new(heap);
                    let rep = vec.Vec<u8>::new(heap);
                    let paths = vec.Vec<vec.Vec<u8>>::new(heap);
                    match fs.read_dir(heap,
                            str_from_utf8(td.as_slice())) {
                        Err(e) => {
                            rep = resolve.bputs(rep, "cannot read ");
                            rep = catb(rep, td.as_slice());
                            rep = rep.push(u8(10));
                        }
                        Ok(dl) => {
                            let i: u64 = 0;
                            while i < fs.dir_len(dl) {
                                let e = fs.dir_ent(dl, i);
                                let nm = fs.ent_name(dl, e);
                                if e.kind == 1 && nm.len > 5 {
                                    if nm.bytes[nm.len - 5] == 46
                                    && nm.bytes[nm.len - 4] == 108
                                    && nm.bytes[nm.len - 3] == 97
                                    && nm.bytes[nm.len - 2] == 110
                                    && nm.bytes[nm.len - 1] == 103 {
                                        paths = paths.push(joinp(
                                            vec.Vec<u8>::new(heap),
                                            td.as_slice(), nm.bytes));
                                    }
                                }
                                i = i + 1;
                            }
                            fs.free_dir_list(dl);
                        }
                    }
                    paths = registry.sort_paths(paths);
                    let i: u64 = 0;
                    while i < paths.len {
                        match parse_tcase(heap, paths.buf[i].as_slice()) {
                            Err(e) => {
                                rep = resolve.bputs(rep, "  SKIP  ");
                                rep = catb(rep, e.as_slice());
                                rep = rep.push(u8(10));
                                e.destroy();
                            }
                            Ok(c) => { cases = cases.push(c); }
                        }
                        paths.buf[i].destroy();
                        i = i + 1;
                    }
                    paths.destroy();
                    // workdir — $TMPDIR/ourc-native-tests like s0
                    let wd = vec.Vec<u8>::new(heap);
                    match process.env("TMPDIR") {
                        Ok(e) => { wd = catb(wd, lb(e)); }
                        Err(_) => { wd = resolve.bputs(wd, "/tmp"); }
                    }
                    if wd.len > 0 && wd.buf[wd.len - 1] != 47 {
                        wd = wd.push(u8(47));
                    }
                    wd = catb(wd, lb("ourc-native-tests"));
                    match fs.mkdir_all(heap, wd.as_slice()) {
                        Ok(_) => {}
                        Err(_) => {}
                    }
                    let pass: u64 = 0;
                    let fail: u64 = 0;
                    i = 0;
                    while i < cases.len {
                        rep = ntest_one(heap, cases.buf[i],
                                        roots, wd.as_slice(), rep);
                        let mark = rep.buf[rep.len - 1];
                        rep.len = rep.len - 1;
                        if mark == 1 { pass = pass + 1; }
                        if mark == 0 { fail = fail + 1; }
                        if mark > 100 {
                            fail = fail + u64(mark) - 100;
                        }
                        i = i + 1;
                    }
                    rep = rep.push(u8(10));
                    rep = resolve.bu32(rep, pass);
                    rep = resolve.bputs(rep, " passed, ");
                    rep = resolve.bu32(rep, fail);
                    rep = resolve.bputs(rep, " failed\n");
                    io.print(str_from_utf8(rep.as_slice()));
                    rep.destroy();
                    i = 0;
                    while i < cases.len {
                        tcase_free(cases.buf[i]);
                        i = i + 1;
                    }
                    cases.destroy();
                    free_lroots(roots);
                    td.destroy(); wd.destroy();
                    project.free_project(p);
                    if fail == 0 && pass > 0 { return 0; }
                    return 1;
                }
        }
    }
}
