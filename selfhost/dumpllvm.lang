// dumpllvm — the self-hosted LLVM dump. Mirrors Stage-0's
// `--dump-llvm`: `llem.emit` renders .ll text from the module
// `ir.module` records (the same Module shape emit.rs consumes).
// Frontend/checker failures dump the same sorted `!` tail.
// N75 — the pipeline lives in `driver.compile`; this is the
// canonical-dump shell over it.
import std.io;
import std.process;
import std.vec;
import std.fs;
import driver;

fn write_all(s: slice u8) {
    let off: u64 = 0;
    while off < s.len {
        let n = s.len - off;
        let w = mml_fd_write(1, &s[off], n);
        if w <= 0 { return; }
        off = off + u64(w);
    }
}

fn main() -> i32 {
    let heap = system_allocator();
    let path: str;
    match process.arg(1) {
        Ok(p) => { path = p; }
        Err(_) => {
            io.eprintln("usage: dumpllvm <file.lang>");
            return 2;
        }
    }
    let dc = driver.compile(heap, path);
    write_all(dc.ll.as_slice());
    write_all(dc.tail.as_slice());
    driver.destroy(dc);
    return 0;
}
