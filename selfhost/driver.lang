// driver — the shared self-hosted compile pipeline (N75).
// `compile` runs lexer → parser → loader → resolver → checker →
// own-IR → LLVM emit and returns the pieces every driver surface
// needs: the .ll text, the sorted `!` tail (dump oracles), the
// short `L:C: error: msg` diagnostics (build path — Stage-0's
// render_short headline), and the `main`-contract status.
import std.vec;
import std.fs;
import std.process;
import lexer;
import parser;
import ast;
import loader;
import unicode;
import resolve;
import check;
import ir;
import llem;

pub struct DC {
    heap: alloc,
    ll: vec.Vec<u8>,       // .ll text — empty when the pipeline failed
    tail: vec.Vec<u8>,     // sorted `!` lines (dump-surface diags)
    diag: vec.Vec<u8>,     // `[file:]L:C: error: msg` build-path diags
    main_st: u8,           // 0 ok, 1 missing, 2 non-int ret, 3 bad params
}

pub fn destroy(own dc: DC) {
    dc.ll.destroy();
    dc.tail.destroy();
    dc.diag.destroy();
}

/// `diag` out of the DC — the rest freed (ntest's compile-error
/// cases need the message itself, not a stderr write).
pub fn diag_take(own dc: DC) -> vec.Vec<u8> {
    dc.ll.destroy();
    dc.tail.destroy();
    return dc.diag;
}

fn under(base: slice u8, p: slice u8) -> i64 {
    let bn = u64(base.len);
    if bn > u64(p.len) { return 0 - 1; }
    let i: u64 = 0;
    while i < bn {
        if base[i] != p[i] { return 0 - 1; }
        i = i + 1;
    }
    if bn == u64(p.len) { return i64(bn); }
    if bn == 1 && base[0] == 47 { return 1; }
    if p[bn] == 47 { return i64(bn + 1); }
    return 0 - 1;
}

fn rawb(own v: vec.Vec<u8>, b: slice u8) -> vec.Vec<u8> {
    let i: u64 = 0;
    while i < u64(b.len) {
        v = v.push(b[i]);
        i = i + 1;
    }
    return v;
}

/// normed path bytes for pid — entry-relative > `<std>/` > absolute.
fn normb(own v: vec.Vec<u8>, ed: slice u8, read l: loader.Loader,
         pid: u32) -> vec.Vec<u8> {
    let ps = l.pspans.buf[u64(pid)];
    let pb = &l.pbyt.buf[u64(ps.off)..u64(ps.off) + u64(ps.len)];
    let r = under(ed, pb);
    if r >= 0 { return rawb(v, &pb[u64(r)..]); }
    let r2 = under(l.stdlib.as_slice(), pb);
    if r2 >= 0 {
        v = resolve.bputs(v, "<std>/");
        return rawb(v, &pb[u64(r2)..]);
    }
    return rawb(v, pb);
}

// ---- `!` tail ---------------------------------------------------------------

/// one `! file line col msg` line into `v`.
fn emit_bang(own v: vec.Vec<u8>, file: slice u8,
             line: u32, col: u32, m: slice u8) -> vec.Vec<u8> {
    v = resolve.bputs(v, "! ");
    v = rawb(v, file);
    v = v.push(u8(32));
    v = loader.bpush_u64(v, u64(line));
    v = v.push(u8(32));
    v = loader.bpush_u64(v, u64(col));
    v = v.push(u8(32));
    v = rawb(v, m);
    v = v.push(u8(10));
    return v;
}

fn cmp_line(read ev: vec.Vec<u8>, a: u64, b: u64) -> u8 {
    let i = a;
    let j = b;
    while i < ev.len && j < ev.len {
        let x = ev.buf[i];
        let y = ev.buf[j];
        if x != y {
            if x == u8(10) { return 1; }
            if y == u8(10) { return 0; }
            if x < y { return 1; }
            return 0;
        }
        i = i + 1;
        j = j + 1;
    }
    if i >= ev.len || ev.buf[i] == u8(10) { return 1; }
    return 0;
}

/// sort a vec of byte-lines (each ending in \n) — lex order.
fn sort_lines(own v: vec.Vec<u8>, heap: alloc) -> vec.Vec<u8> {
    let offs = vec.Vec<u64>::new(heap);
    let ls: u64 = 0;
    let i: u64 = 0;
    while i < v.len {
        if v.buf[i] == u8(10) {
            offs = offs.push(ls);
            offs = offs.push(i + 1);
            ls = i + 1;
        }
        i = i + 1;
    }
    if ls < v.len { offs = offs.push(ls); offs = offs.push(v.len); }
    i = 2;
    while i < offs.len {
        let s0 = offs.buf[i];
        let e0 = offs.buf[i + 1];
        let j = i;
        while j > 0 && cmp_line(v, s0, offs.buf[j - 2]) == 1 {
            offs.buf[j] = offs.buf[j - 2];
            offs.buf[j + 1] = offs.buf[j - 1];
            j = j - 2;
        }
        offs.buf[j] = s0;
        offs.buf[j + 1] = e0;
        i = i + 2;
    }
    let out = vec.Vec<u8>::new(heap);
    i = 0;
    while i < offs.len {
        let j = offs.buf[i];
        while j < offs.buf[i + 1] {
            out = out.push(v.buf[j]);
            j = j + 1;
        }
        i = i + 2;
    }
    v.destroy();
    offs.destroy();
    return out;
}

/// loader diags — `! {file|-} {line} {col} {msg}` per diagnostic.
fn dump_diags(own v: vec.Vec<u8>, ed: slice u8,
              read l: loader.Loader) -> vec.Vec<u8> {
    let i: u64 = 0;
    while i < l.ediags.len {
        let d = l.ediags.buf[i];
        v = resolve.bputs(v, "! ");
        if d.file < 0 {
            v = v.push(u8(45));
        } else {
            v = normb(v, ed, l, u32(d.file));
        }
        v = v.push(u8(32));
        v = loader.bpush_u64(v, u64(d.line));
        v = v.push(u8(32));
        v = loader.bpush_u64(v, u64(d.col));
        v = v.push(u8(32));
        v = rawb(v, &l.emsg.buf[u64(d.m0)..u64(d.m1)]);
        v = v.push(u8(10));
        i = i + 1;
    }
    return v;
}

// ---- short diagnostics (build path — s0's `render_short` headline) ----------

/// substring probe — Stage-0 `classify`'s `m.contains`.
fn bcontains(hay: slice u8, ndl: str) -> u8 {
    let n = ndl.bytes;
    if n.len == 0 || u64(n.len) > u64(hay.len) { return 0; }
    let i: u64 = 0;
    while i + u64(n.len) <= u64(hay.len) {
        let j: u64 = 0;
        let same: u8 = 1;
        while j < u64(n.len) {
            if hay[i + j] != n[j] { same = 0; }
            j = j + 1;
        }
        if same == 1 { return 1; }
        i = i + 1;
    }
    return 0;
}
/// N79 — host platform descriptor. `OUR_TARGET` overrides (cross-
/// compile/testing); otherwise the runtime reports the triple it was
/// built for (mmlrt knows via the C preprocessor). Derived: the
/// platform runtime source, the Windows/Linux link adjustments, and
/// the exe suffix.
extern fn mml_target_triple(out: * *const u8) -> i64;
pub struct Plat {
    triple: vec.Vec<u8>,    // llvm triple for llem.emit
    rtplat: vec.Vec<u8>,    // "mmlrt_posix.c" | "mmlrt_win32.c"
    win: u8,                // windows → lld + ws2_32 + .exe
    lnx: u8,                // linux → -lpthread
    esuf: vec.Vec<u8>,      // ".exe" | ""
}
pub fn plat(heap: alloc) -> Plat {
    let t = vec.Vec<u8>::new(heap);
    match process.env("OUR_TARGET") {
        Ok(e) => { t = loader.bpush(t, e.bytes); }
        Err(_) => {
            let p: *const u8 = 0;
            let n = mml_target_triple(&mut p);
            if n > 0 { t = loader.bpush(t, slice(p, n)); }
        }
    }
    if t.len == 0 { t = resolve.bputs(t, "arm64-apple-darwin"); }
    let p = Plat {
        triple: t,
        rtplat: vec.Vec<u8>::new(heap),
        win: 0, lnx: 0,
        esuf: vec.Vec<u8>::new(heap),
    };
    if bcontains(p.triple.as_slice(), "windows") == 1 {
        p.win = 1;
        p.rtplat = resolve.bputs(p.rtplat, "mmlrt_win32.c");
        p.esuf = resolve.bputs(p.esuf, ".exe");
    } else {
        p.rtplat = resolve.bputs(p.rtplat, "mmlrt_posix.c");
        if bcontains(p.triple.as_slice(), "linux") == 1 { p.lnx = 1; }
    }
    return p;
}
pub fn destroy_plat(own p: Plat) {
    p.triple.destroy(); p.rtplat.destroy(); p.esuf.destroy();
}
/// prefix probe — `m.starts_with`.
fn bstarts(hay: slice u8, ndl: str) -> u8 {
    let n = ndl.bytes;
    if u64(n.len) > u64(hay.len) { return 0; }
    let j: u64 = 0;
    while j < u64(n.len) {
        if hay[j] != n[j] { return 0; }
        j = j + 1;
    }
    return 1;
}
/// errors.rs `classify` — family index for a headline, NONE else.
/// FAMILIES order is Stage-0's table verbatim.
fn d_classify(m: slice u8) -> u32 {
    if bcontains(m, "unjoined task") == 1
        || bcontains(m, "races") == 1
        || bcontains(m, "atomically held") == 1
        || bcontains(m, "held by a lock") == 1
        || bcontains(m, "already locked") == 1
        || bcontains(m, "different mutex domain") == 1
        || bcontains(m, "under a lock conflicts") == 1
        || bcontains(m, "through read authority") == 1 {
        return 1;
    }
    if bcontains(m, "channel-held") == 1
        || bcontains(m, "sent through a channel") == 1
        || bcontains(m, "stale in transit") == 1
        || bcontains(m, "channel op") == 1 {
        return 3;
    }
    if bcontains(m, "escapes region") == 1
        || bcontains(m, "send-escape") == 1
        || bcontains(m, "does not outlive") == 1
        || bcontains(m, "cannot promote") == 1
        || bcontains(m, "stale handle") == 1
        || bcontains(m, "still carries a reference") == 1
        || bcontains(m, "cannot leave its scope") == 1
        || bcontains(m, "cannot cross a") == 1 {
        return 2;
    }
    if bcontains(m, "it is borrowed") == 1
        || bcontains(m, "mutably borrowed") == 1
        || bcontains(m, "already borrowed") == 1
        || bcontains(m, "live borrow") == 1
        || bcontains(m, "through a borrow") == 1
        || bcontains(m, "through a handle") == 1
        || bcontains(m, "derive write authority") == 1
        || bcontains(m, "&mut` through") == 1
        || bcontains(m, "write through `&`") == 1
        || bcontains(m, "write through `slice`") == 1
        || bcontains(m, "derive `slice mut`") == 1
        || bcontains(m, "read capability") == 1
        || bcontains(m, "moved authority") == 1
        || bcontains(m, "moved reference") == 1
        || bcontains(m, "referent is borrowed") == 1 {
        return 0;
    }
    if bcontains(m, "maybe-consumed") == 1
        || bcontains(m, "dead on another path") == 1 {
        return 5;
    }
    if bcontains(m, "after consume") == 1
        || bcontains(m, "double consume") == 1
        || bcontains(m, "already consumed") == 1 {
        return 4;
    }
    if bcontains(m, "uninitialized") == 1
        || bcontains(m, "possibly-uninitialized") == 1
        || bcontains(m, "needs a type annotation or an initializer") == 1 {
        return 6;
    }
    if bcontains(m, "cannot overwrite") == 1
        || bcontains(m, "still holds") == 1 {
        return 7;
    }
    if bcontains(m, "still owns") == 1 {
        return 20;
    }
    if bstarts(m, "`match`") == 1
        || bcontains(m, "non-exhaustive") == 1
        || bcontains(m, "match arm") == 1
        || bcontains(m, "payload") == 1
        || bcontains(m, "active variant") == 1
        || bcontains(m, "binds no payload") == 1 {
        return 13;
    }
    if bstarts(m, "expected") == 1
        || bstarts(m, "unexpected") == 1
        || bstarts(m, "unterminated") == 1
        || bstarts(m, "newline in") == 1 {
        return 18;
    }
    if bcontains(m, "inferred as both") == 1
        || bcontains(m, "cannot infer") == 1 {
        return 9;
    }
    if bstarts(m, "undefined") == 1
        || bstarts(m, "unknown ") == 1
        || bstarts(m, "no function") == 1
        || bstarts(m, "no struct") == 1
        || bstarts(m, "no enum") == 1
        || bcontains(m, "declares no variants") == 1
        || bstarts(m, "no field") == 1
        || bstarts(m, "no member") == 1
        || bstarts(m, "no associated function") == 1
        || bcontains(m, "has no variant") == 1 {
        return 10;
    }
    if (bcontains(m, "takes ") == 1 && bcontains(m, "argument") == 1)
        || bcontains(m, "requires a place") == 1
        || bcontains(m, "is not a place") == 1
        || bcontains(m, "must be a place") == 1
        || bcontains(m, "is ambiguous") == 1
        || bcontains(m, "must bind a fresh `let`") == 1
        || bcontains(m, "requires a variable") == 1
        || bcontains(m, "takes no arguments") == 1
        || bcontains(m, "exactly one argument") == 1
        || bcontains(m, "first argument must name a place") == 1
        || bcontains(m, "construct a variant") == 1
        || bcontains(m, "missing field") == 1 {
        return 11;
    }
    if (bcontains(m, "found") == 1
          && (bcontains(m, "expected") == 1
            || bcontains(m, "requires") == 1
            || bcontains(m, "wants") == 1
            || bcontains(m, "takes") == 1
            || bcontains(m, "must be") == 1))
        || bcontains(m, "type mismatch") == 1
        || bcontains(m, "non-integers") == 1
        || bcontains(m, "width/sign mismatch") == 1
        || bcontains(m, "operands, found") == 1
        || bcontains(m, "index must be") == 1
        || bcontains(m, "bound must be") == 1
        || bcontains(m, "indexing non-array") == 1
        || bcontains(m, "field access on non-struct") == 1
        || bcontains(m, "cannot slice") == 1
        || bcontains(m, "recursive") == 1
        || bcontains(m, "initialized twice") == 1
        || bcontains(m, "not a task") == 1
        || bcontains(m, "must be an enum") == 1
        || bcontains(m, "must be bool") == 1
        || bcontains(m, "not atomic storage") == 1
        || bcontains(m, "not `*const`") == 1
        || bcontains(m, "void value") == 1
        || bcontains(m, "out of bounds") == 1
        || bcontains(m, "out of range") == 1
        || bcontains(m, "negative index") == 1
        || bcontains(m, "not element-indexed") == 1
        || bcontains(m, "not a declarable type") == 1 {
        return 8;
    }
    if bcontains(m, "`spawn`") == 1
        || bcontains(m, "join ") == 1
        || bcontains(m, "`join`") == 1
        || bcontains(m, "out of scope without `join`") == 1
        || bcontains(m, "`send`") == 1
        || bcontains(m, "`recv`") == 1
        || bcontains(m, "`close`") == 1
        || bcontains(m, "`channel`") == 1
        || bcontains(m, "guard") == 1
        || bcontains(m, "`lock`") == 1
        || bcontains(m, "`unlock`") == 1
        || bcontains(m, "channel endpoint") == 1
        || bcontains(m, "not a channel") == 1 {
        return 14;
    }
    if bcontains(m, "outside a loop") == 1
        || bcontains(m, "`return`") == 1
        || bcontains(m, "returning a value") == 1
        || bcontains(m, "unreachable") == 1 {
        return 12;
    }
    if bcontains(m, "private") == 1
        || bcontains(m, "exposes") == 1
        || bcontains(m, "is private to") == 1
        || bcontains(m, "is not `pub`") == 1 {
        return 16;
    }
    if bcontains(m, "import") == 1
        || bcontains(m, "declared, but the file") == 1
        || bcontains(m, "module") == 1
        || bcontains(m, "cycle") == 1
        || bcontains(m, "cyclic") == 1
        || bstarts(m, "no module") == 1
        || bstarts(m, "duplicate") == 1
        || (bcontains(m, "field `{") == 1
            && bcontains(m, "in struct") == 1) {
        return 15;
    }
    if bcontains(m, "non-FFI type") == 1
        || bcontains(m, "extern ") == 1
        || bcontains(m, "writable `*T`") == 1
        || bcontains(m, "*const") == 1 {
        return 17;
    }
    if bcontains(m, "does not fit") == 1
        || bcontains(m, "division by zero") == 1
        || bcontains(m, "constant expression") == 1
        || bcontains(m, "literal") == 1
        || bcontains(m, "digit") == 1
        || bcontains(m, "escape") == 1
        || bstarts(m, "misplaced") == 1 {
        return 19;
    }
    return ir.NONE();
}
/// family index → code bytes (FAMILIES order, Stage-0's table).
fn d_code(own v: vec.Vec<u8>, i: u32) -> vec.Vec<u8> {
    if i == 0 { return resolve.bputs(v, "E1001"); }
    if i == 1 { return resolve.bputs(v, "E1002"); }
    if i == 2 { return resolve.bputs(v, "E1003"); }
    if i == 3 { return resolve.bputs(v, "E1004"); }
    if i == 4 { return resolve.bputs(v, "E2001"); }
    if i == 5 { return resolve.bputs(v, "E2002"); }
    if i == 6 { return resolve.bputs(v, "E2003"); }
    if i == 7 { return resolve.bputs(v, "E2004"); }
    if i == 8 { return resolve.bputs(v, "E3001"); }
    if i == 9 { return resolve.bputs(v, "E3002"); }
    if i == 10 { return resolve.bputs(v, "E3003"); }
    if i == 11 { return resolve.bputs(v, "E3004"); }
    if i == 12 { return resolve.bputs(v, "E4001"); }
    if i == 13 { return resolve.bputs(v, "E4002"); }
    if i == 14 { return resolve.bputs(v, "E4003"); }
    if i == 15 { return resolve.bputs(v, "E5001"); }
    if i == 16 { return resolve.bputs(v, "E5002"); }
    if i == 17 { return resolve.bputs(v, "E6001"); }
    if i == 18 { return resolve.bputs(v, "E7001"); }
    if i == 19 { return resolve.bputs(v, "E7002"); }
    return resolve.bputs(v, "E2005");
}

/// caret/entry machinery for the rich diagnostic renderer — N82-C
/// port of s0's `compiler/src/driver/render.rs`. One entry per
/// headline/label line; `msg` empty = bare carets (headline).
pub struct REnt { line: u32, col: u32, w: u64, msg: vec.Vec<u8> }

/// digit count of `n`.
fn num_w(n: u32) -> u64 {
    let d: u64 = 1;
    let m = n;
    while m >= 10 {
        m = m / 10;
        d = d + 1;
    }
    return d;
}

fn rep(own v: vec.Vec<u8>, ch: u8, n: u64) -> vec.Vec<u8> {
    let i: u64 = 0;
    while i < n {
        v = v.push(ch);
        i = i + 1;
    }
    return v;
}

/// byte range of 1-based `line` in `src` — ok=0 when out of range.
pub struct LSpan { ok: u8, s: u64, e: u64 }
fn line_span(src: slice u8, line: u32) -> LSpan {
    let cur: u32 = 1;
    let s0: u64 = 0;
    let i: u64 = 0;
    while i < u64(src.len) {
        if src[i] == u8(10) {
            if cur == line {
                return LSpan { ok: 1, s: s0, e: i };
            }
            cur = cur + 1;
            s0 = i + 1;
        }
        i = i + 1;
    }
    if cur == line {
        return LSpan { ok: 1, s: s0, e: u64(src.len) };
    }
    return LSpan { ok: 0, s: 0, e: 0 };
}

/// UTF-8 sequence length from the lead byte (stray continuations
/// count as one — the renderer never sees invalid UTF-8 anyway).
fn cp_len(b: u8) -> u64 {
    if b < 0x80 { return 1; }
    if b < 0xC0 { return 1; }
    if b < 0xE0 { return 2; }
    if b < 0xF0 { return 3; }
    return 4;
}

/// UTF-8 decode — U+FFFD on truncation (matches Rust `.chars()`
/// only for well-formed input, which is all the loader admits).
fn decode_cp(src: slice u8, i: u64, e: u64) -> u32 {
    let b0 = src[i];
    if b0 < 0x80 { return u32(b0); }
    let n = cp_len(b0);
    if n == 2 && i + 1 < e {
        return ((u32(b0) & 31) << 6) | (u32(src[i + 1]) & 63);
    }
    if n == 3 && i + 2 < e {
        return ((u32(b0) & 15) << 12)
            | ((u32(src[i + 1]) & 63) << 6)
            | (u32(src[i + 2]) & 63);
    }
    if n == 4 && i + 3 < e {
        return ((u32(b0) & 7) << 18)
            | ((u32(src[i + 1]) & 63) << 12)
            | ((u32(src[i + 2]) & 63) << 6)
            | (u32(src[i + 3]) & 63);
    }
    return 0xFFFD;
}

/// `col_cells` — display cells occupied by the first `n` chars of
/// src[s..e] (tab = 4).
fn cells_upto(src: slice u8, s: u64, e: u64, n: u64) -> u64 {
    let cells: u64 = 0;
    let taken: u64 = 0;
    let i = s;
    while i < e && taken < n {
        if src[i] == u8(9) {
            cells = cells + 4;
        } else {
            cells = cells + 1;
        }
        i = i + cp_len(src[i]);
        taken = taken + 1;
    }
    return cells;
}

/// `caret_width` — ident/number chars (Unicode alnum + `_` + `.`)
/// extend the underline from 1-based char col `col`; min 1.
fn caret_w(src: slice u8, s: u64, e: u64, col: u32) -> u64 {
    let i = s;
    let skipped: u32 = 1;
    while i < e && skipped < col {
        i = i + cp_len(src[i]);
        skipped = skipped + 1;
    }
    let w: u64 = 0;
    while i < e {
        let cp = decode_cp(src, i, e);
        if unicode.is_alphanumeric(cp) || cp == 95 || cp == 46 {
            w = w + 1;
            i = i + cp_len(src[i]);
        } else {
            i = e;
        }
    }
    if w == 0 { return 1; }
    return w;
}

/// `{line:>pw} | {untab src}` + `\n` + `{pad} | {cells}{carets}[ msg]`
/// — s0's `gutter` for one entry.
fn emit_ent(own v: vec.Vec<u8>, pw: u64, src: slice u8,
            ls: LSpan, line: u32, col: u32, w: u64,
            msg: slice u8) -> vec.Vec<u8> {
    v = rep(v, u8(32), pw - num_w(line));
    v = loader.bpush_u64(v, u64(line));
    v = resolve.bputs(v, " | ");
    let i = ls.s;
    while i < ls.e {
        if src[i] == u8(9) {
            v = resolve.bputs(v, "    ");
        } else {
            v = v.push(src[i]);
        }
        i = i + 1;
    }
    v = v.push(u8(10));
    v = rep(v, u8(32), pw);
    v = resolve.bputs(v, " | ");
    v = rep(v, u8(32), cells_upto(src, ls.s, ls.e, u64(col) - 1));
    v = rep(v, u8(94), w);
    if u64(msg.len) > 0 {
        v = v.push(u8(32));
        v = rawb(v, msg);
    }
    return v;
}

/// Stable insertion sort by line — s0's `sort_by_key`.
fn r_sort(own es: vec.Vec<REnt>) -> vec.Vec<REnt> {
    let i: u64 = 1;
    while i < es.len {
        let j = i;
        while j > 0 && es.buf[j].line < es.buf[j - 1].line {
            let t = es.buf[j - 1];
            es.buf[j - 1] = es.buf[j];
            es.buf[j] = t;
            j = j - 1;
        }
        i = i + 1;
    }
    return es;
}

fn free_ents(own es: vec.Vec<REnt>) {
    let i: u64 = 0;
    while i < es.len {
        es.buf[i].msg.destroy();
        i = i + 1;
    }
    es.destroy();
}

fn free_notes(own notes: vec.Vec<vec.Vec<u8>>) {
    let i: u64 = 0;
    while i < notes.len {
        notes.buf[i].destroy();
        i = i + 1;
    }
    notes.destroy();
}

/// `render_short` verbatim — `[file:]L:C: error[E]: msg`, then
/// `[file:]L:C: note:` labels, then `note:` notes. `es[0]` is the
/// headline; `hm` is its text. Consumes `es` + `notes`.
fn r_short(own v: vec.Vec<u8>, has_f: u8, file: slice u8,
           hm: slice u8, own es: vec.Vec<REnt>,
           own notes: vec.Vec<vec.Vec<u8>>) -> vec.Vec<u8> {
    if has_f == 1 {
        v = rawb(v, file);
        v = v.push(u8(58));
    }
    v = loader.bpush_u64(v, u64(es.buf[0].line));
    v = v.push(u8(58));
    v = loader.bpush_u64(v, u64(es.buf[0].col));
    v = resolve.bputs(v, ": error");
    let ci = d_classify(hm);
    if ci != ir.NONE() {
        v = v.push(u8(91));
        v = d_code(v, ci);
        v = v.push(u8(93));
    }
    v = resolve.bputs(v, ": ");
    v = rawb(v, hm);
    let i: u64 = 1;
    while i < es.len {
        v = v.push(u8(10));
        if has_f == 1 {
            v = rawb(v, file);
            v = v.push(u8(58));
        }
        v = loader.bpush_u64(v, u64(es.buf[i].line));
        v = v.push(u8(58));
        v = loader.bpush_u64(v, u64(es.buf[i].col));
        v = resolve.bputs(v, ": note: ");
        v = rawb(v, es.buf[i].msg.as_slice());
        i = i + 1;
    }
    let i: u64 = 0;
    while i < notes.len {
        v = resolve.bputs(v, "\nnote: ");
        v = rawb(v, notes.buf[i].as_slice());
        i = i + 1;
    }
    free_ents(es);
    free_notes(notes);
    return v;
}

/// s0 `render` — one file group (all self-hosted labels are
/// same-file): headline + labels sorted by line with `...` gaps,
/// `-->` header, `pad = note:` tail. `file` is the normed display
/// path (the root's normed path for root-attributed diags — s0
/// never omits `-->`'s file). `hm` is the headline msg; `es[0]`
/// the headline entry. Empty `src` or a missing headline line
/// falls back to `r_short` (unregistered-source rule).
fn r_render(own v: vec.Vec<u8>, has_f: u8, file: slice u8,
            hm: slice u8, own es: vec.Vec<REnt>,
            own notes: vec.Vec<vec.Vec<u8>>,
            src: slice u8) -> vec.Vec<u8> {
    // render_all's join — a blank line between diags.
    if v.len > 0 { v = v.push(u8(10)); }
    let ls0 = line_span(src, es.buf[0].line);
    if file.len == 0 || ls0.ok == 0 {
        return r_short(v, has_f, file, hm, es, notes);
    }
    let mx: u32 = es.buf[0].line;
    let i: u64 = 1;
    while i < es.len {
        if es.buf[i].line > mx { mx = es.buf[i].line; }
        i = i + 1;
    }
    let pw = num_w(mx);
    v = resolve.bputs(v, "error");
    let ci = d_classify(hm);
    if ci != ir.NONE() {
        v = v.push(u8(91));
        v = d_code(v, ci);
        v = v.push(u8(93));
    }
    v = resolve.bputs(v, ": ");
    v = rawb(v, hm);
    v = v.push(u8(10));
    v = rep(v, u8(32), pw);
    v = resolve.bputs(v, "--> ");
    v = rawb(v, file);
    v = v.push(u8(58));
    v = loader.bpush_u64(v, u64(es.buf[0].line));
    v = v.push(u8(58));
    v = loader.bpush_u64(v, u64(es.buf[0].col));
    v = v.push(u8(10));
    v = rep(v, u8(32), pw);
    v = resolve.bputs(v, " |\n");
    es = r_sort(es);
    let prev: u32 = 0;
    let has_prev: u8 = 0;
    let i: u64 = 0;
    while i < es.len {
        let ls = line_span(src, es.buf[i].line);
        if ls.ok == 1 {
            if has_prev == 1 && es.buf[i].line > prev + 1 {
                v = rep(v, u8(32), pw);
                v = resolve.bputs(v, " ...\n");
            }
            v = emit_ent(v, pw, src, ls, es.buf[i].line,
                es.buf[i].col, es.buf[i].w,
                es.buf[i].msg.as_slice());
            v = v.push(u8(10));
            prev = es.buf[i].line;
            has_prev = 1;
        }
        i = i + 1;
    }
    let i: u64 = 0;
    while i < notes.len {
        v = v.push(u8(10));
        v = rep(v, u8(32), pw);
        v = resolve.bputs(v, " = note: ");
        v = rawb(v, notes.buf[i].as_slice());
        i = i + 1;
    }
    free_ents(es);
    free_notes(notes);
    return v;
}

/// `srcs` lookup — the retained source for `file` (pid or -1).
fn src_of(read l: loader.Loader, file: i64) -> i64 {
    let i: u64 = 0;
    while i < l.srcs.len {
        if l.srcs.buf[i].file == file { return i64(i); }
        i = i + 1;
    }
    return 0 - 1;
}

/// loader diags in production order — s0's `render` per ediag.
/// `-->`'s file is s0's display path: the arg verbatim for
/// root-attributed diags, the canonical pid for dep files.
fn render_ediags(own v: vec.Vec<u8>, path: slice u8,
                 read l: loader.Loader) -> vec.Vec<u8> {
    let i: u64 = 0;
    while i < l.ediags.len {
        let d = l.ediags.buf[i];
        let m2 = &l.emsg.buf[u64(d.m0)..u64(d.m1)];
        let fspan: slice u8 = path;
        let hf: u8 = 0;
        if d.file >= 0 {
            let ps = l.pspans.buf[u64(d.file)];
            fspan = &l.pbyt.buf[u64(ps.off)..
                u64(ps.off) + u64(ps.len)];
            hf = 1;
        }
        let src: slice u8 = &m2[0..0];
        let si = src_of(l, d.file);
        if si >= 0 {
            src = l.srcs.buf[u64(si)].src.as_slice();
        }
        let es = vec.Vec<REnt>::new(l.heap);
        let ls = line_span(src, u32(d.line));
        let w: u64 = 1;
        if ls.ok == 1 {
            w = caret_w(src, ls.s, ls.e, u32(d.col));
        }
        es = es.push(REnt { line: u32(d.line), col: u32(d.col),
            w: w, msg: vec.Vec<u8>::new(l.heap) });
        let notes = vec.Vec<vec.Vec<u8>>::new(l.heap);
        v = r_render(v, hf, fspan, m2, es, notes, src);
        i = i + 1;
    }
    return v;
}


/// checker diag → entries+notes → `r_render`. All labels are
/// same-file in the self-hosted checker, so one group per diag.
fn render_cdiag(own v: vec.Vec<u8>, has_f: u8, file: slice u8,
                read c: check.Checker, cd: check.CDiag,
                hm: slice u8, src: slice u8) -> vec.Vec<u8> {
    let es = vec.Vec<REnt>::new(c.heap);
    let ls = line_span(src, cd.line);
    let w: u64 = 1;
    if ls.ok == 1 { w = caret_w(src, ls.s, ls.e, cd.col); }
    es = es.push(REnt { line: cd.line, col: cd.col, w: w,
        msg: vec.Vec<u8>::new(c.heap) });
    let i: u64 = u64(cd.l0);
    while i < u64(cd.l1) {
        let lb = c.dlab.buf[i];
        let lm = loader.bpush(vec.Vec<u8>::new(c.heap),
            &c.ebyt.buf[u64(lb.m0)..u64(lb.m1)]);
        let ls2 = line_span(src, lb.line);
        let w2: u64 = 1;
        if ls2.ok == 1 {
            w2 = caret_w(src, ls2.s, ls2.e, lb.col);
        }
        es = es.push(REnt { line: lb.line, col: lb.col, w: w2,
            msg: lm });
        i = i + 1;
    }
    let notes = vec.Vec<vec.Vec<u8>>::new(c.heap);
    i = u64(cd.n0);
    while i < u64(cd.n1) {
        let np = c.dnote.buf[i];
        notes = notes.push(loader.bpush(
            vec.Vec<u8>::new(c.heap),
            &c.ebyt.buf[u64(np.off)..u64(np.off) + u64(np.len)]));
        i = i + 1;
    }
    return r_render(v, has_f, file, hm, es, notes, src);
}

// ---- `main` contract (s0 build_with) -----------------------------------------

/// is_int — prim kinds 0..7; Atomic (20) transparent like s0.
fn d_isint(read r: resolve.Resolver, t: u32) -> u8 {
    let ty = r.rtys.buf[u64(t)];
    let k = u32(ty.kind);
    if k <= 7 { return 1; }
    if k == 20 { return d_isint(r, ty.a); }
    return 0;
}

/// 0 ok, 1 missing, 2 non-int ret, 3 bad params — s0's build gate:
/// `main` returns int; params are [] or `args: slice str`.
fn d_main(read g: ir.G) -> u8 {
    let mv = resolve.bputs(
        vec.Vec<u8>::new(g.heap), "main");
    let mn = resolve.intern_at(g.c.r, mv.as_slice());
    mv.destroy();
    if mn == ir.NONE() { return 1; }
    let fi: u64 = 0;
    while fi * 8 < g.irf.len {
        let fb = fi * 8;
        if g.irf.buf[fb] == mn {
            if d_isint(g.c.r, g.irf.buf[fb + 1]) == 0 { return 2; }
            let poff = u64(g.irf.buf[fb + 2]);
            let plen = u64(g.irf.buf[fb + 3]);
            if plen == 0 { return 0; }
            if plen == 1 {
                let pa = g.irpa.buf[poff + 1];
                let pty = g.c.r.rtys.buf[u64(g.irpa.buf[poff + 2])];
                // `args: slice str` — no auth, immutable slice of str.
                if pa == 0 && u32(pty.kind) == 17 && pty.b == 0 {
                    let et = g.c.r.rtys.buf[u64(pty.a)];
                    if u32(et.kind) == 10 { return 0; }
                }
            }
            return 3;
        }
        fi = fi + 1;
    }
    return 1;
}

// ---- the pipeline -------------------------------------------------------------

/// Compile `path` through the full self-hosted pipeline. Never fails
/// to return — every error channel lands in `diag`/`tail` instead.
pub fn compile(heap: alloc, path: str) -> DC {
    return compile_roots(heap, path,
        vec.Vec<loader.LRoot>::new(heap));
}

/// Project-mode compile — the same pipeline with declared package
/// roots (N81). `roots` entries are name → dep src dir.
pub fn compile_roots(heap: alloc, path: str,
                     own roots: vec.Vec<loader.LRoot>) -> DC {
    let dc = DC {
        heap: heap,
        ll: vec.Vec<u8>::new(heap),
        tail: vec.Vec<u8>::new(heap),
        diag: vec.Vec<u8>::new(heap),
        main_st: 1,
    };
    let l0 = loader.new(heap);
    let l = loader.set_roots(l0, roots);
    let rd = loader.bparent(path.bytes);
    l = loader.intern_p(l, rd);
    let dir_pid = l.res;
    match fs.realpath(heap, rd) {
        Ok(b) => {
            l.base = loader.bpush(l.base, b.as_slice());
            b.destroy();
        }
        Err(_) => {
            l.base = loader.bputs(l.base, ".");
        }
    }

    // `path` may point into a Vec (project entry) — slurp_r's open
    // needs a real C string, so copy + NUL before the raw-ptr call.
    let zp = loader.bpush(vec.Vec<u8>::new(heap), path.bytes);
    zp = zp.push(u8(0));
    let sr = fs.slurp_r(heap, zp.buf.ptr);
    zp.destroy();
    match sr {
        Ok(bytes) => {
            if mml_str_check(bytes.buf.ptr, bytes.len) == 0 {
                let m = vec.Vec<u8>::new(heap);
                m = loader.bpush(m, path.bytes);
                m = loader.bputs(m,
                    ": stream did not contain valid UTF-8");
                l = loader.lfail(l, 0 - 1, 1, 1, m);
                bytes.destroy();
            } else {
                l = loader.register_src(l, 0 - 1,
                    bytes.as_slice());
                let lx = lexer.lex(heap, bytes);
                if lx.errs.len > 0 {
                    l = loader.lfail_lex(l, 0 - 1, lx);
                } else {
                    let p = parser.parse(heap, lx);
                    if p.fail != 0 {
                        let m = vec.Vec<u8>::new(heap);
                        m = loader.bpush(m, p.emsg.as_slice());
                        l = loader.lfail(l, 0 - 1, p.eline, p.ecol, m);
                        parser.destroy(p);
                    } else {
                        l = loader.load(l, p, dir_pid);
                        if l.fail == 0 {
                            let r = resolve.new(heap);
                            let r2 = resolve.register(r, l, p);
                            let c = check.new(heap, r2);
                            let g = ir.new(c);
                            // errs boundaries for file attribution:
                            // (module idx, errs_len before)
                            let eb = vec.Vec<u64>::new(heap);
                            l = loader.intern_p(l, path.bytes);
                            let rpid = l.res;
                            // a module whose check produced diags
                            // fails the whole frontend — no later
                            // modules, no root (check_module's `?`).
                            let aborted: u8 = 0;
                            let mi: u64 = 0;
                            while mi < l.mods.len && aborted == 0 {
                                let m = l.mods.buf[mi];
                                let d0 = m.deps_off;
                                let dn = m.deps_len;
                                let q = vec.Vec<u8>::new(heap);
                                let ns = l.nspans.buf[u64(m.name)];
                                let i2: u64 = 0;
                                while i2 < u64(ns.len) {
                                    q = q.push(
                                        l.nbyt.buf[u64(ns.off) + i2]);
                                    i2 = i2 + 1;
                                }
                                let pv = normb(
                                    vec.Vec<u8>::new(heap),
                                    rd, l, m.file);
                                g.c.r = resolve.module(g.c.r,
                                    l.progs.buf[mi], l, p,
                                    u32(mi), d0, dn,
                                    "mod", q.as_slice(),
                                    pv.as_slice());
                                if g.c.r.ferrs.len == 0 {
                                    eb = eb.push(mi);
                                    eb = eb.push(u64(g.c.errs.len));
                                    let fb = g.c.r.fbases.buf[u64(mi)];
                                    g.c = check.module(g.c,
                                        l.progs.buf[mi], l,
                                        u32(mi), fb);
                                    g.c.ev.destroy();
                                    g.c.ev =
                                        vec.Vec<u8>::new(heap);
                                    if g.c.errs.len > eb.buf[
                                        eb.len - 1] {
                                        aborted = 1;
                                    } else {
                                        g = ir.module(g,
                                            l.progs.buf[mi], l,
                                            u32(mi), fb);
                                    }
                                }
                                q.destroy();
                                pv.destroy();
                                mi = mi + 1;
                            }
                            // root module — resolve + check + lower,
                            // only when every dep checked clean
                            if aborted == 0 {
                            let rd0 = l.res2;
                            let rdn = l.res3;
                            let pv = vec.Vec<u8>::new(heap);
                            let i5: u64 = 0;
                            while i5 < path.bytes.len {
                                pv = pv.push(u8(path.bytes[i5]));
                                i5 = i5 + 1;
                            }
                            let eq = vec.Vec<u8>::new(heap);
                            g.c.r = resolve.module(g.c.r, p, l, p,
                                u32(l.progs.len), rd0, rdn,
                                "root", eq.as_slice(),
                                pv.as_slice());
                            eq.destroy();
                            pv.destroy();
                            if g.c.r.ferrs.len == 0 {
                                eb = eb.push(u64(l.progs.len));
                                eb = eb.push(u64(g.c.errs.len));
                                let fb2 = g.c.r.fbases.buf[
                                    u64(g.c.r.fbases.len - 1)];
                                g.c = check.module(g.c, p, l,
                                    u32(l.progs.len), fb2);
                                g.c.ev.destroy();
                                g.c.ev = vec.Vec<u8>::new(heap);
                                if g.c.errs.len == eb.buf[
                                    eb.len - 1] {
                                    g = ir.module(g, p, l,
                                        u32(l.progs.len), fb2);
                                }
                            }
                            }
                            if g.c.r.ferrs.len != 0 {
                                // Stage-0's mono errors abort the
                                // pipeline — `!` tail + short diags.
                                let fi: u64 = 0;
                                while fi < g.c.r.ferrs.len {
                                    let fd = g.c.r.ferrs.buf[fi];
                                    let wm = g.c.r.fmods.buf[fi];
                                    let m2 = &g.c.r.ebyt.buf[
                                        u64(fd.m0)..u64(fd.m1)];
                                    let tmp =
                                        vec.Vec<u8>::new(heap);
                                    let fv =
                                        vec.Vec<u8>::new(heap);
                                    if u64(wm) < l.progs.len {
                                        fv = normb(fv, rd, l,
                                            l.mods.buf[
                                                u64(wm)].file);
                                    } else {
                                        fv = normb(fv, rd, l, rpid);
                                    }
                                    let tmp2 = emit_bang(tmp,
                                        fv.as_slice(),
                                        fd.line, fd.col, m2);
                                    dc.tail = loader.bpush(
                                        dc.tail, tmp2.as_slice());
                                    tmp2.destroy();
                                    let msrc: slice u8 = &m2[0..0];
                                    let hf: u8 = 0;
                                    if u64(wm) < l.progs.len {
                                        msrc = l.progs.buf[
                                            u64(wm)].lx.src.as_slice();
                                        hf = 1;
                                    } else {
                                        msrc = p.lx.src.as_slice();
                                    }
                                    // mono errs stamp file=Some
                                    // always — dep canon or the arg
                                    // verbatim, never normed.
                                    let fspan: slice u8 = path.bytes;
                                    if u64(wm) < l.mods.len {
                                        let ps = l.pspans.buf[u64(
                                            l.mods.buf[
                                                u64(wm)].file)];
                                        fspan = &l.pbyt.buf[
                                            u64(ps.off)..
                                            u64(ps.off) +
                                            u64(ps.len)];
                                    }
                                    let es = vec.Vec<REnt>::new(
                                        heap);
                                    let ls = line_span(msrc,
                                        fd.line);
                                    let w: u64 = 1;
                                    if ls.ok == 1 {
                                        w = caret_w(msrc, ls.s,
                                            ls.e, fd.col);
                                    }
                                    es = es.push(REnt {
                                        line: fd.line,
                                        col: fd.col, w: w,
                                        msg: vec.Vec<u8>::new(
                                            heap) });
                                    dc.diag = r_render(dc.diag, 1,
                                        fspan, m2, es,
                                        vec.Vec<vec.Vec<u8>>::new(
                                            heap), msrc);
                                    fv.destroy();
                                    fi = fi + 1;
                                }
                            } else {
                                // N74 — the .ll text stands alone on
                                // a clean pipeline, exactly like
                                // s0's `emit` over the module.
                                if g.c.errs.len == 0 {
                                    let pl = plat(heap);
                                    let le = llem.new(heap);
                                    let le2 = llem.emit(le, g,
                                        str_from_utf8(
                                            pl.triple.as_slice()));
                                    dc.ll = loader.bpush(dc.ll,
                                        le2.out.as_slice());
                                    llem.destroy(le2);
                                    destroy_plat(pl);
                                    dc.main_st = d_main(g);
                                }
                            }
                            // checker errs — attribute by eb
                            let mi2: u64 = 0;
                            while g.c.r.ferrs.len == 0
                                && mi2 < g.c.errs.len {
                                let cd = g.c.errs.buf[mi2];
                                // find module: last eb with
                                // errs_len <= mi2
                                let wm: u64 = u64(l.progs.len);
                                let k: u64 = 0;
                                while k < eb.len {
                                    if mi2 >= eb.buf[k + 1] {
                                        wm = eb.buf[k];
                                    }
                                    k = k + 2;
                                }
                                let m2 = &g.c.ebyt.buf[u64(cd.m0)..
                                    u64(cd.m1)];
                                if wm < l.mods.len {
                                    let fv = normb(
                                        vec.Vec<u8>::new(heap),
                                        rd, l,
                                        l.mods.buf[wm].file);
                                    let tmp = vec.Vec<u8>::new(heap);
                                    let tmp2 = emit_bang(tmp,
                                        fv.as_slice(),
                                        cd.line, cd.col, m2);
                                    dc.tail = loader.bpush(
                                        dc.tail, tmp2.as_slice());
                                    tmp2.destroy();
                                    let dsrc =
                                        l.progs.buf[wm]
                                            .lx.src.as_slice();
                                    let ps2 = l.pspans.buf[u64(
                                        l.mods.buf[wm].file)];
                                    let fsp2 = &l.pbyt.buf[
                                        u64(ps2.off)..
                                        u64(ps2.off) +
                                        u64(ps2.len)];
                                    dc.diag = render_cdiag(
                                        dc.diag, 1,
                                        fsp2, g.c, cd,
                                        m2, dsrc);
                                    fv.destroy();
                                } else {
                                    let dash = vec.Vec<u8>::new(heap);
                                    let dash = dash.push(u8(45));
                                    let tmp = vec.Vec<u8>::new(heap);
                                    let tmp2 = emit_bang(tmp,
                                        dash.as_slice(),
                                        cd.line, cd.col, m2);
                                    dc.tail = loader.bpush(
                                        dc.tail, tmp2.as_slice());
                                    tmp2.destroy();
                                    dash.destroy();
                                    let rp = normb(
                                        vec.Vec<u8>::new(heap),
                                        rd, l, rpid);
                                    dc.diag = render_cdiag(
                                        dc.diag, 0,
                                        path.bytes, g.c, cd,
                                        m2, p.lx.src.as_slice());
                                    rp.destroy();
                                }
                                mi2 = mi2 + 1;
                            }
                            eb.destroy();
                            ir.destroy(g);
                        }
                        parser.destroy(p);
                    }
                }
            }
        }
        Err(e) => {
            l = loader.lfail(l, 0 - 1, 1, 1,
                loader.ioerr(heap, path.bytes, e));
        }
    }
    if l.fail != 0 {
        // loader/lex/parse diags — sorted `!` tail + short diags.
        let s = vec.Vec<u8>::new(heap);
        let s2 = dump_diags(s, rd, l);
        let s3 = sort_lines(s2, heap);
        dc.tail = loader.bpush(dc.tail, s3.as_slice());
        s3.destroy();
        dc.diag = render_ediags(dc.diag, path.bytes, l);
    } else {
        dc.tail = sort_lines(dc.tail, heap);
    }
    loader.destroy(l);
    return dc;
}
