es an affine-V map\n/// so `free_storage` can take the shell. Also the honest \"any entry\"\n/// op like `Vec::pop`.\npub fn pop_value<V>(write self: StrMap<V>) -> result.Result<V, i32> {\n    let i: u64 = 0;\n    while i < self.slots.len {\n        match self.slots[i] {\n            Full(e) => {\n                let value = e.v;\n                self.slots[i] = Slot<V>::Tomb;\n                self.len = self.len - 1;\n                return result.Result<V, i32>::Ok(value);\n            }\n            _ => {}\n        }\n        i = i + 1;\n    }\n    return result.Result<V, i32>::Err(1);\n}\n\n/// Same drain but the WHOLE `Entry` \xE2\x80\x94 key view + hash + value \xE2\x80\x94\n/// for callers that still need the word alongside the value\n/// (wordfreq drains into a sortable Vec of (key, count) pairs).\npub fn pop_entry<V>(write self: StrMap<V>) -> result.Result<Entry<V>, i32> {\n    let i: u64 = 0;\n    while i < self.slots.len {\n        match self.slots[i] {\n            Full(e) => {\n                self.slots[i] = Slot<V>::Tomb;\n                self.len = self.len - 1;\n                return result.Result<Entry<V>, i32>::Ok(e);\n            }\n            _ => {}\n        }\n        i = i + 1;\n    }\n    return result.Result<Entry<V>, i32>::Err(1);\n}\n\n/// Read-only cursor step: borrows the next live entry at or after\n/// cursor `i`, advancing `i` past it \xE2\x80\x94 `Err(1)` means exhausted.\n/// The map is only borrowed: `len` is untouched, no entry moves,\n/// nothing allocates. `*e` yields the live `Entry` in place \xE2\x80\x94 read\n/// `(*e).key` / `(*e).v`, never move them.\n///\n///     let i: u64 = 0;\n///     while true {\n///         match m.next_entry(i) {\n///             Ok(e) => { /* borrowed \xE2\x80\x94 drop before mutating m */ }\n///             Err(_) => { break; }\n///         }\n///     }\n///\n/// `i` is a raw slot cursor: the borrow checker blocks mutation while\n/// a yielded borrow lives, but `i` itself is just an index \xE2