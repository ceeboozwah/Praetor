: u64) -> i64;\nextern fn mml_sock_send(s: i64, buf: *const void, n: u64) -> i64;\nextern fn mml_sock_close(s: i64) -> i32;\nextern fn mml_sock_errno() -> i32;\n/// N58B \xE2\x80\x94 the runtime fills `sa` with the host's sockaddr_in (16\n/// bytes); family/addr/port chosen by the arguments, not bytes.\nextern fn mml_sockaddr_v4(sa: *u8, o0: i32, o1: i32, o2: i32, o3: i32, port: i32);\n\npub struct Ipv4Addr { o0: u8, o1: u8, o2: u8, o3: u8 }\n\npub fn v4(a: u8, b: u8, c: u8, d: u8) -> Ipv4Addr {\n    return Ipv4Addr { o0: a, o1: b, o2: c, o3: d };\n}\n\n/// INADDR_ANY \xE2\x80\x94 bind every interface.\npub fn any_v4() -> Ipv4Addr {\n    return Ipv4Addr { o0: 0, o1: 0, o2: 0, o3: 0 };\n}\n\npub fn loopback_v4() -> Ipv4Addr {\n    return Ipv4Addr { o0: 127, o1: 0, o2: 0, o3: 1 };\n}\n\n/// The runtime owns sockaddr_in \xE2\x80\x94 byte layout differs per OS (BSD\n/// prepends sin_len); painting bytes here was silently Apple-only.\nfn sockaddr_v4(write sa: [16]u8, ip: Ipv4Addr, port: u16) {\n    mml_sockaddr_v4(&mut sa[0], i32(ip.o0), i32(ip.o1), i32(ip.o2), i32(ip.o3), i32(port));\n}\n\n// ---- raw layer \xE2\x80\x94 bare return codes, unchanged contract ----------\n\n/// AF_INET=2, SOCK_STREAM=1 \xE2\x80\x94 platform constants, stated once.\n/// Returns a socket handle (i64; a Win32 SOCKET is 64-bit).\npub fn tcp_socket() -> i64 {\n    return mml_sock_socket(0x2, 0x1, 0);\n}\n\npub fn bind_v4(s: i64, ip: Ipv4Addr, port: u16) -> i32 {\n    let sa: [16]u8;\n    sa[0] = 0;\n    sockaddr_v4(sa, ip, port);\n    return mml_sock_bind(s, &sa[0], 16);\n}\n\npub fn connect_v4(s: i64, ip: Ipv4Addr, port: u16) -> i32 {\n    let sa: [16]u8;\n    sa[0] = 0;\n    sockaddr_v4(sa, ip, port);\n    return mml_sock_connect(s, &sa[0], 16);\n}\n\npub fn listen_raw(s: i64, backlog: i32) -> i32 {\n    return mml_sock_listen(s, backlog);\n}\n\n/// addr/len out-params unused \xE2\x80\x94 the peer's address isn't asked for.\npub fn accept_raw(s: i64) -> i64 {\n    return mml_sock_accept(s);\n